#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("상|동|교|회","尙|洞|敎|會")에 모인 #ruby("인|물","人|物")로 말하면, #ruby("전|덕|기","全|德|基")·#ruby("정|순|만","鄭|淳|萬")·#ruby("이|준","李|儁")·#ruby[이|석][李|石]\(東寧)·#ruby[최|재|학][崔|在|學]\(#ruby("평|양|인","平|壤|人"))·#ruby("계|명|륙","桂|明|陸")·#ruby("김|인|집","金|仁|濈")·#ruby("옥|관|빈","玉|觀|彬")·#ruby("이|승|길","李|承|吉")·#ruby("차|병|수","車|炳|修")·#ruby("신|상|민","申|尙|敏")·#ruby[김|태|연][金|泰|淵]\(鴻作)·#ruby("표|영|각","表|永|珏")·#ruby("조|성|환","曹|成|煥")·#ruby("서|상|팔","徐|相|八")·#ruby("이|항|직","李|恒|稙")·#ruby("이|희|간","李|僖|侃")·#ruby("기|산|도","奇|山|濤")·#ruby[전|병|헌][全|炳|憲]\(王三德)·#ruby("유|두|환","柳|斗|煥")·#ruby("김|기|홍","金|基|弘")·#ruby("김|구","金|龜") #ruby("등","等")이었다. #ruby("회|의","會|議") #ruby("결|과","結|果") #ruby("상|소","上|疏")를 올리기로 #ruby("결|정","決|定")하고 #ruby("이|준","李|儁")#footnote(numbering: _ => [3)])[#h(0.35em)#ruby[이|준][李|儁]\(1858〜1907). #ruby("이|준","李|儁")은 1904#ruby("년","年") #ruby("공|진|회","共|進|會") #ruby("회|장","會|長")으로 #ruby("국|권|수|호|운|동","國|權|守|護|運|動")을 하다 6#ruby("개|월|간","個|月|間") #ruby("유|배","流|配")되었다. #ruby("유|배","流|配")에서 돌아온 그는 1905#ruby("년","年") #ruby("을|사|조|약","乙|巳|條|約") #ruby("반|대","反|對") #ruby("상|소|운|동","上|疏|運|動")을 #ruby("주|도","主|導")하였고, 1907#ruby("년","年") #ruby("고|종","高|宗")의 #ruby("밀|사","密|使")로 #ruby("헤이그","海牙")에 가서 #ruby("순|국","殉|國")하였다.]이 #ruby[상소문][疏文]을 지었다. #ruby("제|1|회","第|一|回") #ruby("소|수","疏|首")#footnote(numbering: _ => [4)])[#h(0.35em)#ruby("소|수","疏|首")는 #ruby("소|두","疏|頭"). #ruby("소|장","疏|章")의 #ruby("서|명","署|名") #ruby("명|단","名|單") #ruby("중","中") #ruby("제|일","第|一") 위에 있는 #ruby("자","者").]는 #ruby("최|재|학","崔|在|學")이고, 그밖에 네 사람을 더하여 다섯 사람이 #ruby("신|민","臣|民")의 #ruby("대|표","代|表") #ruby("명|의","名|義")로 #ruby("서|명","署|名")하였다. 다섯 사람만 #ruby("상|소","上|疏")한 것은, #ruby("상|소","上|疏")하면 반드시 #ruby("사|형","死|刑")될 것이요, #ruby("사|형","死|刑")되면 다시 다섯 사람씩 몇 #ruby("차|례","次|例")든지 #ruby("계|속","繼|續")할 #ruby("작|정","作|定")이었기 때문이다.]
#zh[那时聚集在尚洞的人物有全德基、郑淳万、李俊、李东宁、崔在学、桂明陆、金仁戬、玉观彬、李承吉、车炳修、申尚敏、金泰渊、表永珏、曹成焕、徐相八、李恒植、李喜侃、奇山涛、全炳宪（今名王三德）、柳斗焕、金基弘和我——金龟。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("정|순|만","鄭|淳|萬")의 #ruby("인|도","引|導")로 #ruby("교|회|당","敎|會|堂")에서 #ruby("맹|세","盟|誓")의 #ruby("기|도","祈|禱")를 하고, 모두 #ruby("대|한|문","大|漢|門") 앞으로 나갔다. #ruby("서|명","署|名")한 다섯 사람만 #ruby("궐|문","闕|門") 밖에서 #ruby("형|식|상","形|式|上")으로 #ruby("회|의","會|議")를 열어 #ruby("상|소","上|疏")를 #ruby("의|결","議|決")하였지만, #ruby("상|소|장","上|疏|章")은 벌써 #ruby("별|감","別|監")들의 #ruby("협|조","協|助")로 #ruby("상|감","上|監")께 올려졌다.]
#zh[会议结果决定上疏，第一次疏文由李俊执笔，而由崔在学领衔，再加四人签名，共五名市民代表联名。如果失败，则再继续请愿。去上疏之前，我们这一批人由郑淳万主持，聚集在尚洞教会，作宁死不屈的盟誓祈祷，然后全体赶到大汉门前，由在疏文上签名的五位，在宫阙门前开了形式上的会议，通过了上疏的决议，其实疏状早就通过别监（官名）呈递给皇上了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 갑자기 #ruby("왜","倭")놈 #ruby("순|사|대","巡|査|隊")가 달려와서 #ruby("간|섭","干|涉")했다. 다섯 사람이 #ruby("일|시","一|時")에 #ruby("왜","倭")놈 #ruby("순|사","巡|査")에게 달려들어 #ruby("내|정|간|섭","內|政|干|涉")을 #ruby("규|탄","糾|彈")하였다. #ruby("즉|각","卽|刻") #ruby("대|한|문","大|漢|門") 앞에는 #ruby("왜","倭")놈의 칼이 번쩍번쩍 빛났고 다섯 #ruby("지|사","志|士")는 맨주먹으로 싸움을 #ruby("시|작","始|作")하였다. #ruby("근|처","近|處")에서 #ruby("호|위","護|衛")하던 우리들은 소리를 #ruby("벽|력","霹|靂")같이 지르며, “#ruby("왜","倭")놈이 #ruby("국|권","國|權")을 #ruby("강|탈","強|奪")하고 #ruby("조|약","條|約")을 #ruby("강|제","强|制")로 #ruby("체|결","締|結")하는데, 우리 #ruby("인|민","人|民")은 #ruby("원|수","怨|讐")의 #ruby("노|예","奴|隸")가 되어 살 것인가 #ruby("의","義")롭게 죽을 것인가” 하는 #ruby("격|분","激|憤")한 #ruby("연|설","演|說")을 곳곳에서 하니 #ruby("인|심","人|心")이 #ruby("흉|흉","洶|洶")해졌다.]
#zh[这时忽然跑来了日本警察队，强迫我们解散，我们抗议说这是干涉我们的内政。霎时间刀光剑影，五位志士赤手空拳跟他们展开搏斗，我们护卫着他们，高声怒吼。我们一方面反抗，一方面以誓死抵抗的精神发表激烈的演说，谓日人侵犯了我国的主权，强迫缔结把我们人民视为奴隶的条约，此时群情激愤。结果日本警察队抓走了在疏状上签名的五位志士，把他们押往警务厅。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다섯 #ruby("지|사","志|士")는 #ruby("경|무|청","警|務|廳")에 #ruby("감|금","監|禁")되었는데 #ruby("심|문","訊|問")하는 것을 보니 #ruby("결|국","結|局") #ruby("훈|방","訓|放")할 #ruby("모|양","模|樣")이었다. 우리는 #ruby("계|속","繼|續") #ruby("상|소","上|疏")하는 것을 그만두고, #ruby("종|로","鍾|路")에서 #ruby("공|개|연|설","公|開|演|說")을 하다 #ruby("금|지","禁|止")당하면 #ruby("대|대|적","大|大|的")인 #ruby("육|박|전","肉|薄|戰")을 #ruby("전|개","展|開")하기로 했다. #ruby("종|로","鍾|路")에서 #ruby("연|설","演|說")을 하니 #ruby("왜|순|사","倭|巡|査")가 칼을 뽑아들었다. #ruby("연|설","演|說")하던 #ruby("청|년","靑|年")이 맨손으로 달려들어 발로 차 #ruby("왜|순|사","倭|巡|査")를 땅에 거꾸러뜨리자, #ruby("왜","倭")놈들이 #ruby("총","銃")을 쏘기 #ruby("시|작","始|作")했다. 그때 마침 #ruby("어|물|전","魚|物|廛") #ruby[도매점][魚廛都家]이 #ruby("화|재","火|災")를 당한 뒤라 기와조각이 #ruby("산","山")처럼 쌓여 있어, 우리 몇 사람이 그 기와조각을 #ruby("왜|순|사|대","倭|巡|査|隊")를 #ruby("향","向")해 던지며 #ruby("접|전","接|戰")이 #ruby("시|작","始|作")되었다. #ruby("왜|순|사","倭|巡|査")놈들은 #ruby("중|국|인","中|國|人") #ruby("상|점","商|店")에 #ruby("침|입","侵|入")하여 #ruby("잠|복","潛|伏")한 채 #ruby("총","銃")을 #ruby("발|사","發|射")하였다. #ruby("군|중","群|衆")이 기와조각을 #ruby("중|국","中|國") #ruby("점|포","店|舖")에 던지자, #ruby("왜|보|병","倭|步|兵") 1#ruby("개","個") #ruby("중|대","中|隊")가 #ruby("포|위","包|圍")하여 #ruby("공|격","攻|擊")했다. #ruby("인|산|인|해","人|山|人|海")를 이루던 #ruby("군|중","群|衆")은 제#ruby("각|각","各|各") 흩어졌고, #ruby("왜","倭")놈들은 #ruby("한|인","韓|人")을 잡히는 대로 #ruby("포|박","捕|縛")하니 #ruby("수|십","數|十") #ruby("명","名")이 #ruby("체|포","逮|捕")·#ruby("감|금","監|禁")되었다.]
#zh[我们亲眼看到五位志士被抓走，因此我们聚集在钟路，开始作街头演说。在那里日本警察拔出了佩刀，想要驱散群众。当时恰巧有一家水产批发店遭了火灾，现场瓦砾成堆，我们就投掷碎瓦片和日本警察交战，日本警察寡不敌众，退到了一家中国人开设的店铺，作为掩护，向我们开枪射击，我们也向那个店铺雨点般地投掷瓦片。这个时候又有一个中队的日本兵开到，冲散了街头的群众，他们见人就捆，被抓去的约有几十名之多。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 #ruby("민|영|환","閔|泳|煥")#footnote(numbering: _ => [5)])[#h(0.35em)#ruby[민|영|환][閔|泳|煥]\(1861〜1905). #ruby("민|영|환","閔|泳|煥")은 1905#ruby("년","年") #ruby("을|사|늑|약","乙|巳|勒|約")이 #ruby("체|결","締|結")되자 이를 #ruby("반|대","反|對")하는 #ruby("상|소","上|疏")를 올렸고, 그 #ruby("효|과","效|果")가 없자 1905#ruby("년","年") 11#ruby("월","月") 30#ruby("일","日") #ruby("국|민","國|民")과 #ruby("각|국","各|國") #ruby("공|사","公|使")에게 고하는 #ruby("유|서","遺|書")를 남기고 #ruby("자|결","自|決")하였다. #ruby("시|호","諡|號")는 #ruby("충|정","忠|正").]이 #ruby("자|결","自|決")하였다. 그 #ruby("보|도","報|道")를 접하고 몇몇 #ruby("동|지","同|志")들과 같이 #ruby("민|영|환","閔|泳|煥") 댁에 가서 #ruby("조|문","弔|問")을 마치고 돌아서 큰 #ruby("도|로","道|路")에 나오는 때였다. 나이가 #ruby("사|십","四|十") 안팎쯤 되어 보이는 어떤 한 사람이, 흰 #ruby("명|주","明|紬")저고리에 갓 #ruby("망|건","網|巾")도 없이 맨상투 바람으로 #ruby("의|복","衣|服")에 핏자국이 얼룩덜룩한 채 여러 사람의 #ruby("호|위","護|衛")를 받으며 #ruby("인|력|거","人|力|車")에 실려가는데, 크게 소리치며 울부짖는 것이었다. 누구냐고 물으니, #ruby("참|찬","參|贊") #ruby("이|상|설","李|相|卨")#footnote(numbering: _ => [6)])[#h(0.35em)#ruby[이|상|설][李|相|卨]\(1870〜1917). 이 #ruby("시|기","時|期") #ruby("선|구|적","先|驅|的")인 #ruby("풍|운","風|雲")의 #ruby("민|족|운|동|가","民|族|運|動|家"). 그는 #ruby("을|사|늑|약","乙|巳|勒|約")을 #ruby("전|후","前|後")하여 #ruby("일|본","日|本")을 #ruby("규|탄","糾|彈")하는 #ruby("상|소|운|동","上|疏|運|動")을 #ruby("주|도","主|導")하고, 1906#ruby("년","年") #ruby("북|간|도","北|間|島") #ruby("용|정","龍|井")으로 #ruby("망|명","亡|命")하였다. 그는 1907#ruby("년","年") #ruby("고|종","高|宗")의 #ruby("밀|사","密|使")로 #ruby("헤이그","海牙")에 갔으며, 그것이 #ruby("실|패","失|敗")하자 #ruby("러|시|아","俄|西|亞") #ruby("연|해|주","沿|海|州")로 가서 #ruby("권|업|회","勸|業|會")를 #ruby("조|직","組|織")하였다.]인데 #ruby("자|살","自|殺") #ruby("미|수","未|遂")에 그쳤다 한다. 그이도 나라일이 날로 잘못되어 감을 보고 #ruby("의|분","義|憤")을 못 이겨 #ruby("자|살","自|殺")하려던 것이었다.]
#zh[这天得到闵泳焕自杀的消息，我和几位同志到闵家去吊唁，归途中在大街上看到一个约有四十岁左右，头上梳着发髻的男人，白绢上衣血迹斑斑，坐在人力车上大哭大叫，被几个人前呼后拥地拉走。我打听了一下是谁，人群中有人回答说是自杀未遂的参赞李相卨。他也是因见国势日衰，义愤填膺而萌发了自杀的念头。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|초","當|初") #ruby("상|동|회|의","尙|洞|會|議")에서는 다섯 #ruby("내|지","乃|至") 여섯 사람이 한 #ruby("조","組")가 되어 몇 #ruby("차|례","次|例")든 비록 앞사람이 죽더라도 뒷사람은 이어 #ruby("계|속","繼|續")하기로 하였으나, #ruby("상|소","上|疏")하여 #ruby("체|포","逮|捕")당한 #ruby("지|사","志|士")들을 몇십 #ruby("일","日") #ruby("구|류","拘|留")에만 #ruby("처","處")하고 말 #ruby("정|황","情|況")이니 #ruby("계|속","繼|續")할 #ruby("필|요","必|要")가 없어졌다. 아무리 #ruby("급|박","急|迫")하여도 #ruby("국|가|흥|망","國|家|興|亡")에 대한 #ruby("절|실","切|實")한 #ruby("각|오","覺|悟")가 적은 #ruby("민|중","民|衆")과 더불어서는 무슨 일이나 #ruby("실|효","實|效") 있게 할 수가 없다. 바꿔 말하면 아직 #ruby("민|중","民|衆")의 #ruby("애|국|사|상","愛|國|思|想")이 #ruby("박|약","薄|弱")한 것이다.]
#zh[当初，尚洞会议决定五人至六人编成一组，不论多少次，前人虽死，后人继续。然而上疏被捕的志士只被处几十日拘留便要了结，继续下去已无必要。不论形势多么急迫，与对国家兴亡缺乏切实觉悟的民众在一起，什么事都收不到实效。换句话说，民众的爱国思想还很薄弱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("칠|년|병","七|年|病") #ruby("삼|년|애","三|年|艾")”#footnote(numbering: _ => [7)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “7#ruby("년","年") 묵은 #ruby("병","病")에 3#ruby("년","年") 묵은 쑥을 구한다”. #ruby("원|래","原|來")는 ‘七年之病 求三年艾’으로 #ruby("범|순|인","范|純|仁")의 말. 7#ruby("년","年") 동안이나 오래 앓은 고생한 #ruby("병","病")에 3#ruby("년","年") 걸리지 않으면 #ruby("생|장","生|長")할 수 없는 쑥을 구한다는 것으로, #ruby("평|소","平|素")에 미리 갖추어 놓지 않고 #ruby("필|요","必|要")한 때 급히 구하면 얻지 못한다는 뜻이다.]는 #ruby("격","格")으로 때는 늦었으나마, #ruby("인|민","人|民")의 #ruby("애|국|사|상","愛|國|思|想")을 #ruby("고|취","鼓|吹")하여 #ruby("인|민","人|民")으로 하여금 #ruby("국|가","國|家")가 곧 #ruby("자|기","自|己") 집인 줄을 깨닫고, #ruby("왜","倭")놈이 곧 #ruby("자|기","自|己") #ruby("생|명","生|命")과 #ruby("재|산","財|産")을 빼앗고 #ruby("자|기","自|己") #ruby("자|손","子|孫")을 #ruby("노|예","奴|隸")로 삼을 줄을 #ruby("분|명","分|明")히 깨닫도록 하는 수밖에 다른 #ruby("최|선|책","最|善|策")이 없다고 생각했다. 그때 모였던 #ruby("동|지","同|志")들이 #ruby("사|방","四|方")으로 헤어져서 #ruby("애|국|사|상","愛|國|思|想")을 #ruby("고|취","鼓|吹")하고 #ruby("신|교|육","新|敎|育")을 #ruby("실|시","實|施")하기로 하여, 나도 다시 #ruby("황|해|도","黃|海|道")로 돌아와 #ruby("교|육","敎|育")에 #ruby("종|사","從|事")하였다.]
#zh[虽是“七年之病，求三年之艾”，为时已晚，但我想除此以外别无善策，只有鼓吹人民的爱国思想，使他们明白国家就是自己的家，明白倭寇正要夺取自己的生命和财产，把自己的子孙变为奴隶。当时聚集的同志便分散四方，鼓吹爱国思想，实施新教育，我也再回到黄海道，从事教育。]
#heading(level: 3)[#text(font: "KOPUSGo B")[2) #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校")와 #ruby("하|기","夏|期") #ruby("사|범|강|습","師|範|講|習")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("장|련","長|連")을 떠나 내 나이 33#ruby("세","歲")인 #ruby[무|신|년][戊|申|年]\(1908)#footnote(numbering: _ => [8)])[#h(0.35em)이듬해 #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校")로 옮겨 #ruby("하|기","夏|期") #ruby("사|범|강|습|회","師|範|講|習|會")를 #ruby("개|최","開|催")한 것이 1907#ruby("년","年")이므로, #ruby("종|산","鍾|山") #ruby("서|명|의|숙","西|明|義|塾") #ruby("교|사","敎|師")가 된 것은 1906#ruby("년","年")\(31#ruby("세","歲"))으로 보는 것이 #ruby("타|당","妥|當")하다.]9#ruby("월","月") 9#ruby("일","日"), #ruby("문|화","文|化") #ruby("초|리|면","草|里|面") #ruby("종|산","鍾|山")에 #ruby("거|주","居|住")하면서 그 동네 #ruby("사|립","私|立") #ruby("서|명|의|숙","西|明|義|塾")의 #ruby("교|사","敎|師")가 되어 #ruby("농|촌","農|村") #ruby("아|동","兒|童")을 가르쳤다. 그러다가 그 이듬해 #ruby("정|월","正|月") 18#ruby("일","日") #ruby("안|악|읍","安|岳|邑")으로 옮겨, #ruby("읍","邑")에 #ruby("신|설","新|設")한 #ruby("사|립","私|立") #ruby("양|산|학|교","楊|山|學|校")의 #ruby("교|사","敎|師")가 되어 #ruby("근|무","勤|務")하였다. #ruby("장|련","長|連")에서 #ruby("종|산","鍾|山")으로 갈 때는 #ruby("우|종|서","禹|鍾|瑞") #ruby("목|사","牧|師")의 #ruby("간|청","懇|請")으로 갔는데, #ruby("서|명|의|숙","西|明|義|塾")이 #ruby("산|촌","山|村")에 있어 #ruby("발|전|성","發|展|性")이 보이지 않는데다, #ruby("김|용|제","金|庸|濟") #ruby("등","等") 몇몇 #ruby("친|구","親|舊")의 부름에 따라 #ruby("안|악|읍","安|岳|邑")으로 옮기게 된 것이었다.]
#zh[我是应禹钟瑞老师的邀请，从长连来到钟山的。翌年，我又迁到安岳。这是因为西明义塾设在山村，没有什么发展前途，加上安岳的金庸济等几位知己的邀请，所以就转到安岳任新设的私立杨山学校的教员。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|명|의|숙","西|明|義|塾")에서 #ruby("근|무","勤|務")할 때, #ruby("의|병|장","義|兵|將") #ruby("우|동|선","禹|東|鮮")#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("원|문","原|文"): “禹東善”. ‘禹東善’은 ‘禹東鮮’의 #ruby("오|류","誤|謬"). #ruby[우|동|선][禹|東|鮮]\(1870〜1908)은 #ruby("황|해|도","黃|海|道") #ruby("문|화","文|化") #ruby("출|신","出|身")의 #ruby("의|병","義|兵"). #ruby("을|사|의|병","乙|巳|義|兵") #ruby("당|시","當|時") #ruby("격|전","激|戰")을 벌이다 #ruby("체|포","逮|捕")된 그는 #ruby("감|옥","監|獄")에서 #ruby("감|시|병","監|視|兵")의 #ruby("총","銃")을 빼앗아 #ruby("일|본|군","日|本|軍") 8#ruby("명","名")을 #ruby("사|살","射|殺")하고 끝까지 #ruby("교|전","交|戰")하다 #ruby("사|망","死|亡")하였다.]이 10#ruby("리","里")쯤 떨어진 #ruby("내|동","內|洞")에 #ruby("진","陣")을 치고 있다가 #ruby("왜|병","倭|兵")의 #ruby("야|간","夜|間") #ruby("습|격","襲|擊")으로 #ruby("달|천","達|泉") #ruby("부|근","附|近")에서 크게 #ruby("패","敗")하고, 그중 17#ruby("명","名")의 #ruby("의|병","義|兵") #ruby("시|체","屍|體")가 #ruby("내|동","內|洞") #ruby("동|구","洞|口") 밖 길가에 널려 있다는 #ruby("보|도","報|道")를 들었다. 그때 마침, #ruby("왜|병","倭|兵") 세 #ruby("명","名")이 #ruby("총|기","銃|器")를 #ruby("휴|대","携|帶")하고 #ruby("종|산","鍾|山")에 들어와 집집마다 다니며 #ruby("계|란","鷄|卵")과 닭을 #ruby("약|탈","掠|奪")하고 다닌다고, #ruby("동|장","洞|長")이 놀라 찾아와 #ruby("보|고","報|告")하는 것이었다.]
#zh[在西明义塾任教时，义兵将领禹东善在相距约十里的内洞布阵，遭到倭兵夜袭，在达泉附近大败，其中十七名义兵的尸体横陈在内洞洞口外的路上。听到这一消息时，恰有三名倭兵携带枪支进了钟山，挨家挨户抢夺鸡蛋和鸡。洞长惊慌，跑来报告。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("동|장","洞|長") #ruby("우|창|제","禹|昌|濟")의 집에 같이 가 보니, #ruby("왜|병","倭|兵")이 산 닭과 #ruby("계|란","鷄|卵")을 마구 #ruby("약|탈","掠|奪")하고 있었다.#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("당|시","當|時") #ruby("일|본|군","日|本|軍")은 #ruby("의|병","義|兵")과 그 #ruby("관|련|자","關|聯|者")들을 #ruby("흉|폭","兇|暴")하게 #ruby("살|해","殺|害")하였을 뿐만 아니라 #ruby("전|국","全|國")의 개와 닭을 잡아 “13#ruby("도","道") #ruby("강|산","江|山")에서 개와 닭의 소리가 끊기었다”고 할 #ruby("정|도","程|度")였다.] 나는 그 #ruby("왜|병","倭|兵")에게 #ruby("필|담","筆|談")으로 물었다.]
#zh[我和洞长禹昌济一起到他家一看，倭兵正在乱抢活鸡和鸡蛋。我用笔谈问那些倭兵：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("군|대","軍|隊")에서 #ruby("물|품","物|品")을 #ruby("징|발","徵|發")하는 것이냐, 돈 주고 사는 것이냐?”]
#zh[“这是军队征收物品，还是出钱购买？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“돈 주고 사는 것이다.”]
#zh[他们说是购买。我又问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇다면 #ruby("달|천","達|泉") #ruby("시|장","市|場")에서 #ruby("구|입","購|入")할 수 있거늘 왜 이같이 #ruby("촌|민","村|民")을 #ruby("압|박","壓|迫")하느냐.”]
#zh[“要买的话，你们应该去达泉市场，何必骚扰百姓？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신이 #ruby("문|화","文|化") #ruby("군|수","郡|守")냐?”]
#zh[鬼子不回答我的问话，反问我道：]
#zh[“你是文化郡郡守吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("서|명|의|숙","西|明|義|塾") #ruby("교|사","敎|師")이다.”]
#zh[“我是西明义塾的教师。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한 놈이 나와 #ruby("문|답","問|答")하는 사이에 나머지 #ruby("왜|병","倭|兵")은 밖으로 나가 앞집, 뒷집에서 닭을 몰아 안마당으로 #ruby("돌|입","突|入")하니, #ruby("부|인","夫|人")과 어린 아이들이 놀라 소리를 지른다. 나는 #ruby("동|장","洞|長")에게 #ruby("호|령","號|令")했다.]
#zh[其他鬼子趁我和这个鬼子谈话的时机，窜到旁边人家的院子里去抓鸡，吓得妇女孩子们哭喊连天。]
#zh[我呵斥洞长道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("도|적","盜|賊")이 집집마다 쳐들어온다는데, #ruby("동|장","洞|長")은 #ruby("실|태","實|態")도 #ruby("관|찰","觀|察")하지 않는가?”]
#zh[“你是一洞之长，强盗到各家行劫，你却袖手旁观？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나와 #ruby("문|답","問|答")하던 #ruby("왜|병","倭|兵")이 #ruby("호|각","號|角")을 부니, #ruby("외|출","外|出")하였던 놈들이 닭을 한 손에 두세 마리씩 들고 들어왔다. 그놈들이 무슨 말을 하더니, #ruby("강|탈","強|奪")한 닭을 내버리고 동네 바깥으로 나갔다. “아랫동네에서는 집집마다 닭을 잡아 몇 짐이나 지고 갔다”며 동네사람들이 #ruby("후|환","後|患")을 두려워하기에, 나에게 맡기라고 했다.]
#zh[这时，和我谈话的那个鬼子吹起了哨子，窜到别家的鬼子手提着两三只鸡跑了进来。他们嘀咕了一阵子，放下了抢来的鸡，向村外跑去。但是听说去到别的村子的鬼子都把鸡抢跑了。钟山洞的村民怕由此惹出祸端，我安慰他们说一切后果由我承担。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("종|산","鍾|山")에서 첫아기로 딸을 낳았다. 태어난 지 며칠 만에 #ruby("모|녀","母|女")를 #ruby("가|마","轎|子")에 태워 와서 찬#ruby("기|운","氣|運")을 많이 쐰 탓인지, 딸아이는 #ruby("안|악","安|岳")에 #ruby("도|착","到|着")한 #ruby("후","後") 바로 죽고 말았다.]
#zh[从钟山搬到安岳是己酉年正月十八日，初生的大女儿，经不起凛冽的北风吹袭，一到安岳就夭折了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악|군","安|岳|郡")에는 #ruby("당|시","當|時") #ruby("십|수|명","十|數|名")의 #ruby("유|지","有|志")가 있었는데, #ruby("김|용|제","金|庸|濟")·#ruby("김|용|진","金|庸|震")·#ruby("김|홍|량","金|鴻|亮")·#ruby("이|시|복","李|始|馥")·#ruby("이|상|진","李|相|晋")·#ruby("최|재|원","崔|在|源")·#ruby("장|윤|근","張|允|根")·#ruby("김|종|원","金|鍾|元")·#ruby("최|명|식","崔|明|植")·#ruby("김|형|종","金|亨|鍾")·#ruby("김|기|형","金|基|瑩")·#ruby("표|치|정","表|致|禎")·#ruby("장|명|선","張|明|善")·#ruby("차|승|용","車|承|用")·#ruby("한|필|호","韓|弼|浩")·#ruby("염|도|선","廉|道|善")·#ruby("전|승|근","田|承|根")·#ruby("함|덕|희","咸|德|熙")·#ruby("장|응|선","張|應|璇")·#ruby("원|인|상","元|仁|常")·#ruby("원|정|부","元|貞|溥")·#ruby("송|영|서","宋|永|瑞")·#ruby("송|종|서","宋|鍾|瑞")·#ruby("김|용|승","金|庸|昇")·#ruby("김|용|필","金|庸|弼")·#ruby("한|응|조","韓|應|祚") #ruby("등","等")은 #ruby("중|년","中|年") 및 #ruby("청|년","靑|年")이요, #ruby("김|효|영","金|孝|英")·#ruby("이|인|배","李|仁|培")·#ruby("최|용|화","崔|龍|化")·#ruby("박|남|병","朴|南|秉")·#ruby("박|도|병","朴|道|秉")·#ruby("송|한|익","宋|漢|益") #ruby("선|배","先|輩")들은 그 #ruby("군|내","郡|內") #ruby("중|견","中|堅") #ruby("인|물","人|物")인데, 여기 #ruby("기|록","記|錄")한 #ruby("인|원","人|員")은 #ruby("직|접","直|接") 나의 일 즉 #ruby("교|육|사|업","敎|育|事|業")에 #ruby("관|계","關|係") 있는 사람만 헤아려 본 것이다.#footnote(numbering: _ => [11)])[#h(0.35em)#ruby("안|창|호","安|昌|浩")가 “13#ruby("개","個") #ruby("도","道")마다 #ruby("안|악|군","安|岳|郡") 같은 고을이 하나씩만 있으면, 이 나라는 10#ruby("년","年") 안에 #ruby("일|본","日|本")을 따라잡을 수 있을 것이다”라고 #ruby("격|찬","激|讚")한 바와 같이 #ruby("당|시","當|時") #ruby("안|악|군","安|岳|郡")은 #ruby("신|교|육","新|敎|育")의 #ruby("선|구|지|대","先|驅|地|帶")였다.]]
#zh[安岳郡当时有十余名有志之士。金庸济、金庸震、金鸿亮、李始馥、李相晋、崔在源、张允根、金钟元、崔明植、金亨钟、金基莹、表致贞、张明善、车承用、韩弼浩、廉道善、田承根、咸德熙、张应璇、元仁常、元贞溥、宋永瑞、宋钟瑞、金庸升、金庸鼎、韩应祚等，是中年及青年；金孝英、李仁培、崔龙化、朴南秉、朴道秉、宋汉益等前辈，则是郡内的中坚人物。这里所记的，只是和我的事业、也就是教育事业直接有关的人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("신|교|육","新|敎|育")의 #ruby("필|요","必|要")를 #ruby("절|감","切|感")하여 #ruby("김|홍|량","金|鴻|亮")#footnote(numbering: _ => [12)])[#h(0.35em)#ruby[김|홍|량][金|鴻|亮]\(1885〜1950). #ruby("황|해|도","黃|海|道") #ruby("안|악","安|岳") #ruby("출|신","出|身"). 1906#ruby("년","年") #ruby("김|구","金|龜")가 #ruby("운|영","運|營")하는 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("설|립","設|立")하였고, 1910#ruby("년","年") 12#ruby("월","月") #ruby("만|주","滿|洲") #ruby("안|동|현","安|東|縣")에서 #ruby("농|장","農|場")과 #ruby("무|역","貿|易")을 #ruby("경|영","經|營")하면서 #ruby("신|민|회","新|民|會")의 #ruby("독|립|군","獨|立|軍") #ruby("기|지","基|地") #ruby("건|설","建|設")을 #ruby("지|지","支|持")하였다. 1911#ruby("년","年") #ruby("안|명|근","安|明|根") #ruby("사|건","事|件")에 #ruby("연|루","連|累")되어 #ruby("징|역","懲|役")을 살다 1919#ruby("년","年")에 #ruby("석|방","釋|放")되었다.]·#ruby("최|재|원","崔|在|源") #ruby("외","外") 몇몇 #ruby("청|년","靑|年")은 #ruby("경|성","京|城")과 #ruby("일|본","日|本")에 #ruby("유|학","留|學")하고, #ruby("선|배","先|輩") #ruby("등","等")은 #ruby("교|육","敎|育") #ruby("발|달","發|達")에 #ruby("성|심","誠|心")껏 #ruby("노|력","努|力")해서, 그 #ruby("읍|내","邑|內") #ruby("예|수|교|회","耶|蘇|敎|會")에 #ruby("제|1|차","第|一|次")로 #ruby("안|신|학|교","安|新|學|校")가 #ruby("설|립","設|立")되었고, 그 다음 #ruby("사|립","私|立") #ruby("양|산|학|교","楊|山|學|校")가 #ruby("설|립","設|立")되었다.#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("안|신|학|교","安|新|學|校")에는 #ruby("기|독|교|계","基|督|敎|界") #ruby("자|녀","子|女")들이, #ruby("향|청","鄕|廳")자리에 세워진 #ruby("양|산|학|교","楊|山|學|校")에는 #ruby("비|기|독|계","非|基|督|界") #ruby("자|녀","子|女")들이 #ruby("주","主")로 다녔다.] 그#ruby("후","後")에 #ruby("공|립","公|立") #ruby("보|통|학|교","普|通|學|校")가 #ruby("설|립","設|立")되었으며, #ruby("동|창","東|倉")의 #ruby("배|영|학|교","培|英|學|校"), #ruby("용|순","龍|順")의 #ruby("유|신|학|교","維|新|學|校") #ruby("등","等")이 잇따라 #ruby("설|립","設|立")되었다.]
#zh[他们痛感实施新教育的必要。金鸿亮、崔在源等几名青年到汉城和日本留学，前辈们则尽心致力于教育的发达。邑内耶稣教会首先设立了安新学校，接着设立了私立杨山学校。此后公立普通学校成立，东仓的培英学校、龙顺的维新学校等相继设立。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|해","黃|海")·#ruby("평|안","平|安") #ruby("양|도","兩|道")의 #ruby("교|육|계","敎|育|界")나 #ruby("학|생|계","學|生|界")에서 #ruby("평|양","平|壤")의 #ruby("최|광|옥","崔|光|玉")이 #ruby("제|일","第|一") #ruby("신|망","信|望")을 가진 #ruby("청|년","靑|年")이었으므로, 그를 #ruby("초|빙","招|聘")하여 #ruby("양|산|학|교","楊|山|學|校")에서 #ruby("하|기","夏|期") #ruby("사|범|강|습","師|範|講|習")을 열었다.#footnote(numbering: _ => [14)])[#h(0.35em)#ruby[최|광|옥][崔|光|玉]\(1879〜1910). #ruby("평|양","平|壤")의 #ruby("숭|실|학|교","崇|實|學|校")와 #ruby("일|본","日|本") #ruby("메이지","明治")#ruby("대|학","大|學")을 #ruby("졸|업","卒|業")한 #ruby("후","後") 1906#ruby("년","年") #ruby("황|해|도","黃|海|道") #ruby("안|악|지|역","安|岳|地|域")을 #ruby("중|심","中|心")으로 하는 #ruby("면|학|회","勉|學|會") #ruby("결|성","結|成")을 #ruby("주|도","主|導")하였다. #ruby("면|학|회","勉|學|會")는 #ruby("회|장","會|長") #ruby("임|택|권","林|澤|權") #ruby("이|하","以|下") #ruby("초|기","初|期") #ruby("회|원","會|員")이 20#ruby("여","餘") #ruby("명","名")이었고 #ruby("본|부","本|部")는 #ruby("정|명|재","鄭|明|哉")의 집에 두었다. #ruby("면|학|회","勉|學|會")는 #ruby("김|구","金|龜")의 #ruby("양|산|학|교","楊|山|學|校")와 #ruby("공|동","共|同")으로 1907#ruby("년","年")에서 1909#ruby("년","年")까지 3#ruby("년|간","年|間") #ruby("하|기","夏|期") #ruby("사|범|강|습|회","師|範|講|習|會")를 열었다. #ruby("제|1|회","第|一|回") #ruby("강|습|회","講|習|會")의 #ruby("주|제","主|題")는 ‘무너져가는 #ruby("조|국","祖|國")을 일으켜 세우려면 #ruby("자|녀","子|女")를 #ruby("교|육","敎|育")시켜라’였다. #ruby("강|습|회","講|習|會")에서 #ruby("최|광|옥","崔|光|玉")은 #ruby("국|어","國|語")·#ruby("생|리|학","生|理|學")·#ruby("물|리|학","物|理|學")·#ruby("식|물|학","植|物|學")·#ruby("경|제|학","經|濟|學") #ruby("등","等") 가장 많은 #ruby("과|목","科|目")을 #ruby("담|당","擔|當")하였다. #ruby("면|학|회","勉|學|會")는 1908#ruby("년","年") #ruby("해|서|교|육|총|회","海|西|敎|育|總|會")로 #ruby("발|전","發|展")하였다.] #ruby("황|해|도","黃|海|道")에서 #ruby("교|육","敎|育")에 #ruby("종|사","從|事")하는 #ruby("인|사","人|士")는 시골의 #ruby("서|당","書|堂") #ruby("훈|장","訓|長")까지 불러모았고, #ruby("평|안|남|북|도","平|安|南|北|道")의 #ruby("유|지","有|志")나 #ruby("교|육|자","敎|育|者"), #ruby("경|기","京|畿")·#ruby("충|청|도","忠|淸|道")의 #ruby("강|습|생","講|習|生")까지 몰려와서 400#ruby("여","餘") #ruby("명","名")에 달했다. #ruby("강|사","講|師")로는 #ruby("김|홍|량","金|鴻|亮"), #ruby("이|시|복","李|始|馥"), #ruby("이|상|진","李|相|晋"), #ruby("한|필|호","韓|弼|浩"), #ruby("이|보|경","李|寶|慶"),#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("원|주","原|註"): “今 光洙”. #ruby("춘|원","春|園") #ruby("이|광|수","李|光|洙")의 #ruby("아|명","兒|名")이 #ruby("이|보|경","李|寶|慶")이다. #ruby("이|광|수","李|光|洙")는 #ruby("일|본","日|本") #ruby("유|학","留|學")\(1905#ruby("년","年")〜1906#ruby("년","年") 12#ruby("월","月"), 1907#ruby("년","年") 2#ruby("월","月")〜1910#ruby("년","年") 3#ruby("월","月")) #ruby("이|후","以|後") #ruby("귀|국","歸|國")하여 #ruby("정|주","定|州") #ruby("오|산|학|교","五|山|學|校") #ruby("교|원","敎|員")이 된다. 그는 1907#ruby("년","年") 여름#ruby("방|학","放|學")#ruby("중","中") #ruby("일|시","一|時") #ruby("귀|국","歸|國")하여 #ruby("안|악|면|학|회","安|岳|勉|學|會")의 #ruby("하|계|수|련|회","夏|季|修|練|會")에서 #ruby("서|양|사","西|洋|史") #ruby("과|목","科|目")을 #ruby("담|당","擔|當")하였다.] #ruby("김|낙|영","金|洛|英"), #ruby("최|재|원","崔|在|源"), #ruby("도|인|권","都|仁|權") #ruby("외","外") 몇 사람과, #ruby("여|교|사","女|敎|師")로 #ruby("김|낙|희","金|樂|姬"), #ruby("방|신|영","方|信|榮")이 있었고, #ruby("강|습|생","講|習|生")에는 #ruby("강|구|봉","姜|九|峰"), #ruby("박|혜|명","朴|慧|明") #ruby("등","等") #ruby("승|도","僧|徒")까지 있었다.]
#zh[在黄海、平安两道的教育界和学生界，平壤的崔光玉是最孚众望的青年，因此聘请他到杨山学校举办夏季师范讲习。黄海道从事教育的人士，连乡村书堂的训长也都召集了来；平安南北道的有志之士和教育者，以及京畿、忠清道的讲习生也涌来，达四百余名。讲师有金鸿亮、李始馥、李相晋、韩弼浩、李宝庆、金洛英、崔在源、都寅权等几人，女教师有金乐姬、方信荣，讲习生中还有姜九峰、朴慧明等出家的和尚。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("박|혜|명","朴|慧|明")은 #ruby("연|전","年|前")에 나와 #ruby("경|성","京|城") #ruby("영|도|사","永|道|寺")#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("현|재","現|在")의 서울#ruby("시","市") #ruby("성|북|구","城|北|區") #ruby("안|암|동","安|岩|洞")에 있는 #ruby("개|운|사","開|運|寺"). 그런데 앞(157쪽)에서 #ruby("백|범","白|凡")은 #ruby("해|명|대|사","海|明|大|師")를 #ruby("서|대|문","西|大|門") 밖 새 절(#ruby("봉|원|사","奉|元|寺"))에서 헤어졌다고 #ruby("기|술","記|述")하였다.]에서 #ruby("피|차","彼|此")에 #ruby("백|납","白|衲")으로 헤어진 #ruby("사|형","師|兄")으로 #ruby("당|시","當|時") #ruby("패|엽|사","貝|葉|寺") #ruby("주|지|승","住|持|僧")이었는데 #ruby("강|습|회","講|習|會")에서 #ruby("우|연","偶|然")히 #ruby("상|봉","相|逢")했다. 나는 매우 반가워서 #ruby("양|산|학|교","楊|山|學|校") #ruby("사|무|실","事|務|室")에 #ruby("인|도","引|導")하고 여러 #ruby("교|사","敎|師")들에게 내 #ruby("형","兄")님이라고 #ruby("소|개","紹|介")했다. #ruby("교|사","敎|師")들은 #ruby("의|아","疑|訝")해 했다. 나이도 나보다 적어 보일 뿐 아니라, 내가 #ruby("여|동|생","女|同|生")도 없는 #ruby[외아들][獨子]임을 아는 까닭이었다. 나는 #ruby("자|초|지|종","自|初|至|終")을 #ruby("설|명","說|明")하고 나의 #ruby("친|형","親|兄")으로 알아 달라 하였다. 그리고 #ruby("승|속","僧|俗")을 #ruby("불|문","不|問")하고 #ruby("교|육","敎|育")이 #ruby("급|선|무","急|先|務")임을 #ruby("역|설","力|說")한 #ruby("결|과","結|果"), #ruby("혜|명|대|사","慧|明|大|師")도 #ruby("자|기","自|己")부터 #ruby("사|범|학","師|範|學")을 #ruby("공|부","工|夫")하여 곧 #ruby("패|엽|사","貝|葉|寺")에 #ruby("학|교","學|校")를 #ruby("설|립","設|立")하고 #ruby("승|속","僧|俗")의 #ruby("학|생","學|生")을 가르치며 #ruby("교|육","敎|育")하겠다 하였다.]
#zh[朴慧明是以前提到过的在麻谷寺时之师兄，自从年前在汉城和他分手之后一直都没有他的消息，在这次的讲习会中竟意外地重逢，倍觉心喜。当时他是九月山贝叶寺的住持，我请他到杨山学校的办公室，以我兄长的身份介绍和大家认识。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("혜|명","慧|明")은 나에게 지난 일을 이야기했다.]
#zh[慧明对我讲起往事。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("형|제","兄|弟")가 #ruby("영|도|사","永|道|寺")에서 헤어진 #ruby("후","後"), 나는 #ruby("본|사","本|寺")인 #ruby("마|곡|사","麻|谷|寺")에 돌아갔습니다. #ruby("종","宗")스님#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("원|주","原|註"): “指我”. #ruby("김|구","金|龜")를 가리킨다. #ruby("백|범","白|凡")의 #ruby("법|명","法|名")이 #ruby("원|종","圓|宗")이었다.]의 #ruby("노","老")스님이시던 #ruby("보|경|당","寶|鏡|堂")과 스님 #ruby("하|은|당","河|隱|堂") 두 늙은이가 #ruby("석|유","石|油") 한 #ruby("통","桶")을 사서, 그 좋고 나쁨을 #ruby("시|험","試|驗")하기 #ruby("위","爲")해 불이 붙은 막대기 끝을 #ruby("석|유|통","石|油|桶")에 넣자 #ruby("석|유|통","石|油|桶")이 #ruby("폭|발","爆|發")하여, 그 집안에 있던 #ruby("보|경","寶|鏡")·#ruby("하|은","河|隱")·#ruby("포|봉","抱|峯") 세 스님이 한꺼번에 #ruby("사|망","死|亡")하였습니다. 절의 #ruby("총|회","總|會")에서 #ruby("재|산","財|産")을 #ruby("관|리","管|理")하고 우리 #ruby("가|문","家|門")의 #ruby("명|성","名|聲")을 이어받을 사람은 오직 #ruby("종","宗")스님이라 #ruby("공|식","公|式") #ruby("결|정","決|定")하고, #ruby("종","宗")스님을 찾으려고 #ruby("덕|삼","德|三")스님을 #ruby("금|강|산","金|剛|山")까지 보내어 #ruby("탐|문","探|問")하였습니다. 그러나 #ruby("결|국","結|局") #ruby("종|적","蹤|跡")을 알지 못하여 그 #ruby("거|대","巨|大")한 #ruby("재|산","財|産")은 절의 #ruby("공|유","共|有")로 하고 말았습니다.”]
#zh[“我们兄弟在永道寺分手后，我回到本寺麻谷寺。宗师的老师宝镜堂和荷隐堂两位老人买了一桶石油，为了试验好坏，把燃着的木棍伸进油桶，油桶爆炸，屋里的宝镜、荷隐、抱风三位师父一并身亡。寺里总会正式决定，管理财产、接续我们家门名声的，只有宗师一人，于是派德三师父直到金刚山去打听。终于不知下落，那一大笔财产便归寺院公有了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("칠|순","七|旬")이 넘은 #ruby("김|효|영","金|孝|英") #ruby("선|생","先|生")은 #ruby("김|홍|량","金|鴻|亮")의 #ruby("조|부","祖|父")이니, 어렸을 때 #ruby("한|학","漢|學")을 #ruby("공|부","工|夫")하다가 #ruby("가|세","家|勢")가 #ruby("빈|곤","貧|困")하여 #ruby("상|업","商|業")을 #ruby("경|영","經|營")하였다. #ruby("본|도","本|道") #ruby("소|산","所|産")인 #ruby("포|목","布|木")을 사서 #ruby("자|신","自|身")의 어깨에 지고 #ruby("강|계","江|界")·#ruby("초|산","楚|山") #ruby("등|지","等|地")로 #ruby("행|상","行|商")하면서, 배가 많이 고플 때는 허리띠를 더 졸라매며 #ruby("지|극","至|極")히 #ruby("절|약","節|約")하여 #ruby("자|수|성|가","自|手|成|家")하였다 한다.]
#zh[当时年逾七旬的金孝英先生，是金鸿亮的祖父。他幼时学习汉学，后来家境贫困，便经营商业。买了本道所产的布匹，自己扛在肩上，到江界、楚山等地行商，肚子饿极了就把腰带再勒紧一扣，极其节俭，据说就此白手起家。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 뵈었을 때의 #ruby("노|선|생","老|先|生")은 비록 #ruby("기|골","氣|骨")이 #ruby("장|대","長|大")하고 #ruby("용|모","容|貌")가 #ruby("탈|속","脫|俗")하나, ㄱ#ruby("자","字") #ruby("모|양","模|樣")으로 허리가 굽어서 지팡이에 #ruby("의|지","依|支")하여 뜰에 #ruby("출|입","出|入")했다. 비록 #ruby("구|식","舊|式") #ruby("인|물","人|物")이지만 #ruby("두|뇌","頭|腦")가 #ruby("명|석","明|晳")하여, #ruby("정|세","情|勢")를 #ruby("관|찰","觀|察")하는 #ruby("능|력","能|力")은 #ruby("신|진","新|進")#ruby("청|년","靑|年") #ruby("중","中")에서도 더불어 #ruby("의|논","議|論")할 만한 #ruby("자|격","資|格")이 있는 사람이 드물었다.]
#zh[我见到老先生时，他虽然骨格魁伟，容貌脱俗，腰却弯成钩形，拄着拐杖出入庭院。虽是旧式人物，头脑却明晰，观察时势的能力，就是在新进青年中，也很少有人够资格和他议论。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|신|학|교","安|新|學|校")를 #ruby("신|설","新|設")하고, #ruby("직|원","職|員")들이 #ruby("경|비","經|費")를 #ruby("조|달","調|達")해야 하는 어려움 때문에 #ruby("회|의","會|議")를 열었을 때, #ruby("모|금|함","募|金|函")에 ‘#ruby("무|명|씨","無|名|氏") #ruby[벼][正租] #ruby("일|백","一|百") #ruby("석","石") #ruby("의|연","義|捐")’이 들어왔다. 뒷날 #ruby("김|효|영","金|孝|英") #ruby("선|생","先|生")이 #ruby("자|기","自|己") #ruby("자|손","子|孫")에게도 알리지 않고 #ruby("자|신","自|身")을 숨겨 #ruby("의|연|금","義|捐|金")을 낸 것을 알았다. #ruby("장|손","長|孫") #ruby("홍|량","鴻|亮")을 #ruby("일|본","日|本")에 #ruby("유|학","留|學")하게 한 것으로도 #ruby("선|생","先|生")의 #ruby("교|육","敎|育")에 대한 #ruby("각|오","覺|悟")는 #ruby("증|명","證|明")된다. #ruby("선|생","先|生")은 바둑과 술을 #ruby("지|극","至|極")히 좋아하여, #ruby("원|근","遠|近")에 몇몇 바둑 #ruby("친|구","親|舊")가 #ruby("자|기","自|己") #ruby("사|랑","舍|廊")에서 함께 술 마시고 바둑 두는 것을 #ruby("노|년","老|年")의 즐거움으로 삼았다.]
#zh[安新学校新设时，职员们因为要筹措经费而开会，募金箱里投入了“无名氏义捐稻谷一百石”。后来才知道，是金孝英先生连自己的子孙都没有告诉，隐了名捐出来的。送长孙鸿亮到日本留学，也足以证明先生对教育的决心。先生极爱围棋和酒，以远近几位棋友在自己客舍里一起饮酒下棋，作为晚年的乐趣。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("해|주","海|州") #ruby("서|촌","西|村") #ruby("강|경|희","姜|景|熙")는 #ruby("본|래","本|來") 우리 #ruby("고|향","故|鄕") #ruby("침|산","砧|山") #ruby("강|씨","姜|氏")로, #ruby("대|대","代|代")로 #ruby("거|부","巨|富")였지만 젊었을 때 #ruby("방|탕","放|蕩")하여 #ruby("파|산","破|産")한 사람인데, #ruby("선|생","先|生")의 바둑 #ruby("친|구","親|舊") 가운데 하나였다. 하루는 #ruby("선|생","先|生")을 #ruby("문|안","問|安")하고자 #ruby("사|랑","舍|廊")에 갔다. 그 #ruby("강|씨","姜|氏")는 내가 아이때부터 보고 알던 #ruby("노|인","老|人")이요, 나의 #ruby("선|조","先|祖")를 #ruby("멸|시","蔑|視")·#ruby("압|박","壓|迫")하던 #ruby("양|반","兩|班")이지만, 아버님과 #ruby("친|분","親|分")이 #ruby("비|교|적","比|較|的") 두터웠던 #ruby("옛|정","舊|情")을 생각해서 절을 드렸다.]
#zh[海州西村的姜景熙，本是我家乡砧山姜氏，世代巨富，年轻时放荡，破了产，是先生的棋友之一。有一天我到客舍去向先生问安。这位姜氏是我从小就认识的老人，也是轻视、压迫过我祖先的两班，但念他和父亲交情比较深的旧情，我还是行了礼。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 며칠 뒤 #ruby("선|생","先|生")을 모시고 있던 #ruby("용|진","庸|震") #ruby("군","君")에게 들으니, 어제 #ruby("자|기","自|己") #ruby("부|친","父|親")과 #ruby("강|노|인","姜|老|人")이 바둑을 두다가 두 #ruby("노|인","老|人") 사이에 #ruby("언|쟁","言|爭")이 있었다고 한다. 바둑 두는 #ruby("중","中")에 #ruby("강|노|인","姜|老|人")이 #ruby("자|기","自|己") #ruby("부|친","父|親")에게 이런 말을 했다 한다.]
#zh[过了几天，听侍奉先生的庸震君说，昨天他父亲和姜老下棋，两位老人吵了起来。下棋中间，姜老对他父亲说了这样的话：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|형","老|兄")은 #ruby("팔|자","八|字")가 좋아, #ruby("노|년","老|年")에 #ruby("가|산","家|産")이 #ruby("풍|족","豐|足")하고 #ruby("자|손","子|孫")도 #ruby("번|창","繁|昌")할 뿐 아니라 다 #ruby("효|자","孝|子")들이니…….”]
#zh[“老兄八字真好，晚年家产丰足，子孙也兴旺，而且都是孝子……”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("자|기","自|己") #ruby("부|친","父|親")은 이 말을 듣자마자 #ruby("분|기","憤|氣") #ruby("대|발","大|發")하며, 바둑판을 들어 #ruby("문","門") 밖에 던지면서 #ruby("강|씨","姜|氏")를 크게 꾸짖었다.]
#zh[他父亲一听这话，怒气大发，举起棋盘扔到门外，大声呵斥姜氏：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대의 #ruby("지|금","只|今") 말은 #ruby("결","決")코 나를 #ruby("위","爲")하는 것이 아니다. #ruby("칠|십","七|十") #ruby("노|구","老|軀")로 며칠 뒤 #ruby("왜","倭")놈의 #ruby("노|예|문|적","奴|隸|門|籍")에 #ruby("편|입","編|入")될 나쁜 #ruby("운|명","運|命")을 가진 나 같은 놈을 가리켜, #ruby("팔|자","八|字") 좋다는 것이 무엇이냐?”]
#zh[“你现在这话决不是为我好。我这七十老朽，几天后就要编入倭寇的奴隶名册，命运如此之坏，你指着我这样的人，说八字好，好在哪里？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이렇게 #ruby("고|함","高|喊")#ruby("고|함","高|喊") 치시는데 #ruby("자|손","子|孫")된 #ruby("처|지","處|地")로 #ruby("강|씨","姜|氏")를 #ruby("대","對")하여 #ruby("미|안","未|安")하고, #ruby("부|친","父|親")이 그같이 #ruby("국|사","國|事")를 #ruby("우|려","憂|慮")하시는 것을 볼 때 #ruby("황|송","惶|悚")도 하고 #ruby("비|분","悲|憤")도 하여, 오늘 아침 #ruby("노|자","路|資")를 두둑이 주어 #ruby("강|씨","姜|氏")를 #ruby("고|향","故|鄕")으로 돌아가게 하였다고 한다.]
#zh[自此以后，作为子侄辈，总觉得愧对姜老，今早凑足了路费，给了姜老，让他回乡去了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그 말을 들었을 때 피눈물이 눈자위에 차오르는 것을 #ruby("금","禁")할 수 없었다. 나는 #ruby("자|기","自|己") #ruby("자|손","子|孫")과 #ruby("동|년|배","同|年|輩")요, #ruby("학|식","學|識")으로나 #ruby("인|품","人|品")으로나 #ruby("선|생","先|生")의 사랑을 받을 #ruby("자|격","資|格")이 없는데도, 지팡이를 짚고 며칠에 한 #ruby("번","番")씩 반드시 #ruby("문|전","門|前")에 와서,]
#zh[我听了那话，热泪不禁涌上眼眶。我与他的子孙同辈，论学识、论人品，都没有资格受到先生的爱重，然而他拄着拐杖，每隔几天必到我门前，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님, #ruby("평|안","平|安")하시오?”]
#zh[“老师，平安吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 말씀을 하고 가시는 것이었다. 그것은 “#ruby("사|마|골","死|馬|骨") #ruby("오|백|금","五|百|金")”#footnote(numbering: _ => [18)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “죽은 말뼈를 #ruby("오|백","五|百") #ruby("금","金")으로 사는 것”. #ruby("천|리|마","千|里|馬")를 #ruby("구","求")한다는 뜻을 사람들에게 널리 알리기 #ruby("위","爲")해, 죽은 #ruby("천|리|마","千|里|馬")의 뼈를 #ruby("거|금","巨|金") #ruby("오|백","五|百") #ruby("금","金")을 주고 샀다는 #ruby("고|사","古|事"). 여기서는 #ruby("백|범","白|凡") #ruby("개|인","個|人")에 대한 #ruby("과|분","過|分")한 #ruby("대|우","待|遇")를 #ruby("비|유","比|喩")한 것이다.]만은 아니고, #ruby("제|2|세","第|二|世") #ruby("국|민","國|民")을 가르치는 #ruby("업|무","業|務")를 #ruby("존|대","尊|待")하는 #ruby("지|극","至|極")한 #ruby("정|성","精|誠")에서 나온 것이리라. 나에게뿐 아니라 #ruby("애|국|자","愛|國|者")라면 누구에게든 뜨거운 #ruby("동|정","同|情")을 가지시는 것을 보았다.]
#zh[说了这句便走了。这并不只是五百金买死马骨的那份抬举，而是出于尊重新一代国民教育工作的至诚。不只对我，凡是爱国者，我都见他对之怀着热切的同情。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("장|련","長|連")에 붙어살 때 #ruby("해|주","海|州") #ruby("고|향","故|鄕")에 #ruby("성|묘|차","省|墓|次") 갔다. #ruby("준|영","俊|永") 작은아버지께, #ruby("장|련","長|連")에서 #ruby("사|촌|형|제","四|寸|兄|弟")가 한 집에 모여 살면서 #ruby("형","兄")은 #ruby("농|업","農|業")과 #ruby("가|사","家|事") #ruby("전|부","全|部")를 맡고 나는 #ruby("교|육","敎|育")에 #ruby("종|사","從|事")하여 #ruby("생|활","生|活")이 #ruby("안|정","安|定")되고 집안간에 #ruby("화|락","和|樂")하다고 #ruby("보|고","報|告")했다.]
#zh[我在长连寄居时，曾去海州故里扫墓。我向俊永叔父报告：堂兄弟在长连聚在一家，堂兄担当农业和全部家事，我从事教育，生活安定，家人和睦。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[작은아버지는 #ruby("의|아","疑|訝")해 했다.]
#zh[叔父觉得诧异。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너 같은 난봉꾼을 누가 도와주어서 그렇게 사느냐?”]
#zh[“像你这样不务正业的人，谁会帮助你成家立业啊？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“작은아버지 보시기에 저의 난봉은 #ruby("위|험","危|險")하지만, 난봉이 아니라고 보는 사람도 더러 있는 게지요.”]
#zh[我笑着回答说：]
#zh[“我这样不务正业，在叔父看来是十分危险，可是也有人并不认为我是不务正业啊。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그렇게 #ruby("대|답","對|答")하고 웃자, 작은아버지가 다시 물었다.]
#zh[叔父又问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 빈손으로 간 #ruby("후","後"), 네 #ruby("사|촌|형","四|寸|兄")도 뒤따라가고, 네 #ruby("사|촌","四|寸") #ruby("매|부","妹|夫") #ruby("이|용|근","李|用|根")의 #ruby("식|구","食|口")까지 같이 산다니, 너는 #ruby("생|활","生|活") #ruby("근|거","根|據")를 어떻게 하고 사느냐?”]
#zh[“你是空手一人离家出走的，这以后，你堂兄、你堂姐夫一家子也都随你而去，你们还同居一处，究竟是靠什么生活啊？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 #ruby("은|율|군","殷|栗|郡")에 몇몇 #ruby("친|구","親|舊")가 있어, 그들이 오라고 #ruby("청","請")해서 #ruby("이|주","移|住")하였습니다. #ruby("친|구","親|舊") 가운데 #ruby("진|사","進|士") #ruby("오|인|형","吳|寅|炯") #ruby("군","君")은 그 #ruby("군","郡")의 #ruby("갑|부","甲|富")였던 #ruby("오|경|승","吳|景|勝") #ruby("진|사","進|士")의 #ruby("장|손","長|孫")이요, 아직도 #ruby("유|산","遺|産")을 가지고 괜찮게 사는 #ruby("처|지","處|地")입니다. #ruby("인|형","寅|炯") #ruby("군","君")이 #ruby("특|별","特|別")히 1,000#ruby("여","餘") #ruby("냥","兩") #ruby("가|치","價|値")가 있는 집 한 채와 #ruby("전|답","田|畓")·#ruby("과|수|원","果|樹|園")까지 다 갖춰 빌려주면서, 언제든지 내 #ruby("물|건","物|件")과 같이 #ruby("사|용","使|用")하며 #ruby("의|식|주","衣|食|住")의 #ruby("근|거","根|據")를 삼으라 하였습니다.”]
#zh[“我在殷律郡有几位朋友，他们请我搬去，我便迁居了。朋友中进士吴寅炯君，是该郡首富吴景胜进士的长孙，至今还有遗产，日子过得不错。寅炯君特别借给我一所值一千余两的房子，田地、果园一应俱全，说随时可以像用他自己的东西一样使用，作为衣食住的根基。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리고 #ruby("농|사","農|事") 짓는 소 한 마리까지 사서 주었고, 집안에 쓸 것은 #ruby("수|시","隨|時")로 #ruby("인|형","寅|炯") #ruby("군","君")에게 #ruby("청|구","請|求")하여 쓰면서 여러 #ruby("식|구","食|口")가 살아간다는 #ruby("내|용","內|容")을 #ruby("일|일","一|一")이 #ruby("보|고","報|告")하였다.]
#zh[他还买了一头耕牛给我们。家里要用的东西，也随时向寅炯君索取来用。我把全家这样过活的情形，一一向叔父报告了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[작은아버지는 “#ruby("세|상","世|上")에 그렇게 #ruby("후|덕","厚|德")한 사람도 있느냐?” 하셨다. 하지만 작은아버지는 내가 무슨 #ruby("협|잡","挾|雜")이나 하지 않는가 #ruby("의|심","疑|心")하였다. #ruby("당|시","當|時") #ruby("주|변","周|邊")에 #ruby("부|호","富|豪")의 #ruby("자|식","子|息")이나 조카들이 #ruby("왜","倭")놈에게 돈 100#ruby("냥","兩")을 #ruby("차|용","借|用")할 때, #ruby("왜","倭")놈들은 #ruby("증|서","證|書")에다 1,000#ruby("냥","兩")이라고 쓰게 하고 돈을 받을 때는 1,000#ruby("냥","兩")을 다 받아내었다. 만약 #ruby("당|사|자","當|事|者")의 #ruby("자|산","資|産")이 #ruby("부|족","不|足")하면 #ruby("족|징","族|徵")#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("일|가","一|家")의 다른 사람에게 #ruby("대|신","代|身") #ruby("징|수","徵|收")하는 것.]까지 하였는데, 이러한 일을 작은아버지는 자주 보았다. 그래서 내가 서울도 가고 #ruby("남|도","南|道")에도 #ruby("왕|래","往|來")하는데 #ruby("혹|시","或|是") #ruby("왜","倭")놈의 돈이나 얻어 쓰고 다니는 것이 아닐까 하여, 어디를 간다 하면 작은아버지가 #ruby("야|단","惹|端")부터 치셨던 것이다. 그 때문에, 나도 어디 갈 때는 조용히 나가버렸고, 이런 #ruby("연|유","緣|由")로 #ruby("평|소","平|素") #ruby("숙|질|간","叔|姪|間")에 #ruby("정|의","情|誼")가 #ruby("친|밀","親|密")하지 못하였다.]
#zh[叔父听了感叹不已：]
#zh[“想不到世上还有如此厚道的人！”]
#zh[叔父心里也可能怀疑我是否是靠诈骗过活。这也难怪，平常我们叔侄就不是亲密无间的。附近就有些富豪子弟向日本人借钱，借用百两，日本人却在借据上写了千两，索债时非要千两不可，要是举债人家产不够，就向他族人讨要。这类事叔父也见到不少。所以他以为我去汉城和三南也是借用了日本人的钱，只要我一说去哪儿，他总是大吵大闹。因此我外出时也就悄悄地离开，不辞而别。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그해 가을, 작은아버지께서 #ruby("장|련","長|連")에 오셨다. #ruby("사|직|동","社|稷|洞") 집만 좋을 뿐 아니라 #ruby("추|수","秋|收")한 #ruby("곡|물","穀|物")도 #ruby("당|신","當|身") #ruby("댁","宅") 살림보다 나은 것이, #ruby("만|족","滿|足")스럽기보다는 #ruby("예|상","豫|想")밖이었던 것 같다. #ruby("오","吳")#ruby("진|사","進|士")를 찾아가 보고서는 어머님께 “조카가 다른 사람에게 그같이 #ruby("신|뢰","信|賴")받을 줄은 생각 못하였다”고 하셨다 한다. #ruby("오|해","誤|解")가 풀린 #ruby("후","後") 작은아버지는 나를 #ruby("지|극","至|極")히 사랑하셨다.]
#zh[那年秋天，叔父来到长连，他看到社稷洞不仅房子好，而且秋收的谷物也比自己家多，感到十分惊奇。他还去访问了吴进士。他把他在那儿亲眼所见告诉了我母亲，并说：]
#zh[“真想不到人家会如此敬重侄儿。”]
#zh[此后叔父解开了心中的疙瘩，也钟爱起我来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳")으로 #ruby("이|주","移|住")한 뒤에도 #ruby("교|육|사|업","敎|育|事|業")에 #ruby("열|중","熱|中")하다 #ruby("휴|가","休|暇")에 #ruby("성|묘|차","省|墓|次") #ruby("고|향","故|鄕")에 갔다. 여러 해 만에 #ruby("고|향","故|鄕") 땅을 #ruby("방|문","訪|問")하니 어릴 때 #ruby("공|부","工|夫")하고 놀던 옛 #ruby("추|억","追|憶")에 대한 #ruby[감회][感舊之懷]가 #ruby("형|언","形|言")할 수 없었다. 나를 안아주고 사랑해 주던 #ruby("노|인","老|人")들은 #ruby("태|반","太|半")이나 보이지 않고, 내가 어리게 보았던 어린 아이들은 거의 다 #ruby("장|성","長|成")하였다. #ruby("성|장","成|長")한 #ruby("청|년","靑|年") #ruby("중","中")에 쓸 만한 #ruby("인|재","人|才")가 있는가 살펴보았지만, #ruby("모|양","模|樣")만 #ruby("상","常")놈이 아니고 #ruby("정|신","精|神")까지 #ruby("상","常")놈이 되고 말았다. 그이들은 #ruby("민|족","民|族")이 무엇인지, #ruby("국|가","國|家")가 무엇인지 터럭만큼의 #ruby("각|성","覺|醒")도 없는 #ruby[밥벌레][穀蟲]에 #ruby("불|과","不|過")했다.]
#zh[迁居安岳之后，我仍热心于教育事业，休假时回故乡扫墓。隔了好几年才踏上故乡的土地，幼年读书、玩耍的旧忆，感慨难以言喻。抱过我、疼过我的老人大半不见了，我当时看着还小的孩子几乎都已长大。我留心看过长成的青年里有没有可用之才，可他们不只模样是平民，精神也成了平民。他们不知道民族是什么、国家是什么，连一根毫毛的觉醒也没有，不过是些蛀粮食的虫子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[젊은 사람들에게 #ruby("교|육","敎|育")을 말하니 #ruby("신|학|문","新|學|問")은 #ruby("예|수|교","耶|蘇|敎")나 #ruby("천|주|교","天|主|敎")로만 알았다. 이웃동네 #ruby("양|반","兩|班") #ruby("강|진|사","姜|進|士") 집을 찾아갔다. 그 #ruby("양|반","兩|班")들에게, 절할 사람에게는 절로, #ruby[입인사][口敬]하던 사람에게는 입인사로, #ruby("상","常")놈 #ruby("신|분","身|分")으로서 예전과 똑같이 #ruby("대|접","待|接")하면서 #ruby("태|도","態|度")를 살펴보았다. #ruby("이|전","以|前")에 그같이 #ruby("교|만","驕|慢")했던 #ruby("양|반","兩|班")들이, 이제 올리지도 내리지도 못하는 #ruby("어|중|간","於|中|間")한 말투로 나를 #ruby("대","對")하며, 나의 #ruby("지|극","至|極")한 #ruby("공|경","恭|敬")에 어찌할 줄 모른다. #ruby("짐|작","斟|酌")컨대 #ruby("작|년","昨|年") #ruby("강|경|희","姜|景|熙") #ruby("노|인","老|人")이 #ruby("안|악","安|岳") #ruby("김|효|영","金|孝|英") #ruby("선|생","先|生")과 함께 있다가, #ruby("선|생","先|生")이 일어나 나를 맞이하는 것과, #ruby("양|산|학|교","楊|山|學|校")에서 #ruby("사|범|생","師|範|生") 400〜500#ruby("명","名")이 모인 가운데 내가 #ruby("주|선","周|旋")하는 것을 보고 나서 #ruby("자|기","自|己") 집안사람들에게 이야기한 것 같았다.]
#zh[跟年轻人讲起教育，他们只把新学问当成耶稣教或天主教。我去邻村两班姜进士家看看。对这些两班，该行礼的行礼，该口头问候的口头问候，仍以平民的身份，和从前一样对待，观察他们的态度。以前那样傲慢的两班，现在用高不成低不就的口气对我，对我极尽的恭敬不知如何是好。我猜想，去年姜景熙老人在安岳和金孝英先生在一起，看见先生起身迎接我，又看见杨山学校四五百名师范生聚集、由我出面周旋，回去告诉了家里的人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("여|하","如|何")튼 #ruby("양|반","兩|班")의 #ruby("세|력","勢|力")이 #ruby("쇠|퇴","衰|退")한 것은 #ruby("사|실","事|實")이다. #ruby("당|당","堂|堂")한 그 #ruby("양|반","兩|班")들이 #ruby[보잘것없는][草草] #ruby("상","常")놈 하나 #ruby("접|대","接|待")하기에 힘이 딸려 애쓰는 것을 볼 때 더욱 #ruby("가|련","可|憐")하였다. 나라가 죽게 되니까 #ruby("국|내","國|內")에서 #ruby("중|견|세|력","中|堅|勢|力")을 가지고 온갖 못된 #ruby("위|세","威|勢")를 다 부리던 #ruby("양|반","兩|班")부터 저 꼴이 된 것 아닌가. #ruby("만|일","萬|一") #ruby("양|반","兩|班")이 살아나 #ruby("국|가","國|家")가 #ruby("독|립","獨|立")할 수만 있다면, 내가 #ruby("양|반","兩|班")의 #ruby("학|대","虐|待")를 좀더 받더라도 나라만 살아났으면 좋겠다는 #ruby("감|상","感|想")이 일어났다.]
#zh[无论如何，两班的势力衰退是事实。看到堂堂的两班们接待一个微不足道的平民都力不从心，我更加觉得他们可怜。国家要亡了，在国内握着中坚势力、作尽威风的两班，不就先成了这副模样吗。我想，倘若两班能够复活、国家能够独立，我宁可再多受些两班的虐待，只要国家能活过来就好。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("평|소","平|素") #ruby("재|사","才|士")로 #ruby("자|처","自|處")하며 #ruby("호|기","豪|氣") 부리던 #ruby("강|성|춘","姜|成|春")에게 #ruby("구|국","救|國")의 #ruby("방|도","方|道")를 물었다. #ruby("강|군","姜|君")은 나라 망한 #ruby("책|임","責|任")이 #ruby("당|국|자","當|局|者")에 있고, #ruby("자|기","自|己")와 같은 시골 늙은이와는 #ruby("관|계","關|係")가 없는 것처럼 #ruby("조|심","操|心")스럽게 #ruby("대|답","對|答")을 했다. 내의 집안에 #ruby("상","常")놈의 #ruby("상","常")놈이나 그대의 #ruby("양|반","兩|班")인 #ruby("상","常")놈이나 #ruby("상","常")놈 맛은 #ruby("일|반","一|般")이라고 생각된다.#footnote(numbering: _ => [20)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “내 집안이 #ruby("상","常")놈 #ruby("중","中")의 #ruby("상","常")놈이지만 그대는 #ruby("양|반","兩|班") #ruby("중","中")의 #ruby("상","常")놈이니, #ruby("상","常")놈이기는 마찬가지라 생각되었다.”]]
#zh[我向平日以才士自居、颇有豪气的姜成春询问救国之道。姜君小心回答，亡国之责在当局，好像和自己这样的乡下老人没有关系。我想，我家是平民中的平民，你是两班出身的平民，平民的味道却是一样。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("자|제","子|弟")를 #ruby("교|육","敎|育")하라고 #ruby("권","勸")하니 머리 깎는 것이 #ruby("문|제","問|題")라고 했다. #ruby("교|육","敎|育")은 #ruby("단|발","斷|髮")하는 것이 #ruby("목|적","目|的")이 아니고 #ruby("인|재","人|才")를 #ruby("양|성","養|成")하여 #ruby("장|래","將|來") #ruby("완|전","完|全")한 #ruby("국|가","國|家")의 #ruby("일|원","一|員")이 되어, 약한 나라를 #ruby("부|강","富|强")하게 하고 어둠에서 #ruby("광|명","光|明")을 되찾는 것이라 하였다. 그러나 그의 귀에는 #ruby("천|주|학","天|主|學")이나 하라는 소린 줄 알고, #ruby("자|기","自|己") #ruby("가|문","家|門") #ruby("중","中")에도 #ruby("예|수|교","耶|蘇|敎")에 #ruby("참|가","參|加")한 사람이 있다며 #ruby("대|화","對|話")를 #ruby("기|피","忌|避")하였다.]
#zh[劝他教育子弟，他说难在剪发。我说，教育的目的不是剪发，而是培养人才，使之成为将来完整国家的一员，使弱国富强，从黑暗中找回光明。可是他耳朵里只当成叫他去学天主学，说自己家门里也有人入了耶稣教，便回避了谈话。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("저|주","詛|呪")하리로다, #ruby("해|주","海|州") #ruby("서|촌","西|村") #ruby("양|반","兩|班")들이여!]
#zh[可悲可叹啊，海州西村的两班们！]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("자|기","自|己")네가 #ruby("충|신","忠|臣") #ruby("자|손","子|孫")이니 #ruby("공|신","功|臣") #ruby("자|손","子|孫")이니 하며, #ruby("평|민","平|民")을 소나 말처럼 여기고 #ruby("노|예|시","奴|隸|視")하던 #ruby("기|염","氣|焰")은 오늘 어디에 있느냐!]
#zh[你们自称忠臣的子孙、功臣的子孙，把平民当作牛马、当作奴隶的那股气焰，今天在哪里！]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("저|주","詛|呪")하리로다, #ruby("해|주","海|州") #ruby("서|촌","西|村") #ruby("상","常")놈들이여!]
#zh[可悲可叹啊，海州西村的平民们！]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("오|백","五|百") #ruby("년","年") 기나긴 #ruby("세|월","歲|月") 동안 #ruby("양|반","兩|班") 앞에서 담배 한 대, 큰기침 한 #ruby("번","番") 마음놓고 못하다가, 이제는 #ruby("재|래","在|來")의 썩은 #ruby("양|반","兩|班")보다 #ruby("신|선","新|鮮")한 #ruby("신|식","新|式") #ruby("양|반","兩|班")이 될 수 있지 않은가!]
#zh[五百年漫长的岁月里，你们在两班面前连一口烟、一声大咳都不敢随意，现在不是可以成为比旧日腐烂的两班更新鲜的新式两班吗！]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("구|식","舊|式") #ruby("양|반","兩|班")은 #ruby("군|주","君|主") #ruby("일|개|인","一|箇|人")에 대한 #ruby("충|성","忠|誠")으로도 #ruby("자|자|손|손","子|子|孫|孫")이 #ruby("혜|택","惠|澤")을 입었거니와, #ruby("신|식","新|式") #ruby("양|반","兩|班")은 #ruby("삼|천|리","三|千|里") #ruby("강|토","疆|土")의 #ruby("이|천|만","二|千|萬") #ruby("민|중","民|衆")에게 #ruby("충|성","忠|誠")을 다하여 #ruby("자|기","自|己") #ruby("자|손","子|孫")과 #ruby("이|천|만","二|千|萬") #ruby("민|중","民|衆")의 #ruby("자|손","子|孫")에게 #ruby("만|세","萬|歲")토록 #ruby("복|음","福|音")을 남길지라. 그 얼마나 훌륭한 #ruby("양|반","兩|班")이냐. #ruby("환|등","幻|燈")#ruby("기|구","器|具")를 가지고 #ruby("고|향","故|鄕")에 갔을 때, 나는 #ruby("인|근","鄰|近") #ruby("양|반","兩|班") #ruby("상","常")놈을 다 모아놓고, #ruby("환|등|회","幻|燈|會") #ruby("석|상","席|上")에서]
#zh[旧两班只要忠于国君一人，其子子孙孙就可享受其恩泽，新两班则要忠于三千里江山、两千万人民，为自己的子孙和两千万民众的子孙造福千秋万代。这样的新两班是多么伟大！我回到故乡，曾邀集乡人，放映我带回来的幻灯片，当时我向他们大声疾呼：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("양|반","兩|班")도 깨어라! #ruby("상","常")놈도 깨어라!”]
#zh[“平民和两班都应该觉醒了！我们要为三千里锦绣江山和亲爱的两千万同胞竭尽忠诚！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("절|규","絶|叫")하였다.]
#zh[我这样绝叫道。]
#heading(level: 3)[#text(font: "KOPUSGo B")[3) #ruby("각","各") #ruby("군","郡") #ruby("순|회","巡|廻") #ruby("교|육|운|동","敎|育|運|動")]]
#zh[各郡巡回教育运动]
#figure-block("/images/p200.jpg", caption: [1906#ruby("년","年") #ruby("장|련","長|連") #ruby("광|진|학|교","光|進|學|校")에서. 맨 뒷줄 오른쪽 끝이 #ruby("백|범","白|凡").])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳")에서 #ruby("사|범|강|습","師|範|講|習")을 마치고 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("확|장","擴|張")하여 #ruby("중|학|부","中|學|部")와 #ruby("소|학|부","小|學|部")를 두었다.#footnote(numbering: _ => [21)])[#h(0.35em)1907#ruby("년","年") #ruby("초|등|교|육|기|관","初|等|敎|育|機|關")으로 #ruby("양|산|학|교","楊|山|學|校")가 #ruby("설|립","設|立")되었고, 1908#ruby("년","年") #ruby("일|본","日|本") #ruby("유|학","留|學")에서 돌아온 #ruby("김|홍|량","金|鴻|亮") #ruby("등","等")의 #ruby("발|의","發|議")로 #ruby("김|효|영","金|孝|英")이 낸 3,000#ruby("원","元")과 #ruby("지|방|유|지","地|方|有|志")의 #ruby("의|연|금","義|捐|金") 3,000#ruby("원","元")을 #ruby("적|립","積|立")하여 #ruby("양|산|중|학|교","楊|山|中|學|校")를 #ruby("병|설","竝|設")하였다.] #ruby("김|홍|량","金|鴻|亮")이 #ruby("교|주","校|主") 겸 #ruby("교|장","校|長")이 되어 #ruby("교|무","校|務")를 맡았고, 나는 #ruby("최|광|옥","崔|光|玉") #ruby("등","等") #ruby("교|육|자","敎|育|者")와 힘을 합쳐 #ruby("해|서|교|육|총|회","海|西|敎|育|總|會")#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("면|학|회","勉|學|會")가 #ruby("발|단","發|端")이 되어 1908#ruby("년","年") #ruby("황|해","黃|海")#ruby("도|지|역","道|地|域")의 #ruby("교|육","敎|育") #ruby("보|급","普|及")을 #ruby("위","爲")해 #ruby("결|성","結|成")된 #ruby("단|체","團|體").]를 #ruby("조|직","組|織")하여 #ruby("학|무|총|감","學|務|總|監")을 맡아 #ruby("전","全") #ruby("도|내","道|內")에 #ruby("교|육|기|관","敎|育|機|關")을 #ruby("설|립","設|立")·#ruby("운|영","運|營")하는 #ruby("책|임","責|任")을 지고 #ruby("각","各") #ruby("군","郡")을 #ruby("순|행","巡|行")하였다.]
#zh[安岳的师范讲习结束后，扩大杨山学校，设立了中学部和小学部。金鸿亮任校主兼校长，掌理教务。我和崔光玉等教育家合力，组织海西教育总会，我担任学务总监，负起在全道内设立、经营教育机关的责任，巡回各郡。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("배|천","白|川") #ruby("군|수","郡|守") #ruby("전|봉|훈","全|鳳|薰")의 #ruby("요|청","要|請")에 #ruby("의","依")해 #ruby("배|천|읍","白|川|邑")에 #ruby("당|도","當|到")하니, #ruby("전|군|수","全|郡|守")가 #ruby("각","各") #ruby("면","面")에 #ruby("훈|령","訓|令")하여 #ruby("면|내","面|內") #ruby("두|민","頭|民")과 #ruby("신|사","紳|士")#footnote(numbering: _ => [23)])[#h(0.35em)여기서 #ruby("두|민","頭|民")은 #ruby("향|촌","鄕|村")의 #ruby("지|도|급","指|導|級") #ruby("인|사","人|士"), #ruby("신|사","紳|士")는 #ruby("신|식","新|式") #ruby("문|명","文|明")에 눈을 뜬 사람들을 #ruby("의|미","意|味")한다.]들을 #ruby("오|리|정","五|里|亭")에 #ruby("소|집","召|集")하고 기다리다가, #ruby("군|수","郡|守")가 #ruby("선|창","先|唱")하여 “#ruby("김|구","金|龜") #ruby("선|생","先|生") #ruby("만|세","萬|歲")”를 부르자 #ruby("군|중","群|衆")이 #ruby("제|창","齊|唱")했다. 나는 #ruby("전|군|수","全|郡|守")의 입을 막고 #ruby("망|발","妄|發") 말라고 하였다. 나는 그때까지 ‘#ruby("만|세","萬|歲")’ 두 글자는 #ruby("황|제","皇|帝")만의 #ruby("전|용","專|用") #ruby("축|사","祝|辭")요, #ruby("황|태|자","皇|太|子")에게는 ‘#ruby("천|세","千|歲")’라고 부르는 것으로 알았다. #ruby("전|군|수","全|郡|守")는 내 손을 잡으며 말했다.]
#zh[应白川郡守全凤薰的邀请，我到达白川邑。全郡守训令各面，把面内的头民和绅士召集到五里亭等候。郡守领头高呼“金龟先生万岁”，群众齐声附和。我堵住全郡守的嘴，叫他不要妄言。我直到那时还以为，“万岁”二字是皇帝专用的祝辞，对皇太子只称“千岁”。全郡守握着我的手说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김","金")#ruby("선|생","先|生"), #ruby("안|심","安|心")하시오. 내가 #ruby("선|생","先|生")을 #ruby("환|영","歡|迎")하며 #ruby("만|세","萬|歲")를 부르는 것은 #ruby("통|례","通|例")요, #ruby("망|발","妄|發")이 아닙니다. #ruby("친|구","親|舊") #ruby("상|호|간","相|互|間")에도 맞이하고 보낼 때 #ruby("만|세","萬|歲")를 부르는 터인즉, #ruby("안|심","安|心")하시고 #ruby("영|접","迎|接")하는 여러분과 #ruby("인|사","人|事")나 하시오.”]
#zh[“金先生，请放心。我欢迎先生而高呼万岁，是通例，不是妄言。朋友之间迎送也呼万岁，请放心，和前来迎接的各位打个招呼就行了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("배|천|읍","白|川|邑")에서 #ruby("전|군|수","全|郡|守") #ruby("사|저","私|邸")에 머물면서 #ruby("각","各") #ruby("면","面") #ruby("두|민","頭|民")들과 #ruby("회|동","會|同")하고, #ruby("교|육|시|설","敎|育|施|設") #ruby("방|침","方|針")을 #ruby("협|의","協|議"), #ruby("진|행","進|行")하였다.]
#zh[我在白川邑住在全郡守的私宅，和各面头民会面，商议并推进教育设施的方针。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|봉|훈","全|鳳|薰")은 #ruby("본|시","本|是") #ruby("재|령","載|寧") #ruby("서|리|배","胥|吏|輩") #ruby("출|신","出|身")으로, #ruby("해|주|읍","海|州|邑")에서 #ruby("총|순","摠|巡")으로 여러 해 #ruby("근|무","勤|務")하며 #ruby("교|육","敎|育")을 #ruby("장|려","獎|勵")하였다. #ruby("해|주","海|州")에 #ruby("정|내|학|교","正|內|學|校")를 #ruby("설|립","設|立")하여 #ruby("야|학","夜|學")을 #ruby("권|장","勸|獎")할 때는, #ruby("시|내","市|內")의 #ruby("각","各") #ruby("점|포","廛|房") #ruby("사|환","使|喚")을 #ruby("야|학","夜|學")에 보내지 않는 #ruby("주|인","主|人")은 #ruby("처|벌","處|罰")하는 #ruby("등","等") #ruby("별|별","別|別") #ruby("수|단","手|段")을 #ruby("사|용","使|用")하여 #ruby("교|육","敎|育")에 많은 #ruby("업|적","業|績")을 남겼다.]
#zh[全凤薰本是载宁胥吏出身，在海州邑当了多年总巡，奖励教育。他在海州设立正内学校，劝办夜学。市内各店铺的使唤若不送去夜学，便处罚主人。他用尽各种手段，在教育上留下许多业绩。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 뒤 #ruby("배|천","白|川") #ruby("군|수","郡|守")가 되어 그 #ruby("군|내","郡|內")에 #ruby("교|육|시|설","敎|育|施|設")을 열심히 #ruby("설|립","設|立")하였다. #ruby("전|군|수","全|郡|守")의 외아들은 일찍 죽고 #ruby("장|손","長|孫") #ruby("무|길","武|吉")이 5, 6#ruby("세","歲")였다. 그때 #ruby("왜","倭")놈이 #ruby("수|비|대","守|備|隊")나 #ruby("헌|병|대","憲|兵|隊")를 #ruby("군","郡")마다 #ruby("주|둔","駐|屯")시켜 #ruby("관|아","官|衙")를 빼앗았지만, 홀로 #ruby("배|천|군","白|川|郡")만은 #ruby("전|군|수","全|郡|守")가 #ruby("완|강","頑|强")히 #ruby("거|부","拒|否")하여 빼앗기지 않았다. 그러므로 #ruby("왜","倭")놈이 눈엣가시처럼 생각하여 #ruby("종|종","種|種") #ruby("곤|란","困|難")한 #ruby("교|섭","交|涉")이 많았으나, #ruby("전|씨","全|氏")의 #ruby("본","本")뜻은 #ruby("군|수","郡|守")를 #ruby("영|화","榮|華")로운 자리로 알아서가 아니요, #ruby("군|수","郡|守")의 #ruby("권|한","權|限")을 가지고 #ruby("교|육","敎|育")에 힘을 보태고자 함이었다.]
#zh[后来他当了白川郡守，热心在郡内设立教育设施。全郡守的独子早死，长孙武吉才五六岁。那时倭寇在每一郡驻守备队或宪兵队，夺走官衙，唯独白川郡被全郡守坚决拒绝，没有被夺去。因此倭寇视他如眼中钉，常常有许多为难的交涉。然而全氏的本意，并不是把郡守看作荣华的位子，而是要借郡守的权限，为教育出一把力。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그는 #ruby("최|광|옥","崔|光|玉")을 #ruby("초|빙","招|聘")하여 #ruby("사|범|강|습|소","師|範|講|習|所")를 열고, #ruby("청|년","靑|年")을 #ruby("모|집","募|集")하여 #ruby("애|국|심","愛|國|心")을 #ruby("고|취","鼓|吹")시키기에 #ruby("전|력","專|力")했다. #ruby("최|광|옥","崔|光|玉")은 마침내 #ruby("배|천|읍","白|川|邑")에서 #ruby("강|연","講|演")하다가 피를 #ruby("토","吐")하며 죽고 말았다. #ruby("원|근","遠|近") #ruby("인|사","人|士")들은 온 마음과 #ruby("열|성","熱|誠")을 다하는 #ruby("청|년|지|사","靑|年|志|士")가 #ruby("중|도","中|途")에 #ruby("사|망","死|亡")한 것을 #ruby("애|도","哀|悼")하였다. #ruby("임|시","臨|時")로 #ruby("배|천|읍","白|川|邑") #ruby("남|산","南|山") 위 #ruby("학|교","學|校") #ruby("운|동|장","運|動|場") 곁에 #ruby("장|사","葬|事")지내고, #ruby("황|해","黃|海")·#ruby("평|안|도","平|安|道") #ruby("인|사","人|士")들이 #ruby("최|선|생","崔|先|生")의 #ruby("충|정","忠|貞")을 #ruby("영|원","永|遠")히 #ruby("기|념","紀|念")하기 #ruby("위","爲")해 #ruby("장|지","葬|地")를 #ruby("사|리|원","沙|里|院") #ruby("정|거|장","停|車|場") #ruby("근|처","近|處")로 #ruby("정","定")하고, #ruby("비|석","碑|石")은 #ruby("평|양","平|壤") #ruby("정|거|장","停|車|場")의 #ruby("이|토","伊|藤") #ruby("히로부미","博文") #ruby("기|념|비","紀|念|碑")보다 더 훌륭하게 세워, #ruby("왕|래","往|來")하는 사람들에게 #ruby("영|원","永|遠")한 #ruby("인|상","印|象")을 주기로 하였다. #ruby("안|태|국","安|泰|國")#footnote(numbering: _ => [24)])[#h(0.35em)#ruby[안|태|국][安|泰|國]\(1874〜1920). #ruby("평|남","平|南") #ruby("중|화","中|和") #ruby("출|신","出|身")으로, #ruby("안|창|호","安|昌|浩")가 세운 #ruby("평|양","平|壤") #ruby("대|성|학|교","大|成|學|校")의 #ruby("교|장","校|長")을 #ruby("역|임","歷|任")했다. 1907#ruby("년","年") #ruby("이|후","以|後") #ruby("신|민|회","新|民|會")에도 #ruby("참|여","參|與")하였으며, 105#ruby("인","人") #ruby("사|건","事|件")에 #ruby("연|루","連|累")되어 #ruby("백|범","白|凡")과 같이 #ruby("옥","獄")살이를 했다.]에게 #ruby("비|석","碑|石")의 #ruby("모|양","模|樣")까지 #ruby("정","定")하여 #ruby("평|양","平|壤")에서 #ruby("축|조","築|造")하도록 하였으나, #ruby("합|병|조|약","合|併|條|約")이 #ruby("체|결","締|結")되어 이를 이루지 못하였다. 그의 #ruby("유|해","遺|骸")는 아직 #ruby("배|천","白|川")에 그대로 묻혀 있다.]
#zh[他聘请崔光玉，开设师范讲习所，招募青年，全力鼓吹爱国心。崔光玉终于在白川邑演讲时吐血而死。远近人士哀悼这位尽心尽诚的青年志士中途身亡，临时葬在白川邑南山上学校运动场旁边。黄海、平安道人士为永远纪念崔先生的忠贞，把墓地定在沙里院车站附近，碑石要比平壤车站的伊藤博文纪念碑更壮观，好给往来的人留下永久的印象。碑的式样也交给安泰国，让他在平壤建造，可是合并条约缔结，此事没有办成。他的遗骸至今仍埋在白川。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("재|령","載|寧") #ruby("양|원|학|교","養|元|學|校")에서 #ruby("유|림","儒|林")들을 #ruby("소|집","召|集")하여 #ruby("교|육","敎|育")에 대한 #ruby("방|침","方|針")을 #ruby("토|의","討|議")한 #ruby("후","後") #ruby("장|연","長|淵")에 갔다. #ruby("군|수","郡|守") #ruby("이|씨","李|氏")가 #ruby("영|접","迎|接")하고서 #ruby("자|기","自|己") #ruby("관|할","管|轄") #ruby("각","各") #ruby("면","面")에 #ruby("훈|령","訓|令")을 보내 #ruby("김|구","金|龜") #ruby("선|생","先|生")의 #ruby("교|육|방|침","敎|育|方|針")을 #ruby("성|심","誠|心") #ruby("복|종","服|從")하라 하고, 나에게 #ruby("각","各") #ruby("면","面")을 #ruby("순|행","巡|行")하여 달라고 #ruby("간|청","懇|請")했다. #ruby("간|청","懇|請")을 물리치지 못하여 #ruby("읍|내","邑|內")에서 한 #ruby("차|례","次|例") #ruby("환|등|대|회","幻|燈|大|會")를 #ruby("개|최","開|催")하였는데, #ruby("수|천","數|千") #ruby("명","名")의 #ruby("남|녀|노|소","男|女|老|少")가 #ruby("회|집","會|集")하여 #ruby("성|황|리","盛|況|裡")에 치렀다. 이어 #ruby("순|택","蓴|澤")·#ruby("신|화","薪|化")#ruby("면","面") #ruby("등","等")으로 #ruby("순|회","巡|廻")하다가, #ruby("안|악|학|교","安|岳|學|校")의 #ruby("사|무","事|務")가 #ruby("급|박","急|迫")하여 되돌아왔다.]
#zh[在载宁养元学校召集儒林，讨论了教育方针，然后去长渊。郡守李氏迎接我，向所辖各面发出训令，叫他们诚心服从金龟先生的教育方针，并恳请我巡回各面。推辞不得，在邑内开了一次幻灯大会，男女老少数千人集会，办得很盛。接着巡回荃泽、薪花等面，因为安岳学校事务紧急，便回来了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("송|화","松|禾") #ruby("수|교","水|橋") #ruby("시|장","市|場")에 #ruby("도|착","到|着")하여 #ruby("시|내","市|內") #ruby("유|력|자","有|力|者")인 #ruby("감|승|무","甘|承|武") #ruby("등","等") 몇몇 #ruby("유|지","有|志")의 #ruby("요|청","要|請")에 #ruby("의","依")하여 #ruby("부|근","附|近") 대여섯 곳 #ruby("소|학|교","小|學|校")를 불러모아 #ruby("환|등|회","幻|燈|會")를 열었다. 떠나고자 할 즈음에 #ruby("송|화","松|禾") #ruby("군|수","郡|守") #ruby("성|낙|영","成|樂|英")이 #ruby("대|표","代|表")를 보내어,]
#zh[到达松禾水桥市场，应市内有力者甘承武等几位有志的请求，召集附近五六处小学，开了幻灯会。正要离开时，松禾郡守成乐英派了代表来说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("초|면","初|面")인 #ruby("장|연","長|淵") #ruby("군|수","郡|守")는 #ruby("인|사","人|事")만 하고도 #ruby("각","各") #ruby("면","面")을 #ruby("순|회","巡|廻")하며 #ruby("강|연","講|演")까지 해주고, #ruby("친","親")한 나는 찾아주지도 않고 지나가려느냐?”]
#zh[“初见面的长渊郡守，只打个招呼，你就巡回各面，连演讲也做了；跟我相熟，却连来看也不看，就要走过去吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하며 #ruby("간|청","懇|請")했다.]
#zh[他这样恳请。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("군","郡") #ruby("세|무|소|장","稅|務|所|長")인 #ruby("구|자|록","具|滋|祿") #ruby("군","君")도 #ruby("교|육","敎|育")에 #ruby("열|심","熱|心")이 있는 탓으로 #ruby("친|숙","親|熟")한 터여서, #ruby("구|군","具|君")의 #ruby("초|청","招|請")까지 받아 #ruby("부|득|이","不|得|已") #ruby("송|화|군","松|禾|郡") #ruby("읍|내","邑|內")로 #ruby("향","向")했다. 이 #ruby("소|문","所|聞")을 접한 #ruby("성|낙|영","成|樂|英")은 #ruby("즉|시","卽|時") #ruby("각","各") #ruby("면","面")에 10#ruby("여","餘") 곳 #ruby("학|교","學|校")와 #ruby("군|내","郡|內") #ruby("유|지","有|志") #ruby("인|사","人|士")와 #ruby("부|인","夫|人"), #ruby("아|동","兒|童")까지 #ruby("소|집","召|集")하였다.]
#zh[该郡税务所长具滋根君也热心教育，我们本就相熟，又受到具君的邀请，不得已向松禾郡邑内去。成乐英听到这个消息，立即召集各面十余处学校，以及郡内有志人士、夫人和儿童。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 몇 #ruby("년","年") 만에 #ruby("송|화|읍","松|禾|邑")의 #ruby("광|경","光|景")을 보았다. #ruby("해|서","海|西")#ruby("의|병","義|兵")을 #ruby("토|벌","討|伐")하던 #ruby("요|새","要|塞")인 #ruby("읍|내","邑|內") #ruby("관|사","官|舍")는 거의 #ruby("대|부|분","大|部|分") #ruby("왜","倭")가 #ruby("점|령","占|領")했다. #ruby("수|비|대","守|備|隊")·#ruby("헌|병|대","憲|兵|隊")·#ruby("경|찰|서","警|察|署")·#ruby("우|편|국","郵|便|局") #ruby("등","等") 여러 #ruby("기|관","機|關")이 꽉 들어차고, #ruby("개|인","個|人") 집을 #ruby("군|청","郡|廳")으로 하여 #ruby("근|무","勤|務")하는 #ruby("광|경","光|景")을 보고 #ruby("분","憤")한 마음이 머리끝까지 치밀었다.]
#zh[我隔了几年，才看见松禾邑的光景。讨伐海西义兵的要塞、邑内的官舍，几乎大部分被倭寇占领。守备队、宪兵队、警察署、邮政局等机关挤得满满的，郡厅借用私人房子办公。看到这光景，愤恨直冲头顶。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("환|등|회","幻|燈|會")를 열었다. #ruby("대|황|제","大|皇|帝")#footnote(numbering: _ => [25)])[#h(0.35em)1897#ruby("년","年") #ruby("고|종","高|宗")은 #ruby("국|호","國|號")를 #ruby("대|한|제|국","大|韓|帝|國")으로 바꾸고 #ruby("위|호","位|號")를 #ruby("황|제","皇|帝")로 높였다.] #ruby("진|영","眞|影")이 나오자 나는 #ruby("일|동","一|同")에게 #ruby("기|립|국|궁","起|立|鞠|躬")#footnote(numbering: _ => [26)])[#h(0.35em)일어나 고개 숙여 #ruby("경|의","敬|意")를 #ruby("표","表")하는 것.]을 #ruby("명","命")하여 #ruby("한|인","韓|人") #ruby("관|민","官|民")은 물론이고 #ruby("왜","倭")놈 #ruby("장|교","將|領")와 #ruby("경|관","警|官") 무리까지 #ruby("국|궁","鞠|躬")을 시킨 #ruby("후","後") ‘#ruby("한|인","韓|人")이 #ruby("일|본","日|本")을 #ruby("배|척","排|斥")하는 #ruby("이|유","理|由")는 무엇인가’라는 #ruby("제|목","題|目")으로 #ruby("강|연","講|演")하였다.]
#zh[开幻灯会的时候，各面十多所学校、郡内有志之士，甚至妇女儿童都来参加，男女听众达数千名。郡守成乐英、税务署长具滋根等各官厅的官员、日本军官和警官多人均出席了此会。我先请了大皇帝陛下的尊灵，安奉在讲台的正前方，要全体与会者一同起立鞠躬，当然与会的日本军官也不能例外，这样做了以后室内无形中增加了严肃的气氛。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("과|거","過|去") #ruby("러|일|전|쟁","露|日|戰|爭")·#ruby("중|일|전|쟁","中|日|戰|爭") 때만 해도 #ruby("한|인","韓|人")의 #ruby("일|본","日|本")에 대한 #ruby("감|정","感|情")이 #ruby("극","極")히 #ruby("우|호|적","友|好|的")이었으나 #ruby("그|후","其|後")에 #ruby("강|압|조|약","强|壓|條|約")이 #ruby("체|결","締|結")됨에 따라 나쁜 #ruby("감|정","感|情")이 #ruby("점|점","漸|漸") #ruby("격|증","激|增")하였다. 내가 #ruby("연|전","年|前")에 #ruby("문|화","文|化") #ruby("종|산","鍾|山")에서 #ruby("직|접","直|接") 겪은 #ruby("사|실","事|實")로, #ruby("일|본|군","日|本|軍")이 시골 마을에서 #ruby("약|탈","掠|奪")을 #ruby("감|행","敢|行")하는 것을 #ruby("목|도","目|覩")했는데, #ruby("일|본","日|本")의 이와 같은 나쁜 #ruby("행|위","行|爲")가 곧 #ruby("한|인","韓|人")의 #ruby("배|일|감|정","排|日|感|情")의 #ruby("원|인","原|因")이라고 큰소리로 꾸짖었다. 나란히 앉은 #ruby("성|낙|영","成|樂|英")·#ruby("구|자|록","具|滋|祿")을 보니 얼굴이 흙빛으로 바뀌었고 #ruby("왜","倭")놈들은 #ruby("노|기","怒|氣")가 #ruby("등|등","騰|騰")했다.]
#zh[过去日俄战争、中日战争的时候，韩人对日本的感情还极其友好，此后随着强迫条约的缔结，恶感渐渐激增。我拿年前在文化钟山亲身经历的事实，说亲眼看到日本军在乡村抢掠，大声斥责：日本这种恶劣行为，就是韩人排日感情的原因。一看并坐的成乐英、具滋根，脸色变成土灰，倭寇则怒气腾腾。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[갑자기 #ruby("경|찰","警|察")이 #ruby("환|등|회","幻|燈|會")를 #ruby("해|산","解|散")하고 나를 #ruby("경|찰|서","警|察|署")로 데려갔다. #ruby("군|중","群|衆")은 #ruby("감","敢")히 말은 못하였지만 #ruby("분","憤")이 나 대단히 #ruby("격|앙","激|昂")한 #ruby("분|위|기","雰|圍|氣")였다. 나를 #ruby("경|찰|서","警|察|署")에 데리고 가서 #ruby("한|인","韓|人") #ruby("감|독","監|督") #ruby("순|사","巡|査")의 #ruby("숙|직|실","宿|直|室")에서 같이 묵게 하였다. 그러자 #ruby("각","各") #ruby("학|교","學|校")에서 #ruby("학|생","學|生")들이 #ruby("차|례|차|례","次|例|次|例")로 #ruby("방|문","訪|問")하기로 하고, #ruby("위|문|대","慰|問|隊")를 #ruby("조|직","組|織")하여 #ruby("연|속","連|續")하여 #ruby("위|문","慰|問")하였다.]
#zh[忽然警察解散了幻灯会，把我带到警察署。群众不敢说话，气氛却非常激昂。他们把我带到警察署，让我和韩人监督巡查一起住在值班室。于是各校学生决定依次来访，组织了慰问队，连续前来慰问。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하룻밤을 자고 다음날에 #ruby("하|얼|빈","哈|爾|濱") #ruby("전|보","電|報")로, #ruby("이|토","伊|藤") #ruby("히로부미","博文")가 #ruby("한|인","韓|人") #ruby("은|치|안","安|應|七")에게 #ruby("피|살","被|殺")되었다는 #ruby("신|문","新|聞")을 보았다.#footnote(numbering: _ => [27)])[#h(0.35em)원주: “은치안 三字가 其時 新聞에 揭載된 것은 安應七이니 卽 安重根의 字가 應七임이라.” ‘은치안’은 아마도 ‘응칠안’의 #ruby("중|국|식","中|國|式") #ruby("발|음","發|音")인 ‘잉치안’일 것이다.] #ruby("은|치|안","安|應|七")이 누구인지를 몰라 매우 궁금하였는데, 다음날 아침에 #ruby("안|응|칠","安|應|七"), 곧 #ruby("안|중|근","安|重|根")으로 #ruby("명|백","明|白")하게 #ruby("신|문","新|聞")에 #ruby("기|재","記|載")되었다.]
#zh[翌日早上，从报纸上看到来自哈尔滨的消息说，伊藤博文被一个叫做安应七的韩人暗杀了。当日整天猜测，到底是谁？第二天又从新闻报道上看到，才知道他就是安重根，因此回忆起十几年前我在清溪洞见过射击术极高明的少年。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때에야 나는 어렴풋하게나마 내가 #ruby("구|류","拘|留")당하는 #ruby("원|인","原|因")을 깨달았다. 그날 저녁 #ruby("환|등|회","幻|燈|會")에서 #ruby("일|본","日|本")놈을 꾸짖고 욕하였지만 이미 여러 곳에서 그랬는데 #ruby("하|필","何|必") #ruby("송|화","松|禾") #ruby("경|찰","警|察")이 나에게 손을 댄 것을 #ruby("이|상","異|常")하게 여겼다. 그리고 #ruby("구|류","拘|留")를 당한다 해도 며칠 #ruby("후","後")면 #ruby("훈|방","訓|放")될 것으로 알았는데, #ruby("하|얼|빈","哈|爾|濱") #ruby("사|건","事|件")에 #ruby("관|련","關|聯")되는 #ruby("혐|의","嫌|疑")라면 좀 길게 #ruby("고|생","苦|生")하리라 생각되었다.]
#zh[那时我才隐约明白自己被拘留的原因。那天晚上在幻灯会上责骂了日本人，这种事已经在许多地方有过，偏是松禾警察对我下手，我觉得奇怪。即便被拘留，也以为过几天就会训放；若是和哈尔滨事件有关的嫌疑，便想到要多吃些苦。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[며칠 #ruby("후","後") #ruby("평|범","平|凡")한 말 몇 마디를 #ruby("신|문","訊|問")하고서 #ruby("유|치|장","留|置|場")에서 한 달을 지내게 하더니 #ruby("해|주","海|州") #ruby("지|방|재|판|소","地|方|裁|判|所")로 #ruby("압|송","押|送")하였다. #ruby("수|교","水|橋") #ruby("감|승|무","甘|承|武") 집에서 #ruby("점|심","點|心")을 먹을 때, #ruby("시|내","市|內") #ruby("학|교","學|校") #ruby("직|원","職|員")과 #ruby("시","市") #ruby("유|지","有|志")들이 #ruby("일|제","一|齊")히 모여서 #ruby("호|송","護|送")하는 #ruby("왜|순|사","倭|巡|査")에게 #ruby("요|청","要|請")하였다. #ruby("김|구","金|龜") #ruby("선|생","先|生")은 우리 #ruby("교|육|계","敎|育|界") #ruby("사|표","師|表")이니, #ruby("위|로|연","慰|勞|宴")을 베풀고 한 #ruby("차|례","次|例") #ruby("대|접","待|接")하겠다는 것이었다. #ruby("순|사","巡|査")는 #ruby("후|일","後|日") #ruby("해|주","海|州") 다녀온 #ruby("후","後") 실컷 #ruby("위|로","慰|勞")하라며 #ruby("거|절","拒|絕")했다.]
#zh[几天后只问了几句平常的话，便让我在留置场过了一个月，然后押送到海州地方法院。在水桥甘承武家里吃午饭时，市内学校职员和市内有志一齐聚集，向押送的倭巡查请求，说金龟先生是我们教育界的师表，要设慰劳宴招待一次。巡查拒绝了，说等从海州回来再尽情慰劳。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("해|주","海|州")에 #ruby("도|착","到|着")한 #ruby("즉|시","卽|時") #ruby("투|옥","投|獄")되었다. 하룻밤을 지내고, #ruby("검|사","檢|事")가 #ruby("안|중|근","安|重|根")과의 #ruby("관|계","關|係")를 #ruby("질|문","質|問")하였다. 그러나 #ruby("이|전","以|前")에는 #ruby("안|중|근","安|重|根") 집안과 #ruby("각|별","各|別")한 #ruby("관|계","關|係")에 있었지만 이번의 #ruby("하|얼|빈","哈|爾|濱") #ruby("사|건","事|件")과는 아무런 #ruby("관|련","關|聯")이 없다는 것을 알고, #ruby("검|사","檢|事")는 『#ruby("김|구","金|龜")』라고 쓴 100#ruby("여","餘") 쪽의 #ruby("책|자","冊|子")를 내놓고 #ruby("신|문","訊|問")했다. 그 #ruby("책","冊")은 내가 #ruby("수|년|간","數|年|間") #ruby("각","各") #ruby("지|방","地|方")을 돌아다니며 #ruby("일|본","日|本") #ruby("관|헌","官|憲")과 #ruby("반|목","反|目")한 것에 대한 #ruby("경|찰","警|察")의 #ruby("보|고","報|告")를 모은 것이었다.]
#zh[我一到海州就被投进监狱。过了一夜，检查官质问我和安重根的关系。从前虽然和安重根一家特别有关系，和这次哈尔滨事件却毫无关联。检查官知道这一点后，拿出写着“金龟”、一百余页的册子来审问。那本书收集的，是我数年间往来各地、和日本官宪反目的警察报告。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("불|기|소","不|起|訴")로 풀려나자 나는 #ruby("행|장","行|裝")을 챙겨서 #ruby("박|창|진","朴|昌|鎭")의 #ruby("책|방","冊|房")에 갔다. 마침 #ruby("박|군","朴|君")과 만나 그#ruby("간","間")의 #ruby("경|과","經|過")를 이야기하고 있을 때, 곁에 있던 #ruby("유|훈|영","柳|薰|永") #ruby("군","君")이 #ruby("인|사","人|事")를 하더니, #ruby("자|기","自|己") #ruby("부|친","父|親")의 #ruby[회갑연][壽筵]에 함께 #ruby("참|석","參|席")하여 달라고 #ruby("요|청","要|請")했다. #ruby("수|연","壽|筵")을 맞은 #ruby("노|인","老|人")은 곧 #ruby("해|주","海|州") #ruby("부|호","富|豪") 가운데 한 사람인 #ruby("유|장|단","柳|長|湍")이었다. 그런데 #ruby("송|화","松|禾") #ruby("경|찰|서","警|察|署")에서 나를 #ruby("호|송","護|送")했던 #ruby("한","韓")·#ruby("일","日") #ruby("순|사","巡|査") 가운데 #ruby("한|인","韓|人") #ruby("순|사","巡|査")들은, 나를 #ruby("동|정","同|情")하는 사람들로 #ruby("사|건","事|件")의 #ruby("진|행","進|行")을 알고 싶어 떠나지 않고 있었다. #ruby("연|회","宴|會")를 마친 #ruby("후","後") 나는 #ruby("순|사","巡|査") #ruby("전|부","全|部")를 #ruby("음|식|점","飮|食|店")으로 불러서 #ruby("경|과","經|過")를 말해 주고 되돌아가도록 했다.]
#zh[以不起诉释放之后，我收拾行装，到朴昌镇的书店去。正遇见朴君，讲着这期间的经过，旁边的柳熏永君打了招呼，请我一同去参加他父亲的花甲宴。做寿的老人就是海州富户之一柳长湍。从松禾警察署押送我的韩、日巡查之中，那些韩人巡查同情我，想知道事件怎样进行，还没有离开。宴会之后，我把巡查全部请到饮食店，把经过告诉他们，让他们回去。]
#figure-block("/images/p204.jpg", caption: [#ruby("안|중|근","安|重|根") #ruby("의|사","義|士")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|승|준","李|承|駿")·#ruby("김|영|택","金|泳|澤")·#ruby("양|낙|주","梁|洛|疇") #ruby("제|군","諸|君")들이 #ruby("방|문","訪|問")할 즈음, #ruby("안|악","安|岳") #ruby("친|구","親|舊")들이 #ruby("한|정|교","韓|貞|敎")를 #ruby("파|송","派|送")해 왔다. #ruby("동|지","同|志")들이 #ruby("우|려","憂|慮")할 것을 생각하고 하루 일찍 #ruby("한|정|교","韓|貞|敎")를 따라 #ruby("안|악","安|岳")으로 되돌아갔다.]
#zh[安岳的同志们挂念着我的事情，派了韩贞教到海州来，因此我访问了李承骏、金冰泽、梁洛畴等几位朋友后，就随韩贞教返回安岳。]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) #ruby("재|령|지|역","載|寧|地|域") #ruby("교|육|운|동","敎|育|運|動")의 #ruby("추|억","追|憶")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校")에는 #ruby("중","中")·#ruby("소|학|부","小|學|部"), 2#ruby("부","部")를 두고 있었는데, 처음에는 #ruby("이|인|배","李|仁|培")가 #ruby("교|장","校|長")이었고, 그 뒤는 #ruby("김|홍|량","金|鴻|亮")이 #ruby("교|주","校|主") 겸 #ruby("교|장","校|長")이 되었다. 나는 #ruby("소|학|부","小|學|部")에서 #ruby("유|년","幼|年")의 #ruby("교|육","敎|育")을 #ruby("담|임","擔|任")하면서, #ruby("재|령","載|寧") #ruby("북|율|면","北|栗|面") #ruby("무|상|동","武|尙|洞")의 #ruby("보|강|학|교","保|强|學|校") #ruby("교|장","校|長")을 겸하여 그 #ruby("학|교","學|校")에도 #ruby("종|종","種|種") #ruby("왕|래","往|來")하였다.]
#zh[当时安岳杨山学校设有中学、小学两部。起初李仁培当校长，后来金鸿亮任校主兼校长。我在小学部担任幼年教育，又兼任载宁北栗面武尚洞保强学校的校长，常常往来那个学校。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("보|강|학|교","保|强|學|校")는 처음 #ruby("노|동|자","勞|動|者")들이 #ruby("주|동","主|動")이 되어 #ruby("설|립","設|立")하였는데, #ruby("부|근","附|近") 동네 #ruby("유|지","有|志")들이 #ruby("운|영","運|營")하면서 #ruby("학|교","學|校") #ruby("진|흥|책","振|興|策")으로 나를 #ruby("교|장","校|長")으로 뽑은 것이었다. #ruby("전|승|근","田|承|根")을 #ruby("주|임|교|사","主|任|敎|師")로 #ruby("임|명","任|命")하고, #ruby("장|덕|준","張|德|俊")은 #ruby("교|사","敎|師") 겸 #ruby("학|생","學|生")으로 #ruby("친|동|생","親|同|生") #ruby("덕|수","德|秀")#footnote(numbering: _ => [28)])[#h(0.35em)#ruby[장|덕|수][張|德|秀]\(1895〜1947). #ruby("호","號")는 #ruby("설|산","雪|山"). #ruby("일|본","日|本") #ruby("유|학","留|學") #ruby("후","後") #ruby("귀|국","歸|國")하여 『#ruby("동|아|일|보","東|亞|日|報")』 #ruby("창|간","創|刊")할 때 #ruby("주|간","主|幹")을 맡았다. #ruby("해|방","解|放") #ruby("후","後") #ruby("한|국|민|주|당","韓|國|民|主|黨") #ruby("외|교|부|장","外|交|部|長")·#ruby("정|치|부|장","政|治|部|長")을 #ruby("역|임","歷|任")하다 1947#ruby("년","年") 12#ruby("월","月") #ruby("암|살","暗|殺")되었다. #ruby("한|민|당","韓|民|黨")에서는 #ruby("암|살","暗|殺")의 #ruby("배|후","背|後")로 #ruby("백|범","白|凡")을 #ruby("지|목","指|目")하였고, #ruby("재|판","裁|判") #ruby("참|고|자|료","參|考|資|料")로 『#ruby("백|범|일|지","白|凡|逸|志")』가 #ruby("필|사","筆|寫")되었다.]를 데리고 #ruby("교|내","校|內")에 #ruby("숙|식","宿|食")하며, #ruby("교|감","校|監") #ruby("허|정|삼","許|貞|三") #ruby("등","等")의 #ruby("협|력","協|力")으로 #ruby("교|무","校|務")를 #ruby("발|전","發|展")해 갈 때였다.]
#zh[保强学校起初由劳动者主动设立，附近村子的有志之士经营着，为了振兴学校，选我当了校长。我任命田承根为主任教员。张德俊半是教员、半是学生，带着亲弟弟德秀在校内食宿，和学监许贞三等协力，正把教务发展起来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("교|사","校|舍")는 #ruby("신|축","新|築")하던 #ruby("중","中")이어서 아즉 #ruby("개|와","蓋|瓦")치 못하고 #ruby("개|초","蓋|草")만 하고#footnote(numbering: _ => [29)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “아직 기와를 얹지 못하고 이엉으로 #ruby("대|강","大|綱") 얽어”. #ruby("개|초","蓋|草")는 이엉으로 지붕을 이는 것.] #ruby("개|교","開|校")하여 가르치고 있었다. #ruby("학|교","學|校")는 #ruby("무|상|동","武|尙|洞")에서 떨어져 #ruby("야|외","野|外")에 #ruby("독|립","獨|立")한 #ruby("교|사","校|舍")였는데, #ruby("종|종","種|種") #ruby[도깨비불][鬼火]이 #ruby("발|생","發|生")하여 #ruby("진|화","鎭|火")한다는 #ruby("보|고","報|告")가 있었다. 나는 #ruby("교|직|원","敎|職|員") 한 사람에게 #ruby("비|밀","祕|密")히 #ruby("주|의","注|意")를 주었다. #ruby("화|재","火|災")가 #ruby("매|번","每|番") 밤이 깊은 #ruby("후","後")에 일어난다 하니, 3#ruby("일","日") 동안 #ruby("은|밀","隱|密")한 곳에 숨어서 사람의 #ruby("흔|적","痕|跡")이 있는지 살피고, #ruby("흔|적","痕|跡")이 있으면 가만히 #ruby("추|적","追|跡")하여 #ruby("행|동","行|動")을 살펴보라고 #ruby("지|시","指|示")하였다.]
#zh[校舍正在新建，还没能盖瓦，只苫了草，就开学授课。学校离开武尚洞，独立在野外。常常有报告说起了鬼火，被扑灭了。我秘密嘱咐一位教职员：火灾每次都在夜深以后发生，你在隐秘处藏三天，看有没有人的踪迹；有踪迹就悄悄跟踪，观察他的行动。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("과|연","果|然") 둘째 날에 #ruby("급|보","急|報")가 왔다. #ruby("학|교","學|校")에 #ruby("중|대|사|고","重|大|事|故")가 있으니 #ruby("교|장","校|長")이 #ruby("출|석","出|席")하여 달라는 #ruby("보|고","報|告")를 받은 #ruby("즉|시","卽|時") #ruby("학|교","學|校")에 나가보니, 지키던 #ruby("직|원","職|員")이 불을 지른 #ruby("범|인","犯|人") 한 #ruby("명","名")을 묶어놓았고, 동네와 #ruby("학|교","學|校")에서는 ‘죽이자’ ‘살리자’ 하는 #ruby("소|동","騷|動")이 일어났다. 내가 #ruby("범|인","犯|人")을 #ruby("직|접","直|接") #ruby("심|문","訊|問")하니, 그는 그 동네 #ruby("서|당","書|堂") #ruby("훈|장","訓|長")이었다. 내가 동네 어른들을 #ruby("초|청","招|請")해 #ruby("신|교|육","新|敎|育")의 #ruby("필|요","必|要")를 #ruby("설|명","說|明")하자 #ruby("자|기","自|己")가 가르치던 #ruby("아|동","兒|童") 4, 5#ruby("명","名")이 #ruby("전|부","全|部") #ruby("학|교","學|校")에 #ruby("입|학","入|學")하게 되어, #ruby("자|기","自|己")는 #ruby("고|역","苦|役")인 #ruby("농|사","農|事")밖에 #ruby("생|활|방|도","生|活|方|道")가 없게 된 것을 #ruby("원|망","怨|望")해서 #ruby("방|화","放|火")하였다고 #ruby("자|백","自|白")하였다.]
#zh[果然第二天来了急报，说学校出了重大事故，请校长出席。我立刻到校一看，值班的职员捆着一个放火的犯人，村子里和学校里闹着“杀掉”“饶了”。我亲自审问，他是那个村子的书堂训长。我请来村里的长辈，说明新教育的必要，他原来教的四五个儿童便全部进了学校，他自己除了苦重的农活再无生路，因此怨恨而放火。他这样招了供。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 일찍이 #ruby("학|교","學|校") #ruby("사|무|원","事|務|員")을 불러 #ruby("학|교","學|校")에 #ruby("화|재","火|災")가 나던 #ruby("진|상","眞|相")을 물으니 그이들은 #ruby("확|실","確|實")히 도깨비불이라 했다. #ruby("학|교","學|校") #ruby("부|근","附|近") 땅에 그 동네에서 해마다 #ruby("제|사","祭|祀")드리던 이른바 #ruby("부|군|당","府|君|堂")#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("관|아","官|衙")에서 #ruby("신|령","神|靈")을 모시던 #ruby("신|당","神|堂").]이란 것이 있고 그 #ruby("당","堂") #ruby("주|위","周|圍")에는 아름드리 #ruby("고|목","古|木")이 늘어서 있었는데, #ruby("학|교","學|校") #ruby("건|물","建|物")을 새로 #ruby("건|축","建|築")한 #ruby("후","後") 그 #ruby("고|목","古|木")을 베어 #ruby("학|교","學|校")의 #ruby("연|료","燃|料")로 #ruby("사|용","使|用")하였다. 그 까닭으로 동네 #ruby("인|민","人|民")들이 도깨비불로 여겨, #ruby("학|교","學|校")에서 #ruby("부|군|당","府|君|堂")에 #ruby("제|사","祭|祀")지내지 않으면 #ruby("화|재","火|災")를 피하지 못한다는 #ruby("미|신","迷|信")이 #ruby("분|분","紛|紛")하였다 한다. 그래서 내가 그 #ruby("교|직|원","敎|職|員")에게 #ruby("은|밀","隱|密")히 #ruby("지|시","指|示")해 놓았던 것이다.]
#zh[我早先叫来学校事务员，问学校起火的真相，他们一口咬定是鬼火。学校附近的地上，有村里每年祭祀的所谓府君堂，堂的周围立着合抱的古木。新盖校舍之后，砍了那些古木当作学校的燃料。因此村里人当成鬼火，纷纷传说：学校若不向府君堂祭祀，就避不开火灾。所以我才秘密指示了那位教职员。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("직|원","職|員") #ruby("보|고","報|告")에 #ruby("의","依")하면, 두#ruby("번","番")째 #ruby("화|재","火|災")가 난 뒤 #ruby("매|일","每|日") 밤 #ruby("교|사","校|舍") #ruby("부|근","附|近")에 #ruby("은|신","隱|身")하고 #ruby("감|시","監|視")하던 이틀째 되는 밤#ruby("중","中"), #ruby("무|상","武|尙") 동네로부터 #ruby("학|교","學|校")로 가는 길에 사람의 기척이 있어 가만히 따라가 보니, 어떤 사람이 #ruby("황|급","遑|急")히 #ruby("교|사","校|舍")로 달려가 #ruby("강|당","講|堂")의 지붕과 마주보고 있는 #ruby("사|무|실","事|務|室") 지붕에 무슨 #ruby("물|건","物|件")을 던지는 것이었다. #ruby("강|당","講|堂") 지붕에는 벌써 #ruby("화|염","火|焰")이 일어나고, #ruby("사|무|실","事|務|室") 지붕에는 반딧불과 같이 반짝반짝하면서 아직 불이 일어나지 않는 것을 본 그 사람이 #ruby("도|주","逃|走")하려고 할 즈음, 지키던 #ruby("직|원","職|員")이 붙잡아서 #ruby("결|박","結|縛")하고, 동네사람들을 불러 불을 끄고, 나에게 #ruby("급","急")히 #ruby("보|고","報|告")한 것이었다.]
#zh[据职员报告：第二次火灾之后，他每天夜里藏在校舍附近监视。到了第二天半夜，从武尚村子通往学校的路上有人的动静，他悄悄跟去，看见一个人慌忙跑向校舍，朝和礼堂屋顶相对的办公室屋顶扔了什么东西。礼堂屋顶已经起了火焰，办公室屋顶像萤火似地一闪一闪，火还没有燃起来。那人正要逃走，值班的职员抓住捆了起来，叫来村里人灭了火，急忙报告了我。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("범|인","犯|人")을 #ruby("신|문","訊|問")하니 #ruby("일|일","一|一")이 #ruby("자|백","自|白")했다. #ruby("과|연","果|然") #ruby("학|교","學|校")가 #ruby("자|기","自|己") #ruby("생|활","生|活")에 #ruby("손|해","損|害")를 미치기 때문에 #ruby("방|화","放|火")하였다는 것이요, 그 #ruby("방|법","方|法")은 #ruby("일|지|장","一|指|長")의 #ruby("화|승|말|단","火|繩|末|端")에 당셕냥 한 줌을 #ruby("약|두","藥|頭")를 #ruby("총|결","總|結")하고,#footnote(numbering: _ => [31)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “손가락 길이만큼 되는 #ruby("화|약","火|藥")심지 머리에 당성냥 한 줌을 뭉쳐 바르고”.] 줄 끝에 돌멩이를 매달아 지붕에 던져 불을 냈다는 것이었다. 나는 #ruby("경|찰","警|察")에 #ruby("고|발","告|發")하지 않고 조용히 마을을 떠날 것을 #ruby("명","命")하였다.]
#zh[审问那个犯人，他一一招供。果然因为学校损害了他的生活，才放的火。方法是在一指来长的火绳头上捆一把火柴，线头拴上石块，扔到屋顶上点火。我没有向警察告发，只命他悄悄离开村子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳")에서 그 #ruby("학|교","學|校")까지 20#ruby("리","里") #ruby("거|리","距|離")이므로, #ruby("일|주|일","一|週|日")에 한 #ruby("차|례","次|例")씩 #ruby("보|강|학|교","保|强|學|校")에 나갔다. #ruby("안|악|읍","安|岳|邑")에서 #ruby("신|환|포","新|換|浦") #ruby("하|류","下|流")를 건너 #ruby("학|교","學|校")로 가는데, 여름철에 #ruby("학|교","學|校")에 가면서 나루터를 #ruby("향","向")해 가노라면, #ruby("학|교","學|校")에서는 #ruby("소|학|생","小|學|生")들이 나를 바라보고 #ruby("영|접","迎|接")하느라고 몰려나오고 #ruby("직|원","職|員")들도 뒤를 이어 나온다. 내가 나루터에 #ruby("도|착","到|着")하여 보니, 건너편에 와 있던 #ruby("소|학|생","小|學|生") #ruby("전|부","全|部")가 #ruby("의|복","衣|服")을 척척 벗고 #ruby("강","江") 속으로 뛰어 들어간다.]
#zh[从安岳到那个学校有二十里，我一周去一次保强学校。从安岳邑渡过新换浦下游前往学校。夏天走向渡口时，学校里的小学生挤出来迎接我，职员也跟着出来。我到了渡口一看，对岸来的小学生全都脱光衣服，跳进江里。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 크게 놀라 #ruby("고|함","高|喊")을 지르니, #ruby("직|원","職|員")들은 #ruby("강","江")가에서 웃으면서 #ruby("안|심","安|心")하라고 #ruby("답","答")한다. 나룻배에 올라 #ruby("강","江") 가운데로 나아가자, 거뭇거뭇한 #ruby("학|생","學|生")들의 머리가 물 속에서 나타나 뱃전에 매달리는 것이, 마치 쳇바퀴에 개미떼 붙듯 하였다. 나는 #ruby("장|래","將|來")에 #ruby("해|군","海|軍")을 #ruby("모|집","募|集")하게 되면 #ruby("연|해","沿|海") #ruby("촌|락","村|落")에서 #ruby("인|력","人|力")을 #ruby("모|집","募|集")하는 것이 #ruby("편|리","便|利")하겠다고 생각했다.]
#zh[我大吃一惊，高声喊叫。职员们却在江边笑着，叫我放心。上了渡船走到江心，黑黝黝的学生脑袋从水里冒出来，挂在船舷上，像蚂蚁附着在转轮上。我想，将来招募海军，到沿海村落征集人力会方便些。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("무|상|동","武|尙|洞") 역시 #ruby("재|령","載|寧") #ruby("여|물|평","餘|物|坪")의 한 동네이다. #ruby("평|내","坪|內")에는 #ruby("특|별","特|別")한 #ruby("거|부","巨|富")는 없으나 #ruby("보|통","普|通")으로는 그다지 #ruby("빈|곤","貧|困")하지 않은 곳이니, #ruby("토|지","土|地")가 #ruby("대|부|분","大|部|分") #ruby("궁|장","宮|庄")#footnote(numbering: _ => [32)])[#h(0.35em)#ruby("궁","宮")에 #ruby("소|속","所|屬")된 #ruby("농|장","農|場"), #ruby("즉","卽") #ruby("궁|장|토","宮|庄|土"). #ruby("조|선|조","朝|鮮|朝") #ruby("재|령","載|寧") #ruby("여|물|평","餘|物|坪")\(나무리벌)은 #ruby("궁|장|토","宮|庄|土")가 #ruby("집|결","集|結")된 #ruby("지|역","地|域")으로 #ruby("유|명","有|名")하다. 이 #ruby("비|옥","肥|沃")한 #ruby("토|지","土|地")들은 #ruby("토|지|조|사|사|업","土|地|調|査|事|業") #ruby("이|후","以|後") #ruby("대|부|분","大|部|分") #ruby("동|양|척|식|회|사","東|洋|拓|殖|會|社") #ruby("소|유","所|有")의 #ruby("농|장","農|場")이 되었다.]이고 #ruby("지|극","至|極")히 #ruby("비|옥","肥|沃")한 까닭이다. #ruby("인|품","人|品")이 #ruby("명|민","明|敏")·#ruby("준|수","俊|秀")하며, #ruby("시|대","時|代") #ruby("변|천","變|遷")에 #ruby("순|응","順|應")하여 #ruby("운|수","雲|水")·#ruby("진|초","進|礎")·#ruby("보|강","保|强")·#ruby("기|독","基|督") #ruby("학|교","學|校") #ruby("등","等")을 #ruby("설|립","設|立")하여 #ruby("자|제","子|弟")를 #ruby("교|육","敎|育")하고, #ruby("농|무|회","農|務|會")를 #ruby("조|직","組|織")하여 #ruby("농|업","農|業") #ruby("발|달","發|達")을 #ruby("계|도","啓|導")하는 #ruby("등","等") #ruby("공|익|사|업","公|益|事|業")에 #ruby("착|안","着|眼")하는 것이 #ruby("실","實")로 볼 만했다.]
#zh[此地虽然没有很富裕的人，但因都是宫田，土地肥沃，所以大家也都还过得去，并且乡民们都很开通，很会适应时代的变迁。他们一方面建立云水、进础、保强、基督等学校，教育子女，另一方面组织农务会，谋求农业的改良和发展，他们对于公益事业的眼光实在是很远大的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("나|석|주","羅|錫|疇")#footnote(numbering: _ => [33)])[#h(0.35em)#ruby[나|석|주][羅|錫|疇]\(1892〜1926). #ruby("재|령","載|寧") #ruby("여|물|평","餘|物|坪") #ruby("북|률|면","北|栗|面") #ruby("출|신","出|身")으로 #ruby("보|명|학|교","普|明|學|校")에서 #ruby("수|학","修|學")하였고, 1913#ruby("년","年") #ruby("북|간|도","北|間|島")로 건너가 #ruby("무|관|학|교","武|官|學|校")에 #ruby("입|학","入|學"), #ruby("군|사|훈|련","軍|事|訓|鍊")을 받았다. 1919#ruby("년","年") #ruby("국|내","國|內")에 들어와 3·1#ruby("운|동","運|動")에 #ruby("참|여","參|與")하였고, #ruby("여|물|평","餘|物|坪") #ruby("지|역","地|域")에서 #ruby("비|밀|결|사","祕|密|結|社")를 #ruby("조|직","組|織")하여 #ruby("친|일|파","親|日|派")를 #ruby("숙|청","肅|淸")하고 #ruby("군|자|금","軍|資|金")을 모으다 #ruby("일|본","日|本")의 #ruby("감|시","監|視") 때문에 #ruby("상|해","上|海")로 #ruby("망|명","亡|命")하였다.] #ruby("의|사","義|士")는 #ruby("당|시","當|時") #ruby("젊|은","妙|齡") #ruby("청|년","靑|年")으로, 나라의 #ruby("형|세","形|勢")가 날로 잘못되어 감을 #ruby("한","恨")스럽게 생각하여, #ruby("평|내","坪|內")에서 #ruby("남|녀","男|女") 어린 아이 8, 9#ruby("명","名")을 배에 싣고 #ruby("비|밀|리","祕|密|裏")에 #ruby("중|국","中|國")으로 건너가 #ruby("철|망","鐵|網") 밖에서 #ruby("교|육","敎|育")시켜 보고자 #ruby("출|발","出|發")하다가, #ruby("장|련","長|連") #ruby("오|리|포","梧|里|浦")에서 #ruby("왜|경","倭|警")에게 #ruby("발|각","發|覺")되어 여러 달 #ruby("옥|고","獄|苦")를 치렀다. #ruby("출|옥","出|獄") #ruby("후","後")에는 겉으로 #ruby("상|업","商|業"), #ruby("농|업","農|業")에 #ruby("종|사","從|事")하면서 속으로는 #ruby("독|립","獨|立")의 #ruby("사|상","思|想")을 #ruby("고|취","鼓|吹")시키며, #ruby("직|접","直|接") #ruby("간|접","間|接")으로 #ruby("교|육","敎|育")에 #ruby("열|성","熱|誠")을 다하여 #ruby("평|내","坪|內") #ruby("청|년","靑|年")의 우두머리로 #ruby("신|임","信|任")을 받고 있었다. 나도 #ruby("종|종","種|種") #ruby("여|물|평","餘|物|坪")에 #ruby("왕|래","往|來")하게 되었다.]
#zh[义士罗锡畴也是此地人，以弱冠之年，带领八九名少年，企图冲破倭寇的封锁线，乘船离开韩国，到中国去办教育事业，然而在长连梧里浦被日警逮捕，受了几个月的牢狱之苦，才被释放出来。表面上他是做生意或种田，其实暗地里却在青年中鼓吹独立思想，同时直接、间接地从事教育工作，所以成为当地青年们信赖与寄以厚望的中心人物，我也常常去和他会晤。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("노|백|린","盧|伯|麟")#footnote(numbering: _ => [34)])[#h(0.35em)#ruby[노|백|린][盧|伯|麟]\(1876〜1925). #ruby("호","號")는 #ruby("계|원","桂|園"). #ruby("황|해|도","黃|海|道") #ruby("은|율","殷|栗") #ruby("출|신","出|身")으로 #ruby("일|본","日|本")으로 #ruby("유|학","留|學")가 #ruby("일|본","日|本") #ruby("육|군|군|관|학|교","陸|軍|軍|官|學|校")를 #ruby("졸|업","卒|業")했다. 그#ruby("후","後") #ruby("귀|국","歸|國")하여 #ruby("대|한|제|국","大|韓|帝|國")의 #ruby("군","軍") #ruby("요|직","要|職")을 두루 #ruby("역|임","歷|任")하였다. #ruby("군|대","軍|隊")가 #ruby("해|산","解|散")되고 #ruby("국|권","國|權")도 빼앗기자 그는 #ruby("신|민|회","新|民|會")에 #ruby("관|여","關|與")하고 #ruby("해|서|교|육|총|회|장","海|西|敎|育|總|會|長")으로 #ruby("교|육|운|동","敎|育|運|動")을 했다. 1919#ruby("년","年") #ruby("중|국","中|國")으로 #ruby("망|명","亡|命")하여 #ruby("상|해|임|시|정|부","上|海|臨|時|政|府") #ruby("군|무|총|장","軍|務|總|長")을 지냈다.]이 #ruby("군|직","軍|職")에서 물러나 #ruby("풍|천","豊|川") #ruby("자|택","自|宅")에서 #ruby("교|육|사|업","敎|育|事|業")에 #ruby("종|사","從|事")하던 때였다. 하루는 #ruby("경|성","京|城") 가는 길에 #ruby("안|악","安|岳")에서 그와 #ruby("상|봉","相|逢")하여, 함께 #ruby("여|물|평","餘|物|坪") #ruby("진|초|동","進|礎|洞") #ruby("교|육|가","敎|育|家")인 #ruby("김|정|홍","金|正|洪") #ruby("군","君")의 집에서 같이 잤다. #ruby("진|초|학|교","進|礎|學|校") #ruby("직|원","職|員")들과 함께 술을 마시던 즈음 갑자기 동네에서 #ruby("소|동","騷|動")하는 소리가 났다. #ruby("진|초|학|교","進|礎|學|校") #ruby("교|장","校|長") #ruby("김|정|홍","金|正|洪")이 놀라고 두려워서 어찌할 바를 모르면서 #ruby("사|실","事|實")을 말했다.]
#zh[有一天在安岳遇见了卢伯麟，他那时放弃了军职，在丰川家里从事教育，这次去汉城经过安岳，我们得以相逢，于是结伴同行，到余物坪进础洞金正洪家里住了一夜。金君也是该乡镇的教育家。]
#zh[晚上和进础学校教职员一起共进晚餐时，突然村内一阵骚乱，校长金正洪急匆匆地跑进来说，进础学校女教员吴仁星的丈夫李在明用手枪威胁吴仁星，不知要干什么，因此仁星无法到校上课，躲避在某一位朋友家里。李在明声言要杀死全部卖国贼，在村口疯狂地乱放枪，全村被他搅得惶惶不安。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[학교의 #ruby("여|교|사","女|敎|師") #ruby("오|인|성","吳|仁|星")은 #ruby("이|재|명","李|在|明")#footnote(numbering: _ => [35)])[#h(0.35em)#ruby[이|재|명][李|在|明]\(1890〜1910). #ruby("평|양","平|壤")사람으로 1904#ruby("년","年") #ruby("대|한|노|동|이|민|사","大|韓|勞|動|移|民|社")의 #ruby("이|민","移|民") #ruby("모|집","募|集")에 따라가 #ruby("하|와|이","夏|威|夷")에서 #ruby("수|년|간","數|年|間") #ruby("노|동","勞|動")에 #ruby("종|사","從|事")하였다. 1907#ruby("년","年") #ruby("한|일|의|정|서","韓|日|議|定|書") #ruby("협|약","協|約") #ruby("후","後") #ruby("귀|국","歸|國"), #ruby("이|토","伊|藤")를 #ruby("암|살","暗|殺")하려다 #ruby("안|창|호","安|昌|浩")의 #ruby("만|류","挽|留")로 #ruby("실|패","失|敗")하고, #ruby("안|중|근","安|重|根")이 #ruby("이|토","伊|藤")를 #ruby("저|격","狙|擊")한 #ruby("후","後") #ruby("이|완|용","李|完|用") #ruby("등","等") #ruby("국|내","國|內") #ruby("친|일|파","親|日|派")를 #ruby("척|결","剔|抉")하기로 #ruby("결|심","決|心")하였다.]의 #ruby("부|인","夫|人")인데, #ruby("이|군","李|君")이 #ruby("자|기","自|己") #ruby("부|인","夫|人")에게 무슨 #ruby("요|구","要|求")를 #ruby("강|경","强|硬")히 하였던지 #ruby("단|총","短|銃")으로 #ruby("위|협","威|脅")하니, #ruby("오|여|사","吳|女|士")는 놀라고 겁이 나서 #ruby("학|교","學|校") #ruby("수|업","授|業")을 #ruby("감|당","堪|當")치 못할 #ruby("사|정","事|情")을 말하고 이웃집에 #ruby("피","避")해 숨어버렸다 한다. 그런데 #ruby("이|군","李|君")이 미친 사람 #ruby("모|양","模|樣")으로 동네 어귀에서 #ruby("총","銃")을 쏘아대며, #ruby("매|국|노","賣|國|奴")를 #ruby("일|일","一|一")이 #ruby("총|살","銃|殺")하겠노라고 소리를 치니 동네가 #ruby("소|동","騷|動")한다는 것이었다. #ruby("노|백|린","盧|伯|麟")과 #ruby("상|의","相|議")하여 #ruby("이|군","李|君")을 #ruby("청","請")해 불렀다.]
#zh[学校的女教师吴仁星是李在明的夫人。李君不知向自己夫人强硬地要求了什么，用短枪威胁她。吴女士又惊又怕，说自己承担不了学校的课，躲到邻家藏了起来。李君像疯子一样在村口开枪，喊着要把卖国贼一个个枪毙，村子骚动起来。我和卢伯麟商量，把李君请来。]
#figure-block("/images/p208.jpg", caption: [#ruby("이|재|명","李|在|明") #ruby("의|사","義|士")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[뉘가 알았으랴, 그가 며칠 #ruby("후","後") #ruby("경|성","京|城") #ruby("이|현","泥|峴")에서 군밤장수로 #ruby("가|장","假|裝")하고서 #ruby("충|천","衝|天")하는 #ruby("의|기","意|氣")를 품고 #ruby("이|완|용","李|完|用")을 #ruby("저|격","狙|擊")하여 #ruby("조|선","朝|鮮") #ruby("천|지","天|地")를 #ruby("진|동","震|動")하게 할 #ruby("이|재|명","李|在|明") #ruby("의|사","義|士")인 줄을.#footnote(numbering: _ => [36)])[#h(0.35em)위의 #ruby("이|현","泥|峴")은 #ruby("종|현","鍾|峴")의 #ruby("착|오","錯|誤"). #ruby("이|재|명","李|在|明")의 #ruby("의|거","義|擧")는 1909#ruby("년","年") 12#ruby("월","月") 22#ruby("일","日") #ruby("종|현|천|주|교|성|당","鍾|峴|天|主|敎|聖|堂")\(#ruby("현","現") #ruby("명|동|성|당","明|洞|聖|堂")) 앞에서 일어났다.] 그는 먼저 #ruby("인|력|거","人|力|車")를 끄는 #ruby("차|부","車|夫")를 죽이고 #ruby("이|완|용","李|完|用")의 #ruby("생|명","生|命")은 다 빼앗지 못하고 #ruby("체|포","逮|捕")되어 #ruby("순|국","殉|國")하였던 것이다.]
#zh[谁会想到，他就是几天之后在京城泥岘扮成卖栗子的，怀着冲天的义气狙击李完用、震动整个朝鲜的义士李在明呢。他先杀死了拉人力车的车夫，没能要了李完用的性命，被捕殉国。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 우리의 #ruby("요|청","要|請")에 #ruby("응","應")하여 나이 23〜4#ruby("세","歲")의 #ruby("청|년","靑|年")이 눈썹 가에 #ruby("분|기","憤|氣")를 띠고 들어섰다. 우리 두 사람이 돌아가며 #ruby("인|사","人|事")를 했는데, #ruby("자|기","自|己")는 #ruby("이|재|명","李|在|明")이고 #ruby("수|개|월","數|個|月") #ruby("전","前")에 #ruby("미|주","美|洲")로부터 #ruby("귀|국","歸|國")하였다고 했다. #ruby("평|양","平|壤")의 #ruby("오|인|성","吳|仁|星")이란 #ruby("여|자","女|子")와 #ruby("결|혼","結|婚")하여 지내는바, #ruby("자|기","自|己") #ruby("부|인","夫|人")의 #ruby("가|정","家|庭")은 #ruby("과|부","寡|婦")인 #ruby("장|모","丈|母")가 딸 셋을 데리고 지내는데 #ruby("가|세","家|勢")가 #ruby("풍|족","豊|足")하여 딸들을 #ruby("교|육","敎|育")시켰지만, #ruby("국|가","國|家")의 #ruby("대|사","大|事")에 #ruby("충|성","忠|誠")을 바칠 #ruby("용|기","勇|氣")가 없고 #ruby("구|차","苟|且")하게 #ruby("안|일","安|逸")에만 빠져 #ruby("자|기","自|己")의 #ruby("의|기","意|氣")와 #ruby("충|성","忠|誠")을 #ruby("이|해","理|解")하지 못한다고 했다. 그리고 이 때문에 #ruby("자|기","自|己") #ruby("부|부|간","夫|婦|間")에 다툼거리가 생겨 #ruby("학|교","學|校")에 #ruby("손|해","損|害")가 될까 #ruby("우|려","憂|慮")된다고 #ruby("기|탄","忌|憚")없이 말하였다.#footnote(numbering: _ => [37)])[#h(0.35em)#ruby("이|재|명","李|在|明") #ruby("의|사","義|士")의 #ruby("부|인","夫|人")은 #ruby("거|사","擧|事") #ruby("전","前") 마지막 #ruby("작|별","作|別")에서 울지도 않았고 #ruby("만|류","挽|留")하지도 않았다고 한다.]]
#zh[那时应我们的请求，一个二十三四岁的青年眉眼间带着忿气走了进来。我们两人轮流招呼。他说自己是李在明，几个月前从美洲回国。他和平壤一位叫吴仁星的女子结了婚。夫人家里，寡居的岳母带着三个女儿过活，家境富裕，女儿们都受了教育，可是没有为国事尽忠的勇气，只苟且耽于安逸，不理解他的义气和忠诚。因此夫妻之间有了争执，他坦率地说，只怕给学校带来损害。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("계|원","桂|園") #ruby("형","兄")과 내가 #ruby("이|의|사","李|義|士")에게 #ruby("장|래","將|來")에 #ruby("목|적","目|的")하는 일과 #ruby("과|거","過|去") #ruby("경|력","經|歷")·#ruby("학|식","學|識") #ruby("등","等")을 #ruby("일|일","一|一")이 물으니, #ruby("자|기","自|己")는 어려서 #ruby("하|와|이","夏|威|夷")에 건너가서 #ruby("공|부","工|夫")하다, #ruby("조|국","祖|國")이 섬 #ruby("왜","倭")놈에게 #ruby("강|점","强|占")되었단 #ruby("소|식","消|息")을 듣고 #ruby("귀|국","歸|國")하였으며, #ruby("지|금","只|今") 하려는 일은 #ruby("매|국|노","賣|國|奴") #ruby("이|완|용","李|完|用")을 #ruby("위|시","爲|始")하여 몇 놈을 죽이고자 #ruby("준|비","準|備")#ruby("중","中")이라고 했다. 그리고 #ruby("단|도","短|刀") 한 자루, #ruby("단|총","短|銃") 한 #ruby("정","挺")과 #ruby("이|완|용","李|完|用") #ruby("등","等")의 #ruby("사|진","寫|眞") 몇 #ruby("장","張")을 품속에서 내놓았다.]
#zh[卢伯麟兄和我把义士将来要做的事、过去的经历和学识一一问过。他说自己幼时渡海到夏威夷读书，听到祖国被岛倭强占的消息，便回国了。现在准备的，是要杀死卖国贼李完用等几个人。说着从怀里掏出一把短刀、一支短枪，和李完用等人的几张照片。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("계|원","桂|園")과 나는 #ruby("동|일","同|一")한 #ruby("관|찰","觀|察")로 그를, #ruby("시|세","時|勢")의 #ruby("격|변","激|變") 때문에 헛된 #ruby("열|정","熱|情")에 들뜬 #ruby("청|년","靑|年")으로 보았다. #ruby("계|원","桂|園")이 #ruby("이|의|사","李|義|士")의 손을 잡고 #ruby("간|곡","懇|曲")히 말했다.]
#zh[卢伯麟和我看法相同，把他看作因时势剧变、凭着一阵虚热的青年。卢伯麟握着李义士的手，恳切说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("군","君")이 #ruby("국|사","國|事")에 #ruby("비|분","悲|憤")하여 #ruby("용|기","勇|氣") 있게 #ruby("활|동","活|動")하는 것은 #ruby("극","極")히 #ruby("가|상","可|尙")하나, 큰일을 #ruby("도|모","圖|謀")하고자 하는 #ruby("대|장|부","大|丈|夫")가 #ruby("총|기","銃|器")로 #ruby("자|기","自|己") #ruby("부|인","夫|人")을 #ruby("위|협","威|脅")하고 동네에서 #ruby("총","銃")을 마구 쏘아 #ruby("민|심","民|心")을 #ruby("요|란","擾|亂")케 하는 것은 #ruby("의|지","意|志")가 #ruby("확|고","確|固")하지 못한 #ruby("표|징","表|徵")이오. 그러니 #ruby("지|금","只|今") 칼과 #ruby("총","銃")을 나에게 맡겨두고, #ruby("의|지","意|志")를 더욱 #ruby("강","强")하고 굳게 #ruby("수|양","修|養")하고 #ruby("동|지","同|志")도 더 사귀고 얻어서, #ruby("실|행","實|行")할 수 있을 때 #ruby("총","銃")과 칼을 찾아가는 것이 어떠하오?”]
#zh[“君愤于国事、勇敢活动，极可嘉许。可是想做大事的大丈夫，用枪支威胁自己的夫人，又在村里乱开枪，搅动民心，这是意志不坚定的征象。现在把刀和枪交给我，把意志修养得更强更坚，再多结交些同志，到能够实行的时候来取枪和刀，如何？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("의|사","義|士")는 한참 쳐다보다가 #ruby("총","銃")과 칼을 #ruby("계|원","桂|園")에게 주었지만, #ruby("안|색","顔|色")에는 즐겁지 못한 #ruby("기|색","氣|色")이 #ruby("역|력","歷|歷")하였다. 그와 #ruby("작|별","作|別")하고 #ruby("사|리|원|역","沙|里|院|驛")에서 #ruby("차","車")가 막 떠나려 할 때, #ruby("홀|연","忽|然")히 #ruby("이|의|사","李|義|士")가 나타나 #ruby("계|원","桂|園")에게 #ruby("물|품","物|品")의 #ruby("반|환","返|還")을 #ruby("요|구","要|求")하였다. #ruby("계|원","桂|園")은 웃으면서 “#ruby("경|성","京|城") 와서 찾으시오” 하고 말하는 사이, #ruby("기|차","汽|車")가 떠났다.]
#zh[义士望了半天，把枪和刀交给了卢伯麟，脸色却显然不痛快。和他告别，在沙里院车站车正要开时，李义士忽然出现，要求卢伯麟归还东西。卢伯麟笑着说“到京城来取”，话音未落，火车开了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런 지 한 달이 못 되어 #ruby("의|사","義|士")는 #ruby("동|지","同|志") 몇 #ruby("명","名")과 함께 #ruby("경|성","京|城")에 #ruby("도|착","到|着")하였다. #ruby("이|현","泥|峴")에서 #ruby("이|의|사","李|義|士")는 군밤장수로 #ruby("가|장","假|裝")하고 길가에서 밤을 팔다가 #ruby("이|완|용","李|完|用")을 칼로 찔렀다. #ruby("이|완|용","李|完|用")은 #ruby("생|명","生|命")이 #ruby("위|험","危|險")하고, #ruby("이|의|사","李|義|士")와 #ruby("김|정|익","金|貞|益"), #ruby("김|용|문","金|龍|文"), #ruby("전|태|선","全|泰|善"), #ruby("오","吳")◯◯ #ruby("등","等") 여러 사람이 #ruby("체|포","逮|捕")되었다는 #ruby("사|건","事|件")이 #ruby("신|문","新|聞")에 #ruby("게|재","揭|載")되었다.#footnote(numbering: _ => [38)])[#h(0.35em)#ruby("이|재|명","李|在|明") #ruby("의|사","義|士")는 #ruby("이|완|용","李|完|用")을, #ruby("김|정|익","金|貞|益")이 #ruby("이|용|구","李|容|九")를, #ruby("이|동|수","李|東|秀")가 #ruby("송|병|준","宋|秉|畯")을 #ruby("담|당","擔|當")하기로 되어 있었다. #ruby("백|범","白|凡")이 이름을 #ruby("기|억","記|憶")하지 못하는 #ruby("오|군","吳|君")은 뒤에 #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 만나는 #ruby("오|복|원","吳|復|元")이다. #ruby("전|태|선","全|泰|善")은 #ruby("원|문","原|文")에 ‘田泰善’으로 잘못 #ruby("기|록","記|錄")돼 있다.]]
#zh[过后不到一个月，义士和几名同志到了京城。在泥岘，李义士扮成卖栗子的，在路边卖栗子，用刀刺了李完用。李完用性命危险。李义士和金正益、金龙文、田泰善、吴某某等多人被捕，事件登在报纸上。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 깜짝 놀랐다. #ruby("이|의|사","李|義|士")가 #ruby("단|총","短|銃")을 #ruby("사|용","使|用")하였다면 #ruby("국|적","國|賊") #ruby("이|완|용","李|完|用")의 목숨을 #ruby("확|실","確|實")히 끊었을 것인데, 눈먼 우리가 #ruby("간|섭","干|涉")하여 #ruby("무|기","武|器")를 빼앗는 바람에 #ruby("충|분","充|分")한 #ruby("성|공","成|功")을 못한 것이다. #ruby("한|탄","恨|歎")과 #ruby("후|회","後|悔")가 그치지 않았다.]
#zh[我大吃一惊。李义士若用了短枪，国贼李完用的性命一定断了。可我们瞎了眼，出面干涉，夺走了武器，以致不能充分成功。叹息和后悔不止。]
#heading(level: 3)[#text(font: "KOPUSGo B")[5) #ruby("신|민|회","新|民|會")와 #ruby("안|악","安|岳") #ruby("사|건","事|件")]]
#zh[安岳事件]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|록","記|錄")의 #ruby("선|후","先|後")가 #ruby("전|도","顚|倒")되었다. #ruby("오|호","嗚|呼")라! #ruby("국|가","國|家")는 #ruby("병|탄","倂|呑")된 뒤였다. #ruby("국|가","國|家")가 #ruby("합|병","合|併")의 #ruby("치|욕","恥|辱")을 당한 #ruby("당|시","當|時")의 #ruby("인|심","人|心")은 매우 #ruby("흉|흉","洶|洶")하였다. #ruby("원|로|대|신","元|老|大|臣")과 #ruby("내|외","內|外") #ruby("관|리","官|吏")들 #ruby("중","中") #ruby("자|살","自|殺")하는 #ruby("자","者")도 많았고 #ruby("교|육|계","敎|育|界")의 #ruby("배|일|사|상","排|日|思|想")이 #ruby("극|도","極|度")에 달했다. 오직 듣지도 못하고 알지도 못하는 #ruby("농|민","農|民")들 #ruby("중","中")에는 #ruby("합|병","合|併")이 무엇인지, #ruby("망|국","亡|國")이 무엇인지 모르고 있는 #ruby("자","者")도 많았다.]
#zh[记录的先后被颠倒了。呜呼！国家已被吞并。国家蒙受合并耻辱的当时，人心非常汹汹。元老大臣和内外官吏中，自杀的很多，教育界的排日思想达于极点。只有那些听不见、也不明白的农民里，很多人不知道合并是什么、亡国是什么。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나부터 #ruby("망|국","亡|國")의 #ruby("치|욕","恥|辱")을 당하고 나라 없는 아픔을 느끼나, 사람이 사랑하는 #ruby("자|식","子|息")을 잃으면 슬퍼하면서도 살아날 것 같은 #ruby("생|각","生|覺")이 나는 것처럼, 나라가 #ruby("망","亡")하였으나 #ruby("국|민","國|民")이 #ruby("일|치","一|致") #ruby("분|발","奮|發")하면 곧 #ruby("국|권","國|權")이 #ruby("회|복","回|復")될 것같이 #ruby("생|각","生|覺")되었다. 그렇게 하려면 #ruby("후|세","後|世")들의 #ruby("애|국|심","愛|國|心")을 #ruby("앙|양","昂|揚")하여 #ruby("장|래","將|來")에 #ruby("광|복","光|復")하는 길밖에 없다고 #ruby("생|각","生|覺")되어, #ruby("계|속","繼|續")하여 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("확|장","擴|張")하고 #ruby("중|소|학|부","中|小|學|部")에 #ruby("학|생","學|生")을 늘려 #ruby("모|집","募|集")하면서 #ruby("교|장","校|長")의 #ruby("임|무","任|務")를 다했다.]
#zh[我自己也受着亡国的耻辱，感到没有国家的痛苦。可是就像人失去心爱的孩子，悲伤之中仍觉得仿佛还能活过来一样，国家虽亡，我却觉得国民若一致奋发，国权马上就能恢复。要做到这一点，只有提高后世的爱国心、将来光复这一条路。于是继续扩建杨山学校，中小学部增招学生，尽着校长的职务。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이에 앞서 #ruby("국|내","國|內") #ruby("국|외","國|外")를 #ruby("통","通")하여 #ruby("정|치|적","政|治|的") #ruby("비|밀|결|사","祕|密|結|社")가 #ruby("조|직","組|織")되니, 곧 #ruby("신|민|회","新|民|會")였다. #ruby("안|창|호","安|昌|浩")는 #ruby("미|주","美|洲")로부터 #ruby("귀|국","歸|國")하여 #ruby("평|양","平|壤")에 #ruby("대|성|학|교","大|成|學|校")를 #ruby("병|설","竝|設")하여 #ruby("청|년","靑|年")을 #ruby("교|육","敎|育")하는 것을 #ruby("표|면","表|面")의 #ruby("사|업","事|業")으로 내세우면서 #ruby("이|면","裏|面")에서는, #ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("이|승|훈","李|昇|薰")·#ruby("전|덕|기","全|德|基")·#ruby("이|동|녕","李|東|寧")·#ruby("주|진|수","朱|鎭|洙")·#ruby("이|갑","李|甲")·#ruby("이|종|호","李|鍾|浩")·#ruby("최|광|옥","崔|光|玉")·#ruby("김|홍|량","金|鴻|亮")과 #ruby("그|외","其|外") 몇 사람을 #ruby("중|심","中|心")으로 하여 #ruby("당|시","當|時") 400#ruby("여","餘") #ruby("명","名") #ruby("정|수|분|자","精|粹|分|子")로 #ruby("조|직","組|織")된 #ruby("단|체","團|體"), #ruby("즉","卽") #ruby("신|민|회","新|民|會")#footnote(numbering: _ => [39)])[#h(0.35em)1907#ruby("년","年") #ruby("도|산","島|山") #ruby("안|창|호","安|昌|浩")가 #ruby("미|국","美|國")에서 #ruby("귀|국","歸|國")하여 그해 4#ruby("월","月") #ruby("이|갑","李|甲")·#ruby("전|덕|기","全|德|基")·#ruby("양|기|탁","梁|起|鐸") #ruby("등","等")과 같이 #ruby("조|직","組|織")한 #ruby("비|밀|결|사","祕|密|結|社"). #ruby("총|감|독","總|監|督")에 #ruby("양|기|탁","梁|起|鐸"), #ruby("총|서|기","總|書|記")에 #ruby("이|동|녕","李|東|寧"), #ruby("재|무","財|務")에 #ruby("전|덕|기","全|德|基"), #ruby("집|행|원","執|行|員")에 #ruby("안|창|호","安|昌|浩")를 #ruby("선|출","選|出")하였다.]를 #ruby("훈|련","訓|鍊")·#ruby("지|도","指|導")하였다. 그 때문에 #ruby("안|창|호","安|昌|浩")는 #ruby("용|산","龍|山") #ruby("헌|병|대","憲|兵|隊")에 잡혀 #ruby("수|감","收|監")된 일도 있었다.#footnote(numbering: _ => [40)])[#h(0.35em)#ruby("안|창|호","安|昌|浩")는 #ruby("안|중|근","安|重|根") #ruby("의|사","義|士") #ruby("의|거","義|擧") #ruby("관|련","關|聯") #ruby("혐|의","嫌|疑")로 3#ruby("개|월|간","個|月|間") #ruby("수|감","收|監")된 적이 있다.]]
#zh[在这以前，国内国外组织了政治上的秘密结社，就是新民会。安昌浩从美洲回国，在平壤附设大成学校，以教育青年为表面的事业；暗地里以梁起铎、安泰国、李升薰、全德基、李东宁、朱镇洙、李甲、李钟浩、崔光玉、金鸿亮以及其他几人为中心，训练并指导当时由四百余名精粹分子组织起来的团体，即新民会。因此安昌浩也曾被龙山宪兵队抓去关押。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("합|병","合|併")된 #ruby("후","後")에는 이른바 #ruby("주|의|인|물","注|意|人|物")을 #ruby("일|망|타|진","一|網|打|盡")할 것으로 #ruby("예|상","豫|想")함이었던지, #ruby("안|창|호","安|昌|浩")는 미리 #ruby("비|밀|리","祕|密|裏")에 #ruby("장|연|군","長|淵|郡") #ruby("송|천","松|川")에서 #ruby("위|해|위","威|海|衛")로 몰래 건너가고, #ruby("이|종|호","李|鍾|浩")·#ruby("이|갑","李|甲")·#ruby("유|동|열","柳|東|說") #ruby("동|지","同|志")가 이어 #ruby("압|록|강","鴨|綠|江")을 건넜다.#footnote(numbering: _ => [41)])[#h(0.35em)#ruby("원|문","原|文"): “威海尉”. ‘尉’는 ‘衛’. #ruby("위|해|위","威|海|衛")는 #ruby("중|국","中|國") #ruby("산|동|반|도","山|東|半|島") 끝에 #ruby("위|치","位|置")한 #ruby("도|시","都|市")로, #ruby("현","現") #ruby("지|명","地|名")은 #ruby("위|해","威|海"). 1398#ruby("년","年") #ruby("명","明")나라 때 #ruby("왜|구","倭|寇")의 #ruby("습|격","襲|擊")에 #ruby("대|비","對|備")하여 이곳에 #ruby("기|지","基|地")를 #ruby("설|치","設|置")하고 ‘#ruby("위|해|위","威|海|衛")’라는 #ruby("군|대","軍|隊")를 두었다. #ruby("신|민|회","新|民|會")는 1910#ruby("년","年") 3#ruby("월","月") #ruby("만|주","滿|洲")에 #ruby("무|관|학|교","武|官|學|校") #ruby("설|립","設|立")과 #ruby("독|립|군","獨|立|軍") #ruby("기|지","基|地") #ruby("창|건","創|建")을 #ruby("결|정","決|定")하였고, 이를 #ruby("위","爲")해 4#ruby("월","月") #ruby("안|창|호","安|昌|浩")·#ruby("이|갑","李|甲") #ruby("등","等")이 #ruby("출|국","出|國")하였다. #ruby("안|창|호","安|昌|浩")는 #ruby("중|국","中|國") #ruby("산|동|성","山|東|省")으로 #ruby("망|명","亡|命")하여 이른바 ‘#ruby("청|도|회|의","靑|島|會|議")’를 #ruby("소|집","召|集")하였다.]]
#zh[为了预防合并后主要人物被一网打尽，安昌浩从长渊郡松川秘密地到威海卫去了，李钟浩、李甲、柳东悦等同志，也随后分别渡过了鸭绿江。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("경|성","京|城")에서 #ruby("양|기|탁","梁|起|鐸")#footnote(numbering: _ => [42)])[#h(0.35em)#ruby[양|기|탁][梁|起|鐸]\(1871〜1938). 배델(Bethell, E. T.)과 같이 『#ruby("대|한|매|일|신|보","大|韓|每|日|申|報")』를 만들어 #ruby("일|제","日|帝")를 #ruby("규|탄","糾|彈")하고, #ruby("신|민|회","新|民|會")에서도 #ruby("중|심|적","中|心|的")인 #ruby("역|할","役|割")을 하였다.]이 #ruby("주|최","主|催")하는 #ruby("비|밀|회|의","祕|密|會|議") #ruby("통|지","通|知")를 받고 나도 달려가 #ruby("참|석","參|席")했다. #ruby("양|기|탁","梁|起|鐸")의 집에 #ruby("출|석","出|席")된 #ruby("인|원","人|員")은 #ruby("양|기|탁","梁|起|鐸")·#ruby("이|동|녕","李|東|寧")·#ruby("안|태|국","安|泰|國")·#ruby("주|진|수","朱|鎭|洙")·#ruby("이|승|훈","李|昇|薰")·#ruby("김|도|희","金|道|熙")·#ruby("김|구","金|龜") #ruby("등","等")이었다. #ruby("비|밀|회|의","祕|密|會|議")를 열어 #ruby("지|금","只|今") #ruby("왜","倭")가 #ruby("경|성","京|城")에 이른바 #ruby("총|감|부","總|監|府")라는 것을 #ruby("설|치","設|置")하고 #ruby("전|국","全|國")을 #ruby("통|치","統|治")하니, 우리도 #ruby("경|성","京|城")에 #ruby("비|밀|리","祕|密|裏")에 #ruby("도|독|부","都|督|府")를 #ruby("설|치","設|置")하여 #ruby("전|국","全|國")을 다스릴 것, #ruby("만|주","滿|洲")에 #ruby("이|민|계|획","移|民|計|劃")을 #ruby("실|시","實|施")할 것과 #ruby("무|관|학|교","武|官|學|校")를 #ruby("설|립","設|立")하고 #ruby("장|교","將|校")를 #ruby("양|성","養|成")하여 #ruby("광|복|전|쟁","光|復|戰|爭")을 일으킬 것, 이를 #ruby("준|비","準|備")하기 #ruby("위","爲")해 #ruby("이|동|녕","李|東|寧")을 먼저 #ruby("만|주","滿|洲")에 #ruby("파|송","派|送")하여 #ruby("토|지","土|地") #ruby("매|수","買|收"), #ruby("가|옥","家|屋") #ruby("건|축","建|築")과 #ruby("기|타","其|他") #ruby("일|반","一|般")을 #ruby("위|임","委|任")하고, 그 나머지 #ruby("참|석","參|席")한 #ruby("인|원","人|員")으로 #ruby("각","各") #ruby("지|방","地|方") #ruby("대|표","代|表")를 #ruby("선|정","選|定")하여, 15#ruby("일","日") #ruby("이|내","以|內")에 #ruby("황|해|도","黃|海|道")에서 #ruby("김|구","金|龜")가 15#ruby("만","萬") #ruby("원","元"), #ruby("평|남","平|南")의 #ruby("안|태|국","安|泰|國")이 15#ruby("만","萬") #ruby("원","元"), #ruby("평|북","平|北") #ruby("이|승|훈","李|昇|薰")이 15#ruby("만","萬") #ruby("원","元"), #ruby("강|원","江|原")의 #ruby("주|진|수","朱|鎭|洙")가 10#ruby("만","萬") #ruby("원","元"), #ruby("경|성","京|城")의 #ruby("양|기|탁","梁|起|鐸")이 20#ruby("만","萬") #ruby("원","元")을 #ruby("모|집","募|集")하여, #ruby("이|동|녕","李|東|寧")의 뒤를 #ruby("파|송","派|送")하기로 #ruby("의|결","議|決")하고 #ruby("즉|각","卽|刻") #ruby("출|발","出|發")하였다.#footnote(numbering: _ => [43)])[#h(0.35em)#ruby("신|민|회","新|民|會")는 1910#ruby("년","年") 가을 #ruby("이|동|녕","李|東|寧")·#ruby("이|시|영","李|始|榮")이 #ruby("독|립|운|동","獨|立|運|動") #ruby("기|지","基|地")의 #ruby("후|보|지","候|補|地")를 #ruby("답|사","踏|査")하기 #ruby("위","爲")해 #ruby("만|주","滿|洲")로 갔고, 12#ruby("월","月") #ruby("중|순","中|旬") 그들로부터 #ruby("보|고","報|告")받고 #ruby("단|체","團|體") #ruby("이|주","移|住")를 #ruby("위","爲")한 #ruby("구|체|적","具|體|的")인 #ruby("대|책","對|策") 마련에 들어갔다.]]
#zh[在京城接到梁起铎主持的秘密会议的通知，我也赶去参加。出席梁起铎家的，有梁起铎、李东宁、安泰国、朱镇洙、李升薰、金道熙、金龟等。秘密会议议决：现在倭寇在京城设立所谓总监府，统治全国，我们也要在京城秘密设立都督府，治理全国；在满洲实施移民计划，设立武官学校，培养将校，发动光复战争。为了准备这些，先派李东宁到满洲，委托他收买土地、建筑房屋以及其他一切；再从其余出席的人里选定各地方代表，十五日以内，黄海道金龟募十五万元，平南安泰国十五万元，平北李升薰十五万元，江原朱镇洙十万元，京城梁起铎二十万元，随后派到李东宁那里。议决之后，立即出发。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[경|술|년][庚|戌|年]\(1910, 35#ruby("세","歲")) 11#ruby("월","月") 20#ruby("일","日") 이른 아침에 #ruby("양|기|탁","梁|起|鐸")의 #ruby("친|동|생","親|同|生") #ruby("인|탁","寅|鐸")과 그의 #ruby("부|인","夫|人")이 #ruby("동|행","同|行")하여 #ruby("사|리|원|역","沙|里|院|驛")에서 #ruby("하|차","下|車")하였다. #ruby("인|탁","寅|鐸") #ruby("부|부","夫|婦")는 #ruby("재|령","載|寧")#footnote(numbering: _ => [44)])[#h(0.35em)#ruby("원|주","原|註"): “寅鐸은 載寧 裁判所 書記로 赴任의 途次에 同行한 것 　이고 우리의 秘密計劃을 通情치 안은 것은 起鐸부터 親弟의게 事情을 勿說하라고 우리의게 付托한 것이라”.]으로, 나는 #ruby("안|악","安|岳")으로 돌아왔다.]
#zh[庚戌年（1910，三十五岁）十一月二十日清晨，和梁起铎的亲弟弟寅铎及其夫人同行，在沙里院车站下车。寅铎夫妇前往载宁，我回到安岳。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("김|홍|량","金|鴻|亮")과 #ruby("협|의","協|議")하여 #ruby("토|지","土|地")와 #ruby("가|산","家|産")을 팔기 #ruby("시|작","始|作")했고, #ruby("신|천","信|川") #ruby("유|문|형","柳|文|馨") #ruby("등","等") 몇 사람과 이웃 #ruby("군","郡") #ruby("동|지","同|志")에게 #ruby("장|래","將|來") #ruby("방|침","方|針")을 #ruby("은|밀","隱|密")히 알려 #ruby("계|획","計|劃")을 #ruby("진|행","進|行")해 가던 #ruby("중","中")이었다. 그때 #ruby("장|연","長|淵")의 #ruby("이|명|서","李|明|瑞")가 #ruby("자|기","自|己") #ruby("모|친","母|親")과 #ruby("친|동|생","親|同|生") #ruby("명|선","明|善")을 데리고 #ruby("서|간|도","西|間|島")에 먼저 가서 뒤에 #ruby("도|착","到|着")하는 #ruby("동|지","同|志")들의 #ruby("편|의","便|宜")를 #ruby("제|공","提|供")하겠다며 #ruby("안|악","安|岳")으로 찾아왔기에, #ruby("북|행","北|行")을 #ruby("인|도","引|導")하여 #ruby("출|발","出|發")시켰다.#footnote(numbering: _ => [45)])[#h(0.35em)#ruby("원|주","原|註"): “李明瑞는 南滿에 渡하엿다가 同志 十五人을 引率하고 國內에 潛入하야 殷栗郡守를 射殺하고 倭守備隊와 極熱히 싸오다가 敵彈에 殉國하엿다”.]]
#zh[在沙里院和寅铎夫妇分别后回到安岳，向金鸿亮报告了这次秘密会议中所议决的事项。金鸿亮为了顺利推行起见，准备变卖自己的家产，并把这消息偷偷地遍告信川的柳文馨等邻近乡镇的同志们。长渊的李明瑞首先送他的母亲及胞弟明善到西间岛，然后几天之内折返为同志们准备一切，随后也来到安岳，由我引导他们出发北上。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳")에 돌아와 #ruby("소|문","所|聞")을 들으니, #ruby("안|명|근","安|明|根")#footnote(numbering: _ => [46)])[#h(0.35em)#ruby[안|명|근][安|明|根]\(1879〜1927). #ruby("황|해|도","黃|海|道") #ruby("신|천","信|川") #ruby("출|생","出|生"). #ruby("안|중|근","安|重|根")의 #ruby("사|촌","四|寸") #ruby("동|생","同|生"). #ruby("호","號")는 #ruby("매|산","梅|山"). 1910#ruby("년","年") #ruby("국|권","國|權")이 #ruby("침|탈","侵|奪")당하자 #ruby("무|관|학|교","武|官|學|校") #ruby("설|립","設|立")을 #ruby("위","爲")해 #ruby("황|해|도","黃|海|道")의 #ruby("신|석|효","申|錫|孝") #ruby("등","等")으로부터 #ruby("자|금","資|金")을 모으다가 #ruby("밀|고","密|告")로 #ruby("체|포","逮|捕")되었다.]이 #ruby("안|악","安|岳")에 와서 나를 여러 #ruby("차|례","次|例") 찾았으나, 나의 #ruby("경|성|행","京|城|行")으로 서로 어긋나 만나지 못하였다는 것이다. 그런데 어느날 갑자기 밤#ruby("중","中")에 #ruby("명|근","明|根")이 #ruby("양|산|학|교","楊|山|學|校")로 찾아왔다. 그는 #ruby("자|기","自|己")가 #ruby("해|서","海|西")의 #ruby("각","各") #ruby("군","郡") #ruby("부|호","富|豪")를 #ruby("다|수","多|數") 만나본 #ruby("결|과","結|果") 모두 #ruby("독|립|운|동","獨|立|運|動") #ruby("자|금","資|金")을 #ruby("허|락","許|諾")하고도 #ruby("신|속","迅|速")히 추렴에 #ruby("응","應")하지 않아, #ruby("안|악|읍","安|岳|邑") 몇몇 #ruby("부|호","富|豪")를 #ruby("총|기","銃|器")로 #ruby("위|협","威|脅")하여 #ruby("타|지|방","他|地|方")에 #ruby("영|향","影|響")을 미치게 할 #ruby("목|적","目|的")이니, #ruby("응|원","應|援")·#ruby("지|도","指|導")해 주기를 #ruby("청","請")했다.]
#zh[回到安岳，听说安明根来安岳找过我好几次，因我去了京城，彼此错过，没有见着。有一天忽然半夜，明根找到杨山学校。他说见过海西各郡许多富户，都答应了独立运动的经费，却不迅速凑上来。他的目的是用枪支威胁安岳邑几个富户，好影响别的地方，请我声援、指导。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("구|체|적","具|體|的")으로 #ruby("장|래","將|來") #ruby("방|침","方|針")을 물으니,]
#zh[我问他将来的具体方针。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("황|해|도","黃|海|道") #ruby("일|대","一|帶") #ruby("부|호","富|豪")들에게 #ruby("금|전","金|錢")을 나눠 거두어서 #ruby("동|지","同|志")를 모으고, #ruby("전|신","電|信") #ruby("전|화","電|話")를 #ruby("단|절","斷|絶")하고 #ruby("각","各") #ruby("군","郡")에 #ruby("산|재","散|在")한 #ruby("왜|구","倭|寇")는 #ruby("각|기","各|其") 그 #ruby("군","郡")에서 #ruby("도|살","屠|殺")하라는 #ruby("명|령","命|令")을 #ruby("발|포","發|布")하면, #ruby("왜|병","倭|兵") #ruby("대|대","大|隊")가 #ruby("도|착","到|着")하기 #ruby("전","前") 5#ruby("일|간","日|間")은 #ruby("자|유","自|由") #ruby("천|지","天|地")가 될 터이니, 더 나아갈 #ruby("능|력","能|力")이 없다 하여도 #ruby("당|장","當|場")의 #ruby("분","憤")을 풀 수 있지 않겠습니까?”]
#zh[“向黄海道一带的富户分别收敛金钱，聚集同志，切断电信、电话，发布命令，各郡散驻的倭寇由各该郡屠杀。倭兵大队到达之前，有五天是自由天地。即使没有再往前的能力，眼前这口忿气不也可以出了吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. 나는 #ruby("명|근","明|根")을 붙잡고 #ruby("만|류","挽|留")했다.]
#zh[他说完。我拉住明根劝阻。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("형","兄")이 #ruby("여|순","旅|順") #ruby("사|건","事|件")#footnote(numbering: _ => [47)])[#h(0.35em)1910#ruby("년","年") 3#ruby("월","月") #ruby("안|중|근","安|重|根")이 #ruby("여|순|감|옥","旅|順|監|獄")에서 #ruby("사|형","死|刑")당한 것을 말한다.]을 #ruby("목|도","目|覩")한 나머지, 더욱이 #ruby("혈|족","血|族")으로 더욱 피가 끓어 이와 같은 #ruby("계|획","計|劃")을 #ruby("생|각","生|覺")해낸 듯하나, 5#ruby("일|간","日|間") #ruby("황|해","黃|海") #ruby("일|대","一|帶")에 #ruby("자|유","自|由") #ruby("천|지","天|地")를 #ruby("조|성","造|成")하더라도 #ruby("금|전","金|錢")보다 #ruby("중|요","重|要")한 것이 #ruby("동|지","同|志")의 #ruby("결|속","結|束")인데, #ruby("동|지","同|志")는 몇 사람이나 얻었나요?”]
#zh[“兄亲眼见了旅顺的事，又是血亲，血更热，才想出这样的计划吧。即便五天之内把黄海一带造成自由天地，比金钱更要紧的是同志的团结。同志得到了几个人？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“한 #ruby("동|지","同|志")도 몇십 #ruby("명","名")은 되지만, #ruby("형","兄")이 #ruby("동|의","同|意")하신다면 #ruby("인|물","人|物")은 쉽게 얻을 줄 압니다.”]
#zh[“我切实的同志也有几十名。兄若同意，人物容易得到。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("간|곡","懇|曲")히 #ruby("만|류","挽|留")하였다. #ruby("장|래","將|來") #ruby("대|규|모","大|規|模")의 #ruby("전|쟁","戰|爭")을 하려면 #ruby("인|재","人|才") #ruby("양|성","養|成")이 없고는 #ruby("성|공","成|功")을 #ruby("기|약","期|約")할 수 없고, #ruby("일|시|적","一|時|的")인 #ruby("격|발","激|發")로는 5#ruby("일","日")은커녕 3#ruby("일","日")도 #ruby("기|약","期|約")하기 어려우니, #ruby("분|기","憤|氣")를 참고 #ruby("다|수","多|數") #ruby("청|년","靑|年")을 #ruby("북","北")쪽#ruby("지|대","地|帶")로 데려가 #ruby("군|사","軍|事") #ruby("교|육","敎|育")을 #ruby("실|시","實|施")하는 것이 #ruby("당|장","當|場") #ruby("급","急")한 일이라고 했다. #ruby("매|산","梅|山") 역시 뜻은 #ruby("수|긍","首|肯")하나, #ruby("자|기","自|己")가 #ruby("요|량","料|量")하는 바와 다른 점을 #ruby("발|견","發|見")하고는 좀 #ruby("만|족","滿|足")하지 못한 #ruby("의|사","意|思")를 가지고 #ruby("작|별","作|別")하였다.]
#zh[我恳切劝阻。要做将来大规模的战争，不培养人才就不能期望成功；靠一时激发，五天不用说，三天也难指望。要忍住忿气，把多数青年带到北边地带，实施军事教育，这才是眼前的急事。梅山意思上虽然认可，却看出和自己的打算不同，带着不太满足的意思告别了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("불|과","不|過") 며칠 #ruby("후","後")에 #ruby("사|리|원","沙|里|院")에서 #ruby("매|산","梅|山")은 #ruby("왜|경","倭|警")에게 #ruby("체|포","逮|捕")당하여 #ruby("경|성","京|城")으로 #ruby("압|송","押|送")되었고, #ruby("신|천","信|川")·#ruby("재|령","載|寧") #ruby("등","等")에서도 #ruby("연|루|자","連|累|者")들이 #ruby("체|포","逮|捕")되었다는 #ruby("소|식","消|息")이 #ruby("신|문","新|聞")에 #ruby("발|표","發|表")되었다.]
#zh[听完我的话后，虽然他接受了我的见解，然而和他的想法仍有许多出入，因此带着不满的情绪和我分手了。此后不久，从报上传来安明根在沙里院被捕并被押往汉城的消息。信川载宁等地也有不少人受到连累相继被捕。]
#heading(level: 3)[#text(font: "KOPUSGo B")[6) 세#ruby("번","番")째 #ruby("투|옥","投|獄")과 #ruby("고|문","拷|問")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[신|해|년][辛|亥|年]\(1911, 36#ruby("세","歲")) #ruby("정|월","正|月") #ruby("초","初")닷새, 내가 #ruby("양|산|학|교","楊|山|學|校") #ruby("사|무|실","事|務|室")에서 아직 일어나지도 않았을 때, #ruby("왜|헌|병","倭|憲|兵") 한 #ruby("명","名")이 와서 #ruby("헌|병|소|장","憲|兵|所|長")이 #ruby("잠|시","暫|時") #ruby("면|담","面|談")할 일이 있다고 함께 가기를 #ruby("청","請")했다. 같이 가니 벌써 #ruby("김|홍|량","金|鴻|亮")·#ruby("도|인|권","都|仁|權")·#ruby("이|상|진","李|相|晋")·#ruby("양|성|진","楊|成|鎭")·#ruby("박|도|병","朴|道|秉")·#ruby("한|필|호","韓|弼|昊")·#ruby("장|명|선","張|明|善") #ruby("등","等") #ruby("교|직|원","敎|職|員")을 #ruby("차|례","次|例")로 불러모은 #ruby("후","後")였다. #ruby("경|무|총|감|부","警|務|總|監|府")의 #ruby("명|령","命|令")이라며 #ruby("임|시|구|류","臨|時|拘|留")에 #ruby("처","處")한다고 #ruby("선|언","宣|言")한 뒤, 2, 3#ruby("일","日") #ruby("후","後") #ruby("전|부","全|部")를 #ruby("재|령","載|寧")에 옮겨 가두고, #ruby("황|해","黃|海") #ruby("일|대","一|帶")의 #ruby("평|소","平|素") #ruby("애|국|자","愛|國|者")로 #ruby("지|목","指|目")된 #ruby("인|사","人|士")를 #ruby("대|부|분","大|部|分") #ruby("체|포","逮|捕")하였다.]
#zh[辛亥年（1911，三十六岁）正月初五，我在杨山学校办公室还没有起来，一名倭宪兵来，说宪兵所长有事要短暂面谈，请我同去。到了一看，金鸿亮、都寅权、李相晋、杨星镇、朴道秉、韩弼浩、张明善等教职员已经被依次叫来。他们宣称是警务总监部的命令，处以临时拘留。两三天后，全部移到载宁关押，黄海一带平日被指为爱国者的人士，大部分被捕。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이보다 앞서 #ruby("배|천","白|川") #ruby("군|수","郡|守") #ruby("전|봉|훈","全|鳳|薰")이 나에게 #ruby("상|의","相|議")해 왔다. #ruby("국|가","國|家")의 #ruby("대|세","大|勢")가 이미 기우니 #ruby("소|위","所|謂") #ruby("군|수","郡|守")란 #ruby("직|책","職|責")도 #ruby("분|통","憤|痛")이 터져 못하겠다며, #ruby("형","兄") #ruby("등","等")이 #ruby("종|사","從|事")하는 #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校") #ruby("부|근","附|近")에 #ruby("가|옥","家|屋") 한 채를 사서 #ruby("주|거","住|居")하면서 오로지 #ruby("손|자","孫|子") #ruby("무|길","武|吉")의 #ruby("학|업","學|業")에나 힘쓰는 것이 #ruby("소|원","所|願")이라는 것이다. #ruby("당|시","當|時") #ruby("수|안","遂|安")으로 #ruby("이|직","移|職")되었던 #ruby("군|수","郡|守") #ruby("전|봉|훈","全|鳳|薰")이 #ruby("습|락|현","習|樂|峴")에 기와집 한 채를 #ruby("매|입","買|入")하여 #ruby("수|리","修|理")하고 #ruby("솔|가","率|家")하여 #ruby("안|악","安|岳")으로 #ruby("이|주","移|住")해 오는 날, 우리는 #ruby("재|령","載|寧")에서 #ruby("사|리|원","沙|里|院")으로, #ruby("사|리|원","沙|里|院")에서 #ruby("경|성","京|城")으로 다시 #ruby("이|송","移|送")되는 날이었다. #ruby("전|봉|훈","全|鳳|薰")이 우리의 #ruby("소|식","消|息")을 듣고 #ruby("안|악","安|岳")으로 #ruby("이|사","移|徙")하던 #ruby("심|회","心|懷")가 어떠하였으랴.]
#zh[在这以前，白川郡守全凤薰来和我商量。他说国家大势已去，所谓郡守这个职位也气得做不下去，希望在兄等从事的安岳杨山学校附近买一所房子住下，一心只在孙子武吉的学业上用力。当时已调任遂安的郡守全凤薰，在习乐岘买了一所瓦房修葺，举家迁来安岳的那一天，正是我们从载宁送到沙里院、又从沙里院再被解往京城的日子。全凤薰听到我们的消息，迁往安岳时的心情该是怎样呢。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("해|서","海|西") #ruby("각","各") #ruby("군","郡")에서 #ruby("체|포","逮|捕")되어 #ruby("경|성","京|城")으로 #ruby("이|송","移|送")되는 #ruby("인|사","人|士") #ruby("중","中"), #ruby("송|화","松|禾")의 #ruby("반|정","泮|亭") #ruby("신|석|충","申|錫|忠") #ruby("진|사","進|士")는 #ruby("재|령|강","載|寧|江") #ruby("철|교","鐵|橋")를 건너다 #ruby("강","江")에 몸을 던져 #ruby("자|살","自|殺")하였다. #ruby("신|석|충","申|錫|忠")은 #ruby("본|시","本|是") #ruby("해|서","海|西")의 #ruby("저|명","著|名")한 #ruby("학|자","學|者")요 #ruby("대|자|선|가","大|慈|善|家")였다. 나는 #ruby("석|충","錫|忠")의 #ruby("형|제","兄|弟")#footnote(numbering: _ => [48)])[#h(0.35em)#ruby("원|문","原|文"): “弟”. #ruby("원|주","原|註"): “次兄”. #ruby("원|문","原|文")에 #ruby[아우][弟]와 #ruby("원|주","原|註")에 #ruby[둘째형][次兄]이 #ruby("병|기","竝|記")되어 있어 #ruby("형|제|간","兄|弟|間")의 #ruby("순|서","順|序")를 알 수 없다.] #ruby("석|제","錫|悌") #ruby("진|사","進|士")의 #ruby("자|손","子|孫") #ruby("교|육|문|제","敎|育|問|題")로 한 #ruby("차|례","次|例") #ruby("방|문","訪|問")하여 하룻밤 같이 자며 #ruby("담|화","談|話")한 적이 있을 뿐이다. 그때에 #ruby("석|제","錫|悌") #ruby("진|사","進|士")를 #ruby("방|문","訪|問")하고자 동네 #ruby("입|구","入|口")에 들어서니, #ruby("신|진|사","申|進|士") #ruby("댁","宅")에서 #ruby("소|식","消|息")을 듣고서 #ruby("석|제","錫|悌")의 아들 #ruby("낙|영","洛|英")과 #ruby("손|자","孫|子") #ruby("상|호","相|浩") #ruby("등","等")이 #ruby("동|구","洞|口")밖까지 나와 맞았다. 내가 #ruby("모|자","帽|子")를 벗어 #ruby("인|사","人|事")할 때 #ruby("낙|영","洛|英") #ruby("등","等")은 검은 #ruby[갓][黑笠]을 벗고 #ruby("답|례","答|禮")하려 했다. 내가 웃으면서 갓끈 끄르는 것을 #ruby("만|류","挽|留")하니, #ruby("낙|영","洛|英") #ruby("등","等")은 #ruby("송|구","悚|懼")한 빛을 띠고서 “#ruby("선|생","先|生")께서 #ruby("관","冠")을 벗으시는데, 우리가 그저 #ruby("답|례","答|禮")할 수 있습니까?” 했다. 나는 도리어 #ruby("미|안","未|安")하여 내가 쓴 담벙거지는 #ruby("양|인","洋|人")이 쓰는 #ruby("물|건","物|件")인데, #ruby("서|양|인","西|洋|人")의 #ruby("통|례","通|例")가 #ruby("인|사","人|事")할 때 #ruby("탈|모","脫|帽")하는 것이니 #ruby("용|서","容|恕")하라고 하였다. 나는 #ruby("석|제","錫|悌") #ruby("진|사","進|士")를 보고 #ruby("국|가","國|家") #ruby("문|명","文|明")에 #ruby("교|육","敎|育")이 #ruby("급|선|무","急|先|務")인 것을 하룻밤 동안 온 마음으로 #ruby("설|파","說|破")하고, #ruby("손|자","孫|子") #ruby("상|호","相|浩")의 #ruby("교|육","敎|育")을 #ruby("의|뢰","依|賴")받고 #ruby("안|악","安|岳")으로 돌아왔던 것이다.]
#zh[当时被拉上火车移送汉城的还有松禾泮亭申锡忠进士，但他在火车渡越载宁江铁桥时，从车窗跳下去投江自杀了。]
#zh[申进士在海西是知名的学者，也是慈善家。其弟锡悌也是进士，有一次我去拜访锡悌时，其公子济英和孙子相浩，到村口来迎接我，我脱帽打招呼，他们慌忙地除冠答礼。我连忙劝阻，济英等惶恐地说：“先生脱帽，我们怎能失礼呢？”我反倒感到不安，便跟他们说明我戴的是洋人的帽子，洋人的惯例要脱帽行礼，所以请他们原谅。]
#zh[见到锡悌进士后，我们促膝长谈了一个晚上，都认为国家文明，教育乃当务之急。他还拜托我教育其孙相浩。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("사|리|원","沙|里|院")에서 우리와 #ruby("호|송","護|送")하는 #ruby("헌|병","憲|兵") 몇 #ruby("명","名")이 #ruby("경|성|행","京|城|行") #ruby("기|차","汽|車")를 타고 가던 #ruby("중","中") #ruby("기|차","汽|車") 안에서 #ruby("이|승|훈","李|昇|薰")을 만났다. #ruby("남|강","南|岡") #ruby("이|승|훈","李|昇|薰")#footnote(numbering: _ => [49)])[#h(0.35em)#ruby[이|승|훈][李|昇|薰]\(1864〜1930). #ruby("평|북","平|北") #ruby("정|주","定|州") #ruby("출|신","出|身")의 #ruby("민|족|기|업|가","民|族|企|業|家")·#ruby("운|동|가","運|動|家"). 1907#ruby("년","年") #ruby("신|민|회","新|民|會")에 #ruby("가|입","加|入")하고 #ruby("고|향","故|鄕") #ruby("정|주","定|州")에 #ruby("오|산|학|교","五|山|學|校")를 세웠다. 3·1#ruby("운|동","運|動") #ruby("당|시","當|時") 33#ruby("인","人")의 한 사람이다.]은 우리가 묶여 가는 것을 보고, 다른 사람이 알지 못하게 #ruby("차|창","車|窓") 밖으로 머리를 내밀고 하염없이 눈물을 흘렸다. #ruby("기|차","汽|車")가 #ruby("용|산|역","龍|山|驛")에 #ruby("도|착","到|着")할 즈음 #ruby("형|사","刑|事") 한 #ruby("명","名")이 #ruby("남|강","南|岡")에게 #ruby("인|사","人|事")를 하고 물었다.]
#zh[在火车上也遇见了李升薰，他虽然没有被捕，但看到我们被绑着的惨状，不由掉过脸对着窗外淌下了眼泪。火车到达龙山站的时候，跑上来一个刑警，对李升薰说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신 #ruby("이|승|훈","李|昇|薰") #ruby("씨","氏") 아니오?”]
#zh[“您是李升薰先生吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇소.”]
#zh[当他答应后，那个狗刑警又说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("경|무|총|감|부","警|務|總|監|府")에서 #ruby("영|감","令|監")을 부르니 좀 갑시다.”]
#zh[“警务总监部请您老人家去一趟！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고서 #ruby("기|차","汽|車")에서 내리는 #ruby("즉|시","卽|時") 우리와 같이 묶어 끌고 갔다.]
#zh[一下火车，立刻和我们一样捆起来拖走了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈이 #ruby("한|국","韓|國")을 #ruby("강|점","强|占")한 #ruby("후","後") 첫#ruby("번","番")째로 #ruby("국|내","國|內")의 #ruby("애|국|자","愛|國|者")를 #ruby("망|라","網|羅")하여 #ruby("체|포","逮|捕")한 것이다. #ruby("황|해|도","黃|海|道")를 #ruby("중|심","中|心")으로 먼저 #ruby("안|명|근","安|明|根")을 잡아 가두고는, #ruby("계|속","繼|續")하여 #ruby("전","全") #ruby("도|내","道|內")의 #ruby("지|식|계|급","知|識|階|級")과 #ruby("부|호","富|豪")를 #ruby("일|일","一|一")이 #ruby("압|송","押|送")하였다. #ruby("경|성","京|城")에 이미 #ruby("배|치","配|置")한 #ruby("감|옥","監|獄"), #ruby("구|치|소","拘|置|所"), #ruby("각","各") #ruby("경|찰|서","警|察|署") #ruby("구|류|소","拘|留|所")에는 미처 #ruby("수|용","收|容")할 수 없으므로, #ruby("집|물|창|고","什|物|倉|庫")와 #ruby("사|무|실","事|務|室")까지 #ruby("구|금|소","拘|禁|所")로 #ruby("사|용","使|用")하면서 #ruby("임|시","臨|時")로 #ruby("창|고","倉|庫") 안에 벌집과 같은 #ruby("감|방","監|房")을 만들었다. 나도 그곳에 옮겨 #ruby("수|감","收|監")되었는데, 한 #ruby("방","房")에 두 #ruby("명","名") #ruby("이|상","以|上")은 가두어 두기가 #ruby("불|가|능","不|可|能")했다.]
#zh[倭寇强占韩国之后，这是第一次把国内的爱国者一网打尽、加以逮捕。以黄海道为中心，先抓住安明根关起来，接着把全道的知识阶级和富户一一押送。京城已经设置的监狱、拘留所和各警察署的留置所来不及收容，于是连杂物仓库和办公室都用作拘禁所，临时在仓库里隔出蜂巢一样的牢房。我也移到那里收监，一间房子关到两个人以上就不可能了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|해|도","黃|海|道")에서 #ruby("안|명|근","安|明|根")을 #ruby("위|시","爲|始")하여 #ruby("군|별","郡|別")로 보면, #ruby("신|천","信|川")의 #ruby("이|원|식","李|源|植")·#ruby("박|만|준","朴|萬|俊")\(#ruby("도|주","逃|走")), #ruby[신|백|서][申|伯|瑞]\(錫孝의 아들)·#ruby("이|학|구","李|學|九")·#ruby("유|원|봉","柳|元|鳳")·#ruby("유|문|형","柳|文|馨")·#ruby("이|승|조","李|承|祚")·#ruby("박|제|윤","朴|濟|潤")·#ruby("배|경|진","裵|敬|鎭")·#ruby("최|중|호","崔|重|鎬"), #ruby("재|령","載|寧")에서 #ruby("정|달|하","鄭|達|河")·#ruby("민|영|룡","閔|泳|龍")·#ruby("신|효|범","申|孝|範"), #ruby("안|악","安|岳")에서 #ruby("김|홍|량","金|鴻|亮")·#ruby("김|용|제","金|庸|濟")·#ruby("양|성|진","楊|成|鎭")·#ruby("김|구","金|龜")·#ruby("박|도|병","朴|道|秉")·#ruby("이|상|진","李|相|晋")·#ruby("장|명|선","張|明|善")·#ruby("한|필|호","韓|弼|昊")·#ruby("박|형|병","朴|亨|秉")·#ruby("고|봉|수","高|鳳|洙")·#ruby("한|정|교","韓|貞|敎")·#ruby("최|익|형","崔|益|亨")·#ruby("고|정|화","高|貞|華")·#ruby("도|인|권","都|仁|權")·#ruby("이|태|주","李|泰|周")·#ruby("장|응|선","張|膺|善")·#ruby("원|행|섭","元|行|燮")·#ruby("김|용|진","金|庸|震"), #ruby("장|련","長|連")에서 #ruby("장|의|택","張|義|澤")·#ruby("장|원|용","莊|元|容")·#ruby("최|상|륜","崔|商|崙"), #ruby("은|율","殷|栗")에서 #ruby("김|용|원","金|容|遠"), #ruby("송|화","松|禾")에서 #ruby("오|덕|겸","吳|德|謙")·#ruby("장|홍|범","張|弘|範")·#ruby("권|태|선","權|泰|善")·#ruby("이|종|록","李|宗|錄")·#ruby("감|익|룡","甘|益|龍"), #ruby("장|연","長|淵")에서 #ruby("김|재|형","金|在|衡"), #ruby("해|주","海|州")에서 #ruby("이|승|준","李|承|駿")·#ruby("이|재|림","李|在|林")·#ruby("김|영|택","金|榮|澤"), #ruby("봉|산","鳳|山")에서 #ruby("이|승|길","李|承|吉")·#ruby("이|효|건","李|孝|健"), #ruby("배|천","白|川")에서 #ruby("김|병|옥","金|秉|玉"), #ruby("연|안","延|安")에서 #ruby("편|강|렬","片|康|烈"), #ruby("평|남","平|南")에서 #ruby("안|태|국","安|泰|國")·#ruby("옥|관|빈","玉|觀|彬"), #ruby("평|북","平|北")에서 #ruby("이|승|훈","李|昇|薰")·#ruby("유|동|열","柳|東|說")·#ruby("김|용|규","金|用|圭") #ruby("형|제","兄|弟"), #ruby("경|성","京|城")에서 #ruby("양|기|탁","梁|起|鐸")·#ruby("김|도|희","金|道|熙"), #ruby("강|원","江|原")에서 #ruby("주|진|수","朱|鎭|洙"), #ruby("함|경","咸|鏡")에서 #ruby("이|동|휘","李|東|輝")였다. 나는 #ruby("이|동|휘","李|東|輝")#footnote(numbering: _ => [50)])[#h(0.35em)#ruby[이|동|휘][李|東|輝]\(1872〜1935). #ruby("호","號")는 #ruby("성|재","誠|齋"). #ruby("한|말","韓|末") #ruby("군|인","軍|人")에서 #ruby("의|병","義|兵")·#ruby("교|육","敎|育") #ruby("운|동","運|動")에 #ruby("참|여","參|與")하였다. #ruby("신|민|회","新|民|會")에 #ruby("참|여","參|與")하였고, 105#ruby("인","人") #ruby("사|건","事|件")에 #ruby("연|루","連|累")되어 #ruby("체|포","逮|捕")되었으나 #ruby("무|혐|의","無|嫌|疑")로 #ruby("석|방","釋|放")되었다. 그는 #ruby("상|해","上|海") #ruby("임|시|정|부","臨|時|政|府")에서 #ruby("초|대","初|代") #ruby("국|무|총|리","國|務|總|理")를 맡았는데, 1920#ruby("년","年") #ruby("공|산|주|의","共|産|主|義") 그룹 #ruby("상|해|파","上|海|派")의 #ruby("영|수","領|袖")가 된다. 이러한 #ruby("성|향","性|向")으로 #ruby("이|동|휘","李|東|輝")는 #ruby("백|범","白|凡")과 #ruby("대|립","對|立")하였다.]와 #ruby("상|면","相|面")이 없었지만, #ruby("유|치|장","留|置|場")의 #ruby("명|패","名|牌")를 보고서 역시 #ruby("체|포","逮|捕")당한 줄 알았다.]
#zh[黄海道此次被抓来的人有安明根，信川的除李源植、朴万俊已见机逃走外，还有申伯瑞、李学九、柳元凤、柳文馨、李承祚、朴济润、裴敬镇、崔重镐；载宁的有郑达河、闵泳龙、申孝范；安岳的有金鸿亮、金庸济、杨星镇、金龟、朴道秉、李相晋、张明善、韩弼浩、朴亨秉、高凤洙、韩贞教、崔益亨、高贞和、都寅权；长连的有张义泽、庄元容、崔商仑；殷律有金容远；松禾有吴德谦、张弘范、权泰善、李宗录、甘益龙；长渊有金在衡；海州有李承骏、李在林、金荣泽；凤山有李承吉、李孝健；白川有金秉玉；延安有片康烈等；平安南道有安泰国、玉观彬；平安北道有李升薰、柳东悦、金龙圭兄弟；京城有梁起铎、金道熙；江原道有朱镇洙；咸镜道有李东辉等。我和李东辉是素不相识的，但在拘留所看到他的名牌后，才知道他也是被抓来的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("국|가","國|家")가 #ruby("망","亡")하기 #ruby("전","前") #ruby("구|국|사|업","救|國|事|業")에 #ruby("성|의","誠|意") #ruby("성|력","誠|力")을 #ruby("십|분","十|分") #ruby("발|휘","發|揮")하지 못한 #ruby("죄","罪")를 받게 된 것으로 #ruby("자|인","自|認")했다. 나는 깊이 생각했다. 이와 같은 #ruby("위|난","危|難")한 때를 #ruby("당","當")하여 #ruby("응|당","應|當") 지켜갈 #ruby("신|조","信|條")가 무엇인가를 #ruby("연|구","硏|究")하였다. “#ruby("질|풍","疾|風")에 #ruby("경|초","勁|草")를 알고 #ruby("판|탕","坂|蕩")에 #ruby("성|신","誠|臣")을 #ruby("지","知")한다”#footnote(numbering: _ => [51)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “드센 바람에 억센 풀을 알고 #ruby("국|가","國|家")가 #ruby("혼|란","混|亂")할 때 #ruby("진|실","眞|實")한 #ruby("신|하","臣|下")를 안다”. #ruby("질|풍","疾|風")은 드센 바람, #ruby("경|초","勁|草")는 바람에 쏠리지 않는 억센 풀. ‘坂蕩’은 ‘板蕩’으로 #ruby("정|치","政|治")를 잘못하여 나라가 어지러운 것을 말한다.]는 옛 가르침과, #ruby("사|육|신","死|六|臣")·#ruby("삼|학|사","三|學|士")가 죽어도 꺾이지 않았다는 #ruby("고|후|조","高|後|凋") #ruby("선|생","先|生")의 가르침을 다시금 생각하였다.]
#zh[我想，我们平时并没有为国家尽忠效命，因此才会受到这种惩罚，现在我想到了“疾风知劲草，板荡识忠臣”的古训，我如今唯一能做的事是决定实践高后凋先生的训诫，效法“六臣”①和“三学士”宁死不屈的精神。]
#zh[译注：①朝鲜世祖（一四五六—一四六八年在位）时为谋求端宗复位而被处死的六名忠臣，即：李垞、河纬地、柳诚源、俞应孚、成三问、朴彭年。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 #ruby("소|위","所|謂") #ruby("신|문|실","訊|問|室")에 끌려갔다. 처음에는 #ruby("연|령","年|齡")·#ruby("주|소","住|所")·#ruby("성|명","姓|名")을 묻더니,]
#zh[有一天被拉到所谓审讯室。起初问了年龄、住址、姓名，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 어찌하여 여기를 왔는지 알겠느냐?”]
#zh[“你知道自己为什么到这里来吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 물었다.]
#zh[他这样问。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“잡아오니 끌려올 뿐 #ruby("이|유","理|由")는 모른다.”]
#zh[我答道：]
#zh[“因为是被抓来的，所以才到了这里，可是我并不知道原委。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다시는 묻지도 않고 #ruby("수|족","手|足")을 #ruby("결|박","結|縛")하여 #ruby("천|장","天|障")에 달아맨다. 처음에는 #ruby("고|통","苦|痛")을 느꼈으나, 마지막에는 눈 내리는 밤 달빛 #ruby("적|막","寂|寞")한 #ruby("신|문|실","訊|問|室") 한 모퉁이에 가로누워 있게 되었다. 얼굴과 #ruby("전|신","全|身")에 #ruby("냉|수","冷|水")를 끼얹은 느낌만 날 뿐 그 #ruby("전","前")에 무슨 일이 있었는지 알 수 없었다.]
#zh[倭寇不再问我，他们把我的手脚捆绑起来，吊在天花板上，起初觉得很痛苦，后来渐渐失去知觉，等到醒来时，发觉我躺在审讯室的角落里。冬天冷寂的月光斜照着我，除了感觉到脸和身上像是被冷水泼过以外，一点儿也记不起其间发生过什么事情。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("정|신","精|神")을 차리자 #ruby("왜|구","倭|寇")는 비로소 #ruby("안|명|근","安|明|根")과의 #ruby("관|계","關|係")를 물었다. 나는 #ruby("안|명|근","安|明|根")은 서로 아는 #ruby("친|구","親|舊")일 뿐이고 같이 일한 #ruby("사|실","事|實")은 없다고 #ruby("답","答")하였다. 그놈은 #ruby("노|발|대|발","怒|發|大|發")하여 다시 #ruby("천|장","天|障")에 매달고 세 놈이 돌아가며 매와 몽둥이로 #ruby("무|수","無|數")히 #ruby("난|타","亂|打")하였다. 나는 또 #ruby("정|신","精|神")을 잃었다.]
#zh[精神恢复过来，倭寇这才问我和安明根的关系。我回答，安明根只是相识的朋友，没有一起做过事。那家伙勃然大怒，重新吊到天花板上，三个人轮流用鞭子和棍子没头没脑地打。我又失去了知觉。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[세 놈이 마주 들어다가 #ruby("유|치|장","留|置|場")에 눕힐 때는 이미 #ruby("동|창","東|窓")이 밝았다. 내가 #ruby("신|문|실","訊|問|室")에 끌려가던 때는 어제 해 진 #ruby("후","後")였다. 처음에 #ruby("성|명","姓|名")부터 #ruby("신|문","訊|問")을 #ruby("시|작","始|作")하던 놈이 불을 밝히고 밤을 새우는 것과 그놈들이 온 힘을 다해 #ruby("사|무","事|務")에 #ruby("충|실","忠|實")한 것을 생각할 때에 #ruby("자|괴|심","自|愧|心")을 견딜 수가 없었다.]
#zh[三个人抬着把我放倒在留置场时，东窗已经发白。我被拉进审讯室，是昨天日落后。想到那个从姓名开始审问的家伙点着灯熬了一夜，想到他们尽全力忠于事务，我抑制不住羞愧。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("평|소","平|素")에 무슨 일이든지 #ruby("성|심","誠|心")껏 보거니 하는 #ruby("자|신","自|信")도 있었다. 그러나 나라를 남에게 먹히지 않게 #ruby("구|원","救|援")하겠다는 내가, 남의 나라를 한꺼번에 삼키고 되씹는 저 #ruby("왜|구","倭|寇")와 같이 밤을 새워 일한 적이 몇 #ruby("번","番")이었던가? 스스로 물어보니, 온몸이 바늘#ruby("방|석","方|席")에 누운 듯이 #ruby("고|통","苦|痛")스런 #ruby("와|중","渦|中")에도, 내가 #ruby("과|연","果|然") #ruby("망|국|노","亡|國|奴")의 #ruby("근|성","根|性")이 있지 않은가 하여 부끄러운 눈물이 눈시울에 가득 찼다.]
#zh[我平日也自信，不论什么事都尽心去做。可是我口口声声要救国家，不让它被别人吞掉，和那些把别人的国家一口吞下、再倒嚼的倭寇相比，我又有几夜是这样熬过来的？自己一问，纵然浑身像躺在针席上那样痛苦，仍觉得我到底是不是也有亡国奴的根性，羞愧的眼泪充满了眼眶。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("비|단","非|但") 나뿐이랴. 이웃 #ruby("감|방","監|房")에 있는 #ruby("김|홍|량","金|鴻|亮")·#ruby("한|필|호","韓|弼|昊")·#ruby("안|태|국","安|泰|國")·#ruby("안|명|근","安|明|根") #ruby("등","等")도 끌려갔다가 거의 죽어서 돌아온다는 #ruby("소|식","消|息")을 들을 때, 애처롭고 #ruby("분|개","憤|慨")한 마음을 #ruby("억|제","抑|制")할 수 없었다.]
#zh[受到如此严刑拷打的并不只是我一个，隔壁金鸿亮、韩弼浩、安泰国、安明根等，在被带去接受审问后，都是在半死的状态下被送回拘留所的。每次我看到这种情况，就无法抑制涌上心头的满腔悲愤。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("명|근","明|根")은 소리소리 지르면서,]
#zh[有一次，安明根大声嘶喊着说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너희 놈들이 죽일 때 죽일지언정, #ruby("애|국","愛|國") #ruby("의|사","義|士")를 이렇게 #ruby("대|접","待|接")하느냐?”]
#zh[“狗东西！要杀便杀，你们就这样对待爱国义士吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 큰소리로 꾸짖다가, #ruby("간|혹","間|或") 한마디씩 우리에게]
#zh[在他大声叱责中有一句话传到我们耳边：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 내 말만 하였고, #ruby("김|구","金|龜")·#ruby("김|홍|량","金|鴻|亮") #ruby("등","等")은 #ruby("관|계","關|係") 없다 하였소.”]
#zh[“我只说我自己，和金龟、金鸿亮毫不相干。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 말했다.]
#zh[他这样说。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|방","監|房")에서는 #ruby("무|선","無|線")으로 #ruby("이|야|기","無|線|話")를 #ruby("통","通")한다. #ruby("양|기|탁","梁|起|鐸")의 #ruby("방","房")에서 #ruby("안|태|국","安|泰|國") #ruby("방","房")과 내 #ruby("방","房")으로, #ruby("이|재|림","李|在|林") #ruby("방","房") #ruby("좌|우","左|右") 20#ruby("여","餘") #ruby("방","房")의 40#ruby("여","餘") #ruby("명","名")은 서로 #ruby("밀|어","密|語")를 #ruby("전","傳")했다. #ruby("왜","倭")놈들은 #ruby("사|건","事|件")을 둘로 나누니 #ruby("소|위","所|謂") 하나는 #ruby("보|안|범","保|安|犯")이고, 다른 하나는 #ruby("살|인","殺|人") #ruby("모|의","謀|議") 및 #ruby("강|도","强|盜")다.]
#zh[牢房里用“无线”传话。从梁起铎的房间传到安泰国的房间和我的房间，再到李在林房间左右二十多间、四十多人，彼此传递暗语。倭寇把案子分成两起，所谓一个是保安犯，另一个是谋杀和强盗。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[누가 #ruby("신|문","訊|問")을 당하고 오면 #ruby("내|용","內|容")을 #ruby("각","各") #ruby("방","房")에 #ruby("전|달","傳|達")하여 #ruby("주|의","注|意")하게 하였던바, #ruby("왜","倭")놈들이 #ruby("사|건","事|件")의 #ruby("범|위","範|圍")가 #ruby("축|소","縮|小")됨을 #ruby("기|이","奇|異")하게 알고, 그#ruby("중","中")에 #ruby("한|순|직","韓|淳|稷")을 불러다가 #ruby("감|언|이|설","甘|言|利|說")로 꼬여 #ruby("각","各") #ruby("방","房")에서 #ruby("밀|어","密|語")하는 #ruby("내|용","內|容")을 #ruby("탐|지","探|知")하여 알리게 하였다.]
#zh[谁受了审问回来，就把内容传到各房，叫大家留意。倭寇奇怪案子的范围缩小了，把其中的韩淳稷叫去，用甜言蜜语哄他，让他探知各房暗语的内容，报告给他们。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 #ruby("양|기|탁","梁|起|鐸")이 밥구멍에 손바닥을 대고 말했다.]
#zh[有一天，梁起铎把手掌贴在送饭口上说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리의 #ruby("비|밀|전|어","秘|密|傳|語")는 #ruby("한|순|직","韓|淳|稷")이가 #ruby("전|부","全|部") #ruby("고|발","告|發")하니, 이제부터 #ruby("밀|어","密|語") #ruby("전|달","傳|達")을 #ruby("폐|지","廢|止")하자.”]
#zh[“我们的秘密暗语，韩淳稷全都告发了。从现在起，废止暗语传递。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("과|연","果|然") #ruby("질|풍","疾|風")에 굳센 풀을 알 수 있겠다. #ruby("당|초","當|初")에 #ruby("명|근","明|根") #ruby("형","兄")이 #ruby("한|순|직","韓|淳|稷")을 나에게 #ruby("소|개","紹|介")할 때에는 #ruby("용|감","勇|敢")한 #ruby("청|년","靑|年")이라고 하였다. 그러나 이와 같이 #ruby("위|난","危|難")할 때 꺾이는 것이 어찌 #ruby("한|순|직","韓|淳|稷") 혼자뿐이랴. #ruby("최|명|식","崔|明|植")도 #ruby("밀|고","密|告")는 아니하였지만, #ruby("사|실","事|實")이 아닌 것을 그놈들의 #ruby("가|혹","苛|酷")한 #ruby("고|문","拷|問")에 못 이겨 #ruby("무|고","誣|告")한 것이 #ruby("후|회","後|悔")되어 스스로 #ruby("호","號")를 #ruby("긍|허","兢|虛")#footnote(numbering: _ => [52)])[#h(0.35em)#ruby[최|명|식][崔|明|植]\(1880〜1961)은 #ruby("황|해|도","黃|海|道") #ruby("안|악","安|岳") #ruby("출|신","出|身")의 #ruby("독|립|운|동|가","獨|立|運|動|家"). #ruby("한|말","韓|末") #ruby("최|광|옥","崔|光|玉")과 더불어 #ruby("안|악|면|학|회","安|岳|勉|學|會")를 #ruby("조|직","組|織")하고, #ruby("백|범","白|凡")과 더불어 #ruby("신|민|회","新|民|會")에 #ruby("가|입","加|入")하여 #ruby("활|동","活|動")하였다. 1910#ruby("년","年") #ruby("안|명|근","安|明|根") #ruby("사|건","事|件")에 #ruby("연|루","連|累")되어 #ruby("복|역","服|役")하면서, 스스로 #ruby("자|책","自|責")하며 #ruby("호","號")를 #ruby("긍|허","兢|虛"), #ruby("즉","卽") ‘마음을 삼가고 비운다’로 지었다. #ruby("해|방","解|放") #ruby("이|후","以|後") 그는 #ruby("만|주|지|역","滿|洲|地|域")에 남아 #ruby("한|독|당","韓|獨|黨") #ruby("동|북|특|별|당|부","東|北|特|別|黨|部") #ruby("특|별|위|원","特|別|委|員")을 #ruby("역|임","歷|任")하였다. #ruby("백|범","白|凡")과 #ruby("노|선","路|線")을 같이 하던 그는 1948#ruby("년","年") #ruby("귀|국","歸|國")한 #ruby("이|후","以|後") #ruby("백|범","白|凡")의 #ruby("남|북|연|석|회|의","南|北|聯|席|會|議") #ruby("노|선","路|線")에 #ruby("반|대","反|對")하였고, 1950#ruby("년","年") #ruby("신|익|희","申|翼|熙")의 #ruby("민|주|공|화|당","民|主|共|和|黨") #ruby("중|앙|위|원","中|央|委|員")이 되었다.]라 한 것이다.]
#zh[果然疾风知劲草。当初明根兄把韩淳稷介绍给我时，说他是勇敢的青年。可是危难时折了的，岂止韩淳稷一个。崔明植虽然没有告密，却受不住他们残酷的拷问，供了不实的话，冤枉了人，事后后悔，便自己起了个号，叫兢虚。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("결|심","決|心")에 #ruby("결|심","決|心")을 더하여 나의 혀끝에 사람의 #ruby("생|사","生|死")가 달렸다는 것을 #ruby("각|오","覺|悟")하였다. 어느날 또 끌려 #ruby("신|문|실","訊|問|室")에 갔다. #ruby("왜|경","倭|警")이 물었다.]
#zh[我下了又下决心，觉悟到许多人的生死系在我的舌尖上。有一天又被拉到审讯室。倭警问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네 #ruby("평|생","平|生") #ruby("친|구","親|舊")가 누구냐?”]
#zh[有一天，又传唤我出去，问我平生的知己是谁，我不加考虑地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("평|생","平|生") #ruby("친|구","親|舊")는 #ruby("오|인|형","吳|寅|炯")이오.”]
#zh[“平生的朋友是吴寅炯。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈이 반가운 낯으로 물었다.]
#zh[倭寇露出高兴的脸色问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그 사람은 어디서 무엇을 하는가?”]
#zh[“那个人在哪里，做什么？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("오|인|형","吳|寅|炯")은 #ruby("장|련","長|連")에서 살았으나 #ruby("연|전","年|前")에 #ruby("사|망","死|亡")하였소.”]
#zh[“吴麟炯住在长渊，去年已经逝世了。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하니, 그놈들이 또한 #ruby("정|신","精|神")을 잃도록 #ruby("가|혹","苛|酷")하게 #ruby("고|문","拷|問")하였다.]
#zh[听到我这句话，他们大怒，更以恶刑相加，直到我失去知觉为止。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("학|생","學|生") #ruby("중","中")에는 누가 너를 가장 사랑하더냐?”]
#zh[“学生里面，谁最爱你？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하는 말에, #ruby("졸|지|간","猝|地|間")에 내 집에 와서 #ruby("공|부","工|夫")를 하던 #ruby("최|중|호","崔|重|鎬")를 말하고선 혀를 끊고 싶었다. ‘젊은 것이 또 잡혀오겠다’고 생각하였으나, 눈을 들어 #ruby("창","窓") 밖을 보니 벌써 언제 잡혀왔는지 #ruby("반","半")이나 죽은 것을 끌고 지나가는 것이 보였다.]
#zh[听到这话，我一时说出常到我家来读书的崔重镐，说出口就想割掉舌头。心想“年轻人又要被抓来了”，抬眼往窗外看，已经看见一个半死的人被拖过去，不知什么时候抓来的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("소|위","所|謂") #ruby("경|무|총|감|부","警|務|總|監|府")인 #ruby("이|현","泥|峴")#footnote(numbering: _ => [53)])[#h(0.35em)#ruby("현|재","現|在")의 #ruby("충|무|로","忠|武|路")·#ruby("필|동","筆|洞") #ruby("일|대","一|帶"). #ruby("남|산","南|山")의 #ruby("북","北")쪽 #ruby("사|면","斜|面")은 #ruby("배|수","排|水")가 잘 되지 않아 비가 오면 진흙길이 되었다고 해서 #ruby("일|명","一|名") 진고개라 한다. #ruby("경|무|총|감|부","警|務|總|監|府")는 #ruby[대|화|정][大|和|町]\(#ruby("지|금","只|今")의 #ruby("필|동","筆|洞"))에 있었다.] #ruby("산","山")기슭에서는 밤낮으로 #ruby("도|살|장","屠|殺|場")에서 소와 돼지를 때려잡는 소리가 여기저기서 끊이지 않고 들린다. 하루는 #ruby("한|필|호","韓|弼|昊")#footnote(numbering: _ => [54)])[#h(0.35em)#ruby[한|필|호][韓|弼|昊]\(1886〜1911). #ruby("황|해|도","黃|海|道") #ruby("신|천","信|川") #ruby("출|신","出|身")의 #ruby("애|국|계|몽|운|동|가","愛|國|啓|蒙|運|動|家"). 1906#ruby("년","年") #ruby("양|산|학|교","楊|山|學|校")에 #ruby("관|여","關|與")하고 1907#ruby("년","年") #ruby("신|민|회","新|民|會") #ruby("황|해|도","黃|海|道")#ruby("지|부","支|部")에서 #ruby("활|동","活|動")하였다. 1910#ruby("년","年") #ruby("안|명|근","安|明|根") #ruby("사|건","事|件")에 #ruby("연|루","連|累")되어 #ruby("검|거","檢|擧")되어 #ruby("고|문","拷|問")을 받다 #ruby("순|국","殉|國")하였다.] #ruby("의|사","義|士")가 #ruby("신|문","訊|問")당하고 와서 밥구멍으로 겨우 머리를 들어 나를 보고,]
#zh[泥岘山麓下的所谓警务总监部里，昼夜不停地传出哀嚎，就像是屠宰场内的猪、牛被打得半死时的哀鸣。]
#zh[有一天韩弼浩义士受审后回来经过我的牢房，勉强地抬起头来，从送饭口对着我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("일|절","一|節") #ruby("부|인","否|認")하였더니 #ruby("지|독","至|毒")한 #ruby("고|문","拷|問")을 당해 나는 죽습니다.”]
#zh[“我否认了一切，他们施以酷刑，我怕是活不了啦。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고서 #ruby("작|별","作|別")하는 #ruby("모|양","模|樣")을 보인다. 나는 #ruby("위|로","慰|勞")하고 물이라도 좀 마시라고 하였다.]
#zh[听起来好像是跟我诀别似的，于是我安慰他说：]
#zh[“不要那样灰心，先喝一口水吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“물도 먹을 #ruby("필|요","必|要")가 없습니다.”]
#zh[然而韩义士说：]
#zh[“如今连水也不必喝了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("한|의|사","韓|義|士")는 말했다. #ruby("그|후","其|後")에는 다시 어디로 끌고 간 줄 몰랐는데, #ruby("공|판","公|判") 때에 #ruby("동|지","同|志")들에게서 #ruby("신|석|충","申|錫|忠")이 #ruby("철|교","鐵|橋")에서 #ruby("자|살","自|殺")한 것과, #ruby("한|의|사","韓|義|士")가 #ruby("살|해","殺|害")를 #ruby[당했다][遇害]는 것을 비로소 알게 되었다.]
#zh[此后就再也没有他的消息，直到开庭公判时从同志们口里得知申锡忠投江自尽，韩弼浩惨遭杀害的消息。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 #ruby("최|고","最|高") #ruby("신|문|실","訊|問|室")에 갔다. 그런데 누가 뜻하였으랴. 17#ruby("년","年") #ruby("전","前") #ruby("인|천","仁|川") #ruby("경|무|청","警|務|廳")에서 #ruby("심|문","訊|問")을 할 때 #ruby("방|청","傍|聽")을 하다가 내가 #ruby("호|령","號|令")하자 “칙쇼우! 칙쇼우!” 하면서 #ruby("후|문","後|門")으로 #ruby("피|신","避|身")하던 #ruby("와타나베","渡邊")라는 #ruby("순|사","巡|査")놈이, #ruby("전","前")과 같이 검은 #ruby("수|염","鬚|髥")을 길러 늘어뜨리고 얼굴에는 #ruby("약|간","若|干") #ruby("노|쇠","老|衰")한 빛을 띠고 #ruby("총|감|부","總|監|府") #ruby("기|밀|과|장","機|密|課|長")의 #ruby("제|복","制|服")을 입고 #ruby("엄|숙","嚴|肅")하게 다시 내 앞에 턱 마주앉을 줄을. #ruby("와타나베","渡邊") 놈이 입을 열면서 이런 말을 한다.]
#zh[有一天我被带到“最高讯问室”，谁会料到我又遇见了十七年前我在仁川警务厅被审问时坐在旁听席上的渡边巡警，那时他看到我大声叱责，一面嘴里用日语骂着：“畜生！畜生！”一面往后面躲避，现在居然坐在前面来审问我了。这个家伙，像从前一样留着长而黑的胡子，脸上看来多少有些衰老，他穿着警务总监部机关课长的制服，神气活现地坐在我的对面。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내 가슴에는 X#ruby("광|선","光|線")을 대고 있어서 너의 #ruby("일|생","一|生") #ruby("행|적","行|蹟")과 #ruby("비|밀","祕|密")을 모두 알고 있으니, 터럭만큼이라도 숨기면 이 자리에서 때려죽일 터이다.”]
#zh[渡边这个家伙，对我说的第一句话就是，他怀里藏有X光线，早就知道我生平的历史和我内心所藏的秘密，因此要我不必隐瞒，彻底坦白，如有半点隐瞒不实的话，就要当场打死我。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("연|전","年|前")에 #ruby("여|순","旅|順") #ruby("사|건","事|件")에 대한 #ruby("혐|의","嫌|疑")로 #ruby("해|주","海|州") #ruby("검|사|국","檢|事|局")에서 『#ruby("김|구","金|龜")』라는 #ruby("제|목","題|目")이 쓰인 #ruby("책|자","冊|子")를 앞에 두고 #ruby("신|문","訊|問")당하던 일을 생각하였다. #ruby("각","各") #ruby("지|방","地|方")의 #ruby("보|고","報|告")를 #ruby("수|집","蒐|集")한 그 #ruby("책","冊")에는 #ruby("치|하|포","鴟|河|浦")에서 #ruby("왜","倭")놈 죽인 일과 #ruby("인|천","仁|川")에서의 #ruby("사|형","死|刑") #ruby("정|지","停|止"), 그리고 #ruby("탈|옥","脫|獄") #ruby("도|주","逃|走")한 #ruby("사|실","事|實")이 반드시 #ruby("기|재","記|載")되었으리라 생각하였다. 왜냐하면 그 #ruby("사|건","事|件")은 #ruby("당|시","當|時")에 #ruby("전|국","全|國")을 떠들썩하게 하였고, 더욱이 #ruby("황|해","黃|海")·#ruby("평|안|도","平|安|道")에서는 #ruby("배|일","排|日") #ruby("연|설","演|說")의 #ruby("소|재","素|材")가 되었고 #ruby("평|상|시","平|常|時")에도 이야깃거리가 되었기 때문이다.]
#zh[我想起年前因旅顺事件的嫌疑，在海州检事局、面前放着题为《金龟》的册子受审的事。那本收集各地报告的书里，一定记着在鸥河浦杀死倭寇、在仁川停止死刑、以及越狱逃走的事实。因为那件事当时轰动全国，尤其在黄海、平安道成了排日演说的材料，平日也是谈资。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("와타나베","渡邊")가 #ruby("자|발|적","自|發|的")으로 “네가 17#ruby("년","年") #ruby("전","前")에 #ruby("인|천","仁|川") #ruby("경|무|청","警|務|廳")에서 나에게 #ruby("질|욕","叱|辱")하던 일을 #ruby("기|억","記|憶")하느냐?” 하는 말을 하기 #ruby("전","前")에는 입을 열지 않고, #ruby("와타나베","渡邊")의 X#ruby("광|선","光|線")이 #ruby("확|실","確|實")히 맞는가 틀리는가를 #ruby("시|험","試|驗")할 생각으로 이렇게 #ruby("대|답","對|答")을 하였다.]
#zh[可是在渡边自己说出“你还记得十七年前在仁川警务厅辱骂我的事吗”之前，我决定不开口，并且想试一试渡边的X光线到底准不准，于是这样回答。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나의 #ruby("일|생","一|生")은 구석진 곳에서 #ruby("은|사","隱|士") #ruby("생|활","生|活")을 한 적 없고, #ruby("일|반","一|般") #ruby("사|회","社|會")에서 #ruby("헌|신|적","獻|身|的") #ruby("생|활","生|活")을 한 탓으로 말 하나 #ruby("행|동","行|動") 하나가 다 #ruby("공|개|적","公|開|的")이고 #ruby("비|밀","祕|密")은 없소.”]
#zh[“我一生从未在僻静之处过过隐士生活，而是献身于社会，一举一动，一言一行光明磊落，毫无隐私。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("와타나베","渡邊")는 #ruby("순|서","順|序")대로 묻기 #ruby("시|작","始|作")했다.]
#zh[渡边依次询问：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("출|생|지","出|生|地")는?”]
#zh[“你的出生地？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("해|주","海|州") 텃골.”]
#zh[“海州基洞。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("교|육","敎|育")은?”]
#zh[“学历？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("서|당","書|堂")에서 #ruby("한|문","漢|文")을 배웠소.”]
#zh[“在私塾里学过汉文。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("직|업","職|業")은?”]
#zh[“职业”？]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("농|촌","農|村")에서 나서 자랐으므로 나무하고 밭 갈고 하다가, 25〜6#ruby("세","歲")에 #ruby("장|련","長|連")으로 #ruby("이|주","移|住")하여 #ruby("종|교","宗|敎")와 #ruby("교|육","敎|育")에 #ruby("종|사","從|事")하기 #ruby("시|작","始|作")하여, #ruby("지|금","只|今")은 #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校") #ruby("교|장","校|長")으로 #ruby("근|무","勤|務")하던 #ruby("중","中")에 #ruby("체|포","逮|捕")되었소.”]
#zh[“我是农民出身，先是砍柴种地，到二十五六岁，移居长连，开始从事宗教和教育工作。现在新被任命为安岳杨山学校校长，没有多久，就遭到逮捕。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("와타나베","渡邊") 놈이 성을 버럭 내며,]
#zh[渡边怒气冲冲地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("종|교","宗|敎")·#ruby("교|육","敎|育")은 #ruby("피|상|적","皮|相|的") #ruby("운|동","運|動")이고, #ruby("이|면","裏|面")에 #ruby("불|순","不|純")한 #ruby("음|모","陰|謀")가 하나둘이 아니란 것을 내가 #ruby("분|명","分|明")히 알고 있다. #ruby("서|간|도","西|間|島")에 #ruby("무|관|학|교","武|官|學|校")를 #ruby("설|립","設|立")하여 #ruby("후|일","後|日") #ruby("독|립|전|쟁","獨|立|戰|爭")을 #ruby("준|비","準|備")하던 #ruby("사|실","事|實")과, #ruby("안|명|근","安|明|根")과 #ruby("공|모","共|謀")하여 #ruby("총|독","總|督")을 #ruby("모|살","謀|殺")하려 하고 #ruby("부|자","父|子")의 #ruby("금|전","金|錢")을 #ruby("강|탈","强|奪")하려 한 #ruby("사|실","事|實")을 우리 #ruby("경|찰","警|察")은 불 보듯 환하게 알고 있는데 끝까지 숨기려 하느냐?”]
#zh[“你表面上从事宗教和教育工作，暗地里却在策划阴谋，这一点我知道得很清楚。你们在西间岛设立武官学校，准备进行独立战争，你又和安明根共谋杀害总督，抢夺有钱人家的钱财，这些你还不从实招来？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[며 #ruby("노|기","怒|氣")가 #ruby("등|등","騰|騰")하다. 나는 두려움보다는 나의 가슴을 비춘다는 X#ruby("광|선","光|線")이 탈이 나지 않았나 우스운 생각이 났다. 이를 참아가면서]
#zh[这时我并不害怕，只是暗自好笑，觉得渡边怀里藏的X光线也并不怎么样。]
#zh[这样看来，大概告发我的韩籍刑警和侦探们故意漏掉了那些而报告上去的吧！]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("안|명|근","安|明|根")과는 #ruby("일|절","一|節") #ruby("관|계","關|係")가 없다.”]
#zh[“和安明根毫无关系。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("서|간|도","西|間|島")에 #ruby("빈|한","貧|寒")한 #ruby("농|가","農|家")를 #ruby("이|주","移|住")시켜 #ruby("생|활","生|活") #ruby("근|거","根|據")를 마련해 주려는 것뿐이고 다른 일은 없다.”]
#zh[“不过是把贫困的农户迁到西间岛，给他们安排生活的根基，没有别的事。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("지|방|경|찰","地|方|警|察")의 #ruby("시|각","視|角")이 너무 #ruby("협|소","狹|小")하여 걸핏하면 #ruby("일|본","日|本")을 #ruby("배|척","排|斥")하느니 뭐니 하면서 #ruby("교|육|사|업","敎|育|事|業")에 #ruby("방|해","妨|害")가 많으니 #ruby("이|후","以|後") #ruby("지|방|경|찰","地|方|警|察")을 #ruby("주|의","注|意")시켜 우리 같은 사람들이 #ruby("교|육","敎|育")이나 잘 하도록 하여 달라.”]
#zh[“地方警察的眼光太狭窄，动不动就说什么排斥日本，教育事业受到许多妨碍。以后请约束地方警察，让我们这样的人好好办教育。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("학|교","學|校") #ruby("개|학","開|學") #ruby("시|기","時|期")가 이미 지났으니 #ruby("속","速")히 내려가 #ruby("학|교","學|校") #ruby("개|학","開|學")이나 하게 하라.”]
#zh[“学校开学的时期已经过了，赶快放我下去，让学校开学。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 하였다. #ruby("와타나베","渡邊") 놈은 #ruby("고|문","拷|問")도 하지 않고 그저 #ruby("유|치|장","留|置|場")으로 보냈다.]
#zh[渡边这家伙未动酷刑，把我送回拘留所。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("국|모|보|수","國|母|報|讐") #ruby("사|건","事|件")은 #ruby("비|밀","祕|密")이 아니고 #ruby("세|상","世|上")이 다 아는 #ruby("공|공|연","公|公|然")한 #ruby("사|실","事|實")이다. #ruby("왜","倭")놈들이 #ruby("각","各") #ruby("경|찰|기|관","警|察|機|關")에 #ruby("주|의|인|물","注|意|人|物")로 붉은 줄을 긋고 나의 온갖 #ruby("행|동","行|動")을 #ruby("조|사","調|査")했으니, #ruby("해|주","海|州") #ruby("검|사|국","檢|事|局")에 #ruby("비|치","備|置")한 『#ruby("김|구","金|龜")』라는 #ruby("책|자","冊|子")에도 반드시 #ruby("쓰치다","土田")를 죽인 #ruby("사|실","事|實")이 #ruby("기|재","記|載")되었으리라 생각했고, 이번에 #ruby("총|감|부","總|監|府") #ruby("경|시","警|視") 한 #ruby("명","名")이 #ruby("안|악","安|岳")에 #ruby("출|장","出|張") #ruby("조|사","調|査")까지 하였으니, 그 #ruby("사|실","事|實")이 #ruby("발|각","發|覺")된다면 내 #ruby("일|생","一|生")은 여기서 끝이라고 생각하였다. #ruby("와타나베","渡邊") 놈이 썩 들어서면서 내 가슴에 X#ruby("광|선","光|線")을 비췄으니 #ruby("과|거","過|去")를 다 알고 있노라고 할 때, ‘#ruby("인|천","仁|川") #ruby("사|건","事|件")은 피할 수 없다’고 생각하면서도, 그놈의 X#ruby("광|선","光|線")을 #ruby("시|험","試|驗")해 보자는 생각이 들었던 것이다.]
#zh[我为国母报仇的事不是秘密，是世上都知道的公开事实。倭寇在各警察机关把我当作注意人物画了红线，调查我的一切行动，所以我想，海州检事局置备的《金龟》册子里，一定也记着杀死土田的事实。这次总监部又派一名警视到安岳出差调查，那事实若被发觉，我这一生就在这里完了。渡边那家伙闯进来，说往我胸口照了X光线，过去的事全都知道。我一面想“仁川的事躲不开”，一面又想试一试那家伙的X光线。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("와타나베","渡邊") 놈이 그 #ruby("사|실","事|實")을 알면서 #ruby("후|일","後|日")을 #ruby("위","爲")해 일부러 남겨두고 다른 말만 묻는 것이 아니란 #ruby("사|실","事|實")은, 그놈이 #ruby("신|문","訊|問")할 때 X#ruby("광|선","光|線") #ruby("운|운","云|云")하며 나의 #ruby("과|거","過|去")와 #ruby("현|재","現|在")를 잘 아는 듯 #ruby("표|시","表|示")를 내려고 애쓰는 것을 보아서도 잘 알 수 있었다.]
#zh[渡边并不是知道那事实、为了日后故意留着、只问别的话。从他审问时口口声声X光线、极力做出深知我过去和现在的样子，就可以明白。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러고 보니 #ruby("국|가","國|家")는 #ruby("망","亡")하였으나 #ruby("인|민","人|民")은 #ruby("망","亡")하지 않았다고 생각된다. 나는 #ruby("평|소","平|素") 우리 #ruby("한|인","韓|人")의 #ruby("정|탐","偵|探")을 몹시 미워해서 #ruby("여|지","餘|地")없이 #ruby("공|격","攻|擊")하곤 했는데, 나에게 #ruby("공|격","攻|擊")을 받은 #ruby("정|탐|배","偵|探|輩")까지도, #ruby("자|기","自|己")가 잘 아는 그 #ruby("사|실","事|實")만은 #ruby("밀|고","密|告")를 하지 않고 #ruby("왜","倭")놈에 #ruby("대","對")하여 #ruby("비|밀","祕|密")을 지켜준 것이 아닌가.]
#zh[这么看来，国家亡了，人民没有亡。我平日极恨我们韩人的侦探，毫不留情地攻击。可是连受过我攻击的侦探辈，对自己清楚知道的那件事实也不告密，对着倭寇守住了秘密。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다른 사람은 #ruby("물|론","勿|論")이고, 나의 #ruby("제|자","弟|子")로서 #ruby("형|사","刑|事")가 된 #ruby("김|홍|식","金|弘|植")과, 같은 #ruby("학|교","學|校") #ruby("직|원","職|員")으로 있던 #ruby("원|인|상","元|仁|常") #ruby("등","等")부터 #ruby("밀|고","密|告")하지 않은 것이니, 그러고 보면 #ruby("각|처","各|處") #ruby("한|인","韓|人") #ruby("형|사","刑|事")와 #ruby("고|등|정|탐","高|等|偵|探")까지도 그 #ruby("양|심","良|心")에 #ruby("애|국|심","愛|國|心")이 조금이나마 남아 있는 것이 아닌가.]
#zh[别人不用说，连我的弟子、当了刑事的金弘植，和曾经同在学校任职的元仁常等，都没有告密。这么看来，各处的韩人刑事和高等侦探，良心里岂不是还留着一点爱国心。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("사|회","社|會")에서 나를 이같이 #ruby("동|정","同|情")해 주었으니 나로서는 #ruby("최|후","最|後")의 한 숨까지 #ruby("동|지","同|志")를 #ruby("위","爲")하여 #ruby("분|투","奮|鬪")하고 #ruby("원|수","怨|讐")의 #ruby("요|구","要|求")에 #ruby("응","應")하지 않으리라 #ruby("결|심","決|心")하였다. 그리고 #ruby("김|홍|량","金|鴻|亮")은 여러 가지로 #ruby("활|동","活|動")할 #ruby("능|력","能|力")과 #ruby("품|격","品|格")이 나보다 나으니, #ruby("신|문","訊|問") 받을 때 이롭도록 말을 하여 그를 풀어주게 하리라. 그렇게 생각하여 “#ruby[거북이][龜]는 진흙 속에 빠지리니 #ruby[기러기][鴻]는 #ruby("해|외","海|外")로 날으라”#footnote(numbering: _ => [55)])[#h(0.35em)여기서 #ruby[거북][龜]은 #ruby("김|구","金|龜")를, #ruby[기러기][鴻]는 #ruby("김|홍|량","金|鴻|亮")을 #ruby("비|유","比|喩")한 것.]라는 #ruby("구","句")를 혼자 읊었다.]
#zh[社会这样同情我，我决心直到最后一口气都为同志奋斗，不答应仇敌的要求。金鸿亮在各方面的活动能力和品格都比我强，审问时我说有利于他的话，好放他出去。这样想着，独自吟道：“乌龟将陷进泥里，大雁飞向海外。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[일곱 #ruby("번","番") #ruby("신|문","訊|問")에서 #ruby("와타나베","渡邊") 놈만 #ruby("혹|형","酷|刑")을 가하지 않았고, 여섯 #ruby("번","番")은 #ruby("매|번","每|番") #ruby("정|신","精|神")을 잃은 #ruby("후","後")에야 #ruby("유|치|장","留|置|場")에 끌려왔다. 끌려올 때 #ruby("각","各") #ruby("방","房") #ruby("동|지","同|志")들의 #ruby("정|신","精|神")을 북돋아 주기 #ruby("위","爲")하여 “나의 #ruby("생|명","生|命")은 빼앗을 수 있거니와 내 #ruby("정|신","精|神")은 빼앗지 못하리라” 말하면, #ruby("왜","倭")놈들은 “나쁜 말이 해소데 타타쿠”#footnote(numbering: _ => [56)])[#h(0.35em)우리말과 #ruby("일|본","日|本")말이 #ruby("혼|합","混|合")된 #ruby("문|장","文|章"). 타타쿠(たたく)는 ‘때리다’라는 뜻. #ruby("즉","卽") 위 #ruby("문|장","文|章")은 ‘나쁜 말을 했지. 때려줄 거야’라는 #ruby("의|미","意|味")이다.]라고 #ruby("위|협","威|脅")하였지만 내 말을 들은 #ruby("동|지","同|志")들은 #ruby("견|고","堅|固")한 마음을 가지는 것이었다.]
#zh[我受审了七次，除了渡边的审问外，其他几次都被严刑拷打得死去活来，但受刑后每次回到拘留所时，我都大声疾呼：]
#zh[“你们可以剥夺我的生命，但是无法夺去我的精神。”]
#zh[这是为了鼓舞同志们的士气。倭寇听了我的呼喊，以威胁的口吻说：]
#zh[“你再敢胡言乱语就打死你。”但我深信，同志们会从我的话中得到鼓励。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[여덟#ruby("번","番")째 #ruby("신|문","訊|問")에는 #ruby("각","各") #ruby("과|장","課|長")과 #ruby("주|임","主|任") #ruby("경|시","警|視") 7, 8#ruby("명","名")이 나란히 앉아 #ruby("위|협","威|脅")했다.]
#zh[在第八次审问中有各科科长与主任警官七八人列席。这些家伙对我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너의 #ruby("동|류","同|類")가 #ruby("대|부|분","大|部|分") #ruby("자|백","自|白")하였거늘 너 한 놈이 #ruby("자|백","自|白")을 않으니 #ruby("심","甚")히 어리석고 #ruby("완|고","頑|固")하다. #ruby("토|지","土|地")를 사들인 #ruby("지|주","地|主")가 논밭의 뭉우리돌을 골라내는 것은 #ruby("당|연","當|然")한 일 아니냐? 네가 아무리 입을 다물고 혀를 묶어 한마디도 #ruby("발|설","發|說")하지 않으려 하지만, 여러 놈의 입에서 네 #ruby("죄","罪")가 #ruby("발|각","發|覺")되었으니, #ruby("지|금","只|今") #ruby("당|장","當|場") 말하지 않으면 이 자리에서 때려죽이리라.”]
#zh[“你的同伙都已经招供了，唯独你不肯认罪，你是何等的愚蠢和顽固啊！虽然你守口如瓶，但是别人吐了实话，你的罪状能够隐瞒得了吗？你再仔细想一想，一位新买进田地的地主，会将多余无用的石头子儿留在地里，而不捡出来吗？所以你要明白，只要坦白交待，就可以无罪开释。如果你还是这样固执，就当场打死你。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나를 논밭의 자갈돌로 알고 파내려는 그대들의 #ruby("노|고","勞|苦")보다, 파내어지는 나의 #ruby("고|통","苦|痛")이 더욱 #ruby("심","甚")하니 내가 #ruby("자|결","自|決")하는 것을 보라!”]
#zh[听了这些话后，我说：]
#zh[“好啊！如果你们真是把我当成新买来的田地里的石头子儿，那就说对了。我被你们当石头挖出来的痛苦岂是你们把我挖出来的辛苦所可比拟，既然如此，那么你们看着，不必借用你们的手，我自己死给你们看吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 머리를 기둥에 들이받고 #ruby("정|신","精|神")을 잃고 쓰러졌다. 여러 놈들이 #ruby("인|공|호|흡","人|工|呼|吸")을 하고 얼굴에 #ruby("냉|수","冷|水")를 끼얹어서 #ruby("정|신","精|神")이 돌아왔다.]
#zh[说完这话，我用头猛撞身旁的柱子，随即失去了知觉。]
#zh[几个家伙连忙对我进行人工呼吸，再以冷水泼在我脸上，其中有一个家伙假惺惺地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한 놈이 능청스럽게 #ruby("부|탁","付|託")한다.]
#zh[一个家伙油腔滑调地请求。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")는 #ruby("조|선|인","朝|鮮|人") #ruby("중","中")에서 #ruby("신|앙","信|仰")을 받는 #ruby("인|물","人|物")인데, 이같이 #ruby("대|우","待|遇")를 하는 것이 #ruby("적|당","適|當")하지 않으니 저에게 #ruby("위|임","委|任")하여 #ruby("신|문","訊|問")하게 하옵소서.”]
#zh[“金龟是朝鲜人中间受信仰的人物，这样对待不妥当。请交给卑职来审问。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그는 #ruby("즉|시","卽|時") #ruby("승|낙","承|諾")을 얻어가지고 나를 #ruby("자|기","自|己") #ruby("방","房")에 데리고 가서 #ruby("특|별","特|別") #ruby("대|우","待|遇")를 했다. 담배도 주고 말도 #ruby("존|대","尊|待")하며, #ruby("자|기","自|己")가 #ruby("황|해|도","黃|海|道")에 #ruby("출|장","出|張") 가서 #ruby("김|구","金|龜")의 온갖 #ruby("행|동","行|動")을 #ruby("일|일","一|一")이 #ruby("조|사","調|査")하여 보니, #ruby("교|육|사|업","敎|育|事|業")에 #ruby("열|성","熱|誠")인 것은 #ruby("학|교","學|校")에서 #ruby("월|급","月|給")을 받든 못 받든 #ruby("교|무","校|務")를 한결같이 보아온 것으로 알 수 있다는 둥, #ruby("일|반","一|般") #ruby("인|민","人|民")의 #ruby("여|론","輿|論")을 들어보아도 #ruby("정|직","正|直")한 사람인데 #ruby("총|감|부","總|監|府")에 와서 #ruby("김|구","金|龜")의 #ruby("신|분","身|分")을 모르는 사람들에게 #ruby("고|문","拷|問")도 많이 당한 #ruby("모|양","模|樣")이니 매우 #ruby("유|감","遺|憾")이라는 둥, #ruby("신|문","訊|問")도 #ruby("순","順")하게 하여야 #ruby("사|실","事|實")을 말하는 사람이 있고 #ruby("고|문","拷|問")해야 할 사람이 따로 있는데 #ruby("김|구","金|龜")에게는 #ruby("실|례","失|禮")가 많았다는 둥 하며, 능청스럽게 말을 한다.]
#zh[他得到允许，把我带到他的房间里，拿出香烟给我抽，讲话也比较客气，可以说给了我以特殊的待遇；他还说他曾出差到黄海道，调查了有关我的资料，知道我对教育很热心，不管有没有薪俸，仍然对教育那么热心，真是可佩。同时一般的舆论，亦都称道我是一个正直的人，但是警务总监部却不太清楚我的身份，因此使我受了很多酷刑，感到非常遗憾；接着又说，其实对于审问的对象，也应该看清楚是怎样的人，进行适当的处理，因此像我这样的人士，那样对待是非常失礼的。他能讲出这样的话，其脸皮之厚可想而知。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈이 #ruby("신|문","訊|問")하는 #ruby("방|법","方|法")에는 #ruby("대|략","大|略") 세 가지 #ruby("수|단","手|段")이 있다.]
#zh[倭寇审问的方法，大致有三种手段。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째, #ruby("가|혹","苛|酷")한 #ruby("고|문","酷|刑")이다. 채찍과 몽둥이로 #ruby("난|타","亂|打")하는 것, 두 손을 등 뒤에 포개고 오랏줄로 #ruby("결|박","結|縛")하여 #ruby("천|장","天|障")의 쇠고리에 끌어올리고서, #ruby("심|문","訊|問")받는 자를 둥근 걸상 위에 세웠다가 오랏줄 한 끝을 한편에 잡아매고 발#ruby("판","板")을 뽑아버리면 온몸이 #ruby("공|중","空|中")에 매달려 #ruby("질|식","窒|息")하게 되는데, #ruby("그|후","其|後") #ruby("결|박","結|縛")을 풀고 #ruby("냉|수","冷|水")를 온몸에 끼얹어 숨이 돌아오게 하는 것, #ruby("화|로","火|爐")에 쇠막대기를 #ruby("즐|비","櫛|比")하게 늘어놓아 벌겋게 달군 #ruby("후","後") 그 쇠막대기로 온몸을 함부로 지지는 것, 손가락 크기의 #ruby("능|목","菱|木")#footnote(numbering: _ => [57)])[#h(0.35em)마름모꼴의 나무.] 세 #ruby("개","個")를 세 손가락 사이에 끼우고 나무 #ruby("양","兩")끝을 노끈으로 동여매는 것, 거꾸로 매단 #ruby("후","後") 콧구멍에 #ruby("냉|수","冷|水")를 부어넣는 것 #ruby("등","等")이 그것이다.]
#zh[第一是残酷的拷问。用鞭子和棍子痛打；把两手叠在背后，用绳索捆了，拉上天花板的铁环，让受审的人先站在圆凳上，把绳的一头拴在一边，抽掉踏脚，全身便悬在空中，窒息过去，然后解开捆绑，把冷水泼遍全身，让他苏醒；火炉上排满铁条，烧得通红，拿来乱烙全身；把三根手指粗的菱木夹进三个指缝，用绳子勒紧木头两头；倒吊起来，往鼻孔里灌冷水。诸如此类。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[둘째, 굶기는 것이다. #ruby("신|문","訊|問")할 때 #ruby("음|식","飮|食")을 #ruby("보|통","普|通") #ruby("수|인","囚|人")의 #ruby("반","半")으로 줄여 #ruby("생|명","生|命")만 #ruby("유|지","維|持")하게 해놓고, #ruby("친|척","親|戚")이 #ruby("사|식","私|食")을 #ruby("청|원","請|願")하여도 #ruby("신|문","訊|問") #ruby("주|임","主|任")의 #ruby("허|가","許|可")를 얻지 못하면 도로 내보낸다. #ruby("신|문","訊|問") #ruby("주|임","主|任") 되는 놈은, #ruby("사|실","事|實") #ruby("유|무","有|無")는 #ruby("관|계","關|係")치 않고 거짓말이라도 #ruby("왜","倭")놈들이 좋아할 만한 말을 하는 #ruby("수|인","囚|人")에게는 #ruby("사|식","私|食")을 #ruby("허|락","許|諾")하고, #ruby("반|항|성","反|抗|性")이 있어 보이면 #ruby("절|대","絶|對")로 #ruby("허|가","許|可")하지 않는다. 그래서 #ruby("유|치|장","留|置|場")에서는 #ruby("자|연","自|然")히 #ruby("사|식","私|食")을 받아먹는 #ruby("자","者")는 #ruby("강|경","强|硬")치 못해 보이게 된다.]
#zh[然而比酷刑更难以忍受的是饥饿的惩罚。审讯时减少饭量到仅仅不致饿死的程度。]
#zh[若亲属送饭，也要得到审讯主任的批准。他们可以不顾事实，只要你的供词中他们的意，哪怕是对他人不利的假供，他也可以批准送饭，如稍有反抗，则不批准。因此在拘留所里能吃到私送的饭食的人，其态度自然也不会强硬。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그밖에 한 가지가 #ruby("온|화","溫|和")한 #ruby("수|단","手|段")이다. 좋은 #ruby("음|식","飮|食")도 #ruby("대|접","待|接")하고 훌륭히 #ruby("장|식","裝|飾")한 #ruby("아카시","明石")#footnote(numbering: _ => [58)])[#h(0.35em)#ruby("원|주","原|註"): “當時 總監部 總長”. #ruby("아카시","明石元二郞")는 #ruby("내|정|간|섭","內|政|干|涉")과 쿠데타 #ruby("공|작","工|作")의 #ruby("전|문|가","專|門|家"). #ruby("당|시","當|時") #ruby("경|무|총|감","警|務|總|監")으로 #ruby("데라우치","寺內") #ruby("총|독","總|督") #ruby("암|살|모|의","暗|殺|謀|議") #ruby("사|건","事|件")을 #ruby("조|작","造|作")하여 #ruby("애|국","愛|國") #ruby("인|사","人|士")들을 #ruby("체|포","逮|捕")·#ruby("고|문","拷|問")한 #ruby("장|본|인","張|本|人")이다.]의 #ruby("방","房")으로 데려가 #ruby("극|진","極|盡")히 #ruby("공|경","恭|敬")하며 점잖게 #ruby("대|우","待|遇")하는 바람에, #ruby("가|혹","苛|酷")한 #ruby("고|문","拷|問")을 참아낸 #ruby("자","者")도 그 자리에서 #ruby("실|토","實|吐")한 사람이 더러 있다.]
#zh[再有就是采取温和的手段。他们以佳肴款待，把你带到明石（当时的总监部总长）的装饰豪华的房间里，给予各种优待，有的人能经受得住酷刑，但在这种场合下却招了供。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("신|체","身|體") #ruby("고|문","體|刑")에는 한두 #ruby("번","番") 참아보았고, 저놈이 #ruby("발|악","發|惡")을 하면 나도 #ruby("감|정","感|情")이 #ruby("발","發")하여 #ruby("자|연","自|然") #ruby("저|항|력","抵|抗|力")이 생기므로 #ruby("인|내","忍|耐")하였지만, 둘째와 셋째를 당하여 참아내기는 #ruby("지|극","至|極")히 어려웠다. 두#ruby("번","番")째는 굶주림이니, 처음엔 밥이라야 껍질 #ruby("절|반","折|半") 모래 #ruby("절|반","折|半")에 #ruby("반|찬","飯|饌")은 소금이나 쓴 장아찌 꽁댕이를 주는데, #ruby("구|미","口|味")가 없어서 안 먹고 도로 보내기도 하였다. #ruby("그|후","其|後")에는 죽도록 맞은 날이 아니면 그런 밥이라도 기다려서 달게 먹는다. 그때까지 #ruby("근","近") 석 달 동안 아내는 #ruby("매|일","每|日") 아침저녁으로 밥을 가지고 #ruby("유|치|장","留|置|場") 앞에 와서 말소리가 들리도록 목소리를 높여,]
#zh[我经历过体刑。那些家伙发狂，我也冲动起来，产生了抵抗力，因此能经受得住。但是第二种第三种手段却令人难以忍受。开始他们给你的饭食是混有一半麸皮的大麦饭和苦涩的咸菜疙瘩，简直难以下咽，有时吃不下就退回去了。过了几天如果没有再受酷刑，就有些食欲，哪怕还是那种饭食，也会吃得津津有味。这三个月仁儿的母亲每天一早一晚都来到拘留所送饭，她在门前高喊：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")의 밥을 가지고 왔으니 들여주시오.”]
#zh[“给金龟送饭来了，请给递进去吧！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[한다. 그러면 #ruby("왜","倭")놈이,]
#zh[可是日本鬼子却说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“김가메#footnote(numbering: _ => [59)])[#h(0.35em)가메는 #ruby[거북][龜]의 #ruby("일|본|식","日|本|式") #ruby("발|음","發|音").] 나쁜 말이 했소데. #ruby("사|식","私|食")이레 일이 없소다.”]
#zh[“金龟大大的不好，这里不准送饭。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("매|번","每|番") 돌려보낸다.]
#zh[每次都把她打发回去了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("신|체","身|體")가 더욱 말이 아니었다. 그놈들이 달아매고 때릴 때는, #ruby("박|태|보","朴|泰|輔")가 보습 단근질 당할 때에 “이 쇠가 식었으니 다시 달구어 오라”고 한 #ruby("구|절","句|節")을 #ruby("암|송","暗|誦")하였다. 겨울철이라 그리하는지 겉옷만 벗기고 #ruby("양|직","洋|織") 속옷은 입힌 채로 #ruby("결|박","結|縛")하고 때릴 때,]
#zh[我的身体更不成样子了。他们吊起来打的时候，我默诵朴泰辅受烙刑时说的那句：“这铁凉了，再烧热了拿来。”也许因为是冬天，只脱掉外衣，穿着洋布内衣捆起来打。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“속옷을 입어서 아프지 않으니 속옷을 다 벗고 맞겠다.”]
#zh[“穿着内衣不痛，把内衣全脱掉再打。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[며 #ruby("매|번","每|番") 알몸으로 매를 받아서, 살이 벗겨질 뿐 아니라 #ruby("온|전","穩|全")한 살가죽이라곤 없었다.]
#zh[我这样说，每次赤身受杖，不但皮开肉绽，没有一块完整的皮肉。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런 때 다른 사람들이 #ruby("문|전","門|前")에서 #ruby("사|식","私|食")을 먹으면, 고깃국과 김치 냄새가 코에 들어와서 미칠 듯이 먹고 싶어진다. #ruby("매|일","每|日") 아침저녁으로 #ruby("음|식","飮|食") 냄새가 코에 들어올 때마다, 나도 남에게 #ruby("해","害")가 될 말이라도 하고서 가져오는 밥이나 다 받아 먹을까, 또한 아내가 나이 젊으니 몸이라도 팔아서 좋은 #ruby("음|식","飮|食")이나 늘 하여다 주면 좋겠다 하는 더러운 생각이 난다.]
#zh[这时候别人在门前吃私送的饭，肉汤和泡菜的气味钻进鼻子，馋得要发疯。每天早晚一闻到饭味，就起脏念头：哪怕说些害人的话，把送来的饭全接过来吃了吧；妻子年纪还轻，哪怕卖身，常送些好饭来才好。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("박|영|효","朴|泳|孝")의 #ruby("부|친","父|親")#footnote(numbering: _ => [60)])[#h(0.35em)#ruby[박|원|양][朴|元|陽]\(1804〜1884). #ruby("갑|신|정|변","甲|申|政|變")이 #ruby("실|패","失|敗")하고 난 뒤 그는 아들의 #ruby("죄","罪")에 #ruby("연|루","連|累")되어 #ruby("직|위","職|位")를 #ruby("박|탈","剝|奪")당하고 #ruby("감|옥","監|獄")에서 죽었다.]이 #ruby("옥","獄")에서 섬거적을 뜯어먹다가 죽었다는 말, #ruby("소|무","蘇|武")가 #ruby("전|모","氈|毛")를 씹으며 19#ruby("년","年") 동안 #ruby("한","漢")나라에 대한 #ruby("절|의","節|義")를 지켰다#footnote(numbering: _ => [61)])[#h(0.35em)#ruby("소|무","蘇|武")는 #ruby("중|국","中|國") #ruby("전|한","前|漢")의 #ruby("명|신","名|臣")으로, #ruby("무|제","武|帝") 때 #ruby("사|신","使|臣")으로서 #ruby("흉|노","匈|奴")에 갔다가 그곳에 19#ruby("년|간","年|間") #ruby("유|폐","幽|閉")되었다. 그는 #ruby("극|심","極|甚")한 굶주림으로 옷의 #ruby("솜|털","氈|毛")과 들쥐·풀씨 #ruby("등","等")으로 #ruby("연|명","延|命")하다 끝내 살아 #ruby("귀|국","歸|國")하였다. #ruby("한","漢")의 #ruby("소|제","昭|帝")는 그의 #ruby("절|개","節|槪")를 기리어 벼슬을 내렸고, #ruby("후|세","後|世") 사람들은 그와 같은 #ruby("절|개","節|槪")를 #ruby("특|별","特|別")히 #ruby("소|무|절","蘇|武|節")이라 한다.]는 글과, #ruby("전","前")날에 알몸으로 #ruby("고|초","苦|楚")를 받던 일을 생각했다. “나의 #ruby("육|체","肉|體")를 욕보일 수 있을지언정 나의 #ruby("정|신","精|神")은 뺏을 수 없다”고 같이 #ruby("수|감","收|監")된 #ruby("동|지","同|志")들에게 #ruby("주|창","主|唱")하던 #ruby("기|개","氣|槪")와 #ruby("절|개","節|槪")를 생각하면서, 이러다가 #ruby("인|간","人|間")의 #ruby("본|성","本|性")은 사라져 없어지고 짐승의 #ruby("본|능","本|能")만 남는 것이 아닐까 #ruby("자|책","自|責")하던 때, #ruby("아카시","明石")의 #ruby("방","房")에서 나를 #ruby("극|진","極|盡")히 #ruby("우|대","優|待")를 하면서 #ruby("신|문","訊|問")한 것이었다.]
#zh[这时我想起朴泳孝①的父亲，在狱中啮着草席而死；古时苏武，渴饮雪，饥吞毡，为汉朝守了十九年的节操，又回想起自己赤身挨揍的痛楚，为鼓舞同志们的士气而呼喊生命可夺而精神不可丢的气概。不禁自责人性由于饥饿而泯灭，剩下的只是兽性。]
#zh[译注：①朴泳孝（一八六一—一九三九），近代开化派重要人物，后沦为亲日派。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그놈의 #ruby("요|령","要|領")으로 보면 #ruby("신|부|민","新|附|民")의 #ruby("자|격","資|格")만 #ruby("표|시","表|示")하면#footnote(numbering: _ => [62)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “그놈의 #ruby("요|령","要|領")으로 보면, #ruby("식|민","植|民") #ruby("백|성","百|姓")이라 #ruby("인|정","認|定")하기만 하면”.] #ruby("즉|각","卽|刻") #ruby("총|독","總|督")에게 #ruby("보|고","報|告")하여 이와 같은 #ruby("고|통","苦|痛")도 #ruby("면","免")하게 할 뿐 아니라, #ruby("순","純") #ruby("일|본|인","日|本|人")만으로 #ruby("조|선","朝|鮮")을 #ruby("통|치","統|治")하는 것이 아니라 #ruby("덕|망","德|望")이 있는 #ruby("조|선|인","朝|鮮|人")을 #ruby("정|치","政|治")에 #ruby("참|여","參|與")시키려 하기 때문에 #ruby("당|신","當|身")같이 #ruby("충|후","忠|厚")한 사람이 #ruby("정|세","情|勢")의 #ruby("추|이","推|移")를 모르지 않을 터인즉 #ruby("순|응","順|應")함이 어떠하냐 하면서, #ruby("안|명|근","安|明|根") #ruby("사|건","事|件")과 #ruby("서|간|도","西|間|島") #ruby("사|건","事|件")을 #ruby("실|토","實|吐")하라 했다. 나의 #ruby("대|답","對|答")은, #ruby("당|신","當|身")이 나의 #ruby("충|후","忠|厚")를 #ruby("인|정","認|定")한다면 내가 #ruby("진|술","陳|述")한 것을 #ruby("인|정","認|定")하라는 것이었다. 그놈은 아주 점잖고 #ruby("예|의","禮|儀") 있는 모습이었지만 나의 말에 좋지 않은 #ruby("기|색","氣|色")을 보이면서 돌려보냈다.]
#zh[正在自我谴责良心时，他们把我叫到明石元二郎的房间里，尽量优待我，明石还劝诱我说，我只要当顺民，向日本表示忠诚，他们立刻可以向总督请求释放我；还说日本统治朝鲜，并非只用日本人，同时也要用德高望重的朝鲜人士来治理国家，像我这样忠厚的长者，不应为时代潮流所吞没，而应以顺应为上，识时务者为俊杰。要我把安明根事件和西间岛事件从实招来。]
#zh[于是我对明石说：“如果你认为我是忠厚老实人，就应该相信我从头到尾的供述。”这个家伙听了表面上装着满不在乎的样子，但脸色确实很难看，他们终于又把我送回牢房。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 오늘 처음에는 당장 쳐죽인다고 #ruby("발|악","發|惡")하던 끝에 이놈에게 끌려왔는데, 이놈은 #ruby("구니토모","國友") #ruby("경|시","警|視")#footnote(numbering: _ => [63)])[#h(0.35em)#ruby("일|제","日|帝") 때 #ruby("지|금","只|今")의 #ruby("총|경","總|警")에 #ruby("해|당","該|當")하는 #ruby("경|찰|관","警|察|官") #ruby("직|위","職|位").]였다.]
#zh[过了几天，我又被叫出去了，开始说要打死我，后来又被拉到另外一个家伙的房间里。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("이|전","以|前")에 #ruby("대|만|인","台|灣|人") #ruby("범|죄|자","犯|罪|者") 한 #ruby("명","名")을 맡아 #ruby("신|문","訊|問")하였는데, #ruby("지|금","只|今")의 #ruby("김|구","金|龜")와 같이 #ruby("고|집","固|執")하다가 ‘#ruby("검|사|국","檢|事|局")에 가서 #ruby("일|체","一|體")를 #ruby("자|백","自|白")하였노라’는 #ruby("편|지","便|紙")를 받았다. #ruby("김|구","金|龜")도 이제는 #ruby("검|사|국","檢|事|局")으로 넘어갈 터이니, 거기 가서 #ruby("사|실","事|實")을 말하면 더욱 #ruby("검|사","檢|事")의 #ruby("동|정","同|情")을 받을 수 있을 것이다.”]
#zh[“我以前负责审问过一名台湾犯人，他像现在的金龟一样固执，后来我收到信，说‘到了检事局，一切都招了’。金龟现在也要转到检事局，到了那里说出事实，更能得到检事的同情。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그는 #ruby("전|화","電|話")로 국수 장국밥에 고기를 많이 가져오라고 하여, 내 앞에 놓고 먹기를 #ruby("청","請")했다. 나는 말했다.]
#zh[他打电话，叫多带肉的面条汤饭来，摆在我面前请我吃。我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신이 나를 #ruby("무|죄","無|罪")로 #ruby("인|정","認|定")한다면 음식을 먹지만, #ruby("유|죄","有|罪")라 하면 먹지 않을 것이다.”]
#zh[“你若认定我无罪，我就吃；若说有罪，我就不吃。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")는 #ruby("한|문|병|자","漢|文|病|者")#footnote(numbering: _ => [64)])[#h(0.35em)#ruby("자|세","仔|細")한 #ruby("의|미","意|味")는 알 수 없지만, 아마도 #ruby("백|범","白|凡")이 #ruby("일|어","日|語")를 배우지 않아 #ruby("한|문","漢|文")으로 #ruby("문|답","問|答")한 데서 나온 #ruby("표|현","表|現")이라 생각된다.]이다. #ruby("김|구","金|龜")는 지금껏 나에게 #ruby("동|정","同|情")을 아니하였으나, 나는 #ruby("자|연","自|然") #ruby("동|정","同|情")할 마음이 생겨서 변변치 못하나 #ruby("대|접","待|接")하는 것이니 식기 #ruby("전","前")에 먹으라.”]
#zh[这个家伙又说：]
#zh[“金先生是汉文学者，你虽然不同情我，但我是自然而然地同情你，尽管这是家常便饭，也表示我的一番诚意，趁面还没凉，快请用吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 한결같이 #ruby("사|양","辭|讓")하였다. #ruby("구니토모","國友")는 웃으면서 #ruby("한|자","漢|字")로 ‘#ruby("군|의|치|독|부","君|疑|置|毒|否")’#footnote(numbering: _ => [65)])[#h(0.35em)‘그대는 #ruby("독","毒")을 넣지나 않았을까 #ruby("의|심","疑|心")하는가?’라는 뜻.] 다섯 #ruby("자","字")를 써 보이고, 이제부터는 #ruby("사|식","私|食") 들이는 것을 #ruby("허|락","許|諾")하며 #ruby("신|문","訊|問")도 #ruby("종|결","終|結")되었다고 한다. 나는 “#ruby("독","毒")을 넣었는가 #ruby("의|심","疑|心")한 것은 아니다” 하고 먹고 돌아오니 저녁부터 #ruby("사|식","私|食")이 들어왔다.]
#zh[我仍固辞，于是国友带着笑容，用汉字写了“君疑置毒乎”五个字，又说现在审问也结束了，今天开始准许家人送饭。我说并非疑心有毒，于是吃完了那碗汤面，回到了我的房间。第二天开始就允许送饭。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[같은 #ruby("방","房")에 있는 #ruby("이|종|록","李|宗|錄")은 나이가 적은 #ruby("청|년","靑|年")이었다. #ruby("친|척","親|戚") 가운데 따라온 사람이 없으므로 #ruby("사|식","私|食")을 가져다 줄 사람도 없었다. #ruby("방","房")안에서 먹으면 나누어 먹게 하겠으나, #ruby("사|식","私|食")은 반드시 #ruby("방","房") 밖에서 따로 먹게 했는데, #ruby("종|록","宗|錄")이 먹고 싶어하는 #ruby("형|상","形|狀")은 차마 볼 수가 없었다. 나는 #ruby("방","房") 밖에서 밥을 먹다가, 고기 한 덩이와 밥 한 덩이를 입에 물고 #ruby("방","房")안에 들어와서 입 안에서 도로 꺼내 먹여, 마치 어미새가 새끼에게 물어 먹이듯 했다.]
#zh[和我同房间的是一个名叫李宗录的青年，他此地没有一个亲戚，自然也就无人送饭，如果能在房间里吃，也可以分一点给他，但是规定送来的饭必须在房外吃，我不忍看他贪馋的惨状，只好口里塞满了饭菜，回到房里，像母鸟喂雏鸟似的，从我口里喂到他的口里。]
#heading(level: 3)[#text(font: "KOPUSGo B")[7) #ruby("기|약","期|約")없는 15#ruby("년|형","年|刑")]]
#zh[被判十七年徒刑]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 나는 #ruby("종|로|구|치|감","鍾|路|拘|置|監")으로 넘어갔다. 비록 #ruby("독|방","獨|房")에 있으나 #ruby("총|감|부","總|監|府")보다는 #ruby("편|리","便|利")하고, 이른바 #ruby("감|옥","監|獄")의 #ruby("식|사","食|事")도 #ruby("분|량","分|量")이 훨씬 많았다.]
#zh[第二天我就被转移到钟路拘留监。这里的房间是单人一间，比起总监部要舒服多了，牢里的饭食，也比总监部多得多。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈이 내 #ruby("신|문","訊|問")에 대해 #ruby("사|실","事|實")대로 #ruby("형","刑")을 매긴다면 #ruby("소|위","所|謂") ‘#ruby("보|안|법","保|安|法") #ruby("위|반","違|反")’으로 #ruby("극|형","極|刑") 2#ruby("년","年")밖에 지울 수 없었다. 그래서 #ruby("소|위","所|謂") #ruby("안|명|근","安|明|根") #ruby("강|도","强|盜") #ruby("사|건","事|件")에다 억지로 얽어 끌어붙일 #ruby("결|심","決|心")인 듯했다. 그런데 내가 #ruby("경|성","京|城") #ruby("양|기|탁","梁|起|鐸") 집에서 #ruby("서|간|도","西|間|島") #ruby("사|건","事|件")을 #ruby("회|의","會|議")하고 #ruby("이|동|녕","李|東|寧")을 #ruby("파|송","派|送")하게 한 날짜가, 곧 #ruby("안|명|근","安|明|根")이 #ruby("안|악","安|岳")에 와서 #ruby("원|행|섭","元|行|燮")·#ruby("박|형|병","朴|亨|秉")·#ruby("고|봉|수","高|鳳|洙")·#ruby("한|정|교","韓|貞|敎") #ruby("등","等")과 #ruby("안|악","安|岳") #ruby("부|호","富|豪")를 #ruby("습|격","襲|擊")하자고 #ruby("회|의","會|議")했다는 날이었다. 그때 #ruby("안|악","安|岳")에 있었던 #ruby("김|홍|량","金|鴻|亮")·#ruby("김|용|제","金|庸|濟")·#ruby("도|인|권","都|仁|權")·#ruby("양|성|진","楊|成|鎭")·#ruby("장|윤|근","張|允|根") #ruby("등","等")은 #ruby("안|명|근","安|明|根")의 #ruby("종|범","從|犯")으로 쉽게 꾸몄지만, 나에게는 그날 #ruby("경|성","京|城")에 있었다는 #ruby("확|실","確|實")한 #ruby("증|거","證|據")가 있었다.]
#zh[我的案件，照事实来处理的话，只是违反保安法而已，处重刑顶多也不过是两年有期徒刑，但他们总是硬要把我拉进安明根的强盗案件里去。]
#zh[我有确凿的证据可以证明我与安明根案件无关：我在汉城梁起铎家里开会主张派李东宁移民到西间岛的当日，正是安明根到安岳和元行燮、朴亨秉、高凤洙、韩贞教等一起开会商量袭击富豪的日子。当时在安岳的金鸿亮、金庸济、都寅权、杨星镇、张允根等当然成了安明根的从犯，但我因在汉城，绝对无法参加安岳的会议。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리하여 #ruby("안|악","安|岳")에 #ruby("안|명|근","安|明|根")이 와서 만난 날짜만 이십몇 #ruby("일","日")이라 #ruby("기|입","記|入")하고, #ruby("경|성|회|의","京|城|會|議") 날짜는 #ruby("모|월","某|月") #ruby("중|순","中|旬")#footnote(numbering: _ => [66)])[#h(0.35em)#ruby("판|결|문","判|決|文")에는 1910#ruby("년","年") 12#ruby("월","月") #ruby("중|순","中|旬")으로 #ruby("기|록","記|錄")돼 있다.]에 #ruby("양|기|탁","梁|起|鐸") 집에서 #ruby("서|간|도","西|間|島")에 대한 #ruby("사|실","事|實")을 #ruby("회|의","會|議")하였다고 어름어름 #ruby("기|입","記|入")하였다. 그리고 내가 그날 #ruby("안|악","安|岳")에서 #ruby("회|의","會|議")에 #ruby("참|석","參|席")한 것을 #ruby("목|격","目|擊")하였다는 #ruby("증|인","證|人")으로 #ruby("양|산|학|교","楊|山|學|校") #ruby[교지기][校直] 아들인 14#ruby("세","歲")짜리 #ruby("이|원|형","李|元|亨") #ruby("학|생","學|生")을 잡아 올렸다.]
#zh[虽则如此，他们胁迫安岳杨山学校某门卫的十四岁的儿子李元亨作伪证，说亲眼看到我曾参加安岳的会议，企图把我牵连到安明根的强盗事件里去。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 이른바 #ruby("검|사","檢|事") #ruby("신|문","訊|問")을 당할 때에 #ruby("벽","壁") 너머 #ruby("신|문|실","訊|問|室")에서 #ruby("이|원|형","李|元|亨")의 말소리가 들렸다. #ruby("왜","倭")놈이 #ruby("원|형","元|亨")에게 물었다.]
#zh[我清清楚楚地听到我的证人李元亨在邻房受审的声音。]
#zh[鬼子问李元亨：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("안|명|근","安|明|根")이 #ruby("양|산|학|교","楊|山|學|校")에 왔을 때, #ruby("김|구","金|龜")도 그 자리에 있었지?”]
#zh[“你看到安明根和金龟一起参加了那个会议吧！”]
#zh[元亨回答说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("안|명|근","安|明|根")이 누구인지도 모르고, #ruby("김|구","金|龜") #ruby("선|생","先|生")님은 어디 가고 그날 없었습니다.”]
#zh[“我根本不认识安明根，金先生也不知去了哪儿，根本没有参加那个会。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈들은 죽일 것같이 #ruby("협|박","脅|迫")하고, #ruby("조|선|인","朝|鮮|人") #ruby("순|사","巡|査")놈은 #ruby("원|형","元|亨")을 달랬다.]
#zh[日本鬼子大声呵斥，威胁说要杀死他，一旁的韩籍警察则劝诱说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이 미련한 놈아. #ruby("안|명|근","安|明|根")이도, #ruby("김|구","金|龜")도 같이 앉아 있는 것을 보았다고 #ruby("대|답","對|答")만 하면, 네가 #ruby("지|금","只|今")이라도 아버지를 따라 집에 가도록 해줄 터이니 시키는 대로 말을 하여라.”]
#zh[“你这笨蛋，只要说你亲眼看见安明根和金龟在一起，马上就可以跟你父亲回家，你还是照我们的话回答的好。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 그렇게 말하리다. 때리지 마셔요.”]
#zh[一听到这话，元亨说：]
#zh[“那就按你们的意思说吧，别再打我了。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("원|형","元|亨")이 #ruby("대|답","對|答")한다. #ruby("검|사","檢|事")놈이 나를 #ruby("신|문","訊|問")하다가 #ruby("초|인|종","招|人|鐘")을 울리니, #ruby("원|형","元|亨")을 #ruby("문","門") 안으로 들이세우고 #ruby("원|형","元|亨")에게 물었다.]
#zh[元亨这样回答。检查官审问着我，按了铃，把元亨叫进门里，问他：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("양|산|학|교","楊|山|學|校")에서 #ruby("안|명|근","安|明|根")이 #ruby("김|구","金|龜")와 같이 앉은 것을 네가 보았느냐?”]
#zh[“在杨山学校，你看见安明根和金龟坐在一起了吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예.”]
#zh[“是。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[말이 끝나자마자, #ruby("원|형","元|亨")을 #ruby("문","門") 밖으로 끌고 나갔다. #ruby("검|사","檢|事")놈은 나에게 말했다.]
#zh[话刚说完，就把元亨拖到门外。检查官对我说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 이런 #ruby("증|거","證|據")가 있는데도…….”]
#zh[检察官说：“现在证据确凿……”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“500#ruby("여","餘") #ruby("리","里") 멀리 떨어진 곳에서, 같은 날 같은 #ruby("시|각","時|刻")에, 두 곳 #ruby("회|의","會|議")를 다 #ruby("참|석","參|席")한 #ruby("김|구","金|龜")를 만들려고 매우 #ruby("수|고","受|苦")스럽겠소.”]
#zh[我泰然地回答说：]
#zh[“你们为了让金龟在同一天同一时间里参加相隔五百里的两个地方的两个会议，真是煞费苦心啊！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[말을 마치니, 이것으로 #ruby("예|심","豫|審") #ruby("종|결","終|結")이었다.]
#zh[检察官不理会我的话，马上就宣布“预审结束”。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 우리 #ruby("사|건","事|件") #ruby("외","外")에 #ruby("의|병|장","義|兵|將") #ruby("강|기|동","姜|基|東")이 #ruby("원|산","元|山")에서 #ruby("체|포","逮|捕")되어 #ruby("경|무|총|감|부","警|務|總|監|府")에서 같이 #ruby("취|조","取|調")를 받고 #ruby("소|위","所|謂") #ruby("육|군|법|원","陸|軍|法|院")에서 #ruby("사|형","死|刑")을 받은 #ruby("사|건","事|件")이 있었고, #ruby("김|좌|진","金|佐|鎭")#footnote(numbering: _ => [67)])[#h(0.35em)#ruby[김|좌|진][金|佐|鎭]\(1889〜1930). #ruby("호","號") #ruby("백|야","白|冶"). 그는 1911#ruby("년","年") #ruby("북|간|도","北|間|島")에 #ruby("군|관|학|교","軍|官|學|校")를 #ruby("설|립","設|立")하기 #ruby("위","爲")해 #ruby("자|금","資|金")을 모으다 #ruby("체|포","逮|捕")되어 2#ruby("년","年") 6#ruby("개|월|간","個|月|間") #ruby("투|옥","投|獄")되었다.] #ruby("등","等") 몇 사람이 #ruby("애|국|운|동","愛|國|運|動")을 하다가 #ruby("강|도|죄","强|盜|罪")로 #ruby("징|역","懲|役")을 받고 같이 #ruby("수|감","收|監")되어 함께 #ruby("고|생","苦|生")했다.]
#zh[那时除了我们的案子，义兵将领姜基东在元山被捕，在警务总监部一起受审，所谓陆军法院判了死刑。金佐镇等几个人从事爱国运动，以强盗罪服刑，和我们关在一起，一同吃苦。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|기|동","姜|基|東")은 처음에는 #ruby("의|병","義|兵")에 #ruby("참|가","參|加")하였다가, #ruby("즉|시","卽|時") #ruby("귀|순","歸|順")하여 #ruby("헌|병|보|조|원","憲|兵|補|助|員")이 되어 #ruby("경|성|지|방","京|城|地|方")에서 #ruby("복|무","服|務")했다. 그런데 #ruby("왜","倭")놈들이 #ruby("의|병","義|兵")을 #ruby("총|검|거","總|檢|擧")하여 #ruby("수|십","數|十") #ruby("명","名")을 #ruby("일|시","一|時")에 #ruby("총|살","銃|殺")하기로 #ruby("내|정","內|定")하였는데, 그 #ruby("의|병","義|兵")들은 #ruby("강|기|동","姜|基|東")의 #ruby("전","前") #ruby("동|지","同|志")들이었다. #ruby("강|기|동","姜|基|東")은 #ruby("자|기","自|己") #ruby("수|직|시|간","守|直|時|間")에 #ruby("수|감","收|監")된 #ruby("의|병","義|兵")을 #ruby("전|부","全|部") #ruby("해|방","解|放")하고 #ruby("사|무|소","事|務|所")에 #ruby("비|치","備|置")한 #ruby("총|기","銃|器")를 꺼내어 #ruby("각|기","各|其") #ruby("무|장","武|裝")했다. 그리고 #ruby("야|간","夜|間")에 #ruby("경|계|망","警|戒|網")을 #ruby("돌|파","突|破")하여 #ruby("강|원","江|原")·#ruby("경|기","京|畿")·#ruby("충|청","忠|淸") #ruby("각|지","各|地")에서 #ruby("수|년","數|年") 동안 #ruby("항|일|전|쟁","抗|日|戰|爭")을 #ruby("계|속","繼|續")하였다. 그는 #ruby("후","後")에 #ruby("원|산","元|山")에서 #ruby("안|기|동","安|基|東")으로 #ruby("행|세","行|世")하면서 무슨 일을 #ruby("계|획","計|劃")하다가 #ruby("체|포","逮|捕")되어 #ruby("총|살","銃|殺")을 당하고 말았다.#footnote(numbering: _ => [68)])[#h(0.35em)#ruby[강|기|동][姜|基|東]\(1884〜1911). 그는 #ruby("대|한|제|국","大|韓|帝|國") #ruby("기|병","騎|兵") #ruby("부|위","副|尉")였는데, 1907#ruby("년","年") #ruby("군|대","軍|隊") #ruby("강|제","强|制") #ruby("해|산","解|散") #ruby("후","後") #ruby("해|산|군","解|散|軍")을 #ruby("규|합","糾|合")하여 #ruby("의|병|항|쟁","義|兵|抗|爭")을 하다 #ruby("체|포","逮|捕")되어 #ruby("위|장","僞|裝") #ruby("귀|순","歸|順")하여 #ruby("장|단","長|湍") #ruby("고|랑|포","高|浪|浦") #ruby("헌|병|보|조|원","憲|兵|補|助|員")을 하였다. 그는 #ruby("탈|옥","脫|獄")하여 #ruby("의|병|투|쟁","義|兵|鬪|爭")을 #ruby("계|속","繼|續")하다 1911#ruby("년","年") 2#ruby("월","月") 12#ruby("일","日") #ruby("원|산","元|山") #ruby("오|처|루","吾|妻|樓")에서 #ruby("체|포","逮|捕")되었다.]]
#zh[姜基东起初参加义兵，随即归顺，当了宪兵补助员，在京城地方服务。倭寇预定把义兵一总逮捕，一次枪毙几十名，那些义兵是姜基东从前的同志。姜基东在自己值班的时候，把关着的义兵全部放了，取出事务所里的枪支，各自武装起来，夜里突破警戒网，在江原、京畿、忠清各地继续打了好几年抗日的仗。后来他在元山以安基东的名字活动，计划着什么事，被捕枪毙了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("종|로|감|옥","鍾|路|監|獄")에서 하루는 #ruby("안|악","安|岳") #ruby("군|수","郡|守") #ruby("이","李")아무개가 #ruby("면|회","面|會")를 와서, #ruby("양|산|학|교","楊|山|學|校") #ruby("교|사","校|舍")는 #ruby("원|래","元|來") #ruby("관|청","官|廳")#ruby("건|물","建|物")이니 #ruby("환|부","還|付")하라고 #ruby("강|요","强|要")하고, #ruby("교|구","校|具")와 #ruby("집|물","什|物")도 #ruby("공|립","公|立") #ruby("보|통|학|교","普|通|學|校")에 #ruby("인|도","引|渡")한다는 #ruby("요|구|서","要|求|書")에 #ruby("날|인","捺|印")하라고 #ruby("요|구","要|求")했다. 나는 #ruby("교|사","校|舍")는 #ruby("공|공","公|共")#ruby("건|물","建|物")이니 빼앗아 #ruby("환|수","還|收")하더라도 #ruby("비|품","備|品")과 #ruby("기|구","器|具")는 #ruby("안|신|학|교","安|新|學|校")에 #ruby("기|부","寄|附")하겠다 하였으나, #ruby("결|국","結|局") #ruby("학|교","學|校") #ruby("전|부","全|部")를 #ruby("공|립","公|立") #ruby("보|통|학|교","普|通|學|校")의 #ruby("소|유","所|有")로 #ruby("강|탈","强|奪")해 갔다.]
#zh[有一天，安岳郡守李某，到监狱来看我，他准备把杨山学校的房产和家具，移交给公立普通学校，强行要我签名盖章。我说学校的房产是公家的，要交还给公家也可以，但家具教具是私人财产，愿意赠给私立安新学校，可是最终还是都归了公立普通学校。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("양|산|학|교","楊|山|學|校") #ruby("소|학|생","小|學|生")들은 #ruby("국|가","國|家")에 대한 #ruby("관|념","觀|念")이 #ruby("부|족","不|足")했지만 #ruby("중|학|생","中|學|生")인 #ruby("손|두|환","孫|斗|煥")#footnote(numbering: _ => [69)])[#h(0.35em)#ruby[손|두|환][孫|斗|煥]\(1895〜?). #ruby("황|해|도","黃|海|道") #ruby("은|율","殷|栗") #ruby("출|신","出|身")의 #ruby("독|립|운|동|가","獨|立|運|動|家"). 그는 #ruby("임|시|정|부","臨|時|政|府") #ruby("의|정|원","議|政|院") #ruby("의|원","議|員")을 #ruby("역|임","歷|任")하였고, #ruby("민|족|혁|명|당","民|族|革|命|黨")에서 #ruby("활|동","活|動")하였다. #ruby("해|방","解|放") #ruby("후","後") 그는 #ruby("여|운|형","呂|運|亨")의 #ruby("인|민|당","人|民|黨")·#ruby("근|로|인|민|당","勤|勞|人|民|黨")의 #ruby("중|간|파","中|間|派") #ruby("조|직","組|織")에서 #ruby("주","主")로 #ruby("활|동","活|動")하였고, #ruby("남|북|연|석|회|의","南|北|聯|席|會|議")에도 #ruby("민|족|자|주|연|맹","民|族|自|主|聯|盟") #ruby("대|표","代|表")로 #ruby("참|석","參|席")하였다.]은 남달랐다. 내가 #ruby("장|련|읍","長|連|邑")에서 #ruby("봉|양|학|교","鳳|陽|學|校")#footnote(numbering: _ => [70)])[#h(0.35em)#ruby("원|주","原|註"): “耶敎 設立 後 改稱 進明”. #ruby("예|수|교","耶|蘇|敎")에서 #ruby("설|립","設|立"), #ruby("후","後")에 #ruby("진|명","進|明")으로 #ruby("개|칭","改|稱")하였다.]에 #ruby("근|무","勤|務")할 때 그는 #ruby("초|립","草|笠")둥이였다. 그 #ruby("부|친","父|親") #ruby("손|창|렴","孫|昌|濂")이 늦게 낳은 아들이라 #ruby("애|지|중|지","愛|之|重|之")한 탓에 그 #ruby("부|모","父|母")와 #ruby("어|른","尊|長")은 물론이요, 그 #ruby("군","郡") #ruby("군|수","郡|守")까지도 #ruby("두|환","斗|煥")에게 ‘해라’ 하는 말을 들었다. 어떤 사람이고 #ruby("두|환","斗|煥")에게 높임말을 들어본 사람이 없었다.]
#zh[杨山学校的小学生国家观念不足，中学生孙斗焕却不同。我在长连邑凤阳学校任职时，他还是个戴草笠的孩子。父亲孙昌廉晚年得子，宠爱得不得了，所以父母和长辈不用说，连郡守听斗焕说话也是不用敬语。没有一个人听斗焕说过敬语。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|해","黃|海")·#ruby("평|안","平|安") #ruby("양|도","兩|道")에는 #ruby("특","特")히 #ruby("지|방","地|方") #ruby("풍|습","風|習")에 #ruby("성|년","成|年")이 되기까지 #ruby("부|모","父|母")에게 ‘해라’ 하는 #ruby("습|속","習|俗")이 있으므로, 그 #ruby("천","賤")한 #ruby("풍|습","風|習")을 #ruby("개|량","改|良")하려고 애쓰던 때였다. #ruby("두|환","斗|煥")을 살살 꾀어 #ruby("학|교","學|校")에 #ruby("입|학","入|學")하게 한 #ruby("후","後"), 어느날 #ruby("수|신","修|身") #ruby("시|간","時|間")에 #ruby("학|생","學|生") #ruby("중","中")에 아직 #ruby("부|모","父|母")나 #ruby("연|로","年|老")하신 #ruby("어|른","尊|長")에게 ‘해라’ 하는 이가 있으면 손을 들라 하니, 몇몇 #ruby("거|수","擧|手")하는 #ruby("학|생","學|生") #ruby("중","中")에 #ruby("두|환","斗|煥")이도 있었다. #ruby("수|업","授|業")을 끝내고 #ruby("두|환","斗|煥")을 #ruby("별|실","別|室")로 불러,]
#zh[黄海、平安两道尤其有一种地方风俗，成年以前对父母也可以不用敬语。那时正努力改良这种卑俗。我慢慢哄斗焕进了学校。有一天修身课上，我说学生里还有对父母或年老长辈不用敬语的，举手。举手的几个里也有斗焕。下了课，把斗焕叫到别的房间，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“젖 먹는 어린애는 #ruby("부|모","父|母")나 #ruby("존|장","尊|長")에게 #ruby("경|어","敬|語")를 #ruby("사|용","使|用")하지 못한대도 탓할 수 없으나, 너와 같이 #ruby("어|른","尊|長")된 #ruby("표","標")로 상투 짜고 #ruby("초|립","草|笠") 쓰고서 #ruby("부|모","父|母")와 #ruby("어|른","尊|長")에게 #ruby("공|대","恭|待")할 줄을 모르니, 부끄러운 줄 모르느냐?”]
#zh[“吃奶的幼儿不懂得对父母尊长要用敬语，不能怪他们，你已经结发束髻，戴上了草笠，怎么还不懂得尊敬父母尊长，岂不害羞？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 꾸짖었다. 그러자 #ruby("두|환","斗|煥")이 물었다.]
#zh[斗焕问我：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 언제부터 #ruby("공|대","恭|待")를 하오리까?”]
#zh[“什么时候开始用敬语？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“잘못인 줄 아는 #ruby("시|간","時|間")부터니라.”]
#zh[“从你知错的那一刻起。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 이른 아침 #ruby("문|전","門|前")에서 ‘#ruby("김|구","金|龜") #ruby("선|생","先|生")님’을 부르는 이가 있었다. 나가보니 #ruby("손|창|렴","孫|昌|濂") #ruby("의|관","議|官")이었다. #ruby("하|인","下|人")에게 #ruby[쌀][白米] 한 짐을 지우고 와서 #ruby("문","門") 안에 들여놓고, 너무 기뻐하여 말의 #ruby("순|서","順|序")도 차리지 못했다.]
#zh[第二天一大早，门口有人呼唤金龟先生。我外出一看，原来是议官①孙昌廉。他让下人扛来一背架白米放到我门里，喜形于色，却不知话该从哪儿说起。]
#zh[译注：①朝鲜高宗三十二年（一八九五年）设立的中枢院的官职之一，后改称“赞议”。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("두|환","斗|煥")이 놈이 어제 저녁에 #ruby("학|교","學|校")에서 돌아와 내게 #ruby("공|대","恭|待")하고, 저의 #ruby("모|친","母|親")에게는 #ruby("전","前")과 같이 ‘해라’를 하더니 깜짝 놀라 ‘에고 잘못했습니다’ 하고 말을 고치며 ‘#ruby("선|생","先|生")님 #ruby("교|훈","敎|訓")’이라고 합디다. #ruby("선|생","先|生")님, 진지 많이 잡수시고 그놈 잘 #ruby("교|육","敎|育")하여 주십시오. 밥맛 좋은 쌀이 들어왔기로 좀 가져왔습니다.”]
#zh[“我家斗焕昨晚从学校回来后，对我用了敬语，对他母亲刚有不敬，随即醒悟，立即改用了敬语，说这是老师的教导。老师，请您多多进餐，有了精力好教训我家孩儿，我家刚收进了好大米，特意给老师您送来一些。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나도 마음이 기뻐서 웃었다.]
#zh[听了他的话，我感到十分欣慰。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때에 #ruby("학|교","學|校")를 #ruby("신|설","新|設")하고서, #ruby("학|령","學|齡") #ruby("아|동","兒|童")이 있는 집에 #ruby("방|문","訪|問")하여 다니면서 #ruby("학|부|형","學|父|兄")에게 ‘#ruby("학|생","學|生")들의 머리는 깎지 않겠다’는 #ruby("조|건|부","條|件|附")로, #ruby("애|걸","哀|乞")하며 #ruby("아|동","兒|童")들을 모아 왔다. 그런데 어떤 아이들은 #ruby("부|모","父|母")들이 머리를 자주 빗기지 않아서 이와 서캐(이의 알)가 가득하였다. 나는 할 수 없이 얼레빗·참빗을 사다두고 #ruby("매|일","每|日") 몇 #ruby("시|간","時|間")씩 #ruby("학|생","學|生")들 머리를 빗겼다. #ruby("점|차","漸|次") #ruby("아|동","兒|童") #ruby("수|효","數|爻")가 늘어남에 따라 #ruby("학|과","學|科") #ruby("시|간","時|間")보다 머리 빗기는 #ruby("시|간","時|間")이 많게 되니, 그 다음 #ruby("수|단","手|段")으로 하나둘씩 #ruby("부|모","父|母")의 #ruby("승|낙","承|諾")을 얻어 머리를 깎아주었다.]
#zh[那时学校新设，我挨家拜访有学龄儿童的人家，以“学生的头发不剪”为条件，央求着把儿童聚来。有的孩子父母不常梳头，满头是虱子和虱卵。我只好买了疏梳和密篦，每天花几个小时给学生梳头。儿童渐渐多了，梳头的时间比上课还多，于是下一步，一个两个地得到父母的答应，给他们剪了发。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("두|환","斗|煥")의 #ruby("경|우","境|遇") #ruby("부|친","父|親")의 #ruby("승|낙","承|諾")을 구하다가 도리어 #ruby("퇴|학","退|學")시키겠다고 할지 몰라 나는 #ruby("두|환","斗|煥")이와 #ruby("상|의","相|議")했다. #ruby("두|환","斗|煥")은 상투 짜는 것이 괴롭고 #ruby("초|립","草|笠")이 무거우니, 머리 깎는 것이 #ruby("소|원","所|願")이라 한다. 나는 머리를 깎아서 #ruby("두|환","斗|煥")을 집에 보낸 #ruby("후","後") 슬금슬금 따라가 보았다.]
#zh[斗焕的情形，若先求他父亲答应，只怕反而要让他退学，我便和斗焕商量。斗焕说绾发髻苦，草笠沉，剪发正是他的愿望。我剪了斗焕的头发，打发他回家，自己悄悄跟去看。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("손","孫")#ruby("의|관","議|官")은 눈물이 비오듯하며 #ruby("분","憤")이 머리끝까지 났으나, 더없이 사랑하는 #ruby("두|환","斗|煥")을 #ruby("심","甚")하게 꾸중하기는 싫고 나에게 #ruby("분","憤")풀이를 할 참이었다. 그런데 #ruby("두|환","斗|煥")이가 내가 온 것을 보고 기뻐하는 것을 보고서는 #ruby("분","憤")한 마음이 갑자기 다 어디로 갔는지, 눈에서는 눈물이 뚝뚝 떨어지는데도 얼굴에는 기쁨이 가득해지는 것이었다.]
#zh[孙议官泪如雨下，怒气冲到头顶，又不愿意痛责最心爱的斗焕，打算拿我出气。可是看见斗焕见我来了那么高兴，满腔忿怒忽然不知去了哪里，眼里泪还扑簌簌掉，脸上却充满了喜悦。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님, 이것이 웬일이에요? 내가 죽거든 머리를 깎아주시지 않고.”]
#zh[“老师，这是怎么回事？您等我死后再给他剃发啊！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("미|안","未|安")함을 #ruby("표","表")했다.]
#zh[我感到内疚，遂婉言相劝：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("영|감","令|監")님께서는 #ruby("두|환","斗|煥")이를 #ruby("지|극","至|極")히 사랑하시지요? 나도 #ruby("영|감","令|監")님 다음으로는 사랑합니다. 나는 #ruby("두|환","斗|煥")이가 목이 가는데 큰 상투를 짜고 #ruby("망|건","網|巾")으로 조르고 무거운 #ruby("초|립","草|笠")을 씌워두는 것이 #ruby("위|생","衛|生")에 큰 #ruby("방|해","妨|害")가 되기 때문에 아끼고 사랑하는 생각으로 깎았습니다. #ruby("두|환","斗|煥")이 #ruby("신|체","身|體")가 튼튼해지면 #ruby("영|감","令|監")님에게 고맙다는 #ruby("인|사","人|事")를 듣고야 말걸요?”]
#zh[“您不是很爱斗焕吗？我喜爱他也不下于您，我见斗焕身体虚弱脖子细，梳上这么大的发髻，再束上网巾，戴上沉重的草笠，实在不堪重负，生活上也诸多不便，出于爱护他的心情，把他的头发剃了，斗焕日后身体健壮了，一定会感谢您这当父亲的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이로부터 #ruby("두|환","斗|煥")은 나를 따라 #ruby("안|악","安|岳")으로 #ruby("유|학","留|學")하게 되고, #ruby("손","孫")#ruby("의|관","議|官")도 같이 따라와 #ruby("객|지","客|地")에 머물면서 #ruby("두|환","斗|煥")이 #ruby("공|부","工|夫")하는 것을 보았다. #ruby("두|환","斗|煥")은 사람됨이 #ruby("총|명","聰|明")도 하거니와 #ruby("망|국","亡|國")의 #ruby("한","恨")을 같이 느낄 줄 알았다.]
#zh[此后斗焕跟我到安岳上学，孙议官也跟到安岳，住进旅店，随时了解斗焕念书的情况。斗焕不仅头脑聪明，胸中也怀有亡国之恨。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|학|생","中|學|生") #ruby("중","中")에 #ruby("우|기|범","禹|基|範")은, 내가 #ruby("문|화|군","文|化|郡") #ruby("종|산","鍾|山")의 #ruby("서|명|의|숙","西|明|義|塾")에서 가르치던 때 #ruby("과|부","寡|婦")의 #ruby("자|식","子|息")으로 #ruby("입|학","入|學")하여 #ruby("수|업","授|業")을 받았던 #ruby("학|생","學|生")이다. 그 #ruby("모|친","母|親")의 #ruby("능|력","能|力")으로는 #ruby("계|속","繼|續") #ruby("공|부","工|夫")할 수 없지만 #ruby("재|질","才|質")로는 #ruby("장|래|성","將|來|性")이 있어 보였다. 나는 #ruby("모|친","母|親")에게 #ruby("기|범","基|範")을 나에게 맡기면, #ruby("안|악","安|岳")으로 데리고 가서 내 집에 두고 #ruby("공|부","工|夫")시키겠다고 #ruby("요|청","要|請")했다. 그 #ruby("모|친","母|親")은 매우 #ruby("감|사","感|謝")해 하며 말했다.]
#zh[中学生中还有一个名叫禹基范的，是我在文化钟山西明义塾时的学生。有一天我对她寡居的母亲说：]
#zh[“你把基范交给我带往安岳，他可以住在我家继续学习。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("만|일","萬|一") #ruby("선|생","先|生")께서 그같이 생각하시면, 나도 따라가서 엿장사를 하며 #ruby("기|범","基|範")의 #ruby("공|부","工|夫")하는 #ruby("모|양","模|樣")을 보겠습니다.”]
#zh[他母亲十分感谢，说道：]
#zh[“如蒙先生不弃，我也跟去卖糖饼，天天看着我儿子读书学习。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("기|범","基|範")을 9#ruby("세","歲") 때부터 내 집에서 기르며, #ruby("공|부","工|夫")는 #ruby("안|신|학|교","安|新|學|校") #ruby("소|학|과","小|學|科")를 마치고 #ruby("양|산|학|교","楊|山|學|校") #ruby("중|학|부","中|學|部")에 #ruby("입|학","入|學")하게 하였다.]
#zh[这样，基范九岁时就住在我家，进了安新学校学习，小学毕业后，又进了杨山学校中学部。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 이제 #ruby("왜","倭")놈들이 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("해|산","解|散")하고 #ruby("교|구","校|具") #ruby("전|부","全|部")를 #ruby("강|탈","強|奪")하니, #ruby("교|육|사|업","敎|育|事|業")도 단 #ruby[꿈][春夢]이 되고 말았다. #ruby("목|자","牧|者")를 잃은 #ruby("양","羊")떼 같은 #ruby("학|생","學|生")들이 #ruby("원|수","怨|讐")의 채찍 아래 #ruby("신|음","呻|吟")하게 되었으니 #ruby("원|통","冤|痛")스러울 뿐이다.]
#zh[但是日本鬼子勒令解散杨山学校，夺走了校舍和全部教具，教育事业也变成一场春梦。看到我的学生如同失去放牧人的羔羊，在敌人的铁蹄下呻吟，我心中悲痛不已。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 애써서 #ruby[기러기][鴻] #ruby("친|구","親|舊")\(#ruby("김|홍|량","金|鴻|亮"))가 #ruby("악","惡")의 #ruby[그물망][禍網]을 벗어나 멀리 #ruby("해|외","海|外")로 날아가기를 #ruby("기|도","祈|禱")하였건만, #ruby("홍|량","鴻|亮")은 #ruby("안|명|근","安|明|根")의 #ruby("부|탁","付|託")으로 #ruby("신|천","信|川") #ruby("이|원|식","李|源|植")에게 #ruby("권|고","勸|告")하였다고 #ruby("자|백","自|白")한 #ruby("점","點")으로 보아 풀려날 수 없었다.]
#zh[我曾费尽心机，想救金鸿亮，让他摆脱厄运，远走高飞，到海外去活动。可是他终于招供说出了他是受安明根之托，劝告信川李源植的；这样一来想要出狱就更加困难了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 #ruby("상|경","上|京")하여 #ruby("사|식","私|食")을 날마다 들여보내시고 #ruby("종|종","種|種") #ruby("편|지","便|紙")로 #ruby("소|식","消|息")도 알리셨다. #ruby("안|악","安|岳")의 #ruby("가|산","家|産")과 #ruby("집|물","什|物")을 #ruby("전|부","全|部") #ruby("매|각","賣|却")하여 가지고 서울로 오다가, 두#ruby("번","番")째로 낳은 두 살배기 딸 #ruby("화|경","花|慶")#footnote(numbering: _ => [71)])[#h(0.35em)#ruby("원|문","原|文"): “花慶”. 다른 곳에는 이름이 ‘化敬’으로 되어 있다.]과 아내는 #ruby("당|시","當|時") #ruby("평|산","平|山")에 있던 #ruby("장|모","丈|母")가 사는 #ruby("처|형","妻|兄") 집에 들른 #ruby("후","後") #ruby("상|경","上|京")한다는 것이었다.]
#zh[母亲为了照顾监狱中的我，拿着变卖安岳全部家产得到的款子，千里迢迢来到汉城。她每天给我送饭，还常给我写信。她在信中告诉我，我的妻子和两岁的女儿化敬，先到平山岳母和姐姐家里看看，等到开庭之日再来汉城。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님이 손수 담은 밥그릇을 열고 밥을 먹으면서 생각하니, 어머님의 눈물이 밥에 #ruby("점|점","點|點")이 섞이었을 것이다. 18#ruby("년","年") #ruby("전","前") #ruby("해|주","海|州") #ruby("옥","獄")바라지로부터 #ruby("인|천","仁|川")의 #ruby("옥","獄")바라지 하실 때까지는 슬프고 #ruby("황|망","遑|忙")한 #ruby("중","中")에도 #ruby("내|외|분","內|外|分")이 서로 #ruby("위|로","慰|勞")하고 #ruby("의|논","議|論")하시며 지냈으나, #ruby("지|금","只|今")은 #ruby("과|부","寡|婦")의 몸으로 어느 누구 살뜰하게 #ruby("위|로","慰|勞")하여 줄 사람도 없다. #ruby("준|영","俊|永") #ruby("삼|촌","三|寸")과 #ruby("재|종|형|제","再|從|兄|弟")가 있으나 #ruby("대|부|분","大|部|分") #ruby("토|착","土|着") #ruby("농|민","農|民")이라 #ruby("거|론","擧|論")할 #ruby("여|지","餘|地")도 없고, #ruby("약","弱")한 아내와 어린 아이가 어머님에게 무슨 #ruby("위|안","慰|安")을 할 #ruby("능|력","能|力")이 있을까? 또한 아내가 어린 아이를 데리고, #ruby("자|기","自|己") #ruby("모|친","母|親")이 얹혀 사는 #ruby("처|형","妻|兄") 집에 갔다는 #ruby("소|식","消|息")에는 #ruby("무|한","無|限")의 느낌이 생긴다.]
#zh[打开母亲亲手盛的饭碗，一面吃着，一面想，此饭里不知掉进了母亲多少眼泪。十八年前，从海州的狱中侍奉直到仁川，悲伤慌忙之中，父母还能互相安慰、互相商量；如今母亲是寡妇之身，没有谁能贴心地安慰她。俊永叔父和堂兄弟虽然有，大多是土著农民，说不上什么话。软弱的妻子和幼小的孩子，又能给母亲什么安慰？再说，听到妻子带着幼小的孩子，去了她母亲寄居的姐姐家里，心里涌起无限的感触。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("처|형","妻|兄")은 #ruby("본|래","本|來") #ruby("신|창|희","申|昌|熙") #ruby("군","君")과 #ruby("결|혼","結|婚")하여 #ruby("가|족","家|族")과 같이 #ruby("황|해|도","黃|海|道")에 와서 살았다. 내가 그 #ruby("처|제","妻|弟")인 #ruby("준|례","遵|禮")와 #ruby("결|혼","結|婚")한 #ruby("후","後"), #ruby("신|창|희","申|昌|熙") #ruby("군","君")은 다시 #ruby("의|과","醫|科") #ruby("졸|업","卒|業")을 #ruby("위","爲")해 세브란스 #ruby("의|학|교","醫|學|校")로 들어가게 되어 #ruby("처|형","妻|兄")과 #ruby("장|모","丈|母")까지 도로 #ruby("경|성","京|城")으로 #ruby("이|사","移|徙")해 갔다.]
#zh[妻兄本来和申昌熙君结婚，举家到黄海道来住。我和她的妹妹遵礼结婚之后，申昌熙君为了读完医科，又进了世富兰医学校，于是妻兄和岳母又搬回京城去了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("그|후","其|後") 내가 #ruby("장|련|읍","長|連|邑")에 있을 때, #ruby("장|모","丈|母")와 #ruby("처|형","妻|兄") #ruby("모|녀","母|女") 두 사람만 #ruby("평|양","平|壤")을 들러 #ruby("장|련","長|連") 내 집까지 아내를 만나러 찾아왔다. 그런데 어찌된 #ruby("사|유","事|由")인지 #ruby("처|형","妻|兄")은 #ruby("신|창|희","申|昌|熙") #ruby("군","君")과 잘 맞지 않고 어긋난 빛을 보일 뿐 아니라, #ruby("거|동","擧|動")이 #ruby("상|식","常|識")에 벗어난 #ruby("경|향","傾|向")을 보였다. 하물며 #ruby("기|독|신|자","基|督|信|者")로서 #ruby("행|위","行|爲")인지라 그것을 본 나의 #ruby("부|부","夫|婦")는 #ruby("처|형","妻|兄")과 #ruby("장|모","丈|母")를 #ruby("권","勸")하여 #ruby("신|창|희","申|昌|熙")에게로 보냈다.]
#zh[后来我在长连邑的时候，岳母和妻兄母女两人经过平壤，找到长连我家来看妻子。不知什么缘故，妻兄和申昌熙君合不来，显出龃龉，而且举动有越出常情的倾向。何况这是基督教徒的行为，我们夫妇见了，便劝妻兄和岳母回到申昌熙那里去。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("안|악","安|岳")에 #ruby("이|사","移|徙")했을 때 역시 #ruby("처|형","妻|兄")과 #ruby("장|모","丈|母")가 찾아왔는데, #ruby("처|형","妻|兄")은 #ruby("신|창|희","申|昌|熙")와 #ruby("부|부","夫|婦") #ruby("관|계","關|係")를 끝냈다고 한다. 나와 어머님은 한때도 집안에 #ruby("용|납","容|納")할 생각이 없었으나, 아내는 #ruby("자|신","自|身")의 어머니와 #ruby("형","兄")에 #ruby("대","對")해 #ruby("강|경","强|硬")한 #ruby("태|도","態|度")를 보이지 못하는 것이 #ruby("사|실","事|實")이었다. #ruby("가|정","家|庭")은 #ruby("심","甚")히 #ruby("불|안","不|安")에 빠졌다.]
#zh[我迁到安岳时，妻兄和岳母又找了来，说妻兄已经和申昌熙结束了夫妻关系。我和母亲一刻也不想把她容纳在家里，可是妻子对自己的母亲和姐姐实在硬不起心来。家庭陷入了严重的不安。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 아내에게 #ruby("비|밀","祕|密")히 #ruby("부|탁","付|託")하고, #ruby("장|모","丈|母")에게 “큰딸을 데리고 나가주지 못할 터이면 작은딸까지 데리고 나가 달라”고 말했다. 말뜻을 깨닫지 못한 #ruby("장|모","丈|母")는 좋다 하고, #ruby("모|녀","母|女") 세 사람이 집을 떠나 #ruby("경|성","京|城")으로 #ruby("출|발","出|發")하였다.]
#zh[我秘密拜托了妻子，对岳母说：“你若不能把大女儿带走，就把小女儿也一并带走。”岳母没明白话里的意思，答应了，母女三人离开家，动身去了京城。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 얼마 #ruby("후","後")에 #ruby("경|성","京|城")에 가서 #ruby("동|정","動|靜")을 살펴보니, 아내는 어머니와 #ruby("형","兄")을 떠나 어느 #ruby("학|교","學|校")에 #ruby("투|신","投|身")할 #ruby("계|책","計|策")을 하고 있었다. 나는 아내에게 #ruby("은|밀","隱|密")히 #ruby("약|간","若|干")의 #ruby("여|비","旅|費")를 주고 내려와 #ruby("재|령","載|寧")에 있던 #ruby("선|교|사","宣|敎|師") #ruby("군|예|빈","君|芮|彬")에게 말을 하니, #ruby("준|례","遵|禮")는 #ruby("당|분|간","當|分|間") 데려다가 #ruby("자|기","自|己") 집에 있게 하고 #ruby("서|서","徐|徐")히 데려가라 하였다.]
#zh[过了不久我到京城看动静，妻子正打算离开母亲和姐姐，投进某个学校。我暗暗给了妻子一点旅费，下来告诉在载宁的传教士君芮彬。他说先把遵礼接到自己家里住着，再慢慢接走。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 곧 #ruby("경|성","京|城")으로 #ruby("준|례","遵|禮")에게 #ruby("편|지","便|紙")를 보내고 #ruby("사|리|원|역","沙|里|院|驛") 앞에서 기다리니, #ruby("준|례","遵|禮") 혼자만 #ruby("차","車")에서 내렸다. 아내를 #ruby("군|예|빈","君|芮|彬") #ruby("목|사","牧|師") 집에다 데려다 두고, 나는 #ruby("안|악","安|岳")으로 와서 어머님에게 #ruby("사|정","事|情")을 #ruby("설|명","說|明")하였다.]
#zh[我立刻写信到京城给遵礼，在沙里院车站前等候，遵礼一个人下了车。我把妻子安顿在君芮彬牧师家里，自己回到安岳，向母亲这样说明：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("장|모","丈|母")나 #ruby("처|형","妻|兄")이 비록 #ruby("여|자","女|子") #ruby("도|리","道|理")에 #ruby("위|반","違|反")되는 #ruby("죄|상","罪|狀")이 있더라도, #ruby("죄","罪")가 없는 아내까지 내쫓는 것은 #ruby("도|리","道|理")가 아니니 #ruby("용|서","容|恕")하십시오.”]
#zh[“岳母和她姐姐虽然不守妇道，但终不能把我的妻子也赶走，还是请母亲多多原谅。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[말이 끝나자마자 어머님은 #ruby("쾌","快")히 #ruby("승|낙","承|諾")하셨다.]
#zh[母亲痛快地答应说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇다. 네가 데려오는 것보다 내가 #ruby("직|접","直|接") 가서 데려오마.”]
#zh[“好吧，你去接还不如我直接去接她回来。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 그날로 #ruby("재|령","載|寧")에 가셔서 아내를 데려왔다. #ruby("가|정","家|庭")의 #ruby("파|란","波|瀾")은 이로부터 #ruby("안|정","安|定")되었다. 아내 역시 #ruby("친|모","親|母")와 #ruby("친|형","親|兄")에 대한 #ruby("친|족|관|념","親|族|觀|念")을 #ruby("단|절","斷|絶")하고 지냈다. #ruby("그|후","其|後") #ruby("처|형","妻|兄")은 #ruby("평|산","平|山") #ruby("등|지","等|地")에서 #ruby("헌|병|보|조|원","憲|兵|補|助|員")의 #ruby("처","妻")인지 #ruby("첩","妾")인지가 되어 살고, #ruby("장|모","丈|母")도 같이 산다는 #ruby("풍|설","風|說")만 들었다.]
#zh[当天母亲就去载宁把我妻子接了回来。]
#zh[家庭的波折至此结束，妻子终于抛弃了亲生母、亲姐妹的亲族观念。她姐姐后来在平山又找了一个宪兵补助员，不知是嫁给他做妻还是做妾，岳母也就跟他们住在一起。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 이번에 #ruby("가|족","家|族") #ruby("전|부","全|部")가 #ruby("경|성","京|城")으로 #ruby("공|판","公|判")이란 것을 보겠다고 오던 길에, #ruby("도|중","道|中")에 #ruby("평|산","平|山") #ruby("처|형","妻|兄") 집에다 아내와 #ruby("화|경","花|慶")이는 두고, 어머님만 #ruby("경|성","京|城")으로 먼저 오셔서 #ruby("공|판|일|자","公|判|日|子")를 #ruby("통|지","通|知")하여 아내를 #ruby("상|경","上|京")하게 하였다는 어머님의 #ruby("편|지","便|紙")를 보았다.]
#zh[这次我们全部被捕，要进行公审，母亲信中告诉我说妻子为了来此亲眼看一看公审，竟带着化敬暂住在她姐姐家，由母亲先来汉城，有了消息再通知她来看公审。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이제 내가 #ruby("주|장","主|張")하던 것과 힘써 온 것은 #ruby("대|부|분","大|部|分") 물거품으로 돌아갔다. #ruby("학|교","學|校")에서 #ruby("학|생","學|生")을 가르칠 때에도 #ruby("학|생","學|生")들이 나를 #ruby("숭|배","崇|拜")함보다, 내가 #ruby("학|생","學|生")들에게 #ruby("천|배","千|倍") #ruby("만|배","萬|倍")의 #ruby("숭|배","崇|拜")와 #ruby("희|망","希|望")을 두고 있었다. 나는 일찍이 #ruby("교|육","敎|育")을 #ruby("충|분","充|分")히 받지 못하여 #ruby("망|국|민","亡|國|民")이 되었으나, #ruby("학|생","學|生")들은 #ruby("후|일","後|日") #ruby("건|국|영|웅","建|國|英|雄")이 될 것을 바라던 마음도 헛된 것으로 돌아갔다. 또한 아내도 #ruby("자|기","自|己") 언니가 #ruby("헌|병","憲|兵")의 #ruby("첩","妾")질 한다는 말을 들은 #ruby("후","後")로는 #ruby("영|구","永|久")히 만나지 않기로 #ruby("결|심","決|心")하였건만, 내가 이 #ruby("지|경","地|境")이 되니 하는 수 없이 찾아갔을 것이다.]
#zh[我所主张的和我所追求的现在已全部化为泡影。我在学校教书时曾对学生们说，你们崇拜我，我们对你们也寄予千百倍的希望，尊重和推崇你们，我早年不能充分受教育，当了亡国奴，你们以后一定要多学知识，成为建国的英雄。我为这一希望所费的苦心现在已成徒劳，而妻子听说她姐姐嫁给宪兵为妻这一消息后，曾决心永远和她断绝来往，现在我到了这步田地，无奈又去了她姐家，先前的决心化为乌有。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그럭저럭 #ruby("소|위","所|謂") #ruby("공|판|일|자","公|判|日|子")란 것이 #ruby("정","定")해지고, 어머님은 #ruby("왜","倭")놈 #ruby("나가이","永井")란 #ruby("변|호|사","辯|護|士")를 #ruby("고|용","雇|傭")하였다. #ruby("예|심","豫|審") #ruby("심|문","訊|問") 때 #ruby("나가이","永井") 놈은 내게 이런 말로 물었다.]
#zh[公审的日子终于定下来了。母亲请了日本人永井给我当辩护律师。预审时，永井这家伙问我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("총|감|부","總|監|府") #ruby("유|치|장","留|置|場")에 있을 때 나무#ruby("판|자","板|子") #ruby("벽","壁")을 두드리며 #ruby("양|기|탁","梁|起|鐸")과 무슨 말을 하였는가?”]
#zh[“在总监部拘留所时你和梁起铎敲墙通过什么话？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("나가이","永井")를 노려보고 #ruby("대|답","對|答")했다.]
#zh[我瞪了他一眼说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이것은 #ruby("신|문|관","訊|問|官")을 #ruby("대|리","代|理")한 것인가? 그 #ruby("사|실","事|實")은 #ruby("신|문","訊|問") #ruby("기|록","記|錄")에 #ruby("상|세","詳|細")히 #ruby("기|재","記|載")하였으니 나에게 더 물을 것이 없다.”]
#zh[“你是代法官审问我吗？我的一切已详细地记在审问记录里了，你用不着再多问。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러자 #ruby("검|사","檢|事")놈과 눈을 꿈적이며 #ruby("실|패","失|敗")했다는 뜻을 #ruby("표|시","表|示")하는 것 같았다.]
#zh[这家伙向检察官眨了眨眼，示意完全失败。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이른바 #ruby("재|판|일","裁|判|日")을 맞았다. #ruby("죄|수","罪|囚") #ruby("마|차","馬|車")에 실려 #ruby("경|성","京|城") #ruby("지|방|재|판|소","地|方|裁|判|所") #ruby("문|전","門|前")에 #ruby("당|도","當|到")했다. 어머님이 #ruby("화|경","花|慶")이를 업고 아내와 같이 #ruby("문","門") 안에서 기다리고 있는 것을 보면서, #ruby("소|위","所|謂") 2#ruby("호","號") #ruby("법|정","法|庭")이란 데로 끌려갔다.]
#zh[所谓开庭的日子到了。我坐着囚犯马车，来到京城地方法院门前。看见母亲背着化敬，和妻子一起在门里等着，便被拉进所谓第二号法庭。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[맨 #ruby[앞자리][首席]에 #ruby("안|명|근","安|明|根"), 다음으로 #ruby("김|홍|량","金|鴻|亮")이요, 나는 #ruby("제|3|차","第|三|次")에 앉고, #ruby("이|승|길","李|承|吉")·#ruby("배|경|진","裵|敬|鎭")·#ruby("한|순|직","韓|淳|稷")·#ruby("도|인|권","都|仁|權")·#ruby("양|성|진","楊|成|鎭")·#ruby("최|익|형","崔|益|亨")·#ruby("김|용|제","金|庸|濟")·#ruby("최|명|식","崔|明|植")·#ruby("장|윤|근","張|允|根")·#ruby("고|봉|수","高|鳳|洙")·#ruby("한|정|교","韓|貞|敎")·#ruby("박|형|병","朴|亨|秉") #ruby("등","等") 40#ruby("명","名")이 #ruby("출|석","出|席")하였다. #ruby("방|청|석","傍|聽|席")을 둘러보니 #ruby("각","各") #ruby("학|교","學|校") #ruby("남|녀","男|女") #ruby("학|생","學|生")과 #ruby("각","各") 사람의 #ruby("친|척","親|戚"), #ruby("친|구","親|舊")가 모였고, #ruby("변|호|사","辯|護|士")들과 #ruby("신|문|기|자","新|聞|記|者")들도 #ruby("열|석","列|席")하였다.]
#zh[最前面坐着安明根，其次是金鸿亮，我坐第三，李承吉、裴敬镇、韩淳稷、都寅权、杨星镇、崔益亨、金庸济、崔明植、张允根、高凤洙、韩贞教、朴亨秉等四十人出庭。环顾旁听席，各学校的男女学生和各人的亲戚、朋友都来了，律师和新闻记者也列席。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|지","同|志")들에게 #ruby("한|필|호","韓|弼|昊")·#ruby("신|석|충","申|錫|忠") 두 사람의 #ruby("경|과","經|過")를 들어보니, #ruby("한|필|호","韓|弼|昊") #ruby("선|생","先|生")은 그때 #ruby("경|무|총|감|부","警|務|總|監|府")에서 #ruby("피|살","被|殺")되었고, #ruby("신|석|충","申|錫|忠")은 #ruby("재|령","載|寧") #ruby("철|교","鐵|橋")까지 끌려오다 #ruby("강","江")에 #ruby("투|신","投|身")하여 죽었다는 가슴 아픈 #ruby("사|연","事|緣")을 알게 되었다.]
#zh[从同志那里听到韩弼浩、申锡忠两人的经过，才知道韩弼浩先生当时在警务总监部被打死，申锡忠被拖到载宁铁桥，投江死了。真是令人心痛。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|강","大|綱") #ruby("신|문","訊|問")을 마친 #ruby("후","後") #ruby("소|위","所|謂") #ruby("판|결","判|決")이 있었다. #ruby("안|명|근","安|明|根")은 #ruby("종|신","終|身") #ruby("징|역","懲|役")이요, #ruby("김|홍|량","金|鴻|亮")·#ruby("김|구","金|龜")·#ruby("이|승|길","李|承|吉")·#ruby("배|경|진","裵|敬|鎭")·#ruby("한|순|직","韓|淳|稷")·#ruby("원|행|섭","元|行|燮")·#ruby("박|만|준","朴|萬|俊") 7#ruby("명","名")은 15#ruby("년|형","年|刑")인데, #ruby("원|행|섭","元|行|燮")·#ruby("박|만|준","朴|萬|俊")은 #ruby("결|석","缺|席")하였고, #ruby("도|인|권","都|仁|權")·#ruby("양|성|진","楊|成|鎭")은 10#ruby("년|형","年|刑")이요, #ruby("최|익|형","崔|益|亨")·#ruby("김|용|제","金|庸|濟")·#ruby("장|윤|근","張|允|根")·#ruby("고|봉|수","高|鳳|洙")·#ruby("한|정|교","韓|貞|敎")·#ruby("박|형|병","朴|亨|秉")은 7#ruby("년","年") #ruby("혹","或")은 5#ruby("년","年")으로 #ruby("구|형","求|刑")한 #ruby("후","後"), #ruby("판|결","判|決")도 그대로 #ruby("언|도","言|渡")되었다.#footnote(numbering: _ => [72)])[#h(0.35em)#ruby("판|결|일","判|決|日")은 1911#ruby("년","年") 7#ruby("월","月") 22#ruby("일","日")이었다. 5#ruby("년|형","年|刑")을 받은 사람은 없고 #ruby("최|하","最|下") 7#ruby("년|형","年|刑")이었다. 모두 18#ruby("명","名")이었으며, #ruby("본|문","本|文")의 16#ruby("명","名") #ruby("외","外") #ruby("최|명|식","崔|明|植")과 #ruby("김|익|연","金|益|鍊")이 있었다.] 이것은 이른바 ‘#ruby("강|도","強|盜") #ruby("사|건","事|件")’으로 #ruby("선|고","宣|告")된 것이었다.]
#zh[大致审问之后，有了所谓判决。安明根是无期徒刑。金鸿亮、金龟、李承吉、裴敬镇、韩淳稷、元行燮、朴万俊七人是十五年刑，其中元行燮、朴万俊缺席。都寅权、杨星镇是十年刑。崔益亨、金庸济、张允根、高凤洙、韩贞教、朴亨秉求刑七年或五年，判决也照此宣告。这是所谓“强盗事件”的宣判。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後")에 #ruby("소|위","所|謂") ‘#ruby("보|안","保|安") #ruby("사|건","事|件")’으로 또 #ruby("재|판","裁|判")할 때는, #ruby("수|석","首|席")으로는 #ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("김|구","金|龜")·#ruby("김|홍|량","金|鴻|亮")·#ruby("주|진|수","朱|鎭|洙")·#ruby("옥|관|빈","玉|觀|彬")·#ruby("김|도|희","金|道|熙")·#ruby("김|용|규","金|用|圭")·#ruby("고|정|화","高|貞|華")·#ruby("정|달|하","鄭|達|河")·#ruby("감|익|룡","甘|益|龍")·#ruby("김|용|규","金|用|圭")의 조카 #ruby("등","等")이었다. #ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("김|구","金|龜")·#ruby("김|홍|량","金|鴻|亮")·#ruby("주|진|수","朱|鎭|洙")·#ruby("옥|관|빈","玉|觀|彬")은 2#ruby("년","年") #ruby("징|역","懲|役")이고,#footnote(numbering: _ => [73)])[#h(0.35em)#ruby("옥|관|빈","玉|觀|彬")은 1#ruby("년","年") 6#ruby("개|월","個|月")이었고, #ruby("김|구","金|龜")·#ruby("김|홍|량","金|鴻|亮")은 여기서는 #ruby("형","刑")을 받지 않았다. 따라서 #ruby("김|구","金|龜")의 #ruby("총|형|량","總|刑|量")은 15#ruby("년|형","年|刑")이다.] 그 나머지는 1#ruby("년","年") #ruby("혹","或")은 6#ruby("개|월","個|月")이었다.#footnote(numbering: _ => [74)])[#h(0.35em)#ruby("안|윤|재","安|允|栽")·#ruby("감|익|룡","甘|益|龍")·#ruby("김|용|규","金|用|圭") #ruby("등","等")은 1#ruby("년","年") 6#ruby("개|월|형","個|月|刑")이었고, #ruby("유|문|형","柳|文|馨")·#ruby("권|태|선","權|泰|善")이 1#ruby("년|형","年|刑"), #ruby("김|용|태","金|用|泰")·#ruby("김|희|록","金|熙|祿")·#ruby("김|성|주","金|成|周")·#ruby("정|달|하","鄭|達|河")가 6#ruby("개|월|형","個|月|刑")이었다.] 그밖에 #ruby("이|동|휘","李|東|輝")·#ruby("이|승|훈","李|昇|薰")·#ruby("박|도|병","朴|道|秉")·#ruby("최|종|호","崔|宗|鎬")·#ruby("정|문|원","鄭|文|源")·#ruby("김|병|옥","金|秉|玉") #ruby("등","等") 19#ruby("인","人")은 #ruby("무|의|도","舞|衣|島")·#ruby("제|주|도","濟|州|島")·#ruby("고|금|도","古|今|島")·#ruby("울|릉|도","鬱|陵|島") #ruby("등","等")으로 1#ruby("년","年") #ruby("유|배","流|配")가 #ruby("결|정","決|定")되었다.]
#zh[此后又以所谓“保安事件”开庭。首席是梁起铎、安泰国、金龟、金鸿亮、朱镇洙、玉观彬、金道熙、金用圭、高贞和、郑达河、甘益龙和金用圭的侄子等。梁起铎、安泰国、金龟、金鸿亮、朱镇洙、玉观彬是二年徒刑，其余是一年或六个月。另外李东辉、李升薰、朴道秉、崔宗浩、郑文源、金秉玉等十九人，决定流放舞衣岛、济州岛、古今岛、郁陵岛一年。]
#heading(level: 3)[#text(font: "KOPUSGo B")[8) #ruby("서|대|문|감|옥","西|大|門|監|獄")으로]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리는 며칠 #ruby("후","後")에 #ruby("서|대|문|감|옥","西|大|門|監|獄")으로 #ruby("이|감","移|監")되었다. #ruby("동|지","同|志")들 #ruby("전|부","全|部")가 앞서거니 뒤서거니 그곳에서 함께 #ruby("복|역","服|役")하게 되니, 날마다 서로 얼굴 대하는 것으로도 #ruby("충|분","充|分")히 #ruby("위|로","慰|勞")가 되었고, #ruby("간|간","間|間")이 말로도 #ruby("사|정","事|情")을 알리며 지내는 까닭에 #ruby("고|생","苦|生") 가운데 #ruby("낙","樂")이 되었다. 그뿐 아니라 5#ruby("년","年") #ruby("이|하","以|下")는 #ruby("세|상","世|上")에 나갈 #ruby("소|망","所|望")이 있으나 7#ruby("년","年") #ruby("이|상","以|上")은 #ruby("옥|중|귀|신","獄|中|鬼|神")이 되리라고 믿었기 때문에, #ruby("육|체","肉|體")로는 #ruby("복|역","服|役")을 하나 #ruby("정|신","精|神")으로는 #ruby("왜","倭")놈을 짐승처럼 여기고, #ruby("쾌|활","快|活")한 마음으로 죽는 날까지 #ruby("낙|천|생|활","樂|天|生|活")을 하기로 했다. #ruby("동|지","同|志")들도 #ruby("대|부|분","大|部|分") #ruby("지|향","志|向")하는 바가 #ruby("동|일","同|一")하므로 #ruby("옥|중","獄|中")에서 하는 일이 서로 #ruby("모|의","謀|議")하지 않고도 같은 때가 많았다. #ruby("오|월|동|주","吳|越|同|舟")#footnote(numbering: _ => [75)])[#h(0.35em)#ruby("오|월|동|주","吳|越|同|舟")란 #ruby("중|국","中|國") #ruby("병|법|서","兵|法|書") 『#ruby("손|자","孫|子")』에 나오는 말로, #ruby("원|래","原|來") #ruby("적|대|국","敵|對|國")인 #ruby("오","吳")나라와 #ruby("월","越")나라 사람들도 같은 배에 타게 되면 #ruby("적|대|관|계","敵|對|關|係")는 사라지고 마음이 같아지게 된다, 즉 ‘#ruby("처|지","處|地")가 같으면 마음도 같아진다’는 #ruby("의|미","意|味")이다. 이 말이 #ruby("전","轉")하여 사이 나쁜 사람들이 같은 #ruby("처|지","處|地")에 #ruby("처","處")하거나 #ruby("단|지","但|只") #ruby("동|석","同|席")한 #ruby("경|우","境|遇")를 #ruby("의|미","意|味")하기도 한다. 여기서는 #ruby("원|래","原|來")의 뜻에 가깝다.]란 옛말이 참으로 헛말이 아닌 줄을 깨달았다.]
#zh[几天后，我们被转移到西大门监狱。]
#zh[这样看来，金鸿亮和我等几人，以强盗罪判刑十五年有期徒刑，再加上违反保安法被判二年有期徒刑，加起来要坐十七年牢。唯一值得安慰的是每天可以遇见同志们，同时偶尔也可以谈几句话，这可以说是苦中之乐吧。]
#zh[五年以下的有期徒刑还有出去的机会，七年以上的有期徒刑，恐怕连活着出去的希望也没有了。因此我内心暗自决定，尽管我的身体沦为倭寇的俘虏而坐牢，但在精神上却把倭寇看作是禽兽，直到死去的那天，我们应该以愉快的心情过着乐天的生活，别的同志的想法也都跟我一样。因此我们在狱中的行动几乎都是不谋而合，真所谓风雨同舟，古言不虚啊。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|중","獄|中")에서 #ruby("여|생","餘|生")을 보내게 된 #ruby("동|지","同|志")들은, #ruby("대|부|분","大|部|分") 크거나 어리거나 간에 아들을 두었으나, #ruby("유|독","唯|獨") 내가 젖먹이 #ruby("화|경","花|慶")이만 있고 또한 누이도 없는 #ruby("독|자","獨|子")임을 #ruby("애|석","哀|惜")하게 생각하였다. #ruby("김|용|제","金|庸|濟")는 4#ruby("남","男") 1#ruby("녀","女")를 두었으니, #ruby("장|남","長|男")은 #ruby("선|량","善|亮")이요, 그 다음이 #ruby("근|량","勤|亮")·#ruby("문|량","文|亮")·#ruby("순|량","順|亮")인데, #ruby("자|원","自|願")해서 #ruby("문|량","文|亮")으로 나의 #ruby("대","代")를 잇게 하겠다고 하여 #ruby("허|락","許|諾")하였다.]
#zh[在狱中的同志们几乎都有儿子，唯独我一个人只有独生女儿化敬，金庸济有四儿一女，长子善亮、次子勤亮、三子文亮、四子顺亮，因此他把老三文亮过继给我，继承我的一脉香火。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("심|리","心|理") #ruby("상|태","狀|態")가 #ruby("체|포","逮|捕")된 #ruby("이|전","以|前")과 #ruby("이|후","以|後")에 큰 #ruby("변|동","變|動")이 생겼음을 깨달았다. #ruby("체|포","逮|捕")되기 #ruby("이|전","以|前")에는 #ruby("십|수|년","十|數|年") 동안 #ruby("성|경","聖|經")을 들고 #ruby("교|회|당","敎|會|堂")에서 #ruby("설|교","說|敎")하거나 #ruby("교|편","敎|鞭")을 들고 #ruby("교|실","敎|室")에서 #ruby("학|생","學|生")을 #ruby("교|훈","敎|訓")하였으므로, 하나하나 일마다 #ruby("양|심","良|心")을 #ruby("본|위","本|位")로 삼아서, 삿된 #ruby("마|음","邪|心")이 생길 때마다 먼저 #ruby("자|기","自|己")를 #ruby("자|책","自|責")하지 않고는 #ruby("감","敢")히 다른 사람의 그릇됨을 탓하지 못하는 것이 거의 #ruby("습|관","習|慣")이 되었다. 그런 까닭으로 #ruby("학|생","學|生")들과 #ruby("친|우","親|友")들 #ruby("간","間")에 #ruby("충|실","忠|實")하다는 #ruby("신|망","信|望")을 받고 지냈고, #ruby("범|사","凡|事")에 #ruby("추|기|급|인","推|己|及|人")의 #ruby("상|습","常|習")이 되엿섯건만,#footnote(numbering: _ => [76)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("매|사","每|事")에 #ruby("자|기","自|己")로부터 #ruby("실|천","實|踐")하여 남에 미치는 것이 #ruby("습|관","習|慣")이 되었건만”.] 어찌하여 #ruby("불|과","不|過") #ruby("반|년","半|年") 만에 #ruby("심|리","心|理")에 큰 #ruby("변|동","變|動")이 생겨났는가를 #ruby("연|구","硏|究")해 보았다.]
#zh[我发觉自己的心理状态，被捕以前和以后有了很大的变动。被捕以前十余年间，我拿着圣经在教堂里说教，或是拿着教鞭在教室里教训学生，每一件事都以良心为本，邪念一起，不先责备自己，就不敢怪别人的不是，这几乎成了习惯。因此在学生和亲友之间，得了忠实的信誉。凡事推己及人，也成了常习。何以不过半年，心理上就起了这么大的变动？我研究了一番。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러고 보면, 나의 #ruby("변|화","變|化")는 #ruby("경|무|총|감|부","警|務|總|監|府")에서 #ruby("신|문","訊|問")받을 때 #ruby("와타나베","渡邊") 놈이, 다시 마주앉은 오늘의 #ruby("김|구","金|龜")가 17#ruby("년","年") #ruby("전","前") #ruby("김|창|수","金|昌|洙")인 것도 모르고, #ruby("대|담","大|膽")하게 #ruby("자|기","自|己") 가슴에는 X#ruby("광|선","光|線")을 붙이고 있어 #ruby("출|생","出|生") #ruby("이|후","以|後") #ruby("지|금","只|今")껏 나의 #ruby("일|체","一|體") #ruby("행|동","行|動")을 #ruby("투|시","透|視")하고 있으니 터럭만큼이라도 숨기면 #ruby("당|장","當|場") 쳐죽이겠다고 #ruby("협|박","脅|迫")하던 때부터 #ruby("시|작","始|作")되었던 것이다. #ruby("태|산","泰|山")처럼 크게 보이던 #ruby("왜","倭")놈이 그때부터 #ruby("겨|자","芥|子")씨와 같이 작아 보였다. 무릇 일곱 #ruby("차|례","次|例")나 매달려 #ruby("질|식","窒|息")된 #ruby("후","後") #ruby("냉|수","冷|水")를 끼얹어 살아나곤 하였지만, 마음은 #ruby("점|점","漸|漸") #ruby("강|고","強|固")해져 #ruby("왜","倭")놈에게 #ruby("국|권","國|權")을 빼앗긴 것은 #ruby("일|시|적","一|時|的") #ruby("국|운","國|運") #ruby("쇠|퇴","衰|退")요, #ruby("일|본","日|本")은 #ruby("조|선","朝|鮮")을 #ruby("영|구","永|久") #ruby("통|치","統|治")할 #ruby("자|격","資|格")이 없다는 것이 불 보듯 #ruby("확|연","確|然")한 #ruby("사|실","事|實")로 생각되었다.]
#zh[这么看来，我的变化是从警务总监部受审时开始的。渡边那家伙和今天的金龟重新对面而坐，却不知道我就是十七年前的金昌洙，大胆说自己胸口贴着X光线，能透视我出生以来直到现在的一切行动，藏起一根毫毛也要立刻打死。从他这样胁迫的时候起，像泰山一样高大的倭寇，从此看起来小得像芥子。我前后七次被吊得窒息，又被冷水泼醒，心却越来越坚固。我想，国权被倭寇夺去，只是一时的国运衰退，日本没有永久统治朝鲜的资格，这是洞若观火的事实。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("소|위","所|謂") #ruby("고|등|관","高|等|官")이라고 #ruby("모|자","帽|子")에 #ruby("금","金")줄을 둘셋씩 붙인 놈이, 나에게 #ruby("일|본","日|本") #ruby("천|황","天|皇")의 #ruby("신|성|불|가|침","神|聖|不|可|侵")인 #ruby("권|위","權|威")를 #ruby("과|장","誇|張")하여, ‘#ruby("천|황","天|皇")이 #ruby("재|가","裁|可")한 #ruby("법|령","法|令")에 #ruby("대","對")하여 #ruby("행|정|관|리","行|政|官|吏")가 털끝만큼이라도 #ruby("범|위","範|圍")에 벗어나는 #ruby("행|사","行|事")를 못한다’ 또 ‘#ruby("조|선","朝|鮮") #ruby("인|민","人|民")도 #ruby("천|황","天|皇")의 어린 #ruby("백|성","赤|子")이라 #ruby("일|본|인","日|本|人")과 한가지로 #ruby("대|접|받|는","一|視|同|仁") #ruby("행|복","幸|福")을 받는 것이니, #ruby("공","功")이 있는 사람은 #ruby("상","賞")을 주고 #ruby("죄","罪")가 있는 사람은 #ruby("벌","罰")을 주는 #ruby("법|령","法|令")대로, #ruby("관|리","官|吏")가 #ruby("법|령","法|令")에 #ruby("의","依")하여 #ruby("공|평","公|平")히 #ruby("시|행","施|行")한다’ 그러니 ‘#ruby("관|리","官|吏")가 #ruby("자|기","自|己")에게 좋게 하는 #ruby("인|민","人|民")에게는 #ruby("죄","罪")가 있어도 #ruby("벌","罰")하지 않고 #ruby("자|기","自|己")가 미워하는 사람에게는 #ruby("죄","罪")가 가벼워도 무겁게 #ruby("벌","罰")하던 #ruby("구|한|국","舊|韓|國")\(#ruby("대|한|제|국","大|韓|帝|國")) #ruby("시|대","時|代")와는 하늘과 땅의 #ruby("차|이","差|異")가 있다’고 혀가 닳도록 #ruby("과|장","誇|張")하여 말했다. 그런 그놈의 입에다 대고 며칠 #ruby("후","後")에 내가 되물었다.]
#zh[帽子上镶有两三道金线的高等官曾向我喋喋不休地大放厥词，说什么日本天皇是神圣不可侵犯的，天皇裁可的法令，行政官员不能有丝毫违反，必须忠实执行。朝鲜人民也是天皇之赤子，天皇必将一视同仁，有功者奖，有过者罚。官员定会依法处理，公平对待，决不会像旧韩国的官吏那样，对亲者有罪不罚，对仇者轻罪重罚，现在和以前的时代真是有天壤之别。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대의 말이, #ruby("안|악","安|岳")에 가서 보니 #ruby("급|료","給|料")의 많고 적음을 #ruby("불|문","不|問")에 부치고 #ruby("오|직","唯|只") #ruby("성|심","誠|心")으로 #ruby("학|교","學|校")만 잘 되도록 애쓰는 #ruby("선|생","先|生")이라고 #ruby("인|민","人|民") #ruby("일|반","一|般")에게 #ruby("신|앙","信|仰")을 받은 것을 보면, #ruby("김|구","金|龜")는 #ruby("지|방","地|方")의 #ruby("유|공|자","有|功|者") 가운데 하나라고 하지 않았느냐? 더욱이 나에게는 오늘까지 #ruby("범|죄","犯|罪") #ruby("사|실","事|實")이 없고 #ruby("상","賞")을 받을 사람의 #ruby("열","列")에는 있을지라도 #ruby("죄","罪")를 받을 만한 #ruby("사|실","事|實")로 #ruby("인|정","認|定")될 것은 없으니, 어서 #ruby("방|송","放|送")하면 곧 #ruby("학|교","學|校")로 돌아가 #ruby("개|학","開|學")하겠다.”]
#zh[我反问说：]
#zh[“你那时不是说去安岳调查，都说金龟为学校工作不问薪俸多寡，一心一意要办好学校，是地方上的有功之臣，深受群众的敬重吗？今天我又没有犯罪事实，不授奖给我，也就罢了，还要受罚，真是岂有此理！快放我出去。让我回学校教书。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 그런 줄 안다만 #ruby("전|답","田|畓")을 사들인 #ruby("지|주","地|主")로서 뭉우리돌을 골라내는 것이 #ruby("상|례","常|例") 아니냐? 네가 아무리 #ruby("범|죄","犯|罪") #ruby("사|실","事|實")을 #ruby("자|백","自|白")하지 않았으나 너의 #ruby("동|류","同|類")가 다 너를 우두머리라 말하였으니, 그것이 #ruby("증|거","證|據")가 되어 끝내 #ruby("죄","罪")를 #ruby("면","免")하기 어렵다.”]
#zh[“你虽然这么想，可是作为买地的地主，都会把田地里的瓦砾碎石捡走。你最终也没有坦白你的罪行，但是你的同伙都说你是罪魁祸首，有证有据，免不了要判罪。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("관|리","官|吏")로서 #ruby("법|률","法|律")을 #ruby("무|시","無|視")하는 것 아니냐?”]
#zh[我又反问道：]
#zh[“你是官员，这样做不是完全不顾法律吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 내가 #ruby("반|문","反|問")했더니, #ruby("관|리","官|吏")를 #ruby("희|롱","戲|弄")한다고 미친개 #ruby("모|양","模|樣")으로 #ruby("분|기|탱|천","憤|氣|撐|天")해서 죽도록 매질하였다. 그러나 #ruby("왜","倭")놈이 나를 뭉우리돌로 #ruby("인|정","認|定")하는 것은 참 기쁘다.]
#zh[那家伙像疯狗似的暴跳如雷，说我戏弄官吏，把我狠揍了一顿。可是倭寇认定我是圆石头，我倒真高兴。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘오냐, 나는 죽어도 뭉우리돌 #ruby("정|신","精|神")을 품고 죽겠고, 살아도 뭉우리돌의 #ruby("책|무","責|務")를 다하리라.’]
#zh[“好，我死也要抱着圆石头的精神死去，活着也要尽圆石头的责任。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[는 생각을 가슴 깊이 새겼다. 나는 죽는 날까지 #ruby("왜|마","倭|魔")의 #ruby("소|위","所|謂") #ruby("법|률","法|律")이란 것을 한 푼이라도 #ruby("파|괴","破|壞")할 수만 있다면 #ruby("계|속","繼|續") #ruby("행","行")하고, #ruby("왜|마","倭|魔")를 #ruby("희|롱","戲|弄")하는 것을 #ruby("유|일","唯|一")한 #ruby("오|락","娛|樂")으로 삼고, #ruby("보|통","普|通")사람으로 맛보기 어려운 #ruby("별|종|생|활","別|種|生|活")의 #ruby("진|수","眞|髓")를 맛보리라고 #ruby("결|심","決|心")하였다.]
#zh[我把这个念头深深刻在心里。只要我一天不死，倭魔所谓的法律，能破坏一分就继续破坏，把戏弄倭魔当作唯一的娱乐，要尝一尝普通人难以尝到的另一种生活的真髓。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|대|문","西|大|門")에 #ruby("이|감","移|監")할 때에 #ruby("옥|관","獄|官")이 나에게,]
#zh[转移到西大门监狱的时候，狱官对我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")는, 오늘 입고 있던 #ruby("의|복","衣|服")을 벗어 #ruby("집|물|고","什|物|庫")에 #ruby("봉","封")하여 두는 것과 같이 네 #ruby("자|유","自|由")까지 맡겨두고, #ruby("옥|의","獄|衣")를 입고 #ruby("감|옥","監|獄")에 들어왔으니 #ruby("관|리","官|吏")에게 #ruby("복|종","服|從")하는 것뿐이다.”]
#zh[“金龟，现在要脱下你的衣服，封存在杂物仓库里，你的自由也一样，交到了我们的手里，你要穿着囚衣进监，俯首听命于我们当官的。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 한 말을 #ruby("수|긍","首|肯")하였다. #ruby("간|수","看|守")가 다음날 #ruby("복|역","服|役")시킨다면서 #ruby("수|갑","手|匣")을 풀지 않고 #ruby("수|갑","手|匣") #ruby("검|사","檢|査")를 하면서 너무 꽉 잠그는 바람에, 하룻밤 사이에 손목이 퉁퉁 부어서 보기에 끔찍하게 되었다. 다음날 아침 #ruby("검|사","檢|査") 때에 #ruby("간|수","看|守")들이 보고 놀라서 #ruby("이|유","理|由")를 물었다. 나는 #ruby("대|답","對|答")했다.]
#zh[我点头答应。看守说第二天就要去干苦役，但又不给解下手铐，而且铐得更紧，一夜之间，我的手腕肿得跟腿一样粗。第二天一大早来查监时，看守们见了吓了一跳，就问是怎么搞的，我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("관|리","官|吏")가 알지, #ruby("죄|수","罪|囚")가 어찌 아느냐?”]
#zh[“当官的晓得，我囚犯怎会知道？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("간|수|장","看|守|長")이 와서 보고,]
#zh[看守长过来一看，责骂道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 손목이 이 #ruby("지|경","地|境")이 되었으면 #ruby("수|갑","手|匣")을 늦추어 달라고 #ruby("청|원","請|願")해야 할 것 아니냐?”]
#zh[“手腕肿成这样，你不会跟看守说松松手铐？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어제 #ruby("전|옥","典|獄")#footnote(numbering: _ => [77)])[#h(0.35em)앞의 #ruby("옥|관","獄|官"). #ruby("감|옥","監|獄")을 #ruby("담|당","擔|當")하는 우두머리.]의 #ruby("훈|계","訓|誡")에, #ruby("일|체","一|體")를 #ruby("관|리","官|吏")가 다 알아 할 터이니 나더러는 #ruby("복|역","服|役")만 하라고 하지 않았느냐?”]
#zh[“典狱官昨天不是教训说一切由当官的安排，我只有服从吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("즉|시","卽|時") #ruby("의|사","醫|師")가 와서 #ruby("치|료","治|療")하였으나 손목뼈까지 #ruby("수|갑","手|匣") 끝이 들어가서 부스럼이 터져 생긴 구멍이 컸던 까닭에 #ruby("근","近") 20#ruby("년","年")이 지난 오늘날까지도 손목에 헌 자국이 아직 남아 있다.]
#zh[医生马上来给我治疗，疮口太大，手铐都陷进到骨头里。二十年过去了，直到今天，手腕上还留有瘢痕。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("간|수|장","看|守|長") 말이 “무엇이나 #ruby("수|감|자","收|監|者")가 #ruby("불|편","不|便")한 #ruby("사|정","事|情")이 있을 때는, #ruby("간|수","看|守")에게 #ruby("신|청","申|請")하여 #ruby("전|옥","典|獄")까지도 #ruby("면|회","面|會")하고 #ruby("사|정","事|情")을 말할 수 있으니 #ruby("유|의","留|意")하라”고 한다.]
#zh[看守长又说：]
#zh[“不管怎样，犯人如有什么事，可以向看守提出要求面见典狱官。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄")의 #ruby("규|율","規|律")을 보면 #ruby("수|인","囚|人")들이 #ruby("상|호|간","相|互|間")에 #ruby("담|화","談|話")를 하거나 무슨 #ruby("소|식","消|息")을 #ruby("통","通")하지 못하게 하였으나, 말도 많이 하고 #ruby("소|식","消|息")도 서로 #ruby("신|속","迅|速")하게 #ruby("통","通")했다. 40#ruby("명","名")에 가까운 우리 #ruby("동|지","同|志")들은 무슨 말이나 #ruby("의|견","意|見")이라도 #ruby("충|분","充|分")히 #ruby("교|환","交|換")하고 지냈다.]
#zh[根据狱规，囚犯不得互相谈话，互通消息。但是我们的同志近四十人，只要一有机会，就交谈起来，互相传递讯息，遇事一起商量，交换意见，我了解，同志们现在也是跟我一样的心情。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("심|리","心|理") #ruby("상|태","狀|態")가 #ruby("변","變")한 것은 나뿐 아니었다. #ruby("동|지","同|志")들도 다 #ruby("평|소","平|素")에 #ruby("비","比")하여 크게 #ruby("변","變")했다. 그#ruby("중","中") #ruby("고|정|화","高|貞|華")는 #ruby("용|모","容|貌")부터 #ruby("험|상","險|狀")궂은데다 마음까지 #ruby("변","變")하여 #ruby("옥|중","獄|中")에서 #ruby("소|위","所|謂") #ruby("관|리","官|吏")를 괴롭게 하기로 #ruby("유|명","有|名")했다. 그는 #ruby("음|식","飮|食")을 먹다가 밥에 돌이 있는 것을 #ruby("발|견","發|見")하고는, 땅에서 모래흙을 주워 입에 넣었다. 그리고 이를 밥과 #ruby("혼|합","混|合")하여 싸 가지고 #ruby("전|옥","典|獄") #ruby("면|회","面|會")를 #ruby("청","請")해, #ruby("자|기","自|己")가 받은 1#ruby("년","年") #ruby("징|역","懲|役")을 #ruby("종|신|역","終|身|役")으로 고쳐 달라 하면서 그 #ruby("이|유","理|由")를 다음과 같이 말했다.]
#zh[其中高贞和长得一脸凶相，心态也极不平衡，找狱官的麻烦都出了名。有一次吃着饭，发现饭里夹有砂子，他立即从地上抓起一把土，塞进嘴里，又洒在饭里，包起后要求面见典狱官，提出把他的一年劳役改为终身劳役。他说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("인|간","人|間")은 모래를 먹고 살 수 없는데 내가 먹는 한 그릇 밥에서 골라낸 모래가 밥의 #ruby("분|량","分|量")만 못하지 않으니, 이것을 먹고는 반드시 죽을 것이다. #ruby("기|왕","旣|往") 죽을진댄 #ruby("징|역","懲|役")이나 #ruby("중","重")하게 지고 죽는 것이 #ruby("영|광","榮|光")이다. 1#ruby("년","年")도 #ruby("종|신","終|身")이요, #ruby("종|신","終|身")도 #ruby("종|신","終|身")이 아닌가?”]
#zh[“人怎能靠吃砂土过活？我吃的这碗饭里，砂子几乎占了一半，吃了这种饭还能不死？既然是死，倒不如干重活儿，死了也光荣，反正不就是终身吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|옥","典|獄")은 얼굴#ruby("색","色")이 #ruby("주|홍","朱|紅")같이 되어서 #ruby("식|당","食|堂") #ruby("간|수","看|守")를 불러 꾸짖고 밥 짓는 데에 #ruby("극","極")히 #ruby("주|의","注|意")하여 모래가 없도록 #ruby("개|량","改|良")했다.]
#zh[典狱官脸涨得通红，大声斥责食堂的看守，让他们以后做饭多留些神，不准混进砂子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 며칠 #ruby("후","後"), #ruby("감|방","監|房")에서 #ruby("동|료","同|僚") #ruby("수|인","囚|人")들이 #ruby("의|복","衣|服")에서 #ruby("이","蝨")를 잡는 것을 본 #ruby("고|군","高|君")은, #ruby("비|밀","祕|密")히 #ruby("각","各") 사람에게 #ruby("부|탁","付|託")하여 이를 거두어 모아서 뒤 씻는 종이에 싸놓고, #ruby("간|수","看|守")에게 #ruby("전|옥","典|獄") #ruby("면|회","面|會")를 #ruby("청","請")하였다. #ruby("전|옥","典|獄") 앞에 이 꾸린 것을 내어놓으며,]
#zh[几天后，高君又看到囚犯们在抓虱子，他偷偷地让人们把虱子集中起来，用手纸包好，又跟看守说要面见典狱官。他把脏兮兮的一包东西放在典狱官面前，抗议说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("전","前")날 #ruby("전|옥|장","典|獄|長") #ruby("덕","德")으로 돌 없는 밥을 먹는 것은 #ruby("감|사","感|謝")하나, #ruby("의|복","衣|服")에 이가 끓어서 잠도 잘 수 없고, 깨어도 이 때문에 온몸이 근지러워서 견디기 어렵소.#footnote(numbering: _ => [78)])[#h(0.35em)#ruby("당|시","當|時") #ruby("감|옥","監|獄")의 가장 무서운 #ruby("적","敵")은 빈대와 벼룩이었다. #ruby("신|숙","申|肅")은 “밤이 이미 깊으기에/#ruby("억|제","抑|制")하고 잠을 #ruby("청","請")하니/#ruby("무|정","無|情")한 빈대 벼룩/벌떼같이 달려 든다”며 그의 #ruby("옥|중","獄|中") #ruby("체|험","體|驗")을 말하였다.] #ruby("구|한|국","舊|韓|國")#ruby("시|대","時|代") #ruby("감|옥","監|獄")에는 #ruby("수|인","囚|人")이 #ruby("자|기","自|己") 집에서 #ruby("의|복","衣|服")을 가져다 #ruby("착|용","着|用")할 수 있었으나 #ruby("대|일|본","大|日|本")의 #ruby("문|명","文|明")한 #ruby("법|률","法|律")은 그도 #ruby("허|가","許|可")하지 않으니, 이처럼 #ruby("불|결","不|潔")한 #ruby("의|복","衣|服")을 입으면 #ruby("질|병","疾|病")이 생길까 #ruby("염|려","念|慮")되오.”]
#zh[“上次多蒙典狱长关照，饭里再也没有吃到砂子，这次衣服上又长了这么多虱子，睡觉也睡不好，就是醒着浑身也痒得难受。旧韩国时代囚犯还可以穿自家的衣服，现在按大日本的文明法律已不许可，而穿这样不干净的衣服容易得病，请马上给各监房的犯人换上新囚衣，把旧衣服用蒸气机洗净消毒。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하니, #ruby("즉|시","卽|時")로 #ruby("각","各") #ruby("감|방","監|房")에 새로 만든 #ruby("의|복","衣|服")을 들여오고, 옛 옷은 #ruby("증|기|기|계","蒸|氣|機|械")를 #ruby("사|용","使|用")하여 #ruby("간|간","間|間")이 #ruby("소|독","消|毒")하여 주는 까닭에 다시는 이 잡는 사람이 없게 되었다.]
#zh[这以后再也看不到有人抓虱子了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("서|대|문|감|옥","西|大|門|監|獄")은 ‘#ruby("경|성|감|옥","京|城|監|獄")’이라고 #ruby("문|패","門|牌")를 붙인 때인데, #ruby("수|인","囚|人")의 #ruby("총|수","總|數") 2,000#ruby("명","名") #ruby("미|만","未|滿")에 #ruby("대|부|분","大|部|分")이 #ruby("의|병","義|兵")이요, 그 나머지는 #ruby("소|위","所|謂") #ruby("잡|범","雜|犯")이었다. #ruby("옥|중","獄|中")의 #ruby("대|다|수","大|多|數")가 #ruby("의|병","義|兵")이란 말을 듣고, 나는 #ruby("심","甚")히 #ruby("다|행","多|幸")으로 생각하였다. 그이들은 일찍이 #ruby("국|사","國|事")를 #ruby("위","爲")하여 #ruby("분|투","奮|鬪")한 #ruby("의|기|남|아","義|氣|男|兒")들이니, #ruby("기|개","氣|槪")로나 #ruby("경|험","經|驗")으로 배울 것이 많으리라고 생각했다.]
#zh[那时西大门监狱挂的门牌是“京城监狱”。囚犯总数不到两千，大部分是义兵，其余是所谓杂犯。听说狱中多数是义兵，我觉得非常幸运。他们早先为国事奋斗，是有义气的男儿，气概和经验上该有许多可学的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|방","監|房")에 들어가서 #ruby("차|례|차|례","次|例|次|例") #ruby("인|사","人|事")를 하며 물어보니, #ruby("혹","或")은 ‘#ruby("강|원|도","江|原|道") #ruby("의|병","義|兵")의 #ruby("참|모|장","參|謀|長")’이니 #ruby("혹","或")은 ‘#ruby("경|기|도","京|畿|道") #ruby("의|병","義|兵")의 #ruby("중|대|장","中|隊|長")’이니 하여, #ruby("대|부|분","大|部|分") #ruby("의|병","義|兵") #ruby("두|령","頭|領")이고 #ruby("졸|병","卒|兵")이라는 사람을 보지 못했다. 처음에는 #ruby("극","極")히 #ruby("존|경","尊|敬")하는 마음으로 #ruby("교|제","交|際")를 #ruby("시|작","始|作")하였으나, 얼마 되지 않아 마음 씀씀이와 #ruby("행|동|거|지","行|動|居|止")가 #ruby("순|전","純|全")한 #ruby("강|도","強|盜")로밖에 보이지 않았다. #ruby("참|모|장","參|謀|長")이라 하는 사람이 #ruby("군|대","軍|隊")의 #ruby("규|율","規|律")이나 #ruby("전|략","戰|略")이 무엇인지조차 알지 못할 뿐 아니라, #ruby("의|병","義|兵")을 일으킨 #ruby("목|적","目|的")이 무엇인지, #ruby("국|가","國|家")가 무엇인지도 모르는 사람이 많았고, #ruby("당|시","當|時") #ruby("무|기","武|器")를 가지고 여러 마을을 #ruby("횡|행","橫|行")하면서 #ruby("만|행","蠻|行")한 것을 잘한 일처럼 큰소리쳤다.]
#zh[进了牢房，挨个招呼问过去。有的说是“江原道义兵的参谋长”，有的说是“京畿道义兵的中队长”，大多是义兵头领，没见过一个说自己是士兵的。起初我以极尊敬的心开始交往，不多时，看他们的用心和举动，只像纯粹的强盗。自称参谋长的人，连军队的纪律、战略是什么都不知道，很多人也不知道举义的目的是什么、国家是什么。当时带着武器在各村横行、做下蛮行，他们却像做了好事似的大声吹嘘。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 처음으로 13#ruby("호|방","號|房")에 들어가니, 저녁 #ruby("식|사","食|事") #ruby("후","後") #ruby("공|장","工|場")에 #ruby("사|역","使|役") 나갔던 사람들이 몰려들어와 #ruby("의|복","衣|服")을 갈아입은 #ruby("후","後"), 그#ruby("중","中") 한 #ruby("명","名")이 나에게 물었다.]
#zh[我初次进了十三号房。晚饭后，出役到工场的人涌进来，换了衣服，其中一个人问我：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보 #ruby[신참수][新囚], 어디 살았으며, #ruby("죄|명","罪|名")은 무엇이고, #ruby("역","役")은 얼마나 졌소?”]
#zh[“喂，新囚犯，你住在哪儿，罪名是什么，判了多少年？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("일|일","一|一")이 #ruby("대|답","對|答")했다. 이 구석 저 구석에서 #ruby("질|문","質|問")과 #ruby("반|박","反|駁")이 #ruby("연","連")이어 나왔다.]
#zh[我一一回答。这个角落那个角落，质问和反驳接连而来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보 #ruby[신참수][新囚], 똥통을 #ruby("향","向")하여 절하시오.”]
#zh[“喂，新囚犯，向粪桶行礼！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("좌|상","座|上")에 절하시오.”]
#zh[“向座上行礼！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그 사람 생김생김이 #ruby("강|도","強|盜")질할 때는 무서웠겠는데……, #ruby("강|도","強|盜")질하던 이야기나 좀 들읍시다.”]
#zh[“看这人的长相，做强盗的时候一定很吓人……把做强盗的事讲给我们听听。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[함부로 #ruby("무|질|서","無|秩|序")하게 #ruby("조|리","條|理") 없이 떠드는 판에 어떤 말을 #ruby("대|답","對|答")해야 할지 몰라 #ruby("잠|잠","潛|潛")히 앉아 있었다. 어떤 #ruby("자","者")는]
#zh[他们乱哄哄、没头没脑地嚷，我不知道该回答哪一句，静静坐着。有一个人说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이게 어디서 굴러먹던 #ruby("도|적","盜|賊")놈이야. 사람이 묻는 말에 #ruby("대|답","對|答")이 없으니. #ruby("신|문","訊|問")할 때 그같이 #ruby("대|답","對|答") 안했으면 #ruby("율","律")을 지지 안치.”#footnote(numbering: _ => [79)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("형","刑")을 받지 않지.” #ruby("심|문","審|問") 당할 때 #ruby("죄","罪")를 말하지 않았다면 #ruby("형","刑")을 받지 않았을 것이라는 뜻.]]
#zh[“这是从哪儿混来的贼。人家问话也不回答。受审的时候要是也这样不回答，就不会判刑了。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("조|소","嘲|笑")와 #ruby("능|욕","凌|辱")이 끝이 없다. 나는 ‘이곳은 #ruby("하|등","下|等")들만 몰아넣은 #ruby("잡|수|칸","雜|囚|間")인가 보다’ #ruby("잠|잠","潛|潛")히 앉아 있었다.]
#zh[嘲笑和侮辱没完。我想，这里大概是把下等人赶在一起的杂囚间，仍旧静静坐着。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[조금 지나, 어떤 #ruby("조|선","朝|鮮") #ruby("간|수","看|守") 한 사람이 와서 나에게 물었다.]
#zh[过了一会儿，一个朝鲜看守来问我：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“56#ruby("호","號")는 #ruby("구|치|감","拘|置|監")에서 나왔소?”]
#zh[“五十六号是从拘置监来的吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇습니다.”]
#zh[“是的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("공|판","公|判")할 때 #ruby("참|관","參|觀")하였지만 #ruby("심","甚")히 #ruby("애|석","哀|惜")한 일이오. #ruby("운|수","運|數")가 다한 탓이니 어찌하겠소. 마음이나 #ruby("편","便")하게 가질 수밖에 없지요.”]
#zh[“公审的时候我去旁听了，实在可惜。运数尽了，有什么办法。只好把心放宽些。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("간|수","看|守")가 #ruby("대|단","大|端")히 #ruby("동|정","同|情")하는 빛을 보이고 돌아가자, 그 다음은 #ruby("일|인","日|人") #ruby("간|수","看|守")들이 몰려와서 내 #ruby("명|패","名|牌")와 얼굴을 보고 수군거린다.]
#zh[那看守显出非常同情的样子，回去了。接着日本看守们涌来，看着我的名牌和脸，嘀咕着。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("방","房")안에서 한참 #ruby("야|단","惹|端")으로 떠들던 #ruby("죄|수","罪|囚")들이 다시금 수군댄다.]
#zh[房间里闹了好一阵的囚犯又嘀咕起来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이야! #ruby("박|간|수","朴|看|守") 나리가 저 #ruby[신참수][新囚]를 #ruby("존|경","尊|敬")하니, #ruby("관|리","官|吏")가 #ruby("죄|수","罪|囚")에게 #ruby("공|대","恭|待")하는 #ruby("모|양","模|樣")은 처음 보겠다.”]
#zh[“呀！朴看守大人尊敬这个新囚犯。当官的对囚犯这样恭敬，我还是头一次见。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("박|간|수","朴|看|守") 나리의 #ruby("친|척","親|戚") 어른인 게지.”]
#zh[“大概是朴看守大人的亲戚长辈。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 떠드는데, 한 사람이 #ruby("정|숙","靜|肅")하게 물어왔다.]
#zh[他们这样嚷着，有一个人郑重地问过来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby[신참수][新囚]는 #ruby("박|간|수","朴|看|守") 나리와 어떻게 되시오?”]
#zh[“新囚犯和朴看守大人是什么关系？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("박|간|수","朴|看|守")인지, #ruby("이|간|수","李|看|守")인지 나는 모르오.”]
#zh[“朴看守还是李看守，我不知道。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 #ruby("이|전","以|前")에 무슨 높은 벼슬을 지냈소?”]
#zh[“那么你以前做过什么高官？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 벼슬하지 않았소.”]
#zh[“我没有做过官。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러자 그#ruby("중","中") 한 사람이 또 물었다.]
#zh[于是其中又有一个人问：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신, #ruby("양|기|탁","梁|起|鐸")을 아시오?”]
#zh[“你认识梁起铎吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("짐|작","斟|酌")하지요.”]
#zh[“约略知道。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“옳지, 저 #ruby[신참수][新囚]도 #ruby("국|사|범","國|事|犯") #ruby("강|도","強|盜")인가 보다. 3#ruby("일","日") #ruby("전","前") 『#ruby("대|한|매|일|신|보","大|韓|每|日|申|報")』 #ruby("사|장","社|長") #ruby("양|기|탁","梁|起|鐸")이란 #ruby[신참수][新囚]가 들어왔고, 그 #ruby("공|범","共|犯")으로 #ruby("유|명","有|名")한 #ruby("신|사","紳|士") 여러 #ruby("명","名")이 #ruby("역","役")을 졌다고 아무개 #ruby("간|수","看|守") 나리가 말씀하더라. 그러면 저 #ruby[신참수][新囚]도 #ruby("신|사","紳|士")이므로 우리가 묻는 말에 #ruby("대|답","對|答")도 잘 아니하는가 보군. 아니꼬운 놈, 나도 #ruby[허왕산][旺山]#footnote(numbering: _ => [80)])[#h(0.35em)#ruby("구|한|말","舊|韓|末") #ruby("저|명","著|名")한 #ruby("의|병|장","義|兵|將") #ruby[허|위][許|蔿]\(1855〜1908)의 #ruby("호","號"). #ruby[허|위][許|蔿]는 1907#ruby("년","年") #ruby("정|미","丁|未") 7#ruby("조|약","條|約")과 #ruby("강|제|적","強|制|的")인 #ruby("군|대","軍|隊") #ruby("해|산","解|散")에 #ruby("반|대","反|對")하여 #ruby("의|병","義|兵")을 일으켜 서울 #ruby("진|공|작|전","進|攻|作|戰")을 세웠다가 #ruby("실|패","失|敗")하고, 1908#ruby("년","年") 6#ruby("월","月") #ruby("체|포","逮|捕")되어 10#ruby("월","月") 21#ruby("일","日") #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 #ruby("처|형","處|刑")되었다.] 밑의 #ruby("당|당","堂|堂")한 #ruby("참|모|장","參|謀|長")이야. 여기서 #ruby("교|만","驕|慢")을 부려봐야 #ruby("소|용","所|用")없다.”]
#zh[“对了，这个新囚犯也是国事犯强盗吧。三天前《大韩每日申报》社长梁起铎这个新囚犯进来了，他的同犯、好几位有名的绅士都判了刑，某某看守大人这么说的。那么这个新囚犯也是绅士，所以我们问话他也不好好回答。讨厌的家伙。我也是许旺山下堂堂的参谋长。在这儿摆架子没有用。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 처음에 그 #ruby("자","者")들을 #ruby("하|등","下|等") #ruby("잡|범","雜|犯")들로만 알았다가, #ruby("허|위","許|蔿")의 #ruby("부|하","部|下")라는 말을 듣고서는 #ruby("심","甚")히 #ruby("통|탄","痛|歎")하였다. 저런 #ruby("자","者")가 #ruby("참|모|장","參|謀|長")이었으니, #ruby("허|위","許|蔿") #ruby("선|생","先|生")이 #ruby("실|패","失|敗")하였을 것은 불 보듯 #ruby[뻔한][明若觀火] 것 아닌가.#footnote(numbering: _ => [81)])[#h(0.35em)#ruby("매|천","梅|泉") #ruby("황|현","黃|玹")도 “#ruby("의|병","義|兵")에 #ruby("도|적|배","盜|賊|輩")와 다름없는 이들이 많다”고 #ruby("개|탄","慨|歎")한 바 있다.]]
#zh[我起初只把他们当作下等杂犯，一听说是许芳的部下，非常痛叹。这样的人当了参谋长，许芳先生的失败不是洞若观火的事吗。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|중","獄|中")에 #ruby("전","傳")해오는 이야기가 있었다. #ruby("이|강|년","李|康|秊")#footnote(numbering: _ => [82)])[#h(0.35em)#ruby[이|강|년][李|康|秊]\(1858〜1908). #ruby("호","號")는 #ruby("운|강","雲|崗"). #ruby("고|종","高|宗") 17#ruby("년","年")\(1880) #ruby("무|과","武|科")에 #ruby("급|제","及|第")하였다가 #ruby("갑|신|정|변","甲|申|政|變")이 일어나자 #ruby("낙|향","落|鄕")하였고, 1895#ruby("년","年") #ruby("문|경","聞|慶")에서 #ruby("의|병","義|兵")을 일으켜 #ruby("탐|관|오|리","貪|官|汚|吏")를 #ruby("처|단","處|斷")했다. 1897#ruby("년","年") #ruby("만|주","滿|洲")에서 #ruby("의|병","義|兵")을 #ruby("모|집","募|集")하여 #ruby("왜|적","倭|賊")과 싸우고, 1905#ruby("년","年") #ruby("을|사|조|약","乙|巳|條|約") #ruby("이|후","以|後") 다시 #ruby("봉|기","蜂|起")하였으며, 1907#ruby("년","年") #ruby("군|대","軍|隊") #ruby("해|산","解|散") #ruby("후","後") #ruby("민|긍|호","閔|肯|鎬") #ruby("부|대","部|隊")와 #ruby("공|동|작|전","共|同|作|戰")으로 큰 #ruby("전|공","戰|功")을 세웠다. 서울 #ruby("진|공|계|획","進|攻|計|劃")을 세웠다가 #ruby("청|풍","淸|風") #ruby("금|수|산|전|투","金|水|山|戰|鬪")에서 #ruby("체|포","逮|捕")되어, 1908#ruby("년","年") #ruby("사|형","死|刑")당했다.] #ruby("선|생","先|生")과 #ruby("허|위","許|蔿") #ruby("선|생","先|生")은 #ruby("왜|적","倭|賊")에게 #ruby("체|포","逮|捕")되어, #ruby("신|문","訊|問")과 #ruby("재|판","裁|判")을 받지 않고 #ruby("사|형","死|刑")당하시기까지 #ruby("왜|적","倭|賊")을 더럽게 여기며 꾸짖다가 #ruby("순|국","殉|國")하셨는데, 그#ruby("후","後") #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 #ruby("사|용","使|用")하던 #ruby("자|래|정","自|來|井")이 #ruby("허|위","許|蔿") #ruby("선|생","先|生") #ruby("사|형|일","死|刑|日")로부터 우물물이 벌겋게 흐려져 #ruby("폐|정","廢|井")되었다는 것이다.]
#zh[狱中流传着这样一个故事：李康年和许芳两先生，被日寇逮捕后，不接受审讯判决，痛骂日寇，遂被处死殉国。西大门监狱原有一口自来井，从许芳先生服刑之日起，井水变红，浑浊不堪，变成一口废井。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그처럼 서릿발 같은 #ruby("절|의","節|義")를 듣고 생각해보니 부끄럽기 끝이 없었다. #ruby("정|신","精|神")은 #ruby("정|신","精|神")대로 잘 #ruby("보|존","保|存")하지만, #ruby("왜","倭")놈에게 소·말이나 #ruby("야|만|인","野|蠻|人") #ruby("대|우","待|遇")를 받는 나로서 #ruby("당|시","當|時") #ruby("의|병","義|兵")들의 #ruby("자|격","資|格")을 #ruby("평|론","評|論")할 #ruby("용|기","勇|氣")가 있을까? #ruby("지|금","只|今") 내가 #ruby("의|병","義|兵") #ruby("죄|수","罪|囚")를 #ruby("무|시","無|視")하지만, 그 #ruby("영|수","領|袖")인 #ruby("허|선|생","許|先|生")·#ruby("이|선|생","李|先|生")의 #ruby("혼|령","魂|靈")이 나의 눈앞에 #ruby("출|현","出|現")하여 #ruby("엄|중","嚴|重")한 #ruby("질|책","叱|責")을 하는 듯싶다.]
#zh[听到他们两位保持着这样冰清玉洁的气节，我自愧不如。我虽然仍保持着原来的精神，没有变节，但倭寇把我视为牛马，我受到了野蛮的对待，哪里还有资格来评论当时的义兵呢？我轻视义兵囚犯，现在就好像受到了他们的领袖许、李两先生灵魂的严厉斥责。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘옛날 #ruby("의|병","義|兵")은 네가 보는 바와 같이 #ruby[무식한][目不識丁] 것들이니 #ruby("국|가","國|家")에 #ruby("대","對")한 #ruby("의|무","義|務")도 #ruby("이|해","理|解")하지 못하는 것이 #ruby("사|실","事|實")이나, 너는 일찍이 #ruby("고|후|조","高|後|凋")에게 #ruby("의|리","義|理")가 무엇인지 가까이서 배웠고, 그이에게서 배운 #ruby("금|언","金|言") #ruby("중","中")에 #ruby("삼|척|동|자","三|尺|童|子")라도 개나 #ruby("양","羊")을 가리켜 절을 시키면 반드시 크게 #ruby("노","怒")하며 #ruby("불|응","不|應")한다는 말을, #ruby("강|단","講|壇")에서 #ruby("신|성","神|聖")한 #ruby("제|2|세","第|二|世") #ruby("국|민","國|民")에게 #ruby("연|설","演|說")하던 네가, 머리를 숙여 #ruby("왜","倭")놈 #ruby("간|수","看|守")에게 #ruby("예","禮")를 하느냐? 네가 #ruby("항|상","恒|常") #ruby("암|송","暗|誦")하는 #ruby("고|인","古|人")의 #ruby("시","詩") 가운데,]
#zh[“从前的义兵，正如你所见，是些没有学问的人，不懂得对国家的义务，这是事实。可是你早先在高后凋身边，近处学过什么是义理。他教你的金言里有一句：哪怕三尺童子，若指着狗或羊叫他下拜，也一定大怒不从。你在讲台上，对神圣的第二代国民演说过这话，如今却低下头，向倭寇看守行礼吗？你平日总是暗诵古人的诗，其中说：]
#quote-block[남이 해준 #ruby("음|식","飮|食")을 먹고 남이 만들어 준 옷을 #ruby("입거늘","食人之食衣人衣")]
#zh[吃着别人给的饭，穿着别人做的衣，]
#quote-block[품은 뜻은 #ruby("평|생","平|生") 어기지 말아야 한다. (所志平生莫有違)]
#zh[怀抱的志向，终身不可违背。]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[는 #ruby("귀|절","句|節")을 #ruby("망|각","忘|却")하였느냐? 네가 어려서부터 늙어서까지 스스로 #ruby("농|사","農|事") 짓지 않고 스스로 옷을 짜지 않아도 #ruby("대|한","大|韓")의 #ruby("사|회","社|會")가 너를 입히고 먹였는데, #ruby("금|일","今|日") #ruby("왜","倭")놈이 먹이는 콩밥이나 먹고 붉은 #ruby("의|복","衣|服")이나 입히는 데 #ruby("순|종","順|從")하라고 먹이고 입혔느냐? #ruby("명|색","名|色")이야 #ruby("의|병","義|兵")이든 #ruby("도|적","盜|賊")이든, #ruby("왜","倭")놈에 #ruby("순|종","順|從")하는 #ruby("백|성","順|民")이 아니라고 #ruby("인|정","認|定")하여, #ruby("종|신","終|身")이니 10#ruby("년","年")이니 #ruby("감|금","監|禁")하여 두는 것으로도 #ruby("족","足")히 #ruby("의|병","義|兵")의 #ruby("가|치","價|値")를 #ruby("인|정","認|定")할 수 있지 않으냐? #ruby("남|아","男|兒")는 #ruby("의","義")로 죽을지언정 #ruby("구|구","區|區")히 살지 않는다고 #ruby("평|일","平|日")에 어린 #ruby("학|생","學|生")을 가르치더니, 네가 #ruby("금|일","今|日") 살아 있는 것이냐, 죽은 것이냐? 네가 개 같은 #ruby("생|활","生|活")을 견뎌 지내고서 17#ruby("년","年") #ruby("후","後")에 #ruby("장|차","將|次") #ruby("공","功")을 세워 #ruby("죄","罪")를 갚을 #ruby("자|신","自|信")이 있느냐?’]
#zh[这两句你忘掉了吗？你从小到老，自己不耕田，自己不织布，大韩的社会给你衣食。今天倭寇喂你豆饭、给你穿红衣，难道供你吃穿是要你顺从吗？名义上不论叫义兵还是盗贼，他们不被认作顺从倭寇的百姓，关着终身也好、十年也好，也就足以承认义兵的价值，不是吗？男儿宁为义而死，不苟且偷生。你平日这样教幼小的学生，你今天是活着，还是死了？你忍受着猪狗一样的生活，十七年之后，有把握立功来赎罪吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이같은 생각을 하며 #ruby("심|신","心|身")이 #ruby("극|도","極|度")로 #ruby("혼|란","混|亂")한 때, 마침 #ruby("안|명|근","安|明|根") #ruby("형","兄")이 나에게 #ruby("조|용","從|容")히 이런 말을 한다.]
#zh[一想到这儿，我心神不宁，极端苦恼。]
#zh[恰在此时，安明根跟我悄悄地说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("감|옥","監|獄")에 들어온 #ruby("후","後") 아무리 생각하여 보아도 하루를 살면 하루가 #ruby("욕","辱")되고 이틀을 살면 이틀이 #ruby("욕","辱")되니, 굶어 죽으려고 생각합니다.”]
#zh[“我自入狱以来，总是认为一日不死，即受一日之辱，两天不死，即受两天之辱，我想绝食而死。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("쾌","快")히 #ruby("찬|성","贊|成")하였다.]
#zh[我毫不考虑地回答说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("가|능","可|能")하거든 #ruby("단|행","斷|行")하시오.”]
#zh[“办得到就那么办。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날부터 #ruby("명|근","明|根") #ruby("형","兄")은 #ruby("단|식","斷|食")을 했다. #ruby("자|기","自|己") #ruby("분|량","分|量")의 #ruby("음|식","飮|食")은 다른 #ruby("수|인","囚|人")들에게 나눠주고 #ruby("자|기","自|己")는 굶었다. #ruby("연","連") 4, 5#ruby("일","日")을 굶으니 #ruby("기|력","氣|力")이 #ruby("탈|진","脫|盡")하여 #ruby("운|신","運|身")을 못하게 되었다. #ruby("간|수","看|守")가 물으면 배가 아파서 밥을 안 먹는다고 하나, 눈치 밝은 #ruby("왜","倭")놈들이 #ruby("병|원","病|院")으로 옮겨 #ruby("진|찰","診|察")해도 아무 #ruby("병","病")이 없으므로, #ruby("명|근","明|根") #ruby("형","兄")을 뒷짐을 지우고 #ruby("계|란","鷄|卵")을 풀어 억지로 입에 부어넣었다.]
#zh[从那一天开始，安明根就以肚子痛为由，把他的每顿饭都分给别的囚犯，这样继续了四五天没吃东西，因此他虚脱得只剩下奄奄一息。眼快的日本鬼子自然不会信他的话，把他转到医院看病，诊断结果知道没病，便把安明根反绑起来，强行打开他的嘴，灌进了鸡蛋等一类流质食物，因此挽回了一条垂死的生命。在这里连死的自由都没有。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 #ruby("봉|변","逢|變")을 당한 #ruby("명|근","明|根") #ruby("형","兄")은 나에게 #ruby("기|별","寄|別")했다.]
#zh[安明根又通知我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“저는 하는 수 없이 #ruby("금|일","今|日")부터 #ruby("음|식","飮|食")을 먹습니다.”]
#zh[“我又开始吃饭了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("전","傳")하여 일러주었다.]
#zh[我转告他说。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("살|활|자|유","殺|活|自|由")라는 부처님이라도 #ruby("입|차|문|내","入|此|門|內")하야는 #ruby("막|존|지|해","莫|存|知|解")일 것이니 #ruby("자|중","自|重")하라.”#footnote(numbering: _ => [83)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “죽이고 살리는 것을 마음대로 하는 부처님이라도, #ruby("감|옥","監|獄") 안에 들어와서는 어찌할 수 없을 것이니 #ruby("자|중","自|重")하시오.”]]
#zh[“就是有生杀自由的佛，进了这门也得莫存知解，你要自重。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|중","獄|中")에서 #ruby("고","故") #ruby("이|재|명","李|在|明") #ruby("의|사","義|士")의 #ruby("동|지","同|志")들을 #ruby("상|봉","相|逢")하니, #ruby("김|정|익","金|貞|益")·#ruby("김|용|문","金|龍|文")·#ruby("박|태|은","朴|泰|殷")·#ruby("이|응|삼","李|應|三")·#ruby("전|태|선","全|泰|善")·#ruby("오|복|원","吳|復|元") #ruby("등","等")과 #ruby("안|중|근","安|重|根") #ruby("의|사","義|士")의 #ruby("동|지","同|志") #ruby("우|덕|순","禹|德|淳")#footnote(numbering: _ => [84)])[#h(0.35em)#ruby("원|문","原|文"): “禹德順”. ‘禹德順’은 #ruby[우|덕|순][禹|德|淳]\(1880〜1950). #ruby("안|중|근","安|重|根")의 #ruby("동|료","同|僚")로 #ruby("조|도|선","趙|道|先")·#ruby("유|동|하","劉|東|夏") #ruby("등","等")과 함께 잡혀 3#ruby("년|형","年|刑")을 받았다.] #ruby("등","等")이다.#footnote(numbering: _ => [85)])[#h(0.35em)#ruby("김|정|익","金|貞|益")은 15#ruby("년|형","年|刑"), #ruby("김|용|문","金|龍|文")·#ruby("전|태|선","全|泰|善")은 10#ruby("년|형","年|刑"), #ruby("이|응|삼","李|應|三")은 5#ruby("년|형","年|刑")을 받았다.] 첫 #ruby("대|면","對|面")이지만 마치 오래 된 것 같아 서로 사랑하는 #ruby("정","情")이 있을 뿐 아니라, 마음가짐과 일 #ruby("처|리","處|理")에서도 #ruby("의|병|수","義|兵|囚")들에 #ruby("비","比")하면 #ruby("대|부|분","大|部|分") 뭇닭 속의 #ruby("봉|황","鳳|凰") 같은 느낌이었다.]
#zh[在狱中遇到了故友李在明义士的同志们，他们是金正益、金龙文、朴泰殷、李应三、田泰善、吴复元等，也有安重根义士的同志禹德顺等。我们真是一见如故，互相敬重。他们的为人处事，与那些义兵囚犯相比，犹如鹤立鸡群。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|좌|진","金|佐|鎭")은 #ruby("침|착","沈|着")하고 굳세며 #ruby("용|감","勇|敢")한 #ruby("청|년","靑|年")으로 #ruby("국|사","國|事")를 #ruby("위","爲")하여 무슨 #ruby("운|동","運|動")을 하다가 #ruby("투|옥","投|獄")되었는데, #ruby("친|애","親|愛")의 #ruby("정","情")을 서로 #ruby("표","表")하였다. #ruby("점|차","漸|次")로 #ruby("옥|중","獄|中")에도 #ruby("생|활","生|活")의 #ruby("취|미","趣|味")가 있음을 깨닫게 되었다.]
#zh[金佐镇是个刚强勇敢的青年，为国事展开活动，不幸被捕入狱，我们彼此建立了感情，逐渐对狱中生活也感到了一些乐趣。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("서|대|문|옥","西|大|門|獄")에 갇힌 지 며칠 #ruby("후","後") 또 #ruby("중|대","重|大") #ruby("사|건","事|件")이 #ruby("발|생","發|生")하니, #ruby("왜","倭")놈의 이른바 #ruby("제|2|차","第|二|次") 뭉우리돌 줍는 #ruby("사|건","事|件")이다. #ruby("제|1|차","第|一|次")는 #ruby("황|해|도","黃|海|道") #ruby("안|악","安|岳")을 #ruby("중|심","中|心")으로 하여 40#ruby("여","餘") #ruby("명","名") #ruby("인|사","人|士")를 #ruby("타|살","打|殺")·#ruby("징|역","懲|役")·#ruby("유|배","流|配")의 세 #ruby("종|류","種|類")로 #ruby("처|결","處|決")한 것이었다. 그런데 이번에는 #ruby("평|안|도","平|安|道") #ruby("선|천","宣|川")을 #ruby("중|심","中|心")으로 #ruby("애|국|인|사","愛|國|人|士")를 #ruby("일|망|타|진","一|網|打|盡")하여 105#ruby("명","名")을 #ruby("검|거","檢|擧")·#ruby("취|조","取|調")했다.#footnote(numbering: _ => [86)])[#h(0.35em)#ruby("일|제","日|帝")는 1910#ruby("년","年") 12#ruby("월","月") 27#ruby("일","日") #ruby("압|록|강","鴨|綠|江") #ruby("철|교|준|공|식","鐵|橋|竣|工|式")에 #ruby("참|가","參|加")하려는 #ruby("사이토","寺內正毅") #ruby("총|독","總|督")을 #ruby("암|살","暗|殺")하려고 #ruby("모|의","謀|議")하였다는 #ruby("혐|의","嫌|疑")로 #ruby("애|국|지|사","愛|國|志|士")들 600#ruby("여","餘") #ruby("명","名")을 #ruby("검|거","檢|擧")·#ruby("투|옥","投|獄")하였고, 그#ruby("중","中") 105#ruby("명","名")을 #ruby("기|소","起|訴")하였다. 이를 이른바 ‘105#ruby("인","人") #ruby("사|건","事|件")’이라 한다.]]
#zh[我关进西大门狱几天之后，又发生了重大事件，就是倭寇所谓第二次捡圆石头的事件。第一次以黄海道安岳为中心，把四十余名人士分处死、徒刑、流放三种了结。这一次以平安道宣川为中心，把爱国人士一网打尽，逮捕审讯了一百零五名。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이미 #ruby("제|1|차","第|一|次") #ruby("소|위","所|謂") #ruby("보|안","保|安") #ruby("사|건","事|件")으로 2#ruby("년|형","年|刑")을 #ruby("집|행","執|行")받고 있던 #ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("옥|관|빈","玉|觀|彬")과, #ruby("유|배|형","流|配|刑")에 #ruby("처","處")하였던 #ruby("이|승|훈","李|昇|薰")까지 다시 집어넣고 #ruby("신|문","訊|問")을 #ruby("개|시","開|始")하였다. 이것은 #ruby("기|존","旣|存")의 #ruby("보|안|율","保|安|律")로 2#ruby("년","年")만 지운 것이 #ruby("왜","倭")의 마음에 #ruby("미|흡","未|洽")하여 좀더 지우자는 #ruby("야|만|적","野|蠻|的")인 생각에서 나온 것이었다. 나와 #ruby("김|홍|량","金|鴻|亮")도 15#ruby("년","年")에 2#ruby("년","年") #ruby("역","役")을 더하여 #ruby("합","合") 17#ruby("년","年")의 #ruby("역","役")을 졌다.#footnote(numbering: _ => [87)])[#h(0.35em)105#ruby("인","人") #ruby("사|건","事|件")의 #ruby("최|종","最|終") #ruby("판|결","判|決")에서는 99#ruby("명","名")이 #ruby("무|죄","無|罪") #ruby("석|방","釋|放")되고 #ruby("윤|치|오","尹|致|旿")·#ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("이|승|훈","李|昇|薰")·#ruby("임|치|정","林|蚩|正")·#ruby("옥|관|빈","玉|觀|彬") #ruby("등","等") 6#ruby("명","名")만 #ruby("징|역","懲|役") 4#ruby("년","年")을 #ruby("선|고","宣|告")받았다. #ruby("백|범","白|凡")이 #ruby("김|홍|량","金|鴻|亮")과 같이 2#ruby("년|형","年|刑")을 더 받았다고 하는 것은 #ruby("착|오","錯|誤")로 보인다. #ruby("백|범","白|凡")의 #ruby("총|형|량","總|刑|量")은 #ruby("안|명|근","安|明|根") #ruby("사|건","事|件")으로 받은 15#ruby("년","年")이다.]]
#zh[已经因第一次所谓保安事件在执行二年刑的梁起铎、安泰国、玉观彬，和被处流放的李升薰，又被抓进来开始审问。这是因为按原有的保安律只判了二年，倭寇心里不足，想再加重，出于这种野蛮的想法。我和金鸿亮也在十五年上再加二年劳役，合计十七年。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어느날 #ruby("간|수","看|守")가 와서 나를 #ruby("면|회|소","面|會|所")로 데려갔다. 누가 왔는가 하고 기다리노라니, #ruby("판|자","板|子") #ruby("벽","壁")에서 딸깍 하고 주먹이 하나 드나들 만한 구멍이 열렸다. 그리로 내다보니 어머님이 서 계셨고, 곁에 #ruby("왜","倭")놈 #ruby("간|수","看|守")가 지키고 섰다.]
#zh[有一天看守来，把我带到面会所。我等着看是谁来了，板壁上咔哒一声，开了一个能伸进拳头的洞。往外一看，母亲站在那里，旁边站着倭寇看守。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("근","近") 일고여덟 달 만에 #ruby("면|회","面|會")하는 어머님은 #ruby("태|연","泰|然")하신 #ruby("안|색","顔|色")으로 말씀하셨다.]
#zh[将近七八个月才面会的母亲，神色泰然地说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 네가 #ruby("경|기","京|畿") #ruby("감|사","監|司")나 한 것보담 더 기쁘게 생각한다. 네 #ruby("처","妻")와 #ruby("화|경","花|慶")이까지 데리고 와서 #ruby("면|회","面|會")를 #ruby("청","請")했는데, 한 #ruby("번","番")에 한 사람밖에 #ruby("허|락","許|諾")하지 않는대서 네 #ruby("처","妻")와 #ruby("화|경","花|慶")이는 저 밖에 있다. 우리 세 #ruby("식|구","食|口")는 #ruby("평|안","平|安")히 잘 있다. #ruby("옥|중","獄|中")에서 몸이나 잘 있느냐? 우리 근심 말고 네 몸이나 잘 #ruby("보|중","保|重")하기 바란다. #ruby("만|일","萬|一") #ruby("식|사","食|事")가 #ruby("부|족","不|足")하거든 하루에 #ruby("사|식","私|食") 두 #ruby("번","番")씩을 들여주랴?”]
#zh[“我认为这样比你做了京畿监史还值得高兴。因为规定一次只准一个人会面，所以你的妻子和女儿化敬都在外面等着哩，我们三个人过得很好，你不必挂念，希望在牢中好好保重身体；如果饭不够吃的话，我们每天送两次来给你好吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[오랜만에 #ruby("모|자","母|子") #ruby("상|봉","相|逢")하니 나는 반가운 마음과 더불어, 저같이 씩씩한 #ruby("기|절","氣|節")을 가지신 어머님께서 개 같은 #ruby("원|수","怨|讐") #ruby("왜","倭")놈에게 #ruby("자|식","子|息") 보여 달라고 #ruby("청|원","請|願")하였다고 생각하니 #ruby("황|송","惶|悚")한 마음이 그지없다. 다른 #ruby("동|지","同|志")들의 #ruby("면|회","面|會") #ruby("정|황","情|況")을 들어보면, #ruby("부|모","父|母") #ruby("처|자","妻|子")가 와서 서로 #ruby("대|면","對|面")하면 울기만 하다가 #ruby("간|수","看|守")의 #ruby("제|지","制|止")로 말 한마디도 못하였다는 것이 #ruby("보|통","普|通")인데, 우리 어머님은 참 놀랍다고 생각된다. 나는 17#ruby("년","年") #ruby("징|역","懲|役") #ruby("선|고","宣|告")를 받고 돌아와서 잠은 #ruby("전","前")과 같이 잤어도 밥은 한 끼를 먹지 못한 적이 있는데, 어머님은 어찌 저렇게 #ruby("강|인","強|靭")하신가 #ruby("탄|복","歎|服")하였다.]
#zh[隔了许久，母子相见。我心里高兴，同时又想，母亲有这样刚强的气节，却向狗一样的仇敌倭寇请求要看儿子，心里惶恐无尽。听别的同志说面会的情形，父母妻子来了，对面只是哭，看守一制止，连一句话也说不成，这是寻常。我们的母亲实在令人吃惊。我被宣告十七年徒刑回来，觉还照旧睡，饭却有一顿没吃成的时候。母亲怎么这样刚强，我叹服了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("실","實")로 말 한마디를 못하였다. 그러다 #ruby("면|회|구","面|會|口")가 닫히고, 어머님께서 머리를 돌리시는 것만 보고, 나도 끌려 #ruby("감|방","監|房")으로 돌아왔다. 어머님이 나를 #ruby("대","對")하여서는 #ruby("태|연","泰|然")하셨으나, 돌아서 나가실 때는 반드시 눈물에 발부리가 보이지 않았을 것이다. 어머님이 #ruby("면|회","面|會") 오실 때 아내와는 물론 많은 #ruby("상|의","商|議")가 있었을 것이요, 내 #ruby("친|구","親|舊")들도 #ruby("주|의","注|意")를 해드렸을 듯하지만, #ruby("일|단","一|旦") 만나면 울음을 참기가 #ruby("지|극","至|極")히 어려울 것인데, 어머님은 참 놀라운 어른이다.]
#zh[我实在一句话也说不出。面会口关上了，只看见母亲转过头去，我也被拉回牢房。母亲对着我是泰然的，转身出去的时候，一定泪水遮住了脚边。母亲来面会，和妻子当然商量过许多，我的朋友们也像嘱咐过她。一旦见了面，忍住哭是极难的，母亲真是了不起的人。]
#heading(level: 3)[#text(font: "KOPUSGo B")[9) #ruby("옥|중","獄|中")의 #ruby("의","衣")·#ruby("식","食")·#ruby("주","住")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|중|생|활","獄|中|生|活")을 #ruby("일|일","一|一")이 #ruby("기|록","記|錄")하기는 #ruby("불|가|능","不|可|能")하나, #ruby("의","衣")·#ruby("식","食")·#ruby("주","住")·#ruby("행","行")을 #ruby("각|각","各|各") 나누어 쓰면서 그때 #ruby("체|험","體|驗")하고 #ruby("목|격","目|擊")한 것과 나의 #ruby("생|활","生|活")하던 #ruby("진|상","眞|相")을 말하고자 한다.]
#zh[狱中的生活不可能一一叙述，只能就衣食住行等方面把我亲自体验或亲眼见到的说一说，也谈谈我的生活真相。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("각","各") #ruby("수|인","囚|人")들은 #ruby("소|위","所|謂") #ruby("판|결","判|決")을 받기 #ruby("전","前")에는 #ruby("자|기","自|己")의 #ruby("의|복","衣|服")을 입거나 #ruby("자|기","自|己") #ruby("의|복","衣|服")이 없으면 #ruby("청|색","靑|色") 옷을 입다가, #ruby("기|결","旣|決")되어 #ruby("복|역","服|役")하는 #ruby("시|간","時|間")부터 붉은 옷을 입으니, #ruby("조|선","朝|鮮") #ruby("복|식","服|飾")으로 만들어 입는다. #ruby("입|동","立|冬") #ruby("시|기","時|期")부터 #ruby("춘|분","春|分")까지는 #ruby("면|옷","棉|衣")을 입히고, #ruby("춘|분","春|分")에서 #ruby("입|동","立|冬")까지는 #ruby("홑|옷","單|衣")을 입히되, #ruby("병","病")든 #ruby("수|인","囚|人")에게는 흰옷을 입혔다.]
#zh[囚犯们在判决前都穿着自己的衣服，如自己没有，则发给你青色囚衣。判刑后的服役期间则发给朝鲜式红色囚衣。从立冬到春分穿棉衣，春分以后穿单衣，病号则穿白色囚衣。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("식|사","食|事")는 하루 3#ruby("회","回")로 #ruby("분|배","分|配")하는데, 그 #ruby("재|료","材|料")는 #ruby("조|선","朝|鮮") #ruby("각","各") #ruby("도","道")에서 #ruby("각|기","各|其") 그 #ruby("지|방","地|方")에서 아주 헐한 #ruby("곡|물","穀|物")을 #ruby("선|택","選|擇")하는 까닭에 #ruby("각","各") #ruby("도","道") #ruby("감|옥","監|獄")의 #ruby("음|식","飮|食")이 #ruby("동|일","同|一")하지 않았다.]
#zh[饭一天分三顿。材料是朝鲜各道各自选取本地极便宜的谷物，所以各道监狱的伙食并不相同。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("서|대|문|감|옥","西|大|門|監|獄")은 #ruby("십|분","十|分")에 콩이 #ruby("오|분","五|分") #ruby("소|미","小|米") #ruby("삼|분","三|分") #ruby("현|미","玄|米") #ruby("이|분","二|分")으로#footnote(numbering: _ => [88)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “콩 5#ruby("할","割"), 좁쌀 3#ruby("할","割"), #ruby("현|미","玄|米") 2#ruby("할","割")로”.] 밥을 지어, #ruby("최|하","最|下") 8#ruby("등|식","等|食")에 250#ruby("문","文")\(#inline-glyph("/images/p242.png", cls: ("vm",)))#footnote(numbering: _ => [89)])[#h(0.35em)#ruby("일|본","日|本")의 무게 #ruby("단|위","單|位")로 약 3.75g.]을 #ruby("기|본","基|本")으로 하여 2#ruby("등","等")까지 #ruby("문|수","文|數")를 #ruby("증|가","增|加")하였다. #ruby("차|입","差|入")되는 #ruby("사|식","私|食")은, #ruby("감|옥","監|獄") 바깥에 있는 #ruby("식|당","食|堂") #ruby("주|인","主|人")이 #ruby("수|인","囚|人") #ruby("친|족","親|族")의 #ruby("부|탁","付|託")을 맡아 #ruby("배|식","配|食") #ruby("시|간","時|間")마다 밥과 한두 가지 #ruby("반|찬","飯|饌")을 가져오면, #ruby("간|수","看|守")가 #ruby("검|사","檢|査")하고 #ruby("일|자","一|字") 박은 #ruby("통","桶")에 #ruby("다|식","茶|食")과 같이 박아내어 #ruby("분|배","分|配")하는데,#footnote(numbering: _ => [90)])[#h(0.35em)#ruby("전|통|과|자","傳|統|菓|子")의 하나인 #ruby("다|식","茶|食")은 길쭉한 #ruby("판|자","板|子")조각에 구멍을 판 #ruby("다|식","茶|食")틀로 박아내어 만든다. 여기서는 밥을 마치 #ruby("다|식","茶|食") 찍어내듯이 뭉쳐서 #ruby("분|배","分|配")하는 것을 말한다.] #ruby("사|식","私|食") 먹는 #ruby("수|인","囚|人")들은 한 곳에 모아서 먹게 하였다. #ruby("감|식","監|食")도 #ruby("등|수","等|數")는 다르나 밥은 같은 것이고, #ruby("각","各") #ruby("공|장","工|場")이나 #ruby("각","各") #ruby("감|방","監|房")에서 먹게 한다.]
#zh[当时西大门监狱，十分里豆五分、小米三分、玄米二分，煮成饭。最低八等食以二百五十文为底，增加到二等。送进来的私饭，由监狱外面的食堂主人受囚犯亲属之托，每到开饭时送来饭和一两样菜，看守检查之后，在印了日期的桶里像茶食一样舀出来分配。吃私饭的囚犯集中在一处吃。狱食的等数不同，饭是一样的，在各工场或各牢房里吃。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[세 때로 밥과 #ruby("찬","饌")을 #ruby("일|제","一|齊")히 #ruby("분|배","分|配")한 #ruby("후","後"), #ruby("간|수","看|守")가 머리 숙이는 #ruby("인|사","人|事") #ruby("고|두|례","叩|頭|禮")를 시킨다. #ruby("수|인","囚|人")들은 #ruby("호|령","號|令")에 좇아 무릎을 꿇고, 무릎 위에 두 손을 올려놓고 머리를 숙인다. 그러다가 #ruby("왜","倭")놈 말로 “모도이”#footnote(numbering: _ => [91)])[#h(0.35em)#ruby("원|주","原|註"): “우리의 軍號 바릇과 갓다.” 모도이는 모도리(もどり). 우리말로 ‘바로’.] 하면 머리를 #ruby("일|제","一|齊")히 들었다가, “키반”#footnote(numbering: _ => [92)])[#h(0.35em)#ruby("원|주","原|註"): “喫飯”. 키반(きばん)은 우리말로 ‘밥 먹어’.] 해야 #ruby("각","各") #ruby("수|인","囚|人")이 먹기 #ruby("시|작","始|作")한다.]
#zh[三顿把饭和菜一齐分完之后，看守叫人低头行叩头礼。囚犯依着口令跪下，两手搁在膝盖上，低下头。然后用倭语一喊，大家一齐抬头，再一喊，各人开始吃。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("수|인","囚|人")들에게 #ruby("경|례","敬|禮")를 시키는 #ruby("간|수","看|守")는 다음과 같이 #ruby("훈|화","訓|話")한다.]
#zh[叫囚犯行礼的看守这样训话：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("식|사","食|事")는 #ruby("천|황","天|皇")이 너희 #ruby("죄|인","罪|人")을 불쌍히 여겨서 주는 것이니, 머리를 숙여서 #ruby("천|황","天|皇")에게 #ruby("예","禮")를 하고 #ruby("감|사","感|謝")의 뜻을 #ruby("표","表")하라.”]
#zh[“饭食是天皇可怜你们这些罪人给的，低下头向天皇行礼，表示感谢。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 #ruby("매|번","每|番") ‘#ruby("경|례","敬|禮")’라고 할 때에 들어보면 #ruby("각","各") #ruby("수|인","囚|人")들이 입안엣소리로 무슨 말인지 중얼거리는 것이 있다. 나는 #ruby("이|상","異|常")하게 생각되었다. #ruby("천|황","天|皇")이 밥을 준대서 #ruby("천|황","天|皇")에 #ruby("대","對")한 #ruby("감|사","感|謝")를 #ruby("표|시","表|示")하는 것인가 했는데, 낯익은 #ruby("수|인","囚|人")들에게 물어보니 모두 한가지로 #ruby("대|답","對|答")했다.]
#zh[但是每当喊“敬礼”时，我看到囚犯们在喃喃自语，嘴里在默祷着什么。我很奇怪，以为是在向天皇表示良好的祝愿，事后跟熟识的囚犯一问，他们都异口同声地回答说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신, #ruby("일|본","日|本") #ruby("법|전","法|典")을 보지 못했소? #ruby("천|황","天|皇")이나 #ruby("황|후","皇|后")가 죽으면 #ruby("대|사|면","大|赦|免")이 내려 #ruby("각","各") #ruby("죄|인","罪|人")을 #ruby("방|송","放|送")한다고 하지 않았소? 그러므로 우리 #ruby("수|인","囚|人")들은 머리를 숙이고 #ruby[하느님][上帝]께 ‘#ruby("메이지","明治")란 놈을 #ruby("즉|사","卽|死")시켜 줍소서’ 하고 #ruby("기|도","祈|禱")합니다.”]
#zh[“你没看到日本法典吗？那上面不是说天皇或皇后死亡，要下大赦令释放罪囚？所以我们这些罪囚都低头向上帝祷告，盼天皇快死。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그 말을 듣고 #ruby("심","甚")히 기뻐하여 나도 그렇게 하겠다고 하였다. #ruby("그|후","其|後")부터는 나도 ‘노는 입에 #ruby("염|불","念|佛")’#ruby("격","格")으로 #ruby("매|번","每|番") #ruby("식|사","食|事") 때에 “나에게 #ruby("전|능","全|能")을 베풀어 #ruby("동|양","東|洋")의 #ruby("대|악|괴","大|惡|魁")인 #ruby("왜|황","倭|皇")을 내 손에 죽게 합소서” 하고 #ruby[하느님][上帝]께 #ruby("기|도","祈|禱")하였다.]
#zh[我听了十分高兴，决定也跟着学。此后每当吃饭时，我就跟念经似的，向上帝祷告：]
#zh[“上帝啊，请赐给我全能，让我手刃东洋罪魁倭皇。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("수|인","囚|人")들 #ruby("중","中")에 #ruby("종|종","種|種") #ruby("감|식|벌","減|食|罰")을 받는 #ruby("자","者")가 있으니, 내 밥을 남을 주거나 남의 밥을 내가 얻어먹다가 #ruby("간|수","看|守")에게 #ruby("발|견","發|見")되면, 3#ruby("일","日") 또는 7#ruby("일|간","日|間") 무거운 #ruby("벌","罰")로는 3#ruby("분","分")의 2를 #ruby("감","減")하고 가벼운 #ruby("벌","罰")로는 2#ruby("분","分")의 1을 #ruby("감","減")하여 먹이는데, #ruby("감|식|벌","減|食|罰")을 당하기 #ruby("전","前") #ruby("간|수","看|守")놈들이 죽지 않으리만큼 때려준다. #ruby("소|위","所|謂") #ruby("옥|칙","獄|則")에 #ruby("의","依")하면 #ruby("감|식","減|食")도 #ruby("벌|칙","罰|則") #ruby("중","中")의 하나인 것이다.]
#zh[囚犯中常有人受到减食处罚，谁要是把饭分给别人，或是吃了别人的饭食，被看守发觉，重则减去三分之二的量，轻则减少一半，要执行三天乃至七天，而且还要受到看守的毒打。日寇订有监规，减食则是处罚之一。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 #ruby("점","點")에 #ruby("대","對")하여 나는 깊이 #ruby("연|구","硏|究")하였다. #ruby("표|면","表|面")으로 나도 붉은 옷을 입은 #ruby("복|역|수","服|役|囚")이나, #ruby("정|신|상","精|神|上")으로 나는 #ruby("결","決")코 #ruby("죄|인","罪|人")이 아니다. #ruby("왜","倭")놈의 이른바 ‘#ruby("신|부|민","新|付|民")’(新付民: #ruby("식|민","植|民") #ruby("백|성","百|姓"))이 아니고, 나의 #ruby("정|신","精|神")으로는 죽으나 사나 #ruby("당|당","堂|堂")한 #ruby("대|한","大|韓")의 #ruby("애|국|자","愛|國|者")이다. 될 수 있는 대로 #ruby("왜","倭")놈의 #ruby("법|률","法|律")을 #ruby("복|종","服|從")치 않는 #ruby("실|제","實|際") #ruby[사실][實事實]이 있어야만, 내가 살아 있는 #ruby("본","本")뜻이 있는 것이다.]
#zh[这一点我深入想过。表面上我也是穿着红衣服劳役的囚犯，精神上我决不是罪人。我不是倭寇所谓的“新附民”，我的精神死也好活也好，是堂堂大韩的爱国者。必须尽可能有不服从倭寇法律的实际事实，我活着才有本意。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러면 나는 하루 한 끼 #ruby("혹","或") 두 끼 #ruby("사|식","私|食")을 먹으니, 밥이 #ruby("부|족","不|足")하여 애쓰는 #ruby("수|인","囚|人")들을 먹이고도 나는 한 끼라도 #ruby("자|양|분","滋|養|分") 있는 #ruby("음|식","飮|食")을 먹는 셈이다. #ruby("건|강","健|康")에는 큰 #ruby("결|함","缺|陷")이 없으리라고 생각해서, #ruby("매|번","每|番") 내 밥은 곁에서 먹는 #ruby("수|인","囚|人")을 주어 먹게 했다. 처음에 먹기를 #ruby("시|작","始|作")할 때, 곁에 앉은 #ruby("수|인","囚|人")의 옆구리를 꾹 찌르면 그 사람은 알아차리고 빨리 #ruby("자|기","自|己") #ruby("분|량","分|量")을 먹은 뒤 내 앞에다가 빈 그릇을 놓는다. 내 밥그릇을 그 사람에게 주면, #ruby("간|수","看|守")놈 보기에 나는 밥을 빨리 먹고 앉아 있는 것으로 보여진다.]
#zh[于是我一天吃一顿或两顿私饭。把饭不够、为此苦恼的囚犯喂了，我自己也算吃到一顿有养分的。我想健康不会有大欠缺，每次把我的饭给旁边吃的囚犯。刚开始吃的时候，使劲戳一下身旁囚犯的肋下，他就明白，赶快吃完自己的一份，把空碗放在我面前。我把饭碗给他，在看守看来，就像我吃得快、坐在那里。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("수|인","囚|人")들의 #ruby("품|행","品|行")이, 열 #ruby("번","番") 내 밥을 먹는다면 먹을 때는 죽어도 #ruby("은|혜","恩|惠")를 잊지 못하겠다고 #ruby("치|사","致|辭")를 하던 #ruby("자","者")라도, 아침밥을 얻어먹고는 저녁밥을 다른 사람에게 주는 것을 보면, 그 #ruby("즉|시","卽|時")로 #ruby("욕|설","辱|說")을 퍼부었다.]
#zh[囚犯的品行是这样：十次吃我的饭，吃的时候发誓死也不忘恩的人，早上得了饭，晚上看见给了别人，立刻就破口大骂。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“저놈이 네 #ruby[의붓애비][義父]냐? 이야, #ruby("효|자|문","孝|子|門") 세우겠다.”]
#zh[“那家伙是你的继父吗？嘿，要立孝子门了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러면 밥을 얻어먹는 #ruby("자","者")가 또한 나를 #ruby("옹|호","擁|護")하는 말로 맞대고 #ruby("욕|설","辱|說")을 하다가 #ruby("간|수","看|守")에게 #ruby("발|각","發|覺")되어 함께 #ruby("벌","罰")을 서는 까닭에, #ruby("선","善")을 #ruby("행","行")함이 도리어 #ruby("악","惡")을 #ruby("행","行")하게 되는 #ruby("경|우","境|遇")가 #ruby("허|다","許|多")하다.]
#zh[于是得了饭的人又用护着我的话对骂，被看守发觉，一起受罚。所以行善反而成了作恶，这种情形很多。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("수|인","囚|人")들이 내게 함부로 #ruby("대","對")하지 못하는 #ruby("이|유","理|由")가 몇 가지 있었다. #ruby("수|인","囚|人") #ruby("중","中")의 #ruby("정|수|분|자","精|髓|分|子")인 #ruby("이|재|명","李|在|明") #ruby("의|사","義|士")의 #ruby("동|지","同|志")들은 모두 #ruby("일|어","日|語")에 #ruby("능|통","能|通")하여 #ruby("왜","倭")놈들에게 큰 #ruby("신|임","信|任")을 받았는데, 그 사람들이 나에게 #ruby("대","對")하여 #ruby("극","極")히 #ruby("존|경","尊|敬")하는 것을 #ruby("동|료","同|僚") #ruby("수|인","囚|人")들이 보았던 것이다. #ruby("수|인","囚|人")들을 #ruby("임|시","臨|時") #ruby("신|문","訊|問")할 때 그들을 #ruby("통|역","通|譯")으로 #ruby("사|용","使|用")했으니, #ruby("성|행","性|行")이 사나운 #ruby("자","者")는 하루에도 몇 #ruby("번","番")씩 불려다니는 터에 #ruby("통|역","通|譯")들에게 밉보이고서는 #ruby("자|기","自|己")에게 #ruby("직|접","直|接") #ruby("해","害")가 돌아올까 하는 두려움이 있었고, 내가 날마다 밥을 다른 사람에게 주는 것을 보니 #ruby("후|일","後|日")의 #ruby("소|망","所|望")이 있으리라는 #ruby("기|대","期|待")가 그 #ruby("이|유","理|由")이다.]
#zh[我刚进入西大门监狱的时候，受到先进来的一批人的轻视，但是等到他们知道我是所谓的“国事强盗犯”之后，开始改变了态度。尤其是李在明义士的同志们都很有学问，同时通晓日语，因此当囚犯和看守之间有什么问题发生时，都由他们来做翻译，所以深受日本鬼子的信任，性情不好的罪犯有时一天要被叫去好几次，他们怕得罪翻译，于己不利，又看到李在明义士的同志们对我都很尊敬，也就不敢再轻视我。加上看到我分饭食给别人吃，不管怎样，自己往后也总会轮到的，所以他们就不敢把我怎么样。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[통틀어 말하자면 우리 #ruby("동|지","同|志")들은 #ruby("인|격","人|格")과 #ruby("재|능","才|能")에서 뛰어나고, 50〜60#ruby("명","名")이 #ruby("정|신|적","精|神|的")으로 #ruby("단|결","團|結")되어 누구도 #ruby("멸|시","蔑|視")할 수 없을 뿐 아니라, 우리와 다른 #ruby("사|건","事|件")이라도 똑똑한 #ruby("분|자","分|子")는 모두 우리와 #ruby("정|의","情|義")를 #ruby("통","通")하고 지내는 터였으니, #ruby("엄|연","儼|然")히 #ruby("수|인","囚|人")의 #ruby("영|도|적","領|導|的") #ruby("기|관","機|關")이 되어 갔다. #ruby("수|인","囚|人")의 #ruby("표|면","表|面") #ruby("감|독","監|督")은 #ruby("왜","倭")놈이 하고, #ruby("정|신|상","精|神|上") #ruby("지|도","指|導")는 우리 #ruby("동|지","同|志")들이 하게 되었다.]
#zh[总的说来，我们五六十名同志人格高尚，才能超群，又互相精诚团结，不容欺侮。因其他事件而被关进来的囚犯中，有头脑的人也跟我们有了情义，我们俨然变成了囚犯们的领导核心。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("숙|소","宿|所")는 #ruby("감|방","監|房")에서 #ruby("잡|거","雜|居")하는데, #ruby("왜","倭")놈의 #ruby[다다미][草席] 3#ruby("장","張") #ruby("반","半")에 #ruby("해|당","該|當")하는 #ruby("방","房") 안 #ruby("면|적","面|積")에 #ruby("수|인","囚|人") 10#ruby("여","餘") #ruby("명","名")은 #ruby("보|통","普|通")이고, 어떤 때에는 20#ruby("여","餘") #ruby("명","名")을 몰아넣을 때도 #ruby("종|종","種|種") 있었다. 앉아 있는 #ruby("시|간","時|間")에는 #ruby("수|인","囚|人") #ruby("번|호","番|號") #ruby("차|례","次|例")에 따라, 1·2·3·4#ruby("열","列")을 지어 앉는다. #ruby("석|식","夕|食") #ruby("후","後") 몇 #ruby("시|간","時|間")은 뜻에 따라 #ruby("서|적","書|籍")도 보게 하고, #ruby("문|맹","文|盲")들은 소곤소곤 이야기도 하게 하지만, 큰소리로 #ruby("서|적","書|籍")을 소리내어 읽지 못하게 하고, 이야기는 더욱 #ruby("엄|금","嚴|禁")한다.]
#zh[住宿是在牢房里杂居。相当于倭寇三张半榻榻米的房间里，住十多名囚犯是常事，有时也常常塞进二十多名。坐着的时候按囚犯号码排成一、二、三、四列。晚饭后几个钟头，可以随意看书，不识字的可以悄悄说话，但不许大声念书，说话更是严禁。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[무슨 말소리가 나면 #ruby("간|수","看|守")가 와서 누가 무슨 말을 하였나 물어서, 이야기하였다고 #ruby("자|백","自|白")하면 그 #ruby("수|인","囚|人")들에게 쇠창살 사이로 손을 내놓으라 하여 실컷 때려주는 터이므로, 앉아 있는 동안에 이#ruby("방","房") 저#ruby("방","房")에서 “아이구, 아이구” 하는 소리와 사람 치는 소리가 끊일 때가 없다. 처음에는 맞는 모습과 #ruby[저승사자][夜叉]#footnote(numbering: _ => [93)])[#h(0.35em)#ruby("범|어","梵|語")의 #ruby("야|차","夜|叉")\(yaksa)에서 #ruby("취|음","取|音")한 말. #ruby("염|라|대|왕","閻|羅|大|王")의 #ruby("명|령","命|令")으로 #ruby("지|옥","地|獄")의 #ruby("죄|인","罪|人")을 다루는, #ruby("흉|측","凶|測")하게 생긴 #ruby("옥|졸","獄|卒").] 같은 #ruby("왜","倭")놈들의 #ruby("만|행","蠻|行")을 차마 볼 수 없었으나, 하도 자주 보아 그런지 #ruby("점|점","漸|漸") #ruby("신|경","神|經")이 #ruby("둔","鈍")하여져서 보기에 #ruby("심|상","尋|常")한 때도 있었다.]
#zh[一有说话的声音，看守就来问是谁说了什么。若承认说了话，就叫那些囚犯从铁窗格子里伸出手来，痛打一顿。所以坐着的时候，这房那房“哎哟、哎哟”的声音和打人的声音没有断过的时候。起初，挨打的样子和阎王使者似的倭寇的蛮行，实在看不下去。看得太多了，神经渐渐迟钝，有时看着也平常了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이제 생각하니 우리 #ruby("독|립|운|동","獨|立|運|動")이 #ruby("시|작","始|作")된 #ruby("후","後") #ruby("장|덕|준","張|德|俊") #ruby("의|사","義|士")가 『#ruby("동|아|일|보","東|亞|日|報")』 #ruby("종|군|기|자","從|軍|記|者")로 #ruby("북|간|도","北|間|島")에 #ruby("출|장","出|張")하여, #ruby("왜","倭")놈들이 #ruby("독|립|군","獨|立|軍")이나 #ruby("평|민","平|民")이나 잡히는 대로 끌어다 개 패듯 하는 #ruby("광|경","光|景")을 보고서 #ruby("의|분","義|憤")을 참지 못해 #ruby("왜","倭")놈 #ruby("대|장","大|將")에게 #ruby("엄|중","嚴|重")하게 #ruby("항|의","抗|議")하였는데, 그 #ruby("대|장","大|將")놈이 #ruby("사|과","謝|過")하고 #ruby("장|의|사","張|義|士")를 #ruby("문","門") 밖에서 #ruby("작|별","作|別")한 뒤 #ruby("비|밀|리","祕|密|裏") #ruby("체|포","逮|捕")하여 #ruby("암|살","暗|殺")하였다는 #ruby("당|시","當|時") #ruby("밀|탐","密|探")이 있었다.#footnote(numbering: _ => [94)])[#h(0.35em)#ruby[장|덕|준][張|德|俊]\(1893〜1920). #ruby("호","號")는 #ruby("추|송","秋|松"). #ruby("황|해|도","黃|海|道") #ruby("재|령","載|寧") #ruby("북|률|면","北|栗|面") #ruby("출|신","出|身"). #ruby("설|산","雪|山") #ruby("장|덕|수","張|德|秀")의 #ruby("형","兄"). #ruby("백|범","白|凡")이 #ruby("보|강|학|교","保|强|學|校") #ruby("교|장","校|長") #ruby("시|절","時|節") #ruby("보|강|학|교","保|强|學|校") #ruby("교|사","敎|師")였으며, 1920#ruby("년","年") #ruby("동|아|일|보","東|亞|日|報")에 #ruby("입|사","入|社")하여 #ruby("홍|범|도","洪|範|圖")의 #ruby("봉|오|동","鳳|梧|洞") #ruby("전|투","戰|鬪") #ruby("승|리","勝|利") #ruby("후","後") #ruby("일|본|군","日|本|軍") #ruby("상|황","狀|況")을 #ruby("취|재","取|材")하기 #ruby("위","爲")해 #ruby("만|주","滿|洲")로 갔다. 그해 11#ruby("월","月") 6#ruby("일","日") #ruby("간|도","間|島")에 #ruby("도|착","到|着")한 그는 #ruby("일|본|인","日|本|人")이 #ruby("무|고","無|故")한 #ruby("조|선|인","朝|鮮|人")을 #ruby("학|살","虐|殺")하는 것을 #ruby("취|재","取|材")하다, #ruby("모|아|산","帽|兒|山")에서 #ruby("일|본|군","日|本|軍")에게 #ruby("살|해","殺|害")당했다.] 나는 #ruby("옥|중","獄|中") #ruby("체|험","體|驗")으로 인해 그것이 더욱 #ruby("명|확","明|確")하다고 믿는다.]
#zh[独立运动开始后，张德俊义士作为东亚报的随军记者，出差到北间岛，见到日本鬼子不管是独立军还是平民百姓，见人就抓，不禁义愤填膺，向鬼子队长提出了严正抗议。鬼子队长表示歉意，把他们送出门外，后来暗地里逮捕了他，将他秘密处死。这个消息不胫而走，到处流传。我入狱后经过自身的感觉，对这一消息也深信不疑了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 내가 #ruby("최|명|식","崔|明|植") #ruby("군","君")과 너무 오래 #ruby("격|리","隔|離")되어 지내, #ruby("울|적","鬱|寂")한 #ruby("회|포","懷|抱")를 풀기 #ruby("위","爲")해 한 #ruby("방","房")에서 같이 지낼 #ruby("계|획","計|劃")을 #ruby("실|시","實|施")했는데, 그것은 #ruby[옴][疥瘡]을 만들어서 #ruby("감|옥|의","監|獄|醫")에게 #ruby("진|찰","診|察")받아 같은 #ruby("방","房")에서 #ruby("거|주","居|住")케 되도록 하는 것이었다. 옴을 만드는 #ruby("방|법","方|法")을 말하면, 가는 #ruby("철|사","鐵|絲")를 얻어서 끝을 갈아 뾰족하게 만들어 감추어둔다. 그러다가 #ruby("의|사","醫|師")가 #ruby("각","各") #ruby("공|장","工|場")과 #ruby("감|방","監|房")으로 돌아다니며 #ruby("병","病")든 #ruby("수|인","囚|人")을 #ruby("진|찰","診|察")하기 30#ruby("분","分") #ruby("전","前"), #ruby("철|사","鐵|絲") 끝으로 #ruby("좌|우","左|右") 손가락 사이를 꼭꼭 찔러두면 찌른 자리가 옴과 같이 솟아오르고 그 끝에서 맑은 물이 솟아오른다. 그러면 누가 보든지 옴#ruby("병","病")으로 보게 된다. 그 #ruby("방|법","方|法")으로 #ruby("진|찰","診|察")하니 그날로 옴#ruby("방","房")으로 #ruby("전|방","轉|房")되어, 둘이 같이 한 #ruby("방","房")에 들어갔다.]
#zh[有一天，我和崔明植君隔离得太久，为了消解郁闷，实行了住在一房的计划。那就是做出疥疮，让监狱医生诊过，住到同一间房里。做疥疮的方法是：弄到细铁丝，把一头磨尖，藏起来。医生到各工场和牢房巡诊病人之前三十分钟，用铁丝尖把左右指缝紧紧刺上，刺的地方就鼓起来，像疥疮一样，尖上冒出清水。谁看了都以为是疥疮。这样诊过，当天就转到疥疮房，两个人进了同一间。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 저녁 하도 그리웠던 판에 서로 이야기하다 #ruby("사|토","佐|藤")란 #ruby("간|수","看|守")놈에게 #ruby("발|각","發|覺")되었다. 누가 먼저 말을 하였나 묻기에, 내가 먼저 이야기를 했다고 #ruby("대|답","對|答")했다. 창살 밑으로 나오라 하기에 나가 서니, 그놈이 #ruby("역|시","亦|是") #ruby("곤|봉","棍|棒")으로 #ruby("난|타","亂|打")를 한다. 나는 아무 소리도 내지 않고 한참 동안을 맞았다. 그때 맞은 #ruby("상|처","傷|處")로 왼쪽 귀의 #ruby("연|골","軟|骨")이 #ruby("상","傷")하여 봉충이#footnote(numbering: _ => [95)])[#h(0.35em)봉충은 한쪽의 크기가 다른 짝짝이.]가 되어서 #ruby("지|금","只|今")껏 남아 있다. #ruby("명|식","明|植") #ruby("군","君")은 #ruby("용|서","容|恕")하며, 다시 #ruby("왜","倭")놈말로 “하나시 햇소데 다다귀도”#footnote(numbering: _ => [96)])[#h(0.35em)‘이야기하면 때려줄 테야.’] 하고 물러갔다.]
#zh[那天晚上实在想念，彼此说着话，被一个叫佐藤的看守发觉。他问谁先说的，我回答是我先说的。他叫我到窗格子底下，我出去站着，他又用棍棒乱打。我一声不响，挨了好一阵。那时的伤把左耳软骨打坏，成了疙瘩，至今还在。他饶了明植君，又用倭语说了一句“再说话就打”，退下去了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 일부러 #ruby[옴][疥瘡]을 만들어서 #ruby("전|방","轉|房")한 #ruby("이|유","理|由")가 또 한 가지 있다. #ruby("감|방","監|房")에 #ruby("수|인","囚|人")의 #ruby("수","數")가 너무 많아, 앉았을 때는 마치 그릇에 콩나물 대가리 나오듯이 되었다가, 잘 때에는 몬저 #ruby("일|인","一|人") #ruby("수|동","首|東") #ruby("일|인","一|人") #ruby("수|서","首|西")로 착착 모로 뉘여서,#footnote(numbering: _ => [97)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “한 사람이 머리를 #ruby("동","東")쪽으로 두면 다른 사람이 머리를 #ruby("서","西")쪽으로 두어 착착 모로 눕고 난 뒤”.] 더 누울 자리가 없으면 나머지 사람들은 일어서고, #ruby("좌|우","左|右")에 한 사람씩 힘센 사람이 #ruby("판|자","板|子") #ruby("벽","壁")에 등을 붙이고 두 발로 먼저 누운 사람의 가슴을 힘껏 민다. 그러면 드러누운 사람들은]
#zh[那时故意做出疥疮、转到那间房，还有一个缘故。牢房里囚犯太多，坐着的时候像碗里冒出豆芽梗。睡觉时先一个头朝东、一个头朝西，挨个侧躺。再没有躺的地方，剩下的人就站着。左右各一个有力气的人，背贴着板壁，用两脚使劲蹬先躺下的人的胸口。于是躺着的人就叫：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아이구, 가슴뼈 부러진다.”]
#zh[“哎哟，胸口的骨头要断了。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("야|단","惹|端")이다. 하지만 미는 쪽에는 또 드러누울 자리가 생기니, 서 있던 사람이 그 사이에 드러눕고, 몇 #ruby("명","名")이든지 그 #ruby("방","房")에 있는 #ruby("자","者")가 다 누운 뒤에야 밀어주던 사람까지 눕는다. 모말#footnote(numbering: _ => [98)])[#h(0.35em)#ruby("곡|식","穀|食") 따위를 되는 네모가 반듯한 말. #ruby("곡|식","穀|食") 낱알이 새어 나가지 않게 네 귀퉁이를 꽉 물리게 짠다.]과 같이 네 귀퉁이를 물려 짜서 지은 #ruby("방","房")이 아니면 #ruby("방","房")이 부서질 터였다.]
#zh[他们这样嚷。可是蹬的那一边又腾出躺的地方，站着的人就躺进空隙。房间里的人不论多少，都躺下之后，蹬人的才躺下。若不是像麻布那样四角咬合织成的房间，房间都要挤破。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[힘써 내밀 때는 사람의 뼈가 #ruby("상","傷")하는 소리인지, #ruby("판|자","板|子") #ruby("벽","壁")이 부러지는 소리인지 우두둑 소리에 소름이 돋는다. 그런 #ruby("광|경","光|景")을 보고, #ruby("감|독","監|督")하는 #ruby("간|수","看|守")놈들은 개 짖듯이 떠들지 말라면서 들여다본다. 나는 #ruby("노|쇠","老|衰")한 사람이 #ruby("흉|골","胸|骨")이 #ruby("상","傷")하여 죽는 것도 여러 #ruby("명","名") 보았다.]
#zh[使劲蹬的时候，不知是人骨头受伤的声音，还是板壁折断的声音，嘎吱一响，令人起鸡皮。监督的看守看着这光景，像狗叫一样说别吵，往里看。我看见年老力衰的人胸骨受伤而死的，也有好几个。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("종|일","終|日") 힘든 일을 하던 #ruby("수|인","囚|人")들이므로 그같이 끼어서도 잠이 든다. 첫번 누을 제는 #ruby("수|남|자|측","首|南|者|側")은 #ruby("면|북","面|北")하여 모로 눕고 #ruby("수|북|자|측","首|北|者|側")은 #ruby("남|면|이|와","南|面|而|臥")하고 잠이 들엇다가도 감슴이 답답하야 잠이 　이면 #ruby("방|향|전|환","方|向|轉|換")하자는 #ruby("의|사","意|思")가 #ruby("일|치","一|致")하여 #ruby("남|면|측","南|面|側")은 #ruby("북|면","北|面") #ruby("북|면|측","北|面|側")은 #ruby("남|면","南|面")으로 도라눕는다.#footnote(numbering: _ => [99)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “처음 누울 때는 #ruby("남","南")쪽 #ruby("북","北")쪽으로 어긋나게 모로 누워 선잠을 자다, 가슴이 답답하여 잠이 깨어 #ruby("방|향","方|向") #ruby("전|환","轉|換")하자는 #ruby("의|사","意|思")가 #ruby("일|치","一|致")하면, #ruby("남","南")쪽으로 누운 #ruby("자","者")는 #ruby("북","北")쪽으로 #ruby("북","北")쪽으로 누운 #ruby("자","者")는 #ruby("남","南")쪽으로 #ruby("일|제","一|齊")히 돌아눕는다.”] 그것은 #ruby("고|통","苦|痛")을 바꾸고자 함이다. 입과 코를 마주 대고 #ruby("호|흡","呼|吸")할 수는 없지만, 잠이 깊이 들 때 보면 서로 키스하고 자는 #ruby("자","者")가 많고, #ruby("약","弱")한 사람은 솟구쳐 올라 사람 위에서 잠을 자다 밑에 든 #ruby("자","者")에게 몰리어서 이리저리 굴러다니다 날을 밝히는 것이 #ruby("옥|중","獄|中")의 하룻밤이다.]
#zh[囚犯整天干重活，这样挤着也能睡着。最初躺下时，头朝东的一侧脸朝北侧卧，头朝北的一侧脸朝南睡着。胸口闷、睡不着，大家便一致要换方向，朝南的转向北，朝北的转向南。那是为了换一换痛苦。嘴和鼻子不能对着呼吸，可是睡熟了看，许多人像彼此接吻似的睡着。弱的人被拱上来，睡在人身上，又被底下的人推着滚来滚去，直到天亮。这就是狱中的一夜。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|중","獄|中")의 #ruby("고|통","獄|苦")은 여름, 겨울 두 #ruby("계|절","季|節")에 더욱 #ruby("심","甚")하다. 여름철에는 #ruby("감|방","監|房")에서 #ruby("수|인","囚|人")들의 #ruby("호|흡","呼|吸")과 땀에서 #ruby("증|기","蒸|氣")가 피어올라 서로 얼굴을 #ruby("분|간","分|間")할 수 없다. 가스에 불이 나서 #ruby("수|인","囚|人")들이 #ruby("질|식","窒|息")되면 #ruby("방","房")안으로 무소대\[물쏘대\]를 들이쏘아 #ruby("진|화","鎭|火")하고, #ruby("질|식","窒|息")된 #ruby("자","者")는 얼음으로 찜질하여 살리는데, 죽는 #ruby("자","者")도 여러 #ruby("번","番") 보았다. #ruby("수|인","囚|人")들이 가장 많이 죽기는 여름철이다. 겨울철에는 #ruby("감|방","監|房")에 20#ruby("명","名")이 있다면 솜이불 네 #ruby("장","張")을 들여주는데, 턱 밑에서 겨우 무릎 아래만 가려지므로 버선 없는 발과 무릎은 #ruby("태|반","太|半") #ruby("동|상","凍|傷")이 나고, 귀와 코는 얼어서 #ruby("극","極")히 #ruby("참|혹","慘|酷")한데, 발가락 손가락이 물러 터져 #ruby("불|구","不|具")가 된 #ruby("수|인","囚|人")도 여럿 보았다.]
#zh[夏冬两季，牢狱生活就更为痛苦，夏天，牢房里由于人的呼吸和汗气，整个房间像蒸笼似的，有的罪犯窒息昏倒，就用冰块冷敷，使之苏醒。也有人就此死去，死人多的就是夏季。]
#zh[冬季每间牢房住二十人，只给四床棉被，而且只能盖到膝盖，耳朵鼻子，小腿双脚全都冻伤，惨不忍睹。也有被冻掉手指脚趾，成了残废的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("간|수","看|守")놈들의 #ruby("심|술","心|術")은, #ruby("감|방","監|房")에서 무슨 말소리가 났는데 누가 말을 하였나 물어보아, 말한 #ruby("자","者")가 #ruby("자|백","自|白")을 않고 누가 말했다고 #ruby("고|발","告|發")도 없을 때는, 여름철에는 #ruby("방|문","房|門")을 닫아버리고 겨울철에는 #ruby("방|문","房|門")을 여는 것이었으니, 이것이 #ruby("감|시","監|視")의 #ruby("묘|방","妙|方")이다.]
#zh[看守心肠十分狠毒，听到谈话声就问谁在讲话，这时如果没有人坦白或无人告发，他们夏天就把房门紧闭，冬天则把房门敞开，这是他们惩罚犯人的妙方。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄") #ruby("생|활","生|活")에서 #ruby("제|일","第|一") #ruby("고|생","苦|生")을 많이 하는 사람은 #ruby("신|체","身|體")가 큰 사람이다. 내 키가 5#ruby("척","尺") 6#ruby("촌","寸") #ruby("중","中")키에 #ruby("불|과","不|過")하나 잘 때 #ruby("종|종","種|種") 발가락이 남에 입에 들어가고 추위도 더 받는다.]
#zh[在牢里最苦的是身材高大的人，我身高五尺六，是中等身材，比我个子还高的人睡觉时则常常把脚趾伸到别人的嘴里，冬天挨冻也最厉害。衰老的囚犯也有胸部被挤伤，因此而死亡的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그놈들이 내게 #ruby("대","對")하여는 유달리 #ruby("대|우","待|遇")를 하는데, #ruby("복|역","服|役")시킨다고 말만 하고 #ruby("실|제","實|際")로 시키진 않았다. #ruby("서|대|문|감|옥","西|大|門|監|獄")에 가서도 100#ruby("일","日") 동안 #ruby("수|갑","手|匣")을 채워두었기 때문에, 그같이 좁은 #ruby("방","房")에서 두 손이 묶인 잠자리가 너무 #ruby("고|통","苦|痛")스러웠다. #ruby("동|료","同|僚") #ruby("수|인","囚|人")들도 잠결에 내 #ruby("수|갑","手|匣")에 몸이 닿으면 죽는다고 #ruby("야|단","惹|端")이니, 좀 넓은 #ruby("방","房")에 #ruby("거|처","居|處")할 생각을 하였다. 그리하여 짜낸 #ruby("계|획","計|劃")—#ruby[옴][疥瘡]을 만들어 #ruby("최|명|식","崔|明|植")과 같은 #ruby("방","房")에 #ruby("거|주","居|住")하는 것—이 들어맞았으나, 모처럼 이야기 좀 하다가 이 #ruby("봉|변","逢|變")을 당한 것이다.]
#zh[那些家伙对我还算客气，让干活时只是嘴里嚷嚷，并不真的让我干。我到西大门监狱头一百天还戴着手铐，在这狭窄拥挤的牢房里戴着手铐睡觉真是件痛苦的事，手铐挤压在别人身上，人家都喊受不了。因此我才想方设法要转监，不料因谈话而受到这一顿毒打。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("행|동","行|動")의 #ruby("구|속","拘|束")은 더욱 #ruby("심","甚")하여 아침에 잠을 깨어도 마음대로 일어나지 못한다. 반드시 #ruby("일|정","一|定")한 #ruby("시|간","時|間")을 지켜서 #ruby("일|시","一|時")에 #ruby("호|령","號|令")으로 일어나게 하고, #ruby("즉|시","卽|時") #ruby("간|수","看|守")들이 #ruby("각","各") #ruby("방","房")의 #ruby("수|인","囚|人")을 꿇어앉힌다. 그리고 한 놈이 #ruby("수|인","囚|人")을 #ruby("향","向")해 #ruby("왜","倭")놈말로 “기오츠케”#footnote(numbering: _ => [100)])[#h(0.35em)#ruby("원|주","原|註"): “우리말노 긔착”. #ruby[기오츠케][起着]\(きおつけ)는 우리말로 차렷.]를 부르면 #ruby("수|인","囚|人")들은 #ruby("일|제","一|齊")히 머리를 숙인다. 한 놈이 #ruby("명|패","名|牌")를 들고 첫 자리에 앉은 #ruby("수|인","囚|人")의 #ruby("번|호","番|號")부터 끝까지 읽는데, #ruby("수|인","囚|人")마다 #ruby("자|기","自|己") #ruby("번|호","番|號")를 들으면 “하이(예)” 하고 곧 머리를 든다.]
#zh[监狱里行动处处受制。清晨一觉醒来，也不能起身，一定要遵守时间并听从口令。看守们把犯人叫起来，有一个鬼子面向牢房用日语呼喊“立正！”犯人们就一齐低下脑袋。此时有一名看守手拿名牌，从第一号起直呼到最后一号。囚犯们胸前都贴有番号，叫到自己的番号时，则应声抬头，回答一声“有”。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[끝자리에 앉은 #ruby("수|인","囚|人")까지 다 마친 #ruby("후","後"), 잘 때 입던 #ruby("의|복","衣|服")을 벗어 꾸려놓고, #ruby("수|건","手|巾") 한 #ruby("장","張")씩으로 허리 아래를 가리고 알몸에 맨발로, 멀면 100#ruby("보","步") 가까우면 50#ruby("보","步") #ruby("이|내","以|內") #ruby("거|리","距|離")를, 천천히 손 활개도 못 치고 #ruby("벽","甓")돌 한 #ruby("개","個")씩 펴놓은 것을 밟으며 #ruby("공|장","工|場")에 간다. 거기서 #ruby("각|각","各|各") #ruby("자|기","自|己")의 일#ruby("복","服")을 입게 하고 또 #ruby("열","列")을 지어 쪼그려 앉힌 뒤 #ruby("수|효","數|爻")를 #ruby("점|검","點|檢")하고 #ruby("세|면","洗|面")을 시킨다. 아침밥을 먹이고 나서는 곧 #ruby("노|역","役|事")을 #ruby("시|작","始|作")하는데, 일의 #ruby("종|류","種|類")는 #ruby("간|단","簡|單")한 #ruby("철|공","鐵|工"), #ruby("목|공","木|工"), #ruby("직|공","織|工"), #ruby("피|복|공","被|服|工"), #ruby("보|석","寶|石"),#footnote(numbering: _ => [101)])[#h(0.35em)#ruby("원|주","原|註"): “倭말 무시료, 가마니 等”. #ruby[무시로][筵蓆]\(むしろ)는 자리·거적·멍석 #ruby("등","等") 깔개의 #ruby("총|칭","總|稱"). ‘#ruby("보|석","寶|石")’은 ‘#ruby("편|석","編|蓆")’ 또는 ‘#ruby("보|석","補|蓆")’의 #ruby("오|류","誤|謬")인 듯하다.] #ruby("궐|련|갑","捲|烟|匣") #ruby("제|조","製|造"), 새끼 꼬기, 김매기, 빨래, 밥 짓기 #ruby("등","等")이 있다.]
#zh[坐在末位的囚犯也都点完之后，脱下睡觉时穿的衣服叠好，各用一条手巾遮住腰下，光着身子、赤着脚。远则一百步，近则五十步以内，不能甩开胳膊，慢慢踏着一块一块铺着的砖，走到工场。到了那里，各自穿上自己的工作服，再列队蹲下，点人数，洗脸。吃过早饭，立刻开始劳役。工种有简单的铁工、木工、织工、被服工、宝石、卷烟盒制造、搓草绳、锄草、洗衣、做饭等。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그밖에 여러 #ruby("수|인","囚|人")들 #ruby("중","中")에 #ruby("품|행","品|行")이 #ruby("방|정","方|正")하다고 보여진 #ruby("자","者")는 #ruby("내|감","內|監") 바깥 일터의 #ruby("청|소|부","掃|除|夫")와 #ruby("병|동","病|棟")의 #ruby("간|호|부","看|病|夫"), #ruby("취|사|장","炊|事|場")의 #ruby("취|사|부","炊|事|夫")로 뽑아 썼다. 이러한 #ruby("특|종","特|種") #ruby("역|사","役|事")에 쓰이는 #ruby("자","者")는 #ruby("정|승","政|丞") 부럽지 않다고들 하는데, #ruby("대|우","待|遇")도 좀 #ruby("후","厚")하고 #ruby("고|통","苦|痛")도 덜하기 때문일 것이다.]
#zh[此外，囚犯里看起来品行端正的，被挑去当内监外面工地的清扫夫、病栋的看护，和炊事场的炊事夫。干这种特别劳役的人，都说不羡慕宰相，大概因为待遇稍厚、痛苦也少些。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|방","監|房")에서 #ruby("공|장","工|場")에 나갈 때나 들어올 때, 여름철은 #ruby("보|통","普|通")이지만 겨울철에는 추워서 온몸이 꺼멓게 죽어서 들어오고 나간다. 겨울에 #ruby("공|장","工|場")에 가서 옷을 풀어보면 틈틈이 눈이 끼인 것이라도 입기만 하면 #ruby("훈|훈","薰|薰")히 더운 #ruby("기|운","氣|運")이 돌아온다. #ruby("공|장","工|場")에서 #ruby("노|역","役|事")을 마치고 저녁을 먹고 #ruby("감|방","監|房")으로 들어올 때도, #ruby("역|시","亦|是") 일옷을 벗고 알몸에 #ruby("수|건","手|巾")만 두르고 들어와 아침과 같이 #ruby("번|호","番|號") #ruby("점|검","點|檢")한 #ruby("후","後") 앉았다가 #ruby("정","定")한 #ruby("시|간","時|間")에야 자게 한다.]
#zh[上工地或回牢房时，夏季尚可，其他季节，浑身都呈青紫。冬天到了工地，衣服的缝隙都沾满雪花，但是一穿上身，全身还是能感到有些暖气。一天的劳役结束后，在工地吃了晚饭回牢房时，又要脱掉工作服，和早晨一样，赤身裹着一条毛巾，到了牢房，又清点一遍人员，然后坐下，直到规定时间才让睡觉。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("구|속","拘|束")을 너무 지나칠 #ruby("정|도","程|度")로 #ruby("가|혹","苛|酷")하게 할수록 #ruby("반|대","反|對")로 #ruby("수|인","囚|人")들의 #ruby("심|성","心|性")도 따라 #ruby("악|화","惡|化")되어서, #ruby("횡|령","橫|領")이나 #ruby("사|기|죄","詐|欺|罪")로 들어온 #ruby("자","者")라도 #ruby("절|도","竊|盜")나 #ruby("강|도","强|盜")질을 #ruby("연|구","硏|究")해서 #ruby("만|기","滿|期") #ruby("출|옥","出|獄") #ruby("후","後")에 더 무거운 #ruby("형","刑")을 받아 다시 들어오는 #ruby("자","者")를 #ruby("종|종","種|種") 볼 수 있었다. #ruby("지|금","只|今") #ruby("감|옥","監|獄")은 #ruby("물|론","勿|論") #ruby("이|민|족","異|民|族")의 #ruby("압|제","壓|制")를 받는다는 #ruby("감|정","感|情")이 #ruby("충|만","充|滿")한 곳이므로 #ruby("왜","倭")놈들의 #ruby("처|사","處|事")로는 털끝만큼이라도 #ruby("감|화","感|化")를 줄 수 없으나, 내 #ruby("민|족","民|族")끼리 #ruby("감|옥","監|獄")을 다스린다 하여도 남을 #ruby("모|방","模|倣")하여서는 #ruby("감|옥","監|獄") #ruby("설|치","設|置")에 아무런 #ruby("효|과","效|果")가 없겠다고 생각되었다.]
#zh[在监狱里这样残酷地对待囚犯，使囚犯的性情更坏，更加自暴自弃，所以因欺诈或贪污罪名入狱的人最后都变成了窃贼或强盗，许多人刑满出狱后又被送进监狱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리하여 #ruby("후|일","後|日") 우리나라가 #ruby("독|립","獨|立")한 #ruby("후","後") #ruby("감|옥","監|獄") #ruby("간|수","看|守")부터 #ruby("대|학","大|學") #ruby("교|수","敎|授")의 #ruby("자|격","資|格")으로 #ruby("사|용","使|用")하고, #ruby("죄|인","罪|人")을 #ruby("죄|인","罪|人")으로 보기보다는 #ruby("국|민","國|民")의 #ruby("일|원","一|員")으로 보아서 #ruby("선","善")으로 #ruby("지|도","指|導")하기에만 #ruby("주|력","注|力")해야 하겠고, #ruby("일|반","一|般") #ruby("사|회","社|會")에서도 #ruby("감|옥","監|獄")살이 한 #ruby("자","者")라고 #ruby("멸|시","蔑|視")하지 말고 #ruby("대|학|생","大|學|生")의 #ruby("자|격","資|格")으로 #ruby("대|우","待|遇")해야 #ruby("감|옥","監|獄") #ruby("설|치","設|置")한 #ruby("가|치","價|値")가 있겠다고 생각되었다.]
#zh[日本人虽想以其狭隘的心胸来感化充满着民族反抗意识的我们，但这是不可能的。即便是由本民族来管理监狱，但照这样的方式办下去，也不会有任何好处。日后我国取得独立，狱卒也必须具有大学教授的资格，而对待犯人，与其把他们当作罪人来看管，不如把他们看做国民中不幸的一员而教之向善。同时社会也应该摒弃对坐过牢的人的蔑视，而以大学生的身份待之，那样就一定会收到好的效果。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|대|문|감|옥","西|大|門|監|獄")에는 #ruby("역|대","歷|代")의 #ruby("진|귀","珍|貴")한 #ruby("보|물","寶|物")이 있으니, 지난날 #ruby("이|승|만","李|承|晩") #ruby("박|사","博|士")가 #ruby("자|기","自|己") #ruby("동|지","同|志")들과 같이 #ruby("투|옥","投|獄")되었을 때, #ruby("서|양|인","西|洋|人") #ruby("친|구","親|舊")들과 #ruby("연|락","聯|絡")하여 #ruby("옥|중","獄|中")에 #ruby("도|서|실","圖|書|室")을 #ruby("설|치","設|置")하고 우리나라와 #ruby("외|국","外|國")의 #ruby("진|귀","珍|貴")한 #ruby("서|적","書|籍")을 #ruby("구|입","購|入")하여 5, 6#ruby("년|간","年|間") 긴 #ruby("세|월","歲|月") #ruby("옥|수","獄|囚")에게 나라를 #ruby("구","救")하고 #ruby("부|흥","復|興")시키는 #ruby("방|도","方|道")를 #ruby("강|연","講|演")하였던 그것이다.]
#zh[西大门监狱里有历代的珍贵宝物。那是从前李承晚博士和同志们一起入狱时，和西洋朋友联络，在狱中设了图书室，买了我国和外国的珍贵书籍，五六年漫长岁月里，向狱囚讲演救国、复兴的方略。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("노|역","役|事")을 쉬는 날 #ruby("서|적|고","書|籍|庫")에 쌓인 #ruby("각|종","各|種") #ruby("책|자","冊|子")를 #ruby("각","各") #ruby("방","房")에 들여보내 주는데, 그#ruby("중","中")에 #ruby("이","李")#ruby("박|사","博|士")의 손때와 눈물 #ruby("흔|적","痕|跡")으로 얼룩진, #ruby("감|옥|서","監|獄|署")라는 #ruby("도|장","圖|章")이 찍힌 『#ruby("광|학|유|편","廣|學|類|編")』, 『#ruby("태|서|신|사","泰|西|新|史")』 #ruby("등","等")의 #ruby("서|적","書|籍")을 보았다. 나는 그러한 #ruby("책|자","冊|子")를 볼 때 그 #ruby("내|용","內|容")보다는 #ruby("배|알","拜|謁")치 못한 #ruby("이","李")#ruby("박|사","博|士")의 얼굴을 보는 듯 반갑고 #ruby("무|한","無|限")한 느낌이 일었다.]
#zh[劳役休息的日子，把书库里堆着的各种书送到各房。其中我看见盖着“监狱署”图章、沾着李博士的手泽和泪痕的《光学遗编》《泰西新史》等书。我看这些书的时候，与其说是书的内容，倒像看见了未曾拜见的李博士的脸，又高兴，又有无限的感触。]
#heading(level: 3)[#text(font: "KOPUSGo B")[10) #ruby("기|인","奇|人")과 #ruby("영|웅","英|雄")]]
#zh[奇人与英雄]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[앞에서 #ruby("의|병","義|兵")들의 #ruby("결|점","缺|點")을 #ruby("대|강","大|綱") 말하였고, 여기서는 통틀어서 #ruby("수|인","囚|人")들 #ruby("대|다|수","大|多|數")의 #ruby("성|행","性|行")과 #ruby("견|문","見|聞")을 #ruby("대|강","大|綱") 말하겠다.]
#zh[我在前面讲了一些义兵的缺点，这里我再说一说一般囚犯的品性以及我的见闻。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄") 밖 #ruby("보|통","普|通") #ruby("사|회","社|會")에서는 듣도 보도 못할 #ruby("괴|이","怪|異")한 #ruby("특|징","特|徵")을 #ruby("발|견","發|見")하였다. #ruby("보|통","普|通") #ruby("사|회","社|會")에서는 아무리 #ruby("막|역","莫|逆")한 #ruby("친|구","親|舊")들 사이라도 “내가 뉘 집에 가서 #ruby("강|도","强|盜")나 #ruby("살|인","殺|人")이나 #ruby("절|도","竊|盜")를 하였노라”고 #ruby("발|언","發|言")할 사람이 없거늘, 하물며 #ruby("초|면","初|面") #ruby("인|사","人|事") #ruby("후","後")에도 서슴지 않고 “내가 아무개를 죽였다” “아무개 집에 가서 #ruby("불|한|당","不|汗|黨")질 한 것도 나와 아무개가 하였다”고 #ruby("기|탄","忌|憚")없이 이야기한다. #ruby("세|상","世|上")이 다 알듯이 그 #ruby("죄","罪")로 #ruby("벌","罰")을 받는 #ruby("중","中")이라면 그럴 수 있겠으나, 스스로 숨겨서 밝혀지지 않았던 #ruby("사|건","事|件")도 #ruby("기|탄","忌|憚")없이 #ruby("공|개","公|開")한다.]
#zh[我在监狱里看到了一些千奇百怪的事情，这在普通社会上是见所未见，闻所未闻的。举例说吧，犯人们毫无忌惮地谈论着自己在什么地方偷了什么，杀死了某某，不但不感到羞耻，反而津津乐道，他们跟熟悉的人谈还情有可原，可是竟然在初次谋面的陌生人面前也厚着脸皮讲这些隐私，这在普通社会是不会有人这么做的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("우|선","于|先") 한 가지 먼저 말할 것은, 어느날 가마니 짜는 #ruby("제|3|공|장","第|三|工|場")에서 #ruby("최|명|식","崔|明|植") #ruby("군","君")과 내가 #ruby("소|제|부","掃|除|夫") 일을 하던 때 일이다. 우리는 #ruby("원|료","原|料")를 #ruby("각","各") #ruby("수|인","囚|人")들에게 돌려주고 뜰을 #ruby("소|제","掃|除")하고 나면, #ruby("수|인","囚|人")들이 #ruby("물|건","物|件") 만드는 구경이나 한다. #ruby("왜","倭")#ruby("간|수","看|守")가 한 #ruby("시|간","時|間") 지킬 때는 #ruby("자|유","自|由")가 없으나, #ruby("조|선","朝|鮮") #ruby("간|수","看|守")가 #ruby("반","半") #ruby("시|간","時|間") 볼 때는 #ruby("한|가","閑|暇")하다. #ruby("수|인","囚|人") #ruby("전|부","全|部")가 #ruby("담|화|회","談|話|會")를 연 것같이 수군거리면, #ruby("조|선","朝|鮮") #ruby("간|수","看|守")도 #ruby("왜","倭")#ruby("간|수","看|守")처럼 “말을 말라”고 #ruby("왜","倭")#ruby("간|수","看|守")보다 더 크게 #ruby("호|령","號|令")하지만, #ruby("실|제","實|際")로는 #ruby("왜","倭")#ruby("간|수|장","看|守|長")이나 #ruby("부|장","部|長")놈이 오는가 #ruby("망","望")보는 데 #ruby("불|과","不|過")하다.]
#zh[我跟崔明植君在编织草袋的第三工场担任清扫工作，我们把工具材料分发给犯人后，就在院子里打扫。打扫完毕，就到处走走，看看犯人们编织草袋。在日本看守监工的一个钟头里是没有自由的，但是在韩籍看守监工的半个钟头里，却是比较自由，也较为清闲。这时囚犯们就像开茶话会似的，一个个都在窃窃私语。韩籍看守也和日本看守一样，会大声呵斥：“不准讲话”，实际上这是通风报信，告诉犯人日本看守长或是什么部长来了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 틈에 #ruby("최","崔")#ruby("군","君")과 #ruby("의|견","意|見")의 같고 다름을 #ruby("시|험","試|驗")하기로 하고, 200#ruby("여","餘") #ruby("명","名")을 한 #ruby("번","番")은 올라가면서 살펴보고 한 #ruby("번","番")은 내려오면서 살펴본 뒤, 그#ruby("중","中") 몇째 자리에 앉은 #ruby("자","者")가 #ruby("특|이","特|異")하면 그 #ruby("번|호","番|號")를 써 가지고 서로 맞추어 보아, #ruby("의|견","意|見")이 같으면 그 #ruby("자","者")의 #ruby("인|격","人|格")을 #ruby("조|사","調|査")하여 보기로 했다. 한 #ruby("차|례","次|例")씩 #ruby("시|찰","視|察")하고 돌아와 #ruby("각|기","各|其") 적은 #ruby("번|호","番|號")를 맞추어 보니 #ruby("의|견","意|見")이 #ruby("부|합","符|合")하였다. 그 #ruby("자","者")는 나이가 마흔이 넘어 보이고, 몸가짐과 말은 들어보지 못했지만, 똑같은 일옷을 입었으나 눈에 #ruby("정|기","精|氣")가 들어차 있어 우리 눈에 띄었다.]
#zh[后来我和崔君决定，利用到处转悠的机会，在囚犯中挑选优秀的人材。我们到处转来转去，看到有突出的囚犯就各自记下他们的号码，然后我俩碰面后再互相核对，如果遇有两人同时记下的号码，就开始调查他的来历和为人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫#ruby("번","番")째 #ruby("조|사","調|査")를 내가 하기로 #ruby("언|약","言|約")하고 그 #ruby("자","者")를 찾아가 #ruby("인|사","人|事")를 #ruby("청","請")하며 물었다.]
#zh[约定由我先调查，我找到那人，打招呼问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신은 어디가 #ruby("본|향","本|鄕")이며, #ruby("징|역","懲|役")은 얼마나 되시오?”]
#zh[“你的本乡是哪里，徒刑是多少年？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("괴|산","槐|山")에 살았으며 #ruby("강|도","强|盜") 5#ruby("년","年")이고, #ruby("재|작|년","再|昨|年")에 들어와 이제 3#ruby("년","年") 있으면 #ruby("출|감","出|監")되겠소.”]
#zh[“我住在槐山，强盗五年。前年进来的，再过三年就可以出狱了。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("답","答")하고 그가 #ruby("반|문","反|問")하였다.]
#zh[他这样回答，又反问：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신은?”]
#zh[“你呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("안|악","安|岳")에 살았고 #ruby("강|도","强|盜") 15#ruby("년","年")으로 #ruby("작|년","昨|年")에 #ruby("입|감","入|監")하였소.”]
#zh[“我住在安岳，强盗十五年，去年入狱。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“하! 짐이 좀 무겁게 되었소. #ruby("초|범","初|犯")이시지요?”]
#zh[金进士说：]
#zh[“那可不轻啊！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 그렇소.”]
#zh[“是，是的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈 #ruby("간|수","看|守")가 오므로 그렇게만 #ruby("문|답","問|答")하고 일어나서 와버렸다. 그 사람에게 가서 무슨 이야기하는 것을 본 #ruby("수|인","囚|人") #ruby("중","中")에 내게 묻는 #ruby("자","者")가 있었다.]
#zh[倭寇看守来了，只问答到这里，我站起来走了。看见我去跟那人说话的囚犯里，有人来问我。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“56#ruby("호","號")는 그 사람을 #ruby("이|전","以|前")에 아셨소?”]
#zh[“五十六号，你以前认识那个人吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“몰랐소. 당신은 그가 누구인지 아시오?”]
#zh[“不认识。你知道他是谁吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“알고말고요. #ruby("남|도","南|道") #ruby("도|적","盜|賊")치고 그 사람 모르는 사람은 없을 듯하오.”]
#zh[“当然知道。南道的盗贼，大概没有不认识他的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("흥|미","興|味")가 있어 더 물었다.]
#zh[我有了兴趣，又问：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그가 어떤 사람이오?”]
#zh[“他是怎样的人？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그 사람은 #ruby("삼|남","三|南")의 #ruby("불|한|당","不|汗|黨") #ruby("괴|수","魁|首")인 #ruby("김","金")#ruby("진|사","進|士")입니다. 이 #ruby("감|옥","監|獄")에 #ruby("동|당","同|黨")이 여러 #ruby("명","名")이 있다가 더러는 #ruby("병","病")이 나 죽고, #ruby("사|형","死|刑")도 받고, #ruby("방|면","放|免")된 #ruby("자","者")도 많지요.”]
#zh[“一提到他，南道的盗贼没有一个不认识的，他是三南有名的不汗党首领金进士，这个监狱里就有不少他的部下，有的已经病死，有的被判死刑，也有的被释放了。”]
#zh[译注：①明火执仗的强盗团伙。]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고는 말을 그쳤다. 그날 저녁에 #ruby("감|방","監|房")에 들어오는데, 그 사람이 벌거벗고 우리 뒤를 따라서 들어왔다.]
#zh[那天晚上，我们赤裸着自工场回到牢房时，他也裸着跟在我们后面走进我住的房间来说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘부터는 이 #ruby("방","房")에서 괴로움을 끼치게 됩니다.”]
#zh[“从今天起要在这个房间打扰了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 반기며 말했다.]
#zh[我高兴地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신이 이 #ruby("방","房")으로 #ruby("전|방","轉|房")되셨소?”]
#zh[“你也转到这个房里吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, #ruby("노|형","老|兄") 계신 #ruby("방","房")이로구려.”]
#zh[“是啊！原来老兄住在这个房间。”他也以高兴的口吻说。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("각|각","各|各") #ruby("의|복","衣|服")을 입고 #ruby("점|검","點|檢")을 마친 #ruby("후","後"), 나는 #ruby("수|인","囚|人")들에게 #ruby("철|창","鐵|窓") #ruby("좌|우","左|右")로 귀를 대고 #ruby("간|수","看|守")의 신 끄는 소리가 들리거든 알려달라 #ruby("부|탁","付|託")하고, 그 사람과 #ruby("담|화","談|話")를 #ruby("시|작","始|作")하였다.]
#zh[穿上衣服后，我请同屋的囚犯站在铁窗下给我们望风，便跟金进士谈了起来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("공|장","工|場")에서 #ruby("잠|시","暫|時") #ruby("인|사","人|事")를 하고, #ruby("정","情")다운 이야기 한마디도 못하고 헤어지게 됨을 퍽 #ruby("유|감","遺|憾")으로 생각하고 들어오던 #ruby("차","次")에, #ruby("노|형","老|兄")이 #ruby("방","房")을 옮겨 #ruby("동|거","同|居")하게 되니 퍽도 기쁩니다.”]
#zh[“在工场里只打了个招呼，一句亲热的话也没能说就分开，很是遗憾。进来的时候，老兄转了房，和我同住，非常高兴。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 나 #ruby("역|시","亦|是") #ruby("동|감","同|感")이올시다.”]
#zh[“是，我也同感。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("진|사","進|士")가 내게 마치 #ruby("예|수|교","耶|蘇|敎") #ruby("목|사","牧|師")가 #ruby("교|인","敎|人")에게 #ruby("세|례","洗|禮")#ruby("문|답","問|答")하듯 묻기 #ruby("시|작","始|作")한다.]
#zh[进士开始问我，像耶稣教牧师对教人做洗礼问答一样。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|형","老|兄"), #ruby("강|도","强|盜") 15#ruby("년","年")이라고 하셨지요?”]
#zh[“老兄，你不是因强盗被处刑十五年吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 그렇습니다.”]
#zh[“是的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 #ruby("계|통","系|統")으로 #ruby("추","秋")설이오, #ruby("목|단","牧|丹")설이오, #ruby("북|대","北|隊")요? #ruby("행|락","行|樂")은 얼마 동안이오?”]
#zh[“那么你是属于那个系统呢？是‘秋雪’还是‘牡丹雪’？‘行乐’多久了？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 한마디도 #ruby("대|답","對|答")을 못하였다.]
#zh[我一句也答不上来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("진|사","進|士")는 빙긋이 웃으면서 말했다.]
#zh[进士微微笑着说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|형","老|兄")이 #ruby("북|대","北|隊")인가 싶으오.”]
#zh[“老兄像是‘北大’。”]
#zh[这样说着，他脸上显出有点轻视的样子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 처음 들어보는 #ruby("문|자","文|字")라, “#ruby("북|대","北|隊")라니요”라고 #ruby("반|문","反|問")도 못하고 앉아 있었다. 곁에 앉아 이야기를 듣던 #ruby("수|인","囚|人") #ruby("중","中") 한 사람이 #ruby("김","金")#ruby("진|사","進|士")에게 나를 가리키며 말했다.]
#zh[我头一次听见这种字，连“什么叫北大”也反问不出来，只是坐着。旁边听着话的囚人中，有一个人指着我对金进士说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이분은 #ruby("국|사|범","國|事|犯") #ruby("강|도","强|盜")랍니다. 그런 말씀을 물어서야 #ruby("대|답","對|答") 못할 것이오.”]
#zh[“这位是国事犯强盗。问那种话，他答不上来。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄") 말투로 ‘찰(참)#ruby("강|도","强|盜")’이니 #ruby("계|통","系|統") 있는 #ruby("도|적","盜|賊")이므로, 내가 #ruby("김","金")#ruby("진|사","進|士")의 말에 #ruby("대|답","對|答")을 못하는 #ruby("이|유","理|由")를 말했다.]
#zh[他用监狱的口气说，这是“察（真）强盗”，是有系统的盗贼，所以说明我答不上金进士的话的缘故。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김","金")#ruby("진|사","進|士")는 그 말을 듣고 고개를 끄덕인다.]
#zh[金进士听了，点头。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내 어쩐지 #ruby("공|장","工|場")에서 #ruby("노|형","老|兄")이 #ruby("강|도","强|盜") 15#ruby("년","年")이라 할 때, 아래위 살펴보아도 #ruby("강|도","强|盜") 냄새를 #ruby("발|견","發|見") 못하겠기로 #ruby("북|대","北|隊")인가 보다 했구려.”]
#zh[“我就感到奇怪，刚才在工场里老兄说是因为强盗罪被判十五年，我怎么看也看不出强盗的味道来，所以才说你像‘北大’。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("양|산|학|교","楊|山|學|校") #ruby("사|무|실","事|務|室")에서 여러 #ruby("교|사","敎|師")들이 모여 지낼 때, 우리나라에 #ruby("소|위","所|謂") #ruby("활|빈|당","活|貧|黨")#footnote(numbering: _ => [102)])[#h(0.35em)#ruby("삼|남","三|南")을 #ruby("중|심","中|心")으로 게릴라#ruby("식","式") #ruby("방|식","方|式")으로 #ruby("활|동","活|動")한 #ruby("민|중","民|衆") #ruby("무|장","武|裝")#ruby("집|단","集|團")으로 1900#ruby("년","年")에서 1904#ruby("년","年")까지 #ruby("최|고|조","最|高|潮")에 달했다. #ruby("김","金")#ruby("진|사","進|士")가 #ruby("소|속","所|屬")된 #ruby("추","秋")설은 #ruby("활|빈|당","活|貧|黨")이다.]이니 #ruby("불|한|당","不|汗|黨")이니 하는 여러 가지 #ruby("비|밀|결|사","秘|密|結|社")가 있어서 #ruby("타|진|겁|성","打|鎭|劫|城")에 #ruby("살|인|탈|재","殺|人|奪|財")를 하고도 #ruby("동|섬|서|홀","東|閃|西|忽")에 #ruby("동|작","動|作")이 #ruby("민|활","敏|活")함으로,#footnote(numbering: _ => [103)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("진","鎭")을 치고 #ruby("성","城")을 #ruby("공|격","攻|擊")하여 #ruby("살|인","殺|人")과 #ruby("약|탈","掠|奪")을 하고 #ruby("동","東")에 번쩍 #ruby("서","西")에 번쩍 #ruby("동|작","動|作")이 #ruby("민|활","敏|活")하여”.] #ruby("포|교","捕|校")와 #ruby("군|대","軍|隊")를 풀어도 뿌리를 뽑지 못하는 것을 보면 #ruby("분|명","分|明") #ruby("공|고","鞏|固")한 #ruby("단|결","團|結")과 #ruby("기|민","機|敏")한 #ruby("훈|련","訓|鍊")이 있을 터인데, 우리도 어느날이고 #ruby("독|립|운|동","獨|立|運|動")을 하자면 #ruby("견|고","堅|固")한 #ruby("조|직","組|織")과 #ruby("기|민","機|敏")한 #ruby("훈|련","訓|鍊")이 없이는 #ruby("성|공","成|功")하지 못할 터이니 #ruby("도|적","盜|賊")의 #ruby("결|사","結|社")와 #ruby("훈|련","訓|鍊")을 #ruby("연|구","硏|究")하여 볼 #ruby("필|요","必|要")가 있다 하여, 몇 달을 두고 #ruby("각","各") #ruby("교|사","敎|師")가 #ruby("연|구","硏|究")하다가 끝내 아무런 #ruby("성|과","成|果")가 없었던 것이 생각났다.]
#zh[我想起年前在杨山学校跟教员们谈起的话，江湖上有所谓活贫党与不汗党的团伙，他们侵袭村庄城镇，杀死官员，夺走钱财，他们勇敢而又团结，机动灵活，神出鬼没，捕快和军队也无法把他们斩草除根。我们如果要实行独立运动，就必须有坚强的组织与机敏的训练，因此有必要研究他们结社和训练的方法，可是和教员们一起研究数月，也无结果，就此不了了之。]
#zh[译注：①劫富济贫的绿林好汉。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[3#ruby("일","日") 굶어 #ruby("도|적","盜|賊")할 마음이 생기지 않을 #ruby("자","者") 드물다 하나, 마음만으로 #ruby("도|적","盜|賊")이 될 수는 없다. 한두 #ruby("명","名")의 좀도둑은 #ruby("가|능","可|能")하지만 #ruby("수|십","數|十") #ruby("명","名") #ruby("수|백","數|百") #ruby("명","名")의 #ruby("집|단|체","集|團|體")가 되어 #ruby("일|사|불|란","一|絲|不|亂")하게 움직이는 데에는 반드시 #ruby("지|휘","指|揮") #ruby("명|령","命|令")을 보내는 #ruby("기|관","機|關")과 #ruby("주|동|인|물","主|動|人|物")이 있어야 이끌 수 있을 것이다. 그만한 #ruby("인|물","人|物")이 있다 하면 #ruby("자|격","資|格")과 #ruby("지|량","智|量")이 #ruby("정|부","政|府") #ruby("관|리","官|吏") #ruby("이|상","以|上")의 #ruby("인|격|자","人|格|者")라야 할 것이니, #ruby("연|구","硏|究")·#ruby("조|사","調|査")하여 볼 #ruby("필|요","必|要")가 있다 해서 #ruby("연|구","硏|究")한 것이나, 끝내 #ruby("단|서","端|緖")를 얻지 못하고 말았던 것이다.]
#zh[一个人如果饿上三天，就会起当盗贼的念头，但只光想就成得了吗？一两个越墙钻洞的小偷也许容易，要说几十名、几百名的盗贼团伙，就要有组织、有训练、有条规，更需要有头目的领导才行，能成为几十、几百名强盗团伙的首领，那么他必具有统治一个国家的智慧、勇气与威严。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 일을 생각하고 #ruby("김","金")#ruby("진|사","進|士")에게 바짝 들러붙어 묻기 #ruby("시|작","始|作")했다. #ruby("김","金")#ruby("진|사","進|士")란 #ruby("자","者")가, 내가 #ruby("자|기","自|己")의 #ruby("동|류","同|類") 아님을 #ruby("발|표","發|表")한 #ruby("이|상","以|上") 내게 #ruby("자|기","自|己")네 #ruby("내|막","內|幕")을 다 말하여 줄까 #ruby("의|문","疑|問")이나, 이 #ruby("기|회","機|會")가 아니면 #ruby("평|소","平|素")에 애쓰던 것을 알 수 없다 생각하고 먼저 내 #ruby("신|분","身|分")에 #ruby("대","對")해 #ruby("대|강","大|綱") #ruby("설|명","說|明")한 다음 물었다.]
#zh[想起那件事，我紧贴着金进士问起来。金进士已经知道我不是他们的同类，会不会把内幕全告诉我，还是疑问。我想错过这个机会，平日用心的事就无从知道，先把我的身分大略说明，然后问：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("평|소","平|素")에 귀 #ruby("단|체","團|體")의 #ruby("조|직","組|織") #ruby("훈|련","訓|鍊")을 #ruby("연|구","硏|究")하여 보았으나 #ruby("단|서","端|緖")를 얻지 못하였습니다. #ruby("연|구","硏|究")의 #ruby("목|적","目|的")이 #ruby("도|적","盜|賊")을 #ruby("박|멸","撲|滅")함이 아니고 #ruby("후|일","後|日") 나라일에 #ruby("참|고","參|考")·#ruby("응|용","應|用")하자 함이었으니, #ruby("명|료","明|瞭")하게 #ruby("설|명","說|明")하여 줄 수 있겠습니까?”]
#zh[“平日研究过贵团体的组织训练，却得不到线索。研究的目的不是扑灭盗贼，是日后国家的事要参考、应用，能不能明了地说明？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("진|사","進|士")가 말했다.]
#zh[进士说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("비|밀|결|사","秘|密|結|社")의 #ruby("시|원","始|原")과 #ruby("유|래","由|來")가 여러 백 #ruby("년","年")으로 이제는 #ruby("자|연","自|然") #ruby("공|공|연","公|公|然")한 #ruby("비|밀","秘|密")이 되었으나 #ruby("기|강","紀|綱")이 #ruby("엄|밀","嚴|密")한 탓으로, 나라가 #ruby("망","亡")함에 따라 예로부터 지켜오던 #ruby("사|회","社|會") #ruby("기|강","紀|綱")이 #ruby("여|지","餘|地")없이 #ruby("추|락","墜|落")된 오늘날에도, #ruby("조|선","朝|鮮")에서 ‘#ruby("벌","蜂")의 #ruby("법","法")’과 ‘#ruby("도|적","盜|賊")놈의 #ruby("법","法")’은 그대로 남아 있다고 #ruby("자|인","自|認")합니다. #ruby("노|형","老|兄")을 #ruby("북|대","北|隊")로 생각하고, 알지 못하시는 것을 여러 말로 물은 데 #ruby("대","對")하여 #ruby("미|안","未|安")합니다. 그런즉 #ruby("노|형","老|兄")에게 물은 것에 #ruby("대","對")해 먼저 #ruby("설|명","說|明")을 하고, 이어 #ruby("조|직","組|織")·#ruby("훈|련","訓|鍊")·#ruby("실|행","實|行")의 몇 가지 #ruby("예","例")를 들어 말씀하오리다.]
#zh[“迄今为止，我们国家的精神全被瓦解，只剩下刑罚和盗贼而已。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|선|시|대","朝|鮮|時|代") #ruby("이|전","以|前")은 #ruby("상|고","上|古")할 수 없으나, #ruby("조|선|시|대","朝|鮮|時|代") #ruby("이|후","以|後") #ruby("도|적","盜|賊")의 #ruby("계|파","系|派")와 #ruby("시|원","始|原")은 이렇습니다. #ruby("도|적","盜|賊")이란 이름부터 #ruby("명|예","名|譽")롭지 않거든 누가 #ruby("도|적","盜|賊")질을 좋은 #ruby("직|업","職|業")으로 알고 #ruby("행","行")할 #ruby("자","者") 있으리오만, #ruby("대|개","大|槪")가 #ruby("불|평|자","不|平|者")의 #ruby("반|동|적","反|動|的") #ruby("심|리","心|理")에서 #ruby("기|인","起|因")된 것이외다. #ruby("고|려","高|麗") #ruby("말","末") #ruby("이|성|계","李|成|桂")가 #ruby("신|하","臣|下")로서 임금을 #ruby[쳐서][以臣伐君] 나라를 얻은 #ruby("후","後"), #ruby("당|시","當|時")에 #ruby("두|문|동","杜|門|洞") 72#ruby("인","人")#footnote(numbering: _ => [104)])[#h(0.35em)#ruby("조|선","朝|鮮") #ruby("건|국","建|國")을 #ruby("반|대","反|對")하는 #ruby("고|려","高|麗") #ruby("유|신","遺|臣") #ruby("고|천|상","高|天|祥") #ruby("등","等") 72#ruby("인","人")의 #ruby("충|신","忠|臣")·#ruby("열|사","烈|士")들이 #ruby("망|국","亡|國")의 #ruby("비|애","悲|哀")를 품고 #ruby("두|문|동","杜|門|洞")에 들어가 #ruby("신|왕|조","新|王|朝")에 #ruby("협|력","協|力")하지 않자, #ruby("이|성|계","李|成|桂")는 #ruby("두|문|동","杜|門|洞")을 #ruby("포|위","包|圍")하고 불을 놓아 #ruby("몰|살","沒|殺")시켰다고 한다.] 같은 사람들 #ruby("외","外")에도 #ruby("고|려","高|麗") #ruby("왕|조","王|朝")에 #ruby("충|성","忠|誠")하고자 하는 뜻을 가지고 있는 #ruby("자","者") 많았을 것이오. 그러한 #ruby("지|사","志|士")들이 #ruby("비|밀|리","秘|密|裏")에 #ruby("연|락","連|絡") #ruby("혹","或")은 #ruby("집|단","集|團")하여 가지고, #ruby("약","弱")한 #ruby("자","者")를 #ruby("구|제","救|濟")하고 기운 것을 붙들고자 하는 #ruby("선|의","善|意")와, #ruby("질|서","秩|序")를 #ruby("파|괴","破|壞")하고자 하는 #ruby("보|복|적","報|復|的") #ruby("대|의","大|義")를 #ruby("표|방","標|榜")하고, 구석진 곳에 #ruby("동|지","同|志")를 #ruby("소|집","召|集")하였습니다. #ruby("조|선","朝|鮮")의 #ruby("은|총","恩|寵")과 #ruby("국|록","國|祿")을 먹는 #ruby("자","者"), #ruby("백|성","百|姓")을 #ruby("착|취","搾|取")하는 #ruby("소|위","所|謂") #ruby("양|반","兩|班")이라는 #ruby("족|속","族|屬")과 #ruby("부|유","富|有")한 #ruby("자","者")의 #ruby("재|물","財|物")을 #ruby("탈|취","奪|取")하여 #ruby("빈|한","貧|寒")한 #ruby("백|성","百|姓")을 #ruby("구|제","救|濟")하였는데, 나라에서 #ruby("도|적","盜|賊")이란 이름을 붙여 가지고 500#ruby("여","餘") #ruby("년","年") 동안 #ruby("압|박","壓|迫")·#ruby("도|살","屠|殺")하여 온 것이외다.]
#zh[朝鲜时代以前无从查考，朝鲜时代以后盗贼的系派和始原是这样。盗贼这个名字本来就不名誉，谁会把做贼当作好职业？大概都起于不平者的反动心理。高丽末李成桂以臣子攻打君主得到国家之后，当时杜门洞七十二人那样的人以外，想对高丽王朝尽忠的人一定很多。那些志士在秘密里联络，或是结成集团，标榜救济弱者、扶持将倒者的善意，和要破坏秩序的报复大义，在偏僻的地方召集同志。把吃朝鲜恩宠和国禄的人、剥削百姓的所谓两班，以及富人的财物夺来救济贫寒的百姓。国家贴上盗贼的名字，压迫、屠杀了五百余年。]
#zh[译注：杜门洞七十二人，是反对朝鲜建国的高丽遗臣。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 #ruby("강|원|도","江|原|道")에 #ruby("근|거","根|據")를 둔 #ruby("자","者")들의 #ruby("기|관","機|關") #ruby("명|의","名|義")는 ‘#ruby("목|단","牧|丹")설’이요, #ruby("삼|남","三|南")에 있는 #ruby("기|관","機|關")은 ‘#ruby("추","秋")설’이라 하여 왔습니다. ‘#ruby("북|대","北|隊")’라는 것은 #ruby("무|식","無|識")한 #ruby("자","者")들이 #ruby("임|시","臨|時")#ruby("임|시","臨|時")로 #ruby("작|당","作|黨")하여 #ruby("민|가","民|家")나 털고 #ruby("약|탈","掠|奪")하는 #ruby("자","者")를 말하는데, #ruby("목|단","牧|丹")설과 #ruby("추","秋")설 두 #ruby("기|관","機|關")에 #ruby("속","屬")한 #ruby("사|람","徒|黨")끼리 만나면 #ruby("초|면","初|面")에도 옛 #ruby("친|구","親|舊")처럼 #ruby("동|지","同|志")로 #ruby("인|정","認|定")하고 서로 도우나, #ruby("북|대","北|隊")에 #ruby("대","對")하여는 두 설이 하나같이 #ruby("적|대|시","敵|對|視")하는 #ruby("규|율","規|律")을 #ruby("정","定")하였으므로, 만나기만 하면 #ruby("무|조|건","無|條|件") #ruby("사|형","死|刑")을 하는 것이외다.]
#zh[在江原道有根据地的，机关名义叫“牡丹雪”；在三南的机关叫“秋雪”。“北大”是无识的人临时结党，只扫民家、掠夺的人。属于牡丹雪和秋雪两机关的徒党，初面也像旧友一样认作同志，互相帮助。对北大，两雪一样定了敌视的规律，一见面就无条件处死刑。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("목|단","牧|丹")·#ruby("추","秋") #ruby("양","兩")설의 #ruby("최|고","最|高") #ruby("수|령","首|領")은 ‘#ruby("노|사|장","老|師|丈")’이요, 그 아래에 #ruby("총|사|무","總|事|務")는 ‘#ruby("유|사","有|司")’라 하고, #ruby("각","各") #ruby("지|방","地|方") #ruby("주|관|자","主|管|者")도 ‘#ruby("유|사","有|司")’라 합니다. #ruby("양","兩")설에서 하는 #ruby("공|동|대|회","共|同|大|會")를 ‘큰 #ruby("장","場") 부른다’ 하고, #ruby("각|기","各|其") #ruby("단|독","單|獨")으로 #ruby("부|하","部|下")를 #ruby("소|집","召|集")하는 것을 ‘#ruby("장","場") 부른다’ 하는 것이외다.]
#zh[牡丹、秋两雪的最高首领是“老师丈”，下面总事务叫“有司”，各地方主管者也叫“有司”。两雪的共同大会叫“唤大场”，各自单独召集部下叫“唤场”。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[큰 #ruby("장","場")은 #ruby("종|전","從|前")에는 #ruby("매|년","每|年") 한 #ruby("차|례","次|例")씩 불렀으나 #ruby("지|금","只|今")에 이르러서는 재알이(#ruby("왜","倭")놈)가 하도 #ruby("심","甚")하게 구는 탓으로 #ruby("폐|지","廢|止")하였습니다. #ruby("종|전","從|前")에 큰 #ruby("장","場")을 부른 뒤에는 어느 고을을 털든지 큰 #ruby("시|장","市|場")을 치는 #ruby("운|동","運|動")이 생긴 것이외다. 큰 #ruby("장","場")을 부르는 #ruby("본","本")뜻은 #ruby("도|적","盜|賊")질만 하는 것이 아니고, 설의 #ruby("공|사","公|事")를 #ruby("처|리","處|理")하는 것인데, 그때에 큰 #ruby("시|위","示|威") 삼아 한 #ruby("차|례","次|例") 하는 것이외다. 큰 #ruby("장","場")을 부르는 #ruby("통|지","通|知")에서 #ruby("각","各") #ruby("도","道") #ruby("각","各") #ruby("지|방","地|方")의 #ruby("책|임|자","責|任|者")에게 ‘#ruby("부|하","部|下") 누구누구 몇 #ruby("명","名")을 #ruby("파|송","派|送")하라’ 하면 어김없는데, 흔히 큰 #ruby("시|장","市|場")이나 #ruby("사|찰","寺|刹")로 부르게 됩니다. #ruby("소|명","召|命")을 받고 #ruby("출|정","出|征")하여 가는 데는 돌님장사#footnote(numbering: _ => [105)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “돌림장수”. ‘돌님장사’는 ‘돌림장사’ 또는 ‘#ruby("도|부","到|付")장사’ ‘도붓장사’이다. 한 곳에서 #ruby("점|포","店|鋪")를 열고 장사하는 것이 아니라, 이곳 저곳 떠돌아 다니며 장사하는 사람을 말한다.]로, 중으로, #ruby("상|제","喪|制")로, #ruby("양|반","兩|班") #ruby("행|차","行|次")로, 등짐장수로 #ruby("형|형|색|색","形|形|色|色") #ruby("별|별","別|別") #ruby("형|식","形|式")으로 #ruby("가|장","假|裝")해서 갑니다.]
#zh[从前大场每年唤一次，到了现在，因为倭寇闹得太厉害，废止了。从前唤过大场之后，便兴起扫荡某邑、袭击大市场的运动。唤大场的本意不是只做盗贼的事，是处理雪的公事，那时当作一次大示威。唤大场的通知里，对各道各地方的责任者说“派部下某某几名”，没有差错，常常叫到大市场或寺刹。奉召出征的人，扮成走贩、和尚、丧制、两班行次、背货商，形形色色，各种样子伪装着去。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("일|례","一|例")를 들면 #ruby("연|전","年|前")에 #ruby("하|동","河|東") #ruby("화|개|장","花|開|場")에서 큰 #ruby("장","場")을 부르는데 볼 만하였습니다. 그 #ruby("장","場")날을 #ruby("이|용","利|用")한 것인데, #ruby("사|방","四|方")으로 #ruby("장","場")을 보러 오는 사람이 길에 차서 몰려들어올 때, 거기에 섞여 #ruby("도|적","盜|賊")놈들도 들어오지요. #ruby("시|장","市|場")이 한창일 #ruby[때][中場] 어떤 #ruby("행|상","行|喪")이 들어오는데, #ruby("상|주","喪|主")가 #ruby("삼|형|제","三|兄|弟")요, 그 뒤에는 #ruby("상|복","喪|服") 입은 사람들과 말 위에서 #ruby("호|상","護|喪")하는 사람도 많고, #ruby("상|여","喪|輿")는 #ruby("비|단","緋|緞")으로 맵시 있게 꾸몄고, #ruby("상|여","喪|輿")꾼도 #ruby("일|제","一|齊")히 #ruby("소|복","素|服")으로 차려 입었습니다.]
#zh[举一个例，年前在河东花开场唤大场，很可看。利用的是场日。四方来赶场的人把路挤满涌进来，盗贼也混在里面。市场正中的时候，进来一队行丧，丧主是三兄弟，后面穿丧服的人很多，马上护丧的人也多，丧舆用绯缎打扮得体面，抬舆的人也一齐穿上素服。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("시|내","市|內")에 들어와서 큰 #ruby("주|점","酒|店") 뜰에 #ruby("상|여","喪|輿")를 세우고 나서, #ruby("상|주","喪|主")들은 #ruby("죽|장","竹|杖")을 짚고 ‘아이구! 아이구!’ #ruby("상|여","喪|輿") 앞에서 #ruby("곡","哭")을 합니다. #ruby("상|여","喪|輿")꾼들에게 술을 먹일 때, 어떤 #ruby("호|상|객","護|喪|客") 한 #ruby("명","名")이 #ruby("갯|국","狗|湯") 한 그릇을 사 가지고 #ruby("상|주","喪|主")에게 #ruby("권","勸")합니다. #ruby("상|주","喪|主")가 #ruby("온|순","溫|順")하게 그 #ruby("자","者")를 #ruby("향","向")하여]
#zh[进了市内，把丧舆停在大酒店的院子里，丧主拄着竹杖，在丧舆前哭“哎哟！哎哟！”给抬舆的人酒吃的时候，一个护丧客买了一碗狗肉汤劝丧主。丧主温顺地对那人说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘무슨 #ruby("희|롱","戲|弄")을 못해서 #ruby("상|제","喪|制")에게 갯국을 권하는가? 그리 말라.’]
#zh[“有什么戏弄，竟劝丧制吃狗肉汤？别这样。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하여도, 갯국을 권하던 #ruby("호|상|인","護|喪|人")은 도리어 #ruby("강|권","强|勸")하여 기어이 #ruby("상|제","喪|制")들에게 갯국을 먹이려 합니다. #ruby("온|유","溫|柔")하던 #ruby("상|주","喪|主")들도 차차 #ruby("노|기","怒|氣")를 띠고 #ruby("거|절","拒|絕")합니다.]
#zh[可是劝狗肉汤的护丧人反而强劝，一定要丧制吃。本来温顺的丧主也渐渐带了怒气，拒绝。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘아무리 #ruby("무|례","無|禮")한 놈이기로 #ruby("초|상","初|喪")하는 #ruby("상|제","喪|制")더러 갯국 먹으라는 놈이 어디 있느냐?’]
#zh[“再无礼，哪有叫初丧的丧制吃狗肉汤的？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘#ruby("친|구","親|舊")가 #ruby("권","勸")하는 갯국을 좀 먹으면 못쓰느냐?’]
#zh[“朋友劝的狗肉汤，吃一点怎么不行？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이렇게 차차 싸움이 됩니다.]
#zh[就这样渐渐打起来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다른 #ruby("호|상|인","護|喪|人")들도 싸움 말린다고 #ruby("야|단","惹|端")치고, #ruby("장","場")꾼들의 눈이 다 그리로 #ruby("집|중","集|中")되어 웃기를 마지 아니할 즈음, #ruby("상|주","喪|主") 3#ruby("형|제","兄|弟")가 #ruby("죽|장","竹|杖")을 들어 #ruby("상|여","喪|輿")를 부수고 #ruby("널","柩")을 깨고 널의 뚜껑을 획 잡아 제친즉, #ruby("시|체","屍|體")는 없고 5#ruby("연|발","連|發") #ruby("장|총","長|銃")이 가득 들었습니다. #ruby("상|주","喪|主")·#ruby("호|상","護|喪")꾼·#ruby("상|여","喪|輿")꾼이 #ruby("총","銃") 한 자루씩을 들고, #ruby("사|방","四|方") 길목을 지켜 #ruby("출|입","出|入")을 막고, #ruby("시|장","市|場")에 놓인 돈과 집에 쌓아둔 #ruby("부|상","富|商")의 돈 #ruby("전|부","全|部")를 #ruby("탈|취","奪|取")하여 가지고 #ruby("쌍|계|사","雙|溪|寺")에서 #ruby("공|사","公|事")를 마치고 헤어졌습니다.]
#zh[别的护丧人也嚷着劝架，场上人的眼睛都集中到那里，笑个不停的时候，丧主三兄弟举起竹杖，砸破丧舆，打破棺材，一把掀开棺盖，里面没有尸体，装满了五连发长枪。丧主、护丧的、抬舆的各拿一支枪，守住四方路口，堵住出入，把市场上放着的钱和家里囤着的富商的钱全部夺走，在双溪寺办完公事，散了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("노|형","老|兄")이 #ruby("황|해|도","黃|海|道")에 사시니, #ruby("연|전","年|前")에 #ruby("청|단|장","靑|丹|場")을 치고 #ruby("곡|산","谷|山") #ruby("군|수","郡|守")를 죽인 #ruby("소|문","所|聞")을 들었을 것입니다. #ruby("청|단|장","靑|丹|場")을 칠 때는 내가 #ruby("총|지|휘","總|指|揮")로 #ruby("도|당","徒|黨")을 #ruby("영|솔","領|率")했습니다. 나는 어떤 #ruby("양|반","兩|班")의 #ruby("행|차","行|次")로 #ruby("가|장","假|裝")하여 네 사람이 끄는 #ruby("사|인|교","四|人|轎")를 타고 따르는 #ruby("하|인","下|人")들을 늘어 세워 #ruby("호|기","豪|氣") 있게 달려들어 #ruby("시|장","市|場") #ruby("사|무","事|務")를 #ruby("무|사","無|事")히 마치고, #ruby("질|풍|뇌|우","疾|風|雷|雨")같이 #ruby("곡|산","谷|山") #ruby("군|아","郡|衙")를 #ruby("습|격","襲|擊")하였는데, #ruby("군|수","郡|守")놈이 하도 #ruby("인|민","人|民")을 #ruby("어|육","漁|肉")하엿기로#footnote(numbering: _ => [106)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("인|민","人|民")을 #ruby("절|단","切|斷")내길래”.] 죽여버렸지요.”]
#zh[“老兄来自黄海道吗？那么可晓得年前侵袭青丹赶集场，杀死谷山郡守的事吧！”]
#zh[我说是的，金进士像是回想着过去的事，而感觉到很愉快似地笑着说：]
#zh[“那时候指挥党徒的就是我，我穿着两班的服饰，乘着四人轿由家丁们前呼后拥着，浩浩荡荡地进入青丹赶集场，在赶集场办完事后像疾风迅雷般地进入谷山邑杀死了郡守；那个家伙虐待百姓，鱼肉乡里，我们是替天行道，他罪有应得。”我问他：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|형","老|兄")의 #ruby("금|번","今|番") #ruby("징|역","懲|役")이 그 #ruby("사|실","事|實") 때문이오?”]
#zh[“那么你是因此事入狱的吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아니오. #ruby("만|약","萬|若") 그 #ruby("사|실","事|實")이라면 5#ruby("년","年")만 지겠습니까? 이미 #ruby("징|역","懲|役")을 #ruby("면","免")하기 어렵게 되었기로 #ruby("약|소","約|小")한 #ruby("사|건","事|件")을 #ruby("실|토","實|吐")하였더니 5#ruby("년|형","年|刑")을 받았소.]
#zh[“不，如果是为了那事件入狱，五年会够吗？我总觉得这次不会轻易脱身，所以只供出一件不太重要的事件，才判五年徒刑的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|직","組|織") #ruby("방|법","方|法")에 #ruby("대","對")하여는 #ruby("근|본","根|本") #ruby("비|밀|결|사","秘|密|結|社")인 만큼 #ruby("엄|밀","嚴|密")하고 #ruby("기|계|적","機|械|的")이므로 #ruby("설|명","說|明")을 #ruby("충|분","充|分")히 해드리기 어려우나, #ruby("노|형","老|兄")이 #ruby("연|구","硏|究")하여 보아도 #ruby("단|서","端|緖")를 얻지 못하였다는 #ruby("점","點")에서부터 말씀하지요. #ruby("도|당","徒|黨")은 #ruby("수|효","數|爻")만 많고 #ruby("정|밀","精|密")치 못한 것보다는 #ruby("수|효","數|爻")가 적어도 #ruby("정|밀","精|密")한 것을 #ruby("목|적","目|的")으로 하기 때문에, #ruby("각","各") #ruby("도","道") #ruby("각","各") #ruby("지|방","地|方") #ruby("책|임","責|任") #ruby("유|사","有|司")에게 #ruby("노|사|장","老|師|丈")이 #ruby("매|년","每|年") #ruby("각","各") #ruby("분","分")설에서 #ruby("자|격|자","資|格|者") 한 #ruby("명","名")씩을 #ruby("정|밀","精|密") #ruby("조|사","調|査")하여 #ruby("보|고","報|告")케 합니다. 그 #ruby("자|격|자","資|格|者")란 것은,]
#zh[至于组织方法，根本是秘密结社，又严密又机械，难以充分说明，就从老兄研究了也得不到线索这一点说起。徒党与其人数多而不精密，不如人数少而精密，所以老师丈每年让各道各地方的责任有司，在各分雪精密调查一名资格者来报告。那资格者是：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째, 눈빛이 굳세고 맑을 것,]
#zh[第一，眼色要坚定、清澈，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[둘째, 아래가 맑고,]
#zh[第二，下面要清，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[셋째, #ruby("담|력","膽|力")이 #ruby("강|실","强|實")할 것,]
#zh[第三，胆力要强实，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[넷째, #ruby("성|품","性|品")이 #ruby("침|착","沈|着")할 것,]
#zh[第四，性情要沉着。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|상","以|上") 몇 가지를 갖춘 #ruby("자","者")를 #ruby("은|밀","隱|密")히 #ruby("보|고","報|告")하면, 설의 #ruby("지|도|부","指|導|部")에서 #ruby("보|고","報|告") 올린 #ruby("유|사","有|司")도 모르게 다시 #ruby("비|밀|조|사","秘|密|調|査")를 하여, #ruby("조|사","調|査")가 서로 #ruby("부|합","符|合")될 때 그 설 #ruby("책|임","責|任")#ruby("유|사","有|司")에게 맡겨 #ruby("합|격|자","合|格|者")를 #ruby("도|적","盜|賊")놈으로 만듭니다.]
#zh[把具备以上几条的人秘密报告，雪的指导部再做秘密调查，连报告上来的有司也不让知道。调查彼此符合的时候，交给那雪的责任有司，把合格者造成盗贼。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("합|격|자","合|格|者")는 #ruby("물|론","勿|論") #ruby("자|기","自|己")에게 #ruby("대","對")하여 #ruby("보|고","報|告")를 하거나 #ruby("조|사","調|査")하는 것을 #ruby("완|전","完|全")히 모르게 합니다. #ruby("책|임","責|任") #ruby("유|사","有|司")가 #ruby("노|사|장","老|師|丈")의 #ruby("분|부","分|付")를 받들어 #ruby("자|격|자","資|格|者")에게 #ruby("착|수","着|手")하는 #ruby("방|법","方|法")은, 먼저 그 #ruby("자|격|자","資|格|者")가 즐기고 좋아하는 것을 알아보고, #ruby("여|색","女|色")을 좋아하는 #ruby("자","者")에게는 #ruby("미|색","美|色")으로, 술을 즐겨 마시는 #ruby("자","者")에게는 술로, #ruby("재|물","財|物")을 좋아하는 #ruby("자","者")는 #ruby("재|물","財|物")로 #ruby("극|진","極|盡")히 #ruby("정","情")을 베풀어 #ruby("환|심","歡|心")을 사서 #ruby("친|형|제","親|兄|弟") #ruby("이|상","以|上")으로 #ruby("정|의","情|義")가 #ruby("밀|착","密|着")케 된 #ruby("후","後") #ruby("훈|련","訓|鍊")을 #ruby("시|작","始|作")하는 것입니다.]
#zh[合格者当然完全不知道有人报告自己、调查自己。责任有司奉老师丈的吩咐，向资格者着手的方法，是先查明他喜好什么。好女色的用美色，好喝酒的用酒，好财物的用财物，极尽情意买他的欢心，情义密着到亲兄弟以上之后，才开始训练。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("방|법","方|法")의 #ruby("일|단","一|端")을 말하면, #ruby("책|임|자","責|任|者")가 #ruby("자|격|자","資|格|者")와 같이 어디 가서 놀다가 밤 깊은 #ruby("후","後") 같이 돌아오다 어떤 집 #ruby("문","門") 앞에 와서 #ruby("책|임|자","責|任|者")가]
#zh[说方法的一端：责任者和资格者一起到哪里去玩，夜深了一同回来，到了某家门前，责任者]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘그대가 #ruby("잠|시","暫|時") 동안만 이 #ruby("문","門") 밖에서 기다려 주면 내가 이 집에 들어가서 #ruby("주|인","主|人")을 보고 곧 나오겠다.’]
#zh[“你在这门外稍等一会，我进这家见了主人就出来。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("요|청","要|請")하면, #ruby("자|격|자","資|格|者")는 아무것도 모르고 #ruby("문","門") 밖에서 나오기를 기다리고 섰을 것이외다. 갑자기 안마당으로부터]
#zh[这样请求，资格者什么也不知道，便站在门外等他出来。忽然从内院]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘#ruby("도|적","盜|賊")이야!’]
#zh[“有贼！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|함","高|喊")이 일어나고 그 집 #ruby("주|위","周|圍")로 벌써 #ruby("포|교","捕|校")가 달려들어, #ruby("우|선","于|先") #ruby("문|전","門|前")에 서 있던 #ruby("자|격|자","資|格|者")를 #ruby("포|박","捕|縛")하고, 안마당에 #ruby("침|입","侵|入")하였던 #ruby("책|임|자","責|任|者")를 #ruby("포|박","捕|縛")하여 가지고, 깊은 산골로 끌고 가서 #ruby("신|문","訊|問")을 #ruby("개|시","開|始")합니다. #ruby("주","主")로 #ruby("자|격|자","資|格|者")에게 #ruby("대","對")하여 70#ruby("여","餘") #ruby("종","種")의 #ruby("악|형","惡|刑")으로 #ruby("고|문","拷|問")을 해서, #ruby("자|기","自|己")가 #ruby("도|적","盜|賊")이라고 말하면 그 자리에서 #ruby("흔|적","痕|跡") 없이 죽여버리고, 끝끝내 #ruby("도|적","盜|賊")이 아니라고 #ruby("고|집","固|執")하는 #ruby("자","者")는 #ruby("포|박","捕|縛")을 푼 #ruby("후","後") 외진 곳에 데리고 가 며칠#ruby("간","間") 술과 고기를 잘 먹여가지고 #ruby("입|당|식","入|黨|式")을 #ruby("거|행","擧|行")합니다.]
#zh[高喊起来，捕校已经从房子四周扑来，先把站在门前的资格者捕缚，再把侵入内院的责任者捕缚，拖到深山沟里开始讯问。主要对资格者用七十余种恶刑拷问。自己承认是盗贼的，当场杀得没有痕迹；到底坚持说不是盗贼的，解开捕缚，带到偏僻地方，几天好好给酒肉吃，然后举行入党式。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("입|당|식","入|黨|式")에는 #ruby("책|임","責|任") #ruby("유|사","有|司")가 #ruby("정|석","正|席")에 앉고, #ruby("자|격|자","資|格|者")를 앞에 꿇어앉히고 입을 벌리라 한 뒤, 칼을 빼 그 끝을 입 안에 넣고 #ruby("자|격|자","資|格|者")에게]
#zh[入党式上，责任有司坐在正席，让资格者跪在前面，叫他张嘴，拔出刀，把刀尖放进嘴里，对资格者]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘위아래 이빨로 칼끝을 힘껏 물라.’]
#zh[“用上下牙用力咬住刀尖。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("호|령","號|令")합니다. 그리고 칼을 잡았던 손을 놓고 나서 다시]
#zh[这样号令。然后放开握刀的手，又]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘네가 하늘을 쳐다보아라. 땅을 내려다보아라. 나를 보아라.’]
#zh[“你抬头看天。低头看地。看我。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("호|령","號|令")한 뒤, 다시 칼을 입 안에서 빼 칼집에 넣고 #ruby("자|격|자","資|格|者")에게]
#zh[号令之后，再把刀从嘴里拔出来，插入刀鞘，对资格者]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘너는 하늘을 알고 땅을 알고 사람을 안즉 #ruby("확|실","確|實")히 우리의 #ruby("동|지","同|志")로 #ruby("인|정","認|定")한다.’]
#zh[“你知天、知地、知人，确实认作我们的同志。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("선|고","宣|告")합니다.]
#zh[这样宣告。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("식","式")을 마친 #ruby("후","後")에는 #ruby("입|당|자","入|黨|者")까지 #ruby("영|솔","領|率")하여 #ruby("예|정","豫|定") #ruby("방|침","方|針")에 #ruby("의","依")해 #ruby("정|식","正|式")으로 #ruby("강|도","强|盜")질 한 #ruby("차|례","次|例")를 하고, 빼앗은 #ruby("장|물","贓|物")을 #ruby("신|입|당|원","新|入|黨|員")까지 고르게 나누어줍니다. 몇 #ruby("차|례","次|例")만 #ruby("동|행","同|行")하면 #ruby("완|전","完|全")한 #ruby("도|적","盜|賊")놈이 됩니다.”]
#zh[式完之后，连入党者一起率领，按预定方针正式做一次强盗，把夺来的赃物连新入党员平均分开。同行几次，就成了完全的盗贼。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 또 #ruby("김","金")#ruby("진|사","進|士")에게 물었다.]
#zh[我又问金进士：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|지","同|志")가 #ruby("사|방","四|方")에 흩어져 움직이니 #ruby("동|지","同|志")들이 서로 모를 사람도 많을 것이고 그러면 서로 만나서 #ruby("충|돌","衝|突")을 피하기 어렵고 여러 가지 #ruby("불|편","不|便")할 터인데, #ruby("동|지","同|志")들은 서로 무엇으로 #ruby("표|별","表|別")합니까?”]
#zh[“你们的党徒四散活动，彼此又不认识，相遇时难以避免冲突，有很多不便，是不是有什么暗号标识？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇지요. 우리의 #ruby("표|별","表|別")은 자주자주 고치는 까닭에 #ruby("영|구","永|久")히 #ruby("정","定")해진 것이 없으나 반드시 #ruby("표|별","表|別")은 있습니다. #ruby("일|례","一|例")를 들면, 얼마 #ruby("전","前") 어떤 #ruby("여|관","旅|館")에 #ruby[대상인][大商] 몇 #ruby("명","名")이 #ruby("숙|박","宿|泊")함을 알고 밤#ruby("중","中")에 #ruby("도|당","徒|黨")을 이끌고 #ruby("침|입","侵|入")하여 #ruby("재|물","財|物")을 #ruby("약|탈","掠|奪")하는데, 갑자기 #ruby("좌|중","座|中")에 낯을 땅에 대고 꿈적을 못하는 사람 가운데 한 사람이 #ruby("반","半")벙어리 말로 ‘에구, 나도 #ruby("장","醬") 담글 때 추렴돈 석 #ruby("냥","兩") 내었는데요’ 하고 우리끼리 #ruby("통","通")하는 #ruby("표|별","表|別")을 말합니다. ‘저놈, #ruby("방|자","放|恣")스럽게 무슨 #ruby("수|작","酬|酌")을 하니, 저놈부터 동여 앞세우라’ 하여 끌고 와서 #ruby("문|답","問|答")한 #ruby("결|과","結|果") #ruby("확|실","確|實")히 #ruby("동|지","同|志")입니다. 그런 #ruby("경|우","境|遇")에는 그 #ruby("동|지","同|志")까지 #ruby("장|물","贓|物") 나누는 것을 같이 하는 것이 #ruby("법","法")입니다.”]
#zh[“是啊，我们的暗号标识经常变化，没有永久固定的，但暗号总是有的。举例说，年前有几个大商贾住进了旅店，我们得悉后，半夜里带领同党冲了进去，搜劫财物，他们都匍匐在地，不敢动弹，其中有一人结结巴巴地说：‘哎，做酱时我也出了三两份子钱的。’‘放肆，给我绑了，把他拉出去！’拉到面前问清后，确实是我们的同志，这样我们分赃时也有他一份。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 또 물었다.]
#zh[我又问：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("혹|시","或|是") 듣건데, #ruby("도|적","盜|賊")한 #ruby("장|물","贓|物")을 #ruby("분|배","分|配")하다가 싸움이 되어 그로 #ruby("인","因")해 #ruby("발|각","發|覺") #ruby("체|포","逮|捕")된다고 하니, 그것이 #ruby("결|점","缺|點")이 아니오?”]
#zh[“我听说强盗分赃有时分得不均，常引起争斗，往往把事情暴露了，遭到逮捕，这不能不是个缺点。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그것이 #ruby("소|위","所|謂") #ruby("북|대","北|隊")의 #ruby("소|행","所|行")입니다. 우리 #ruby("계|통","系|統") 있는 #ruby("도|적","盜|賊")은 #ruby("절|대","絕|對")로 그런 #ruby("추|태","醜|態")가 없습니다. 첫째 우리는 #ruby("임|시","臨|時")#ruby("임|시","臨|時")로 #ruby("도|적","盜|賊")질을 자주 하는 것이 아니고 1#ruby("년","年")에 한 #ruby("차|례","次|例")요, 많아야 두세 #ruby("번","番")에 #ruby("불|과","不|過")합니다. #ruby("장|물","贓|物") 나누기에는 더욱 예로부터 #ruby("정","定")한 #ruby("규|칙","規|則")에 #ruby("의","依")하여 #ruby("분|배","分|配")하되, 백 #ruby("분","分")에 몇 #ruby("분","分")은 #ruby("노|사|장","老|師|丈")에게로, 그 다음 #ruby("각","各") #ruby("지|방","地|方")의 #ruby("공|용","公|用"), 몇 #ruby("분","分")은 #ruby("조|난","遭|難")당한 #ruby("유|족","遺|族")의 #ruby("구|제|비","救|濟|費"), 이처럼 몇 #ruby("분","分")을 먼저 #ruby("제|한","制|限") #ruby("후","後") #ruby("극|단","極|端")의 #ruby("모|험","冒|險")을 #ruby("감|수","甘|受")한 #ruby("자","者")에게 #ruby("장|려|금","奬|勵|金")까지 주고 나서, #ruby("평|균","平|均") #ruby("분|배","分|配")하므로 그런 #ruby("폐","弊")는 #ruby("결","決")코 없습니다.]
#zh[“这是北大他们干的。凡属于我们系统的决不会有此丑事。首先我们决不经常外出抢劫，一年最多也不过两三次，分赃也都按老规矩分配，百分之几归老师丈，百分之几是各地方的公积金，遇难的遗族救济费也占去若干，除去这些外，还要划出一部分奖金给最担风险的人，剩下的平均分配，决无分赃不公的现象。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리 #ruby("법","法")에 4#ruby("대","大") #ruby("사|형|죄","死|刑|罪")가 있습니다.]
#zh[我们的法里有四大死刑罪。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제|1|조","第|一|條"), #ruby("동|지","同|志")의 #ruby("처|첩","妻|妾")을 #ruby("간|통","姦|通")한 #ruby("자","者"),]
#zh[第一条，奸通同志妻妾的，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제|2|조","第|二|條"), #ruby("체|포","逮|捕")·#ruby("신|문","訊|問") 때에 #ruby("자|기","自|己") #ruby("동|료","同|僚")를 #ruby("실|토","實|吐")한 #ruby("자","者"),]
#zh[第二条，逮捕、讯问时吐出自己同僚的，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제|3|조","第|三|條"), #ruby("도|적","盜|賊")질할 때 #ruby("장|물","贓|物")을 #ruby("은|닉","隱|匿")한 #ruby("자","者"),]
#zh[第三条，做盗贼时隐匿赃物的，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제|4|조","第|四|條"), #ruby("동|료","同|僚")의 #ruby("재|물","財|物")을 #ruby("강|탈","强|奪")한 #ruby("자","者")입니다.]
#zh[第四条，强夺同僚财物的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("포|교","捕|校")는 #ruby("피","避")하여 멀리 #ruby("도|주","逃|走")하면 #ruby("혹|시","或|是") #ruby("생|명","生|命")을 #ruby("보|존","保|存")할 수 있으나, 우리 #ruby("법","法")으로 #ruby("사|형","死|刑")을 받고 그물을 빠져나가기는 #ruby("지|극","至|極")히 어렵습니다. 그리고 #ruby("도|적","盜|賊")질하기 싫든지 나이 많아 #ruby("도|당","徒|黨")에서 물러나기를 #ruby("청|원","請|願")하여도, #ruby("동|지","同|志")가 #ruby("급","急")한 #ruby("경|우","境|遇") #ruby("자|기","自|己") 집에 숨겨주는 한 가지 일만은 #ruby("응|낙","應|諾")한다는 #ruby("서|약","誓|約")을 받고 난 뒤, #ruby("행|락","行|樂")을 #ruby("면|제","免|除")하여 줍니다.”]
#zh[捕校若避开、远远逃走，或许能保全性命，可是受了我们法的死刑，要脱出罗网就极难。而且不愿意做盗贼，或是年纪大了、请愿退出徒党，也要他发誓：同志急迫的时候，藏在自己家里这一件事答应下来，然后才免除行乐。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("행|락","行|樂")이 무엇이오?”]
#zh[“什么叫‘行乐’？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("즉","卽") #ruby("도|적","盜|賊")질을 이름하여 #ruby("행|락","行|樂")이라 합니다.”]
#zh[“我们把抢劫称为‘行乐’。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("만|일","萬|一") #ruby("행|락","行|樂")을 하다가 #ruby("포|교","捕|校")에게 #ruby("체|포","逮|捕")되면 #ruby("생|환","生|還")시킬 #ruby("방|법","方|法")은 없습니까?”]
#zh[我又问道：]
#zh[“假如行乐被捕，有无使之生还的方法？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보, 우리라고 잡히는 족족 다 죽는다면 여러 백 #ruby("년","年") 동안에 #ruby("근|거","根|據")가 #ruby("소|멸","消|滅")되었을 것이오. 우리 떼설이(떼#ruby("도|적","盜|賊"))가 #ruby("민|간","民|間")에만 있지 않고 #ruby("사|환|계","仕|宦|界"), #ruby("특","特")히 #ruby("포|도|청","捕|盜|廳")과 #ruby("군|대","軍|隊")에 #ruby("요|직","要|職")을 가지도록 하였다가, 어느 #ruby("도","道")에서 #ruby("도|적","盜|賊")이 잡힌 #ruby("후","後")에 서울로 #ruby("보|고","報|告")가 오면 #ruby("자|연","自|然") 바른 #ruby("도|적","正|賊") 곧 설과, 가짜 #ruby("도|적","假|賊") #ruby("북|대","北|隊")를 #ruby("변|별","辨|別")할 수 있으니, #ruby("북|대","北|隊")는 #ruby("지|방","地|方") #ruby("처|결","處|決")에 맡기고 바른 #ruby("도|적","盜|賊")은 서울로 #ruby("압|송","押|送")하여 #ruby("동|료","同|僚")를 #ruby("실|토","實|吐")한 #ruby("자","者")는 #ruby("사|형","死|刑")케 하고, #ruby("자|기","自|己") #ruby("사|실","事|實")만 #ruby("공|술","供|述")한 #ruby("자","者")는 기어이 살려서 옷과 밥을 주고 #ruby("출|옥","出|獄")시킵니다.”]
#zh[“嘿，要是我们被捕一个死一个，几百年后岂不是绝种断根了？其实我们不光是在民间，就是在官府，尤其是在捕盗厅和军队里，都有身居要职者，某道抓到盗贼，上报到京城，自然能分清是‘雪’还是‘北大’。如是‘北大’就让地方处决，如是属于‘雪’系统的盗贼，就让押到京城审问，要是他供出同伙，就处以死刑，只招认自己的事而不牵连他人，那就要供之以衣食，千方百计地救他出狱。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김","金")#ruby("진|사","進|士")의 말을 듣고 나는 생각하여 보았다. 내가 #ruby("국|사","國|事")를 #ruby("위","爲")하여 #ruby("원|대","遠|大")한 #ruby("계|획","計|劃")을 품고 #ruby("비|밀|결|사","秘|密|結|社")로 일어난 #ruby("신|민|회","新|民|會") #ruby("회|원","會|員")의 한 사람이지만, 저 #ruby("강|도|단","强|盜|團")에 #ruby("비","比")하면 아무것도 아니다. 우리의 #ruby("조|직","組|織")과 #ruby("훈|련","訓|鍊")이 아주 #ruby("유|치","幼|稚")한 것을 깨닫고 부끄러움을 #ruby("금","禁")할 수 없었다. #ruby("당|시","當|時") #ruby("옥|중","獄|中")의 #ruby("수|인","囚|人")들 #ruby("중","中")에도 이같은 #ruby("강|도","强|盜")의 #ruby("인|격","人|格")이 #ruby("제|일","第|一")이므로, #ruby("왜","倭")놈에게 #ruby("의|뢰","依|賴")하여 #ruby("순|사","巡|査")나 #ruby("헌|병","憲|兵")#ruby("보|조|원","補|助|員") #ruby("등","等") #ruby("왜|관|리","倭|官|吏")를 하다가 들어온 #ruby("자","者")는 #ruby("감","敢")히 #ruby("수|인","囚|人")들 #ruby("중","中")에 머리를 들지 못하고, #ruby("사|기","詐|欺")·#ruby("절|도","竊|盜")·#ruby("횡|령|범","橫|領|犯")들도 #ruby("강|도","强|盜") 앞에서는 옴짝을 못하기 때문에 #ruby("수|인|계","囚|人|界")의 #ruby("권|위","權|威")를 #ruby("강|도","强|盜")가 잡고 있었다.]
#zh[我听了金进士的话，想了想。我虽是为国事怀着远大计划、以秘密结社起来的新民会会员之一，比起那强盗团却什么也不是。明白我们的组织和训练非常幼稚，禁不住羞耻。当时狱中的囚人里，这类强盗的人格也算第一，所以投靠倭寇、当过巡查或宪兵补助员等倭官吏进来的人，不敢在囚人中间抬头；诈欺、窃盗、横领的犯人在强盗面前也动弹不得，囚人界的权威便抓在强盗手里。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 우리 #ruby("동|지","同|志") #ruby("중","中")에는 목단#ruby("계","系") 추#ruby("계","系")#footnote(numbering: _ => [107)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("목|단","牧|丹")설·#ruby("추","秋")설”. 이것으로 보아 ‘설’은 ‘#ruby("계|통","系|統")’을 #ruby("의|미","意|味")하는 것이다.] #ruby("강|도","强|盜")보다 #ruby("월|등","越|等")한 #ruby("행|동","行|狀")을 한 사람이 많은데, 그#ruby("중","中")에는 #ruby("고|정|화","高|貞|華")가 #ruby("의|식","衣|食") #ruby("항|쟁","抗|爭")을 벌인 것을 #ruby("위|시","爲|始")하여, #ruby("고|봉|수","高|鳳|洙")가 #ruby("담|임","擔|任")#ruby("간|수","看|守")를 발로 차 거꾸러뜨렸다가 #ruby("간|수","看|守")가 일어난 #ruby("후","後")에도 #ruby("죄","罪")를 받지 않고 도리어 #ruby("상|표","賞|表")를 받은 것도 #ruby("특|이","特|異")한 것이었다. 그 #ruby("왜","倭")놈 #ruby("간|수","看|守")는 #ruby("수|인","囚|人")에게 #ruby("욕","辱")당한 것을 #ruby("상|관","上|官")에게 #ruby("보|고","報|告")하자니 #ruby("자|기","自|己")가 #ruby("욕","辱")먹겠으므로 #ruby("고|봉|수","高|鳳|洙")의 #ruby("행|동","行|動")이 #ruby("극","極")히 #ruby("모|범","模|範")이라고 #ruby("보|고","報|告")했던 것이다. 그밖에 #ruby("김|홍|량","金|鴻|亮")이 #ruby("간|수","看|守")들을 #ruby("매|수","買|收")하여 #ruby("보|약","補|藥")을 #ruby("비|밀","秘|密")히 갖다 먹고 #ruby("각","各") #ruby("신|문","新|聞")을 들여다보는 것 #ruby("등","等")이 있는데, 그#ruby("중","中")에서도 가장 #ruby("특|출","特|出")한 #ruby("자","者")는 #ruby("도|인|권","都|仁|權")이다.]
#zh[可是我们同志里面，行动比牡丹系、秋系强盗还高出一等的人很多。其中以高贞华发起衣食抗争为首；高凤洙把担任看守一脚踢倒，看守起来之后不但不受罪，反而得了赏表，也很特异。那个倭寇看守若把受囚人侮辱的事报告上官，自己要丢脸，所以报告说高凤洙的行动极其模范。此外还有金鸿亮收买看守，秘密拿补药来吃、看各种报纸等等。其中最特出的是都寅权。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("도|군","都|君")은 #ruby("본|시","本|是") #ruby("용|강","龍|岡") 사람으로, #ruby("노|백|린","盧|伯|麟")·#ruby("김|희|선","金|羲|善")·#ruby("이|갑","李|甲") #ruby("등","等") 여러 #ruby("장|교","將|領")에게 #ruby[군사학][武學]을 배워 일찍이 #ruby("정|교","正|校")의 #ruby("군|직","軍|職")을 가졌다가, #ruby("왜","倭")놈에게 #ruby("군|대","軍|隊")가 #ruby("해|산","解|散")된 #ruby("후","後")에 #ruby("향|리","鄕|里")에 #ruby("거|주","居|住")하다 #ruby("양|산|학|교","楊|山|學|校") #ruby("교|사","敎|師")로 #ruby("초|빙","招|聘")받아 #ruby("근|무","勤|務")하였다. 사람됨이 #ruby("민|활","敏|活")하고 뜻이 굳건했다. 10#ruby("년","年") #ruby("역","役")을 받고 #ruby("복|역","服|役")하던 #ruby("중","中") #ruby("예|수|교","耶|蘇|敎")를 #ruby("독|실","篤|實")히 믿었다. #ruby("왜","倭")놈의 이른바 #ruby("교|회|사","敎|誨|師")#footnote(numbering: _ => [108)])[#h(0.35em)#ruby("교|회|사","敎|誨|師") 또는 #ruby("교|화|사","敎|化|師")는 #ruby("형|무|소","刑|務|所")#ruby("내","內") #ruby("수|감|자","收|監|者")를 #ruby("반|성","反|省")·#ruby("교|화","敎|化")시키는 것을 #ruby("업|무","業|務")로 하는 #ruby("공|무|원","公|務|員")이다.]가 #ruby("일|요|일","日|曜|日")에 #ruby("불|상","佛|像") 앞에서 #ruby("각","各") #ruby("수|인","囚|人")으로 하여금 머리를 숙여 #ruby("예|불","禮|佛")하도록 #ruby("명","命")하면 #ruby("수|인","囚|人")들은 #ruby("심|중","心|中")으로는 #ruby("천|황","天|皇") #ruby("급|살","急|煞")을 #ruby("기|원","祈|願")하면서도 #ruby("표|면","表|面")으로는 머리를 숙였지만, 한 #ruby("호|령","號|令")에 #ruby("수|백","數|百") #ruby("명","名")이 머리를 숙이는 #ruby("중","中")에도 #ruby("도|인|권","都|仁|權") 한 사람만은 머리를 까딱 아니하고 앉았다.]
#zh[都君本是龙冈人，跟卢伯麟、金羲善、李甲等将领学武学，早有正校的军职。军队被倭寇解散之后住在乡里，受聘为杨山学校教师。为人敏活，意志坚定。受了十年役，服役中笃信耶稣教。倭寇所谓教诲师，星期日命令各囚人在佛像前低头礼佛，囚人心里祈愿天皇急死，表面上却低头。一声号令、几百人低头之中，只有都寅权一个人头也不点，坐着。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("간|수","看|守")가 #ruby("질|문","質|問")하니 #ruby("도|군","都|君")은 #ruby("자|기","自|己")는 #ruby("예|수|교|도","耶|蘇|敎|徒")이므로 #ruby("우|상","偶|像")에 절하지 않는다 했다. #ruby("왜","倭")놈들이 #ruby("분","憤")이 나서 #ruby("도|군","都|君")의 머리를 타서 억누르거니 #ruby("도|군","都|君")은 눌리지 않으려거니 #ruby("대|소|동","大|騷|動")이 일어났다.]
#zh[看守一问，都君说自己是耶稣教徒，不对偶像下拜。倭寇发了怒，按他的头往下压，都君不肯被压，大骚动起来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("일|본|법","日|本|法")에도 #ruby("신|앙","信|仰") #ruby("자|유","自|由")가 있고, #ruby("감|옥","監|獄") #ruby("법","法")에도 #ruby("수|인","囚|人")들이 #ruby("불|교","佛|敎")만 #ruby("신|앙","信|仰")하라는 #ruby("조|문","條|文")이 없는데, 어디 #ruby("근|거","根|據")하여 이같이 #ruby("무|리","無|理")한가? #ruby("일|본","日|本")의 눈에는 #ruby("도|인|권","都|仁|權")이가 #ruby("죄|인","罪|人")이라 하나, #ruby("신","神")의 눈에는 #ruby("일|본|인","日|本|人")이 #ruby("죄|인","罪|人") 될지도 알 수 없다.”]
#zh[“日本法也有信仰自由，监狱法也没有条文叫囚人只信仰佛教，凭什么这样无理？日本眼里都寅权是罪人，神的眼里，日本人是不是罪人还不知道。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이로 #ruby("인","因")해 큰 #ruby("시|비","是|非")가 생겨, #ruby("급|기|야","及|其|也")는 #ruby("교|화","敎|化") #ruby("시|간","時|間")에 #ruby("불|상","佛|像")에 절하는 것 한 가지 일은 #ruby("수|인","囚|人") #ruby("자|유","自|由")에 맡긴다는 #ruby("전|옥","典|獄")의 #ruby("교|시","敎|示")가 있었다. 이것뿐 아니다. #ruby("전|옥","典|獄")이 #ruby("도|인|권","都|仁|權")에게 #ruby("상|표","賞|表")와 #ruby("상|장","賞|狀")을 주었으되, #ruby("도|군","都|君")는 #ruby("절|대","絶|對") #ruby("사|절","謝|絶")하고 물리쳤다.]
#zh[因此起了大是非，终于教化时间对佛像下拜这一件事，由典狱教示，交给囚人自由。不止这个。典狱把赏表和赏状给都寅权，都君绝对谢绝，推开了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("수|인","囚|人")의 #ruby("상|표","賞|表")는 #ruby("개|전","改|悛")하는 #ruby("상|황","狀|況")이 있는 #ruby("자","者")에게 주는 것인데, 나는 #ruby("당|초","當|初")에 #ruby("죄","罪")가 없었고, #ruby("수|인","囚|人")이 된 것은 #ruby("일|본","日|本") #ruby("세|력","勢|力")이 나보다 #ruby("우|세","優|勢")한 것뿐이거늘, #ruby("상","賞")이 무슨 #ruby("관|련","關|聯")이 있는가?”]
#zh[“囚人的赏表，是给有改悛状况的人的。我当初没有罪，成了囚人，只是日本势力比我优势而已，赏有什么关联？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 하며 끝내 #ruby("거|절","拒|絶")하였고, #ruby("그|후","其|後")에 #ruby("소|위","所|謂") #ruby("가|출|옥","假|出|獄")을 시키는데도,]
#zh[这样说着，终于拒绝了。后来要给他所谓假出狱，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내 #ruby("죄","罪")가 없는 것을 #ruby("지|금","只|今")에야 깨달았거든 #ruby("판|결","判|決")을 #ruby("취|소","取|消")하고 아주 풀어줄 것이지, #ruby("가|출|옥","假|出|獄")이란 #ruby("가","假")#ruby("자","字")가 #ruby("정|신","精|神")에 #ruby("상|쾌","爽|快")치 못하니 #ruby("기|한","期|限")까지 있다 나간다.”]
#zh[“既然现在才明白我没有罪，就取消判决，干脆放了。假出狱这个‘假’字，精神上不痛快，我要待到期满再出去。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하니, #ruby("왜","倭")놈도 어찌하지 못하고 #ruby("기|한","期|限")을 채워서 #ruby("방|면","放|免")하였다.]
#zh[这样说，倭寇也无可奈何，满了期限才放免。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("도|인|권","都|仁|權")의 #ruby("행|동","行|動")은 #ruby("강|도","强|盜")로서는 #ruby("능","能")히 가지지 못할 것이다. “#ruby("만|산|고|목|일|엽|청","滿|山|枯|木|一|葉|靑")”#footnote(numbering: _ => [109)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “온 #ruby("산","山")의 마른나무 가운데 잎사귀 하나만 푸르다”.]는 #ruby("기|개","氣|槪")를 누가 #ruby("흠|모","欽|慕")하고 #ruby("감|탄","感|嘆")하지 않으리오. #ruby("불|서","佛|書")의 “#ruby("외|외|낙|락|적|나|라","嵬|嵬|落|落|赤|裸|裸") #ruby("독|보|건|곤|수|반|아","獨|步|乾|坤|誰|伴|我")”#footnote(numbering: _ => [110)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “홀로 우뚝 솟아 넓은 #ruby("도|량","度|量")을 펼치고, #ruby("천|하","天|下")를 걸어감에 누가 나를 따르랴”.]는 #ruby("구|절","句|節")을 #ruby("도|군","都|君")을 #ruby("위","爲")해 #ruby("암|송","暗|誦")하였다.]
#zh[都寅权的行动，做强盗的也不能有。“满山枯木一叶青”的气概，谁不钦慕、感叹？]
#zh[为了都君我一再吟咏着佛家的句子：]
#zh[“嵬嵬落落赤裸裸，独步乾坤谁伴我。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|료","同|僚") #ruby("수|인","囚|人") #ruby("중","中")에 #ruby("이|종|근","李|種|根")이란 나이 20#ruby("세","歲") #ruby("청|년","靑|年")이 있으니, #ruby("의|병|장","義|兵|將") #ruby("이|진|룡","李|鎭|龍")의 #ruby("일|가","一|家") #ruby("동|생","同|生")이었다. 어릴 적부터 #ruby("일|어","日|語")를 잘하여 #ruby("러|일|전|쟁","俄|日|戰|爭") 때 #ruby("왜|장","倭|將") #ruby("아카시","明石")의 #ruby("통|역","通|譯")이 되었다가 #ruby("헌|병|보|조|원","憲|兵|補|助|員")이 되었다. #ruby("이|진|룡","李|鎭|龍")이 #ruby("의|병","義|兵")을 일으키던 처음에 #ruby("종|근","種|根")을 불러와서 #ruby("사|형","死|刑")을 #ruby("집|행","執|行")하고자 했는데, #ruby("종|근","種|根")이 #ruby("이|의|사","李|義|士")를 #ruby("향","向")해,]
#zh[囚犯中有一个名叫李钟根的二十岁青年，他是义兵将领李震龙的族弟，自幼就会日语，日俄战争时当了倭寇将领明石的翻译，此后又当了宪兵补助员。李震龙起义之初，要将钟根处死。钟根向李义士求饶说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아우가 나이 어려 #ruby("대|의","大|義")를 #ruby("몰|각","沒|覺")하고 #ruby("왜","倭")의 졸개가 되었으나, #ruby("지|금","只|今")이라도 #ruby("형","兄")님을 따라 #ruby("의|병","義|兵")이 되어 #ruby("왜|병","倭|兵")을 #ruby("섬|멸","殲|滅")하고 #ruby("장|차","將|次") #ruby("공","功")을 세워 그#ruby("간","間")의 #ruby("죄","罪")를 씻는 것이 어떠하겠습니까?”]
#zh[“族弟年少，不明大义，当了日寇的走卒，现在愿随哥哥一起举义，消灭倭寇，将功赎罪，望哥哥饶恕小弟。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하니 #ruby("이|의|사","李|義|士")가 #ruby("쾌","快")히 #ruby("허|락","許|諾")하였다. #ruby("종|근","種|根")은 곧 #ruby("보|조|원","補|助|員")의 #ruby("총|기","銃|器")를 그대로 메고 #ruby("이|의|사","李|義|士")가 #ruby("실|패","失|敗")하기까지 #ruby("종|군","從|軍")하다가, #ruby("왜","倭")에게 #ruby("생|포","生|捕")되어 #ruby("사|형","死|刑")을 받게 되었는데, #ruby("이|전","以|前")에 #ruby("신|임","信|任")받던 #ruby("아카시","明石")에게 #ruby("면|회","面|會")를 #ruby("청","請")하여 #ruby("용|서","容|恕")를 #ruby("구","求")한 #ruby("결|과","結|果") 5#ruby("년","年") #ruby("역","役")을 받았다.]
#zh[李义士随即撤销了死刑命令。钟根从此拿着宪兵补助员的枪支，当了义兵。李义士战败，钟根被日寇生俘，判了死刑，钟根请求面见明石，于是看在过去的情分，减为五年有期徒刑。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|종|근","李|種|根")은 #ruby("왜","倭")#ruby("간|수","看|守")에게 #ruby("청","請")하여, #ruby("자|기","自|己")가 #ruby("일|자|무|식","目|不|識|丁")이니 56#ruby("호","號")와 같은 #ruby("방","房")에서 자고 같은 #ruby("공|장","工|場")에서 #ruby("복|역","服|役")하게 해주면 #ruby("문|자","文|字")를 배우겠다고 하여 #ruby("허|가","許|可")를 얻었다. 2#ruby("년","年") 동안이나 #ruby("문|자","文|字")를 가르치노라니 나도 #ruby("종|근","種|根")의 #ruby("애|호","愛|護")를 많이 받았다. 그러다가 #ruby("종|근","種|根")은 #ruby("가|출|옥","假|出|獄")으로 나가게 되었다. #ruby("그|후","其|後") 집에서 보낸 #ruby("서|신","書|信")을 보니, #ruby("종|근","種|根")이가 아내를 거느리고 #ruby("안|악","安|岳")까지 가서 어머님을 뵈었다는 말이 있었다.]
#zh[入狱后，钟根向看守提出要求，说自己目不识丁，愿和五十六号住一室，同在一个工场干活，顺便也可以学习认字，他的要求获得了批准。此后两年间，我教他识字，他也给了我很多照顾，后来他被假释出狱。我从家信里得知他出狱后还带着妻子去安岳探望了我的母亲。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("출|역","出|役")#ruby("중","中")이던 어느날 #ruby("졸|지","猝|地")에 #ruby("역|사","役|事")를 #ruby("중|지","中|止")하고 #ruby("수|인","囚|人")을 한 곳에 #ruby("회|집","會|集")케 하더니, #ruby("메이지","明治")의 #ruby("사|망","死|亡")을 #ruby("선|언","宣|言")한 뒤 이른바 #ruby("대|사|면","大|赦|免")을 #ruby("반|포","頒|布")하였다. 먼저 #ruby("보|안","保|安") 2#ruby("년","年")은 #ruby("면|형","免|刑")이 되니, #ruby("보|안|율","保|安|律")로만 #ruby("감|옥","監|獄") 살던 #ruby("동|지","同|志")들은 그날로 #ruby("출|옥","出|獄")하였다. #ruby("강|도|율","强|盜|律")에는, #ruby("명|근","明|根") #ruby("형","兄")에게는 #ruby("감|형","減|刑")도 되지 않았으나, 15#ruby("년","年") #ruby("역","役")에는 나 혼자만 8#ruby("년","年")을 #ruby("감","減")해 7#ruby("년","年")으로 되고, #ruby("김|홍|량","金|鴻|亮") #ruby("이|외","以|外") 몇 사람은 #ruby("대|부|분","大|部|分") 7#ruby("년","年")을 #ruby("감","減")해 8#ruby("년","年")으로 되고, 10#ruby("년","年"), 7#ruby("년","年"), 5#ruby("년","年")들도 #ruby("차|례","次|例")로 #ruby("감|형","減|刑")되었다.]
#zh[有一天正在做工时，忽然命令终止工作，把囚犯们集合在一起，宣布明治死了，因此下了大赦令，违反保安法被判二年的，当天就可出狱。犯于强盗罪的，明根兄未被减刑；被判十五年的，只有我一人被减刑八年，还剩下七年；金鸿亮等均被减至八年；被判十年、七年、五年的也按比例减刑。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("불|과","不|過") 몇 달 뒤에 #ruby("메이지","明治")의 #ruby("처","妻")가 또한 #ruby("사|망","死|亡")해서 #ruby("잔|기","殘|期")의 3#ruby("분","分")의 1을 #ruby("감","減")하니, 5#ruby("년|여","年|餘")의 가벼운 #ruby("형","刑")이 되었다. 그때는 #ruby("명|근","明|根") #ruby("형","兄")도 #ruby("종|신|형","終|身|刑")에서 20#ruby("년","年")으로 #ruby("감","減")하였으나, #ruby("명|근","明|根") #ruby("형","兄")은 #ruby("형","刑")을 더하여 죽여줄지언정 #ruby("감|형","減|刑")은 받지 않겠다고 하였다. 그러나 #ruby("왜","倭")놈 말은 “#ruby("죄|수","罪|囚")에게 #ruby("일|체","一|體")를 #ruby("강|제","强|制")로 #ruby("집|행","執|行")하는 것이니 #ruby("감|형","減|刑")을 받고 안 받음도 #ruby("수|인","囚|人")의 #ruby("자|유","自|由")에 있지 않다”고 했다. 그때 #ruby("공|덕|리","孔|德|里")에 #ruby("경|성|감|옥","京|城|監|獄")#footnote(numbering: _ => [111)])[#h(0.35em)#ruby("현|재","現|在") #ruby("마|포|구","麻|浦|區") #ruby("아|현|동","阿|峴|洞") 서울#ruby("지|검","地|檢") #ruby("서|부|지|청","西|部|支|廳"), 서울#ruby("지|법","地|法") #ruby("서|부|지|원","西|部|支|院") 자리이다.]을 #ruby("준|공","竣|工")한 #ruby("후","後")이므로, #ruby("명|근","明|根") #ruby("형","兄")은 그리로 #ruby("이|감","移|監")되어 얼굴만이라도 다시 보지 못했다.]
#zh[又过了几个月，明治的妻子也死了，因此又在剩下的刑期中减去三分之一，我的刑期只剩下五年左右的轻刑。此时被判终身监禁的安明根也减刑至二十年，他虽然抗拒着，宁愿加刑求死而不愿减刑，但是对囚犯一切都是强制执行，所以囚犯们连不减刑的自由都没有，终于改为二十年了。后来安明根移监到新建的孔德里京城监狱，因此我们再也没有谋面的机会。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("명|근","明|根") #ruby("형","兄")은 #ruby("전|후","前|後") 17#ruby("년","年") 동안을 #ruby("구|속","拘|束")되었다가 #ruby("연|전","年|前")에 풀려나 #ruby("신|천","信|川") #ruby("청|계|동","淸|溪|洞")에서 #ruby("부|인","夫|人")과 같이 1#ruby("년","年") 남짓 지내다가, #ruby("자|기","自|己") #ruby("부|친","父|親")과 #ruby("친|형|제","親|兄|弟")가 그리워 #ruby("가|족","家|族")을 이끌고 #ruby("중|국","中|國")·#ruby("러|시|아","俄|西|亞") #ruby[접경지대][中俄領]로 #ruby("이|주","移|住")하였다. 그런데 #ruby("원|체","元|體") #ruby("장|구","長|久")한 #ruby("세|월","歲|月") 동안 #ruby("가|혹","苛|酷")한 #ruby("고|생","苦|生")을 한 탓으로 몸에 #ruby("저|항|력","抵|抗|力")이 없어져 그다지 #ruby("심","甚")하지도 않은 #ruby("신|병","身|病")으로 #ruby("만|고|분|한","萬|古|憤|恨")을 품고 #ruby("중|국|령","中|國|領") #ruby("화|룡|현","和|龍|縣")에서 마침내 #ruby("불|귀","不|歸")의 #ruby("객","客")이 되었다.#footnote(numbering: _ => [112)])[#h(0.35em)#ruby("안|명|근","安|明|根")은 #ruby("감|옥","監|獄")에 10#ruby("년|간","年|間") #ruby("복|역","服|役")하였으며, 죽은 #ruby("장|소","場|所")는 #ruby("길|림|성","吉|林|省") #ruby("의|란|현","依|蘭|縣") #ruby("팔|호|리","八|湖|里")이다.]]
#zh[安明根前后在监狱里过了十七年之后，年前才获释放，在信川青溪洞与他的夫人安度劫后余生，过了一年多，由于怀念在中俄边境的父亲和兄弟，因而率家前往。由于长期受牢狱之苦，身体已没有抵抗力，一场并不很重的病，竟使他怀着千古遗恨，在中国和龙县与世长辞。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그럭저럭 내가 #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 지낸 것이 3#ruby("년","年")#ruby("여","餘")이고, 남은 #ruby("기|간","期|間")은 #ruby("불|과","不|過") 2#ruby("년","年")이었다. 이때부터는 마음에 #ruby("확|실","確|實")히 다시 #ruby("세|상","世|上")에 나가 #ruby("활|동","活|動")할 #ruby("신|념","信|念")이 생겼다. 그리하여 #ruby("주|야","晝|夜")로 #ruby("세|상","世|上")에 나가서는 무슨 #ruby("사|업","事|業")을 할까 생각하였다. 나는 #ruby("본|시","本|是") #ruby("왜","倭")놈이 이름지어준 ‘뭉우리돌’이다. ‘뭉우리돌’의 #ruby("대|우","待|遇")를 받은 #ruby("지|사","志|士") #ruby("중","中")에 #ruby("왜","倭")놈의 #ruby[가마솥][火釜]인 #ruby("감|옥","監|獄")에서 #ruby("인|간","人|間")으로 당하지 못할 #ruby("학|대","虐|待")와 #ruby("욕","辱")을 받고도, #ruby("세|상","世|上")에 나가서는 오히려 #ruby("왜","倭")놈에게 #ruby("순|종","順|從")하며 남은 목숨을 이어가는 #ruby("자","者")도 있으니, 그것은 ‘뭉우리돌’ #ruby("중","中")에도 #ruby("석|회|질","石|灰|質")을 #ruby("함|유","含|有")하였으므로 다시 #ruby("세|상","世|上")이라는 바다에 던져지면 #ruby("평|소","平|素") 굳은 #ruby("의|지","意|志")가 #ruby("석|회","石|灰")같이 풀리는 것과 같다.]
#zh[经过这样好几次的减刑，我在西大门监狱过了三年多，就剩下两年了。从此开始萌发再次到社会上去活动的希望，日夜思量出去之后首先要做些什么。我本来就是倭寇起名的“圆石头”。受过“圆石头”待遇的志士，在倭寇那口大锅似的监狱里受尽了人所不能忍受的虐待和侮辱，出去之后，有人反而对倭寇变得顺从了，苟且偷生地过日子。那是因为“圆石头”里头也含着石灰质，再被抛进人世这个海里，平素坚定的意志便像石灰一样化开了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러므로 나는 다시 #ruby("세|상","世|上")에 나가는 데 #ruby("대","對")하여 #ruby("우|려","憂|慮")가 적지 않았다. #ruby("만|일","萬|一") 나도 #ruby("석|회|질","石|灰|質")을 가진 뭉우리돌이면 #ruby("만|기","滿|期") #ruby("이|전","以|前")에 #ruby("성|결","聖|潔")한 #ruby("정|신","精|神")을 품은 채로 죽었으면 좋지 않을까 생각했다.]
#zh[因此我对再次出狱，忧虑实在不少。我想我要是也成了含着石灰质的圆石头，出去也变节，倒不如在期满之前怀着圣洁的精神死在狱中。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리하여 #ruby("결|심","決|心")의 #ruby("표|시","表|示")로 이름을 ‘#ruby("구","九")’라 하고, #ruby("호","號")를 ‘#ruby("백|범","白|凡")’이라 고쳐서 #ruby("동|지","同|志")들에게 #ruby("언|포","言|布")하였다. #ruby("구","龜")를 #ruby("구","九")로 고친 것은 #ruby("왜","倭")의 #ruby("민|적","民|籍")#footnote(numbering: _ => [113)])[#h(0.35em)#ruby("민|적","民|籍")은 #ruby("호|적","戶|籍"). #ruby("조|선|시|대","朝|鮮|時|代")의 #ruby("전|통|적","傳|統|的")인 #ruby("호|적|제|도","戶|籍|制|度")의 #ruby("불|완|전","不|完|全")을 #ruby("보|완","補|完")하기 #ruby("위","爲")해 #ruby("대|한|제|국","大|韓|帝|國")은 1909#ruby("년","年") 3#ruby("월","月") #ruby("근|대|적","近|代|的")인 #ruby("호|적|법","戶|籍|法")인 ‘#ruby("민|적|법","民|籍|法")’을 #ruby("시|행","施|行")하였고, 1923#ruby("년","年") #ruby("일|제","日|帝")가 그것을 「#ruby("조|선|호|적|령","朝|鮮|戶|籍|令")」으로 #ruby("대|체","代|替")하였다. #ruby("근|대","近|代") #ruby("호|적|제|도","戶|籍|制|度")의 #ruby("특|징","特|徵")으로는, 모든 사람의 #ruby("인|적|사|항","人|的|事|項")이 #ruby("민|적","民|籍")에 #ruby("등|재","登|載")되며, #ruby("개|명","改|名")은 10#ruby("일","日") #ruby("이|내","以|內") #ruby("신|고","申|告")하지 않으면 #ruby("처|벌","處|罰")받게 되어 있다.]에서 벗어나고자 함이요, #ruby("연|하","蓮|下")를 #ruby("백|범","白|凡")으로 고친 것은 #ruby("감|옥","監|獄")에서 여러 해 #ruby("연|구","硏|究")에 #ruby("의","依")해 우리나라 #ruby("하|등|사|회","下|等|社|會"), 곧 #ruby("백|정","白|丁") #ruby("범|부","凡|夫")들이라도 #ruby("애|국|심","愛|國|心")이 #ruby("현|재","現|在")의 나 #ruby("정|도","程|度")는 되어야 #ruby("완|전","完|全")한 #ruby("독|립|국|민","獨|立|國|民")이 되겠다는 바람 때문이었다.]
#zh[为表示我的决心，我决定把我登在日本户籍上的名字“金龟”改为“金九”，把我的号“莲下”改为“白凡”，并且通知了狱中的同志们。把“龟”改成“九”，是要脱离日本户籍；改称白凡，是表示我国最低贱的屠夫和无知的凡夫，希望他们最低限度都有和我一样的爱国心。这也正表明了我的心愿：我们同胞的爱国心及知识程度若不提高，就不能建立起一个完整的独立国家。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("복|역","服|役")#ruby("중","中")에 뜰을 쓸 때나 #ruby("유|리|창","琉|璃|窓")을 닦고 할 때는 하느님께 이렇게 #ruby("기|도","祈|禱")하였다. ‘우리도 어느 때 #ruby("독|립|정|부","獨|立|政|府")를 #ruby("건|설","建|設")하거든, 나는 그 집의 뜰도 쓸고, #ruby("창|호","窓|戶")도 닦는 일을 해보고 죽게 해 달라’고.]
#zh[每次在监狱里清扫庭院、擦着玻璃的时候，我都向上帝祈求：如果我们国家独立了，请让我给那政府扫扫地、擦擦窗子，然后死去。]
#heading(level: 3)[#text(font: "KOPUSGo B")[11) 다시 #ruby("인|천|감|옥","仁|川|監|獄")으로]]
#zh[再回仁川监狱]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("잔|기","殘|期")를 2#ruby("년","年")도 채 못 남기고 #ruby("서|대|문|감|옥","西|大|門|監|獄")을 떠나 #ruby("인|천","仁|川")으로 #ruby("이|감","移|監")하게 되었다. #ruby("원|인","原|因")은 내가 #ruby("제|2|과|장","第|二|課|長")인 #ruby("왜","倭")놈과 싸운 #ruby("사|실","事|實")이 있었는데, 그놈이 #ruby("비|교|적","比|較|的") #ruby("고|역","苦|役")이 #ruby("심","甚")한 #ruby("인|천","仁|川") #ruby("축|항","築|港")#ruby("공|사","工|事")를 시키는 곳으로 보낸 것이다.]
#zh[我剩下不到二年的刑期时，就转移到仁川监狱去了。我跟西大门监狱第二科的日本科长争吵过，他为了报复，就把我送到仁川去干筑港这个重活儿。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|대|문","西|大|門")에는 우리 #ruby("동|지","同|志")들이 #ruby("다|수","多|數") 있어서 #ruby("정|리|상","情|理|上") #ruby("위|로","慰|勞")도 되고, #ruby("노|역","勞|役") #ruby("중","中")에도 #ruby("편|의","便|宜")가 많은 터였다. #ruby("쾌|활","快|活")한 #ruby("생|활","生|活")을 하였다 할 수 있는 이곳을 떠나, #ruby("철|사","鐵|絲")로 허리를 묶여 30〜40#ruby("명","名") #ruby("적|의|군","赤|衣|軍")에 #ruby("편|입","編|入")되어 #ruby("인|천","仁|川") #ruby("옥|문","獄|門") 앞에 #ruby("당|도","當|到")하였다.]
#zh[我就此告别了许多同志，告别了可以称得上“愉快地”生活了三年的西大门监狱。腰间用铁丝捆着，编进三四十名穿红衣的囚犯里，被拉到了仁川狱门前。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[무|술|년][戊|戌|年]\(1898) 3#ruby("월","月") 9#ruby("일","日") 한밤#ruby("중","中")에 #ruby("옥","獄")을 깨뜨리고 #ruby("도|주","逃|走")한 이 몸이, 17#ruby("년","年") #ruby("후","後")에 #ruby("철|사","鐵|絲")에 묶여서 다시 이곳에 올 줄 누가 알았으랴. #ruby("옥|문","獄|門") 안에 들어서며 살펴보니 새로이 #ruby("감|방","監|房")을 #ruby("증|축","增|築")하였으나, 옛날에 내가 글 읽던 #ruby("방","房")과 #ruby("산|보","散|步")하던 뜰은 그대로 있었다. 호랑이같이 #ruby("와타나베","渡邊") 놈을 #ruby("통|렬","痛|烈")히 #ruby("규|탄","糾|彈")하던 #ruby("경|무|청","警|務|廳")은 #ruby("매|춘|녀","賣|淫|女")의 #ruby("검|사|소","檢|査|所")로, #ruby("감|리|사","監|理|使")가 #ruby("집|무","執|務")하던 #ruby("내|원|당","來|遠|堂")은 #ruby("감|옥","監|獄") #ruby[창고][汁物庫]가 되었고, 옛날 #ruby("순|검","巡|檢")·#ruby("주|사","主|事")들이 들끓던 곳은 #ruby("왜","倭")놈의 #ruby("세|상","世|上")으로 #ruby("변","變")해 버렸다.]
#zh[谁会料想得到，戊戌年三月初九日半夜里破狱逃走的我，十七年之后又被铁丝捆着回到这个监牢里来。进门后环顾四周，牢房新添了不少，但我曾经在里面读书的牢房仍保存在那儿，曾经散步过的庭院也没有多大改变。我曾像老虎似地大声责骂渡边那家伙的警务厅，现在成了妓女检查所；监理使办公的来远堂，变成了堆放监狱杂物的仓库；以前巡检、主事喧闹的场所，现在是倭寇的天下了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[마치 사람이 죽었다가 몇십 #ruby("년","年") #ruby("후","後")에 다시 살아나서, #ruby("자|기","自|己")가 놀던 #ruby("고|향","故|鄕")에 와서 보는 듯하다. #ruby("감|옥","監|獄") 뒷담 너머 #ruby("용|동","龍|洞") 마루턱에서 #ruby("옥|중","獄|中")에 갇힌 #ruby("불|효","不|孝") #ruby("자|식","子|息")인 나를 보시느라고 날마다 우두커니 서서 내려다보시던 #ruby("선|친","先|親")의 얼굴이 보이는 것 같다. 그러나 #ruby("세|상","世|上")이 바뀌고 #ruby("시|대","時|代")가 변한 탓으로 #ruby("지|금","只|今")의 #ruby("김|구","金|龜")를 옛날 #ruby("김|창|수","金|昌|洙")로 알 #ruby("자","者")는 없을 것이라고 생각했다.]
#zh[这就好像死去了几十年的人再复活，重又回到故乡一样。我好像又看见了先父的慈颜，他站在监狱后墙外龙洞山坡上，天天呆立着向下眺望，只为看一眼被关在牢房里的不孝儿子。然而世事变迁，相信不会有人说今天的金九就是过去的金昌洙了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|방","監|房")에 들어가서 보니 #ruby("서|대|문","西|大|門")에서 먼저 #ruby("이|감","移|監")된 낯이 익은 사람도 더러 있었다. 그런데 한 사람이 곁에 썩 다가앉으며 나를 보고서 아는 체를 한다.]
#zh[我进入牢房，看到有几个先从西大门监狱转移过来的面熟的人。有一个人坐近我的身旁，望着我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그분 낯이 매우 익은데……, 당신 #ruby("김|창|수","金|昌|洙") 아니오?”]
#zh[“这位非常面善，你不会是金昌洙吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[정말 #ruby("청|천|벽|력","靑|天|霹|靂")이라. 놀라서 #ruby("자|세","仔|細")히 보니, 17#ruby("년","年") #ruby("전","前")에 #ruby("절|도","竊|盜") 10#ruby("년","年") #ruby("역","役")을 지고, 같이 #ruby("감|방","監|房")살이하던 #ruby("문|종|칠","文|種|七")이었다. 나이는 늙었을망정 젊어서의 얼굴은 그대로 알겠으나, #ruby("전","前")에 없던 #ruby("이|마","天|頂")에 쑥 패인 구멍이 있다. 나는 짐짓 머뭇거렸다.]
#zh[犹如晴天霹雳一般，使我大吃一惊。仔细一看，原来是十七年前与我同监房的文种七，他因盗窃被判了十年。年纪虽老，年轻时的面貌还认得，不同的是额前多了一个从前没有的深坑。我故意迟疑着。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("자","者")는 내 얼굴을 자세히 보면서 말했다.]
#zh[他仔细端详着我的脸，说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("창|수","昌|洙") #ruby("김","金")#ruby("서|방","書|房"), #ruby("지|금","只|今") 내 얼굴에 구멍이 없다고 보면 아실 것 아니오! 나는 당신이 #ruby("탈|옥","脫|獄")한 #ruby("후","後")에 죽도록 매를 맞은 #ruby("문|종|칠","文|種|七")이오.”]
#zh[“昌洙金书房！你只当我脸上现在没有这个洞，就该认得了吧！我就是你逃走以后被打得半死的文种七啊！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그만하면 알겠구려.”]
#zh[“你这一说，我就知道了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 밉기도 하고 무섭기도 하였지만 반갑게 #ruby("인|사","人|事")를 하였다.]
#zh[我不能硬说不认识。对他实在又讨厌又害怕，还是连忙跟他打了招呼。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("문|종|칠","文|種|七")이 물었다.]
#zh[姓文的又问我：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("당|시","當|時") #ruby("항|구","港|口")를 #ruby("진|동","震|動")시키던 #ruby("충|신","忠|臣")이 #ruby("지|금","只|今")은 무슨 #ruby("사|건","事|件")으로 들어왔소?”]
#zh[“当时轰动仁川港口的忠臣，现在又因何罪坐牢呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“15#ruby("년","年") #ruby("강|도","强|盜")요。”]
#zh[“十五年强盗罪。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("문","文")은 입을 삐쭉거리며 말했다.]
#zh[姓文的撇着嘴挖苦说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("충|신","忠|臣")과 #ruby("강|도","强|盜")는 #ruby("거|리","距|離")가 매우 먼데요. 그때 #ruby("창|수","昌|洙")가 우리 같은 #ruby("도|적","盜|賊")놈들과 #ruby("동|거","同|居")하게 한다고 #ruby("경|무|관","警|務|官")까지 #ruby("규|탄","糾|彈")을 하던 것으로 보아서 #ruby("강|도","强|盜") 15#ruby("년","年") 맛이 꽤 무던하겠구려.”]
#zh[“忠臣与强盗的距离是多么远啊。那时因为让你跟我们这些盗贼住在一起，你连警务官都痛骂过，现在判了强盗十五年，看来倒还满不在乎呢。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("문","文")의 말을 탓하기는 #ruby("고|사","姑|捨")하고 도리어 빌붙었다.]
#zh[我心里虽很生气，但并未责备他，反而用恭维的口吻凑上去说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보, #ruby("충|신","忠|臣") 노릇도 사람이 하고, #ruby("강|도","强|盜")도 사람이 하는 것 아니오? 한때는 그렇게 놀고 한때는 이렇게 노는 게지요. #ruby("대|관|절","大|關|節") #ruby("문|서|방","文|書|房")은 어찌하여 다시 #ruby("고|생","苦|生")을 하시오?”]
#zh[“嘿，当忠臣是人，当强盗不也是人吗？此一时也，彼一时也。大关节的文书房，到底为了什么又来这里受苦呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 이번까지 #ruby("감|옥","監|獄") #ruby("출|입","出|入")이 일곱 #ruby("차|례","次|例")이니, #ruby("일|생","一|生")을 #ruby("감|옥","監|獄")에서 보내게 됩니다.”]
#zh[“我呀，到现在已是第七次入狱了，这一生都要在监狱里过了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("징|역","懲|役")은 얼마요?”]
#zh[“刑期是多久呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("강|도","强|盜") 7#ruby("년","年")에서 5#ruby("년","年")이 되어, 한 #ruby("반","半") #ruby("년","年") #ruby("후","後")엔 다시 나가 다녀오겠소.”]
#zh[“强盗罪判了七年，减成五年，再过半年又可以出去闯一闯再回来。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보, 끔찍한 말씀도 하시오.”]
#zh[“你说得太吓人了吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("자|본","資|本") 없는 장사는 거지와 #ruby("도|적","盜|賊")이지요. 더욱이 #ruby("도|적","盜|賊")질에 입맛을 붙이면 #ruby("별","別") 수가 없습니다. 당신도 여기서는 #ruby("별","別") 꿈을 다 꾸지만 #ruby("사|회","社|會")에 나가만 보시오. #ruby("도|적","盜|賊")질하다가 #ruby("징|역","懲|役") 산 놈이라고 누가 받자를 하오? #ruby("자|연","自|然") #ruby("농","農")·#ruby("공","工")·#ruby("상","商")에 #ruby("접|촉","接|觸")을 못하지요. 개 눈에는 똥만 보인다는 말과 같이 #ruby("도|적","盜|賊")질 해본 놈은 거기만 눈치가 뚫려서 다른 길은 밤#ruby("중","中")이구려.”]
#zh[“乞丐跟盗贼做的是没本钱的生意！尤其是做贼做上了瘾，就没有别的办法了。你也别在这里净做梦，到社会上去看看吧，谁肯收留做过强盗又坐过牢的人呢？自然没法接触农、工、商任何一行。就像狗眼里看到的全是粪一样，做过贼的人眼里只开了这条路，别的路都是黑夜里。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그같이 여러 #ruby("번","番")이라면 #ruby("감|형","減|刑")이 어찌 되었소?”]
#zh[“你是屡犯，怎么还会减刑呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("번|번","番|番")이 #ruby("초|범","初|犯")이지요. 지나온 대로 #ruby("진|술","陳|述")하다가는 바깥바람도 못 쐬게요?”]
#zh[“每次都说是初犯啊！如果把过去的一切都照实供出来，连外面的风也吹不着了。”]
#figure-block("/images/p265.jpg", caption: [#ruby("백|범","白|凡")이 #ruby("인|천|감|옥","仁|川|監|獄") #ruby("수|감","收|監") #ruby("당|시","當|時") #ruby("출|역","出|役")나갔던 #ruby("인|천|항","仁|川|港") #ruby("축|항|공|사|장","築|港|工|事|場")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("서|대|문|감|옥","西|大|門|監|獄")에서, #ruby("평|소","平|素") 같은 무리로 #ruby("도|적","盜|賊")질을 하다가 #ruby("자|기","自|己")는 #ruby("중|형","重|刑")을 지고 #ruby("복|역","服|役")#ruby("중","中")인데, 같은 무리가 가벼운 #ruby("횡|령|죄","橫|領|罪")를 지고 들어와 서로 만나, #ruby("중|형|자","重|刑|者")가 #ruby("경|형|자","輕|刑|者")인 #ruby("동|료","同|僚")를 #ruby("고|발","告|發")하여 #ruby("종|신|역","終|身|役")을 받게 하고, #ruby("자|기","自|己")는 그 #ruby("공|로","功|勞")로 #ruby("형","刑")을 #ruby("감","減")하고 #ruby("후","厚")한 #ruby("대|우","待|遇")를 받아서 #ruby("동|료","同|僚") #ruby("수|인","囚|人")들에게 #ruby("질|시","嫉|視")받는 사람을 보았다. #ruby("만|일","萬|一") #ruby("문|가","文|哥")를 덧뜨려 놓으면 #ruby("감|옥","監|獄")에 #ruby("대","對")해 눈치가 훤한 #ruby("자","者")로 #ruby("괴|악","怪|惡")한 #ruby("행|동","行|動")을 할지 알 수 없었다. 나의 #ruby("신|문","訊|問") #ruby("기|록","記|錄")에 3#ruby("개|월","個|月") #ruby("징|역","懲|役") 진 #ruby("사|실","事|實")이 없는데도 17#ruby("년","年")이나 지워주는 #ruby("왜","倭")놈들인데, 저의 #ruby("군|관","軍|官")을 죽이고 #ruby("탈|옥","脫|獄")한 #ruby("사|실","事|實")이 #ruby("발|각","發|覺")되는 날이면 아주 마지막이다. #ruby("체|포","逮|捕")된 #ruby("직|후","直|後") #ruby("사|실","事|實")이 #ruby("발|각","發|覺")되었다면 죽든지 살든지 #ruby("상|쾌","爽|快")하게 지내버렸을 텐데, #ruby("만|기","滿|期")가 1#ruby("년","年") 남짓에, 이제껏 당하지 못할 #ruby("욕","辱"), #ruby("감|당","堪|當")하기 어려운 #ruby("학|대","虐|待")를 다 지내고 나서 #ruby("세|상","世|上")에 나갈 #ruby("희|망","希|望")을 가진 오늘날, #ruby("문|가","文|哥")가 먼저 #ruby("발|설","發|說")만 하면 내 #ruby("일|신","一|身")은 #ruby("고|사","姑|捨")하고 늙은 어머님, 어린 #ruby("처|자","妻|子")의 #ruby("정|경","情|景")이 어떠할까?]
#zh[我在西大门监狱时曾看到过，平日同伙做贼，自己被处了重刑，正在服刑，同伙后来因横领轻罪进来，重刑的便告发轻刑的同僚，让他改判无期徒刑，自己却因这功劳减了刑，受到优待，因此其他囚犯都看他不起。想到这里，千万不能得罪文哥，否则他是深知监狱门道的人，不知会做出什么怪事来。我的审讯记录里并没有判过三个月徒刑的事实，倭寇却能给我抹上十七年；若是杀死他们军官、越狱的事一旦发觉，那就完了。若是被捕当时就发觉，死也好活也好，倒可以痛快了结。如今满期只剩一年有余，不堪的侮辱、难当的虐待都受过了，正盼着出狱，文哥若先说出去，且不说我自己，老母和年幼的妻子又将如何？]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("문|가","文|哥")에게 #ruby("친|절","親|切") 또 #ruby("친|절","親|切")하게 #ruby("대|우","待|遇")하였다. 집에서 부쳐주는 #ruby("사|식","私|食")도 틈을 타서 #ruby("문|가","文|哥")를 주어 먹게 하고, #ruby("감|옥|식","監|獄|食")이라도 그 #ruby("자","者")가 곁에만 오면 나는 굶으면서도 #ruby("문|가","文|哥")를 주어 먹였다. 그러다 #ruby("문|가","文|哥")가 먼저 #ruby("만|기","滿|期") #ruby("출|옥","出|獄")하니, 내가 #ruby("출|옥","出|獄")하는 것 못지않게 시원하였다.]
#zh[因此我对待文哥是亲切又亲切。家里送来的饭食，一有机会就分给他吃；监狱里给的饭，如果他在我旁边，我就忍着饿全部给他吃。等到文哥的刑满出狱时，我高兴得差不多等于自己也出狱了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아침저녁 쇠사슬로 허리를 마주 매고 #ruby("축|항","築|港")#ruby("공|사|장","工|事|場")으로 #ruby("출|역","出|役")을 간다. 흙지게를 등에 지고 10#ruby("여","餘") #ruby("장","丈")의 높은 사다리를 밟고 오르내린다. 여기서 #ruby("서|대|문|감|옥","西|大|門|監|獄")#ruby("생|활","生|活")을 #ruby("회|고","回|顧")하면 #ruby("속|담","俗|談")에 ‘누워서 팥떡 먹기’라, #ruby("불|과","不|過") #ruby("반","半")나절에 어깨가 붓고, 등#ruby("창","瘡")이 나고, 발이 부어서, #ruby("운|신","運|身")을 못하게 되었다. 그러나 어찌할 #ruby("도|리","道|理")가 없었다. 무거운 짐을 지고 사다리로 올라갈 때, 여러 #ruby("번","番") 떨어져 죽을 #ruby("결|심","決|心")을 하였다. 그러나 같이 쇠사슬을 마주 맨 #ruby("자","者")는 #ruby("인|천|항","仁|川|港")에서 남의 구두 켤레나 담뱃갑을 #ruby("도|적","盜|賊")한 #ruby("죄","罪")로 두세 달 #ruby("징|역","懲|役") 사는 가벼운 #ruby("수|인","囚|人")이었다. 그 #ruby("자","者")까지 내가 죽이는 것은 #ruby("도|리","道|理")가 아니다. 생각다 못해 #ruby("노|역","勞|役")에 잔꾀를 부리지 않고 죽을힘을 다하였다. 여러 달 #ruby("후","後") #ruby("소|위","所|謂") #ruby("상|표","賞|表")를 주었다. #ruby("도|인|권","都|仁|權")같이 #ruby("거|절","拒|絶")할 #ruby("용|기","勇|氣")도 없고, 도리어 #ruby("다|행","多|幸")으로 생각되었다.]
#zh[我每天早上跟一位囚犯锁在一起，腰间互相用铁链锁着到筑港工地去干活，背上土箕，踩着十余丈高的梯子上上下下，人都快累死了。回想西大门监狱的生活，比起这里真是俗话说的躺着吃豆沙糕。这里做不到半天，肩膀肿了，背上生疮，双脚无力，全身动弹不得，但是仍不能不做。我好几次想背着土箕从梯子上跳下去，但是跟我绑在一起的人只不过是在仁川港偷了别人一双鞋或一盒烟、被判两三个月而已，我不能连累他，所以我就放弃了自杀的念头，只有拼死命地干活。这样干了几个月，给了我所谓的奖状。我没像都寅权那样拒绝，反而觉得很幸运。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄")#ruby("문","門") 밖으로 #ruby("축|항","築|港")#ruby("공|사|장","工|事|場")에 #ruby("출|입","出|入")할 때 왼#ruby("편","便") 첫 집이 #ruby("박|영|문","朴|永|文")의 #ruby("물|상|객|주","物|商|客|主") 집이다. 17#ruby("년","年") #ruby("전","前")에 #ruby("부|모","父|母") #ruby("양|위","兩|位")께서 그 집에 계실 때, #ruby("박|씨","朴|氏")가 #ruby("후|덕","厚|德")한 사람인데다 나를 사랑하여 #ruby("물|심|양|면","物|心|兩|面")으로 도와주고, 아버님과 #ruby("동|갑","同|甲")이시므로 #ruby("친|밀","親|密")히 지냈는데, 그 #ruby("노|인","老|人")이 #ruby("문|전","門|前")에서 우리가 들어가고 나오는 것을 보고 있다. 나는 내 #ruby("은|인","恩|人")이요, 아울러 아버님과 #ruby[동갑][父執尊丈]이신 #ruby("노|인","老|人")에게 곧 가서 절하고 “나는 #ruby("김|창|수","金|昌|洙")입니다” 하고 싶다. 그렇게 하면 그분이 오죽 반겨할까?]
#zh[每天到筑港工地去，牢门出来左边第一家就是朴永文的物商客栈。十七年前父母两位住在他家，朴氏为人厚道，又爱我，从物质和精神两方面都帮助过我，他与先父同庚，所以往来很密。我们经过他家门口时，朴老先生总是站在门前目不转睛地望着我们。他是我的恩人，又是和父亲同庚的尊长，我真想立刻过去行礼，说“我就是金昌洙”，他该多么高兴。虽然如此之近，在目前情况下我不能向他问安，真是难过。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[왼쪽 맞은#ruby("편","便") 집도 #ruby("역|시","亦|是") #ruby("물|상|객|주","物|商|客|主")인 #ruby("안|호|연","安|浩|然")의 집인데, #ruby("안|씨","安|氏") #ruby("역|시","亦|是") 나와 #ruby("부|모","父|母")님께 #ruby("극|진","極|盡")한 #ruby("정|성","精|誠")을 다하던 #ruby("노|인","老|人")으로, 그도 그 집에 그대로 살고 있었다. 나는 #ruby("출|입","出|入")시 #ruby("종|종","種|種") 마음으로 절하고 지냈다.]
#zh[对面也是物商客栈，安浩然先生的家。安先生同样是对我和父母尽过极诚的老人，也还住在那里。我每次出入牢门，经过他家门前时，心中总是默默地向他行礼。]
