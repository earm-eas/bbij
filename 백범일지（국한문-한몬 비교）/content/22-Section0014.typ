#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제","第")2#ruby("지|대","支|隊")는 OSS#footnote(numbering: _ => [10)])[#h(0.35em)OSS는 Office of Strategic Service로 #ruby("미|국","美|國") #ruby("전|략|사|무|국","戰|略|事|務|局")의 #ruby("약|자","略|字"). #ruby("미|국","美|國")은 2#ruby("차|대|전","次|大|戰") #ruby("중","中") #ruby("해|외|전|략","海|外|戰|略") #ruby("기|구","機|構")로서 #ruby("정|보|활|동","情|報|活|動")과 #ruby("유|격|활|동","遊|擊|活|動")을 #ruby("병|행","竝|行")하며 #ruby("적","敵") #ruby("후|방|지|역","後|方|地|域")을 #ruby("교|란","攪|亂")시킬 #ruby("목|적","目|的")으로 1942#ruby("년","年") OSS를 #ruby("창|건","創|建")하였다.] #ruby("주|관|자","主|管|者") 싸전트 #ruby("박|사","博|士")와 #ruby("이|범|석","李|範|奭") #ruby("지|대|장","支|隊|長")이 #ruby("합|작","合|作")하여 #ruby("서|안","西|安")에서 #ruby("비|밀|훈|련","祕|密|訓|鍊")을 #ruby("실|시","實|施")하고, #ruby("본|시","本|是") #ruby("개|성","開|城") #ruby("출|신","出|身")으로 우리 #ruby("언|어","言|語")가 #ruby("능|숙","能|熟")한 윔쓰 #ruby("중|위","中|尉")#footnote(numbering: _ => [11)])[#h(0.35em)윔쓰는 #ruby("해|방","解|放") #ruby("전","前") OSS#ruby("소|속","所|屬")으로 #ruby("광|복|군","光|復|軍") #ruby("교|관","敎|官")을 #ruby("역|임","歷|任")하였고, #ruby("해|방","解|放") #ruby("직|후","直|後")에는 #ruby("미|군|정","美|軍|政") #ruby("장|관","長|官") 하지의 #ruby("요|청","要|請")으로 #ruby("임|정","臨|政")에 관한 #ruby("보|고|서","報|告|書")를 #ruby("작|성","作|成")하여 #ruby("제|출","提|出")한 바 있다. 이 #ruby("보|고|서","報|告|書")에서 그는 #ruby("임|정","臨|政")의 #ruby("역|할","役|割")과 #ruby("활|용|가|치","活|用|價|値")를 매우 높게 #ruby("평|가","評|價")하여, #ruby("해|방","解|放") #ruby("초|기","初|期") #ruby("미|군|정","美|軍|政")이 #ruby("임|정","臨|政")에 대한 #ruby("긍|정|적","肯|定|的")인 #ruby("인|식","認|識")을 갖는 데 #ruby("중|요","重|要")한 #ruby("역|할","役|割")을 하였다.]는 #ruby("부|양","阜|陽")에서 #ruby("김|학|규","金|學|奎") #ruby("대|장","隊|長")과 #ruby("합|작","合|作")하여 #ruby("비|밀|훈|련","祕|密|訓|鍊")을 #ruby("실|시","實|施")하였다. 3#ruby("개|월","個|月")의 #ruby("훈|련","訓|鍊")을 마치고 #ruby("조|선","朝|鮮")으로 #ruby("밀|파","密|派")하여 #ruby("파|괴","破|壞")·#ruby("정|탐","偵|探") #ruby("등","等") #ruby("공|작","工|作")을 #ruby("개|시","開|始")할 #ruby("준|비","準|備")를 마쳤을 때, #ruby("미|국","美|國") #ruby("작|전|부|장","作|戰|部|長") 도노반 #ruby("장|군","將|軍")과 #ruby("항|적|공|작","抗|敵|工|作")을 #ruby("협|의","協|議")하기 위해 #ruby("미|국","美|國") #ruby("비|행|기","飛|行|機")를 타고 #ruby("서|안","西|安")으로 가서 #ruby("정|중","鄭|重")한 #ruby("회|담","會|談")을 하였다.#footnote(numbering: _ => [12)])[#h(0.35em)#ruby("장|준|하","張|俊|河")의 #ruby("회|고","回|顧")에 의하면 #ruby("백|범","白|凡")이 #ruby("광|복|군","光|復|軍") #ruby("총|사|령","總|司|令") #ruby("이|청|천","李|靑|天")과 함께 #ruby("두|곡","杜|曲")을 #ruby("방|문","訪|問")한 것은 1945#ruby("년","年") 8#ruby("월","月") 7#ruby("일","日")이었다.] 그 #ruby("내|용","內|容")은 #ruby("대|개","大|槪") 다음과 같다.]
#zh[由于此事的关系，我们的光复军引起了联合国的注意，美国主管战略事务局(Office of Strategic Senice)的萨森特博士在西安与第二支队长李范奭合作，威姆斯中尉在阜阳与第三支队长金学奎合作，秘密训练我们的光复军。按照预定的计划，受完三个月的训练后，便授以侦察及破坏的任务，准备秘密遣回祖国工作。我为了与美国作战部长陀诺裴将军讨论军事协议，搭乘美国飞机到西安。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제","第")2#ruby("지|대","支|隊") #ruby("본|부","本|部") #ruby("사|무|실","事|務|室") #ruby("정|면","正|面") 오른쪽 #ruby("태|극|기","太|極|旗") 밑에는 내가 앉고, 왼쪽 #ruby("성|조|기","星|條|旗") 밑에 도노반이 앉고, 도노반 앞에는 #ruby("미|국","美|國") #ruby("훈|련|관","訓|鍊|官")들이 앉았고, 내 앞에는 #ruby("제","第")2#ruby("지|대","支|隊") #ruby("간|부","幹|部")들이 앉은 #ruby("후","後"), 도노반 #ruby("장|군","將|軍")으로부터 #ruby("정|중","鄭|重")한 #ruby("선|언","宣|言") #ruby("발|표","發|表")가 있었다.]
#zh[会议在光复军第二支队本部办公室举行，开会时，正右边的太极旗下坐着我和第二支队的干部，左边美国国旗下坐着陀诺裴将军与美国教官。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("금|일","今|日") #ruby("금|시","今|時")로부터 아메리카#ruby("합|중|국","合|衆|國")과 #ruby("대|한|민|국|임|시|정|부","大|韓|民|國|臨|時|政|府")와의 #ruby("적","敵") #ruby("일|본","日|本")에 #ruby("항|거","抗|拒")하는 #ruby("비|밀|공|작","祕|密|工|作")은 #ruby("시|작","始|作")되었다.”]
#zh[陀诺裴将军站起来宣布说：]
#zh[“自今日起，美利坚合众国与大韩民国临时政府共同抵抗敌人日本，开展秘密工作。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[도노반과 내가 #ruby("정|문","正|門")으로 나올 때에 #ruby("활|동|사|진|반","活|動|寫|眞|班")들이 #ruby("사|진|촬|영","寫|眞|撮|影")을 하는 것으로 #ruby("의|식","儀|式")을 끝마쳤다.]
#zh[陀诺裴和我走出正门时，活动照相班拍照，仪式就此结束。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 #ruby("미|국","美|國") #ruby("군|관","軍|官")들의 #ruby("요|청","要|請")으로 #ruby("비|밀|훈|련","祕|密|訓|鍊")을 받은 #ruby("학|생","學|生")들의 #ruby("실|전|실|험","實|戰|實|驗")을 해볼 #ruby("목|적","目|的")으로 #ruby("두|곡","杜|曲")에서 다시 #ruby("동|남","東|南")쪽으로 40#ruby("리","里")쯤 떨어진, #ruby("고|대","古|代") #ruby("한|시","漢|詩")에 #ruby("유|명","有|名")한 #ruby("종|남|산","終|南|山") #ruby("고|찰","古|刹")에 있는 #ruby("비|밀|훈|련|소","祕|密|訓|鍊|所")#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("광|복|군","光|復|軍") #ruby("제","第")2#ruby("지|대","支|隊")는 이 오래 된 #ruby("사|찰","寺|刹")을 #ruby("내|부","內|部") #ruby("개|조","改|造")하여 #ruby("비|밀|훈|련|소","祕|密|訓|鍊|所")로 #ruby("사|용","使|用")하였다.]로 #ruby("자|동|차","自|動|車")를 몰았다. #ruby("산","山") #ruby("입|구","入|口")까지 가서 #ruby("차","車")를 버리고 다시 #ruby("보|행","步|行")으로 5#ruby("리","里") #ruby("가|량","假|量") 들어가 #ruby("당|도","當|到")하니, #ruby("시|간","時|間")이 마침 #ruby("정|오","正|午")라서 #ruby("미|국","美|國") #ruby("군|대|식","軍|隊|式")으로 #ruby("오|찬","午|餐")을 먹었다.]
#zh[第二天应美国军官的请求，为了看看受过秘密训练的学生的实战实验，从杜曲再往东南约四十里，开车到古代汉诗里有名的终南山古刹秘密训练所。到了山口弃车，再步行五里左右到达，时候正是正午，吃了美国军队式的午餐。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[맨 먼저 #ruby("냉|수","冷|水") 여러 #ruby("통","桶")을 뜰에 가져다 놓고 #ruby("군|대|용","軍|隊|用") 국과 물그릇으로 #ruby("병|용","竝|用")하는 #ruby("철|기","鐵|器")를 1#ruby("인|당","人|當") 1#ruby("개","個")씩 나누어 준 #ruby("후","後"), 종이#ruby("갑","匣")도 한 #ruby("개","個")씩을 나누어 주었다. 그것을 풀어헤쳐 보니 #ruby("과|자","菓|子") 비슷한 것이 5#ruby("개","個")씩 들어 있고, 여러 가지 #ruby("통","桶")조림 깡통, #ruby("연|초","煙|草") 4#ruby("개","個"), 그리고 #ruby("휴|지","休|紙")까지 들어 있었다. 또한 종이로 싼 가루 한 #ruby("봉|지","封|紙")를 #ruby("냉|수","冷|水")에 섞어보니 훌륭한 고깃국이 되어 #ruby("점|심","點|心")으로 #ruby("충|분","充|分")하였다. #ruby("미|국","美|國") #ruby("군|대","軍|隊")의 #ruby("평|상|시","平|常|時") #ruby("전|투|식|량","戰|鬪|食|糧")이라 #ruby("간|단","簡|單")한 #ruby("서|양|요|리","西|洋|料|理")였으나 누구든 #ruby("부|족","不|足")한 사람은 없을 것이다. #ruby("군|대|식|사","軍|隊|食|事") 한 가지만 #ruby("왜|병","倭|兵")과 #ruby("비|교","比|較")해 보더라도 #ruby("왜|적","倭|敵")이 질 것은 #ruby("명|확","明|確")한 #ruby("사|실","事|實")이라 하겠다.]
#zh[先把好几桶冷水放在院子里，军队用的汤和喝水并用的铁器每人发一个，纸匣也每人发一个。打开一看，里面有五块像饼干的东西，各种罐头，四支烟，连手纸都有。还有一包纸包的粉，和进冷水，就成了很好的肉汤，午饭足够了。这是美国军队平常的战斗粮食，虽是简单的西餐，谁也不会不够。单拿军队的饭食和倭兵一比，倭寇要失败也是明明白白的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("만|족","滿|足")한 #ruby("오|찬","午|餐")을 마친 #ruby("후","後"), 때는 아직 8#ruby("월","月") #ruby("상|순","上|旬")이라, 참외와 수박 #ruby("등","等")을 먹었다. 이어서 우리 #ruby("청|년|학|생","靑|年|學|生")들을 #ruby("훈|련","訓|鍊")시키는 #ruby("미|국","美|國") #ruby("장|교","將|校")들의 #ruby("각|자","各|自") 맡은 #ruby("과|목","科|目")을 #ruby("실|습","實|習")하는 #ruby("광|경","光|景")을 구경하였다.]
#zh[吃完了满足的午餐，时候还是八月上旬，又吃了香瓜和西瓜。接着观看美国将校各按自己担任的科目，训练我们青年学生的情形。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째로 본 것은 #ruby("심|리|학","心|理|學") #ruby("박|사","博|士")가 #ruby("각","各") #ruby("학|생","學|生")들을 #ruby("심|리|학|적","心|理|學|的")으로 #ruby("시|험","試|驗")하여 #ruby("모|험|성","冒|險|性")이 #ruby("풍|부","豐|富")한 #ruby("자","者")는 #ruby("파|괴|술","破|壞|術")을, #ruby("지|적","知|的") #ruby("능|력","能|力")이 #ruby("강","強")한 #ruby("자","者")는 #ruby("적|정","敵|情") #ruby("정|탐","偵|探")으로, 눈 밝고 손재주 있는 #ruby("자","者")는 #ruby("무|전|기","無|電|機") #ruby("사|용|법","使|用|法")을 #ruby("분|과","分|科") #ruby("과|목","科|目")으로 #ruby("훈|련","訓|鍊")시키는 것이었다. #ruby("심|리|학|자","心|理|學|者")가 #ruby("시|험","試|驗") #ruby("성|적","成|績")의 #ruby("개|요","槪|要")를 #ruby("보|고","報|告")하였는데, #ruby("특","特")히 #ruby("한|국","韓|國") #ruby("청|년","靑|年")은 앞으로 #ruby("촉|망","囑|望")된다고 말하였다.]
#zh[这次实地演习，第一是以心理学的方法选拔敢于和善于冒险的人、能随机应变而精于侦察的人和耳聪目明、熟练掌握无线电的人，主持这项考试的心理学家的结论是，韩国青年不论是勇气或是技能都是很优秀的，将来前途无量。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("청|년","靑|年") 7#ruby("명","名")을 #ruby("인|솔","引|率")하고 #ruby("종|남|산","終|南|山") 봉우리로 올라가 #ruby("수|백","數|百") 길 #ruby("절|벽","絶|壁") 아래로 내려가서 #ruby("적|정","敵|情")을 #ruby("탐|지","探|知")하고 올라오는 것이 #ruby("목|표","目|標")인데, #ruby("소|지|품","所|持|品")은 #ruby("단|지","但|只") #ruby("수|백","數|百") 길 되는 숭마바#footnote(numbering: _ => [14)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("숙|마","熟|麻") 밧줄”. 잿물에 담갔다가 솥에 찐 삼껍질인 #ruby("숙|마","熟|麻")로 만든 밧줄.] 하나뿐이었다. #ruby("청|년","靑|年") 7#ruby("명","名")이 #ruby("회|의","會|議")한 #ruby("결|과","結|果") 그 #ruby("수|백","數|百") 길 되는 밧줄을 여러 #ruby("번","番") 매듭지은 #ruby("후","後"), 한 끝은 #ruby("상|봉","上|峰") 바위 위에 매고, 다른 끝은 #ruby("절|벽","絶|壁") 아래로 떨어뜨린 #ruby("후","後") 그 줄을 타고 내려갔다. 그리고는 나뭇가지를 하나씩 입에 물고 올라오니 이로써 #ruby("목|표","目|標")를 #ruby("달|성","達|成")하였다.#footnote(numbering: _ => [15)])[#h(0.35em)‘#ruby("추|가|본","追|加|本")’과 ‘#ruby("국|사|원|본","國|士|院|本")’ 및 이를 #ruby("저|본","底|本")으로 한 모든 #ruby("출|간|본","出|刊|本") 사이에는 두 가지 #ruby("차|이","差|異")가 있다. ‘#ruby("국|사|원|본","國|士|院|本")’이나 #ruby("출|간|본","出|刊|本")에는 ① 7#ruby("명","名")에게 밧줄을 하나씩 주었는데 이를 이어서 긴 밧줄 하나로 만들어, ② 나뭇가지가 아닌 나뭇잎을 따온 것으로 되어 있다.] 이를 지켜본 #ruby("미|국","美|國") #ruby("교|관","敎|官")은,]
#zh[其次是把麻绳连结起来，一头系在岩石上，然后挑出七名青年，命他们攀绳下到悬崖下，摘一片树叶衔在口里，再攀援而上。考官看了七人的表演，大为赞赏，他说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 앞서 #ruby("중|국","中|國") #ruby("학|생","學|生") 400#ruby("명","名")을 모아서 #ruby("시|험","試|驗")하였을 때에도 #ruby("발|견","發|見")하지 못한 #ruby("해|답","解|答")을 #ruby("귀|국","貴|國") #ruby("청|년","靑|年") 7#ruby("명","名")에게서 찾아냈소. 참으로 앞날이 #ruby("촉|망","囑|望")되는 #ruby("국|민","國|民")이오.”]
#zh[“我考过四百名中国青年，他们不能解决的问题，让七名韩国青年出色地解决了。韩国人真是一个前途光明的民族啊！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라며 크게 #ruby("칭|찬","稱|讚")하였다. 그#ruby("후","後") #ruby("폭|파|술","爆|破|術")·#ruby("사|격|술","射|擊|術")·#ruby("비|밀","祕|密")#ruby("도|강|술","越|江|術") #ruby("등|등","等|等")을 #ruby("차|례","次|例")로 #ruby("시|험","試|驗")하였다. 나는 #ruby("시|찰","視|察")을 #ruby("무|사","無|事")히 마친 #ruby("후","後") 그날로 #ruby("두|곡","杜|曲")으로 돌아왔다.]
#zh[这七名青年受到如此的称赞，我真是无比高兴。]
#zh[再其次是试验爆破、射击、秘密渡河等，他们都有很好的成绩，我非常满意。当天我们就回到了杜曲。]
#heading(level: 3)[#text(font: "KOPUSGo B")[3) #ruby("왜|적","倭|敵")의 #ruby("조|기|항|복","早|期|降|伏")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("두|곡","杜|曲")에서 하룻밤을 묵고 다음날은 #ruby("서|안","西|安")의 #ruby("중|국","中|國") #ruby("친|우","親|友")들을 #ruby("방|문","訪|問")하였다. 40#ruby("리","里") #ruby("서|안","西|安")을 들어가서 #ruby("호|종|남","胡|宗|南") #ruby("장|군","將|軍")을 #ruby("방|문","訪|問")하였으나, #ruby("호","胡")#ruby("장|군","將|軍")은 #ruby("출|장","出|張")#ruby("중","中")인 #ruby("관|계","關|係")로 #ruby("참|모|장","參|謀|長")이 #ruby("대|신","代|身") #ruby("접|견","接|見")하였다.]
#zh[在杜曲住了一夜，第二天去拜访西安的中国朋友。走进四十里到了西安，去见胡宗南将军，胡将军出差，由参谋长代为接见。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("성","省") #ruby("정|부","政|府")를 #ruby("방|문","訪|問")하니 #ruby("성","省") #ruby("주|석","主|席") #ruby("축|소|주","祝|紹|周") #ruby("선|생","先|生")은 나와 #ruby("막|역","莫|逆")한 #ruby("친|우","親|友")라 다음날 저녁 #ruby("자|기","自|己") #ruby("사|랑","舍|廊")에서 #ruby("식|사","食|事")를 같이 하자고 #ruby("초|청","招|請")하여 #ruby("승|낙","承|諾")하였다. 또한 #ruby("성|당|부","省|黨|部")에서는 나를 위한 #ruby("연|회","宴|會")를 #ruby("개|최","開|催")하겠다 하고, #ruby("서|안|부|인|회","西|安|婦|人|會")에서도 나를 #ruby("환|영","歡|迎")하기 위하여 #ruby("연|극","演|劇")을 #ruby("준|비","準|備")한다 하며, #ruby("각","各") #ruby("신|문|사","新|聞|社")에서도 #ruby("환|영|회","歡|迎|會")를 #ruby("개|최","開|催")하겠으니 #ruby("참|석","參|席")해 달라고 #ruby("요|청","要|請")하였다.]
#zh[去访问省政府，省主席祝绍周先生和我是莫逆之交，邀请第二天晚上在他自己的舍廊一起吃饭，我答应了。省党部也说要为我开宴会，西安妇女会为欢迎我准备演剧，各报社也要开欢迎会，请我出席。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날은 우리 #ruby("동|포","同|胞") #ruby("김|종|만","金|鍾|萬") #ruby("씨","氏") #ruby("댁","宅")에서 #ruby("유|숙","留|宿")하였다. 다음날 #ruby("서|안","西|安")의 #ruby("명|소","名|所")를 #ruby("대|강","大|綱") #ruby("관|람","觀|覽")하고 #ruby("축","祝")#ruby("주|석","主|席") #ruby("사|랑","舍|廊")에서 저녁을 마친 #ruby("후","後"), 날씨가 매우 더울 때이므로 #ruby("객|실","客|室")에서 수박을 먹으며 #ruby("담|화","談|話")하던 #ruby("중","中") #ruby("홀|연","忽|然") #ruby("전|화","電|話")소리가 울렸다. #ruby("축","祝")#ruby("주|석","主|席")은 놀라는 듯 자리에서 일어나 “#ruby("중|경","重|慶")에서 무슨 #ruby("소|식","消|息")이 있는 듯하다”며 #ruby("전|화|실","電|話|室")로 #ruby("급","急")히 들어가더니, 뒤이어 나오며]
#zh[我那天晚上就在我们同胞金钟万家度过，翌日我参观了西安的名胜古迹，晚上就依约到祝主席家去共进晚餐。吃过饭后在客室里一面吃西瓜一面闲谈时，忽然电话铃响了，祝主席吃惊地站起来说，不知道重庆有什么消息来，就到电话室去，过了一会儿回来喊着：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("왜|적","倭|敵")이 #ruby("항|복","降|伏")한답니다.”]
#zh[“倭寇投降了！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 하였다.#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("국|사|원|본","國|士|院|本")에서는 이 다음에 “아! #ruby("왜|적","倭|敵")이 #ruby("항|복","降|伏")”이라는, #ruby("유|명","有|名")한 #ruby("백|범","白|凡")의 #ruby("탄|식","歎|息")이 #ruby("문|학|적","文|學|的")으로 #ruby("추|가","追|加")되어 있다.]]
#zh[他说。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 #ruby("소|식","消|息")은 내게 #ruby("희|소|식","喜|消|息")이라기보다는 하늘이 무너지고 땅이 꺼지는 일이었다. #ruby("수|년","數|年") 동안 애를 써서 #ruby("참|전","參|戰")을 #ruby("준|비","準|備")한 것도 모두 #ruby("허|사","虛|事")로 돌아가고 말았다.]
#zh[这个消息对我与其说是喜讯，不如说是天塌地陷。几年间费尽心血准备参战，全部成了虚事。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|안|훈|련|소","西|安|訓|鍊|所")와 #ruby("부|양|훈|련|소","阜|陽|訓|鍊|所")에서 #ruby("훈|련","訓|鍊")받은 우리 #ruby("청|년","靑|年")들을 #ruby("조|직|적","組|織|的")·#ruby("계|획|적","計|劃|的")으로 #ruby("각|종","各|種") #ruby("비|밀|무|기","祕|密|武|器")와 #ruby("전|기","電|器")를 #ruby("휴|대","携|帶")시켜 #ruby[산동반도][山東角]에서 #ruby("미|국","美|國") #ruby("잠|수|함","潛|水|艦")에 태워 #ruby("본|국","本|國")으로 #ruby("침|입","侵|入")하게 하여 #ruby("국|내","國|內") #ruby("요|소","要|所")에서 #ruby("각|종","各|種") #ruby("공|작","工|作")을 #ruby("개|시","開|始")하여 #ruby("인|심","人|心")을 #ruby("선|동","煽|動")하게 하고, #ruby("전|신","電|信")으로 #ruby("통|지","通|知")하여 #ruby("무|기","武|器")를 #ruby("비|행|기","飛|行|機")로 #ruby("운|반","運|搬")하여 #ruby("사|용","使|用")할 것을 #ruby("미|국","美|國") #ruby("육|군|성","陸|軍|省")과 #ruby("긴|밀","緊|密")히 #ruby("합|작","合|作")하였다. 그런데 그러한 #ruby("계|획","計|劃")을 한#ruby("번","番") #ruby("실|시","實|施")해 보지도 못하고 #ruby("왜|적","倭|敵")이 #ruby("항|복","降|伏")하였으니, #ruby("전|공|가|석","前|功|可|惜")이요, #ruby("내|사|가|려","來|事|可|慮")라.#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("지|금","只|今")까지 들인 #ruby("정|성","精|誠")이 아깝고 다가올 일이 걱정되었다.”]]
#zh[在西安训练所和阜阳训练所受过训练的青年，我们已和美国陆军部紧密合作，要有组织、有计划地让他们携带各种秘密武器和电器，从山东半岛坐美国潜水艇潜入本国，在国内要地开始各种工作，鼓动人心，再用电信通知，把武器用飞机运来使用。这样的计划一次也没能实施，倭寇就投降了，前功可惜，来事可虑。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("즉|시","卽|時") #ruby("축","祝")#ruby("씨","氏") #ruby("사|랑","舍|廊")을 #ruby("출|발","出|發")하여 #ruby("차","車")가 큰길을 지날 때 벌써 #ruby("군|중","群|衆")은 #ruby("인|산|인|해","人|山|人|海")를 이루었고, #ruby("만|세","萬|歲")소리는 #ruby("성|내","城|內")에 #ruby("진|동","震|動")하였다. #ruby("약|속","約|束")한 #ruby("환|영|준|비","歡|迎|準|備")를 #ruby("전|부","全|部") #ruby("취|소","取|消")하고 그날 밤 바로 #ruby("두|곡","杜|曲")으로 #ruby("귀|환","歸|還")하였다.]
#zh[我立刻离开祝氏的舍廊。车子经过大街时，群众已经人山人海，万岁声震动城内。约定的欢迎准备全部取消，当晚就回到杜曲。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리 #ruby("광|복|군","光|復|軍")은 #ruby("계|획","計|劃")하였던 #ruby("자|기","自|己") #ruby("임|무","任|務")를 #ruby("달|성","達|成")치 못하고 #ruby("전|쟁","戰|爭")이 끝나 #ruby("실|망","失|望") #ruby("낙|담","落|膽")하는 #ruby("분|위|기","雰|圍|氣")에 잠기었고, #ruby("반|면","反|面") #ruby("미|국","美|國") #ruby("교|관","敎|官")과 #ruby("군|인","軍|人")들은 매우 기뻐하여 #ruby("질|서","秩|序")가 #ruby("문|란","紊|亂")한 것도 깨닫지 못할 #ruby("정|도","程|度")였다. #ruby("미|국","美|國")은 #ruby("한|국","韓|國") #ruby("병|사","兵|士") #ruby("수|천","數|千") #ruby("명","名")을 #ruby("수|용","收|容")할 #ruby("장|소","場|所")를 #ruby("두|곡","杜|曲")에다 #ruby("건|설","建|設")할 #ruby("목|적","目|的")으로 #ruby("종|남|산","終|南|山")에서 #ruby("벽","甓")돌과 #ruby("재|목","材|木")을 #ruby("운|반","運|搬")하는 #ruby("등","等") #ruby("거|대","巨|大")한 #ruby("공|사","工|事")를 #ruby("진|행","進|行")하였는데, 그날부터 그 #ruby("공|사","工|事")도 #ruby("일|제","一|齊")히 #ruby("중|지","中|止")되었다. 나의 #ruby("원|래","元|來") #ruby("목|적","目|的")은 #ruby("제","第")1#ruby("차","次")로 #ruby("서|안","西|安")에서 #ruby("훈|련","訓|鍊")을 마친 #ruby("청|년","靑|年")들을 #ruby("본|국","本|國")으로 들여보내고, #ruby("제","第")2#ruby("차","次")로 #ruby("부|양","阜|陽")으로 가서 그곳에서 #ruby("훈|련","訓|鍊")받은 #ruby("청|년","靑|年")들도 아울러 #ruby("본|국","本|國")으로 보낼 #ruby("예|정","豫|定")이었으나, 그 #ruby("역|시","亦|是") 물거품이 되었다.]
#zh[我们光复军没能达成计划好的任务，战争就结束了，沉在失望落胆的气氛里。美国教官和军人却高兴得连秩序紊乱也不觉得。美国为了在杜曲建造能容纳数千名韩国兵士的地方，正从终南山搬运砖和木材，做着巨大的工程，从那天起工程也一齐停止。我原来的目的是先把在西安训练完的青年送进本国，再到阜阳把那里训练的青年也送回本国，这同样成了泡影。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|안","西|安")으로 갈 때 #ruby("군|용|기","軍|用|機")를 타고 갔으니 #ruby("중|경","重|慶")으로 돌아올 때에도 #ruby("군|용|기","軍|用|機")를 타고 올 #ruby("예|정","豫|定")이었으나, #ruby("질|서","秩|序")가 #ruby("문|란","紊|亂")하여 #ruby("군|용|기","軍|用|機")를 타지 못하고 #ruby("여|객|기","旅|客|機")로 #ruby("귀|환","歸|還")하였다. 내가 #ruby("중|경","重|慶")으로 올 때 #ruby("서|안","西|安")에서는 #ruby("미|국","美|國") #ruby("군|인","軍|人") 몇 #ruby("명","名"), #ruby("이|범|석","李|範|奭") #ruby("지|대|장","支|隊|長"), 우리 #ruby("청|년","靑|年") 4〜5#ruby("명","名") #ruby("등","等")이 서울로 #ruby("출|발","出|發")하였다. 그#ruby("후","後") #ruby("소|식","消|息")을 들으니 #ruby("영|등|포","永|登|浦")에 #ruby("도|착","到|着")하여 하룻밤을 #ruby("숙|박","宿|泊")하였으나, #ruby("왜","倭")놈의 #ruby("항|거","抗|拒")로 다시 #ruby("서|안","西|安")으로 돌아왔다는 것이다.#footnote(numbering: _ => [18)])[#h(0.35em)#ruby("이|범|석","李|範|奭")과 #ruby("장|준|하","張|俊|河") #ruby("일|행","一|行")은 1945#ruby("년","年") 8#ruby("월","月") 18#ruby("일","日") #ruby("오|후","午|後") 3#ruby("시","時") #ruby("여|의|도","汝|矣|島") #ruby("비|행|장","飛|行|場")에 #ruby("도|착","到|着")하여 #ruby("일|본","日|本") #ruby("군|대","軍|隊")와 #ruby("대|치","對|峙")하다. #ruby("임|무","任|務")를 #ruby("완|수","完|遂")하지 못하고 19#ruby("일","日") #ruby("오|후","午|後") 5#ruby("시","時") #ruby("여|의|도","汝|矣|島") #ruby("비|행|장","飛|行|場")을 다시 떠났다.]]
#zh[去西安时坐的是军用飞机，回重庆时也预定坐军用飞机，可是秩序紊乱，坐不成军用飞机，改坐客机回来。我回重庆的时候，在西安有几名美国军人、李范奭支队长和我们四五名青年出发去汉城。后来听说他们到了永登浦，住了一夜，因为倭寇抗拒，又回到西安。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|경","重|慶")에 돌아와 보니 #ruby("중|국","中|國") #ruby("사|회","社|會")는 벌써 #ruby("전|쟁","戰|爭")#ruby("중","中")의 #ruby("긴|장","緊|張")된 #ruby("분|위|기","雰|圍|氣")가 #ruby("돌|변","突|變")하여 #ruby("각|계","各|界") #ruby("각|층","各|層")이 #ruby("혼|란","混|亂")한 #ruby("상|태","狀|態")에 빠져 있었고, 우리 #ruby("한|인","韓|人") #ruby("사|회","社|會")는 앞으로 어찌해야 할지 #ruby("방|향","方|向")을 찾지 못한 #ruby("형|편","形|便")이었다. #ruby("임|시|정|부","臨|時|政|府")에서는 그 사이 #ruby("의|정|원","議|政|院")을 #ruby("개|회","開|會")하고 “#ruby("국|무|원","國|務|院")이 #ruby("총|사|직","總|辭|職")을 한다”느니, “#ruby("임|시|정|부","臨|時|政|府")를 #ruby("해|산","解|散")하고 #ruby("본|국","本|國")에 돌아가자”느니 #ruby("논|의","論|議")가 #ruby("분|분","紛|紛")하였다. 그러다 “#ruby("주|석","主|席")이 #ruby("중|경","重|慶")으로 돌아온다는 #ruby("소|식","消|息")이 있으니 #ruby("주|석","主|席")의 #ruby("의|견","意|見")을 #ruby("청|취","聽|取")한 #ruby("후","後") #ruby("결|정","決|定")하기로 하자”고 하여, #ruby("의|정|원","議|政|院")은 3#ruby("일|간","日|間") #ruby("정|회","停|會")#ruby("중","中")이었다.#footnote(numbering: _ => [19)])[#h(0.35em)1945#ruby("년","年") 8#ruby("월","月") 18〜19#ruby("일","日") #ruby("개|최","開|催")된 #ruby("제","第")39#ruby("차","次") #ruby("임|시|의|정|원|회|의","臨|時|議|政|院|會|議")는 #ruby("임|시|정|부","臨|時|政|府") #ruby("입|국|문|제","入|國|問|題")를 다루었으나, #ruby("한|독|당","韓|獨|黨")과 #ruby("민|혁|당","民|革|黨")·#ruby("신|한|민|주|당","新|韓|民|主|黨")·#ruby("해|방|동|맹","解|放|同|盟") #ruby("등","等")의 #ruby("의|견","意|見") #ruby("차|이","差|異")로 인하여 #ruby("백|범","白|凡")이 돌아올 때까지 #ruby("휴|회","休|會")하고 기다렸다.]]
#zh[到达重庆时，中国人战时的紧张状态已经松懈，陷入了一片混乱，我们的同胞也茫然不知所措。我还没有回来的期间，临时政府召集临时议政院开会，有的主张临时政府国务委员总辞职，有的主张解散后回国，意见纷纭，得不到结果，听到我这个主席回来的消息后，休会三天。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("개|회","開|會") #ruby("벽|두","劈|頭")에 #ruby("출|석","出|席")하여,]
#zh[我在开会开头就出席，主张说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("임|시|정|부","臨|時|政|府") #ruby("해|산","解|散") #ruby("운|운","云|云")은 #ruby("천|만|부|당","千|萬|不|當")하고 #ruby("총|사|직","總|辭|職")도 #ruby("불|가","不|可")하다. 우리가 #ruby("장|래","將|來")에 서울에 들어가 #ruby("전|체","全|體") #ruby("국|민","國|民")에게 #ruby("정|부","政|府")를 도로 바치고 난 뒤 #ruby("국|무|위|원","國|務|委|員")이 #ruby("총|사|직","總|辭|職")하는 것이 옳다.”]
#zh[“解散临时政府万万不可，总辞职也不可以。将来我们进了汉城，把政府交还给全体国民之后，国务委员再总辞职，那才对。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("주|장","主|張")하였다.#footnote(numbering: _ => [20)])[#h(0.35em)8#ruby("월","月") 21#ruby("일","日") #ruby("오|전","午|前") #ruby("서|안","西|安")에서 돌아온 #ruby("백|범","白|凡")은 #ruby("오|후","午|後")의 #ruby("의|정|원|회|의","議|政|院|會|議")에 #ruby("참|석","參|席")하여 “#ruby("총|총","悤|悤")하고 일이 많고 보따리 쌀 때에 #ruby("총|사|직","總|辭|職")은 #ruby("불|가","不|可")하다”는 #ruby("자|신","自|身")의 #ruby("입|장","立|場")을 밝혔다.] 그때 「14#ruby("개|조","個|條") #ruby("원|칙","原|則")」을 #ruby("결|정","決|定")하였다.#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("임|시|의|정|원|회|의","臨|時|議|政|院|會|議")에서 #ruby("각","各") #ruby("당|파","黨|派")#ruby("간","間")의 #ruby("의|견","意|見")을 #ruby("조|정","調|整")하지 못하자, #ruby("한|독|당","韓|獨|黨")은 #ruby("국|무|위|원|회","國|務|委|員|會") #ruby("중|심","中|心")으로 #ruby("입|국","入|國") #ruby("후","後") #ruby("정|국","政|局") #ruby("수|습|방|안","收|拾|方|案")을 마련하여 9#ruby("월","月") 3#ruby("일","日") #ruby("임|시|정|부","臨|時|政|府") #ruby("주|석","主|席") #ruby("김|구","金|九") #ruby("명|의","名|義")로 「#ruby("당|면|정|책","當|面|政|策") 14#ruby("개","個") #ruby("조|항","條|項")」을 #ruby("발|표","發|表")하였다.] #ruby("입|국","入|國")하려 할 때에 #ruby("미|국","美|國") #ruby("측","側")은 #ruby("미|국","美|國") #ruby("군|정|부","軍|政|府")가 서울에 있으니 #ruby("임|정","臨|政")은 #ruby("개|인","個|人") #ruby("자|격","資|格")으로 들어오라고 #ruby("통|보","通|報")하였다.#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("미|국|무|성","美|國|務|省")에서는 “#ruby("북|위","北|緯") 38#ruby("도|선","度|線") #ruby("이|남","以|南")의 #ruby("지|역","地|域")이 #ruby("미|군","美|軍")에 의해 #ruby("군|정","軍|政")을 받고 있다는 #ruby("사|실","事|實")을 #ruby("인|정","認|定")하며, #ruby("군|정","軍|政")이 끝날 때까지 #ruby("정|부","政|府")로서 #ruby("행|사","行|使")하지 않으며 #ruby("군|정","軍|政") #ruby("당|국","當|局")의 #ruby("법","法")과 #ruby("규|칙","規|則")을 #ruby("준|수","遵|守")할 것에 #ruby("동|의","同|意")한다”라는 #ruby("서|약|서","誓|約|書")를 #ruby("김|구","金|九")·#ruby("임|정","臨|政") #ruby("측","側")에 받아들일 것을 #ruby("일|방|적","一|方|的")으로 #ruby("통|보","通|報")하였다. #ruby("김|구","金|九")와 #ruby("임|정","臨|政")은 이 #ruby("서|약","誓|約")을 받아들인 #ruby("후","後") #ruby("입|국","入|國") #ruby("허|가","許|可")를 받을 수 있었다.] 그리하여 #ruby("입|국","入|國") #ruby("문|제","問|題")로 #ruby("의|논","議|論")이 #ruby("분|분","紛|紛")하였으나, #ruby("결|국","結|局")은 #ruby("개|인","個|人") #ruby("자|격","資|格")으로 #ruby("입|국","入|國")하기로 #ruby("결|정","決|定")되었다.]
#zh[当时决定了「十四条原则」。要入国的时候，美国方面通知说，汉城有美国军政府，临时政府要以个人资格进来。入国问题议论纷纷，结果决定以个人资格入国。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[7#ruby("년|간","年|間")의 #ruby("중|경|생|활","重|慶|生|活")을 마치게 되니 #ruby("실","實")로 #ruby("감|개|무|량","感|慨|無|量")하여 무슨 말을 써야 할지 말의 #ruby("조|리","條|理")와 일의 #ruby("두|서","頭|緖")를 찾기가 어렵다. #ruby("교|자","轎|子")#footnote(numbering: _ => [23)])[#h(0.35em)#ruby("교|자","轎|子") 또는 #ruby("평|교|자","平|轎|子")는 네 사람이 메고 가는 가마.]를 타고 #ruby("남|안","南|岸") #ruby("화|상|산","和|尙|山")에 있는 #ruby("모|친","母|親") #ruby("묘|소","墓|所")와 #ruby("망|자","亡|子") #ruby("인","仁")의 #ruby("묘|지","墓|地")를 찾아가, 미리 #ruby("준|비","準|備")해 간 꽃을 바치고 #ruby("축|문","祝|文")을 #ruby("낭|독","朗|讀")한 #ruby("후","後"), #ruby("묘","墓")지기를 불러 돈을 #ruby("후","厚")하게 주며 #ruby("분|묘","墳|墓") #ruby("관|리","管|理")를 #ruby("부|탁","付|託")하고 돌아왔다.]
#zh[七年的重庆生活就此结束，实在感慨无量，话的条理和事的头绪都难找。我坐着轿子到南岸和尚山母亲的墓和亡子仁儿的墓地，献上预先准备的花，读了祝文，叫来守墓人，厚厚给了钱，拜托他管理坟墓，然后回来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("입|국","入|國")할 #ruby("행|장","行|裝")을 #ruby("준|비","準|備")할 때 가죽#ruby("상|자","箱|子") 8#ruby("개","個")를 사서 #ruby("정|부|문|서","政|府|文|書")를 #ruby("수|습","收|拾")하였다.#footnote(numbering: _ => [24)])[#h(0.35em)가장 1#ruby("차","次") #ruby("자|료","資|料")인 #ruby("임|시|정|부","臨|時|政|府") #ruby("문|서","文|書") 8#ruby("상|자","箱|子")는 #ruby("한|국|전|쟁","韓|國|戰|爭")#ruby("중","中")에 #ruby("유|실","遺|失")되어 그 #ruby("행|방","行|方")을 알 수 없다. 이로 인해 #ruby("임|시|정|부","臨|時|政|府")에 대한 #ruby("자|료","資|料")는 #ruby("일|본","日|本") #ruby("정|부","政|府")의 #ruby("사|찰|기|록","査|察|記|錄")이거나 #ruby("대|만","臺|灣") #ruby("국|민|당","國|民|黨") #ruby("정|부","政|府") #ruby("소|장","所|藏") #ruby("자|료","資|料")가 #ruby("대|부|분","大|部|分")이다.] #ruby("중|경","重|慶")의 500#ruby("여","餘") #ruby("명","名") #ruby("교|포","僑|胞")의 #ruby("선|후","善|後") #ruby("문|제","問|題")와, #ruby("임|시|정|부","臨|時|政|府")가 #ruby("중|경","重|慶")을 #ruby("출|발","出|發")한 #ruby("이|후","以|後") #ruby("중|국|정|부","中|國|政|府")와 #ruby("연|락|관|계","連|絡|關|係")를 갖기 위하여 #ruby("주|화|대|표|단","駐|華|代|表|團")을 #ruby("설|치","設|置")하고, #ruby("단|장","團|長")에 #ruby("박|찬|익","朴|贊|翊"), #ruby("간|부","幹|部")에는 #ruby("민|필|호","閔|弼|鎬")·#ruby("이|광","李|光")·#ruby("이|상|만","李|象|萬")·#ruby("김|은|충","金|恩|忠") #ruby("등","等")을 #ruby("선|임","選|任")하였다.#footnote(numbering: _ => [25)])[#h(0.35em)1945#ruby("년","年") 11#ruby("월","月") 1#ruby("일","日") #ruby("임|시|정|부","臨|時|政|府")는 #ruby("귀|국","歸|國") #ruby("후","後") #ruby("교|민","僑|民")들의 #ruby("위|무","慰|撫")와 #ruby("중|국","中|國") #ruby("국|민|당","國|民|黨")과의 #ruby("외|교|적","外|交|的") #ruby("교|섭","交|涉")을 위하여 #ruby("중|경","重|慶")에 #ruby("대|한|민|국|임|시|정|부","大|韓|民|國|臨|時|政|府") #ruby("주|화|대|표|단","駐|華|代|表|團")을 #ruby("설|치","設|置")하였다. #ruby("대|표|단","代|表|團")은 1946#ruby("년","年") 6#ruby("월","月") #ruby("본|부","本|部")를 #ruby("남|경","南|京")으로 옮겼고, #ruby("중|국","中|國") #ruby("국|민|당|군","國|民|黨|軍")의 #ruby("만|주","滿|洲") #ruby("진|출","進|出") #ruby("후","後") #ruby("만|주","滿|洲")를 #ruby("중|심","中|心")으로 #ruby("활|동","活|動")하였다. 그#ruby("후","後") #ruby("변|화","變|化")를 거듭하다 1948#ruby("년","年") 8#ruby("월","月") 10#ruby("일","日") #ruby("공|식|적","公|式|的")으로 #ruby("해|체","解|體")되었다.]]
#zh[准备入国行装的时候，买了八只皮箱，收拾政府文书。为了重庆五百余名侨胞的善后，以及临时政府离开重庆以后和中国政府保持联络，设置了驻华代表团，团长选任朴赞翊，干部有闵弼镐、李光、李象万、金恩忠等。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|경","重|慶")을 떠날 #ruby("당|시","當|時")에 #ruby("중|국","中|國") #ruby("공|산|당","共|産|黨") #ruby("본|부","本|部")에서 #ruby("주|은|래","周|恩|來")·#ruby("동|필|무","董|必|武") #ruby("등","等")이 우리 #ruby("임|시|정|부","臨|時|政|府") #ruby("국|무|원","國|務|院") #ruby("전|체","全|體")를 #ruby("초|청","招|請")한 #ruby("송|별|연","送|別|宴")이 있었다. #ruby("국|민|당","國|民|黨") #ruby("정|부","政|府")에서도 #ruby("송|별|연","送|別|宴")을 열었는데, #ruby("장|개|석","蔣|介|石") #ruby("선|생","先|生")을 #ruby("위|시","爲|始")하여 #ruby("중|앙|정|부","中|央|政|府")와 #ruby("중|앙|당|부","中|央|黨|部") #ruby("각|계","各|界") #ruby("명|망|가","名|望|家") #ruby("수|백","數|百") #ruby("인","人")이 모였고, 우리 #ruby("측","側")에서는 #ruby("임|시|정|부","臨|時|政|府") #ruby("국|무|위|원","國|務|委|員")과 #ruby("한|국|독|립|당","韓|國|獨|立|黨") #ruby("간|부","幹|部")들이 #ruby("초|청","招|請")받았다. #ruby("연|회","宴|會")는 #ruby("중|국","中|國") #ruby("국|민|당","國|民|黨") #ruby("중|앙|당|부","中|央|黨|部") #ruby("대|례|당","大|禮|堂")에서 #ruby("중","中")·#ruby("한","韓")#ruby("국|기","國|旗")를 #ruby("교|차","交|叉")한 채 #ruby("융|숭","隆|崇")하고 #ruby("간|곡","懇|曲")하게 #ruby("진|행","進|行")되었다. #ruby("장|개|석","蔣|介|石") #ruby("주|석","主|席")과 #ruby("송|미|령","宋|美|齡") #ruby("여|사","女|史")가 #ruby("선|두","先|頭")로 “#ruby("장|래","將|來") #ruby("중","中")·#ruby("한","韓")의 #ruby("영|구","永|久") #ruby("행|복","幸|福")을 #ruby("도|모","圖|謀")하자”고 #ruby("연|설","演|說")하였고, 우리 #ruby("측","側") #ruby("답|사","答|辭")가 있은 #ruby("후","後") 끝마쳤다.]
#zh[我们将要离开重庆，所以中央政府与国民党，以蒋介石伉俪为首，邀集了政府、党部、各界要人二百余名，在国民党中央党部大礼堂里，宴请我们临时政府国务委员与韩国独立党干部。礼堂内交叉悬挂着中国国旗与太极旗，非常隆重感人地举行了欢送宴会，蒋介石主席与宋美龄女士首先站起来致辞，祝中韩两国国运昌隆，我方也致了答辞。中国共产党本部的周恩来、董必武也为临时政府国务院全体委员举行了欢送宴会。]
