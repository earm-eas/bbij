#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 #ruby("안|진|사","安|進|士") #ruby("사|랑","舍|廊")에 갔다가 참빗장수 한 사람을 보았다. 말하는 것과 #ruby("행|동","行|動")하는 것을 가만히 보니 #ruby("보|통","普|通") 돌아다니는 참빗장수와 달랐다. 내가 먼저 #ruby("인|사","人|事")를 #ruby("청","請")하였다. 그 사람은 #ruby("남|원|군","南|原|郡") #ruby("이|동","耳|洞")에 사는 #ruby("김|형|진","金|亨|鎭")이었다. 나와는 #ruby("본","本")이 같고, 나이는 나보다 8, 9#ruby("세","歲") 많았다.#footnote(numbering: _ => [1)])[#h(0.35em)#ruby("김|형|진","金|亨|鎭")\(1861〜1898). #ruby("본|명","本|名")은 #ruby("김|원|명","金|元|明")이고, #ruby("김|형|모","金|炯|模")·#ruby("김|형|진","金|亨|振")·#ruby("김|봉|회","金|鳳|會") #ruby("등","等")의 다른 이름을 가지고 있으며, #ruby("김|구","金|九")보다 15#ruby("세","歲") #ruby("연|상","年|上")이다. 그는 #ruby("갑|오|농|민|전|쟁","甲|午|農|民|戰|爭")을 겪고 난 뒤 1895#ruby("년","年") #ruby("음|력","陰|曆") 4#ruby("월","月") ‘#ruby("척|양|척|왜","斥|洋|斥|倭")의 #ruby("대|도","大|道")’를 가기로 #ruby("결|심","決|心")하고 #ruby("상|경","上|京")하여 #ruby("정|세","情|勢")를 살피던 #ruby("중","中"), 같은 해 5#ruby("월","月") #ruby("황|해|도","黃|海|道") #ruby("신|천","信|川") #ruby("청|계|동","靑|溪|洞") #ruby("안|태|훈","安|泰|勳") #ruby("의|려|소","義|旅|所")에 이르러 #ruby("김|창|수","金|昌|洙")\(#ruby("김|구","金|九"))를 만났다. 이들은 곧 #ruby("의|기|투|합","意|氣|投|合")하여 #ruby("중|국","中|國")으로 #ruby("구|국","救|國")의 #ruby("여|행","旅|行")을 하게 되는데, #ruby("김|형|진","金|亨|鎭")은 그 자세한 #ruby("행|적","行|蹟")을 『#ruby("노|정|약|기","路|程|略|記")』란 #ruby("여|행|기","旅|行|記")로 남기고 있다. 이 #ruby("책","冊")은 『#ruby("백|범|일|지","白|凡|逸|志")』의 #ruby("관|련","關|連") #ruby("부|분","部|分")과 좋은 #ruby("대|비","對|比")가 된다.]]
#zh[我决定启程前往清国的前一天，谒见了安进士，在他的客舍，遇到了一个卖篦子的，他的谈吐怎么看也不像是个普通的人，于是和他寒暄，后来才知道他是住在全罗道南原耳洞的金亨镇，跟我是本家，年龄约比我大八九岁左右。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 사람에게 “내 집에 가면 참빗을 살 터이니 같이 가자”고 #ruby("청","請")하여, 그가 집에까지 따라왔다. 하룻밤 함께 자면서 이런저런 이야기를 나누어 보니 그는 #ruby("보|통","普|通") 참빗장수가 아니라, #ruby("삼|남|지|방","三|南|地|方")에서도 #ruby("신|천","信|川") #ruby("청|계|동","靑|溪|洞")에 있는 #ruby("안|진|사","安|進|士")가 #ruby("당|대","當|代")의 #ruby("대|문|장","大|文|章")이요 #ruby("대|영|웅","大|英|雄")이라는 #ruby("소|문","所|聞")이 있어 찾아온 것이라 한다. 내가 보기에 그 사람됨이 그다지 #ruby("출|중","出|衆")해 보이지 않고 #ruby("학|식","學|識")도 넉넉하지는 못해 보였으나, #ruby("시|국","時|局")에 대한 #ruby("불|평","不|平")으로 무슨 일을 해보겠다는 #ruby("결|심","決|心")은 있어 보였다. 다음날 함께 #ruby("고|선|생","高|先|生") #ruby("댁","宅")을 #ruby("방|문","訪|問")하고 #ruby("김|형|진","金|亨|鎭")의 사람됨을 살펴보시게 하였다. #ruby("고|선|생","高|先|生")은 그와 이야기를 나누어 보시더니, 남의 머리가 될 #ruby("인|물","人|物")은 못 되나 다른 사람을 도와서 일을 #ruby("성|사","成|事")할 만한 #ruby("소|질","素|質")은 있어 보인다고 하셨다.#footnote(numbering: _ => [2)])[#h(0.35em)#ruby("반|면","反|面") #ruby("김|형|진","金|亨|鎭")은 #ruby("고|능|선","高|能|善")을 보고 ‘#ruby("정|학|군|자","正|學|君|子")’라고 높이 #ruby("평|가","評|價")하였다.]]
#zh[我借买篦子为名，带他到我家来过了一晚，想观察他是何等人物，果然他不是普通卖篦子的人。]
#zh[据说他听说安进士是当代的大文豪，大英雄，特为见面而来的。]
#zh[他人品虽不出众，学识也不渊博，但言谈间似乎对国家时局颇感不满，想要有所作为。]
#zh[翌日陪同他去拜访高先生，请先生加以品评，先生所下的判断是，他虽然缺乏大人物的头脑，但有协助别人做事的才能。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 집에서 부리던 말 한 #ruby("필","匹")을 내다 팔아서 200#ruby("냥","兩")의 #ruby("여|비","旅|費")를 #ruby("준|비","準|備")하여 #ruby("김|형|진","金|亨|鎭")과 함께 #ruby("청","淸")나라로 #ruby("출|발","出|發")하였다. 가는 길에 먼저 #ruby("백|두|산","白|頭|山")이나 #ruby("답|파","踏|破")하고 #ruby("동|삼|성","東|三|省")#footnote(numbering: _ => [3)])[#h(0.35em)#ruby("동|북","東|北") 3#ruby("성","省"). #ruby("중|국","中|國") #ruby("동|부","東|部")에 #ruby("위|치","位|置")해 있는 #ruby("길|림|성","吉|林|省")·#ruby("요|녕|성","遼|寧|省")·#ruby("흑|룡|강|성","黑|龍|江|省"). #ruby("만|주","滿|洲")라 부르던 곳이다.]을 거쳐 마지막으로 #ruby("북|경","北|京")까지 갈 #ruby("목|적","目|的")으로 #ruby("출|발","出|發")하였다.]
#zh[于是我决定和他作伴，卖了一匹家里喂养的马，准备了二百两盘缠，一同启程前往清国。]
#zh[江界城之役]
#zh[我们的计划是先游览白头山①，绕过东三省到北京。]
#zh[译注：长白山。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리는 #ruby("평|양","平|壤")까지 #ruby("무|사","無|事")히 #ruby("도|착","到|着")하여#footnote(numbering: _ => [4)])[#h(0.35em)이들은 #ruby("청|계|동","靑|溪|洞")에서 #ruby("출|발","出|發")하여 #ruby("재|령","載|寧")→#ruby("봉|산","鳳|山")→#ruby("황|주","黃|州")→#ruby("중|화","中|和")를 거쳐 #ruby("평|양","平|壤")에 #ruby("도|착","到|着")하였다.] #ruby("여|행","旅|行") #ruby("방|법","方|法")을 #ruby("협|의","協|議")한 #ruby("결|과","結|果"), #ruby("김|형|진","金|亨|鎭")과 같이 참빗장수 #ruby("행|세","行|世")를 하기로 하고, #ruby("여|비","旅|費") #ruby("전|부","全|部")로 참빗·붓·먹과 #ruby("기|타","其|他") #ruby("산|중","山|中")에서 #ruby("요|긴","要|緊")한 #ruby("물|품","物|品")을 사서 두 사람이 한 짐씩 짊어졌다. #ruby("모|란|봉","牡|丹|峰")·#ruby("을|밀|대","乙|密|臺")를 #ruby("잠|시","暫|時") 구경하고, #ruby("강|동","江|東")·#ruby("양|덕","陽|德")·#ruby("맹|산","孟|山")을 지나 #ruby("고|원","高|原")·#ruby("정|평","定|平")을 거쳐 #ruby("함|흥","咸|興") #ruby("감|영","監|營")에 #ruby("도|착","到|着")하였다.]
#zh[一直到平壤都很顺利，从平壤开始，我也跟金亨镇一样化装成卖篦子和杂货的商人，买了可以在山城贩卖的毛笔、墨和其他必需品，两个人分别背着。]
#zh[离开平壤一路观览乙密台和牡丹峰之后，再转江东、阳德、孟山，越过高原、定平，抵达咸兴监营。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("평|양","平|壤")에서부터 #ruby("함|흥","咸|興")에 #ruby("도|착","到|着")하기까지 있었던 일 #ruby("중","中")에 아직까지 #ruby("기|억","記|憶")에 남는 일이 있다. #ruby("강|동","江|東") 어떤 #ruby("시|장","市|場")#footnote(numbering: _ => [5)])[#h(0.35em)#ruby("김|형|진","金|亨|鎭")에 #ruby("의","依")하면 이곳은 #ruby("강|동","江|東") #ruby("열|파|장","咽|派|場")이다.]에서 하룻밤 지내다가 #ruby("칠|십","七|十") #ruby("노|인","老|人") 주정뱅이에게 #ruby("이|유","理|由") 없이 매를 맞았다. 억울하기는 하였으나, #ruby("원|대","遠|大")한 #ruby("목|적","目|的")을 품고 먼 길을 가는 #ruby("처|지","處|地")에 #ruby("사|소","些|少")하게 잘못 만난 일을 마음에 둘 바 아니라 하여, #ruby("한|신","韓|信")이 #ruby("회|음","淮|陰")의 #ruby("시|정|잡|배","市|井|雜|輩")에게 당했던 일#footnote(numbering: _ => [6)])[#h(0.35em)#ruby("유|방","劉|邦")을 도와 #ruby("천|하","天|下")를 #ruby("통|일","統|一")한 #ruby("한|신","韓|信")이 어릴 때 #ruby("회|음","淮|陰")의 #ruby("부|랑|배","浮|浪|輩")가 #ruby("시|비","是|非")를 걸어 #ruby("자|기","自|己") 가랑이 밑을 기어서 지나가라고 하자, #ruby("한|신","韓|信")은 싸우지 않고 #ruby("부|랑|배","浮|浪|輩")의 가랑이 밑을 지나갔다. #ruby("원|대","遠|大")한 #ruby("이|상","理|想")을 품은 사람은 작은 일에 #ruby("구|애","拘|礙")받지 않는다는 #ruby("고|사","故|事")이다.]을 이야기하고 서로 #ruby("위|로","慰|勞")하였다.]
#zh[在江东某市场歇夜时，曾经被七十多岁的老醉汉无缘无故地用鞭子抽了一顿，因为有要事在身，要走远路，不能因小失大，于是讲了韩信在淮阴受胯下之辱的故事，算是自我安慰。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|원|군","高|原|郡") #ruby("함|관|령","咸|關|嶺")#footnote(numbering: _ => [7)])[#h(0.35em)#ruby("함|관|령","咸|關|嶺")은 #ruby("함|주|군","咸|州|郡")과 #ruby("홍|원|군","洪|原|郡") 사이에 있다.] 위에서 #ruby("이|태|조","李|太|祖")의 #ruby("승|전|비","勝|戰|碑")#footnote(numbering: _ => [8)])[#h(0.35em)#ruby("원|주","原|註"): “戰勝靺鞨之碑”. #ruby("고|려","高|麗") 말 #ruby("이|성|계","李|成|桂")가 #ruby("원","元")나라 #ruby("승|상","丞|相") #ruby("나|하|추","納|哈|出")의 #ruby("침|략","侵|略")을 물리친 것을 #ruby("기|념","紀|念")하여 #ruby("순|조","純|祖") 30#ruby("년","年")\(1830)에 세운 #ruby("달|단|동|승|전|기|적|념|비","韃|靼|洞|勝|戰|紀|蹟|念|碑"). #ruby("말|갈","靺|鞨")은 #ruby("달|단","韃|靼")의 #ruby("착|각","錯|覺")일 것이다. 또한 이 #ruby("비","碑")는 #ruby("고|원|군","高|原|郡")이 아니라 #ruby("홍|원|군","洪|原|郡")에 있다. 한편 『#ruby("노|정|약|기","路|程|略|記")』에 #ruby("의","依")하면, #ruby("함|흥","咸|興")에서부터 #ruby("노|자","路|資")가 떨어져 #ruby("김|창|수","金|昌|洙")와 #ruby("김|형|진","金|亨|鎭")은 잠자리를 #ruby("각|각","各|各") #ruby("구","求")하고 다음날도 #ruby("각|자","各|自") #ruby("출|발","出|發")하여, #ruby("함|관|령","咸|關|嶺")에서 #ruby("전|승|비","戰|勝|碑")를 보고 내려와 #ruby("주|막","酒|幕")에서 서로 #ruby("상|봉","相|逢")하였다고 한다.]를 구경하고, #ruby("홍|원","洪|原") #ruby("신|포","新|浦")의 #ruby("경|치","景|致")와 #ruby("북|어","北|魚")잡이하는 #ruby("광|경","光|景")을 보았다. 어떤 튼튼한 #ruby("여|자","女|子")가 광주리에 꽃게 한 마리를 힘껏 이고 가는데, 게다리 한 개가 내 팔뚝보다 굵은 것을 보았다.]
#zh[路上还看了高原咸关岭上的李太祖②击退靺鞨的战胜碑。观赏了洪原新浦的风景，参观了捕白腹鳕。有一个健壮的妇女篮子里装了一只花螃蟹费力地顶在头上走，螃蟹的一只脚比我的胳臂还粗，不禁惊奇不已。]
#zh[译注：李成桂。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("함|경|도","咸|鏡|道")의 #ruby("교|육|제|도","敎|育|制|度")는 #ruby("양|서|지|방","兩|西|地|方")\(#ruby("평|안","平|安")·#ruby("황|해|도","黃|海|道"))보다 일찍이 #ruby("발|달","發|達")해 있었다. 아무리 가난해서 게딱지만한 집#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("원|주","原|註"): “普通으로도 兩西에 比하면 構造가 整齊하다.”]을 짓고 살더라도 #ruby("서|재","書|齋")는 반드시 기와집으로 지었고, 그#ruby("외","外") 동네에는 #ruby("도|청","都|廳")이 있었다. #ruby("도|청","都|廳")은 동네 #ruby("공|용|가|옥","公|用|家|屋")으로 #ruby("비|교|적","比|較|的") 크고 #ruby("화|려","華|麗")하게 지어, 그 집에 모여 놀기도 하고, 이야기#ruby("책","冊")도 보고, 짚신도 삼곤 했다. 동네 뉘 집에나 손님이 오면 #ruby("식|사","食|事")를 #ruby("대|접","待|接")하여 #ruby("도|청","都|廳")에서 자고 쉬게 했고, #ruby("무|전|객","無|錢|客")이 와서 자고 가기를 #ruby("청","請")하면 #ruby("도|청","都|廳")의 #ruby("공|금","公|款")으로 #ruby("음|식","飮|食")을 #ruby("대|접","待|接")하는 #ruby("규|례","規|例")가 있었다. 또 #ruby("오|락|기|구","娛|樂|器|具")로는 북·장구·꽹과리·퉁소 #ruby("등","等")을 #ruby("비|치","備|置")하여 두고, 동네사람들이 #ruby("종|종","種|種") 모여 즐기기도 하고 손님을 #ruby("위|로","慰|勞")하기도 하는 #ruby("미|풍|양|속","美|風|良|俗")이 있었다.]
#zh[咸镜道最值得称道的是当地教育比黄海道、平安道普及。即使在只有茅草房子的贫穷的村子里，书院及道厅都是瓦房。]
#zh[所谓“道厅”是村里公用的建筑，比一般的住房稍大而华丽些。人们平日在这里集会商讨村里公事，也在这里捻绳子，编草鞋，讲故事。又如某家有客人来，只须招待饮食，住宿却在“道厅”内，如果遇到了一文不名的过往旅客，规定由“道厅”供给膳宿，还备有鼓、长鼓、小锣、策等乐器，村民们常集会娱乐，也以此酬劳来客。这些制度都颇值得借鉴。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("홍|원","洪|原") 어떤 큰 동네의 #ruby("서|재","書|齋")를 #ruby("방|문","訪|問")했는데, #ruby("건|물","建|物")이 크고 #ruby("웅|장","雄|壯")한데다 #ruby("교|사","敎|師")가 세 사람 있었다. #ruby("고|등|교|사","高|等|敎|師") 한 사람은 #ruby("학|생","學|生") 가운데 #ruby("경|서|반","經|書|班")을 혼자 맡아 가르치고, 그 다음은 #ruby("중|등|과","中|等|科")를, 그 다음은 #ruby("유|치|반","幼|稚|班")을 #ruby("분|담","分|擔")하여 가르치는데, #ruby("대|청","大|廳") #ruby("좌|우","左|右")에 북과 #ruby("징","錚")을 매달고, 북을 치면 #ruby("학|생","學|生")들이 #ruby("독|서","讀|書")를 #ruby("시|작","始|作")하고, 징을 치면 #ruby("독|서","讀|書")를 #ruby("파","罷")하는 #ruby("기|발","奇|拔")한 #ruby("방|법","方|法")을 쓰고 있었다.]
#zh[在洪原境内的某一书院有三位老师，书院分为高、中、初三班。由这三位老师分别任教，这在旧书院里面是很稀罕的事。在书院两边挂有鼓和钟，鼓一响就开始上课，一敲钟就下课。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("함|흥","咸|興")에 #ruby("도|착","到|着")하여 #ruby("조|선","朝|鮮")에서 #ruby("제|일","第|一") 큰 나무다리인 #ruby("남|대|천","南|大|川")다리#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("함|흥","咸|興") #ruby("만|세|교","萬|歲|橋")를 말한다.]를 지났다. #ruby("남|대|천","南|大|川")의 #ruby("수|심","水|深")은 장마 때를 #ruby("제|외","除|外")하고는 #ruby("대|개","大|槪") 옷을 걷어올리고 건너갈 만한 깊이인데, 가장 넓은 곳의 #ruby("폭","幅")은 그 다리와 거의 같은 #ruby("약","約") 5#ruby("리","里") #ruby("거|리","距|離")였다. #ruby("김|병|연","金|炳|淵")#footnote(numbering: _ => [11)])[#h(0.35em)#ruby("김|병|연","金|炳|淵")\(1807〜1863)은 #ruby("조|선|시|대","朝|鮮|時|代")의 #ruby("방|랑|시|인","放|浪|詩|人"). #ruby("별|호","別|號")는 김삿갓 또는 #ruby("김|립","金|笠"). 그의 #ruby("시","詩")는 #ruby("풍|자","諷|刺")와 #ruby("해|학","諧|謔")을 담고 있으며, #ruby("전|통|적","傳|統|的")인 #ruby("한|시","漢|詩")의 #ruby("권|위","權|威")에 대해 #ruby("도|전","挑|戰")하는 #ruby("파|격|적","破|格|的")인 것이 많다. 『#ruby("김|립|시|집","金|笠|詩|集")』이 있다.]이 읊었다는 「#ruby("남|대|천|시","南|大|川|詩")」에 이런 #ruby("구|절","句|節")이 있는데,]
#zh[抵达咸兴，渡过了朝鲜第一大木桥南大川桥。南大川的水深，除了雨季之外，大抵撩起衣裳便可涉过，最宽处几乎与那座桥相等，约有五里。金炳渊所咏的《南大川诗》里有这样的句子：]
#quote-block[산은 들이 좁을까 저어하여 저 멀리 솟아 #ruby("있고","山疑野狹遠遠立")]
#zh[“山怕原野狭窄，远远地耸立着；”]
#quote-block[물은 배 가는 것이 두려워 얕게도 흐르는구나. (水畏舟行淺淺流)#footnote(numbering: _ => [12)])[#h(0.35em)#ruby("원|문","原|文"): “山疑野窄超超立/水恐舟行淺淺流”. 김삿갓 #ruby("시","詩")의 #ruby("원|문","原|文")과 #ruby("대|비","對|比")하면 『#ruby("백|범|일|지","白|凡|逸|志")』는 ‘窄超超’ ‘恐’ #ruby("등","等") 네 글#ruby("자","字")가 틀린다.]]
#zh[“水怕舟船通行，浅浅地流着。”]
#figure-block("/images/p66.jpg", caption: [#ruby("함|흥","咸|興") #ruby("남|대|천","南|大|川")의 #ruby("만|세|교","萬|歲|橋")])
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[사람들이 이 #ruby("구|절","句|節")을 가리켜 #ruby("명|작","名|作")이라 하였다.]
#zh[人们称这两句为名作。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 다리를 지나가니 #ruby("조|선","朝|鮮")의 4#ruby("대","大") 큰 #ruby[물건][四大物] #ruby("중","中") 하나인 장승#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("원|주","原|註"): “木製人像이니 頭에 紗帽를 쓰고, 面에 赤色으로 染하고, 눈을 부릅뜨고 威嚴이겟 製造한 것”. 장승에는 #ruby("인|면|형","人|面|形")·#ruby("귀|면|괴|수|형","鬼|面|怪|獸|形")·#ruby("미|륵|형","彌|勒|形")·#ruby("남|근|형","男|根|形")·#ruby("문|무|관|형","文|武|官|形") #ruby("등","等")이 있다. #ruby("백|범","白|凡")이 본 #ruby("함|흥","咸|興")장승은 #ruby("인|면|형","人|面|形") 장승이다. #ruby("인|면|형","人|面|形")의 #ruby("경|우","境|遇") #ruby("남","男")장승은 머리에 #ruby("관","冠")을 쓰고 눈을 부릅뜨고 덧니와 #ruby("수|염","鬚|髥")을 달고 있는 #ruby("형|상","形|狀")이며, 더러는 몸체에 붉은#ruby("색","色")을 #ruby("칠","漆")하기도 한다. #ruby("반|면","反|面") #ruby("여","女")장승에는 #ruby("관","冠")이 없으며 얼굴에 #ruby("연|지","臙|脂")와 곤지를 찍고 몸체를 #ruby("청|색","靑|色")으로 #ruby("칠","漆")하기도 한다.] 네 개가 #ruby("좌|우","左|右") 길가에 마주보고 서 있었다. #ruby("조|선","朝|鮮")의 #ruby("사|대|물","四|大|物")이라 함은 #ruby("경|주","慶|州")의 #ruby[인경][鍾]#footnote(numbering: _ => [14)])[#h(0.35em)#ruby("통|일|신|라|시|대","統|一|新|羅|時|代") 만들어진 #ruby("성|덕|대|왕|신|종","聖|德|大|王|神|鐘"). #ruby("속|칭","俗|稱") ‘에밀레종’이라 한다.]과 #ruby("은|진","恩|津") #ruby("미|륵","石|佛"),#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("충|남","忠|南") #ruby("논|산|군","論|山|郡") #ruby("은|진|면","恩|津|面") #ruby("관|촉|사","灌|燭|寺")에 있는 #ruby("석|조|미|륵|보|살|입|상","石|造|彌|勒|菩|薩|立|像"). 이에 관한 여러 가지 #ruby("영|험|담","靈|驗|談")과 #ruby("설|화","說|話")가 #ruby("전","傳")한다.] #ruby("연|산","連|山")의 #ruby[쇠솥][釜], #ruby("함|흥","咸|興")의 장승을 이르는 것이다. #ruby("이|태|조","李|太|祖")가 세웠다는 #ruby("함|흥","咸|興")의 #ruby("낙|민|루","樂|民|樓")도 구경하였다.#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("함|흥","咸|興")은 #ruby("조|선|왕|조","朝|鮮|王|朝")의 #ruby("발|상|지","發|祥|地")로서, #ruby("조|선","朝|鮮") #ruby("태|조","太|祖") #ruby("이|성|계","李|成|桂")와 #ruby("관|련","關|聯")된 #ruby("유|적|지","遺|蹟|地")가 많다.]]
#zh[过了那座桥，看见朝鲜四大物之一的长柱①。这长柱系大木材上面刻头像，头上戴了丝帽，脸上涂了红漆，瞪着眼，极其威严。四个这种木雕成双地分别矗立在路旁，左右相对。所谓朝鲜四大物，是指庆州的大钟、恩津的石佛、连山的铁锅和咸兴的长柱。]
#zh[译注：路碑。]
#zh[咸兴的“乐民楼”系李太祖所建造，仍然保存得很完整。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("북|청","北|靑")은 #ruby("산","山") 속에 있는 큰 #ruby("읍","邑")으로, 이곳 사람들은 예로부터 #ruby("과|거","科|擧")에 #ruby("열|심","熱|心")이었다. 그 #ruby("결|과","結|果") #ruby("군|내","郡|內")에 #ruby("생|존","生|存")해 있는 #ruby("진|사","進|士")가 30#ruby("여","餘") #ruby("명","名")이요, #ruby("급|제|자","及|第|者")가 7#ruby("명","名")이나 된다고 하였다. #ruby("남|대|천","南|大|川") #ruby("좌|우","左|右")에 솔대#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("원|주","原|註"): “進士를 한 사람은 大長木柱에 龍의 形像을 圖畵하고 木端에는 橫飛하는 龍體를 木刻하야 冠한 것이라.” 솔대는 ‘솟대’로 긴 나무 장대에 여러 가지 #ruby("모|양","模|樣")을 해서 #ruby("숭|배","崇|拜")하는 것을 말한다. #ruby("지|역","地|域")에 따라 여러 가지 #ruby("종|류","種|類")가 있는데, #ruby("북|청","北|靑")의 솟대는 #ruby("과|거","科|擧")에 #ruby("급|제","及|第")한 #ruby("자","者")가 #ruby("자|기","自|己") #ruby("과|시","誇|示")와 #ruby("가|문","家|門")의 #ruby("행|운","幸|運")을 빌기 위해 집 앞이나 #ruby("조|상","祖|上")의 #ruby("산|소","山|所")에 세우는 것으로, 꼭대기에 #ruby("용","龍")을 새겨서 붉은 #ruby("칠","漆")을 한다.]가 #ruby("무|수","無|數")히 세워져 있는 것을 보았다. #ruby("가","可")히 #ruby("문|화|향","文|華|鄕")이라 부를 만했다.]
#zh[尤其是北青，这儿是咸镜道内最崇尚读书之地，当我经过此地时，现存的进士就有三十多人，大科及第的文官多达七人，真不愧为“文乡”，令人叹服。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("단|천","端|川") #ruby("마|운|령","摩|雲|嶺")을 넘어 #ruby("갑|산|군","甲|山|郡")에 이른 때가 #ruby("을|미|년","乙|未|年")\(1895) 7#ruby("월","月")#ruby("경","頃")이었다. #ruby("분|명","分|明")히 #ruby("산|중","山|中") 큰 #ruby("읍","邑")이었음에도 불구하고 #ruby("이|상","異|常")했던 것은 그 #ruby("지|역|내","地|域|內")의 #ruby("관|사","官|舍")를 #ruby("제|외","除|外")한 모든 집들의 지붕에 한결같이 푸른 풀이 #ruby("무|성","茂|盛")해 있다는 #ruby("점","點")이었다. 얼른 보기에 사람이 살지 않는 #ruby("황|폐","荒|廢")한 빈 마을과 같은 느낌이 들었다. 그것은 거기 말로 ‘봇껍질’이라 하는 것으로 지붕을 덮고 흙을 씌워놓아 풀씨가 날아와서 흙에 떨어져 #ruby("무|성","茂|盛")케 해놓았기 때문이었다. 그렇게 해놓으면 아무리 큰비가 와서 퍼부어도 흙이 씻겨 나가지 않는다고 한다. 그 봇나무는 #ruby("양|서|지|방","兩|西|地|方")에 있는 껍질 붉은 벚나무와는 #ruby("종|류","種|類")가 아주 다른 것이었다. #ruby("색","色")이 희고 #ruby("탄|력|성","彈|力|性")이 #ruby("강","强")해서 지붕을 덮을 때 반드시 조약돌이나 흙으로 눌러놓는데, 흙기와나 돌기와보다 오래 가고 무너지지 않는다고 한다. 또 그곳에서는 사람이 죽은 #ruby("후","後") #ruby("염|습","殮|襲")할 때에 봇껍질로 싼다고 하였다. 그렇게 하면 흙 속에서 #ruby("만","萬") #ruby("년","年")이 지나도 #ruby("해|골","骸|骨")이 흩어지지 않는다고 한다.#footnote(numbering: _ => [18)])[#h(0.35em)자작나무를 이 #ruby("지|역","地|域")에서는 봇나무라고 한다. #ruby("질","質")이 좋고 썩지 않으며 벌레가 먹지 않아서 #ruby("함|경|도","咸|鏡|道")와 #ruby("평|안|도","平|安|道") #ruby("산","山")골에서는 #ruby("영|궤","靈|机")를 만들기도 한다.]]
#zh[我们越过端川摩云岭，抵达甲山邑的时候，正当乙未年七月。此地令人惊奇的是除了官厅的屋顶是用瓦盖的以外，其他人家的屋顶上都长满了杂草，乍看像是无人居住的废墟，后来才知道屋顶是用桦树皮加土盖的，土上杂草丛生，因此下多大的雨，土也不会流失。桦树皮质料既白又平，坚硬耐用比瓦更好。还有一说，人死了用桦树皮包裹埋葬可历万年而骸骨不烂。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("혜|산|진","惠|山|鎭")에 이르러 #ruby("제|천|당","祭|天|堂")을 구경했다. 그곳은 #ruby("백|두|산","白|頭|山") 줄기가 #ruby("남","南")쪽으로 내달으며 #ruby("조|선","朝|鮮") #ruby("산|맥","山|脈")의 큰 줄기를 이루는 곳이다. #ruby("제|천|당","祭|天|堂") #ruby("주|련","柱|聯")에 이런 글이 있었다.]
#zh[惠山镇的“祭天堂”位于我国众山之祖的白头山麓，是古代皇帝派官祭山和祭天的地方，壁上悬有一副古联：]
#quote-block[#ruby("유|월","六|月")에도 눈 덮인 #ruby("산","山"), #ruby("백|두","白|頭")에 #ruby("운|무","雲|霧")가 #ruby("감돌고","六月雪色山 白頭而雲霧")]
#zh[“六月雪色山，白头而云雾，]
#quote-block[#ruby("만|고","萬|古")를 소리쳐 흐르는 물, #ruby("압|록","鴨|綠")에 용솟음친다. (萬古流聲水 鴨綠而洶湧)#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("원|문","原|文"): “六月雪色은 山白頭而雲霧/萬古流聲水 鴨而洶湧”. #ruby("갑|산","甲|山") #ruby("동|인|촌","同|仁|村")에 ‘#ruby("백|두|산|령|신|지|위","白|頭|山|靈|神|之|位")’를 모시는 #ruby("제|향|당","祭|享|堂")이 있고, #ruby("혜|산","惠|山")에서 #ruby("동|남|방","東|南|方") 2km #ruby("지|점","地|點")에 #ruby("국|사|당","國|師|堂")이 있다. 『#ruby("노|정|약|기","路|程|略|記")』에 #ruby("의","依")하면 위 #ruby("주|련","柱|聯")의 #ruby("한|시","漢|詩")는 #ruby("국|사|당","國|師|堂")에 있다. 아마도 #ruby("백|범","白|凡")은 #ruby("제|향|당","祭|享|堂")과 #ruby("국|사|당","國|師|堂")을 #ruby("혼|돈","混|沌")하였던 것 같다. 그리고 #ruby("원|문","原|文")의 #ruby("한|시","漢|詩") #ruby("구|절","句|節")에도 #ruby("약|간","若|干")의 #ruby("착|오","錯|誤")가 있다.]]
#zh[万古流声水，鸭绿而汹涌。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[해마다 #ruby("조|정","朝|廷")에서는 #ruby("제|천|당","祭|天|堂")에 #ruby("관|리","官|吏")를 보내 #ruby("백|두|산","白|頭|山") #ruby("신|령","神|靈")에게 #ruby("제|사","祭|祀")를 올린다고 한다.]
#zh[据说每年朝廷都派遣官吏到祭天堂，向白头山神灵致祭。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("혜|산|진","惠|山|鎭")에서는 #ruby("압|록|강","鴨|綠|江") 건너#ruby("편","便")의 #ruby("중|국|인","中|國|人") #ruby("민|가","民|家")에서 개 짖는 소리까지 다 들렸고, #ruby("압|록|강","鴨|綠|江")도 걸어서 건너다녔다. 거기서 #ruby("백|두|산","白|頭|山")으로 가는 길을 물으니 #ruby("서|대|령","西|大|嶺")을 넘어서 간다 했다. #ruby("삼|수|군","三|水|郡")으로, #ruby("장|진|군","長|津|郡")으로, #ruby("후|창|군","厚|昌|郡")으로, #ruby("자|성|군","慈|城|郡") #ruby("중|강","中|江")을 건너, #ruby("중|국","中|國")땅인 #ruby("모|아|산","帽|兒|山")에 #ruby("도|착","到|着")하였다.]
#zh[行经惠山镇，此地濒临鸭绿江，可以瞭望隔岸的东北，可听到彼岸的犬吠声，由这里可以赤足渡过。]
#zh[我们走上去白头山的路，越过西大岭、三水、长津、厚昌，渡过慈城的中江，抵达中国领土帽儿山。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|상","以|上") 여러 #ruby("군","郡")을 지나는 길은 #ruby("험|산|준|령","險|山|峻|嶺") 아닌 곳이 없고, 어떤 곳은 70〜80#ruby("리","里")나 사람이 살지 않는 곳도 있어, 아침에 미리 #ruby("점|심","點|心")밥을 싸 가지고 간 적도 있다. #ruby("산","山")길이 극히 #ruby("험|악","險|惡")하였으나 #ruby("맹|수","猛|獸")는 #ruby("별","別")로 없었고, #ruby("삼|림","森|林")이 빽빽하여 #ruby("지|척","咫|尺")을 #ruby("분|별","分|別")키 어려웠다. 나무들 #ruby("중","中")에 큰 것은 밑동 하나를 벤 그루터기 위에 7, 8#ruby("명","名")이 돌아앉아 밥을 먹을 #ruby("정|도","程|度")라고 하였다. 내가 보기에도 나무 한 개를 찍어 넘기고, 그 나무를 #ruby("절|단","切|斷")하여 #ruby("곡|식","穀|食") #ruby("저|장","貯|藏")하는 #ruby("통","筒")을 파는데, #ruby("장|정","壯|丁")이 나무#ruby("통","筒") 안에 서서 도끼질하는 것을 보았다.]
#zh[一路上所经过的山岭异常险峻，更有些地方是七八十里内渺无人烟，行路人必须携带干粮。山岭虽然险峻，可是野兽不多，森林密布，不能辨别方向。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[또 이#ruby("편","便") #ruby("산","山")꼭대기의 #ruby("노|목","老|木")이 쓰러져 건너#ruby("편","便") #ruby("산","山")꼭대기에 걸쳐 있는 것을 많이 보았는데, #ruby("행|인","行|人")들이 그 나무다리를 타면 굳이 깊은 #ruby("계|곡","溪|谷")으로 가지 않고도 건너갈 수 있었다. 우리도 나무를 타고 건너보았다. 마치 #ruby("신|선","神|仙")이 다니는 길인 듯싶었다.]
#zh[据说砍伐后的树墩，可以作为七八个人的餐桌那么大的并不稀罕，我还看到有个壮士跳进挖空的树墩，用斧子砍析当谷仓，还有的树在山巅上被砍倒后，倒在另一个山头，竟可以做为山峰之间的桥梁，我们也走过了这种天然木桥。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("지|방","地|方")은 #ruby("인|심","人|心")이 #ruby("순|후","淳|厚")하고 먹을 것이 #ruby("풍|부","豐|富")해서 손님 오는 것을 매우 반가워하고 얼마든지 묵어가도록 해주었다. #ruby("양|식","糧|食")으로 #ruby("사|용","使|用")하는 #ruby("곡|식","穀|食")은 #ruby("대|개","大|槪")가 귀리와 감자고, #ruby("개|천","開|川")에는 ‘이면수’라는 물고기가 많이 있는데 맛이 참 좋았다. 사람들이 짐승 가죽으로 #ruby("의|복","衣|服")을 만들어 입는 것을 보면 #ruby("원|시|시|대","原|始|時|代") 그대로 #ruby("생|활","生|活")하는 것도 같았다. #ruby("삼|수|읍","三|水|邑") #ruby("성","城") 안팎에는 #ruby("민|가","民|家")가 30#ruby("여","餘") #ruby("호","戶") 있다고 하였다.]
#zh[当地人心地淳朴，热情好客，出产丰富，招待旅客非常周到。农作物大部分是燕麦和马铃薯，山溪中盛产一种名叫“李延寿”的鱼，其味鲜美。他们以兽皮为衣，看起来非常原始。三水邑内的人家仅有三十户。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("모|아|산","帽|兒|山")에서 #ruby("서|북","西|北")쪽으로 #ruby("노|인|치","老|人|峙")라는 고개를 넘고 또 넘어, #ruby("서|대|령","西|大|嶺") 가는 길로 접어들던 #ruby("도|중","途|中")에 우리 #ruby("동|포","同|胞")를 100#ruby("리","里")에 두어 사람씩 만나게 됐다. #ruby("대|부|분","大|部|分") #ruby("금","金") 캐는 사람들이었는데, 만나는 사람마다 #ruby("백|두|산","白|頭|山")에는 가지 말라고 말린다. #ruby("이|유","理|由")는 #ruby("서|대|령","西|大|嶺")을 넘는 #ruby("도|중","途|中")에 #ruby("향|마|적","嚮|馬|賊")이라는 #ruby("중|국|인","中|國|人") #ruby("도|적","盜|賊")떼가 숲 속에 숨어 있다가, 지나가는 사람들을 #ruby("총","銃")으로 쏘아 죽인 #ruby("후","後")에 #ruby("시|체","屍|體")를 뒤져서 #ruby("소|지|품","所|持|品")을 빼앗아 가는데, 요새도 우리 #ruby("동|포","同|胞")가 그같이 #ruby("피|살","被|殺")되었다는 것이다.]
#zh[从帽儿山向西北越过老人峙，在去西大岭约一百里的旅途上，我们先后碰上了两三位采金矿的同胞。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리 두 사람은 #ruby("상|의","相|議") 끝에 #ruby("백|두|산","白|頭|山") 가는 것을 그만두고 #ruby("통|화|현|성","通|化|縣|城")으로 갔다. #ruby("통|화|현|성","通|化|縣|城")은 세워진 지 오래 되지 않아서 #ruby("관|사","官|舍")와 #ruby("성|루|문","城|樓|門")의 서까래 나무가 아직 흰 빛을 띠고 있었다. #ruby("성","城") 안팎에 있는 집이 500#ruby("여","餘") #ruby("호","戶") #ruby("정|도","程|度") 된다고 하였다. 우리 #ruby("동|포","同|胞")는 #ruby("단","單") 한 집뿐인데, #ruby("남|자","男|子") #ruby("주|인","主|人")은 #ruby("변|발","辮|髮")에 #ruby("중|국","中|國") #ruby("복|장","服|裝")으로 #ruby("통|화|현","通|化|縣") #ruby("군|대","軍|隊")에서 #ruby("복|무","服|務")한다 하고, 아낙네들은 #ruby("전|부","全|部") #ruby("한|복","韓|服") 차림이었다. 이 사람은 #ruby("당|시","當|時") #ruby("명|칭","名|稱")으로 #ruby("호|통|사","胡|通|辭")#footnote(numbering: _ => [20)])[#h(0.35em)#ruby("만|주|어","滿|洲|語")를 #ruby("통|역","通|譯")하는 사람.]였다.]
#zh[他们告诉我们说，过西大岭，路上就有响马贼，他们隐伏山林，杀人越货，我同胞已有被杀害的，因此最好不要去白头山，我们只好遗憾地取消了参拜白头山之旅，取道前往通化县城。]
#zh[通化县城建设不久，官衙和城楼上的椽子尚呈白色。城内共有居民五百户，其中仅有一户是我国同胞。男的作中国人打扮，在县军队供职，而他的妻女都穿着我国服装。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("부|근","附|近") 10#ruby("리","里")쯤 되는 곳에 #ruby("심|생|원","沈|生|員")이라는 #ruby("동|포","同|胞")가 산다고 해서 찾아가 보았다. 겨우 글을 읽을 줄 아는 #ruby("자","者")로, #ruby("정|신","精|神") 없이 #ruby("아|편","阿|片")을 피워대서 몸에 뼈밖에 남지 않은 사람이었다.]
#zh[据说再过去十里有一位同胞叫沈生员，我们特地去拜访他，结果发现他虽粗通文字，却是个鸦片鬼，已经骨瘦如柴。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 곳들을 두루 다니는 #ruby("중","中")에 가장 밉게 보이는 것은 #ruby("호|통|사","胡|通|辭")들이었다. 이곳에 사는 우리 #ruby("동|포","同|胞")들은 #ruby("대|개","大|槪") #ruby("갑|오|년","甲|午|年") #ruby("난|리","亂|離")\(#ruby("청|일|전|쟁","淸|日|戰|爭"))를 #ruby("피|해","被|害") 낯설고 물설은 #ruby("외|국","外|國")으로 넘어와 #ruby("중|국","中|國")사람들이 살지 않는 #ruby("산","山")속 #ruby("험|악","險|惡")한 곳만 #ruby("택","擇")해서 #ruby("화|전","火|田")을 일구고 조와 강냉이 #ruby("농|사","農|事")를 지으며 살았다. 그런데 #ruby("호|통|사","胡|通|辭")들은 #ruby("중|국|어","中|國|語") 몇 마디 배워가지고 #ruby("중|국","中|國")사람에게 붙어서 #ruby("동|포","同|胞")들에게 #ruby("별|별","別|別") #ruby("무|리","無|理")한 #ruby("학|대","虐|待")를 다하는데, #ruby("여|자","女|子")들의 #ruby("정|조","貞|操")를 #ruby("유|린","蹂|躪")하고 돈과 #ruby("곡|식","穀|食")을 억지로 빼앗는 #ruby("등","等") 차마 입에 담지 못할 #ruby("악|행","惡|行")을 #ruby("허|다","許|多")히 #ruby("행","行")하였다. 나는 어떤 #ruby("중|국|인","中|國|人")의 집에서 우리 #ruby("한|복","韓|服")을 입고 머리를 땋은 #ruby("처|녀","處|女") 한 #ruby("명","名")이 살고 있는 것을 보았다. 남들에게 물어보니, 이 #ruby("처|녀","處|女")의 #ruby("부|모","父|母")가 사윗감을 #ruby("구","求")하고 있었는데, 이것을 눈치챈 #ruby("호|통|사","胡|通|辭")는 #ruby("중|국|인","中|國|人")에게 빚을 갚지 못하는 #ruby("대|신","代|身") 그 #ruby("처|녀","處|女")를 #ruby("중|매","仲|媒")해 주겠다고 #ruby("약|속","約|束")하고, #ruby("처|녀","處|女")의 #ruby("부|모","父|母")를 #ruby("위|협","威|脅")하여 #ruby("강|제","强|制")로 그 #ruby("중|국|인","中|國|人")에게로 보낸 것이라 했다.]
#zh[周游这一地区，遇到的人中最可恶的是一些“胡翻译”，学会了几句中国语，便专门欺凌可怜的同胞。许多同胞为了避甲午之乱，逃难到人地生疏的中国境内，选择中国人不能居住的险峻山谷开垦山田，种植小米或玉米苟延残喘，而这些所谓“胡翻译”，专门勾结中国人滋生事端，抢夺钱粮，蹂躏妇女，无所不为。]
#zh[我在一个中国人的家里发现了一个穿韩国衣服的年轻少女，据邻居说，她是中了“胡翻译”的奸计。她父母为她找婆家，被胡翻译看到，就为中国人做媒，以偿付债务为名，胁迫其父母，把她强行拉到中国人的家里来作抵押的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 돌아다닌 곳은 #ruby("통|화","通|化")·#ruby("환|인","桓|仁")·#ruby("관|전","寬|甸")·#ruby("임|강","臨|江")·#ruby("집|안","輯|安") #ruby("등","等")이었는데, 어디서나 똑같이 #ruby("호|통|사","胡|通|辭")의 #ruby("폐|해","弊|害")가 #ruby("심","甚")하였다. 그때에 #ruby("무|논","水|田")은 보지 못하였다. #ruby("본|래","本|來") 땅이 #ruby("비|옥","肥|沃")하여 #ruby("잡|곡","雜|穀")은 무엇이나 #ruby("비|료","肥|料")를 주지 않아도 잘 되었다. 한 사람이 #ruby("농|사","農|事")를 지으면 열 사람이 먹어도 #ruby("족","足")할 #ruby("정|도","程|度")였다. #ruby("단","單") 한 가지 소금이 #ruby("제|일","第|一") #ruby("귀","貴")한 #ruby("물|건","物|件")이었다. 그 #ruby("지|역","地|域")에 들어오는 소금은 다 #ruby("의|주","義|州") #ruby("방|면","方|面")으로부터 물길로 #ruby("수|천","數|千") #ruby("리","里")씩 실려와서 #ruby("판|매","販|賣")되었다.]
#zh[通化、宽甸、临江、桓仁、辑安等地也都有“胡翻译”横行无忌。]
#zh[这地方虽无水田，但土壤肥沃，即使不施肥，一个人种地也可养活十个人。唯一缺乏的是食盐，必须从义州用船只逆水运来贩卖，因此价钱很贵。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[곳곳에 두세 집 #ruby("내|지","乃|至") 여남은 집까지 모여 #ruby("산|림","山|林")을 #ruby("개|척","開|拓")하고 오막살이를 짓고 #ruby("거|주","居|住")하는데, #ruby("인|심","人|心")이 극히 #ruby("순|후","淳|厚")하여 거기 말로 ‘앞대 나그네’#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("원|주","原|註"): “故國人이란 뜻”.]가 왔다 하면 무척 반가워들 하였다. 한 동네에 들어가면 제#ruby("각|기","各|其") 맞아들이고, #ruby("남|녀|노|소","男|女|老|少")가 모여서 #ruby("고|국","故|國") 이야기를 하라고 조르기도 하며, 이집 저집에서 다투어 #ruby("음|식","飮|食")을 #ruby("대|접","待|接")하였다.]
#zh[所到之处，都有我国同胞，少的两三家，多的有十多户，他们自居斗室，开山耕作。他们心地非常淳朴，见有从本国来的人，一律称作“南方的客人”，跟亲戚一样亲热，每家都争着款待。男女老幼闻讯成群而来，要求来客谈一些故国的消息。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그곳에 #ruby("이|주","移|住")한 사람들은 #ruby("대|부|분","大|部|分") #ruby("생|활|난","生|活|難")을 #ruby("피","避")하여 간 사람들이 많았다. #ruby("갑|오|년","甲|午|年") #ruby("청|일|전|쟁","淸|日|戰|爭") 때 #ruby("피|난","避|難")하여 건너간 집이 많았고, 드물게 #ruby("죄","罪")를 저지르고 #ruby("도|망","逃|亡")한 #ruby("자","者")들, #ruby("즉","卽") #ruby("전|국","全|國") #ruby("각|지","各|地")에서 #ruby("민|란","民|亂")을 일으켰던 #ruby("주|동|자","主|動|者")들, #ruby("공|금","公|金")을 #ruby("유|용","流|用")한 #ruby("평|안","平|安")·#ruby("함|경","咸|鏡") #ruby("양|도","兩|道")의 #ruby("이|속","吏|屬")들도 #ruby("간|혹","間|或") 있었다.]
#zh[他们大多数因生活困难，移居此地，也有不少是在中日战争时避难而来的，有的是在本国犯罪后逃出来的，其中也有在民变时当过“状头”的豪杰，也有亏空公款的平安、咸镜两道的官商。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("지|세","地|勢")로 말하면 #ruby("파|저|강","婆|猪|江") #ruby("좌|우","左|右")에 #ruby("설|인|귀","薛|仁|貴"),#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("당","唐")나라 #ruby("고|종","高|宗") 때의 #ruby("장|군","將|軍"). #ruby("고|구|려","高|句|麗")가 #ruby("멸|망","滅|亡")한 뒤 #ruby("평|양","平|壤")에 #ruby("설|치","設|置")된 #ruby("안|동|도|호|부","安|東|都|護|府")의 #ruby("도|호","都|護")로 #ruby("부|임","赴|任")하였다.] #ruby("연|개|소|문","泉|蓋|蘇|文")#footnote(numbering: _ => [23)])[#h(0.35em)#ruby("연|개|소|문","淵|蓋|蘇|文")\(?〜666). #ruby("천|개|소|문","泉|蓋|蘇|文")은 #ruby("연|개|소|문","淵|蓋|蘇|文")의 #ruby("중|국|문|헌|식","中|國|文|獻|式") #ruby("표|현","表|現"). #ruby("중|국|인","中|國|人")들은 #ruby("당","唐") #ruby("고|조","高|祖")의 이름이 ‘#ruby("이|연","李|淵")’이므로 ‘#ruby("연","淵")’#ruby("자","字")를 #ruby("피","避")해 ‘#ruby("천","泉")’ 또는 ‘#ruby("전","錢")’으로 #ruby("표|기","表|記")하였는데, 이 #ruby("영|향","影|響")으로 우리나라에서도 흔히 그렇게 #ruby("사|용","使|用")하였다. 멀리는 #ruby("김|부|식","金|富|軾")의 『#ruby("삼|국|사|기","三|國|史|記")』, 가까이는 #ruby("박|은|식","朴|殷|植")의 『#ruby("천|개|소|문|전","泉|蓋|蘇|文|傳")』이 그러하다.]의 #ruby("관|루","管|壘") #ruby("흔|적","遺|址")이 남아 있고, #ruby("도|처","到|處")에 #ruby("천|연","天|然")의 #ruby("요|새","要|塞")가 있었다. 그 #ruby("천|연","天|然") #ruby("요|새","要|塞")들은 한 사람이 막으면 #ruby("만","萬") 사람도 들어올 수 없는 곳이므로 #ruby("여|진","女|眞")·#ruby("금","金")·#ruby("요","遼")·#ruby("고|구|려","高|句|麗")의 #ruby("발|원|지","發|源|地")라 한다.]
#zh[从这一带的地势来看，婆猪江左右有薛仁贵、渊盖苏文的营垒遗址，到处都是一夫当关、万夫莫开的天险。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아마도 #ruby("관|전","寬|甸")에서였던 듯하다. 한 곳에 #ruby("비|각","碑|閣")이 있는데 #ruby("비|문","碑|文")에는 ‘#ruby("삼|국|충|신 |임|경|업|의|비","三|國|忠|臣 |林|慶|業|之|碑")’라고 새겨져 있었다. #ruby("근|처","近|處")에 있는 #ruby("중|국","中|國")사람들 #ruby("중","中") #ruby("병","病")든 사람이 있으면 이 #ruby("비|각","碑|閣")에 와서 낫게 해 달라고 비는 #ruby("풍|속","風|俗")이 있다고 했다.#footnote(numbering: _ => [24)])[#h(0.35em)#ruby("임|경|업","林|慶|業")\(1594〜1646). 그는 #ruby("철|저","徹|底")한 #ruby("친|명|배|청","親|明|排|淸") #ruby("정|신","精|神")으로 #ruby("일|관","一|貫")하다가 #ruby("명","明")나라와 #ruby("내|통","內|通")하였다는 #ruby("죄|명","罪|名")으로 #ruby("인|조","仁|祖")의 #ruby("친|국","親|鞫")을 받고 죽었다. #ruby("백|범","白|凡")의 #ruby("선|조","先|祖")인 #ruby("김|자|점","金|自|點")은 #ruby("임|경|업","林|慶|業")의 #ruby("후|원|자","後|援|者")였으나, 마지막에는 #ruby("자|신","自|身")이 #ruby("연|루","連|累")될까 봐 죽일 것을 #ruby("주|장","主|張")하였다. #ruby("임|장|군","林|將|軍")에 관한 이야기는 #ruby("소|설","小|說")이나 #ruby("전|기","傳|記"), #ruby("설|화","說|話")의 #ruby("형|태","形|態")로 #ruby("다|양","多|樣")하게 #ruby("민|간","民|間")에 #ruby("유|포","流|布")되었고, #ruby("무|속","巫|俗")에서는 #ruby("임|장|군","林|將|軍")을 가장 #ruby("위|세","威|勢") 있는 #ruby("신","神")으로 받들고 있다. 사람들은 그가 #ruby("잡|귀","雜|鬼")를 쫓고 #ruby("병","病")을 낫게 해주며, #ruby("수|명|장|수","壽|命|長|壽")와 #ruby("안|과|태|평","安|過|太|平")을 가져다 준다고 믿는다. #ruby("중|국","中|國") #ruby("관|전","寬|甸")에서 #ruby("임|장|군","林|將|軍") #ruby("숭|배","崇|拜")는 #ruby("한|국","韓|國") #ruby("무|속","巫|俗")의 #ruby("영|향","影|響")으로 보여진다.]]
#zh[金、辽、高句丽发祥地宽甸有林庆业将军的碑阁，碑上刻有“三国忠臣林庆业之碑”据说住在此地的中国人，生了病有向此碑拜祭的风俗。]
#figure-block("/images/p71.jpg", caption: [『#ruby("백|범|일|지","白|凡|逸|志")』에 #ruby("기|록","記|錄")돼 있는 #ruby("청|국|행|로","淸|國|行|路")])
#heading(level: 3)[#text(font: "KOPUSGo B")[2) #ruby("김|이|언","金|利|彦") #ruby("의|병","義|兵")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 #ruby("지|방","地|方")을 두루 돌면서 #ruby("수|소|문","搜|所|聞")하여 들어보니, #ruby("벽|동","碧|潼")사람 #ruby("김|이|언","金|利|彦")이 힘과 #ruby("용|기","勇|氣")가 남달리 뛰어나고 #ruby("학|식","學|識")도 #ruby("풍|부","豐|富")하다 하였다. 일찍이 #ruby("심|양|자|사","瀋|陽|刺|史")#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("자|사","刺|史")는 #ruby("중|국","中|國")의 #ruby("지|방|관|리","地|方|官|吏")로 #ruby("주","州")의 #ruby("지|사","知|事")에 #ruby("해|당","該|當")하지만, #ruby("당|시","當|時")에 이 #ruby("지|역","地|域")에 #ruby("자|사","刺|史")라는 #ruby("관|직","官|職")은 없었다. 그런데 #ruby("당|시","當|時") #ruby("심|양|지|역","瀋|陽|地|域")에서는 #ruby("연|왕","燕|王") #ruby("의|극|당|아","依|克|唐|阿")가 #ruby("유|력|자","有|力|者")로 #ruby("반|일|운|동","反|日|運|動")을 #ruby("후|원","後|援")하였다. 『#ruby("노|정|약|기","路|程|略|記")』에 #ruby("의","依")하면 #ruby("김|창|수","金|昌|洙")·#ruby("김|형|진","金|亨|鎭") #ruby("등","等")은 #ruby("중|국","中|國")의 힘을 빌리기 #ruby("위","爲")해 #ruby("연|왕","燕|王")에게 #ruby("상|소","上|疏")를 올렸고, #ruby("연|왕","燕|王")은 #ruby("서|경|장","徐|慶|璋")과 #ruby("의|논","議|論")하여 이들에게 #ruby("진|동|창|의|사","鎭|東|倡|義|使")라는 #ruby("직|위","職|位")를 주고 #ruby("지|원","支|援")을 #ruby("약|속","約|束")하였다.]가 그의 #ruby("용|력","勇|力")을 높이 사서 #ruby("준|마","駿|馬") 한 #ruby("필","匹")과 『#ruby("삼|국|지","三|國|志")』 한 #ruby("질","帙")을 주었고, #ruby("청","淸")나라 #ruby("고|급","高|級") #ruby("장|교","將|校")들에게도 #ruby("융|숭","隆|崇")한 #ruby("대|우","待|遇")를 받고 있다 하였다. 그가 지금 #ruby("청","淸")나라의 #ruby("원|조","援|助")를 받아서 #ruby("의|병","義|兵")을 일으키려고 #ruby("도|모","圖|謀")하고 있다는 이야기를 들었다.#footnote(numbering: _ => [26)])[#h(0.35em)여기서부터 『#ruby("백|범|일|지","白|凡|逸|志")』와 『#ruby("노|정|약|기","路|程|略|記")』의 #ruby("중|국","中|國") #ruby("기|행","紀|行")은 큰 #ruby("차|이","差|異")가 있다. 『#ruby("노|정|약|기","路|程|略|記")』의 1895#ruby("년","年") #ruby("중|국","中|國") #ruby("원|정","遠|征")은 「6〜7#ruby("월","月")의 1#ruby("차","次") #ruby("원|정","遠|征")」과 「9#ruby("월","月")의 2#ruby("차","次") #ruby("원|정","遠|征")」 두 #ruby("번","番")에 걸쳐 있다. #ruby("백|범","白|凡")과 #ruby("김|형|진","金|亨|鎭")이 #ruby("삼|도|구","三|道|溝") #ruby("김|이|언","金|利|彦") #ruby("부|대","部|隊")에 #ruby("합|류","合|流")하여 11#ruby("월","月") #ruby("초","初") #ruby("거|사","擧|事")하는 것은 2#ruby("차","次") #ruby("중|국","中|國") #ruby("원|정","遠|征")에서 돌아올 즈음일 것이다.]]
#zh[我们还得知在这地方，有位碧潼地方的人名叫金利彦，他勇力过人，学识丰富，沈阳刺史嘉许他的勇力，曾赠骏马一匹、《三国志》一套，还受到清朝高级将领隆重接待。获得清人之助，正图招募抗日义勇军。]
#figure-block("/images/p72.jpg", caption: [『#ruby("노|정|약|기","路|程|略|記")』에 #ruby("기|록","記|錄")돼 있는 #ruby("청|국|행|로","淸|國|行|路")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("여|하|간","如|何|間")에 찾아가 보기로 #ruby("상|의","相|議")하고 두 사람이, 때로는 헤어져서 때로는 함께 다니면서 #ruby("수|소|문","搜|所|聞")하여 #ruby("김|이|언","金|利|彦")의 #ruby("비|밀","祕|密") #ruby("주|소","住|所")를 알아내게 되었다. #ruby("강|계|군","江|界|郡") #ruby("서|문","西|門")인 #ruby("인|풍|루","仁|風|樓")#footnote(numbering: _ => [27)])[#h(0.35em)#ruby("관|서|팔|경","關|西|八|景")의 하나로서 #ruby("강|계|군","江|界|郡")의 #ruby("독|로|강","禿|魯|江")과 #ruby("북|천","北|川")이 #ruby("합|수","合|水")되는 곳에 있다.] 밖으로 80#ruby("여","餘") #ruby("리","里") 더 가서 #ruby("압|록|강","鴨|綠|江")을 건너면 그곳 사람들이 #ruby("보|통","普|通") #ruby("황|성","皇|城")이라 부르는 곳이 있는데, #ruby("부|근","附|近") 10#ruby("여","餘") #ruby("리","里") 되는 곳에 #ruby("삼|도|구","三|道|溝")라는 곳이 있었다. 그곳이 바로 #ruby("김|이|언","金|利|彦")의 #ruby("비|밀","祕|密") #ruby("주|소|지","住|所|地")였다.]
#zh[我们商量着，无论如何也要去找他。两人有时分头，有时同行，四处打听，终于打听到金利彦的秘密住所。从江界郡西门仁风楼再出去八十余里，渡过鸭绿江，那里的人通常称为皇城，附近十多里处有个地方叫三道沟，那便是金利彦的秘密住址。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|이|언","金|利|彦")을 찾아갈 때에는 두 사람이 같이 가는 것보다 서로 모르는 사람인 것처럼 따로 가기로 뜻을 모았다. #ruby("김|이|언","金|利|彦")의 사람됨도 #ruby("각|자","各|自") 알아보고, 참말 #ruby("의|병","義|兵")을 #ruby("거|사","擧|事")할 뜻이 있는지, #ruby("혹|시","或|是") 무슨 #ruby("술|책","術|策")이나 가지고 #ruby("백|성","百|姓")들을 꾀는 것은 아닌지, #ruby("각|자","各|自") #ruby("자|세","仔|細")히 #ruby("관|찰","觀|察")하자는 #ruby("의|도","意|圖")였다. 며칠 먼저 #ruby("김|형|진","金|亨|鎭")을 #ruby("유|람|객","遊|覽|客") #ruby("행|색","行|色")으로 꾸며 #ruby("출|발","出|發")케 하고, 나는 #ruby("김|이|언","金|利|彦")과 그를 따르는 사람들에 #ruby("대","對")해 #ruby("탐|지","探|知")할 #ruby("작|정","作|定")으로 참빗장수의 #ruby("행|색","行|色")을 하고 네댓새 뒤에 #ruby("출|발","出|發")하여 #ruby("남","南")쪽으로 #ruby("향","向")하였다.]
#zh[去找金利彦的时候，我们觉得与其两人同去，不如装作互不相识，分开走。各自看看他的为人，他究竟真有举义的意思，还是拿什么术策哄骗百姓，要各自仔细观察。于是让金亨镇先打扮成游客出发，我则打算探听金利彦和他手下的情形，扮作卖篦子的，四五天之后出发，向南而行。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[길을 가던 #ruby("중","中"), 하루는 #ruby("압|록|강","鴨|綠|江")을 한 100#ruby("여","餘") #ruby("리","里") 앞둔 곳에서 #ruby("홀|연","忽|然")히 #ruby("청","淸")나라 #ruby("무|관","武|官") 한 사람을 만나게 되었다. 그는 궁둥이에 #ruby("관|인","官|印")이 찍힌 말을 타고 머리에는 마라기#footnote(numbering: _ => [28)])[#h(0.35em)#ruby("만|주|족","滿|洲|族") #ruby("청","淸")나라의 #ruby("군|인","軍|人") #ruby("모|자","帽|子").]를 쓰고 #ruby("옥|로","玉|鷺")#footnote(numbering: _ => [29)])[#h(0.35em)갓머리에 다는 #ruby("옥","玉")으로 만든 #ruby("장|식|구","裝|飾|具"). 해오라기 #ruby("모|양","模|樣")이며 높은 벼슬아치나 #ruby("외|국","外|國")에 가는 #ruby("사|신","使|臣")이 #ruby("사|용","使|用")했다.]를 꽂고 #ruby("홍|사","紅|絲")를 드리우고 있었다.]
#zh[一天，走在离鸭绿江还有一百多里的路上，忽然遇见一位清国武官。他骑着一匹臀部盖有官印的马，头戴军帽，插着玉鹭，垂着红丝。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 덮어놓고 앞으로 나가서 말머리를 잡았다. 그 #ruby("무|관","武|官")은 곧 말에서 내렸다. 나는 #ruby("청","淸")나라 말을 알지 못했기 때문에 #ruby("항|상","恒|常") 품안에 「#ruby("취|지|서","趣|旨|書")」 한 #ruby("장","張")을 써서 간직하고 다녔다. 어쩌다가 #ruby("청","淸")나라 사람 가운데 #ruby("문|자","文|字") 아는 사람을 만나면 그 #ruby("취|지|서","趣|旨|書")를 내보이곤 했었는데, #ruby("청","淸")나라 #ruby("무|관","武|官")에게도 그것을 보여주었다. 그런데, 그 #ruby("무|관","武|官")은 글을 채 다 읽기도 #ruby("전","前")에 갑자기 길바닥에 털썩 주저앉더니 크게 소리내어 울음을 터뜨리는 것이었다. 나는 놀라서 붙들고 #ruby("이|유","理|由")를 물었다. 그 #ruby("무|관","武|官")은 글 가운데,]
#zh[我不管三七二十一，上前一把抓住马头，那武官随即下马。我不会清国话，所以身上常带一张《趣旨书》，偶尔遇见识字的清国人，便拿出来给他看，这次也拿给这位武官看了。他字还没有读完，忽然扑通坐在路上，放声大哭。我吃了一惊，抓住他问缘故。那武官指着文中的句子，]
#quote-block[#ruby("통|탄","痛|歎")할 바, 저 #ruby("왜|적","倭|敵")은 나와 함께 같은 #ruby("세|상","世|上")을 살 수 없는 #ruby("원|수","怨|讐")이다.]
#zh[“痛叹啊，那倭寇与我是不能同生在一个世上的仇敌。”]
#quote-block[(痛彼倭敵與我 不共戴天之讐)]
#zh[（痛彼倭敌与我不共戴天之仇）]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라는 #ruby("구|절","句|節")을 가리키며, 다시 나를 붙들고 #ruby("통|곡","痛|哭")했다.]
#zh[他指着这句，又抱住我痛哭。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그제야 나는 갖고 있던 #ruby("필|통","筆|筒")을 꺼내 #ruby("필|담","筆|談")을 #ruby("시|작","始|作")했다. 먼저 그 사람이 물었다.]
#zh[我这才取出笔筒，开始笔谈。他抑制住悲痛，先问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("일|본","日|本")이 어찌하여 그대의 #ruby("원|수","怨|讐")인가?”]
#zh[“日本何以是你的仇敌？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("일|본","日|本")은 #ruby("임|진|년","壬|辰|年")부터 #ruby("대|대","代|代")로 내려오는 #ruby("국|가","國|家")의 #ruby("원|수","怨|讐")일 뿐 아니라, 지난달에는 우리 #ruby("국|모","國|母")를 불살라 죽였기 때문이오.”#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("임|진|년","壬|辰|年")은 #ruby("임|진|왜|란","壬|辰|倭|亂")을, 지난달의 #ruby("국|모","國|母") #ruby("시|해","弑|害")는 1895#ruby("년","年") 8#ruby("월","月") 20#ruby("일","日") #ruby("명|성|왕|후","明|成|王|后") #ruby("시|해","弑|害") #ruby("사|건","事|件")을 #ruby("의|미","意|味")한다. 『#ruby("백|범|일|지","白|凡|逸|志")』로만 #ruby("추|적","追|跡")하면 #ruby("백|범","白|凡")이 #ruby("청|계|동","靑|溪|洞")을 떠나 #ruby("중|국","中|國")에 #ruby("도|착","到|着")한 뒤 한참 #ruby("후","後")에 #ruby("명|성|왕|후","明|成|王|后")가 #ruby("시|해","弑|害")되었다. 그런데도 #ruby("백|범","白|凡")이 이 #ruby("사|건","事|件")을 잘 알고 있는 것은 #ruby("약|간","若|干") #ruby("어|색","語|塞")하다. 『#ruby("노|정|약|기","路|程|略|記")』의 #ruby("기|록","記|錄")대로 #ruby("중|국","中|國") #ruby("원|정","遠|征")이 두 #ruby("번","番") 있었으며, #ruby("명|성|왕|후","明|成|王|后") #ruby("시|해","弑|害") #ruby("사|건","事|件") #ruby("이|후","以|後") 제2#ruby("차","次") #ruby("중|국","中|國") #ruby("원|정","遠|征")이 있었다고 보는 것이 #ruby("합|리|적","合|理|的")이다.]]
#zh[“日本从壬辰年以来，便是我国世代相传的仇敌，而且上个月还把我国母烧死了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("반|문","反|問")하였다.]
#zh[我反问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대가 #ruby("초|면","初|面")에 이같이 #ruby("통|곡","痛|哭")함은 무엇 때문이오?”]
#zh[“我们初次见面，你为何这般痛哭？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 지난 #ruby("갑|오|년","甲|午|年")에 #ruby("평|양","平|壤")싸움#footnote(numbering: _ => [31)])[#h(0.35em)1894#ruby("년","年") #ruby("청|일|전|쟁","淸|日|戰|爭") 때 #ruby("평|양","平|壤")에서는 #ruby("청|일|간","淸|日|間")에 #ruby("치|열","熾|烈")한 #ruby("공|방|전","攻|防|戰")이 있었다.]에서 #ruby("전|사","戰|死")한 #ruby("서|옥|생","徐|玉|生")의 아들#footnote(numbering: _ => [32)])[#h(0.35em)#ruby("원|주","原|註"): “名은 忘却”. 이 사람의 이름은 #ruby("서|경|장","徐|慶|璋")일 것이다. #ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에 #ruby("의","依")하면 그는 #ruby("김|창|수","金|昌|洙")에게 ‘#ruby("의|병|좌|통|령","義|兵|左|統|領")’이란 #ruby("직|함","職|銜")을 주며 #ruby("일|본","日|本")을 물리치기 #ruby("위","爲")해 #ruby("연|합","聯|合")할 것을 #ruby("약|속","約|束")한다.]이오. #ruby("강|계","江|界") #ruby("관|찰|사","觀|察|使")에게 #ruby("부|탁","付|託")하여 #ruby("부|친","父|親")의 #ruby("시|체","屍|體")를 찾아 달라고 #ruby("의|뢰","依|賴")하였는데, 그로부터 #ruby("전|갈","傳|喝")이 오기를 #ruby("부|친","父|親")의 #ruby("시|체","屍|體")를 찾아놓았으니 와서 #ruby("운|구","運|柩")해 가라 하였소. 그런데 가서 보니 #ruby("부|친","父|親")의 #ruby("시|체","屍|體")가 아니기에 이렇게 빈손으로 되돌아오는 길이오.”]
#zh[“我是去年甲午在平壤战役中阵亡的徐玉生之子。曾托江界观察使寻找父亲的遗体，他捎信来说遗体已经找到，让我去运柩。前往一看，并不是父亲，所以这样空着手回来。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("자|기","自|己") 집은 #ruby("금|주","錦|州")인데, #ruby("자|기","自|己") #ruby("부|친","父|親")은 집에서 기르던 #ruby("병|사","兵|士") 1,500#ruby("명","名") #ruby("중","中")에 1,000#ruby("명","名")을 #ruby("인|솔","引|率")하고 #ruby("출|전","出|戰")하였다고 한다. 그들 1,000#ruby("명","名")은 모두 #ruby("부|친","父|親")과 같이 #ruby("전|멸","全|滅")했고, #ruby("현|재","現|在") #ruby("자|기","自|己") 집에는 #ruby("군|인","軍|人") 500#ruby("명","名")이 남아 집을 지키고 있다고 했다. #ruby("재|산","財|産")은 매우 넉넉하고, #ruby("자|기","自|己") 나이는 서른 몇 살이며 #ruby("부|인","夫|人")은 몇 살이고 #ruby("자|녀","子|女")는 몇 #ruby("명","名")이라고 #ruby("상|세","詳|細")히 일러주었다.]
#zh[他详细地告诉我说：他的家是在锦州，家中养有一千五百名军士，他的父亲率领了一千名出征，已全军覆没，现在家中尚存五百名，家财富裕，他今年三十多岁，妻子××岁，已有几个子女。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 먼저 그에게 #ruby("평|양","平|壤") #ruby("보|통|문","普|通|門") 밖 들녘에서 #ruby("일|본","日|本")사람들이 세운 ‘#ruby("서|옥|생|전|망|처","徐|玉|生|戰|亡|處")’란 나무#ruby("비","碑")를 보았다고 말해 주었다.#footnote(numbering: _ => [33)])[#h(0.35em)『#ruby("노|정|약|기","路|程|略|記")』에 #ruby("의","依")하면 9#ruby("월","月") #ruby("중|국","中|國") 2#ruby("차","次") #ruby("원|정","遠|征")시 #ruby("평|양","平|壤") #ruby("모|란|봉","牡|丹|峰")의 #ruby("기|자|릉","箕|子|陵") 앞에서 「#ruby("왜|적|전|망|공|신|지|비","倭|賊|戰|亡|功|臣|之|碑")」를 #ruby("발|견","發|見")하고 #ruby("통|곡","痛|哭")한 #ruby("내|용","內|容")이 나오는데, 그것을 말하는지도 모르겠다.] 그는 나의 나이가 #ruby("자|기","自|己")보다 어리므로 나를 ‘띠디’(弟弟: 아우)라 부르고, 자기더러는 ‘꺼거’(哥哥: #ruby("형","兄"))라 부르라고 써 보였다. 그리고는 내가 짊어지고 있던 봇짐을 #ruby("자|기","自|己") 말#ruby("안|장","鞍|裝")에 달아매고 나를 붙들어 말 등에 올려 태우고 #ruby("금|주","錦|州")를 #ruby("향","向")해 채찍질을 하면서 언제까지든 #ruby("복|수","復|讐")할 때가 오기까지 #ruby("자|기","自|己") 집에 가서 같이 지내자고 하였다.]
#zh[我便告诉他在平壤普通门之外，曾看见过写着“徐玉生战死之地”的木牌。]
#zh[当他问过我的年纪后，才知道我比他年轻，他要称我为弟，并要我称他为兄，彼此结为兄弟。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("미|안","未|安")한 마음에 같이 걸어서 가기를 #ruby("청","請")하였다. 그러나 그는 걱정 말라고 하며 #ruby("불|과","不|過") 10#ruby("리","里")만 가면 #ruby("관|마","官|馬")를 잡아탈 수 있다고 하였다. 나는 말 위에서 곰곰이 생각했다. #ruby("서|씨","徐|氏")의 뜻을 보면 #ruby("장|래","將|來") #ruby("교|제","交|際")할 좋은 #ruby("기|회","機|會")가 되겠으니 같이 지내는 것이 극히 좋겠으나, 먼저 길을 떠난 #ruby("김|형|진","金|亨|鎭")에게 이 #ruby("사|실","事|實")을 알릴 길이 없었다. 또 #ruby("김|이|언","金|利|彦")이 #ruby("의|병","義|兵")을 일으킨다고 하니 #ruby("자|세","仔|細")한 #ruby("내|용","內|容")을 알고 싶은 생각이 앞섰으므로, #ruby("무|작|정","無|作|定") #ruby("금|주","錦|州")로 가서 #ruby("서|씨","徐|氏") 집에 머물러 있을 마음이 없었다. 말에서 내려 #ruby("서|군","徐|君")에게 물었다.]
#zh[他说我们既然有共同的敌人，可以住在一起等待机会，并且邀请我跟他回锦州去，还没有等我回答，他很快地卸下我的行李，挂在马背上，并扶我上马，他一个人走在后面跟着。我请求下马同走，他说不必考虑，只走十里，就可找到官马乘骑。]
#zh[在马上我沉思，这是多好的机会，我原来的目的就是要与中国人士结交，现在跟他结下缘分，亦算达成宿愿了，但顾虑的是无法跟金亨镇联络，加上金利彦举义，尚不知其内情，我无法跟他一起去锦州家。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보, 꺼거. 내가 #ruby("고|국","故|國")의 #ruby("부|모","父|母")를 #ruby("이|별","離|別")한 지 어느덧 1#ruby("년","年")이 지났지만 #ruby("소|식","消|息")을 알지 못하고 있고, 또 #ruby("왕|실","王|室")#footnote(numbering: _ => [34)])[#h(0.35em)#ruby("원|문","原|文"): “皇室”. #ruby("대|한|제|국","大|韓|帝|國")의 #ruby("황|제","皇|帝")로 #ruby("위|호","位|號")가 #ruby("격|상","格|上")되는 것이 1897#ruby("년","年")이기 때문에 #ruby("당|시","當|時")에는 ‘#ruby("왕|실","王|室")’이라고 했을 것이다.]에서 #ruby("변","變")을 당한 #ruby("후","後")에 나라 안의 #ruby("정|치","政|治") #ruby("상|황","狀|況")이 어떻게 #ruby("변","變")했는지도 모르고 있소. 내가 먼저 #ruby("고|국","故|國")으로 돌아가 #ruby("부|모","父|母")님께 #ruby("승|낙","承|諾")을 얻어 가지고 와서 떳떳이 꺼거와 함께 지내며 #ruby("장|래","將|來")를 #ruby("경|영","經|營")함이 어떻겠소?”]
#zh[“哥哥，我离别故国父母，转眼将近一年，音信不通。王室遭变之后，国内政治情形如何变化，我也不得而知。我想先回故国，得到父母允诺，再来堂堂正正地与哥哥同住，共图将来，如何？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|씨","徐|氏")는 #ruby("대|단","大|端")히 아쉬워하면서,]
#zh[徐氏十分不舍，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|생","同|生") #ruby("사|정","事|情")이 그러하다 하면 어쩔 수 없지. 어서 #ruby("속","速")히 #ruby("고|국","故|國")의 #ruby("부|모","父|母")를 뵌 #ruby("후","後") 다시 와서 만납시다.”]
#zh[“弟弟既有这般情形，也是无法。你快去拜见故国父母，然后再来相会。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고는 #ruby("재|삼","再|三") 눈물로써 #ruby("부|탁","付|託")하고 서로 #ruby("작|별","作|別")하였다.]
#zh[再三洒泪叮嘱，彼此分别。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[대엿새 #ruby("후","後") #ruby("삼|도|구","三|道|溝")에 #ruby("도|착","到|着")하였다. 이집 저집 #ruby("방|문","訪|問")하여 참빗장수로 #ruby("행|세","行|世")하면서 #ruby("김|이|언","金|利|彦")의 #ruby("동|정","動|靜")과 그 #ruby("부|하","部|下")들에 #ruby("대","對")해 알아보았다. #ruby("두|령","頭|領")인 #ruby("김|이|언","金|利|彦")은 일 벌이기를 좋아하는 #ruby("성|벽","性|癖")이 있는 만큼, #ruby("자|신|감","自|信|感")이 지나쳐 다른 사람의 #ruby("도|모","圖|謀")를 너그러이 받아들이는 #ruby("도|량","度|量")이 #ruby("부|족","不|足")해 보였다. #ruby("용|력","勇|力")은 #ruby("월|등","越|等")히 뛰어나서, #ruby("당|시","當|時") 나이 50#ruby("여","餘") #ruby("세","歲")에 #ruby("심|양","瀋|陽")에 있는 500#ruby("근","斤")짜리 #ruby("화|포","火|砲")를 가만히 앉은 자리에서 #ruby("양","兩")손으로 들어올렸다 내렸다고 한다.]
#zh[我仍是卖篦子的打扮，挨家打听金利彦的消息。与徐分别后约五六天，才抵达金利彦的根据地“三道沟”。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 나의 #ruby("관|찰","觀|察")로는 #ruby("진|정","眞|正")한 마음의 #ruby("용|기","勇|氣")는 #ruby("부|족","不|足")하지 않을까 하는 생각이 들었다. #ruby("김|이|언","金|利|彦")보다는 그의 #ruby("동|지","同|志")로서 #ruby("초|산","楚|山") #ruby("이|방","吏|房")을 지냈다는, #ruby("김|규|현","金|奎|鉉")이란 사람이 #ruby("의|리","義|理")도 있고 #ruby("계|책","計|策")도 잘 세우는 것 같아 보였다.]
#zh[我探听到金利彦当时有五十多岁，勇力过人，能双手举起五百斤的大炮，但好大喜功，无勇无谋，自大气量狭，据我的观察，他缺乏勇气。倒是他的同志中，曾在楚山做过“吏房”的金奎铉，为人颇有义气，且具谋略之才。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|이|언","金|利|彦")은 #ruby("의|병","義|兵") #ruby("운|동","運|動")의 #ruby("수|령","首|領")이 되어 #ruby("당|시","當|時") 많은 #ruby("의|병","義|兵")을 #ruby("모|집","募|集")하였다. #ruby("압|록|강","鴨|綠|江")을 사이에 두고 이쪽 #ruby("변|방","邊|方")으로는 #ruby("초|산","楚|山")·#ruby("강|계","江|界")·#ruby("위|원","渭|原")·#ruby("벽|동","碧|潼") #ruby("등","等")에서 몰래 #ruby("포|수","砲|手")를 #ruby("모|집","募|集")하였고, 저쪽 #ruby("변|방","邊|方")으로는 #ruby("청","淸")나라 #ruby("강","江") #ruby("근|처","近|處") #ruby("일|대","一|帶")에서 #ruby("이|주|민","移|住|民") #ruby("포|수","砲|手")#footnote(numbering: _ => [35)])[#h(0.35em)#ruby("원|주","原|註"): “家家 居半 獵銃이 有함.”]를 #ruby("모|집","募|集")하여 그 #ruby("수","數")가 #ruby("근","近") 300#ruby("명","名")이나 되었다. #ruby("의|병","義|兵")을 일으킨 #ruby("대|의|명|분","大|義|名|分")은 “#ruby("국|모","國|母")가 #ruby("왜|구","倭|寇")에게 #ruby("피|살","被|殺")된 것은 #ruby("국|민","國|民") #ruby("전|체","全|體")의 #ruby("치|욕","恥|辱")이니 가만히 앉아서 참고 있을 수 없다”는 것이었다.#footnote(numbering: _ => [36)])[#h(0.35em)#ruby("명|성|왕|후","明|成|王|后") #ruby("시|해","弑|害") #ruby("사|건","事|件")으로 일어난 #ruby("의|병","義|兵")을 #ruby("을|미|의|병","乙|未|義|兵"), 또는 그 #ruby("동|기","動|機")와 #ruby("목|적","目|的")을 #ruby("취","取")하여 ‘#ruby("복|수","復|讐")#ruby("의|병","義|兵")’이라고 한다.] 글을 잘 쓰는 #ruby("김|규|현","金|奎|鉉")으로 하여금 #ruby("격|문","檄|文")을 지어 뿌리게 했다.]
#zh[金利彦当了义兵首领，当时招募了许多义兵。鸭绿江这边边境，在楚山、江界、渭原、碧潼等地秘密招募炮手；对岸则在清国江边一带招募移民猎户，将近三百名。举义的大义名分是：“国母被倭寇杀害，是国民全体的耻辱，不能坐视忍耐。”让文章好的金奎铉作了檄文散发。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("의|병","義|兵")을 일으키는 #ruby("모|의","謀|議")에는 우리 두 사람도 #ruby("참|가","參|加")했다. 나는 #ruby("비|밀","祕|密")히 #ruby("강|계|성","江|界|城")에 들어가서 #ruby("화|약","火|藥")을 #ruby("매|입","買|入")하여 등에 지고 #ruby("압|록|강","鴨|綠|江")을 건너기도 했고, #ruby("초|산","楚|山")·#ruby("위|원","渭|原") #ruby("등|지","等|地")에 몰래 숨어 들어가 #ruby("포|수","砲|手")를 #ruby("모|집","募|集")하기도 했다.]
#zh[举义的谋议，我们两人也参加了。我秘密进入江界城，买了火药背着渡过鸭绿江，又潜入楚山、渭原等地招募炮手。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("거|사","擧|事")한 때는 #ruby("을|미|년","乙|未|年") 11#ruby("월","月") #ruby("초","初")였다. #ruby("압|록|강","鴨|綠|江")은 #ruby("대|부|분","大|部|分") #ruby("빙|판","氷|板")으로 얼어붙어 있었다. #ruby("삼|도|구","三|道|溝")에서 #ruby("행|군","行|軍")하여 얼음 위로 #ruby("강","江")을 건너 #ruby("강|계|성","江|界|城")까지 바로 들어갈 #ruby("계|획","計|劃")이었다.]
#zh[举事是在乙未年十一月初。鸭绿江大部分已经结成冰板。计划从三道沟行军，踏冰过江，直入江界城。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한#ruby("번","番")은 이런 일도 있었다. 내가 #ruby("위|원","渭|原")에서 일을 마치고 #ruby("책|원|지","策|源|地")인 #ruby("삼|도|구","三|道|溝")로 돌아오던 #ruby("중","中") 혼자서 얇은 얼음을 밟았다가 #ruby("강","江") 속에 빠진 적이 있었다. 몸은 물 속으로 빠져들어 가고, 겨우 머리와 #ruby("양","兩")손만 얼음 위에 남아 있는 #ruby("형|편","形|便")이 되었다. 죽을힘으로 솟아올라 #ruby("육|지","陸|地")에 #ruby("도|달","到|達")하였으나, 옷이 #ruby("삽|시|간","霎|時|間")에 얼음덩어리로 #ruby("변","變")하여 한 발자국도 움직이기 어려운 #ruby("지|경","地|境")이 되었다. #ruby("익|사","溺|死")는 겨우 #ruby("면","免")하였으나, #ruby("동|사","凍|死")를 #ruby("면","免")하기 어려운 #ruby("상|황","狀|況")이었다. #ruby("시|간","時|間")을 다투던 그때 내 #ruby("고|함","高|喊")소리를 들은 #ruby("산","山")골짜기 동네사람이 나와서 #ruby("자|기","自|己") 집으로 끌고 가 #ruby("구|호","救|護")하여 준 #ruby("덕|분","德|分")에 겨우 살 수 있었다.]
#zh[我完成了在渭原的工作后，在回到三道沟的途中，正渡过鸭绿江时，由于踏着薄冰失足陷入江中，全身都掉在水里，只剩两只手臂扒在冰窟窿边，我竭尽全力，好容易爬了上来，但被水浸透的湿衣立即冻成了冰块，寸步难移。虽幸免于淹死，却可能被冻死，我只有大声喊救命。后来被听到喊声的村民们救出抬到家里，这才保住一条命。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|이|언","金|利|彦")에게 #ruby("강|계","江|界")로 들어갈 #ruby("계|책","計|策")을 물었더니, 이미 #ruby("강|계","江|界") #ruby("병|영","兵|營")에 있는 #ruby("장|교","將|校")들과 #ruby("내|응","內|應")해 두었으니 #ruby("성","城")에 들어가는 것은 #ruby("문|제","問|題")가 없다 하였다.]
#zh[我问金利彦进入江界的计策，他说已经和江界兵营的将校约好内应，入城不成问题。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 그 #ruby("장|교","將|校")들이 #ruby("순|수","純|粹")한 #ruby("애|국|심","愛|國|心")으로 #ruby("내|응","內|應")하는 것입니까? 아니면 다른 #ruby("이|유","理|由")가 있습니까?”]
#zh[“那么那些将校是出于纯粹的爱国心来内应呢，还是另有缘故？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|이|언","金|利|彦")은 아래와 같이 #ruby("답","答")하였다.]
#zh[金利彦回答如下：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 이미 #ruby("심|양","瀋|陽")에 가서 #ruby("인|명","仁|明") #ruby("노|야","老|爺")#footnote(numbering: _ => [37)])[#h(0.35em)#ruby("노|야","老|爺")는 ‘어르신’ ‘나리’라는 뜻의 #ruby("중|국","中|國")말. #ruby("인|명","仁|明")은 #ruby("고|유|명|사","固|有|名|詞")인지 #ruby("형|용|사","形|容|詞")인지, 또 누구를 가리키는지 #ruby("불|명|확","不|明|確")하다.]와 #ruby("친","親")하고 그가 #ruby("하|사","下|賜")하는 말까지 받은 일을 이 #ruby("장|교","將|校")들이 알고 있소. 그러니 언제나 #ruby("청","淸")나라 #ruby("군|사","軍|士")들의 #ruby("응|원","應|援")만 받아오면 그들이 다 같이 #ruby("행|동","行|動")해 주겠다고 굳게 #ruby("약|속","約|束")하였소. 그런 까닭에 #ruby("성","城")에 들어가는 일은 매우 쉬운 일이오.”]
#zh[“我已经到过沈阳，和仁明老爷亲近，还领受了他赏的马，这些将校都知道。所以他们坚定约定，只要一得到清国军士的声援，便一齐行动。因此入城是很容易的事。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 또 물었다.]
#zh[我又问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 #ruby("청","淸")나라 #ruby("군|사","軍|士")들을 이번에 #ruby("다|소|간","多|少|間")이라도 #ruby("사|용","使|用")케 됩니까?”]
#zh[“那么这次多少能用上清国的军士吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이번에는 안되지만, 우리가 #ruby("거|사","擧|事")하여 #ruby("강|계","江|界")를 #ruby("점|령","占|領")하면 #ruby("원|병","援|兵")이 온다고 하였소.”]
#zh[“这一次还不行。不过说，我们一起事、占领了江界，援兵就会来。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리고 우리가 #ruby("모|집","募|集")한 #ruby("포|수","砲|手")들의 #ruby("복|장","服|裝") #ruby("문|제","問|題")가 나와서 나는 이런 #ruby("의|견","意|見")을 #ruby("주|장","主|張")하였다.]
#zh[接着又谈到我们所募炮手的服装，我主张道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("포|수","砲|手") #ruby("중","中")에 #ruby("청","淸")나라 말을 잘 하는 사람이 많으니, 그#ruby("중","中") 몇#ruby("십","十") #ruby("명","名")에게 #ruby("청|병","淸|兵") #ruby("장|관","將|官")의 옷을 입혀 #ruby("청","淸")나라 #ruby("장|교","將|校") #ruby("혹","或")은 #ruby("대|장","大|將")으로 꾸밉시다. 그리고 그 나머지는 #ruby("한|복","韓|服")을 입혀 #ruby("후|방","後|方")에 따르게 합시다. #ruby("선|두","先|頭")에는 #ruby("심|양","瀋|陽") #ruby("자|사","刺|史")로부터 #ruby("하|사","下|賜")받은 말을 타게 하고, #ruby("청","淸")나라 #ruby("장|교","將|校")로 꾸민 #ruby("군|인","軍|人")에게 긴 칼을 차게 해서 #ruby("선|두","先|頭")에 #ruby("입|성","入|城")케 함이 좋은 #ruby("계|책","計|策")일까 합니다. #ruby("이|유","理|由")는, #ruby("강|계|성","江|界|城") #ruby("장|교","將|校")들이 #ruby("내|응","內|應")한다는 것을 #ruby("순|전","純|全")히 믿기 어렵기 때문입니다. 그 사람들은 #ruby("단|지","但|只") #ruby("청","淸")나라 #ruby("군|사","軍|士")들이 오면 그것을 보고 #ruby("내|응","內|應")하겠다는 것이지, #ruby("의|리|상","義|理|上") #ruby("내|응","內|應")한다는 것이 아닙니다. 그러니 #ruby("만|약","萬|若") 우리에게서 #ruby("청|병","淸|兵")의 그림자도 보이지 않으면 #ruby("정|세","情|勢")는 #ruby("세|부|득|이","勢|不|得|已") #ruby("반|대","反|對") #ruby("방|향","方|向")으로 가고 말 것입니다.”]
#zh[“炮手之中会说清国话的人很多，挑出几十名，穿上清兵将官的衣服，装成清国将校或大将。其余的穿上韩服跟在后面。前头让人骑上沈阳刺史所赐的马，给扮作清国将校的军人佩上长刀，让他们首先入城，这才是好计。因为江界城将校的内应不能完全相信。他们只是说看见清国军士来了才肯内应，并不是出于义理。倘若在我们这边连清兵的影子也看不见，形势势必走到反面去。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|이|언","金|利|彦")은 제1#ruby("착","着")으로 #ruby("고|산|진","高|山|鎭")#footnote(numbering: _ => [38)])[#h(0.35em)#ruby("원|주","原|註"): “거긔 말노 고사리”.]을 쳐서 #ruby("무|기","武|器")를 #ruby("탈|취","奪|取")한 다음, 제2#ruby("차","次")로 그 #ruby("무|기","武|器")를 가지고 #ruby("강|계","江|界")를 #ruby("공|격","攻|擊")한다는 #ruby("계|책","計|策")을 세웠다. 그러나 나는 그것 #ruby("역|시","亦|是") #ruby("불|가","不|可")한 일임을 #ruby("역|설","力|說")하였다. #ruby("이|유","理|由")는 다음과 같았다.]
#zh[金利彦以第一着先打高山镇，夺取武器，第二步再用那些武器攻江界。我力说这也不可。理由如下：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“지금 우리에게 300#ruby("여","餘") #ruby("명","名")의 #ruby("포|수","砲|手")가 있으니, 이 #ruby("병|력","兵|力")만 가지고 #ruby("질|풍|뇌|우","疾|風|雷|雨")의 #ruby("형|세","形|勢")로 힘차게 #ruby("돌|진","突|進")해 들어가면 #ruby("충|분","充|分")히 #ruby("성","城")을 #ruby("점|령","占|領")할 수 있습니다. #ruby("선|발|대","先|發|隊")의 #ruby("수|효","數|爻")가 비록 적긴 하여도 저쪽에서는 우리 뒤에 얼마나 많은 #ruby("병|력","兵|力")이 있는지 모를 것이니, #ruby("충|분","充|分")히 이길 수 있을 것입니다.”]
#zh[“现在我们有三百多名炮手，只凭这支兵力，以疾风雷雨之势猛冲进去，充分可以占领城池。先发队人数虽少，对方不知我们后面还有多少兵力，必可取胜。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|규|현","金|奎|鉉")과 #ruby("경|성","京|城")사람 #ruby("백|진|사","白|進|士") #ruby("등","等")은 다 내 #ruby("의|견","意|見")에 #ruby("찬|동","贊|同")하였다. 그러나 #ruby("본|래","本|來") #ruby("성|격","性|格")이 #ruby("독|단|적","獨|斷|的")인 #ruby("김|이|언","金|利|彦")은 두 가지 #ruby("이|유","理|由")로 #ruby("반|대","反|對")하였다.]
#zh[金奎铉和京城人白进士等都赞成我的意见。可是生性独断的金利彦以两个理由反对。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째, #ruby("청|군","淸|軍") #ruby("복|장","服|裝")과 #ruby("청|군","淸|軍") #ruby("장|교","將|校")로 #ruby("가|장","假|裝")하는 것은 옳지 않은 일이다. 우리가 #ruby("당|당","堂|堂")하게 #ruby("국|모","國|母") 죽인 #ruby("원|수","怨|讐")를 갚기로 한 #ruby("이|상","以|上") #ruby("당|연","當|然")히 #ruby("백|의|군|인","白|衣|軍|人")으로 #ruby("입|성","入|城")함이 옳다. 둘째, 아직 #ruby("군|인","軍|人")은 있으나 #ruby("무|기","武|器")가 #ruby("부|족","不|足")하니 먼저 #ruby("고|산|진","高|山|鎭")을 쳐서 #ruby("무|기","武|器")를 #ruby("탈|취","奪|取")해 가지고 다음날에 #ruby("강|계","江|界")를 #ruby("점|령","占|領")하는 것이 옳다는 것이었다.]
#zh[第一，假扮清军服装、装成清军将校，是不正当的。我们既要堂堂正正为国母之死复仇，自然应当以白衣军人入城。第二，眼下虽有军人，武器不足，应当先打高山镇夺取武器，次日再占领江界。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리 두 사람은 #ruby("김|이|언","金|利|彦")이 #ruby("고|집","固|執")하고 나가는 데 #ruby("대","對")해 끝까지 #ruby("반|대","反|對")하고 갈라서지는 말기로 하고 어찌되었든 따라가 보기로 하였다.]
#zh[我们两人虽然始终反对金利彦这样固执下去，却决定不和他分手，无论如何先跟着去看看。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[제1#ruby("착","着")으로 #ruby("야|간","夜|間")에 #ruby("고|산|진","高|山|鎭")을 #ruby("침|입","侵|入")하여 #ruby("무|기","武|器")를 #ruby("탈|취","奪|取")하고 빈손으로 #ruby("종|군","從|軍")하는 #ruby("자","者")들에게 #ruby("분|배","分|配")하였다. 다음날 #ruby("강|계","江|界")로 #ruby("진|군","進|軍")하여 #ruby("전|군","全|軍")이 한밤#ruby("중","中")에 얼음 위를 밟고 건너갔다. #ruby("인|풍|루","仁|風|樓") 밖 10#ruby("리","里") #ruby("가|량","假|量") 되는 곳에 #ruby("선|두","先|頭")가 #ruby("도|착","到|着")하자 #ruby("강","江")의 #ruby("남","南")쪽 기슭에 있는 소나무 숲 속에서 #ruby("화|승|총","火|繩|銃") 불빛이 반짝거리고 있었다. #ruby("강|계|대","江|界|隊") #ruby("소|속","所|屬") #ruby("장|교","將|校") 몇몇이 우리를 맞이하러 나와서 #ruby("김|이|언","金|利|彦")을 찾아서 물었다.]
#zh[第一着，夜间侵入高山镇，夺取武器，分给空手从军的人。第二天向江界进军，全军在半夜踏冰渡江。前锋到达仁风楼外约十里的地方，江南岸松林里火绳枪的火光闪闪。江界队的几个将校出来迎接，找到金利彦问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이#ruby("번","番") 오는 #ruby("중","中")에 #ruby("청|병","淸|兵")이 있는가?”]
#zh[“这次来的人里面有清兵吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|이|언","金|利|彦")은 #ruby("대|답","對|答")했다.]
#zh[金利彦回答道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("우|선","于|先") #ruby("강|계","江|界")를 #ruby("점|령","占|領")하고 #ruby("통|지","通|知")하면 곧 #ruby("청|병","淸|兵")이 올 것이오.”]
#zh[“先占领江界，一通知，清兵立刻就来。”]
#zh[不知道他说的是否实话，但决非战略性的回答，这亦是金利彦在作战计划上的失策。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("장|교","將|校")들은 고개를 설레설레 흔들면서 돌아갔다. 그들이 돌아가자마자 솔숲에서 #ruby("포|성","砲|聲")이 울려나오더니, #ruby("탄|환","彈|丸")이 비처럼 쏟아지기 시작했다. #ruby("좌|우","左|右")의 #ruby("산","山")골짜기 #ruby("험|준","險|峻")한 #ruby("빙|판","氷|板") 위에서 #ruby("근","近") #ruby("천|여","千|餘") #ruby("명","名")의 사람과 말떼가 큰 #ruby("혼|잡","混|雜")을 빚으며 물밀듯이 밀려 나가고 들어오니, 어느새 #ruby("총","銃")알에 맞아 죽는 #ruby("자","者"), 다쳐서 아우성을 치는 #ruby("자","者")들이 생겨나기 시작했다.]
#zh[那些将校摇着头走了。他们刚一转身，松林里便响起枪声，弹丸像雨一般倾泻下来。左右山沟险峻的冰面上，将近一千多人和马匹大乱，潮水般涌进涌出，转眼就有中弹死去的，有受伤呼号的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("김|형|진","金|亨|鎭")과 몇 걸음 #ruby("후|퇴","後|退")하면서 #ruby("상|의","相|議")하였다.]
#zh[我与金亨镇后退几步商量。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|이|언","金|利|彦")의 #ruby("금|번","今|番") #ruby("실|패","失|敗")는 #ruby("영|원","永|遠")한 #ruby("실|패","失|敗")라 다시 사람들을 모으지 못할 거요. 그러니 저들과 같이 #ruby("퇴|각","退|却")할 아무 #ruby("필|요","必|要")가 없소. 이렇게 낯선 #ruby("행|색","行|色")으로는 잡히기 쉬울 것이니, #ruby("잠|시","暫|時") #ruby("강|계|성","江|界|城") #ruby("부|근","附|近")에서 몸을 #ruby("피","避")했다가 #ruby("고|향","故|鄕")으로 돌아갑시다.”]
#zh[“金利彦这次失败是永远的失败，再也聚不起人来了。没有必要跟他们一起退却。这身陌生的装束容易被抓住，暂且在江界城附近躲避，再回故乡吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이렇게 #ruby("결|정","決|定")하고 #ruby("산","山")언저리로 올라가서, #ruby("강|계|성","江|界|城")과 아주 가까운 #ruby("거|리","距|離")에 있는 #ruby("촌|락","村|落")으로 들어갔다. 한 동네 #ruby("전|부","全|部")가 #ruby("피|난","避|難")하고 집집마다 사람을 찾아볼 수 없었다.]
#zh[这样决定之后，我们爬上山边，进了离江界城极近的村落。全村都避难去了，家家找不到一个人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한 집에 들어가니 집 바깥#ruby("문","門")이나 안#ruby("문","門")이나 다 열어둔 채였으나, #ruby("주|인","主|人")을 불러봐야 #ruby("역|시","亦|是") 한 사람도 없는 빈집이었다. 안#ruby("방","房")에 들어가니 #ruby("방","房")구석 #ruby("화","火")덕#footnote(numbering: _ => [39)])[#h(0.35em)#ruby("원|주","原|註"): “山郡 居民은 房구석에 굿배기 火爐를 備設하야 煖爐로 代用하는 것.” ‘굿배기 火爐’는 #ruby("이|동","移|動")할 수 있는 ‘#ruby("화|로","火|爐")’가 아니라, #ruby("방","房") 한쪽에 #ruby("고|정","固|定")되어 있는 ‘#ruby("화","火")덕’을 말한다. #ruby("화","火")덕은 #ruby("지|역","地|域")과 #ruby("시|기","時|期")에 따라 #ruby("다|양","多|樣")한데, #ruby("함|경|도","咸|鏡|道")의 ‘등듸’, #ruby("제|주|도","濟|州|道")의 ‘봉덕’, #ruby("강|원|도","江|原|道")의 ‘화투’ #ruby("등","等")이 있다.]에 불이 피어 일렁일렁하고 있었다. 우리 두 사람은 #ruby("우|선","于|先") #ruby("화","火")덕 옆에 앉아 손발을 녹였다. 가만히 앉아 있노라니 #ruby("방","房")안 가득히 기름 냄새와 술 냄새가 났다. 시렁 위에서 광주리를 꺼내보니 온갖 고기가 가득하였다. #ruby("우|선","于|先") 닭다리와 돼지갈비를 숯불에 쪼여 먹고 있는데, 베#ruby("두|건","頭|巾")을 쓴 사람이 #ruby("문","門")을 가만히 열고 #ruby("방","房")안을 들여다보았다. 나는 거짓 #ruby("책|망","責|望")을 했다.]
#zh[我们走到一间大门和里屋的门都没上锁的屋子，在外面叫了半天也没人应答，进去到里屋一看，只见屋角有一火盆（山里居民设在屋角的火炉，用以取暖），我们两人坐在火盆边烤火，忽然闻到房里散发出油香味和酒味，拿下搁板上的筐子一看，里面装满了各种肉食，我们掏出了鸡腿猪排，在火上烤了大嚼起来。这时有人开门往里窥视。我责问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“웬 사람인데 #ruby("야|반","夜|半")에 남의 집을 묻지도 않고 #ruby("침|입","侵|入")하는가?”]
#zh[“是谁半夜三更潜入别人家里？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 사람이 놀라고 두려운 빛을 띠고 머뭇거리며 말했다.]
#zh[那人惊慌失措，嗫嚅地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이것은 내 집인데요.”]
#zh[“这是我的家。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“누가 #ruby("주|인","主|人")이든지 이렇게 눈 오는 밤인데 들어와 몸이나 녹이시오.”]
#zh[“不管主人是谁，你先进来暖暖身子。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 사람이 들어오는 것을 보고 나는 물었다.]
#zh[他进来后，我便问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대가 이 집 #ruby("주|인","主|人")이라면 집을 비우고 어디를 갔던 게요? 내가 보기에 #ruby("주|인","主|人") 같아 보이지는 않으나 추울 터이니 여기 와서 고기나 자시오.”]
#zh[“既然你是主人，为什么屋里空无一人，你跑到哪儿去了？我看你不像。外面冷，你先吃些肉。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 사람도 하도 어이가 없어 이야기를 한다.]
#zh[那人也觉得太荒唐，说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘이 내 어머님 #ruby("대|상","大|祥")입니다. #ruby("각|처","各|處")에서 #ruby("조|객","弔|客")이 와서 #ruby("제|사","祭|祀")를 지내려는데, 갑자기 #ruby("동|구","洞|口")에서 #ruby("포|성","砲|聲")이 #ruby("진|동","震|動")하지 않겠습니까? #ruby("조|객","弔|客")들은 뿔뿔이 흩어져 #ruby("도|망","逃|亡")가고 나도 #ruby("식|구","食|口")들을 #ruby("산","山")속으로 #ruby("피|신","避|身")시켜 두고 #ruby("잠|시","暫|時") 왔던 길이오.”]
#zh[“今天是我母亲的大祥。各处吊客来要举行祭祀，洞口忽然枪声大震。吊客四散逃走，我也把家人藏到山里，这是暂时回来看看。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 한편으로 #ruby("실|례","失|禮")했다고 말하고 한편으로는 #ruby("위|로","慰|勞")를 했다.]
#zh[我向他道了失礼，并安慰他说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리도 장사#ruby("차","次") #ruby("성|내","城|內")에 왔는데, #ruby("당|도","當|到")하자마자 #ruby("난|리","亂|離")가 났다고 #ruby("소|동","騷|動")을 하기로 #ruby("촌","村")으로 #ruby("피|난","避|難")을 나온 것이오. 와서 보니 #ruby("당|신","當|身") 집 #ruby("문","門")이 열려 있기로 들어왔고, 들어와 보니 #ruby("음|식|물","飮|食|物")이 있기로 #ruby("요|기","療|飢")를 하던 #ruby("중","中")이오. #ruby("난|리","亂|離") 때라 이런 일도 있는 #ruby("법","法")이니 #ruby("용|서","容|恕")하시오.”]
#zh[“我们也是做生意来此，碰到这次骚乱，来此躲避，见大门开着，才进来的。见屋里有吃的，正好腹内饥饿，遂拿来充饥。兵荒马乱的，这也是常有的事，望你见谅。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("주|인","主|人")은 그제야 #ruby("안|심","安|心")을 했다. 나는 #ruby("주|인","主|人")을 #ruby("권","勸")하여 #ruby("산","山")속에 #ruby("피","避")하여 숨은 #ruby("식|구","食|口")들을 다시 돌아오게 하라고 일렀다. #ruby("주|인","主|人")은 #ruby("겁","怯")이 나서 말했다.]
#zh[这时主人才放心。我劝他把躲进山里的家人再叫回来。主人害怕，说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“지금도 보니 #ruby("동|구","洞|口") 밖에 #ruby("군|대","軍|隊")가 밀려가던데요.”]
#zh[“现在还看见村口外有军队涌过去呢。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("군|대","軍|隊")가 무슨 일로 #ruby("출|발","出|發")한다는지 들으셨소?”]
#zh[“你听见军队是为了什么出发的吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("주|인","主|人")은 #ruby("청","淸")나라 쪽을 가리키며 말했다.]
#zh[主人指着清国那边说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("강","江") 건너 쪽에서 #ruby("의|병","義|兵")이 밀려와 #ruby("강|계","江|界")를 치려다가 #ruby("군|대","軍|隊")에게 몰려간다고 합디다. 그렇지만 멀리서 자꾸 #ruby("포|성","砲|聲")이 들리니 알 수 있습니까? #ruby("승|부","勝|負")가 어찌 될지는 아무도 모르지요.”]
#zh[“说是江对岸的义兵涌来要打江界，被军队赶回去了。可是远处还不断传来炮声，谁知道呢？胜负谁也不知道。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리는 이렇게 말했다.]
#zh[我们这样说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("의|병","義|兵")이 오나 #ruby("군|대","軍|隊")가 오나 #ruby("촌","村")사람들에게야 무슨 #ruby("관|계","關|係")가 있겠소? #ruby("부|녀|자","婦|女|子")와 어린 아이들이 눈 속에서 밤을 지내다가 무슨 #ruby("위|험","危|險")이 있을지 모르니 #ruby("속","速")히 집으로 돌아오게 하시오.”]
#zh[“不管是义兵来，还是军队来，和老百姓有什么关系？你妻儿孩子在雪地里过夜，有多危险，还是快把他们领回家来吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("주|인","主|人")은 오히려 #ruby("자|기","自|己") 집을 우리에게 #ruby("부|탁","付|託")하였다.]
#zh[主人反而把自家托付给我们。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내 집 #ruby("식|구","食|口")뿐 아니라 온 마을이 거의 다 #ruby("산","山") 위에서 밤을 보낼 #ruby("준|비","準|備")를 하였으니, 손님은 #ruby("과","過")히 #ruby("염|려","念|慮")치 마시고 #ruby("이|왕","已|往") 내 집에 오셨으니 집이나 지켜주시오. 나는 #ruby("산","山")에 있는 #ruby("식|구","食|口")들을 가서 보고 오리다.”]
#zh[“全村人都准备在那里过夜，岂止我家。客人但请放心，既然已来到我家，就请看一下家，我要上山去看看家里人。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("인|풍|루","仁|風|樓") 밖 길가 첫 동네에 있던 그 집에서 잠을 자고, 다음날 아침 일찌감치 #ruby("출|발","出|發")하여 #ruby("강|계","江|界")를 떠나서 #ruby("적|유|령","狄|踰|嶺")을 넘어 #ruby("수|일","數|日") 만에 #ruby("신|천","信|川")에 #ruby("도|착","到|着")했다.]
#zh[在仁风楼外路边头一个村子的那家睡了一夜，第二天一早出发，离开江界，越过狄踰岭，数日内抵达信川。]
#heading(level: 3)[#text(font: "KOPUSGo B")[3) #ruby("인|연","因|緣") 없는 스승의 #ruby("손|자","孫|子")사위]]
#zh[离开清溪洞]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("청|계|동","靑|溪|洞")을 #ruby("향","向")하여 가는 길에 사람들에게 물으니, #ruby("고|선|생","高|先|生") 집에 #ruby[콜레라][虎烈刺病]가 들어 맏아들·맏며느리인 #ruby("원|명","元|明") #ruby("부|부","夫|婦")가 #ruby("일|시","一|時")에 함께 죽었다는 놀라운 #ruby("소|식","消|息")을 들었다.#footnote(numbering: _ => [40)])[#h(0.35em)#ruby("을|미|년","乙|未|年")\(1895) #ruby("윤","閏") 5#ruby("월","月")에 #ruby("전|국","全|國")에 콜레라가 #ruby("만|연","蔓|延")하여 #ruby("수|천","數|千") #ruby("명","名")이 #ruby("사|망","死|亡")하였다.]]
#zh[在往清溪洞的路上向人打听，听到惊人的消息：高先生家里染了霍乱，长子、长媳元明夫妇一时都死了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[동네 #ruby("입|구","入|口")에 들어서서 먼저 #ruby("고|선|생","高|先|生") #ruby("댁","宅")에 가서 #ruby("위|문","慰|問")하였다. #ruby("고|선|생","高|先|生")은 도리어 #ruby("침|착","沈|着")하고 #ruby("태|연","泰|然")한 빛이 있었으나, 나는 #ruby("원|통","怨|痛")하고 가슴이 답답해 아무 말도 할 수가 없었다. #ruby("부|모","父|母")님 계신 집으로 가려고 #ruby("하|직","下|直")을 할 때에 #ruby("고|선|생","高|先|生")이 #ruby("이|해","理|解")하기 어려운 말씀을 한마디 하셨다.]
#zh[进了村口，我先到高先生府上慰问。高先生反而沉着泰然，我却冤痛得胸闷，一句话也说不出来。正要告辞回父母那里时，高先生说了一句难以理解的话：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“곧 #ruby("성|례","成|禮")를 하기로 하세!”]
#zh[“立即就成婚吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[듣기만 하고 집에 가서 #ruby("부|모","父|母")님과 이야기하는 가운데,]
#zh[我只听了这句话，回到家跟父母说话的时候，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 떠난 뒤에 #ruby("고|선|생","高|先|生") #ruby("손|녀","孫|女")\(#ruby("원|명","元|明")의 맏딸)와 너와 #ruby("약|혼","約|婚")이 되었다.”]
#zh[“你走了以后，和高先生的孙女（元明的长女）订了婚。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[는 말씀을 들었다. 그제야 비로소 #ruby("고|선|생","高|先|生")이 말씀하신 뜻을 깨달을 수 있었다.]
#zh[听到这话，这才明白高先生那句话的意思。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아버님과 어머님은 번갈아가며 #ruby("약|혼","約|婚")하게 된 #ruby("경|과","經|過")를 #ruby("설|명","說|明")하셨다. 아버님의 말씀은 이러하였다.]
#zh[父亲和母亲轮流说明订婚的经过。父亲的话是这样的：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 나간 #ruby("후","後") #ruby("고|선|생","高|先|生")이 집에 찾아오셔서, ‘요새는 아들도 없고 매우 #ruby("고|적","孤|寂")하실 터이니 내 #ruby("사|랑","舍|廊")에 오셔서 이야기나 하고 놉시다’ 하시더라. #ruby("감|사","感|謝")하여 그 #ruby("사|랑","舍|廊")에 가서 노는데, #ruby("고|선|생","高|先|生")이 네가 어렸을 적부터 #ruby("행|동","行|動")해 온 것을 #ruby("세|밀","細|密")히 물으시더구나. 그래서 나는 네가 어렸을 때 #ruby("공|부","工|夫") #ruby("열|심","熱|心")히 하던 것과 #ruby("해|주","海|州") #ruby("과|거|장","科|擧|場")에서 #ruby("극|단|적","極|端|的")인 #ruby("비|관","悲|觀")을 품고 돌아온 일, #ruby("관|상|서","觀|相|書")를 보다가 #ruby("낙|심","落|心")하던 일, 마음 좋은 사람이 되려고 #ruby("동|학","東|學")에 #ruby("입|도","入|道")하던 일, #ruby("근|처","近|處") 동네의 #ruby("강|씨","姜|氏")·#ruby("이|씨","李|氏")들은 #ruby("조|상","祖|上")님의 뼈를 사고 파는 죽은 #ruby("양|반","兩|班")들이지만 너는 스스로 마음을 #ruby("수|양","修|養")하고 몸으로 #ruby("실|행","實|行")하여 살아 있는 #ruby("양|반","兩|班")이 되겠다고 하던 것 #ruby("등","等")을 모두 이야기하였다.”]
#zh[有一天，高先生到我家里说：“最近令郎不在，一定很寂寞吧！先生不妨到寒舍来聊聊天。”于是有一天父亲到高先生府上去拜访，高先生详问我的幼年时代的事情。]
#zh[父亲告诉他，我在小时候读书很用功，到海州去参加科举回来后非常悲观，研究相书，因自己的命相不好而伤心，为了当好心人，所以加入东学修道，住在邻村的姜姓和李姓，都是专啃祖宗骨头的两班。我儿则是以修身力行，立志想凭自身奋斗而成为两班的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님 말씀은 이러했다.]
#zh[母亲的话是这样的：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어느날 #ruby("고|선|생","高|先|生")이 우리집에 오셔서 나더러도 네가 곧잘 하던 일을 물으시더구나. 그래서 나는 네가 #ruby("강|령","康|翎")에서 큰 칼을 가지고 #ruby("신|풍","新|豐") #ruby("이|생|원","李|生|員")집 아이들을 죽이러 갔다가 칼도 빼앗기고 매만 맞고 왔던 일을 말씀드렸다. 그리고 돈 스무 #ruby("냥","兩")을 허리에 차고 떡 사 먹으러 갔다가 제 아버지께 매 맞았던 이야기며, 내가 사둔 #ruby("청","靑")·#ruby("홍","紅") 물감을 #ruby("전|부","全|部") 가져다가 #ruby("개|천","開|川")에 풀어놓았던 일, 아침에 울기 시작하면 #ruby("종|일","終|日")토록 울었다는 이야기를 했다.”]
#zh[我母亲也告诉高先生，我在小时候很顽皮，在康翎时，曾经拿刀杀新丰李生员家的孩子，结果刀反被别人夺走，挨了一顿揍回来；有一次带了二十两铜钱正想去买米饼吃时，被父亲撞见打了一顿；曾把家里染料偷出去把河水染成各种颜色等往事；还说我哭起来能从早哭到晚。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아버님께서 또 말씀하셨다.]
#zh[父亲又说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“하루는 #ruby("고|선|생","高|先|生") #ruby("댁","宅")에 가서 노는데, #ruby("선|생","先|生")이 갑자기 ‘#ruby("노|형","老|兄"), 우리집과 #ruby("혼|인","婚|姻")하면 어떻겠습니까?’ 하고 물으시더라. 나는 무어라고 #ruby("대|답","對|答")할지를 몰랐다. #ruby("선|생","先|生")이 다시 말씀하시기를 ‘내가 #ruby("청|계|동","靑|溪|洞")에 온 뒤로 #ruby("수","數")없이 많은 #ruby("청|년","靑|年")들을 #ruby("시|험","試|驗")하여 왔는데, #ruby("당|신","當|身") 아들만한 사람을 아직 보지 못하였소. #ruby("불|행","不|幸")히 아들 며느리가 갑자기 죽고 보니 내 몸과 마음을 #ruby("전|부","全|部") #ruby("의|탁","依|託")할 사람을 생각하게 되었는데, #ruby("노|형","老|兄")의 아들과 내 맏#ruby("손|녀","孫|女")와 #ruby("혼|인","婚|姻")을 하고 내가 #ruby("창|수","昌|洙")에게 #ruby("의|탁","依|託")하면 어떻겠소?’ 하셨다. 나는 #ruby("황|공","惶|恐")하여 ‘#ruby("선|생","先|生")께서 그처럼 #ruby("미|거","未|擧")한 #ruby("자|식","子|息")을 사랑하시는 것이 #ruby("감|사","感|謝")하나 #ruby("반|상","班|常")의 다름으로나 #ruby("덕|행","德|行")으로나 제 집의 #ruby("형|편","形|便")으로나 #ruby("자|식","子|息")의 #ruby("처|지","處|地")로 #ruby("감|당","堪|當")할 수 없습니다. 제 #ruby("자|식","子|息")이 속마음은 어떤지 모르나 저도 스스로 #ruby("인|정","認|定")하다시피 #ruby("외|모","外|貌")도 하도 못나서 #ruby("선|생","先|生") 집안에 #ruby("욕","辱")이 될까 두렵습니다’ 하였다. 그러자 #ruby("고|선|생","高|先|生")은 이런 말을 하시더라. ‘아비만큼 아들을 아는 사람이 없다고 하나 내가 #ruby("노|형","老|兄")보다 아드님에 #ruby("대","對")해 좀더 알는지 알겠소? 아드님이 못생겼다고 그다지 근심은 마시오. 내가 보건대 #ruby("창|수","昌|洙")는 #ruby("범|상","虎|相")입디다. #ruby("인|중","人|中")이 짧은 것이라든지 이마가 #ruby("속","俗") 붙은 것으로#footnote(numbering: _ => [41)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “이마가 두툼한 것이라든지”. ‘#ruby("서|문|당|본","西|文|堂|本")’이나 ‘#ruby("학|민|사|본","學|民|社|本")’ 둘 다 ‘두툼한’으로 #ruby("해|석","解|釋")했다.] 걸음걸이라든지, #ruby("장|래","將|來") 두고 보시오. 범의 냄새도 풍기고 범의 소리도 질러서 #ruby("세|상","世|上")을 크게 놀라게 할는지 알겠소?’ 하시더라.”]
#zh[“有一天到高先生府上闲坐，先生忽然问：‘老兄，和我们家结亲如何？’我不知道怎么回答。先生又说：‘我到清溪洞以后，试验过无数青年，还没见过像令郎这样的人。不幸儿子儿媳忽然死了，我便想到可以把身心全部托付的人。老兄的儿子和我的长孙女结亲，我把一切托付给昌洙，如何？’我惶恐地说：‘先生这样爱我这不成器的孩子，很是感激。可是论班常之别、论德行、论我家的情形、论孩子的处境，都担当不起。孩子内心如何我不知道，可连他自己也承认，外貌也太差，怕给先生家门丢脸。’高先生便说：‘都说知子莫若父，可也许我比老兄更了解令郎？不必太担心他长得不好。我看昌洙是虎相。人中短，额头厚，还有那步态，将来看着吧。也许会发出虎的气味，吼出虎的声音，大大惊动世间。’”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("부|모","父|母")님 말씀에 그렇게 해서 #ruby("약|혼","約|婚")을 하였다 한다. 나는 #ruby("고|선|생","高|先|生")이 그같이 나를 #ruby("촉|망","屬|望")하고 #ruby("자|원","自|願")하여 #ruby("손|녀","孫|女")를 #ruby("허|락","許|諾")한 일로 #ruby("인","因")해 더욱 #ruby("책|임|감","責|任|感")이 무거워지는 느낌을 받았고, 또 그 #ruby("성|의","誠|意")를 #ruby("감|당","堪|當")키 어렵다는 생각을 하였다. 그러나 #ruby("규|수","閨|秀")의 #ruby("자|품","姿|品")이 뛰어난 점이나, #ruby("상|당","相|當")한 #ruby("가|정|교|훈","家|庭|敎|訓")을 받은 점을 생각하면 한#ruby("편","便")으로 #ruby("만|족","滿|足")한 마음도 들었다.]
#zh[对于高先生寄予我那么大的期望，把孙女许配给我，总觉得很是惶恐，感到责任重大。尤其听先生讲过：]
#zh[“我的长子夫妇都死了，将来是要靠昌洙了。”]
#zh[又说：]
#zh[“我来清溪洞，虽然见过许多的青年，可是没有一个像昌洙这样好的男孩子。”]
#zh[听了更觉得无地自容。对于他的孙女儿，不论才貌、品德、家庭教育等，我都是心满意足的了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後")로 #ruby("고|선|생","高|先|生") #ruby("댁","宅")에 가면 안채에서도 #ruby("인|정","認|定")하는 빛이 보였고, 예닐곱 살 된 둘째 #ruby("손|녀","孫|女")아이는 나더러 아저씨라고 부르며 “안아주오” “업어주오” 하였다. 또, 그 #ruby("규|수","閨|秀")는 #ruby("조|부","祖|父") 밥#ruby("상","床")에 내 밥을 같이 차려 들고 내가 앉아 있는 자리에도 들어왔다. 나는 마음이 퍽 기뻤다. #ruby("원|명","元|明") #ruby("부|부","夫|婦")의 #ruby("장|례","葬|禮")도 내가 도와서 지냈다.]
#zh[虽然婚礼尚未举行，高先生家已把我当做女婿看待。偶而在先生家用餐时，由那位小姐端上饭桌，她的六七岁小妹妹亦高兴地称我姐夫。我的岳父母元明夫妇的丧事，就由我料理完毕。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")에게 #ruby("청","淸")나라 돌아다닌 이야기를 처음부터 끝까지 #ruby("일|일","一|一")이 #ruby("보|고","報|告")하였다. #ruby("압|록|강","鴨|綠|江")과 #ruby("두|만|강","豆|滿|江") 건너#ruby("편","便") #ruby("토|지","土|地")의 #ruby("비|옥","肥|沃")함에 #ruby("대","對")해, 그리고 그곳의 #ruby("지|세","地|勢")와 #ruby("인|심","人|心")은 어떠한지에 #ruby("대","對")해 말씀드렸고, #ruby("서|옥|생","徐|玉|生")의 아들과 #ruby("결|의","結|義")한 일, 돌아오는 길에 #ruby("김|이|언","金|利|彦")을 만나 #ruby("의|병","義|兵")에 #ruby("동|참","同|參")하였다가 #ruby("실|패","失|敗")한 일 #ruby("등|등","等|等")을 다 말씀드렸다. 또 #ruby("장|래","將|來")에 #ruby("북|방","北|方")에 가서 #ruby("활|동","活|動")할 #ruby("지|대","地|帶"), #ruby("즉","卽") #ruby("군|대","軍|隊")를 움직일 만한 #ruby[곳][用武之地] #ruby("등","等")을 두루 #ruby("소|상","昭|詳")히 #ruby("보|고","報|告")하였다.]
#zh[我向高先生报告这次旅行的经过，并告诉他豆满江、鸭绿江对岸的土地肥沃，地势险要，可以移民养兵，是很好的用武之地，人性也极为淳厚，还讲了跟徐玉生的儿子结拜兄弟，以后又遇上金利彦，参加了义兵之战，惨遭失败等事情。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[마침 그때는 #ruby("단|발|령","斷|髮|令")이 내린 때였다.#footnote(numbering: _ => [42)])[#h(0.35em)#ruby("단|발|령","斷|髮|令")이 내려진 때는 1895#ruby("년","年") 11#ruby("월","月") 15#ruby("일","日")\(#ruby("음","陰"))이다.] #ruby("군|대","軍|隊")와 #ruby("경|찰","警|察")은 거의 다 머리를 깎았고, #ruby("문|관","文|官")들도 #ruby("각","各") #ruby("군","郡")의 #ruby("면|장","面|長")까지 #ruby("단|발","斷|髮")을 #ruby("실|시","實|施")하던 #ruby("중","中")이었다. 나는 이 #ruby("문|제","問|題")를 #ruby("고|선|생","高|先|生")과 #ruby("상|의","相|議")하고 #ruby("안|진|사","安|進|士")와 더불어 #ruby("의|병","義|兵") 일으킬 #ruby("문|제","問|題")를 #ruby("회|의","會|議")하였다. 그러나 #ruby("안|진|사","安|進|士")는 아무 #ruby("승|산","勝|算") 없이 일어났다가는 #ruby("실|패","失|敗")할 수밖에 없으니 그럴 생각이 없고, #ruby("천|주|교","天|主|敎")를 믿다가 #ruby("후|일","後|日") #ruby("기|회","機|會")를 보겠다는 것이었다. 뿐만 아니라 그는 지금 #ruby("당|장","當|場") 머리를 깎아야 한다면 깎기까지라도 할 #ruby("의|향","意|向")을 가졌노라고 하였다. 그 말을 듣자, #ruby("고|선|생","高|先|生")은 두말 않고 #ruby("절|교","絶|交")를 #ruby("표|시","表|示")하였다.]
#zh[其时正在实施断发令，军队和警察已经强迫完成了剪发，各郡文官公吏也都正在实施之中。]
#zh[我乃向高先生进言，跟安进士商议起兵发难。虽然举行了会谈，但安进士颇不以为然，认为轻举妄动，唯有失败之一途，应该先信仰天主教，然后待机举事。]
#zh[他甚至还说：]
#zh[“如被迫必须断发的话，剪发也无所谓。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("진|사","進|士"), 오늘부터 끊네.”]
#zh[高先生不悦地说：]
#zh[“进士，从今天起，跟你断绝关系。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")이 #ruby("절|교","絶|交")를 #ruby("선|언","宣|言")하고 자리에서 물러나는 바람에 나의 #ruby("심|사","心|思")도 매우 저어하여졌다. 이 일이 #ruby("안|진|사","安|進|士")의 #ruby("인|격","人|格")으로 된 것이었든지 아니었든지 #ruby("간","間")에, 우리나라에서 일어난 #ruby("동|학","東|學")은 #ruby("토|벌","討|伐")하고 #ruby("서|양","西|洋") 오랑캐가 하는 #ruby("서|학","西|學")을 한다는 말이 매우 #ruby("괴|이","怪|異")하였다. 모름지기 #ruby("의|리","義|理") 있는 선비라면, “#ruby("두|가|단","頭|可|斷")이언정 #ruby("발|불|가|단","髮|不|可|斷")\(#ruby("영|위|지|하|무|두|귀","寧|爲|地|下|無|頭|鬼") #ruby("부|작|인|간|단|발|인","不|作|人|間|斷|髮|人"))”#footnote(numbering: _ => [43)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “목을 자를지언정 머리카락은 자를 수 없다” “저승에서 머리 없는 #ruby("귀|신","鬼|神")이 될지언정 이승에서 머리 깎는 사람은 되지 않겠다”.]고 생각할 때였다. 그런데 #ruby("안|진|사","安|進|士")가 #ruby("단|발","斷|髮")할 #ruby("의|향","意|向")까지 보였다는 것은 그에게 #ruby("의|리","義|理")가 없다는 말이 아니고 무엇이겠는가?]
#zh[言罢，拂袖而去。所谓“断绝”是我国从古代开始，读书人宣布绝交的话。]
#zh[看了这情形，我也对安进士产生了反感。不管他的为人如何，他对本国的东学加以讨伐，反而信仰洋夷的天主学，这就是非常怪异的事。而且现在深明大义之士，都主张“宁为地下无头鬼，不作人间断发人”，他却认为剪发也无所谓，这是违背大义。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 생각을 하고 #ruby("고|선|생","高|先|生")과 #ruby("상|의","相|議")하기를 #ruby("속","速")히 #ruby("성|혼","成|婚")이나 하고서 #ruby("청|계|동","靑|溪|洞")을 떠나기로 #ruby("결|정","決|定")하였다. #ruby("부|모","父|母")님께는 다른 #ruby("자|녀","子|女")가 없었고 #ruby("단|지","但|只") 나 하나뿐이었으므로, #ruby("고|선|생","高|先|生")과 같이 훌륭한 #ruby("가|문","家|門") #ruby("출|신","出|身")인 며느리를 맞게 되는 것이 무엇보다도 기뻐서 온 힘을 다하여 #ruby("혼|수","婚|需")와 #ruby("혼|구","婚|具")를 #ruby("준|비","準|備")하기에 #ruby("분|주","奔|走")하였다. 그러나 어찌 #ruby("예|상","豫|想")하였으랴? #ruby("호|사|다|마","好|事|多|魔")로 #ruby("괴|이","怪|異")한 일이 생겼다.]
#zh[我对安进士的态度非常失望，便和高先生商量，决定尽快地完成我的婚礼，然后离开清溪洞。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 10#ruby("여","餘") #ruby("리","里") 길 #ruby("해|주","海|州") #ruby("검|단","檢|丹") #ruby("등|지","等|地")에 있는 #ruby("친|구","親|舊") 집에 가서 일을 보고 해가 저물어 그 집에서 잠을 자게 되었다. 겨우 아침에 일어났을 때에 #ruby("고|선|생","高|先|生")이 나를 찾아와서 #ruby("천|만|낙|심","千|萬|落|心")하여 이렇게 말씀하셨다.]
#zh[父母只有我这一个儿子，现在要娶媳妇，对方又是名门闺秀，真是乐不可支，把仅有的钱拿出来，忙着操办婚事。但是好事多磨，这时却发生了一件意想不到的事。一天我到离此十多里的海州检丹亲友家中办事，天黑了，就睡在那家。早上起床的时候，高先生找我来了。他失望地对我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“자네가 어렸을 때 뉘 집에 #ruby("약|혼","約|婚")을 하였다가 자네가 #ruby("원","願")치 않아서 #ruby("퇴|혼","退|婚")하였다고 했던 것이 지금에 와서 #ruby("문|제","問|題")가 되네그려. 내가 어제 #ruby("사|랑","舍|廊")에 앉았노라니 #ruby("성","姓")이 #ruby("김","金")가라고 하는 사람이 찾아왔었다네. 나를 보고 ‘#ruby("당|신","當|身")이 #ruby[고아무개][高某]냐?’ 묻기로 그러하다 하니 내 앞에다가 칼을 내어놓고 하는 말이 ‘들으니 #ruby("당|신","當|身") #ruby("손|녀","孫|女")를 #ruby("김|창|수","金|昌|洙")에게 #ruby("허|혼","許|婚")하였다 하니 #ruby("첩","妾")으로 주는 것이오, #ruby("정|실","正|室")이오?’ 하고 물었네. 하도 #ruby("괴|상","怪|常")하여 #ruby("김","金")가를 나무라며 ‘#ruby("초|면","初|面")에 그게 무슨 #ruby("무|례","無|禮")한 말이냐?’ 하니, #ruby("김","金")가가 #ruby("노|기","怒|氣") #ruby("등|등","騰|騰")하여 하는 말이 ‘#ruby("김|창|수","金|昌|洙")의 #ruby("정|처","正|妻")는 곧 내 딸인데 이제 들으니 #ruby("당|신","當|身") #ruby("손|녀","孫|女")와 #ruby("결|혼","結|婚")을 한다 하기로 #ruby("첩","妾")이라면 #ruby("가","可")하나 #ruby("정|실","正|室")이라면 이 칼로 #ruby("생|사","生|死")를 가름하겠다’ 하지 않겠나? 나는 ‘#ruby("김|창|수","金|昌|洙")가 #ruby("종|전","從|前")에 #ruby("약|혼","約|婚")한 곳이 있었으나 이미 #ruby("파|혼","破|婚")된 줄 알고 #ruby("허|혼","許|婚")을 하였소. 그러나 이제 그대의 말을 듣건대 #ruby("엄|연","儼|然")히 #ruby("약|혼|중","約|婚|中")이라 하니 이 #ruby("문|제","問|題")는 내가 #ruby("김|창|수","金|昌|洙")를 보고 #ruby("해|결","解|決")할 터, 그대는 물러가오’ 하여 돌려보냈네. 이 일을 어찌하겠나? 우리 집안 #ruby("여|자","女|子")들은 큰 #ruby("난|리","亂|離")가 났네.”]
#zh[“昨天我正在客房的时候，来了一个姓金的人，问我你是高某人吗，我说是的。他即拿出一把刀指着我道：‘听说你把孙女许配给金昌洙是吗？那么只准许她为妾，不可配她为正室。因金昌洙跟我的女儿早就订婚了。你不答应，就用此刀拼个你死我活。’于是我告诉他：‘我以为金昌洙虽订过婚，但已解除婚约，才把孙女许他的。如果已经订婚的话，我是决不会那样做的。待我去问金昌洙后，再行解决，你先回去吧。’现在我家已经乱成一锅粥了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 이 말을 듣고 #ruby("시|작","始|作")이 재미없게 된 것으로 보고 #ruby("고|선|생","高|先|生")에게 말씀드렸다.]
#zh[我听了这话后，知道一切事情已经不大顺利。就向先生解释道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 #ruby("선|생","先|生")님을 믿고 따르는 #ruby("본|래","本|來") #ruby("의|도","意|圖")는 #ruby("선|생","先|生")님의 #ruby("손|자","孫|子")사위나 됨에 있지 않습니다. 저는 #ruby("정|녕","丁|寧")코 #ruby("선|생","先|生")님께서 #ruby("친","親")히 가르쳐 주시는 #ruby("교|훈","敎|訓")을 마음속에 아로새기고 죽을 때까지 그 거룩하신 가르침을 #ruby("봉|행","奉|行")하기로 마음에 #ruby("맹|세","盟|誓")하였습니다. 그러니 #ruby("혼|인","婚|姻")을 하든 안 하든 무슨 #ruby("상|관","相|關")이 있겠습니까? #ruby("혼|사","婚|事")는 서로 #ruby("단|념","斷|念")하고 #ruby("의|리","義|理")로만 #ruby("선|생","先|生")님을 받들겠습니다。”]
#zh[“我所以尊敬先生，也是为了要接受高深的教导，原无意高攀为先生的孙婿，所以我与令孙女不结婚也没关系。我已对婚姻绝望，今后但愿以师生关系，一生侍奉老师就是了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이미 #ruby("혼|사","婚|事")가 #ruby("순|조","順|調")롭게 되지 않을 줄 알고 잘라 말하였으나, 마음속으로는 매우 섭섭하였다.]
#zh[我虽然下了决心，夸口不跟高先生的孙女结婚也不要紧，可是在内心里却觉得非常难过，因我已深深地坠入情网。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")은 내 말을 듣고 눈물을 흘리며 #ruby("탄|식","歎|息")하였다.]
#zh[高先生听了我的话，流泪叹息道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("장|래","將|來")에 몸과 마음을 #ruby("의|탁","依|託")할 만한 사람을 #ruby("물|색","物|色")하고자 #ruby("허|다","許|多")히 마음을 써서 자네를 만났고, 더욱이 #ruby("미|혼","未|婚")이므로 #ruby("혼|사","婚|事")까지 #ruby("성|약","成|約")한 것인데 이런 #ruby("괴|변","怪|變")이 어디 있겠나? 그러면 #ruby("혼|사","婚|事")는 없었던 일로 치세. 그러나 이제 #ruby("관|리","官|吏")들이 #ruby("단|발","斷|髮")을 하고 나면 #ruby("평|민","平|民")들에게도 #ruby("실|시","實|施")하려 할 터이니, 자네는 #ruby("시|급","時|急")히 몸을 빼쳐 달아나 #ruby("단|발","斷|髮")의 #ruby("화","禍")를 #ruby("면","免")하도록 하게. 나는 머리 깎는 #ruby[화][髮禍]가 미치면 죽기로 #ruby("작|정","作|定")하였네.”]
#zh[“我为了物色一个将来可以把身心托付的人，费了许多心思才遇见你，又因你尚未成婚，连婚事都说定了，哪里会有这种怪变？那么婚事就当作没有过。可是官吏们断发之后，就要轮到平民，你赶紧脱身逃走，免掉断发之祸。我若遭到剃头之难，已决心一死。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[여기서 #ruby("이|왕","已|往")에 #ruby("기|록","記|錄")하면서 #ruby("제|외","除|外")하였던 #ruby("사|건","事|件") 한 가지를 #ruby("추|가","追|加")하여 적는다.]
#zh[这里把先前记录时略去的一件事补记下来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내 나이 네댓 살 때에 아버님이 어떤 술집에서 #ruby("함|경|도","咸|鏡|道") #ruby("정|평","定|平") 사람인 #ruby("김|치|경","金|致|景")이란 함지박장수를 만나 #ruby("취|중","醉|中")에 말이 오가다가 그에게 8, 9#ruby("세","歲") 된 딸아이가 있음을 보고 #ruby("농|담","弄|談")같이 #ruby("청|혼","請|婚")을 하였다. #ruby("김|치|경","金|致|景")은 #ruby("혼|사","婚|事")를 #ruby("승|낙","承|諾")하였고, #ruby("사|주","四|柱")까지 보내었다.]
#zh[我四五岁的时候，父亲在一家酒铺遇见咸镜道定平人、卖木瓢的金致景，酒醉交谈之间，得知他有个八九岁的女儿，便像玩笑似的提了亲。金致景答应了这门婚事，还送来了四柱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後") 아버님이 이 #ruby("여|자","女|子")아이를 집에 #ruby("종|종","種|種") 데려오셨다. #ruby("당|시","當|時") 나는 #ruby("서|당","書|堂")에 다니고 있었는데, 동네 아이들이 그것을 보고 나를 놀려대곤 했다.]
#zh[此后父亲常把这女孩带到家里来。当时我在书堂念书，村里的孩子们看见了，便嘲弄我。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너는 함지박장수의 사위다. 너의 집에 데려온 #ruby("처|녀","處|女")가 곱더냐?”]
#zh[“你是卖木瓢的女婿。带到你们家的那个女孩漂亮吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 #ruby("조|롱","嘲|弄")을 받을 때에는 #ruby("심|사","心|思")가 매우 #ruby("불|쾌","不|快")했다. 하루는 추운 겨울 얼음판 위에서 팽이를 돌리며 놀고 있는데 그 #ruby("여|자","女|子")아이가 내 곁에 와서 구경하다가 #ruby("자|기","自|己")에게도 팽이 한 #ruby("개","個")를 깎아 달라고 하였다. 나는 그 말을 듣고 #ruby("화","火")가 머리끝까지 치밀어서 어머님에게 졸라 그 #ruby("여|자","女|子")아이를 도로 돌려보냈다. 그러나 #ruby("약|혼","約|婚")을 #ruby("해|제","解|除")한 것은 아니었다.]
#zh[受这种嘲弄的时候，心里非常不快。有一天，寒冬里在冰上转陀螺玩，那女孩走到我旁边看，还要我也给她削一个陀螺。我听了火气直冲头顶，缠着母亲把那女孩送了回去。不过婚约并没有解除。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그랬다가 #ruby("갑|오|년","甲|午|年")에 #ruby("청|일|전|쟁","淸|日|戰|爭")이 일어났다. #ruby("당|시","當|時")는 #ruby("일|반","一|般") #ruby("인|심","人|心")에 #ruby("대|부|분","大|部|分")의 아들딸 가진 사람들이 #ruby("자|식","子|息") #ruby("혼|인","婚|姻")시키는 것을 #ruby("유|일","唯|一")한 #ruby("의|무","義|務")로 알던 때였다. #ruby("당|시","當|時") 나는 #ruby("동|학","東|學") #ruby("접|주","接|主")가 되어 #ruby("동|분|서|주","東|奔|西|走")하던 판이었는데, 하루는 집에 들어가니 술과 떡을 마련해 놓고 #ruby("혼|인","婚|姻") #ruby("준|비","準|備")를 하고 있는 것이었다. 나는 #ruby("한|사","限|死")코 #ruby("장|가","丈|家")를 가지 않겠다고 #ruby("부|모","父|母")님께 말씀드렸다. #ruby("부|모","父|母")님도 할 수 없다고 여기셨던지, #ruby("김|치|경","金|致|景")에게 #ruby("자|식","子|息")이 #ruby("원","願")하지 않으니 #ruby("혼|약","婚|約")을 #ruby("해|제","解|除")할 것을 #ruby("상|의","相|議")하시고, 그 집 딸도 다른 자리에 #ruby("출|가","出|家")시키라고 하셨다. #ruby("김|치|경","金|致|景")도 #ruby("무|방","無|妨")한 일이라 생각했었다.]
#zh[后来到了甲午年，中日战争爆发。当时一般人心，有儿有女的人多半把给子女完婚当作唯一的义务。那时我当了东学接主，正东奔西走，有一天回到家，却见酒和米饼都备下了，正在准备婚事。我死命对父母说，决不去成亲。父母也觉得无法，便和金致景商量，孩子自己不愿意，婚约该解除，他家女儿也嫁到别处去。金致景当时也认为不妨。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|치|경","金|致|景")이 #ruby("청|계|동","靑|溪|洞")에서 10#ruby("여","餘") #ruby("리","里")쯤 되는 곳에 있는 #ruby("신|천","信|川") #ruby("수|유|령","水|踰|嶺")에 #ruby("이|사","移|徙")하여 술장사를 하던 때였다. 그때 #ruby("김|치|경","金|致|景")이 나와 #ruby("고|선|생","高|先|生") #ruby("댁","宅")과의 #ruby("혼|약","婚|約") #ruby("소|문","所|聞")을 듣고서, 이 #ruby("혼|사","婚|事")를 #ruby("방|해","妨|害")하면 돈푼깨나 얻을 수 있을 것이라 생각하여 짐짓 #ruby("방|해","妨|害")를 놓은 것이었다. 아버님이 #ruby("분|기|탱|천","憤|氣|撐|天")하셔서 곧 #ruby("김|치|경","金|致|景")의 집에 가서 싸움을 하였으나 이미 다 지나간 일이었다. #ruby("김|치|경","金|致|景")은 그때 벌써 #ruby("자|기","自|己") 딸을 #ruby("인|근","隣|近") 동네에 돈을 받고 #ruby("혼|약","婚|約")해 놓은 #ruby("상|태","狀|態")였다고 한다. 그#ruby("후","後") #ruby("고|선|생","高|先|生")은 #ruby("비|동","飛|洞")으로, 우리집은 텃골로, #ruby("세|간","世|間")살이를 다 옮겨 #ruby("이|사","移|徙")하였다.]
#zh[那时金致景已经搬到离清溪洞十多里的信川水踰岭，开着酒铺。他听到我和府上订婚的风声，心想阻挠这门婚事可以弄到几个钱，便故意出来作梗。父亲怒气冲天，立刻到金致景家吵了一场，可是事情已经过去了。据说金致景那时早已收了钱，把女儿许给附近村子。后来高先生搬到飞洞，我们家也把家当搬到基洞。]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) #ruby("복|수","復|讐") #ruby("의|거","義|擧"), #ruby("치|하|포","鴟|河|浦") #ruby("사|건","事|件")]]
#zh[鸥河浦事件]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("시|급","時|急")히 #ruby("청","淸")나라 #ruby("금|주","錦|州")에 있는 #ruby("서|옥|생","徐|玉|生")의 집으로 가기로 #ruby("작|정","作|定")하였다. #ruby("김|형|진","金|亨|鎭")은 #ruby("자|기","自|己") #ruby("본|향","本|鄕")으로 가게 되어 #ruby("동|행","同|行")하지 못하고 #ruby("단|신","單|身")으로 #ruby("출|발","出|發")하였다.#footnote(numbering: _ => [44)])[#h(0.35em)#ruby("약|간","若|干")의 #ruby("전|후","前|後") #ruby("설|명","說|明")이 #ruby("필|요","必|要")하다. 1895#ruby("년","年") #ruby("중|국","中|國")에 다녀온 #ruby("후","後") #ruby("김|창|수","金|昌|洙")·#ruby("김|형|진","金|亨|鎭")은 #ruby("김|재|희","金|在|熙")·#ruby("최|창|조","崔|昌|祖")·#ruby("백|낙|희","白|樂|熙")·#ruby("김|양|근","金|養|根")·#ruby("김|계|조","金|桂|祚")·#ruby("백|기|정","白|基|貞")·#ruby("김|의|순","金|義|順")·#ruby("백|낙|규","白|樂|圭") #ruby("등","等")과 함께 #ruby("장|연","長|淵")에서 #ruby("산|포|수","散|砲|手")를 모아 1896#ruby("년","年") #ruby("구|정|일","舊|正|日")에 #ruby("거|병","擧|兵")하여 #ruby("해|주|부","海|州|府")를 #ruby("공|략","攻|略")하고, #ruby("청|병","淸|兵")과 #ruby("합|류","合|流")하여 #ruby("경|성","京|城")까지 #ruby("진|격","進|擊")하는 #ruby("거|사","擧|事")를 #ruby("추|진","推|進")하였다. 그러나 #ruby("거|사","擧|事") #ruby("직|전","直|前")에 #ruby("백|낙|희","白|樂|熙") #ruby("등","等")이 #ruby("검|거","檢|擧")되어 #ruby("거|사","擧|事")는 #ruby("실|패","失|敗")하고 #ruby("김|창|수","金|昌|洙")와 #ruby("동|료","同|僚")들은 #ruby("황|급","惶|急")히 #ruby("도|피","逃|避")하였다. 이들은 #ruby("체|포","逮|捕")의 #ruby("위|험","危|險") 때문에 #ruby("각|각","各|各") 흩어졌고, #ruby("이|후","以|後") #ruby("김|창|수","金|昌|洙")는 #ruby("김|형|진","金|亨|鎭")을 만나지 못하였다.] #ruby("평|양","平|壤")에 #ruby("도|착","到|着")하니 #ruby("관|찰|사","觀|察|使") #ruby("이|하","以|下") #ruby("전|부","全|部")가 #ruby("단|발","斷|髮")을 하고, 길목을 막고 서서 지나가는 #ruby("행|인","行|人")들을 붙들고 머리를 깎고 있었다. #ruby("단|발|령","斷|髮|令")을 #ruby("피","避")하려고 시골로나 #ruby("산","山")골로 숨어 들어가는 #ruby("백|성","百|姓")들의 #ruby("원|성","怨|聲")이 길을 가득 메운 것을 #ruby("목|격","目|擊")하고, 나는 머리끝까지 #ruby("분|기","憤|氣")가 가득하였다.]
#zh[我独自出发，抵达平壤时，观察使以下的官吏已全部断发，并且在街头巷尾，肆意逮捕行人强行剪发。人们不愿剪发，多偷偷地逃出平壤，去乡村或山里避难。老百姓怨声载道。看了这情景，我真是愤怒至极。]
#figure-block("/images/p86.jpg", caption: [#ruby("백|범","白|凡")이 #ruby("활|동","活|動")했던 #ruby("황|해|도","黃|海|道") #ruby("주|변|도","周|邊|圖")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|주","安|州")에 #ruby("도|착","到|着")했는데, #ruby("게|시|판","揭|示|板")을 보니 #ruby("단|발|정|지|령","斷|髮|停|止|令")이 내려 있었다. #ruby("소|문","所|聞")을 들으니, #ruby("경|성","京|城") #ruby("종|로","鍾|路")에서 사람들에게 #ruby("단|발","斷|髮")을 시켰다가 #ruby("대|소|동","大|騷|動")이 일어났다고 했다. #ruby("일|본|인","日|本|人")들의 #ruby("가|옥","家|屋")을 때려부수고 #ruby("일|인","日|人")을 #ruby("다|수","多|數") 때려죽이는 #ruby("등","等") #ruby("변|란","變|亂")이 나고, #ruby("당|시","當|時") #ruby("정|부","政|府") #ruby("당|국|자","當|局|者")들에게도 큰 #ruby("변|동","變|動")이 일어났다고 했다. 이야기를 들어보니, #ruby("장|차","將|次") 나라 안 #ruby("사|정","事|情")이 많이 #ruby("변","變")할 낌새라 굳이 #ruby("출|국","出|國")할 것이 없다는 생각이 들었다. 또 #ruby("삼|남","三|南") #ruby("방|면","方|面")에서 #ruby("의|병","義|兵")이 #ruby("봉|기","蜂|起")한다고도 하니, 다시 돌아가서 #ruby("시|세","時|勢")를 #ruby("관|찰","觀|察")하리라 #ruby("결|심","決|心")하고 #ruby("회|정","回|程")하였다.#footnote(numbering: _ => [45)])[#h(0.35em)#ruby("을|미|사|변","乙|未|事|變")의 #ruby("참|극","慘|劇")이 있은 지 3#ruby("개|월","個|月") 만인 1895#ruby("년","年") 11#ruby("월","月") #ruby("김|홍|집","金|弘|集")#ruby("내|각","內|閣")이 #ruby("국|상|중","國|喪|中")임에도 #ruby("불|구","不|拘")하고 #ruby("단|발|령","斷|髮|令")을 #ruby("선|포","宣|布")하자, #ruby("전|국","全|國") #ruby("각|지","各|地")에서 몸을 지키자는 ‘#ruby("보|형","保|形")#ruby("의|병","義|兵")’이 일어났다. 이어 #ruby("고|종","高|宗")은 #ruby("러|시|아","俄|羅|斯") #ruby("영|사|관","領|事|館")으로 #ruby("피|신","避|身")하고(#ruby("아|관|파|천","俄|館|播|遷")), #ruby("김|홍|집","金|弘|集")·#ruby("어|윤|중","魚|允|中") #ruby("등","等")은 #ruby("살|해","殺|害")되고 #ruby("갑|오|내|각","甲|午|內|閣")이 #ruby("붕|괴","崩|壞")하였다. 뒤이어 #ruby("이|범|진","李|範|眞")·#ruby("이|완|용","李|完|用")·#ruby("윤|치|호","尹|致|昊") #ruby("등","等")을 #ruby("중|심","中|心")으로 한 #ruby("친|러|내|각","親|俄|內|閣")이 #ruby("등|장","登|場")하여 #ruby("단|발|령","斷|髮|令")을 #ruby("철|회","撤|回")하였다. #ruby("백|범","白|凡")은 #ruby("안|주","安|州")에서 #ruby("아|관|파|천","俄|館|播|遷"), #ruby("내|각","內|閣") #ruby("교|체","交|替"), #ruby("단|발|정|지|령","斷|髮|停|止|令") #ruby("등","等")의 #ruby("소|식","消|息")을 듣고 #ruby("청","淸")나라로 가려던 #ruby("거|사","擧|事") #ruby("계|획","計|劃")을 바꾸었다.]]
#zh[到达安州，见到布告板上贴着停止断发的命令。传闻京城钟路因居民反对断发，发生了骚乱，拆毁了日本人的住房，打死了无数日本人。当时政府当局也出现了很大的变动。]
#zh[我见此情势，改变了主意。何必要到国外去呢？又听说三南方面义兵蜂起，便决心折回去观察时势，于是回程。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("용|강|군","龍|岡|郡")에서 #ruby("안|악|군","安|岳|郡") #ruby("치|하|포","鴟|河|浦")로#footnote(numbering: _ => [46)])[#h(0.35em)#ruby("원|주","原|註"): “安岳郡에서 東北 四十里 許”.] 배를 타고 건너게 되었는데, 때는 #ruby("병|신|년","丙|申|年")\(1896, 21#ruby("세","歲")) 2#ruby("월","月") #ruby("하|순","下|旬")이었다.#footnote(numbering: _ => [47)])[#h(0.35em)#ruby("당|시","當|時") #ruby("보|고","報|告")\(#ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料"))에는 1896#ruby("년","年") 3#ruby("월","月") 8#ruby("일","日")\(#ruby("음|력","陰|曆") 1#ruby("월","月") 25#ruby("일","日"))이다.] #ruby("강","江") 위에 #ruby("빙|산","氷|山")이 떠다니는 바람에 열대여섯 #ruby("명","名")의 #ruby("남|녀","男|女") #ruby("선|객","船|客")이 이 #ruby("빙|산","氷|山")에 #ruby("포|위","包|圍")되고 말았다. #ruby("진|남|포","鎭|南|浦") #ruby("하|류","下|流")까지 #ruby("빙|산","氷|山")에 싸여 내려갔다가 #ruby("조|수","潮|水")를 따라서 다시 #ruby("상|류","上|流")로 오르락내리락 하게 됐는데, #ruby("선|객","船|客")들은 #ruby("물|론","勿|論") 뱃#ruby("사|공","沙|工")들까지 모두 얼음#ruby("귀|신","鬼|神")이 되는 줄 알고 #ruby("당|황","唐|惶")해 했다. 나도 해마다 얼음이 얼었다가 풀리는 때가 되면 사람들이 #ruby("종|종","種|種") 이런 나루터에서 #ruby("빙|산","氷|山")에 #ruby("포|위","包|圍")되어 #ruby("참|사","慘|事")를 겪게 된다는 것을 들어 알고 있었던바, 이날 #ruby("불|행","不|幸")히도 내가 그런 #ruby("위|태","危|殆")로운 #ruby("지|경","地|境")에 빠지게 되었던 것이다. 사람들이 살려 달라고 하나님께 부르짖는 소리, 어머니를 부르는 울음소리가 배에 #ruby("진|동","震|動")하였다.]
#zh[丙申年二月下旬，从龙冈郡搭船渡往安岳郡鸥河浦。江上冰山漂浮，船上男女十五六名乘客被冰山围住，一直漂到镇南浦下游，又随着潮水忽上忽下。乘客不必说，连船夫都以为要做冰鬼了，慌作一团。我原听说每年结冰和解冻的时候，人们常在这种渡口被冰山围住，遭逢惨事，这一天不幸轮到了我。人们呼喊上帝救命、哭叫母亲的声音，震动了整条船。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 살아나갈 #ruby("방|도","方|道")를 찾아보았다. 배 안에는 #ruby("식|량","食|糧")이 없어 얼어죽는 것보다 먼저 굶어 죽을 판이었다. #ruby("다|행","多|幸")히 나귀 한 #ruby("필","匹")이 있어, #ruby("빙|산","氷|山")의 #ruby("포|위","包|圍")가 오랫동안 #ruby("계|속","繼|續")될 것 같으면 #ruby("잔|인","殘|忍")하나마 #ruby("부|득|불","不|得|不") 나귀를 잡아서 열대여섯 사람의 #ruby("생|명","生|命")을 #ruby("보|전","保|全")하기로 했다. #ruby("무|작|정","無|作|定") 소리내어 우는 것이 우리 목숨을 #ruby("구","救")하는 길이 아니니, 뱃일을 #ruby("사|공","沙|工")에게만 맡길 것이 아니라 #ruby("선|객","船|客") 모두가 #ruby("일|제","一|齊")히 힘을 #ruby("합","合")해서 #ruby("빙|산","氷|山")을 밀어내자고 하였다. #ruby("빙|산","氷|山")이 #ruby("순|식|간","瞬|息|間")에 물러가지는 않는다 하더라도, 추위 속에 몸을 움직이면 #ruby("운|동","運|動")이 될 터이니 #ruby("유|익","有|益")할 것 같았다. 내가 이런 #ruby("주|장","主|張")을 #ruby("맹|렬","猛|烈")히 내세우고 힘쓸 #ruby("자","者")를 #ruby("구","求")하니 #ruby("선|객","船|客")들과 뱃#ruby("사|공","沙|工")이 #ruby("일|제","一|齊")히 #ruby("찬|성","贊|成")하였다. 나는 몸을 날려 #ruby("빙|산","氷|山")에 올라가서 얼음들이 모여 있는 #ruby("형|세","形|勢")를 살펴보고, 큰 얼음덩이에 #ruby("의|지","依|支")해서 작은 것을 힘껏 밀어내 보았다. 이렇게 #ruby("노|력","努|力")하던 #ruby("중","中") #ruby("간|신","艱|辛")히 한 줄기 살 길을 찾게 되었다.]
#zh[我寻找活路。船上没有粮食，与其冻死，先要饿死。幸好有一头驴，冰山若围得久，残忍也只好宰了驴，保全这十五六条命。一味哭喊救不了命，船事不能只交给船夫，乘客也该一齐合力把冰山推开。冰山纵然不能顷刻退去，在寒气里活动身子也有益处。我猛烈主张，征求肯出力的人，乘客和船夫一齐赞成。我纵身跳上冰山，看冰聚拢的形势，靠着大冰块用力推开小的。这样努力之中，好容易找出一条生路。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[멀리 떨어진 #ruby("치|하|포","鴟|河|浦")에는 닿지 못하고 5#ruby("리","里") 밖 #ruby("강","江")기슭으로 올라갔다. #ruby("서|산","西|山")에 지는 달이 아직 #ruby("희|미","稀|微")하게 빛을 #ruby("발","發")하고 있었다. #ruby("치|하|포","鴟|河|浦")에 #ruby("도|착","到|着")해서 #ruby("여|관","旅|館")을 겸하고 있는 나루터 #ruby("주|인","主|人")의 집에 들어갔다. #ruby("풍|랑","風|浪")으로 #ruby("인","因")해 #ruby("유|숙","留|宿")하는 손님들이 세 칸 #ruby("여|관|방","旅|館|房")에 가득하였다. #ruby("자|정","夜|午")이 넘은 #ruby("시|각","時|刻")이었으므로 #ruby("방|방","房|房")마다 코고는 소리만 들렸다. 함께 #ruby("고|생","苦|生")했던 우리 #ruby("일|행","一|行")들도 #ruby("방","房") 세 칸에 나뉘어 들어가 잠을 자고 쉬었다.]
#zh[没有靠上远处的鸥河浦，在五里外的江岸上了岸。西山落月还发出微光。到了鸥河浦，走进兼作旅店的渡口主人家里。因风浪留宿的客人把三间客房挤满了。已过午夜，家家只听见鼾声。一起吃过苦的我们一行，也分进三间房歇下。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[잠이 막 들자마자 먼저 들어온 #ruby("여|행|객","旅|行|客")들이 일어나 떠들며, 오늘은 날씨가 좋으니 배를 타고 건너게 해 달라고 한바탕 #ruby("야|단","惹|端")을 쳤다.]
#zh[我们一行，也混进他们里面，刚要睡着时，原先睡觉的人已经起来了，喧闹着请求船家利用转好的天气，在黎明涨潮时载他们渡河。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[조금 있다가 아랫#ruby("방","房")에서부터 아침#ruby("식|사","食|事")가 #ruby("시|작","始|作")되어 가운뎃#ruby("방","房")과 윗#ruby("방","房")까지 밥#ruby("상","床")이 들어왔다. 그때 가운뎃#ruby("방","房")에는 #ruby("단|발","斷|髮")을 하고 #ruby("한|복","韓|服")을 입은 사람 한 #ruby("명","名")이 같이 앉은 나그네와 #ruby("인|사","人|事")를 나누고 있었다. #ruby("성","姓")은 #ruby("정|씨","鄭|氏")라 하고 #ruby("장|연","長|淵")에 산다고 하는데,#footnote(numbering: _ => [48)])[#h(0.35em)#ruby("원|주","原|註"): “其時에 黃海道에는 長淵이 先次로 斷髮되여 平民들도 斷髮한 者 或 有하엿다.”] 말투는 #ruby("장|연","長|淵")말이 아니고 #ruby("경|성","京|城")말이었다. #ruby("촌","村") 늙은이들은 그를 #ruby("진","眞")짜 #ruby("조|선|인","朝|鮮|人")으로 알고 이야기를 나누었으나, 내가 보기에는 #ruby("분|명","分|明")히 #ruby("왜","倭")놈이었다. #ruby("자|세","仔|細")히 살펴보니 흰 두루마기 밑으로 칼집이 보였다. 가는 길을 물어보니 #ruby("진|남|포","鎭|南|浦")로 간다 했다.]
#zh[不久，下房开始送进来饭桌，接着，中房、上房也摆开饭桌，准备吃早饭。我不得不起身，一面等着开饭，一面仔细打量房间里的人。]
#zh[这时，在中间的房间，有个身穿韩服剪了发的人，正和同座人寒暄，从他的谈话中，知道他姓郑，住在长渊。在黄海道，长渊最先施行“断发令”，因此在民间已有人剪了发。可是他的语调不像长渊方言，而是汉城口音，在我听来，分明是个倭寇。再仔细观察，又发现他白衣底下露出一截军刀刀鞘。]
#zh[我问他往哪里去，他说正在赶路上镇南浦去。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그놈의 #ruby("행|색","行|色")에 #ruby("대","對")해 곰곰이 생각해 보았다.]
#zh[我把那家伙的行色仔细想了一番。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘이곳은 #ruby("진|남|포","鎭|南|浦") 맞은#ruby("편","便") 기슭이므로 #ruby("매|일","每|日")#ruby("매|일","每|日") 여러 #ruby("명","名")의 #ruby("왜|인","倭|人")이 #ruby("자|기","自|己")들의 #ruby("본|래","本|來") #ruby("행|색","行|色")대로 #ruby("통|행","通|行")하는 곳이다. 그러니 저놈이 #ruby("보|통","普|通") 장사치나 #ruby("기|술|자","技|術|者") 같으면, 굳이 우리 #ruby("조|선","朝|鮮")사람으로 #ruby("위|장","僞|裝")하지 않아도 되었을 것이다. 그렇다면 #ruby("혹|시","或|是") 저 #ruby("자","者")가 우리 #ruby("국|모","國|母")를 #ruby("시|해","弑|害")한 #ruby("미우라","三浦梧樓")#footnote(numbering: _ => [49)])[#h(0.35em)#ruby("육|군|중|장","陸|軍|中|將") #ruby("출|신","出|身")으로 #ruby("을|미|사|변","乙|未|事|變")을 #ruby("주|도","主|導")한 #ruby("조|선|주|재","朝|鮮|駐|在") #ruby("일|본","日|本") #ruby("공|사","公|使").]가 아닐까? #ruby("경|성","京|城")에서 일어난 #ruby("분|란","紛|亂") 때문에 #ruby("도|망","逃|亡")하여 #ruby("당|분|간","當|分|間") 숨으려는 것은 아닌가? #ruby("만|일","萬|一") #ruby("미우라","三浦梧樓")가 아니더라도 #ruby("미우라","三浦梧樓")의 #ruby("공|범","共|犯")일 것 같다. #ruby("여|하","如|何")튼 칼을 차고 숨어다니는 #ruby("왜|인","倭|人")이 우리 #ruby("국|가","國|家")와 #ruby("민|족","民|族")의 #ruby("독","毒")버섯인 것은 #ruby("명|백","明|白")한 #ruby("사|실","事|實")이다. 내가 저놈 한 #ruby("명","名")을 죽여서라도 #ruby("국|가","國|家")의 #ruby("치|욕","恥|辱")을 씻어 보리라.’]
#zh[我默默沉思，他究竟是何等人？看来不像从事商业或工业的日本人，也许他是弑我国母的三浦梧楼，化了装企图逃走。否则，也定是他的党羽，即使两者都不是，这种佩刀潜逃的人对我们国家和民族来说，总是一个毒瘤，对这种家伙，杀一个算一个，也就算是洗刷了一分耻辱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[먼저 #ruby("주|위","周|圍") #ruby("환|경","環|境")과 나의 #ruby("역|량","力|量")을 살펴보았다. #ruby("방","房") 3칸에 가득 찬 손님의 #ruby("수","數")가 40#ruby("여","餘") #ruby("명","名") 되어 보였고, 그놈의 #ruby("응|견","鷹|犬")#footnote(numbering: _ => [50)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “패거리”. #ruby("응|견","鷹|犬")은 사냥할 때에 쓰이는 매와 개.]가 몇 #ruby("명","名") #ruby("정|도","程|度") 섞여 있을지는 알 수 없었으나, 나이 17, 8#ruby("세","歲") 되어 보이는 #ruby("총|각","總|角")이 그놈 옆에서 무슨 말인가 하고 있었다.#footnote(numbering: _ => [51)])[#h(0.35em)뒤에 밝혀진 바에 #ruby("의","依")하면 배의 #ruby("주|인","主|人")은 #ruby("조|응|두","趙|應|斗"), 배에 탄 #ruby("인|원","人|員")은 #ruby("일|본|인","日|本|人") #ruby("외","外") 7#ruby("명","名")이었다. #ruby("총|각","總|角")의 이름은 #ruby("임|학|길","林|學|吉")이며 20#ruby("세","歲")였다.]]
#zh[我先看了看周围的环境和自己的力量。三间房里客人看来有四十多名，不知那家伙的鹰犬混着几个，只见一个看来十七八岁的小伙子在他旁边说着什么。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘나는 혼잣몸에 빈손이 아닌가? 섣불리 #ruby("동|수","動|手")를 하다가#footnote(numbering: _ => [52)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “손을 썼다가”.] 내 목숨만 저놈의 칼 아래 끊어 보내는 것은 아닐까? 그렇게 되면 내 #ruby("의|지","意|志")와 #ruby("목|적","目|的")은 #ruby("세|상","世|上")에 드러내지도 못하고, 도리어 #ruby("도|적","盜|賊")놈의 #ruby("시|체","屍|體") 하나만 남기고 죽고 말 것이다.#footnote(numbering: _ => [53)])[#h(0.35em)#ruby("실|패","失|敗")하고 죽으면 #ruby("자|기","自|己")가 오히려 #ruby("도|적","盜|賊")이나 #ruby("강|도","强|盜")로 #ruby("오|인","誤|認")받을 것을 #ruby("우|려","憂|慮")한 말이다.] 또 내가 빈손으로 #ruby("단|번","單|番")에 저놈을 죽일 수는 없다. #ruby("만|약","萬|若") 죽을 #ruby("결|심","決|心")을 하고 #ruby("하|수","下|手")를 한다손#footnote(numbering: _ => [54)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “대들더라도”.]#ruby("방","房")안에 있는 사람들이 #ruby("만|류","挽|留")하면 그 틈을 타서 저놈의 칼이 내 몸에 들어오고 말 것이다. 그러니 아무리 생각하여도 이 일은 #ruby("불|가|능","不|可|能")한 일이다.’]
#zh[“我岂不是单身空着手？贸然动手，岂不是只把这条命送在他的刀下？那样我的意志和目的还没向世间表明，反而只留下一具盗贼的尸体就死了。再说我空着手也不能一下杀死他。纵然拼死下手，房里的人若来劝阻，他的刀就会趁隙刺进我的身子。想来想去，这件事是做不到的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 생각을 하니 가슴이 #ruby("심","甚")하게 울렁거렸다.]
#zh[这样想着，胸口剧烈地怦怦跳。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("심|신","心|神")이 자못 #ruby("혼|란","混|亂")한 #ruby("상|태","狀|態")에 빠져 #ruby("고|민","苦|悶")하고 있는데, #ruby("홀|연","忽|然")히 한 가닥 #ruby("광|선","光|線")이 가슴 속에 비치는 듯하였다. 그것은 바로 #ruby("후|조","後|凋") #ruby("고|능|선","高|能|善") #ruby("선|생","先|生")이 가르쳐 주신 #ruby("교|훈","敎|訓")이었다.]
#zh[心神颇为混乱，正在苦闷，忽然觉得有一线光明照进胸中。那正是后凋高能善先生教给我的教训：]
#quote-block[가지 잡고 나무를 오르는 것은 #ruby("기|이","奇|異")한 일이 #ruby("아니나","得樹攀枝無足奇")]
#zh[“抓住树枝爬树，并不是奇事；”]
#quote-block[벼랑에 매달려 잡은 손을 놓는 것이 #ruby("가","可")히 #ruby("장|부","丈|夫")로다. (懸崖撒手丈夫兒)]
#zh[“悬挂在悬崖上撒手，才称得上大丈夫。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 곧 #ruby("자|문|자|답","自|問|自|答")해 보았다.]
#zh[由是我领悟到了其中的道理，心中闪过一线光明，我这样忖度着：]
#zh[由是我领悟到了其中的道理，心中闪过一线光明，我这样忖度着：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("문","問"), “네가 보기에 저 #ruby("왜|인","倭|人")을 죽여 #ruby("설|욕","雪|辱")하는 것이 옳다고 #ruby("확|신","確|信")하는가?”]
#zh[“杀死那个倭寇是对的吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("답","答"), “그렇다.”]
#zh[“对的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("문","問"), “네가 어릴 때부터 ‘마음 좋은 사람’ 되기가 #ruby("소|원","所|願")이 아니었더냐?”]
#zh[“我从小不是就想做一个好心人吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("답","答"), “그렇다. 그러나 지금은 #ruby("원|수","怨|讐") #ruby("왜","倭")놈을 죽이려다가 #ruby("성|공","成|功")하지 못하고 도리어 죽임을 당하면, 한낱 #ruby("도|적","盜|賊")의 #ruby("시|체","屍|體")로 남겨질까 그것을 미리 걱정하고 있는 것이다. 그렇다면 내가 이때까지 ‘마음 좋은 사람’ 되고자 했던 것은 다 거짓이고, #ruby("사|실","事|實")은 ‘#ruby("호|신|호|명|인","好|身|好|名|人")’#footnote(numbering: _ => [55)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “몸에 #ruby("이","利")롭고 이름 내는 것을 좋아하는 사람”. 몸에 #ruby("이|익","利|益")되는 것과 이름 날리는 일을 좋아하는 사람.]이 되려는 #ruby("소|원","所|願")만 가졌던 것이 아닌가。”]
#zh[“是的。”]
#zh[“要杀死倭寇报仇，却害怕不能成功，反死于倭寇刀下，那么，要做好心人的想法，岂不是虚假的吗！我岂不成了贪生怕死，重视虚荣的人了吗！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("자|문|자|답","自|問|自|答") 끝에 비로소 죽을 #ruby("작|정","作|定")을 하고 나니, 가슴 속에서 일렁이던 #ruby("파|도","波|濤")는 어느덧 #ruby("잔|잔","潺|潺")해지고 #ruby("백","百") 가지 #ruby("계|책","計|策")이 줄지어 떠오르기 시작했다.]
#zh[这样想过之后，我的心里反倒平静下来，计策也自然而然地涌现出来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("우|선","于|先") #ruby("방","房")안에 있는 40#ruby("여","餘") #ruby("명","名")의 손님들과 동네사람 #ruby("수|백","數|百") #ruby("명","名")을 #ruby("무|형","無|形")의 노끈으로 꽁꽁 동여 움직이지 못하게 하기로 했다. 그 #ruby("왜","倭")놈이 #ruby("만|약","萬|若") 조금이라도 #ruby("불|안","不|安")한 #ruby("상|태","狀|態")를 느끼게 되면 거기 #ruby("대|비","對|備")하게 될 터이니, #ruby("일|단","一|旦") 아무 눈치도 채지 못하도록 #ruby("안|심","安|心")을 시키고, 나 한 사람만 #ruby("자|유|자|재","自|由|自|在")로 #ruby("연|극","演|劇")을 #ruby("연|출","演|出")하는 #ruby("방|법","方|法")을 쓰기로 했다.]
#zh[于是我决定采用无形的绳索束缚住四十名旅客和数百村民，使他们不能动弹，然后我单独一个人能够自由自在地用表演的办法。还要不露声色，使倭寇安心，以免他有所防备。于是我就设计演戏。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아랫#ruby("방","房")에 먼저 #ruby("도|착","到|着")하여 #ruby("제|일|착","第|一|着")으로 밥#ruby("상","床")을 받은 사람이 숟가락질을 #ruby("시|작","始|作")했다. 그러나 자던 입에 새벽밥이라고 밥이 제대로 넘어갈 리가 없었다. #ruby("삼|분","三|分")의 #ruby("일","一")도 채 못 먹고 있을 즈음, 나중에 밥#ruby("상","床")을 받은 나는 네댓 숟갈로 한 그릇 밥을 다 먹어치웠다. 일어서서 #ruby("주|인","主|人")을 부르니 #ruby("골|격","骨|格")이 #ruby("준|수","俊|秀")하고 나이 #ruby("약","約") 37, 8#ruby("세","歲")나 되었음직한 사람이 #ruby("문","門") 앞에 와서 물었다.]
#zh[下房先到的人第一个接到饭桌，开始动匙。可是刚睡醒的嘴，黎明的饭哪能好好咽下去，还没吃到三分之一。后接到饭桌的我，四五匙就把一碗吃完了。我站起来叫主人，一个骨架清秀、年纪约莫三十七八岁的人来到门前问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어느 손님이 불렀소?”]
#zh[“哪位客人叫我？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("주|인","主|人")을 보고 말했다.]
#zh[我看着主人说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 좀 #ruby("청","請")했소이다. 다름 아니라 내가 오늘 700#ruby("여","餘") #ruby("리","里")나 되는 #ruby("산","山")길을 걸어서 넘어가야 하는데, 아침을 더 먹고 가야겠으니 밥 일곱 #ruby("상","床")\(7#ruby("인|분","人|分"))만 더 차려다 주시오.”]
#zh[“是我请你来的。不为别的，我今天要走七百多里山路，想再吃一顿早饭，请再摆七桌饭。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("주|인","主|人")은 아무 #ruby("대|답","對|答") 없이 나를 보기만 하더니, 내 말에는 #ruby("대|답","對|答")도 아니하고 #ruby("방","房")안에서 아직 밥을 먹고 있는 다른 손님들을 보고서 이렇게 말했다.]
#zh[主人并不回答，只看着我，也不答我的话，却望着房里还在吃饭的客人说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“젊은 사람이 불쌍도 하다. 미친놈이군.”]
#zh[“年轻人也可怜。是个疯子。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 말 한마디를 하고는 안#ruby("방","房")으로 들어가버렸다. 나는 한켠에 드러누워서 #ruby("방","房")안 사람들의 #ruby("평|판","評|判")과 #ruby("분|위|기","雰|圍|氣")를 보면서 #ruby("왜","倭")놈의 #ruby("동|정","動|靜")을 살펴보았다. #ruby("방","房")안에서는 두 갈래 #ruby("논|쟁","論|爭")이 일어나기 시작했다. 그#ruby("중","中") #ruby("유|식","有|識")하게 보이는 #ruby("청|년","靑|年")들은 #ruby("주|인","主|人")의 말과 같이 나를 미친 사람이라 했고, #ruby("식|후|제|일|미","食|後|第|一|味")#footnote(numbering: _ => [56)])[#h(0.35em)밥 먹고 난 #ruby("후","後") 피우는 담배의 맛을 ‘#ruby("식|후|제|일|미","食|後|第|一|味")’라 #ruby("표|현","表|現")하였다.]로 긴 담뱃대를 붙여 물고 앉은 #ruby("노|인","老|人")들은 이 #ruby("청|년","靑|年")들을 나무라며 말했다.]
#zh[说了这一句，就进里屋去了。我躺在一边，看房里人的议论和气氛，观察那倭寇的动静。房里分成两派争论起来。看来有些见识的青年，和主人一样说我是疯子。嘴里咬着长烟袋、把饭后那一袋当作第一味抽着的老人们，责备这些青年说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보게, 말을 함부로 말게. 지금인들 #ruby("이|인","異|人")이 없으란 #ruby("법","法") 있겠나? 이런 #ruby("말|세","末|世")에는 마땅히 #ruby("이|인","異|人")이 나는 #ruby("법","法")일세.”]
#zh[“喂！不要随便讲话，现在难道就不会出异人了吗？在这年头，是一定会出现异人的啊！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("청|년","靑|年")들이 #ruby("대|번","大|番")에 그 말을 받아 대꾸했다.]
#zh[青年们立刻接过话来反驳：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("이|인","異|人")이 없을 리 없겠지만, 저 사람 생긴 꼴을 보세요. 무슨 #ruby("이|인","異|人")이 저렇겠어요?”]
#zh[“异人未必没有，可是请瞧瞧那个人的模样。哪有异人是那个样子的？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("왜","倭")놈은 #ruby("별","別")로 #ruby("주|의","注|意")하는 빛도 없이 #ruby("식|사","食|事")를 마치고 #ruby("중|문","中|門") 밖에 서서 #ruby("문","門")기둥을 #ruby("의|지","依|支")하고 #ruby("방","房")안을 들여다보며 #ruby("총|각","總|角")아이가 밥값 #ruby("계|산","計|算")하는 것을 지켜보고 있었다.]
#zh[那倭寇并没有一点特别注意我的神色，吃完饭后便到外面去，身体倚着门柱，看着年轻人结算饭钱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("서|서","徐|徐")히 몸을 일으켜 크게 #ruby("호|령","號|令")하며 그 #ruby("왜","倭")놈을 발길로 차서 거의 한 길이나 되는 #ruby("계|단","階|段") 밑으로 떨어뜨렸다. 그리고는 바로 쫓아 내려가서 놈의 목을 힘껏 밟았다.]
#zh[我认为时机已到，便慢慢站起来，大喊一声：]
#zh[“好小子！”]
#zh[一脚向那倭寇踢去，他滚到大约一丈远的台阶下面，我纵身跟着跳下，踩住他的脖子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[세 칸 #ruby("객|방","客|房")의 앞쪽 #ruby("출|입|문","出|入|門")이 아랫#ruby("방","房")에 한 짝, 가운뎃#ruby("방","房")의 #ruby("분|합|문","分|合|門")#footnote(numbering: _ => [57)])[#h(0.35em)나뉘었다 합쳐졌다 하는 #ruby("문","門").] 두 짝, 윗#ruby("방","房")에 한 짝, #ruby("합","合")해서 모두 네 짝인데, 이 #ruby("방|문","房|門") 네 짝이 #ruby("일|제","一|齊")히 열리면서 #ruby("문","門")마다 사람머리가 다투어 나왔다.]
#zh[三间客房前面的门，下房一扇，中间房的分合门两扇，上房一扇，一共四扇，这四扇门一齐打开，每个门口都争着探出人头。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 몰려나오는 사람들을 #ruby("향","向")하여 #ruby("간|단","簡|單")하게 한마디로 #ruby("선|언","宣|言")하였다.]
#zh[我向涌出来的人简单地宣布道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“누구든지 이 #ruby("왜","倭")놈을 #ruby("위","爲")해 내게 달려드는 #ruby("자","者")는 모두 죽이고 말리라.”]
#zh[“有谁敢为了这倭寇，出面和我作对的，定不饶他性命！听到了没有？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|언","宣|言")이 채 끝나기도 #ruby("전","前")에, #ruby("방|금","方|今") 내 발에 채이고 밟혔던 #ruby("왜","倭")놈이 새벽 달빛에 칼빛을 번쩍이며 달려들었다. 얼굴로 떨어지는 칼을 #ruby("피","避")하면서 발길로 #ruby("왜","倭")놈의 옆구리를 차서 거꾸러뜨리고 칼 잡은 손목을 힘껏 밟으니 칼이 저절로 땅바닥에 떨어졌다.#footnote(numbering: _ => [58)])[#h(0.35em)#ruby("신|문","新|聞")에서 #ruby("백|범","白|凡")은 #ruby("병|기","兵|器")도 #ruby("사|용","使|用")하였다고 #ruby("진|술","陳|述")했다. #ruby("즉","卽") 처음에는 돌로 #ruby("치|고","石|打"), 다음에는 나무로 #ruby[때렸으며][木擊], #ruby("도|망","逃|亡")가자 다시 나무로 #ruby[때렸다][以木連打].]]
#zh[话还没说完，刚才被我踢倒踩住的倭寇，在黎明的月光里刀光一闪扑了上来。我躲开劈向脸上的刀，一脚踢在他的腰窝，把他踢倒，用力踩住抓刀的手腕，刀自己掉在地上。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그 #ruby("왜","倭")놈을 머리로부터 발끝까지 #ruby("점|점","點|點")이 #ruby("난|도","亂|刀")질했다. 아직 2#ruby("월","月") 날씨라 마당은 #ruby("빙|판","氷|板")이었는데, 피가 샘솟듯 넘쳐서 마당으로 흘러내렸다. 나는 손으로 #ruby("왜","倭")놈의 피를 움켜 마시고, 그 피를 얼굴에 바르고, 피가 떨어지는 칼을 들고 #ruby("방","房")안으로 들어가 호통을 쳤다.]
#zh[我把那倭寇从头到脚乱刀刺去。还是二月天气，院子是冰，血像泉水涌出来，流到院子里。我用手掬起倭寇的血喝了，又把血涂在脸上，举起滴血的刀走进房里喝道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아까 #ruby("왜","倭")놈을 #ruby("위","爲")하여 내게 달려들려고 하던 놈이 누구냐?”]
#zh[“刚才跟那日本鬼子一个鼻孔出气的人是谁？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("방","房")안에 있던 #ruby("자","者")들 #ruby("중","中") 미처 #ruby("도|망","逃|亡")가지 못한 #ruby("자","者")들은 모두 엎드려서 빌기 바빴다.]
#zh[房里来不及逃走的人，全都趴着求饶。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("장|군","將|軍")님, 살려주시오. 나는 그놈이 #ruby("왜","倭")놈인 줄 모르고 #ruby("보|통","普|通") 싸움으로만 알고 말리려고 나갔던 것입니다.”]
#zh[“将军，饶命。我不知道他是倭寇，只当是普通打架，才出去劝的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[또 어떤 사람은 이렇게 말했다.]
#zh[又有人这样说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 어제 배 위에서 #ruby("장|군","將|軍")님과 같이 #ruby("고|생","苦|生")하던 장사꾼입니다. #ruby("왜","倭")놈과 같이 오지도 않았습니다.”]
#zh[“我是昨天在船上和将军一起吃苦的买卖人，并不是和倭寇一起来的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("노|인","老|人")들은 #ruby("겁","怯")이 나서 벌벌 떨면서도 아까 #ruby("청|년","靑|年")들을 #ruby("책|망","責|望")하며 나를 #ruby("편","便")들어 준 일로 떳떳이 가슴을 내밀고 말했다.]
#zh[所有的人都惶恐不迭，只有刚才责骂那些年轻人，为我辩护的老年人，挺身而出，为他人求情：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("장|군","將|軍")님, 아직 #ruby("지|각","知|覺")이 없는 #ruby("청|년","靑|年")들을 #ruby("용|서","容|恕")하십시오.”]
#zh[“将军，请宽恕这些还没有见识的青年。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이러는 가운데, #ruby("주|인","主|人") #ruby("이|화|보","李|和|甫")가 왔다. 그는 #ruby("감","敢")히 #ruby("방","房")안에 들어오지도 못하고 #ruby("방","房") 바깥에 엎드려서 빌었다.]
#zh[这时候主人李和甫来了。他不敢进房，趴在门外求告：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("소|인","小|人")이 눈은 있지만 눈#ruby("동|자","瞳|子")가 #ruby[없어][有目無珠] #ruby("장|군","將|軍")님을 #ruby("멸|시","蔑|視")하였으니, 그 #ruby("죄","罪") 죽어도 #ruby("여|한","餘|恨")은 없습니다. 그러나 저 #ruby("왜","倭")놈에게는 다만 밥 팔아먹은 #ruby("죄","罪")밖에 없습니다. 아까 #ruby("장|군","將|軍")님을 #ruby("능|욕","凌|辱")하였으니 죽어도 마땅합니다.”]
#zh[“小人有眼无珠，因此不认得您是谁，冒犯将军，罪该万死。虽然如此，我跟那倭寇并没有任何关系，只是卖饭给他罢了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("방","房")안에 꿇어 엎드린 채 떨고 있는 사람들을 #ruby("향","向")하여 일어나 앉으라고 #ruby("명","命")하고 #ruby("주|인","主|人") #ruby("이|화|보","李|和|甫")에게 물었다.]
#zh[我吩咐房里跪着发抖的人起来坐下，问主人李和甫：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 그놈이 #ruby("왜","倭")놈인 것은 어떻게 알았느냐?”]
#zh[“你怎么知道他是倭寇？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("소|인","小|人")이 나루터 #ruby("객|주","客|主")를 하는 탓에 #ruby("진|남|포","鎭|南|浦")로 #ruby("내|왕","來|往")하는 #ruby("왜|인","倭|人")들이 #ruby("종|종","種|種") 제 집에서 자고 다닙니다. 그러나 #ruby("한|복","韓|服")을 입고 오는 #ruby("왜|인","倭|人")은 오늘 처음 봅니다.”]
#zh[“小人在渡口做客主，来往镇南浦的倭人常在我家住宿。可是穿着韩服来的倭人，今天是头一回。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 다시 물었다.]
#zh[我又问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이 #ruby("왜|인","倭|人")은 #ruby("복|색","服|色")뿐만 아니라 #ruby("조|선","朝|鮮")말도 #ruby("능","能")한데 네 어찌 #ruby("왜|인","倭|人")인 줄 알았느냐?”]
#zh[“这倭人不但衣装，朝鲜话也很能说，你怎么知道他是倭人？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“몇 #ruby("시|간","時|間") #ruby("전","前")에 #ruby("황|주","黃|州")로부터 온 #ruby("목|선","木|船") 한 #ruby("척","隻")이 #ruby("포|구","浦|口")에 들어왔는데, 뱃사람들의 말이 #ruby("일|본","日|本") #ruby("영|감","令|監") 한 분을 태워왔다고 하기에 알았습니다.”]
#zh[“几个钟头前，从黄州来了一艘木船进了浦口，听船夫们说载了一位日本老爷，所以知道了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그 #ruby("목|선","木|船")이 아직 #ruby("포|구","浦|口")에 머물러 있느냐?”]
#zh[“那木船还停在浦口吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇습니다.”]
#zh[“是的。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그 뱃사람을 데려오라고 하였다.]
#zh[我吩咐把那些船夫带来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이와 같이 #ruby("문|답","問|答")하는 가운데, 눈치 빠른 #ruby("이|화|보","李|和|甫")는 #ruby("일|변","一|邊") #ruby("세|면|도|구","洗|面|道|具")들을 들여오고, 그런 다음 밥 일곱 그릇을 한 #ruby("상","床")에 놓고, 다른 한 #ruby("상","床")에는 #ruby("반|찬","飯|饌")을 차려 들여놓고서 먹기를 #ruby("청","請")하였다. 나는 얼굴을 씻고 밥을 먹게 되었다.]
#zh[这样问答之间，眼快的李和甫一面端进洗脸的家什，然后一桌上放了七碗饭，另一桌上摆了菜，请我吃。我洗了脸，吃起饭来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[밥 한 그릇을 먹은 지 10#ruby("분","分") #ruby("정|도","程|度")밖에 안되었으나, #ruby("과|격","過|激")한 #ruby("행|동","行|動")을 한 뒤라서 한 두 그릇쯤은 더 먹을 수 있었다. 그러나 일곱 그릇까지 먹는다는 것은 #ruby("무|리","無|理")였다. 그래도 애시#ruby("당|초","當|初") 일곱 그릇을 더 #ruby("요|구","要|求")한 것이 거짓말로 알려져서는 재미없는 일이라 큰 양푼 한 #ruby("개","個")를 #ruby("청","請")하여 밥과 #ruby("반|찬","飯|饌")을 한 군데에다 붓고 숟가락 한 #ruby("개","個")를 더 #ruby("청","請")하였다. 숟가락 두 #ruby("개","個")를 포개 들고서 밥 한 덩이가 #ruby("사|발|통","沙|鉢|桶")만큼씩 되게 밥을 떠먹었다. 곁에서 보는 사람 생각으로는 몇 #ruby("번","番")만 더 뜨면 그 밥을 다 먹겠구나 하도록 보기 좋게 한 두어 그릇 #ruby("분|량","分|量")을 먹다가 숟갈을 던지고 혼잣말로 중얼거렸다.]
#zh[吃完一碗饭不过十分钟，可是刚做过激烈的动作，再吃一两碗也不难，七碗却吃不下。可是当初再要七碗若被看成谎话，就没意思了。于是要了一个大盆，把饭和菜倒在一处，又要了一把匙子。两把匙子叠着，一舀就是沙钵那么大的一块。让旁边看的人觉得再舀几下就吃完了，好看地吃了大约两碗，扔下匙子，自言自语道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘은 먹고 싶던 #ruby("원|수","怨|讐")의 피를 많이 먹었더니 밥이 들어가지를 않는다.”]
#zh[“今天喝日本鬼子的血喝得真是痛快，连饭也不想吃了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("식|사","食|事")를 마치고 일의 #ruby("조|처","措|處")에 #ruby("착|수","着|手")했다.]
#zh[吃完饭，着手处置事情。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈을 싣고 온 뱃사람 7#ruby("명","名")이 #ruby("문","門") 앞에 엎드려 #ruby("죄","罪")를 #ruby("청","請")하였다.]
#zh[载那倭寇来的七名船夫跪在门前请罪。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("소|인","小|人")들은 #ruby("황|주","黃|州")에 사는 뱃사람들인데 #ruby("왜","倭")놈을 싣고 #ruby("진|남|포","鎭|南|浦")까지 뱃삯을 #ruby("작|정","作|定")하여 가던 #ruby("죄","罪")밖에 없습니다.”]
#zh[“小人们是黄州船工，我们只是赚他的船钱，求求您饶了我们吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 뱃사람들에게 #ruby("명","命")하여 #ruby("왜","倭")놈의 #ruby("소|지|품","所|持|品") #ruby("전|부","全|部")를 가지고 오도록 했다. #ruby("소|지|품","所|持|品")을 #ruby("조|사","調|査")해 본 #ruby("결|과","結|果"), 그 #ruby("왜|인","倭|人")은 #ruby("쓰치다","土田讓亮")라는 #ruby("자","者")였고 #ruby("직|위","職|位")는 #ruby("육|군","陸|軍") #ruby("중|위","中|尉")였다.#footnote(numbering: _ => [59)])[#h(0.35em)#ruby("일|본","日|本") #ruby("외|무|성","外|務|省") #ruby("자|료","資|料")에 #ruby("의","依")하면 #ruby("쓰치다","土田")는 #ruby("나가사키","長崎")#ruby("현","縣") #ruby("대|마|도","對|馬|島") #ruby("이즈하라","嚴原")#ruby("항","港") #ruby("상|인","商|人")으로, 1895#ruby("년","年") 10#ruby("월","月") #ruby("진|남|포","鎭|南|浦")에 #ruby("도|착","到|着")한 #ruby("후","後") 11#ruby("월","月") 4#ruby("일","日") #ruby("황|해|도","黃|海|道") #ruby("황|주","黃|州")로 가서 #ruby("활|동","活|動")하였고, 1896#ruby("년","年") 3#ruby("월","月") 7#ruby("일","日") #ruby("진|남|포","鎭|南|浦")로 #ruby("귀|환","歸|還")하던 길이었다.] 가진 돈이 #ruby("엽|전","葉|錢") 800#ruby("냥","兩") 남짓 되었다. 그 돈으로 뱃삯을 #ruby("지|불","支|拂")하고, #ruby("이|화|보","李|和|甫")를 시켜 동네의 #ruby("동|장","洞|長")을 불러오라 했다. 그러자 #ruby("이|화|보","李|和|甫")가 말하기를,]
#zh[我命船夫把倭寇的随身物品全部拿来。查过之后，那倭人名叫土田让亮，职位是陆军中尉。带着的钱有叶钱八百多两。用那钱付了船钱，又叫李和甫把村里的洞长叫来。李和甫说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("소|인","小|人"), #ruby("명|색","名|色")이 #ruby("동|장","洞|長")이올시다.”]
#zh[“小人，名分上就是洞长。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[했다. 동네의 #ruby("극|빈","極|貧")한 집에 그 나머지 돈을 모두 나눠주라고 #ruby("명|령","命|令")했다.#footnote(numbering: _ => [60)])[#h(0.35em)#ruby("규|장|각","奎|章|閣") #ruby("재|판|자|료","裁|判|資|料")에 #ruby("의","依")하면 #ruby("백|범","白|凡")은 75#ruby("냥","兩")으로 타고 갈 #ruby("당","唐")나귀를 #ruby("구|입","購|入")하고, 나머지 800#ruby("냥","兩")은 #ruby("동|민","洞|民")에게 나누어 주라고 #ruby("이|화|보","李|和|甫")에게 어음을 바꿔 맡겼다. 이 800#ruby("냥","兩")은 나중에 #ruby("일|본","日|本") #ruby("영|사|관","領|事|館") #ruby("경|찰","警|察")에 #ruby("의","依")해 거의 #ruby("전|액","全|額") #ruby("회|수","回|收")되었다. #ruby("이|후","以|後") #ruby("재|판","裁|判")에서도 돈 #ruby("문|제","問|題")는 #ruby("강|도","强|盜") #ruby("행|위","行|爲") #ruby("여|부","與|否")를 #ruby("판|단","判|斷")하는 #ruby("중|요","重|要")한 #ruby("쟁|점","爭|點")으로 #ruby("부|각","浮|刻")되었다.]]
#zh[他说了。我命令把剩下的钱全部分给村里极穷的人家。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("왜","倭")놈의 #ruby("시|체","屍|體")는 어찌하오리까?”]
#zh[“倭寇的尸体怎么办？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 물으므로 이렇게 #ruby("분|부","分|付")하였다.]
#zh[他问，我这样吩咐：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("왜","倭")놈들은 우리 #ruby("조|선","朝|鮮")의 사람들뿐 아니라 모든 #ruby("생|물","生|物")들의 #ruby("원|수","怨|讐")니, 바다 속에 던져서 물고기와 자라들까지 즐겁게 뜯어먹도록 하라.”]
#zh[“倭寇不只是我们朝鲜人的仇敌，也是一切生物的仇敌，扔进海里，让鱼和鳖也痛快地撕着吃。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런 다음 #ruby("이|화|보","李|和|甫")에게 #ruby("필|기","筆|具")를 갖고 오게 해서 몇 줄의 #ruby("포|고|문","布|告|文")을 썼다. 먼저 #ruby("왜","倭")놈 죽인 #ruby("이|유","理|由")를 “#ruby("국|모|보|수","國|母|報|讐")의 #ruby("목|적","目|的")으로 이 #ruby("왜|인","倭|人")을 죽이노라”라고 밝히고, 마지막 줄에 “#ruby("해|주","海|州") #ruby("백|운|방","白|雲|坊") 텃골 #ruby("김|창|수","金|昌|洙")”라 써서 사람들이 지나다니는 길거리 #ruby("벽","壁")에 붙였다.#footnote(numbering: _ => [61)])[#h(0.35em)#ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에 #ruby("의","依")하면 이때 #ruby("백|범","白|凡")은 1895#ruby("년","年") #ruby("중|국|행","中|國|行")에서 #ruby("서|경|장","徐|慶|璋")으로부터 받은 ‘#ruby("의|병|좌|통|령","義|兵|左|統|領")’이란 #ruby("임|명|장","任|命|狀")도 내보였다.]]
#zh[然后叫李和甫拿来笔砚，写了几行布告。先写明杀死倭寇的理由：“为了给国母报仇，杀死这个倭人。”末行写上“海州白云坊基洞金昌洙”，贴在行人来往的路旁墙壁上。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리고 다시 #ruby("이|화|보","李|和|甫")에게 #ruby("명|령","命|令")하였다.]
#zh[又命令李和甫：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 이 동네 #ruby("동|장","洞|長")이니 #ruby("안|악","安|岳") #ruby("군|수","郡|守")에게 #ruby("사|건","事|件")의 #ruby("전|말","顚|末")을 #ruby("보|고","報|告")하라. 나는 내 집으로 돌아가서 #ruby("연|락","下|回")을 기다리겠다. #ruby("기|념","紀|念")으로 #ruby("왜","倭")놈의 칼은 내가 가지고 가겠다.”]
#zh[“你是这村的洞长，把事件的始末报告安岳郡守。我回家等消息。倭寇的刀，我作纪念带走。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("출|발","出|發")하려고 보니, #ruby("전|신","全|身") #ruby("의|복","衣|服")꼴이 말이 아니었다. 흰옷이 피로 물들어 붉은 옷으로 #ruby("변","變")해 있었다. #ruby("다|행","多|幸")히도 벗어 걸어두었던 두루마기가 있었으므로 그것을 입고 허리에 칼을 찼다. #ruby("한","閑")가로워 보이는 #ruby("태|도","態|度")로 #ruby("행|객","行|客")들과 동네사람 #ruby("수|백","數|百") #ruby("명","名")이 모여 쳐다보는 사이를 지나 #ruby("귀|로","歸|路")에 올랐다. 겉으로는 #ruby("태|연|자|약","泰|然|自|若")하였으나 마음속으로는 매우 #ruby("조|급","躁|急")하였다. #ruby("만|약","萬|若") 동네사람들이 가지 못하게 막는다면, #ruby("사|실","事|實")을 #ruby("설|명","說|明")할 #ruby("기|회","機|會")도 없이 #ruby("왜","倭")놈들이 와서 나를 죽이고 말 것이다.]
#zh[正要出发，一看全身衣服不成样子。白衣被血染成了红衣。幸好有一件脱下来挂着的长袍，便穿上，腰里佩了刀。作出闲暇的样子，从行客和村里几百人围观的中间走上归路。外表泰然，心里却非常急。万一村里人不让走，还没机会说明事实，倭寇就会来把我杀死。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("복|수","復|讐")를 하였든지 무엇을 하였든지 우리 동네에서 #ruby("살|인","殺|人")을 하였으니 네 스스로 일을 #ruby("해|결","解|決")하고 가라.”]
#zh[“你报了仇也好，做了什么也好，你在我们村里杀了人，自己把事情了结了再走。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("만|약","萬|若") 이렇게 나온다면 어떻게 할 것인가? #ruby("물|론","勿|論") 이것은 내 생각이었을 뿐이지, 그 사람들 #ruby("중","中") 아무도 내게 그런 말을 할 #ruby("자","者")는 없었을 것이다.]
#zh[万一他们这样说，怎么办？当然这只是我的想法，那些人里面不会有人对我说这种话。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[발길을 일부러 천천히 옮겨 고개 위에 올라서서 곁눈으로 #ruby("치|하|포","鴟|河|浦")를 내려다보니, 사람들이 #ruby("여|전","如|前")히 모여 서서 내가 가는 것을 구경하고 있었다. #ruby("시|간","時|間")은 어느덧 흘러 아침해가 높이 올라와 있었다.]
#zh[我故意把脚步放慢，走上坡顶，斜眼俯视鸥河浦，人们还聚着看我走。时间已经过去，早晨的太阳高高升起来了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[고개를 넘은 #ruby("후","後")에는 빠른 걸음으로 #ruby("신|천|읍","信|川|邑")에 #ruby("도|착","到|着")하였다. 그날은 #ruby("신|천|읍","信|川|邑") #ruby("장","場")날이었다. #ruby("시|장","市|場") 이곳 저곳에서 #ruby("치|하|포","鴟|河|浦") 이야기가 들렸다.]
#zh[过了坡，快步到了信川邑。那天是信川的集日。市场上到处听见鸥河浦的话。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘 새벽 #ruby("치|하|포","鴟|河|浦") 나루에 어떤 #ruby("장|사","壯|士")가 나타나서 #ruby("일|본","日|本")사람을 한 주먹으로 때려 죽였다지.”]
#zh[“今天黎明，鸥河浦渡口来了个壮士，一拳把日本人打死了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그래, 그 #ruby("장|사","壯|士")하고 같이 #ruby("용|강","龍|岡")에서부터 배를 타고 왔다는 사람을 만났는데, 나이 스물도 채 못 되어 보이는 #ruby("소|년","少|年")이더라는군. #ruby("강","江") 위로 #ruby("빙|산","氷|山")이 몰려와서 배가 그 사이에 끼여 다 죽게 되었는데, 그 #ruby("소|년","少|年") #ruby("장|사","壯|士")가 큰 #ruby("빙|산","氷|山")을 손으로 밀어내고 배에 탄 사람들을 다 살렸다던데. 게다가 그 #ruby("장|사","壯|士")는 밥 일곱 그릇을 눈 깜짝할 사이에 다 먹더라는걸.”]
#zh[“是啊，我遇见个从龙冈和他同船来的人，说那壮士看来还不到二十岁。江上冰山涌来，船夹在中间，眼看都要死了，那个少年壮士用手推开大冰山，把船上的人都救了。而且那壮士眨眼之间吃了七碗饭。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 말을 듣다가 #ruby("신|천","信|川") #ruby("서|부","西|部")에 사는 #ruby("동|학|당","東|學|黨") #ruby("친|구","親|舊") #ruby("유|해|순","柳|海|純")을 찾아갔다. #ruby("유|씨","柳|氏")가 한참 #ruby("후","後")에 “#ruby("형","兄")의 몸에서 피비린내가 난다” 하며 #ruby("자|세","仔|細")히 보더니, “#ruby("의|복","衣|服")에 웬 피가 이다지 많이 묻었소?” 하고 물었다. 나는 #ruby("대|강","大|綱") 둘러댔다.]
#zh[听着这些话，我去找住在信川西部的东学朋友柳海纯。过了好一会，柳氏说“兄身上有血腥气”，仔细一看，问：“衣服上怎么沾了这么多血？”我大致搪塞过去。]
#zh[“你衣服上怎么沾满了血迹？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“길에 오다가 왜가리 한 마리를 잡아먹었더니 피가 묻었소이다.”]
#zh[我毫不在意地说：]
#zh[“我杀了一只鸟吃了，沾上了血迹。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("유|씨","柳|氏")는 다시 물었다.]
#zh[可是柳氏又问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그 칼은 웬 것이오?”]
#zh[“那刀是怎么回事？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보, #ruby("노|형","老|兄")이 #ruby("동|학","東|學") #ruby("접|주","接|主") 노릇할 적에 남의 돈을 많이 #ruby("강|탈","强|奪")하여 두었다는 말을 듣고 내가 #ruby("강|도","强|盜")질하러 왔소.”]
#zh[“老兄当东学接主时抢了人家很多钱，现在我抢你的钱来了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("유|씨","柳|氏")는 또다시 물으며, #ruby("사|실","事|實") 이야기를 하라고 졸랐다.]
#zh[可是柳氏又追问，催我说实话。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|학","東|學") #ruby("접|주","接|主")가 아니고서 그런 말을 하여야 믿지요. 어서 #ruby("사|실","事|實")대로 말해보시오.”]
#zh[“不是东学接主，说这种话我才不信。快照实说吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("대|강","大|綱") 지난 일을 말해 주었다. 내 이야기를 들은 #ruby("유|해|각","柳|海|珏")·#ruby("유|해|순","柳|海|純") #ruby("형|제","兄|弟")는 크게 놀라면서, #ruby("과|연","果|然") #ruby("쾌|남|아","快|男|兒")다운 #ruby("행|동","行|動")이라 하였다. 그리고 내게 #ruby("강|권","强|勸")하기를, #ruby("본|가","本|家")로는 가지 말고 다른 곳으로 #ruby("피|신","避|身")하라 하였다. 그러나 나는 #ruby("절|대","絶|對")로 그렇게 할 수 없다고 말하였다.]
#zh[我无奈说了大致的经过，柳海珏、柳海纯兄弟大惊，夸我是快男儿之所为，并力劝我不要回家乡，躲到别处去。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“사람의 일은 모름지기 밝고 떳떳하여야 하오. 그래야 사나 죽으나 값이 있지, #ruby("세|상","世|上")을 속이고 #ruby("구|차","苟|且")히 사는 것은 사나이 #ruby("대|장|부","大|丈|夫")가 할 일이 아니오.”]
#zh[我说决不能那样做，为人要光明正大，生或死才有价值，欺世骗人，苟且偷生，非大丈夫所为。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[곧 떠나서 집으로 돌아왔다. 아버님께 그 동안 있었던 일을 #ruby("일|일","一|一")이 #ruby("보|고","報|告")하니 #ruby("부|모","父|母")님 #ruby("역|시","亦|是") #ruby("피|신","避|身")할 것을 애써 #ruby("권","勸")하셨다. 그러나 나는 이#ruby("번","番")에 내가 #ruby("왜","倭")놈을 죽인 것은 #ruby("사|사","私|私")로운 #ruby("감|정","感|情")으로 한 일이 아니라 #ruby("국|가|적","國|家|的")인 #ruby("수|치","羞|恥")를 씻기 #ruby("위","爲")해 #ruby("행","行")한 일이니 #ruby("정|정|당|당","正|正|堂|堂")하게 #ruby("대|처","對|處")하겠다고 말씀드렸다.]
#zh[随即动身回到家里。把这期间的事一一禀告父亲，父母也极力劝我躲避。可是我说，这次杀倭寇不是出于私情，是为洗刷国家的羞耻，要正正当当地对付。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("피|신","避|身")할 마음이 있었다면 애시#ruby("당|초","當|初") 그런 일을 하지 않았을 것입니다. 이미 #ruby("실|행","實|行")한 #ruby("이|상","以|上") #ruby("자|연","自|然")히 #ruby("법|사","法|司")에서 #ruby("사|법|적","司|法|的")인 #ruby("조|치","措|處")가 있을 터이니 그에 따르도록 하겠습니다. 이 한 몸 #ruby("희|생","犧|牲")하여 #ruby("만|인","萬|人")을 #ruby("교|훈","敎|訓")할 수 있다면 죽어도 #ruby("영|광","榮|光")된 일입니다. 제 #ruby("소|견","所|見")으로는 집에 앉아서 마땅히 당할 일을 당하는 것이 #ruby("의","義")로운 일이라 생각합니다.”]
#zh[“若有心躲避，当初就不会做那种事。既然已经做了，法司会有司法上的处置，我愿意听从。这一身若能牺牲了教训万人，死了也光荣。依我所见，坐在家里承受该承受的，才是义。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아버님도 다시 #ruby("강|권","强|勸")을 아니하시고 이런 말씀을 하셨다.]
#zh[父亲不再强劝，这样说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내 집이 #ruby("흥","興")하든 #ruby("망","亡")하든 네가 알아 하여라。”]
#zh[“我家是兴是亡，你自己看着办吧。”]
#heading(level: 3)[#text(font: "KOPUSGo B")[5) 첫#ruby("번","番")째 #ruby("투|옥","投|獄")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그럭저럭 석 달이 넘도록 아무 #ruby("소|식","消|息")이 없더니, #ruby("병|신|년","丙|申|年") 5#ruby("월","月") 11#ruby("일","日") 아직 잠자리에서 일어나기도 전인데 어머님이 #ruby("급","急")히 #ruby("사|랑","舍|廊") #ruby("문","門")을 열고 말씀하셨다.]
#zh[就这样过了三个多月，一点消息也没有。丙申年五月十一日，我还没起床，母亲急忙打开客房的门说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“얘, 우리집 앞뒤에 #ruby("전","前")에 보지 못하던 사람들이 와서 #ruby("수","數")없이 둘러서 있다.”]
#zh[“孩子，我们家前后来了从前没见过的人，无数地围着。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 말씀이 끝나자마자 #ruby("수|십","數|十") #ruby("명","名")이 #ruby[쇠채찍][鐵鞭]과 #ruby[쇠몽둥이][鐵椎]를 가지고 달려들면서 물었다.]
#zh[话刚说完，几十个人拿着铁鞭和铁椎冲进来问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("김|창|수","金|昌|洙")냐?”]
#zh[“你是金昌洙吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 그렇거니와 그대들은 무엇 하는 사람들인데 이같이 #ruby("요|란","擾|亂")하게 #ruby("인|가","人|家")에 #ruby("침|입","侵|入")하는가?”]
#zh[“我便是。你们是干什么的，这样吵闹闯进人家？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그들은 그제야 #ruby("내|무|부|령","內|務|部|令")을 #ruby("등|인","等|因")한 #ruby("체|포|장","逮|捕|狀")#footnote(numbering: _ => [62)])[#h(0.35em)#ruby("내|무|부","內|務|部")에서 온 #ruby("공|문","公|文")의 #ruby("내|용","內|容"). #ruby("등|인","等|因")은 #ruby("공|문","公|文") #ruby("내|용","內|容")을 #ruby("요|약","要|約")할 때 쓰는 말. ‘……#ruby("등","等")의 #ruby("사|실","事|實")에 #ruby[의한][因]’ #ruby("체|포|장","逮|捕|狀").]을 보여주고, 나를 #ruby("압|송","押|送")해서 #ruby("해|주","海|州")로 길을 떠났다. #ruby("순|검","巡|檢")과 #ruby("사|령","使|令")이 모두 30#ruby("여","餘") #ruby("명","名")이요, 내 몸은 쇠사슬로 여러 겹 동여졌다. 몇 사람은 앞뒤에 서서 쇠사슬 끝을 잡았고, 그 나머지는 #ruby("좌|우","左|右")로 나를 에워싼 채 길을 갔다.]
#zh[他们这才拿出内务部令等因的逮捕状给我看，押着我上路往海州。巡检和使令一共三十多名，我身上用铁链缠了好几道。几个人前后拉着链子头，其余的左右围着我走。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한 동네에 있는 20#ruby("여","餘") #ruby("호","戶") #ruby("전|부","全|部")가 #ruby("문|중","門|中")사람들이었으나, 두려워하여 한 사람도 #ruby("감","敢")히 내다보지를 못하였다. #ruby("인|근","隣|近") 동네의 #ruby("강|씨","姜|氏")·#ruby("이|씨","李|氏")들은 #ruby("김|창|수","金|昌|洙")가 #ruby("동|학","東|學")한 #ruby("죄","罪")로 붙잡혀 가는 줄 알고 수군거렸다.]
#zh[一个村里二十多户全是门中的人，却怕得没有一个敢探头看。邻近村里的姜氏、李氏以为金昌洙是因东学的罪被抓走，交头接耳。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이틀 만에 #ruby("해|주|옥","海|州|獄")에 들어갔다. 어머님과 아버님이 다 #ruby("해|주","海|州")로 오셔서, 어머님은 밥을 빌어다가 먹여 주시는 #ruby("옥","獄")바라지를 하셨고, 아버님은 #ruby("전","前")에 #ruby("당|신","當|身")이 늘 그러셨듯이 넉넉지 못한 #ruby("사|령|청","使|令|廳")·#ruby("영|리|청","營|吏|廳")·#ruby("계|방","契|房") 사람들에게 #ruby("교|섭","交|涉")하러 다니시며 나를 풀어주려고 애쓰셨다. 그러나 #ruby("시|세","時|勢")가 #ruby("이|전","以|前")과 달라졌고, #ruby("사|건","事|件")이 하도 #ruby("중|대","重|大")하여 아무 #ruby("효|과","效|果")가 없었다.]
#zh[过了两天，我被下在海州监狱。父母亲都来到海州，母亲以到处乞讨来的一些食物照顾狱中的我，父亲则像以前那样，奔走于营吏厅、使令厅、禊房，运用一切人情关系，希望我能被释放，可是因为案情重大，终究没有任何效果。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥","獄")에 갇힌 #ruby("후","後") 한 달#ruby("여","餘")에 #ruby("신|문","訊|問")이 #ruby("시|작","始|作")되었다.#footnote(numbering: _ => [63)])[#h(0.35em)#ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에 #ruby("의","依")하면 #ruby("신|문|일","訊|問|日")은 1896#ruby("년","年") 6#ruby("월","月") 27#ruby("일","日")\(#ruby("음|력","陰|曆") 5#ruby("월","月") 16#ruby("일","日"))이다.] 나는 #ruby("옥","獄")에서 쓰던 #ruby("대|전|목","大|全|木") 칼#footnote(numbering: _ => [64)])[#h(0.35em)#ruby("옥|구","獄|具")의 하나. 마른 나무널#ruby("판","板")으로 만든 #ruby("형","刑")틀로 #ruby("죄|수","罪|囚")의 목에 씌워 #ruby("보|행","步|行")을 #ruby("불|가|능","不|可|能")하게 한 것.]을 목에 걸고 #ruby("선|화|당","宣|化|堂") 뜰에 들어갔다.]
#zh[下狱一个多月，审问开始了。我脖子上套着狱里用的大全木枷，进了宣化堂的院子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|리","監|理") #ruby("민|영|철","閔|泳|喆")이 물었다.]
#zh[监理闵泳喆问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("안|악","安|岳") #ruby("치|하|포","鴟|河|浦")에서 #ruby("일|본","日|本")사람을 #ruby("살|해","殺|害")하고 #ruby("도|적","盜|賊")질을 하였다는데, #ruby("사|실","事|實")이냐?”]
#zh[“据说你在安岳鸥河浦杀害了日本人，并且抢了他的行李，是吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그런 일 없소.”]
#zh[“没有那回事。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네 #ruby("행|적","行|蹟")의 #ruby("증|거","證|據")가 #ruby("분|명","分|明")한데 #ruby("부|인","否|認")을 하느냐?”]
#zh[“你的行迹证据分明，还要否认吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("형","刑")을 #ruby("집|행","執|行")하라는 #ruby("호|령","號|令")이 나자, #ruby("사|령","使|令")들이 내 두 발과 두 무릎을 한데 찬찬히 동이고, 다리 사이에 붉은 #ruby[몽둥이][朱杖] 두 #ruby("개","個")를 들이밀었다. 한 놈이 몽둥이 한 #ruby("개","個")씩을 잡고 #ruby("좌|우","左|右")를 힘껏 누르니 #ruby("단|번","單|番")에 뼈가 허옇게 드러났다.#footnote(numbering: _ => [65)])[#h(0.35em)#ruby("속|칭","俗|稱") ‘주리를 튼다’는 #ruby("고|문","拷|問")으로 #ruby("정|식","正|式") #ruby("명|칭","名|稱")은 ‘#ruby("전|도|주|뢰|형","剪|刀|朱|牢|刑")’. #ruby("해|주|부","海|州|府")도 ‘#ruby("악|형","惡|刑")을 하였지만 #ruby("김|창|수","金|昌|洙")가 #ruby("범|행","犯|行")을 #ruby("부|인","否|認")하였다’고 #ruby("보|고","報|告")하였다.] 내 왼다리 정강마루에 있는 큰 #ruby("상|처","傷|處")자국이 바로 이때 생긴 것이다.]
#zh[一声下令用刑，使令们把我两脚和两膝紧紧捆在一起，腿中间插进两根红杖。一人抓一根，左右用力压，一下子骨头就白生生地露了出来。我左腿胫骨上的大伤疤，就是这时候留下的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 입을 꾹 다물고 아무 말도 하지 않고 있다가, #ruby("결|국","結|局") #ruby("기|절","氣|絶")하고 말았다. 그러자 #ruby("잠|시","暫|時") #ruby("형","刑")을 #ruby("중|지","中|止")하고 얼굴에 찬물을 끼얹어 #ruby("회|생","回|生")시키고는 다시 물었다. 나는 #ruby("감|리","監|理")를 보고 말했다.]
#zh[我紧闭着嘴，一句话也不说，终于昏过去了。他们暂时停刑，把冷水泼在脸上使我苏醒，又问。我看着监理说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("본|인","本|人")의 #ruby("체|포|장","逮|捕|狀")을 보면 #ruby("내|무|부","內|務|部") #ruby("훈|령","訓|令") #ruby("등|인","等|因")이라 되어 있으니, #ruby("본|관|찰|부","本|觀|察|府")에서 #ruby("처|리","處|理")할 수 없는 #ruby("사|건","事|件")이 아니오? #ruby("내|무|부","內|務|部")에 #ruby("보|고","報|告")만 하여 주시오.”]
#zh[“看本人的逮捕状，写着内务部训令等因，这不是本观察府可以处理的案件吗？只请报告内务部。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러자 다시는 아무 말도 하지 않고 도로 #ruby("하|옥","下|獄")시켜 버리고 말았다.]
#zh[于是再也不说什么，又把我关进监牢。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때로부터 #ruby("근","近") 두 달이 지났다. 7#ruby("월","月") #ruby("초","初") #ruby("인|천","仁|川") #ruby("감|리|영","監|理|營")#footnote(numbering: _ => [66)])[#h(0.35em)#ruby("개|항|장","開|港|場")의 #ruby("통|상","通|商")·#ruby("행|정","行|政") #ruby("업|무","業|務")는 #ruby("물|론","勿|論") #ruby("치|안","治|安") #ruby("유|지","維|持")와 #ruby("재|판","裁|判") #ruby("업|무","業|務")까지 #ruby("담|당","擔|當")하였다. 1883#ruby("년","年") #ruby("부|산","釜|山")·#ruby("인|천","仁|川")·#ruby("원|산","元|山") 3#ruby("개","個") #ruby("개|항|장","開|港|場")에 #ruby("설|치","設|置")되었으며 1906#ruby("년","年")에 #ruby("폐|지","廢|止")되었다. #ruby("감|리|서","監|理|署")라고도 한다.]에서 네댓 #ruby("명","名")의 #ruby("순|검","巡|檢")이 #ruby("해|주","海|州")로 와서 나를 데려갔다. #ruby("사|태","事|態")가 이 #ruby("지|경","地|境")이 되자 아버님은 #ruby("고|향","故|鄕")에 있는 집과 #ruby("세|간","世|間")살이를 다 팔아가지고 #ruby("인|천","仁|川")이든지 서울이든지 내가 가는 대로 따라다니며 일이 되어 가는 #ruby("상|황","狀|況")을 보시기로 하고 #ruby("일|단","一|旦") #ruby("고|향","故|鄕")으로 가셨다. 어머님만 나를 따라서 #ruby("인|천","仁|川")으로 #ruby("동|행","同|行")하셨다.]
#zh[以后又过了两个月，在七月初，从仁川监理营来了四五名巡检，将我从海州押送到仁川。]
#zh[事情已到这个地步，我被释回家已是无望，于是父亲决定要变卖全部家产，随我去仁川或汉城，设法营救，为我脱罪，为此又回到家中，只有母亲随我而行。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날은 #ruby("연|안|읍","延|安|邑")에서 하룻밤 자고, 다음날 #ruby("나|진|포","羅|津|浦")#footnote(numbering: _ => [67)])[#h(0.35em)#ruby("연|안|읍","延|安|邑")의 #ruby("남","南")쪽 #ruby("해|안","海|岸")에 있는 #ruby("항|구","港|口")로 #ruby("강|화|도","江|華|島") #ruby("최|북|단","最|北|端")과 마주보고 있다.]로 #ruby("향","向")하였다. 가는 #ruby("도|중","途|中") #ruby("연|안|읍","延|安|邑")에서 #ruby("약","約") 5#ruby("리","里")쯤 되는 길가 무덤 곁에서 #ruby("잠|시","暫|時") 쉬게 되었다. 날씨가 몹시 더웠으므로 #ruby("순|검","巡|檢")들은 참외를 사서 먹으며 앉아 다리를 쉬었다. 무덤 곁에 세워 둔 #ruby("비|문","碑|文")을 보니, 孝子李昌梅之墓（‘#ruby("효|자","孝|子") #ruby("이|창|매","李|昌|梅")의 #ruby("묘","墓")’）라 새겨져 있었다. #ruby("비|석","碑|石") 뒷#ruby("면","面")에 새겨진 글#ruby("자","字")를 보니, 어느 임금이 #ruby("이|창|매","李|昌|梅")의 #ruby("효|성","孝|誠")에 #ruby("대","對")해 #ruby("효|자","孝|子") #ruby("정|문","旌|門")#footnote(numbering: _ => [68)])[#h(0.35em)#ruby("충|신","忠|臣")·#ruby("효|자","孝|子")·#ruby("열|녀","烈|女")를 기리기 #ruby("위","爲")해 집 앞에 세우는 붉은 #ruby("문","門"). #ruby("홍|문","紅|門")이라고도 한다.]을 내렸다고 하였다. #ruby("이|창|매","李|昌|梅")의 #ruby("묘","墓") 옆에는 #ruby("이|창|매","李|昌|梅") #ruby("부|친","父|親")의 #ruby("묘","墓")가 있었다.]
#zh[那天在延安邑住了一夜，第二天往罗津浦去。路上，离延安邑约五里的路边坟墓旁歇了一歇。天气极热，巡检们买了香瓜吃，坐着歇腿。看墓旁立着的碑文，刻着“孝子李昌梅之墓”。碑阴刻着，某位国王因李昌梅的孝诚赐了孝子旌门。李昌梅的墓旁还有他父亲的墓。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|창|매","李|昌|梅")는 #ruby("본|시","本|是") #ruby("연|안","延|安")의 #ruby("통|인","通|引")으로, 그 #ruby("부|친","父|親") #ruby("장|례","葬|禮") #ruby("후","後")에 #ruby("사|시|장","四|時|長")철 비바람을 맞으면서 #ruby("지|성","至|誠")으로 #ruby("산|소","山|所")를 모셨다고 한다. 얼마나 #ruby("극|진","極|盡")하게 #ruby("묘","墓")를 모셨던지, #ruby("묘","墓") 앞의 신 벗은 자리에서부터 절하는 #ruby[자리][拜墓地]까지 한 발자국 한 발자국 걸어갔던 자국들과 두 무릎을 꿇었던 자국, 그리고 #ruby("향|로","香|爐")와 #ruby("향|합","香|盒")을 놓았던 자리에 #ruby("영|영","永|永") 풀이 나지 않았다고 한다. #ruby("만|일","萬|一") 사람이 그 움쑥움쑥 패인 자리를 흙으로 메우면 #ruby("즉|시","卽|時")로 #ruby("뇌|성","雷|聲")이 #ruby("진|동","震|動")하고 큰비가 내려 그 흙들을 씻어내곤 했다는 이야기를 #ruby("근|처","近|處") 사람과 #ruby("순|검","巡|檢")들이 해주었다.]
#zh[李昌梅本是延安的通引，父亲葬礼之后，一年四季冒着风雨，至诚奉祀墓所。奉祀得那么极尽，从墓前脱鞋的地方到跪拜的地方，一步一步走过的足迹、两膝跪过的痕迹，以及放过香炉和香盒的地方，永远不生草。万一有人用土填平那些凹痕，立刻雷声大震，大雨把土冲掉。这是附近的人和巡检们讲的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[눈으로 그 #ruby("비|문","碑|文")을 보고 귀로 그 이야기를 들으며, 나는 #ruby("순|검","巡|檢")들이 알세라 어머님이 알세라, 피 섞인 눈물을 흘리며 #ruby("이|창|매","李|昌|梅")에게 #ruby("대|죄","待|罪")하였다. 다 같은 사람의 #ruby("자|식","子|息")으로 태어나, #ruby("이|창|매","李|昌|梅")는 #ruby("부|모","父|母") 죽은 #ruby("후","後")까지 저렇듯 #ruby("효|도","孝|道")한 자취를 남겼으니, 그 #ruby("부|모","父|母") #ruby("생|전","生|前")에는 어떠했을지를 알 것 같았다. 나의 뒤를 허둥지둥 따라다니시느라 넋이 다 빠져서 내 옆에 앉아 하염없이 한숨만 짓고 계시는 어머님을 차마 뵐 수가 없었다. #ruby("이|창|매","李|昌|梅")가 무덤 속에서 다시 살아 나와 나를 보고, 너는 “#ruby("수|욕|정|이|풍|부|지","樹|欲|靜|而|風|不|止")”#footnote(numbering: _ => [69)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “나무는 조용히 있고 싶어하나 바람이 그치지 않는다”. 『#ruby("한|시|외|전","漢|詩|外|傳")』에 나오는 ‘樹欲靜而風不止 子欲養而親不待’(나무는 잠잠하고자 하나 바람이 그치지 않고, #ruby("자|식","子|息")은 모시고자 하나 어버이가 기다려 주지 않는다)의 앞#ruby("부|분","部|分"). 살아 계실 때 #ruby("효|도","孝|道")하지 못함을 #ruby("탄|식","歎|息")한 #ruby("구|절","句|節")이다.]는 #ruby("구|절","句|節")을 읽지 못하였느냐고 #ruby("책|망","責|望")하는 듯싶었다. 일어나서 #ruby("출|발","出|發")할 때, #ruby("이|창|매","李|昌|梅")의 무덤을 다시금 되돌아보며 마음속으로 #ruby("수","數")없이 절을 하였다.]
#zh[眼看碑文，耳听这些话，我怕巡检知道，也怕母亲知道，流着掺血的泪，向李昌梅请罪。同样生为人子，李昌梅在父母死后还留下这样尽孝的痕迹，父母在世时更可想而知。母亲失了魂似的慌慌张张跟着我，坐在旁边只是叹气，我实在不忍看。仿佛李昌梅从坟墓里活过来责备我：你没读过“树欲静而风不止”这句话吗？起身出发时，我又回头望着李昌梅的墓，在心里拜了无数次。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("나|진|포","羅|津|浦")에서 #ruby("육|로","陸|路")는 끝이 나고 배를 타게 되었다. #ruby("병|신|년","丙|申|年") 7#ruby("월","月") 25#ruby("일","日"), 달빛이 없어 #ruby("천|지","天|地")가 캄캄하고 물소리밖에 들리지 않았다. #ruby("강|화|도","江|華|島")를 지날 때쯤, #ruby("종|일","終|日") 뜨거운 햇빛 아래를 걸어왔던 #ruby("순|검","巡|檢")들이 #ruby("방|심","放|心")하고 다 잠이 든 것을 보시고, 어머님은 뱃#ruby("사|공","沙|工")도 듣지 못할 입안엣말씀으로 내게 말씀하셨다.]
#zh[在罗津浦，陆路到了尽头，要上船了。丙申年七月二十五日，没有月光，天地漆黑，只听得见水声。经过江华岛的时候，母亲见巡检们整天在烈日下走路，都放心睡着了，用连船夫也听不见的口中细语对我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“얘, 네가 이제 가서는 #ruby("왜","倭")놈 손에 죽을 터이니, 맑고 맑은 이 물에 너와 나와 같이 죽어서 #ruby("귀|신","鬼|神")이라도 #ruby("모|자","母|子") 같이 다니자.”]
#zh[“孩子，你这一去要死在倭寇手里。不如你我一起死在这清清的水里，做了鬼也母子相随。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 말씀을 하시고는 내 손을 이끄시고 뱃전으로 가까이 나가신다. 나는 #ruby("황|송|무|지","惶|悚|無|地")하여 어머님을 #ruby("위|안","慰|安")하였다.]
#zh[说了这话，拉着我的手走近船舷。我惶恐无地，安慰母亲。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어머님은 #ruby("자|식","子|息")이 이#ruby("번","番")에 가서 죽는 줄 아십니까? #ruby("결","決")코 죽지 않습니다. #ruby("자|식","子|息")이 #ruby("국|가","國|家")를 #ruby("위","爲")하여 하늘에 사무치게 #ruby("정|성","精|誠")을 다하여 #ruby("원|수","怨|讐")를 죽였으니, 하늘이 도우실 테지요. #ruby("분|명","分|明")히 죽지 않습니다.”]
#zh[“母亲以为儿子这次去就会死吗？决不会死。儿子为国家，尽了通天的精诚，杀了仇敌，上天会保佑的。明明不会死。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 어머님은 #ruby("당|신","當|身")을 #ruby("위|안","慰|安")하는 말씀으로만 들으시고, 다시 손을 잡아 끄셨다. #ruby("자|식","子|息")의 말을 왜 안 믿으시냐고 #ruby("강","强")하게 #ruby("주|장","主|張")하자, 그제야 #ruby("투|신","投|身")할 #ruby("결|심","決|心")을 버리시고 다시 말씀하셨다.]
#zh[可是母亲只当我是安慰她，又拉住我的手。我强说为什么不信儿子的话，她这才放弃投水的决心，又说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너의 아버지와도 #ruby("약|속","約|束")하였다. 네가 죽는 날이면 우리 둘도 같이 죽자고.”]
#zh[“我也和你父亲约好了。你死的那天，我们两个也一起死。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 그때 내가 죽지 않을 거라 한 말씀을 어느 #ruby("정|도","程|度") 믿으셨던 #ruby("모|양","模|樣")이다. 하늘을 #ruby("향","向")하여 두 손을 비비시면서 알아듣지 못할 낮은 #ruby("음|성","音|聲")으로 #ruby("축|원","祝|願")을 하고 계셨다.]
#zh[母亲那时似乎多少相信了我说不会死的话。对着天搓着两手，用听不清的低声祝祷着。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("인|천|옥","仁|川|獄")에 들어갔다. 내가 #ruby("인|천","仁|川")으로 #ruby("이|감","移|監")된 #ruby("이|유","理|由")는 #ruby("갑|오|경|장","甲|午|更|張") #ruby("이|후","以|後")에 #ruby("외|국|인","外|國|人") #ruby("관|련","關|連") #ruby("사|건","事|件")을 #ruby("재|판","裁|判")하는 #ruby("특|별|재|판|소","特|別|裁|判|所")가 있었기 때문이었다. #ruby("감|옥","監|獄")은 #ruby("내|리","內|里")에 있었는데, #ruby("내|리","內|里") 마루에 #ruby("감|리|서","監|理|署")가 있고, 왼#ruby("편","便")에는 #ruby("경|무|청","警|務|廳")이 있고, 오른#ruby("편","便")에 #ruby("순|검|청","巡|檢|廳")이 있었다. #ruby("감|옥","監|獄")은 #ruby("순|검|청","巡|檢|廳") 앞에 있고, 그 앞에는 #ruby("노|상","路|上")을 #ruby("통|제","統|制")하는 2#ruby("층","層") #ruby("문|루","門|樓")가 있었다. #ruby("감|옥","監|獄") #ruby("주|위","周|圍")에는 담#ruby("장","牆")을 높이 쌓아올렸고 담 안에는 #ruby("평|옥","平|屋") 몇 칸이 있는데, 그 #ruby("방","房")들을 #ruby("반","半")으로 나누어서 한#ruby("편","便")에는 #ruby("미|결|수","未|決|囚")와 #ruby("강|도","强|盜")·#ruby("절|도","竊|盜")·#ruby("살|인","殺|人") #ruby("등","等") #ruby("죄|인","罪|人")을 #ruby("수|용","收|容")하고, 나머지 #ruby("반","半")쪽에는 #ruby("민|사|소|송|범","民|事|訴|訟|犯")과 #ruby[경범위반][違警犯] #ruby("등","等") 이른바 #ruby("잡|범","雜|囚")을 #ruby("수|용","收|容")하고 있었다. #ruby("형|사","刑|事") #ruby("피|고","被|告")의 #ruby("기|결|수","旣|決|囚")에게는 #ruby("청|색","靑|色")옷을 입혔고, 웃옷 등쪽에 #ruby("강|도","强|盜")·#ruby("살|인","殺|人")·#ruby("절|도","竊|盜") #ruby("등","等")의 #ruby("죄|명","罪|名")을 먹으로 써놓았다. #ruby("감|옥","監|獄") 바깥으로 일하러 나갈 때에는 #ruby("좌|우","左|右") 어깨와 팔꿈치를 아울러 쇠사슬로 동이고, 2#ruby("인","人") 1#ruby("조","組")로 등 뒤에 자물쇠를 채워 #ruby("간|수","押|牢")가 #ruby("인|솔","引|率")하고 다녔다.]
#zh[死刑面前争生存]
#zh[我被拘押在仁川监狱。我所以转押在仁川监狱，是因为“甲午更张”①以后，审理与外国人有关的特别法院设在此处。我关进的监狱是在内里，在山顶上有监理署，左侧是警务厅，右边是巡检厅，监狱是在巡检厅的前面，前面有二层门楼。四周筑着高高的围墙，里面低矮的平房即是监房。]
#zh[译注：甲午更张，亦称甲午改革，是李朝封建统治阶级内部革新派官僚为使国家昌盛，摆脱外来干涉，逐步走上近代化所进行的一次改革。]
#zh[监狱分为两部分：一部分是拘禁重犯和强盗、窃贼、杀人犯的牢房；一部分是收容一些杂囚。未决犯是普通服装，而服刑的罪犯则穿着蓝衣服，在上衣的背上用毛笔写上强盗、杀人、窃盗等罪名。]
#zh[这些罪犯到外面去做工时，左右双肩绑上链子，每两个人系成一对，在背后上了锁，由看守押着前往。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄")에 들어가자마자 나는 #ruby[도적죄수간][賊囚間]의 9#ruby("인","人")#ruby("용","用") #ruby("장|곡","長|梏")#footnote(numbering: _ => [70)])[#h(0.35em)길다란 차꼬. #ruby("죄|수","罪|囚")를 가두어 둘 때 쓰던 옛 #ruby("형|구","刑|具")의 한 가지. 길다란 두 #ruby("개","個")의 토막나무 사이에 구멍을 파서, #ruby("죄|인","罪|人")의 두 발목을 그 구멍에 넣고 자물쇠로 채우게 되어 있음.] #ruby("중|간","中|間")에 꼼짝없이 묶이게 되었다. #ruby("치|하|포","鴟|河|浦")에서는 #ruby("이|화|보","李|和|甫")가 한 달 #ruby("전","前")에 #ruby("구|속","拘|束"), #ruby("압|송","押|送")되어 #ruby("인|천|옥","仁|川|獄")으로 들어와 갇혔는데, 그는 나를 보고 #ruby("자|기","自|己")의 #ruby("무|죄","無|罪")한 #ruby("증|거","證|據")를 내가 #ruby("제|출","提|出")해 줄 것으로 알고 매우 반가워하였다. 그의 집 #ruby("벽","壁")에 내가 써 붙여놓았던 #ruby("포|고|문","布|告|文")은 #ruby("왜","倭")놈들이 #ruby("조|사","調|査")할 때 떼어 감추고 나를 #ruby("순|전","純|全")히 #ruby("살|인|강|도","殺|人|强|盜")로 꾸며놓았다고 했다.]
#zh[刚进仁川监狱时，我被关在贼囚房，锁在一个可以锁九人的长足枷上，位于其他八个盗贼的中间。在一个月前被逮捕来的鸥河浦店主人李和甫见到了我非常高兴，他以为这一下他可以无罪释放了。据他说，那一天我杀死土田让亮后贴在墙上的布告，被去调查的日本人揭下后藏了起来，单纯指控我为杀人强盗。]
#figure-block("/images/p100.jpg", caption: [#ruby("백|범","白|凡")이 #ruby("치|하|포","鴟|河|浦") #ruby("사|건","事|件")으로 #ruby("투|옥","投|獄")되었던 #ruby("인|천|감|리|서","仁|川|監|理|署")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 #ruby("옥|문","獄|門") 앞까지 따라오셔서 내가 #ruby("옥|문","獄|門") 안으로 들어가는 것을 보시고 눈물을 흘리며 서 계셨다. 나는 #ruby("잠|시","暫|時") 고개를 돌려 그 모습을 보았다. 어머님은 비록 #ruby("농|촌","農|村")에서 #ruby("생|장","生|長")하셨지만 무슨 일이나 잘 #ruby("감|당","堪|當")해내셨고 #ruby("특","特")히 바느질에 #ruby("능","能")하셨다. 무슨 일이 손에 잡히셨을까만, #ruby("자|식","子|息")의 목숨을 #ruby("구","救")하기 #ruby("위","爲")해 #ruby("감|리|서","監|理|署") #ruby("삼|문","三|門")#footnote(numbering: _ => [71)])[#h(0.35em)#ruby("대|궐","大|闕")이나 #ruby("공|관","公|館")의 #ruby("정|문","正|門")·#ruby("동|협|문","東|夾|門")·#ruby("서|협|문","西|夾|門") #ruby("등","等") 세 칸으로 된 #ruby("문","門"). #ruby("중|간","中|間")칸이 #ruby("정|문","正|門")의 #ruby("좌|우","左|右")보다 높으면 솟을#ruby("삼|문","三|門"), 같으면 #ruby("평|삼|문","平|三|門")이라 한다.] 밖에 있는 #ruby("개|성","開|城")사람 #ruby("박|영|문","朴|永|文")의 집에 들어가셔서 이제까지의 일을 #ruby("잠|시","暫|時") 이야기하시고 그 집 동자꾼#footnote(numbering: _ => [72)])[#h(0.35em)밥 짓는 사람. #ruby("식|모","食|母").]으로 써 달라 #ruby("부|탁","付|託")하셨다. 그 집은 #ruby("당|시","當|時") #ruby("항|내","港|內")의 #ruby("유|명","有|名")한 #ruby("물|상|객|주","物|商|客|主")라 안채에서 밥 짓는 일과 옷 만드는 일이 매우 #ruby("번|잡","煩|雜")하고 많았다. #ruby("덕|분","德|分")에 어머님은 하루 세 끼 #ruby("감|옥","監|獄")에 밥 한 그릇씩을 갖다주기로 하는 #ruby("조|건","條|件")으로 #ruby("고|용","雇|傭")이 되셨다. #ruby("압|뢰","押|牢")가 밥을 받아 넣어주면서, “네 #ruby("모|친","母|親")도 #ruby("의|지","依|支")할 곳이 생겼고, 네 밥도 #ruby("매|일","每|日") 세 끼를 들여 줄 터이니 #ruby("안|심","安|心")하라” 고 하였다. 함께 갇힌 #ruby("죄|수","罪|囚")들도 그것을 매우 부러워하였다.]
#zh[母亲随着我来到了牢房外，流着眼泪目送我进了牢门。母亲虽生长在乡下，可是任何事都会干，尤其擅长于针线。她到监理署三门外开城人朴永文的家里哀求，愿当这一家的佣人，以便拯救儿子的生命。朴家在仁川是掮客生意做得最兴隆的一家，家中做饭、做针线的活儿很多。母亲就在他家干起活来。条件是供应我的三餐，每餐一碗饭。狱卒告诉我说：]
#zh[“你母亲已找到了安身之所，赚的钱可以供应你一日三餐，你可以放心了。”]
#zh[其他罪犯们非常羡慕我，我不禁想起古人所说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[옛사람들은 말하기를 “슬프다. #ruby("부|모","父|母")님께서 나를 낳으시느라 #ruby("고|생","苦|生")하시었다”#footnote(numbering: _ => [73)])[#h(0.35em)#ruby("원|문","原|文"): #inline-glyph("/images/p100.png", cls: ("txt_vm",)). #ruby("출|전","出|典"): 『#ruby("시|경","詩|經")』 「#ruby("소|아","小|雅")」#ruby("편","篇").]라 하였지만, #ruby("부|모","父|母")님은 내가 태어날 적에도 많은 #ruby("고|생","苦|生")을 하셨고, 또 나를 먹여 살리시기 #ruby("위","爲")해 #ruby("천|중|만|금","千|重|萬|金")의 #ruby("고|생","苦|生")을 더 겪으셨다. #ruby("불|서","佛|書")에 말하기를, “#ruby("부|모|여|자|녀","父|母|與|子|女")는 #ruby("천|생|백|겁","千|生|百|劫")에 #ruby("은|애|소|유|주","恩|愛|所|遺|住")”#footnote(numbering: _ => [74)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("부|모","父|母")와 #ruby("자|녀","子|女")는 #ruby("천","千") #ruby("번","番")을 태어나고 #ruby("백","百") #ruby("겁","劫")이 지나도록 #ruby("은|혜","恩|惠")와 사랑을 끼치며 사는 #ruby("인|연","因|緣")”.]이라고 한 말이 헛말이 아니었다.]
#zh[“哀哀父母，生我劬劳。”]
#zh[父母生我养我，真是受尽了千辛万苦。佛经说父母与子女有千世之缘，确是言之不谬。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄") 안이 #ruby("극","極")히 #ruby("불|결","不|潔")한데다가 찌는 듯이 더운 여름철이라, 나는 #ruby("장|티|푸|스","長|窒|扶|斯")에 걸려 #ruby("극|심","極|甚")한 #ruby("고|통","苦|痛")을 겪게 되었다. 짧은 #ruby("소|견","所|見")에 #ruby("자|살","自|殺")을 하려고 #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들이 잠든 틈을 타서 이마 위에 손톱으로 ‘#ruby("충","忠")’#ruby("자","字")를 새기고 허리띠로 목을 졸라 드디어 숨이 끊어졌다. 숨이 끊어진 #ruby("잠|깐","暫|間") 동안, 나는 #ruby("고|향","故|鄕")으로 가서 #ruby("평|소","平|素") #ruby("친|애","親|愛")하던 #ruby("재|종|동|생","再|從|同|生") #ruby("창|학","昌|學")#footnote(numbering: _ => [75)])[#h(0.35em)#ruby("원|주","原|註"): “지금 이름은 泰運”.]이와 놀았다. #ruby("고|시","古|詩")에 “#ruby("고|원|장|재|목","故|園|長|在|目") #ruby("혼|거|불|수|초","魂|去|不|須|招")”#footnote(numbering: _ => [76)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("고|향","故|鄕")이 눈앞에 늘 아른거리니, 굳이 부르지 않아도 #ruby("혼","魂")이 먼저 가 있도다”.]라 하였는데, #ruby("실","實")로 헛말이 아니었다.]
#zh[监狱里面又脏又热，实在无法忍受，我又患了伤寒病，真是痛苦到了极点。]
#zh[有一次，我想到自杀，趁着其他罪犯们睡觉的机会，在额上用指甲划了个“忠”字，然后用裤带自缢，当气绝的瞬息之间，我恍惚回到了故乡，跟我平时所喜欢的堂弟昌学（现名为泰运）一起在玩，真所谓：]
#zh[“故园长在目，魂去不须招。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("홀|연","忽|然")히 #ruby("정|신","精|神")이 #ruby("회|복","回|復")되어 보니, #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들이 #ruby("고|함","高|喊")을 치며 죽는다고 #ruby("소|동","騷|動")을 치고 있었다. 그 #ruby("자","者")들이 내가 죽을까 봐 놀라서 그리 한 것은 아니고, 내가 #ruby("정|신","精|神")을 잃으면서 몹시 #ruby("격|렬","激|烈")하게 #ruby("요|동","搖|動")을 쳤기 때문에 일어난 #ruby("소|동","騷|動")이었다. 그#ruby("후","後")로는 여러 사람의 #ruby("주|의","注|意")로 #ruby("자|살","自|殺")할 #ruby("기|회","機|會")가 없었다. 또 나 스스로도 그 뒤로는 #ruby("병|마","病|魔")로 죽든지 #ruby("원|수","怨|讐")에게 죽든지 저절로 죽는 것은 어쩔 수 없는 일이지만, #ruby("자|살","自|殺")하는 것은 옳지 않다고 생각하게 되었다. 그러는 사이에 #ruby("취|한","就|汗")은 되었으나,#footnote(numbering: _ => [77)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("열","熱")은 내렸으나”. ‘就汗’은 ‘取汗’의 #ruby("오|기","誤|記"). #ruby("취|한","取|汗") 또는 #ruby("발|한","發|汗")은 #ruby("병","病")을 다스리기 #ruby("위","爲")해 땀을 내는 것을 말한다.] 보름 동안 #ruby("음|식","飮|食")은 입에 대어보지 못하였다.]
#zh[当醒过来时，旁边的罪犯们在大吵大闹。他们并不是怕我死才闹，是我失了神，摇动得太厉害，才闹起来的。从此众人留意，没有自杀的机会。我自己后来也想，病死或死在仇敌手里是无可奈何，自杀却不对。这中间虽然发了汗，可是半个月食不下咽。]
#heading(level: 3)[#text(font: "KOPUSGo B")[6) #ruby("역|사|적","歷|史|的")인 #ruby("심|문","審|問")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 마침 #ruby("신|문","訊|問")을 한다는 #ruby("기|별","奇|別")이 왔다.#footnote(numbering: _ => [78)])[#h(0.35em)#ruby("인|천","仁|川")에서 첫 #ruby("신|문|일","訊|問|日")은 1896#ruby("년","年") 8#ruby("월","月") 31#ruby("일","日")\(#ruby("음|력","陰|曆") 7#ruby("월","月") 23#ruby("일","日"))이다.] 나는 생각했다.]
#zh[这时正好来了要审问的消息。我想：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘내가 #ruby("해|주","海|州")에서 다리뼈가 다 드러나는 #ruby("악|형","惡|刑")을 당하고 죽는 데까지 이르렀으면서도 #ruby("사|실","事|實")을 #ruby("부|인","否|認")했던 것은, #ruby("내|무|부","內|務|部")에 가서 #ruby("대|관","大|官")들을 보고 내 뜻을 이야기하기 #ruby("위","爲")함이었다. 그러나 여기서 #ruby("불|행","不|幸")히 #ruby("병","病")으로 죽게 되었으니, #ruby("부|득|불","不|得|不") 이곳에서라도 #ruby("왜","倭")놈 죽인 #ruby("취|지","趣|旨")를 #ruby("분|명","分|明")히 말하고 죽으리라.’]
#zh[“我在海州受了腿骨都露出来的酷刑，直到要死也不承认事实，是为了到内务部去见大官，说出我的意思。可是在这里不幸要病死了，不得不就在这里把杀死倭寇的趣旨说清楚再死。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이처럼 마음을 굳게 먹고, #ruby("간|수","看|守")의 등에 업혀 #ruby("경|무|청","警|務|廳")으로 들어갔다. 업혀 들어가면서 살펴보니 #ruby("도|적","盜|賊") #ruby("신|문","訊|問")하는 #ruby("형|구","刑|具")를 #ruby("삼|엄","森|嚴")하게 #ruby("설|비","設|備")해 놓고 있었다. #ruby("간|수","看|守")가 나를 업어다가 #ruby("문","門") 밖에 앉혀 놓자, #ruby("당|시","當|時") #ruby("경|무|관","警|務|官") #ruby("김|윤|정","金|潤|晶")#footnote(numbering: _ => [79)])[#h(0.35em)#ruby("원|주","原|註"): “尹致昊의 장인”. #ruby("윤|치|호","尹|致|昊")는 #ruby("윤|치|오","尹|致|旿")의 #ruby("오|류","誤|謬"). #ruby("김|윤|정","金|潤|晶")은 #ruby("을|사|조|약","乙|巳|條|約") #ruby("이|후","以|後") #ruby("태|인","泰|仁") #ruby("군|수","郡|守")·#ruby("인|천","仁|川") #ruby("부|윤","府|尹")을 지냈고, 1910#ruby("년","年") #ruby("한|일|합|방","韓|日|合|邦") #ruby("이|후","以|後") #ruby("친|일|파","親|日|派")의 길을 걸어 #ruby("중|추|원","中|樞|院") #ruby("참|의","參|議")·#ruby("고|문","顧|問")이 되었다. 그의 딸 #ruby("윤|고|라","尹|高|麗")는 #ruby("중|추|원","中|樞|院") #ruby("찬|의","贊|議")를 지낸 #ruby("윤|치|오","尹|致|旿")의 #ruby("부|인","夫|人")으로 #ruby("한|국","韓|國") #ruby("최|초","最|初")의 #ruby("양|장","洋|裝")#ruby("여|성","女|性")으로 #ruby("전","傳")해지고 있다.]이 내 #ruby("모|양","模|樣")을 보고 물었다.]
#zh[这样下定了心，被看守背着进了警务厅。被背进去时一看，审问盗贼的刑具森严地摆着。看守把我背到门外坐下，当时的警务官金润晶看见我的样子问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어찌하여 저 #ruby("죄|수","罪|囚")의 #ruby("형|용","形|容")이 저렇게 되었느냐?”]
#zh[“这囚犯的形容怎么变成这样？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("열|병","熱|病")으로 그리 되었다고 #ruby("간|수","看|守")가 #ruby("보|고","報|告")하자, #ruby("김|윤|정","金|潤|晶")이 내게 물었다.]
#zh[看守报告说是热病如此，金润晶问我：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("정|신","精|神")이 있어 묻는 말에 #ruby("족","足")히 #ruby("대|답","對|答")할 수 있느냐?”]
#zh[“你神志还在，问的话能够回答吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("정|신","精|神")은 있으나 #ruby("성|대","聲|帶")가 말라붙어서 말이 나오지 않으니 물을 한 #ruby("잔","盞") 주면 마시고 말을 하겠소.”]
#zh[“神志是有的，可是声带干得说不出话。给一杯水，喝了再讲。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러자 곧 #ruby("청","廳")지기더러 물을 가져다가 마시도록 해주었다. #ruby("김|윤|정","金|潤|晶")은 #ruby("법|정","法|庭") 위에 앉아 #ruby("순|서","順|序")대로 #ruby("성|명","姓|名")과 #ruby("주|소","住|所"), #ruby("연|령","年|齡")을 묻고 #ruby("사|실","事|實") #ruby("심|리","審|理")에 들어갔다.]
#zh[于是立刻叫厅役拿水来给我喝。金润晶坐在法庭上，按次序问了姓名、住址、年龄，进入事实审理。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("안|악","安|岳") #ruby("치|하|포","鴟|河|浦")에서 #ruby("모|월","某|月") #ruby("모|일","某|日")에 #ruby("일|본|인","日|本|人")을 #ruby("살|해","殺|害")한 일이 있느냐?”]
#zh[“某月某日，你在安岳鸥河浦有没有杀害日本人的事？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("본|인","本|人")이 그날 그곳에서 #ruby("국|모","國|母")의 #ruby("원|수","怨|讐")를 갚기 #ruby("위","爲")해 #ruby("왜|구","倭|寇") 한 #ruby("명","名")을 때려죽인 #ruby("사|실","事|實")이 있소.”]
#zh[“本人那天在那里，为了报国母的仇，打死一名倭寇，确有其事。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("대|답","對|答")을 들은 #ruby("경|무|관","警|務|官")·#ruby("총|순","總|巡")·#ruby("권|임","權|任")#footnote(numbering: _ => [80)])[#h(0.35em)#ruby("일|반","一|般") #ruby("경|찰","警|察")인 #ruby("순|검","巡|檢")의 우두머리가 #ruby("권|임","權|任"), 그 위가 #ruby("총|순","總|巡"), 그 위가 #ruby("경|무|관","警|務|官")이다.] #ruby("등","等")은 #ruby("일|제","一|齊")히 얼굴을 들고서 #ruby("묵|묵","默|默")히 서로를 쳐다보았고, #ruby("법|정","法|庭") 안은 #ruby("비|상","非|常")히 조용해지기 #ruby("시|작","始|作")했다. 내 옆 #ruby("의|자","椅|子")에는 #ruby("와타나베","渡邊")라고 하는 #ruby("왜","倭")놈 #ruby("순|사","巡|査")가 걸터앉아서 나의 #ruby("신|문","訊|問") #ruby("과|정","過|程")을 #ruby("방|청","傍|聽")인지 #ruby("감|시","監|視")인지 하고 있다가, #ruby("신|문","訊|問") #ruby("시|작","始|作")부터 #ruby("법|정","法|庭") 안이 조용해지는 것을 보고 #ruby("의|아","疑|訝")해 하며 #ruby("통|역","通|譯")으로 그 #ruby("이|유","理|由")를 묻는 것 같았다. 나는 그것을 보고서,]
#zh[听了我的回答，警务官、总巡、权任等一齐抬起脸，默默对看，法庭里开始非常安静。我旁边椅子上坐着一个叫渡边的倭寇巡查，不知是旁听还是监视我的审问，从审问一开始看见法庭安静下来，似乎诧异，通过翻译问缘故。我看见这个情形，]
#zh[译注：巡检的上司。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이놈!”]
#zh[“这家伙！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 큰소리로 #ruby("사|력","死|力")을 다해 #ruby("호|령","號|令")하였다.]
#zh[我用尽死力，大声喝道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“지금 #ruby("소|위","所|謂") #ruby("만|국|공|법","萬|國|公|法")이니, #ruby("국|제|공|법","國|際|公|法") 어디에 #ruby("국|가","國|家")#ruby("간","間")의 #ruby("통|상","通|商")·#ruby("화|친|조|약","通|和|條|約")을 #ruby("체|결","締|結")한 #ruby("후","後") 그 나라 임금을 #ruby("시|해","弑|害")하라는 #ruby("조|문","條|文")이 있더냐? 이 개 같은 #ruby("왜","倭")놈아. 너희는 어찌하여 우리 #ruby("국|모","國|母")를 #ruby("시|해","弑|害")하였느냐? 내가 죽으면 #ruby("귀|신","鬼|神")이 되어서, 살면 몸으로, 네 임금을 죽이고 #ruby("왜","倭")놈을 씨도 없이 다 죽여 우리 #ruby("국|가","國|家")의 #ruby("치|욕","恥|辱")을 씻으리라!”]
#zh[“你混蛋！所谓万国公法里，哪一条文规定签定通商亲善条约后，可以杀死一个国家的国王或王后？狗倭寇呀！你们究竟为了什么杀害我们的国母陛下？在我有生之年，誓报此仇，死则变成厉鬼也要杀你们国王，而且非把你们倭寇消灭得干干净净，来洗雪我国的耻辱不可。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("통|렬","痛|烈")히 꾸짖는 서슬에 #ruby("겁","怯")이 났던지 #ruby("와타나베","渡邊")는 “#ruby("축|생","蓄|生")”#footnote(numbering: _ => [81)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “칙쇼우! 칙쇼우!”. #ruby("일|어","日|語")로 ‘ちくしょう’이며, #ruby("원|래","元|來")는 짐승을 #ruby("의|미","意|味")하지만 ‘빌어먹을’ ‘개새끼’라는 뜻의 #ruby("욕","辱")으로 많이 쓴다.] 하고 #ruby("욕","辱")을 하며, #ruby("대|청","大|廳") 뒤쪽으로 #ruby("도|망","逃|亡")하여 숨고 말았다. #ruby("법|정","法|庭") 안의 #ruby("공|기","空|氣")가 #ruby("긴|장","緊|張")되기 #ruby("시|작","始|作")하였다. #ruby("총|순","總|巡")인지 #ruby("주|사","主|事")인지가 #ruby("김|윤|정","金|潤|晶")에게 와서 말했다.]
#zh[渡边可能听到我的骂声吓慌了神，连说“畜牲！”“畜牲！”急忙退避到大厅后面，庭内的气氛更趋紧张。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("사|건","事|件")이 #ruby("중|대","重|大")하니 #ruby("감|리","監|理") #ruby("영|감","令|監")께 말씀드려 #ruby("직|접","直|接") #ruby("신|문","訊|問")하시도록 하여야겠습니다.”]
#zh[“案件重大，应当禀告监理令监，请他亲自审问。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("잠|시","暫|時") #ruby("후","後") #ruby("감|리|사","監|理|使") #ruby("이|재|정","李|在|正")이 들어와 윗자리에 앉았다. #ruby("김|윤|정","金|潤|晶")은 그때까지 #ruby("신|문","訊|問")하던 #ruby("진|상","眞|相")을 #ruby("보|고","報|告")하였다. #ruby("법|정","法|庭") 안에서 #ruby("참|관","參|觀")하던 #ruby("관|리","官|吏")와 #ruby[근무자][廳屬]들이 위로부터 아무 #ruby("분|부","分|付")가 없었는데도 찻물을 가져다 마시게 해주었다. 나는 #ruby("법|정","法|庭") 맨 윗자리에 앉은 #ruby("이|재|정","李|在|正")에게 #ruby("질|문","質|問")하였다.]
#zh[过了一会，监理使李在正进来坐在上座。金润晶把直到那时审问的真相报告了。法庭里参观的官吏和厅属，上面并没有吩咐，却拿茶水来给我喝。我向坐在法庭最上座的李在正问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("본|인","本|人")은 #ruby("일|개","一|個") 시골의 #ruby("천|민","賤|民")이지만 #ruby("신|하","臣|下")된 #ruby("백|성","臣|民")의 #ruby("의|리","義|理")로 #ruby("국|가","國|家")가 #ruby("수|치","羞|恥")를 당하고, 푸른 하늘 밝은 #ruby[해][白日靑天] 아래 내 그림자가 부끄러워서 #ruby("왜|구","倭|寇") 한 #ruby("명","名")을 죽였소. 그러나 나는 아직 우리 #ruby("동|포","同|胞")가 #ruby("왜|인","倭|人")들의 #ruby("왕","王")을 죽여 #ruby("복|수","復|讐")하였단 말을 듣지 못하였소. 지금 #ruby("당|신","當|身")들은 #ruby("몽|백","蒙|白")#footnote(numbering: _ => [82)])[#h(0.35em)#ruby("몽|백","蒙|白")은 #ruby("국|상","國|喪")을 당하여 #ruby("백|립","白|笠")을 쓰고 #ruby("소|복","素|服")을 입는 것. #ruby("당|시","當|時")는 #ruby("명|성|왕|후","明|成|王|后") #ruby("시|해","弑|害") #ruby("사|건","事|件")으로 #ruby("국|상","國|喪") #ruby("중","中")이었다.]을 하고 있는데, #ruby("춘|추|대|의","春|秋|大|義")#footnote(numbering: _ => [83)])[#h(0.35em)『#ruby("춘|추","春|秋")』는 #ruby("춘|추|시|대","春|秋|時|代") #ruby("노","魯")나라의 #ruby("역|사|서","歷|史|書"). #ruby("원|래","元|來") #ruby("노","魯")나라 #ruby("사|관","史|官")들이 #ruby("편|년|체","編|年|體")로 #ruby("기|록","記|錄")한 것을 #ruby("공|자","孔|子")가 #ruby("윤|리|적","倫|理|的") #ruby("입|장","立|場")에서 #ruby("정|사|선|악","正|邪|善|惡")의 #ruby("가|치|판|단","價|値|判|斷")을 #ruby("가","加")한 것. ‘#ruby("춘|추|대|의","春|秋|大|義")’란 #ruby("공|자","孔|子")가 『#ruby("춘|추","春|秋")』에서 보여준 #ruby("엄|정","嚴|正")한 #ruby("비|판|의|식","批|判|意|識")과 #ruby("역|사|인|식","歷|史|認|識")을 말한다.]에 나랏님의 #ruby("원|수","怨|讐")를 갚지 못하면 #ruby("몽|백","蒙|白")을 아니한다는 #ruby("구|절","句|節")도 읽어보지 못하였소? 어찌 한갓 #ruby("부|귀|영|화","富|貴|榮|華")와 #ruby("국|록","國|祿")을 #ruby("도|적","盜|賊")질하는 더러운 마음으로 임금을 섬기시오?”]
#zh[“我金昌洙虽然是一个乡下的平民，自国母陛下遭受倭贼杀害之后，国家的耻辱，连我在青天白日之下的影子也觉得可耻，因此便杀死了一个倭寇。可是我至今尚未听到要杀死倭王，以报君仇这句话。现在看你们虽然都穿戴上了‘蒙白’①，却似乎忘了春秋大义所载的君父之仇未报，不可以蒙白这句话，一意窃取富贵荣华与宠禄，怎能效忠君王呢？”]
#zh[译注：由于国丧，戴白笠、穿素衣。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|재|정","李|在|正"), #ruby("김|윤|정","金|潤|晶")을 #ruby("위|시","爲|始")하여 #ruby("수|십","數|十") #ruby("명","名")의 #ruby("참|석","參|席") #ruby("관|리","官|吏")들이 내 말을 듣는 #ruby("광|경","光|景")을 보니, 제#ruby("각|기","各|其") 얼굴이 달아올라 홍당무 빛을 띠고 있었다. #ruby("이|재|정","李|在|正")이 마치 하소연하듯 내게 말했다.]
#zh[李在正、金润晶和其他法庭上的官员们闻言色变，一个个面红耳赤，垂首无语。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("창|수","昌|洙")의 지금 하는 말을 들으니, 그 #ruby("충|의","忠|義")와 #ruby("용|기","勇|氣")를 #ruby("흠|모","欽|慕")하는 #ruby("반|면","反|面") 내 #ruby("당|황","唐|慌")스럽고 부끄러운 마음도 #ruby("비","比")할 데 없소이다. 그러나 #ruby("상|부","上|部")의 #ruby("명|령","命|令")대로 #ruby("신|문","訊|問")하여 위에 #ruby("보|고","報|告")하려는 것인즉, #ruby("사|실","事|實")이나 #ruby("상|세","詳|細")히 말씀하여 주시오.”]
#zh[待我讲完之后，沉默良久的李在正，用很谦和的语气说道：]
#zh[“刚才听昌洙所言，对您的忠义和勇敢非常敬佩，同时我也深感惶悚和惭愧，然而按照上级的命令，必须要有审讯报告，因此请把这件事的前后始末详细地供述出来吧！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|윤|정","金|潤|晶")은 내 #ruby("병|증","病|症")이 아직 #ruby("위|험","危|險")함을 #ruby("보|고","報|告") #ruby("감|리","監|理")와 무슨 말을 수군수군하고서는 #ruby("간|수","看|守")를 #ruby("명","命")하여 도로 #ruby("하|옥","下|獄")시키도록 하였다.]
#zh[他讲话时用的是“敬语”。金润晶对李监理史耳语，好像说我的病还在危险状态中，于是令狱卒带我回狱。狱卒背我到中途，从人群里看见母亲的脸孔，看她面带喜色，我想可能是从官属或群众那里听到我做的事后，觉得很放心。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님께서는 나를 #ruby("신|문","訊|問")한다는 #ruby("소|문","所|聞")을 들으시고 #ruby("경|무|청","警|務|廳") #ruby("문","門") 밖에 서 계셨다. 그곳에서 #ruby("간|수","看|守")의 등에 업혀 들어가는 나를 보시고 ‘#ruby("병","病")이 저 #ruby("지|경","地|境")이 되었으니 무슨 말을 잘못 #ruby("대|답","對|答")하여 #ruby("당|장","當|場")에 죽지나 아니할까’ 근심이 가득하셨다고 한다.]
#zh[母亲听说要审问我，站在警务厅门外。在那里看见我被看守背进去，听说她满心忧虑：病到这个地步，万一答错了话，会不会当场死掉。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("신|문","訊|問") #ruby("시|작","始|作")부터 #ruby("관|리","官|吏") #ruby("전|부","全|部")가 떠들어대기 #ruby("시|작","始|作")하니 벌써 #ruby("감|리|영","監|理|營") #ruby("부|근","附|近") #ruby("인|사","人|事")들은 #ruby("희|귀","稀|貴")한 #ruby("사|건","事|件")이라고 구경하러 몰려들며 #ruby("야|단","惹|端")이었다. #ruby("법|정","法|庭") 안은 발 디딜 곳이 없었고, #ruby("문","門") 밖까지 사람들이 둘러서서 #ruby("순|검","巡|檢")들에게 물어댔다.]
#zh[从审问一开始，官吏全都嚷起来，监理营附近的人已经当作稀罕的事件涌来看热闹。法庭里没有下脚的地方，门外也围着人问巡检。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“참말 #ruby("별","別")난 사람이다. 아직 아이인데, #ruby("도|대|체","都|大|體") 무슨 #ruby("사|건","事|件")이냐?”]
#zh[“真是个特别的人。还是个孩子，到底是什么案件？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("간|수","看|守")와 #ruby("순|검","巡|檢")들이 #ruby("보|고","報|告")들은 대로 사람들에게 이야기를 해주었다.]
#zh[看守和巡检把听到的照样告诉人们。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("해|주","海|州") #ruby("김|창|수","金|昌|洙")라는 #ruby("소|년","少|年")인데 #ruby("민","閔")#ruby("중|전","中|殿") 마마의 #ruby("복|수","復|讐")를 #ruby("위","爲")해 #ruby("왜","倭")놈을 때려죽였다나? 그리고 아까 #ruby("감|리|사","監|理|使")를 #ruby("책|망","責|望")하는데 그도 아무 #ruby("대|답","對|答")을 못하던걸.”]
#zh[“是海州一个叫金昌洙的少年，为了给闵中殿娘娘报仇，把倭寇打死了。刚才还责备监理使，他也答不上来。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 이야기가 #ruby("파|다","播|多")하게 퍼져나갔다. 내가 #ruby("간|수","看|守")의 등에 업혀 나가면서 어머님의 얼굴을 살펴보니 #ruby("약|간","若|干") #ruby("희|색","喜|色")을 띠고 계셨다. 여러 사람이 구경한 이야기를 들으신 까닭인 듯한데, 나를 업고 가는 #ruby("간|수","看|守")도 어머님을 #ruby("향","向")하여 말하였다.]
#zh[这些话传开了。我被看守背出去时看母亲的脸，略带喜色。大概是听了众人旁观的话。背我的看守也对母亲说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("당|신","當|身"), #ruby("안|심","安|心")하시오. 어쩌면 이렇게 호랑이 같은 아들을 두셨소?”]
#zh[“您放心。怎么生了这样像老虎的儿子？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("감|옥","監|獄")에 들어가 #ruby("옥|중","獄|中")에서도 한 #ruby("번","番") 큰 #ruby("소|동","騷|動")을 일으켰다. 다름이 아니라 그들이 나를 다시 #ruby[도적죄수간][賊囚間]에다가 두고 차꼬를 채워두는 데 #ruby("대","對")해 크게 #ruby("분|개","憤|慨")했기 때문이었다. 나는 소리를 #ruby("벽|력","霹|靂")같이 지르며 #ruby("관|리","官|吏")를 보고 호통쳤다.]
#zh[我进了监狱，在狱中又闹了一场大乱。不是别的，他们又把我放在盗贼囚间、套上脚枷，我大为愤慨。我声音像霹雳一样，对着官吏喝道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("전","前")에는 내가 아무 #ruby("의|사","意|思")를 드러내지 않았으므로 나에 #ruby("대","對")한 #ruby("대|우","待|遇")를 #ruby("강|도","强|盜")로 하나 무엇으로 하나 잠잠히 입 다물고 있었다. 허나 오늘은 #ruby("정|당","正|當")하게 내 뜻을 #ruby("발|표","發|表")하였음에도 아직도 나를 이다지 #ruby("홀|대","忽|待")하느냐? #ruby("획|지|위|옥","劃|地|爲|獄")이라도 #ruby("의|불|출","義|不|出")일라.#footnote(numbering: _ => [84)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “땅에 금만 그어놓고 그것을 #ruby("감|옥","監|獄")이라 하여도 나는 #ruby("도|망","逃|亡")가지 않을 것이다.”] 내가 #ruby("당|초","當|初")에 도망하여 살고자 하는 생각이 있었다면, #ruby("왜","倭")놈을 죽였던 그 자리에 내 #ruby("주|소","住|所")와 #ruby("성|명","姓|名")을 갖추어서 #ruby("포|고","布|告")하고, 또 내 집에 와서 석 달#ruby("여","餘")나 잡으러 오기를 기다리고 있었겠느냐? 너희 #ruby("관|리","官|吏")의 무리들이 #ruby("왜","倭")놈을 기쁘게 하기 #ruby("위","爲")해 내게 이런 나쁜 #ruby("대|우","待|遇")를 하느냐?”]
#zh[“从前我没有表明任何意思，所以把我当强盗也好、当什么也好，我闭着嘴。可是今天已经正当地发表了我的意思，还这样怠慢我吗？纵然划地为狱，我也不越出去。我当初若想逃走求生，还会在杀死倭寇的地方写上住址和姓名出布告，又在家里等了三个多月等人来抓吗？你们这些官吏，是为了讨倭寇欢心，才这样亏待我吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 말을 하면서 어찌나 #ruby("요|동","搖|動")을 쳤던지, 한 차꼬 구멍에 같이 발목을 넣고 있던 #ruby("자","者")들이 #ruby("좌|우","左|右")로 네 사람씩 #ruby("도|합","都|合") 아홉 사람이었는데 그들이 말을 더 보태서 #ruby("과|장","誇|張")하여 소리지르기를, 내가 한 다리로 #ruby("좌|우","左|右") 여덟 사람의 차꼬 #ruby("전|부","全|部")를 들고 일어서는 바람에 저희들의 발목이 다 부러졌다고 #ruby("고|함","高|喊")#ruby("고|함","高|喊") #ruby("야|단","惹|端")이었다.]
#zh[说这些话的时候摇动得那么厉害。一个脚枷洞里一起锁着脚踝的人，左右各四个，一共九个人。他们添油加醋地喊，说我用一条腿把左右八个人的脚枷全都举起来，他们的脚踝都断了，大嚷大叫。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|윤|정","金|潤|晶")이 #ruby("즉|시","卽|時") #ruby("감|옥","監|獄") 안에 들어와 이 #ruby("광|경","光|景")을 보고 애꿎은 #ruby("간|수","看|守")를 #ruby("책","責")하였다.]
#zh[金润晶立刻进了监狱，看见这光景，责备无辜的看守。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그 사람은 다른 #ruby("죄|수","罪|囚")들과 다른데 왜 도둑 #ruby("죄|수","罪|囚")들과 섞여 있게 하느냐? 하물며 그는 #ruby("중|병","重|病")에 들어 있지 않느냐? #ruby("즉|각","卽|刻") 좋은 #ruby("방","房")으로 옮겨 몸을 풀어주고 너희들이 잘 #ruby("보|호","保|護")하여 드려라.”]
#zh[“这个人跟别的囚犯不同，为什么和盗贼囚犯混在一起？何况他不是害着重病吗？立刻移到好房间，解开身子，你们好好保护。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때부터 나는 #ruby("감|옥","監|獄") 안의 #ruby("왕","王")이 되었다. 어머님이 #ruby("옥|문","獄|門") 밖에서 #ruby("면|회","面|會")를 오시는데, 비록 #ruby("초|조","焦|燥")한 얼굴이었으나 #ruby("희|색","喜|色")이 돌았다. 어머님은 말씀하셨다.]
#zh[从此我成了狱中王。]
#zh[焦躁的母亲来探监时，脸上也露出了喜色。她说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아까 네가 #ruby("신|문","訊|問")을 받고 나온 뒤에 #ruby("경|무|관","警|務|官")이 돈 150#ruby("냥","兩")#footnote(numbering: _ => [85)])[#h(0.35em)#ruby("원|주","原|註"): “現今 三圓”.]을 보내고 네 #ruby("보|약","補|藥")을 먹이라고 하더라. 오늘부터는 #ruby("주|인","主|人") #ruby("내|외","內|外")는 #ruby("물|론","勿|論")이고 #ruby("사|랑","舍|廊") 손님들도 나를 매우 #ruby("존|경","尊|敬")하며 #ruby("대","對")하고, 또 #ruby("옥|중","獄|中")에 있는 아드님이 무슨 #ruby("음|식","飮|食")이든지 자시고 싶어하거든 말만 하면 다 해주겠다고 한다. #ruby("일|전","日|前")에는 어떤 뚜쟁이 할미가 와서 ‘그 집에 #ruby("고|용","雇|傭")살이하는 것보다는 내가 #ruby("중|매","仲|媒")를 서서 돈 많고 #ruby("권|력","權|力")도 많은 #ruby("남|편","男|便")을 얻어 줄 터이니 그리 가서 #ruby("옥","獄")에 밥도 맘대로 해 가져가고 일도 #ruby("주|선","周|旋")하여 #ruby("속","速")히 나오도록 하여 주는 것이 어떠냐’ 하기로, 나는 #ruby("남|편","男|便")이 있어 며칠 안에 이곳에 온다고 말한 일도 있다.”]
#zh[“刚才你受审出来，金警务官送来一百五十两（现在的三圆），说是给你买补药吃的呢！我的房东东家夫妇自不必说待我更好，连他们家客舍的客人们也对我肃然起敬。东家对我说，你狱中的儿子想吃什么，只要说一声，就给做。还有一个保媒拉纤的老太婆跟我说她愿意做媒，给我找一个有钱有势的丈夫，比在人家当佣人好，嫁到他家，往牢里送饭不用发愁，还可设法救你儿子早日出狱。我说我已有丈夫，不日就要来到。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 말씀을 들으니 #ruby("천|지","天|地")가 아득하였다.]
#zh[听了这话，天地昏暗。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그것이 다 이놈의 #ruby("죄","罪")올시다.”]
#zh[“这都是我这做儿子的罪。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 말씀밖에는 드릴 말씀이 없었다.]
#zh[除此之外，没有别的话可说。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|화|보","李|和|甫")는 불려가서 #ruby("신|문","訊|問")을 당할 때나#footnote(numbering: _ => [86)])[#h(0.35em)#ruby("이|화|보","李|和|甫")도 #ruby("백|범","白|凡")과 마찬가지로 8#ruby("월","月") 31#ruby("일","日") 처음 #ruby("심|문","審|問")받았다.] #ruby("감|옥","監|獄") 안에서나 #ruby("김|창|수","金|昌|洙")는 #ruby("지|혜","知|慧")와 #ruby("용|기","勇|氣")를 #ruby("겸|비","兼|備")하여 어느 누구도 그를 #ruby("능","能")히 당할 수 없고, 하룻걸음으로 700#ruby("리","里")를 가고 한 끼 밥을 일곱 그릇씩 먹는다고 #ruby("선|전","宣|傳")하였다. 내가 #ruby("감|옥","監|獄")에서 #ruby("야|단","惹|端")을 할 때나 #ruby("죄|수","罪|囚")들이 #ruby("소|동","騷|動")할 때, #ruby("이|화|보","李|和|甫")는 #ruby("자|기","自|己")가 #ruby("전","前")에 했던 말이 다 들어맞은 것처럼 떠들어댔다. 그는 #ruby("자|기","自|己") 집에서 #ruby("살|인","殺|人") #ruby("사|건","事|件")이 일어났는데도 #ruby("수|수|방|관","袖|手|傍|觀")하였고, #ruby("살|인","殺|人") #ruby("후","後")에라도 #ruby("살|인|자","殺|人|者")를 #ruby("결|박","結|縛")하여 놓고 #ruby("관|청","官|廳")에 #ruby("고|발","告|發")하지 않았다는 #ruby("죄|목","罪|目")으로 #ruby("신|문","訊|問")을 당한 것이었다.]
#zh[我能以一只腿将扣上九个人的长足枷举起来，更使得李和甫高兴了。他被捕的罪名，就是放任杀人犯杀人逃逸。他在狱中或受审时曾经辩白说：一顿吃七碗饭，一日行七百里的大力士，我如何能绑得住呢？这句话到了今天才得到证实。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날부터 #ruby("옥|문","獄|門") 앞에 내 얼굴을 보려고 #ruby("면|회","面|會")를 #ruby("청","請")하는 사람들이 하나 둘 생기기 #ruby("시|작","始|作")했다. #ruby("감|리|서","監|理|署")·#ruby("경|무|청","警|務|廳")·#ruby("순|검|청","巡|檢|廳")·#ruby("사|령|청","使|令|廳") #ruby("등","等")에 있는 #ruby("수|백","數|百") #ruby("명","名")의 #ruby("직|원","職|員")들이 #ruby("각|각","各|各") #ruby("자|기","自|己") #ruby("친","親")한 사람들에게 “#ruby("제|물|포","濟|物|浦") #ruby("개|항","開|港")된 지 9#ruby("년","年"), #ruby("즉","卽") #ruby("감|리|서","監|理|署") #ruby("설|립","設|立")된 #ruby("후","後") 처음 보는 #ruby("희|귀","稀|貴")한 #ruby("사|건","事|件")”이라고 자랑 #ruby("겸","兼") #ruby("선|전","宣|傳")을 했던 까닭이었다. #ruby("항|구","港|口") 안에 있는 #ruby("권|력|자","權|力|者")들은 #ruby("물|론","勿|論")이고 #ruby("노|동|자","勞|動|者")들까지 제#ruby("각|기","各|其") 아는 #ruby("관|리","官|吏")를 찾아가서 언제 #ruby("김|창|수","金|昌|洙")를 다시 #ruby("신|문","訊|問")하는지 미리 알려 달라는 #ruby("청|탁","請|託")을 많이 한다는 말을 들었다.]
#zh[从第二天起，狱门前开始有人一个两个地请求会面，要看我的脸。监理署、警务厅、巡检厅、使令厅的几百名职员，各自对亲近的人夸耀兼宣传，说“济物浦开港九年，也就是监理署设立以后头一次见到的稀罕事件”。听说港口里的有权势的人不必说，连劳动者也各自去找认识的官吏，托他们预先告知什么时候再审问金昌洙。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러던 차에 제2#ruby("차","次") #ruby("신|문|일","訊|問|日")을 맞게 되었다.#footnote(numbering: _ => [87)])[#h(0.35em)#ruby("심|문|자|료","審|問|資|料")에 #ruby("의","依")하면 그날은 1896#ruby("년","年") 9#ruby("월","月") 5#ruby("일","日")\(#ruby("음|력","陰|曆") 7#ruby("월","月") 28#ruby("일","日"))이다.] 그날도 #ruby("역|시","亦|是") #ruby("간|수","看|守")의 등에 업혀 #ruby("옥|문","獄|門") 밖을 나섰다. #ruby("사|방","四|方")을 살펴보니 길에는 사람이 가득 찼고 #ruby("경|무|청","警|務|廳") 안에는 #ruby("각","各") #ruby("관|청","官|廳")의 #ruby("관|리","官|吏")와 #ruby("항|구","港|口")의 #ruby("유|력|자","有|力|者")들이 다 모인 #ruby("모|양","模|樣")이었다. 담#ruby("장","牆") 꼭대기와 지붕 위까지 #ruby("경|무|청","警|務|廳") 뜰이 보이는 곳은 어디나 사람들이 다 올라가 있었다. #ruby("법|정","法|庭") 안에 들어가 앉으니 #ruby("김|윤|정","金|潤|晶")이 슬쩍 내 곁으로 지나가며,]
#zh[就在这时到了第二次审问的日子。那天仍被看守背着出了狱门。四面一看，路上挤满了人，警务厅里像是各官厅的官吏和港口的有力人物都到了。围墙顶上和屋顶上，凡是看得见警务厅院子的地方都上了人。进法庭坐下，金润晶悄悄从我身边经过，说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘도 #ruby("왜","倭")놈이 왔으니 #ruby("기|운","氣|運")껏 #ruby("호|령","號|令")을 하시오.”]
#zh[“今天倭寇又来了，请尽管大声骂好了！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[한다. 그때는 #ruby("김|윤|정","金|潤|晶")에게 #ruby("약|간","若|干")의 #ruby("양|심","良|心")이 있었던 듯하다. 그러나 오늘까지 #ruby("소|위","所|謂") #ruby("경|성|부","京|城|府")의 #ruby("참|여|관","參|與|官") 노릇을 하고 있는 것을 보면, 그때 내가 #ruby("신|문","訊|問")받던 자리를 #ruby("연|극|장","演|劇|場")으로 삼고 나를 #ruby("배|우","俳|優")의 하나로 많은 사람들 앞에 구경시킨 것이었다고 #ruby("해|석","解|釋")할 수도 있다. 그러나 #ruby("심|지","心|志")가 곧지 못한 #ruby[사람][無恒輩]의 #ruby("행|위","行|爲")로 그 #ruby("역|시","亦|是") 그때는 #ruby("의|협|심","義|俠|心")이 좀 생겼다가 날이 오라지는 대로 마음도 따라 #ruby("변","變")한 것이라고도 볼 수 있을 것 같다.]
#zh[金润晶看来似乎还有点良心，但他现在当所谓京城府参与官，这可是日本大官，所以我想他也许是视公署为戏院，视我为演员。也可以这样认为，当时他虽多少有点出自义愤，但毕竟是无恒心之辈，时间一久，也就变心了——对他这样的看法，可能比较正确。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다시 #ruby("신|문","訊|問")을 #ruby("시|작","始|作")한 #ruby("후","後") “나는 #ruby("전","前")에 다 말하였으니 다시 할 말이 없다”고 말을 끝냈다. 그리고는 뒷#ruby("방","房")에 앉아 나를 넘겨다보고 있던 #ruby("와타나베","渡邊")를 #ruby("향","向")해 꾸짖다가 다시 #ruby("감|옥","監|獄")으로 돌아왔다.]
#zh[第二天的审问，我说了一句话就结束：]
#zh[“上次要讲的已经都讲完了，再也无话可说。”]
#zh[并且把在后室窥察我的渡边又臭骂了一顿。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後")로는 #ruby("면|회","面|會")하러 오는 사람의 #ruby("수","數")가 더욱 많아졌다. #ruby("대|개","大|槪") 이런 말들을 하였다.]
#zh[此后前来会面的人更多了。大致都这样说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("인|천|항","仁|川|港")에 #ruby("거|주","居|住")하는 아무개올시다. #ruby("당|신","當|身")의 #ruby("의|기","義|氣")를 #ruby("사|모","思|慕")하여 #ruby("신|문|장","訊|問|場")에서 얼굴을 뵈었소이다. 설마 오래 #ruby("고|생","苦|生")하려고요. #ruby("안|심","安|心")하고 지내십시오. #ruby("출|옥","出|獄") #ruby("후","後")에 한 자리에서 반가이 뵙시다.”]
#zh[“我是住在仁川港的某某。仰慕您的义气，在审问场见了面。总不至于长久吃苦。请放心过。出狱以后，再在一处高兴地见面。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("면|회","面|會") 올 때는 #ruby("음|식","飮|食")을 한 #ruby("상","床")씩 #ruby("정|성","精|誠")스레 #ruby("준|비","準|備")하여 들여보내 주었다. 나는 그 사람들의 #ruby("정","情")에 #ruby("감|동","感|動")하여 보는 데서 몇 #ruby("점","點")씩 먹고는 #ruby("죄|수","罪|囚")들에게 #ruby("차|례","次|例")로 나누어주었다. 그때의 #ruby("감|옥|제|도","監|獄|制|度")는 #ruby("죄|수","罪|囚")들에게 #ruby("음|식|물","飮|食|物")을 #ruby("규|칙|적","規|則|的")으로 날마다 나누어주는 것이 아니라 #ruby("죄|수","罪|囚")들이 일을 하여 짚신이라도 삼으면 #ruby("간|수","看|守")가 #ruby("인|솔","引|率")하고 길거리에 나가 팔아다가 #ruby("죽","粥")이나 쑤어 먹는 판이었다. 내게 가져오는 #ruby("음|식","飮|食")은 #ruby("준|비","準|備")하는 사람들이 되도록 #ruby("정|성","精|誠")을 다해 #ruby("준|비","準|備")한 것이었으므로, #ruby("죄|수","罪|囚")들도 #ruby("죄|수","罪|囚")들이지만 나도 처음 먹는 #ruby("음|식","飮|食")이 많은 터였다. 앉은 #ruby("차|례","次|例")대로 내가 나오는 날까지 그 #ruby("음|식","飮|食")들을 나누어 먹었다.]
#zh[尤其是来找我的人，为表示他们的心意，几乎每人都准备一桌饭菜，送来劝我吃。而我总要在拿来的人面前尝尝，以示领情致谢，剩下的依次分给贼囚房的其他囚犯们。]
#zh[由于当时的监狱制度还未步入正轨，并不是有规律地一天供给三餐，而是由囚犯们自己编草鞋，在狱卒的看押下拿到街上出售，买米回来煮稀饭吃。因此，我分给他们的饮食，使大家非常高兴。因为是大家轮流给我送饭菜，很多食物我还是初次尝到。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[제3#ruby("차","次") #ruby("신|문","訊|問")은 #ruby("감|리|서","監|理|署")에서 했는데,#footnote(numbering: _ => [88)])[#h(0.35em)#ruby("심|문|자|료","審|問|資|料")에 #ruby("의","依")하면 그날은 1896#ruby("년","年") 9#ruby("월","月") 10#ruby("일","日")\(#ruby("음|력","陰|曆") 8#ruby("월","月") 4#ruby("일","日"))이다.] 그날도 #ruby("항|내","港|內") #ruby("거|주|자","居|住|者")는 다 모인 것 같았다. 그날은 #ruby("감|리|사","監|理|使") #ruby("이|재|정","李|在|正")이 #ruby("친","親")히 #ruby("신|문","訊|問")을 하였는데, #ruby("왜","倭")놈은 보이지 않았다. #ruby("감|리","監|理")가 매우 #ruby("친|절","親|切")히 말을 묻고, 나중에 #ruby("신|문|서","訊|問|書") 꾸민 것을 내게 보여 읽게 하고 고칠 것은 고치게 하고 #ruby("백|자","白|字")에 #ruby("착|함","着|啣")하였다.#footnote(numbering: _ => [89)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("백|자","白|字")에 #ruby("서|명","署|名")하였다.” #ruby("착|함","着|啣")은 #ruby("착|압","着|押"). 마지막에 #ruby[아뢴다][白]는 글#ruby("자","字")에 #ruby("서|명","署|名")하는 것을 말한다.] 이로써 #ruby("신|문","訊|問")은 끝이 났다.#footnote(numbering: _ => [90)])[#h(0.35em)#ruby("신|문","訊|問") #ruby("과|정","過|程")에서 #ruby("쟁|점","爭|點")은 ① #ruby("단|독","單|獨") #ruby("범|행","犯|行") #ruby("여|부","與|否"), ② #ruby("백|범","白|凡")이 #ruby("의|병","義|兵")이라 #ruby("자|칭","自|稱")한 #ruby("부|분","部|分"), ③ 쓰치다로부터 빼앗은 돈의 #ruby("액|수","額|數"), ④ 쓰치다를 죽일 때 #ruby("사|용","使|用")한 #ruby("병|기","兵|器") #ruby("등","等")이었다.]]
#zh[第三次审问不在警务厅而是在监理厅，由李在正亲自主持。监理以亲切的口吻审问我，审问完毕后，容许我看一遍口供，如有不适当的地方由我修改，修改完毕后，在空白处签了我的名字，到此审问完毕。这一天没有日本人出席。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[며칠 #ruby("후","後")에는 #ruby("왜","倭")놈들이 내 #ruby("사|진","寫|眞")을 박는다고 해서 #ruby("경|무|청","警|務|廳")으로 또 업혀 들어갔다. 그날도 #ruby("법|정","法|庭") 안팎에 #ruby("허|다","許|多")한 구경꾼이 #ruby("인|산|인|해","人|山|人|海")를 이루었다. #ruby("김|윤|정","金|潤|晶")이 슬쩍 내 귀에 들리게 말하였다.]
#zh[几天后，日本人要拍我的照片，我又被背进了警务厅，这一天有许多得到消息的人拥来旁观，警务厅院子里里外外是人山人海。金润晶低声悄悄地告诉我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘 저 사람들이 #ruby("창|수","昌|洙")의 #ruby("사|진","寫|眞")을 박으러 왔으니, 주먹을 쥐고 눈을 부릅뜨고 #ruby("사|진","寫|眞")을 찍으시오.”]
#zh[“今天，那些人是为了拍昌洙的照片而来的，因此就握拳怒目给他拍照好了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 #ruby("사|진","寫|眞")을 찍느니 못 찍느니가 #ruby("교|섭","交|涉")의 #ruby("문|제","問|題")가 되어 한참 동안 #ruby("의|논","議|論")이 #ruby("분|분","紛|紛")하였다. #ruby("결|국","結|局") #ruby("청|사","廳|舍")에서는 #ruby("허|락","許|諾")지 못할 터이니 #ruby("노|상","路|上")에서나 찍으라 하고 나를 업어서 길거리에 앉혔다. #ruby("왜","倭")놈이 다시 #ruby("청","請")하기를 #ruby("김|창|수","金|昌|洙")에게 #ruby("수|갑","手|匣")을 채우든지 #ruby("포|승","捕|繩")으로 얽든지 하여 #ruby("죄|인","罪|人")된 #ruby("표","表")를 내어 달라고 하였다. #ruby("김|윤|정","金|潤|晶")은 #ruby("거|절","拒|絶")하였다.]
#zh[可是拍不拍照片成了交涉问题，议论纷纷了好一阵。终于厅舍里不能准许，叫他们到路上拍，把我背到街上坐下。倭寇又请求给金昌洙戴上手铐，或者用捕绳捆上，显出罪犯的样子。金润晶拒绝了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이 사람은 ‘#ruby("계|하|죄|인","階|下|罪|人")’#footnote(numbering: _ => [91)])[#h(0.35em)‘階下罪人’은 ‘啓下罪人’. #ruby("즉","卽") 임금의 #ruby("재|가","裁|可")를 받은 #ruby("죄|인","罪|人").]이라 #ruby("대|군|주","大|君|主")\(#ruby("고|종","高|宗")) #ruby("폐|하","陛|下")의 #ruby("분|부","分|付")가 없는 #ruby("이|상","以|上") 그 몸에 #ruby("형|구","刑|具")를 댈 수 없소.”]
#zh[“这个人是阶下罪人，没有大君主陛下的吩咐，不能在他身上加刑具。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜|인","倭|人")은 다시 #ruby("질|문","質|問")하였다.]
#zh[倭人又质问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("정|부","政|府")에서 #ruby("형|법","刑|法")을 #ruby("정","定")하여 #ruby("사|용","使|用")하면, 그것이 곧 #ruby("대|군|주","大|君|主")의 #ruby("명|령","命|令")이 아니오?”]
#zh[“政府制定刑法来用，那不就是大君主的命令吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|윤|정","金|潤|晶")은 #ruby("갑|오|경|장","甲|午|更|張") #ruby("후","後")에 #ruby("형|구","刑|具")는 #ruby("전|부","全|部") #ruby("폐","廢")하였다고 #ruby("답","答")했다. #ruby("왜|인","倭|人")은 다시 말했다.]
#zh[金润晶又说：]
#zh[“自从‘甲午更张’以来，我国已经废止了刑具。”]
#zh[日寇提出质问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("귀|국","貴|國")의 #ruby("감|옥","監|獄") #ruby("죄|수","罪|囚")들이 쇠사슬 찬 것과 칼 쓴 것을 내가 보았소.”]
#zh[“我看到贵国监狱里的囚犯仍然是戴着长枷，套上链子。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|윤|정","金|潤|晶")은 #ruby("노","怒")하여 그 #ruby("왜","倭")놈을 꾸짖으며 #ruby("야|단","惹|端")하였다.]
#zh[金润晶恼怒而大声责骂道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("죄|수","罪|囚")의 #ruby("사|진","寫|眞")에 #ruby("대","對")해 #ruby("조|약","條|約")에 #ruby("정","定")한 #ruby("의|무","義|務")는 없소. #ruby("단|지","但|只") #ruby("상|호|간","相|互|間")에 #ruby("참|고|자|료","參|考|資|料")로 삼으려는 것에 #ruby("불|과","不|過")한 작은 일로 이같이 #ruby("내|정|간|섭","內|政|干|涉")을 하는 것은 받아들일 수 없소.”]
#zh[“拍囚犯照片，并不是条约所规定的义务，仅仅是相互间的参考资料罢了，不能在这种细微末节的事上，由别人干涉我国内政。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[구경꾼들은 #ruby("경|무|관","警|務|官")이 #ruby("명|관","名|官")이라고 #ruby("칭|찬","稱|讚")하였다.]
#zh[于是围观的群众交口赞誉，称金润晶是一位精明的长官。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("급|기|야","及|其|也") 길거리에서 #ruby("사|진","寫|眞")을 찍게 되었다. #ruby("왜","倭")놈이 다시 #ruby("구|걸","求|乞")하듯 #ruby("청","請")하니, 내가 앉은 옆자리에 #ruby("포|승","捕|繩")을 놓아두고 #ruby("사|진","寫|眞")을 찍었다. 나는 며칠 #ruby("전","前")보다는 #ruby("기|운","氣|運")이 좀 돌아와 있었으므로, #ruby("경|무|청","警|務|廳")이 들렸다 놓일 #ruby("정|도","程|度")로 큰소리를 질러 #ruby("왜","倭")놈을 꾸짖고, #ruby("일|반","一|般") #ruby("관|중","觀|衆")들을 #ruby("향","向")하여 #ruby("고|함","高|喊")#ruby("고|함","高|喊") 질러 #ruby("연|설","演|說")을 하였다.]
#zh[由于日本人的一再要求，最后在我的身旁放一副绳索作为拍照的背景。]
#zh[由于我的体力较几天以前有所恢复，于是便痛骂倭寇，向云集的观众发表了一场演说——我高声喊着，吼声震撼了警务厅。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이제 #ruby("왜","倭")놈이 #ruby("국|모","國|母")를 #ruby("살|해","殺|害")하였으니 온 나라 #ruby("백|성","百|姓")에게 크나큰 #ruby("대|치|욕","大|恥|辱")이오. 뿐 아니라 #ruby("왜","倭")놈의 #ruby("독|해","毒|害")는 #ruby("궐|내","闕|內")에만 그치지 않을 것이오. #ruby("당|신","當|身")들의 아들들과 딸들이 #ruby("필|경","畢|竟")은 #ruby("왜","倭")놈의 손에 다 죽을 터이니 나를 본받아서 #ruby("왜","倭")놈을 보는 대로 만나는 대로 다 죽입시다!”]
#zh[“诸位！倭寇杀害了我国国母闵后，对我国而言，是一种无比的耻辱和仇恨，倭寇的危害绝不仅止于宫内，就是你们的儿女，最后都将被倭寇杀害；所以诸位！你们也要仿效我，遇到倭寇，就要见一个杀一个。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈 #ruby("와타나베","渡邊")가 #ruby("직|접","直|接") 나에게 말했다.]
#zh[倭寇渡边直接对我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 그러한 #ruby("충|의","忠|義")가 있을진댄 어찌 벼슬을 못하였느냐?”]
#zh[“你既有这样的忠义，为什么做不了官？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 벼슬을 못하는 #ruby("상","常")놈이기 때문에 작은 놈밖에 죽이지 못하였다. 그러나 벼슬하는 #ruby("양|반","兩|班")들은 너희 #ruby("황|제","皇|帝")의 목을 베어 #ruby("원|수","怨|讐")를 갚을 것이다.”]
#zh[“因为我是不会做官的小百姓，所以我不过杀了个小小的倭寇，做大官的将要砍下你们皇帝的脑袋来报仇雪恨。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러자 #ruby("김|윤|정","金|潤|晶")은 #ruby("와타나베","渡邊")를 #ruby("향","向")하여 말했다.]
#zh[于是金润晶对渡边说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("당|신","當|身")들은 #ruby("죄|수","罪|囚")에게 #ruby("직|접","直|接") #ruby("신|문","訊|問")할 #ruby("권|리","權|利")가 없으니 가시오.”]
#zh[“你们没有直接审问囚犯的权利，走吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그를 물리쳐 보낸 #ruby("후","後") 나는 #ruby("김|윤|정","金|潤|晶")에게 #ruby("이|화|보","李|和|甫")의 #ruby("석|방","釋|放")을 #ruby("요|구","要|求")했다.]
#zh[把他打发走之后，我要求金润晶释放李和甫。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("이|화|보","李|和|甫")는 아무런 #ruby("관|계","關|係")가 없으니 오늘 #ruby("당|장","當|場") #ruby("방|면","放|免")시켜 주시오.”]
#zh[“李和甫毫无关系，今天立刻放了吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“알아서 #ruby("처|리","處|理")할 터이니 #ruby("과","過")히 #ruby("우|려","憂|慮") 마시오.”]
#zh[“我会处理，不必过虑。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄")에 돌아온 지 얼마 못 되어 #ruby("이|화|보","李|和|甫")를 #ruby("호|출","呼|出")하더니 #ruby("석|방","釋|放")해 주었다.#footnote(numbering: _ => [92)])[#h(0.35em)#ruby("이|화|보","李|和|甫")가 #ruby("석|방","釋|放")된 것은 #ruby("김|창|수","金|昌|洙")의 3#ruby("차","次") #ruby("신|문","訊|問")이 끝나고 난 뒤인 10#ruby("월","月") 3#ruby("일","日")이다.] #ruby("이|화|보","李|和|甫")는 #ruby("옥|문","獄|門") 밖에서 나를 찾아와 “#ruby("당|신","當|身")이 말을 잘 해주어 #ruby("무|사","無|事")히 #ruby("석|방","釋|放")되었소” 하고 #ruby("치|사","致|謝")하고는 #ruby("작|별","作|別")하였다.]
#zh[回到监狱不久，便叫出李和甫，把他释放了。李和甫在狱门外找我，说“您替我说了好话，才平安释放”，道了谢，作别而去。]
#heading(level: 3)[#text(font: "KOPUSGo B")[7) #ruby("사|형|수","死|刑|囚")의 #ruby("옥|중|생|활","獄|中|生|活")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이때부터의 #ruby("옥|중|생|활","獄|中|生|活")을 #ruby("대|략","大|略") 들어 쓴다면 다음과 같다.]
#zh[从此以后的狱中生活，大致写来如下。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫#ruby("번","番")째, #ruby("독|서","讀|書").]
#zh[第一，读书。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아버님이 오셔서 『#ruby("대|학","大|學")』#footnote(numbering: _ => [93)])[#h(0.35em)#ruby("유|교","儒|敎") #ruby("경|전","經|傳")으로 #ruby("사|서","四|書") #ruby("중","中")의 하나. #ruby("공|자","孔|子")의 #ruby("손|자","孫|子") #ruby("자|사","子|思")가 지었다고 한다.] 한 #ruby("질","帙")을 사 넣어 주셨으므로 #ruby("매|일","每|日") 『#ruby("대|학","大|學")』을 읽고 외었다. #ruby("인|천|항","仁|川|港")은 우리나라에서 #ruby("제|일","第|一") 먼저 #ruby("개|항","開|港")된 곳이었으므로,#footnote(numbering: _ => [94)])[#h(0.35em)#ruby("백|범","白|凡")은 #ruby("인|천","仁|川")이 #ruby("제|일","第|一") 먼저 #ruby("개|항","開|港")된 곳이라 하였으나, 1876#ruby("년","年") #ruby("강|화|도|조|약","江|華|島|條|約") #ruby("체|결","締|結") #ruby("이|후","以|後") #ruby("부|산","釜|山")\(1876#ruby("년","年")), #ruby("원|산","元|山")\(1879#ruby("년","年")), #ruby("인|천","仁|川")\(1880#ruby("년","年")) #ruby("순|서","順|序")로 #ruby("개|항","開|港")되었다.] #ruby("구|미","歐|美") #ruby("각|국","各|國")에서 들어온 #ruby("거|주|자","居|住|者")와 #ruby("여|행|자","遊|歷|者")들이 있었고 #ruby("각","各") #ruby("종|교|당","宗|敎|堂")도 #ruby("설|립","設|立")되어 있었다. 우리나라 사람 #ruby("중","中")에서도 #ruby("간|혹","間|或") #ruby("외|국","外|國")으로 장사하러 나가 다니면서 #ruby("신|문|화","新|文|化")의 #ruby("취|미","趣|味")를 아는 #ruby("자","者")가 #ruby("약|간","若|干") 있던 때였다.]
#zh[父亲来了，买了一部《大学》送进来，我每天读《大学》、背《大学》。仁川港是我国最先开港的地方，所以有从欧美各国来的居民和游历者，各种教堂也设立了。我国人里面，也偶尔有出外做买卖、略知新文化趣味的人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|리|서","監|理|署") #ruby("직|원","職|員") #ruby("중","中")에서도 나와 이야기해 본 #ruby("후","後") #ruby("신|서|적","新|書|籍")들을 읽어보라고 #ruby("권","勸")하는 사람이 있었다.]
#zh[监理署职员里面，也有人和我谈过之后，劝我读新书籍。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("문","門")을 굳게 닫아 걸고 #ruby("자|기","自|己") 것만 지키려는 #ruby("구|지|식","舊|知|識")·#ruby("구|사|상","舊|思|想")만으로는 나라를 #ruby("구","救")할 수가 없소. #ruby("세|계","世|界") #ruby("각|국","各|國")의 #ruby("정|치","政|治")·#ruby("문|화","文|化")·#ruby("경|제","經|濟")·#ruby("도|덕","道|德")·#ruby("교|육","敎|育")·#ruby("산|업","産|業")이 어떠한지를 #ruby("연|구","硏|究")해 보고, 내 것이 남만 못하면 좋은 것을 #ruby("수|입","輸|入")하여 우리 것으로 만들어, 이 나라와 #ruby("백|성","百|姓")의 살림살이를 #ruby("유|익","有|益")되게 하는 것이 #ruby("시|대","時|代") #ruby("과|제","時|務")를 아는 #ruby("영|웅","英|雄")의 할 일인 것이오. 한갓 #ruby("배|외|사|상","排|外|思|想")만으로는 이 나라가 #ruby("멸|망","滅|亡")하는 것을 #ruby("구","救")하지 못하오. 그러니 #ruby("창|수","昌|洙")와 같이 #ruby("의|기","義|氣") 있는 #ruby("남|자","男|子")는 마땅히 #ruby("신|지|식","新|知|識")을 #ruby("구","求")하여 #ruby("장|래","將|來") #ruby("국|가","國|家")에 큰 일을 하여야 하오。”]
#zh[“把门关得死死的，只守着自己的旧知识、旧思想，救不了国家。要研究世界各国的政治、文化、经济、道德、教育、产业是怎样的，自己的不如别人，就把好的输进来变成我们的，使这个国家和百姓的日子有益，这才是识时务的英雄该做的事。单靠排外思想，救不了这个国家的灭亡。所以像昌洙这样有义气的男子，应当求新知识，将来为国家做大事。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이같이 말하며, 『#ruby("세|계|역|사·|지|지","世|界|歷|史·|地|誌")』 #ruby("등","等") #ruby("중|국","中|國")에서 #ruby("발|간","發|刊")된 #ruby("책|자","冊|子")와 #ruby("국|한|문","國|漢|文")으로 #ruby("번|역","飜|譯")된 것을 갖다주며 읽어보라 #ruby("권","勸")하는 이도 있었다. “#ruby("조|문|도|석|사|가|의","朝|聞|道|夕|死|可|矣")”#footnote(numbering: _ => [95)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “아침에 #ruby("도","道")를 깨우치면 저녁에 죽어도 좋다”. 『#ruby("논|어","論|語")』 「#ruby("이|인","里|仁")」#ruby("편","篇")에 나오는 #ruby("공|자","孔|子")의 말.] 하는 #ruby("격","格")으로, 내 죽을 날이 당할 때까지 글이나 실컷 보리라 하고 손에서 #ruby("책","冊") 놓을 사이 없이 #ruby("열|심","熱|心")히 글을 읽었다. #ruby("감|리|서","監|理|署") #ruby("직|원","職|員")들이 #ruby("종|종","種|種") 와서 내가 #ruby("신|서|적","新|書|籍")에 #ruby("열|심","熱|心")하는 것을 보고는 매우 좋아하는 빛을 보였다.]
#zh[他给我看在中国刊行的或用韩文翻译的《世界历史》、《地志》等书籍。我虽明白随时都会被判处死刑，可是“朝闻道夕死可矣”，在死刑到来之前，我手不释卷地研读这些新书。监理署官员见我这么热心地读书也非常欢喜。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("신|서|적","新|書|籍")을 보고 새로 깨달은 것은, #ruby("고|선|생","高|先|生")이 #ruby("전","前")에 #ruby("조|상","祖|上")께 #ruby("제|사","祭|祀")지내면서 ‘#ruby("유|세|차","維|歲|次") #ruby("영|력","永|曆") #ruby("이|백","二|百") 몃해’#footnote(numbering: _ => [96)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("유|세|차","維|歲|次") #ruby("영|력","永|曆") #ruby("이|백","二|百") 몇 해”. #ruby("영|력","永|曆")은 #ruby("명","明")나라 마지막 #ruby("연|호","年|號")\(1647〜1662). #ruby("청","淸")나라를 #ruby("만|주|족","滿|洲|族")으로 #ruby("멸|시","蔑|視")하는 #ruby("존|명|론","尊|明|論")에서는 #ruby("명","明")나라 #ruby("멸|망","滅|亡") #ruby("이|후","以|後")에도 마지막 #ruby("연|호","年|號")를 #ruby("계|속","繼|續") #ruby("사|용","使|用")하여 ‘#ruby("영|력","永|曆")’은 ‘#ruby("이|백","二|百") 몇 #ruby("년","年")’씩이나 #ruby("계|속","繼|續")되었다.]라고 쓴 #ruby("축|문","祝|文")을 읽던 것이나, #ruby("안|진|사","安|進|士")가 #ruby("양|학","洋|學")을 한다고 하여 #ruby("절|교","絶|交")한 일이 그리 잘한 일로 보이지 않는다는 #ruby("점","點")이었다. #ruby("의|리","義|理")는 #ruby("유|학|자","儒|學|者")들에게 배우고, #ruby("문|화","文|化")와 #ruby("제|도","制|度") #ruby("일|체","一|體")는 #ruby("세|계","世|界") #ruby("각|국","各|國")에서 #ruby("채|택","採|擇")하여 #ruby("적|용","適|用")하는 것이 #ruby("국|가","國|家")의 #ruby("복|리","福|利")가 되겠다는 생각이 들었다.]
#zh[读了新书新明白的是：从前高先生祭祖时读的祝文写着“维岁次永历二百几十年”，以及因为安进士学洋学就绝交，看来并不怎么对。义理跟儒学者学，文化和制度一切从世界各国采取来用，才是国家的福利。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전","前")에 #ruby("청|계|동","靑|溪|洞")에서 오로지 #ruby("고|선|생","高|先|生")만을 하나님처럼 #ruby("숭|배","崇|拜")하고 있던 때는, 나 #ruby("역|시","亦|是") #ruby("척|왜|척|양","斥|倭|斥|洋")이 우리의 #ruby("당|연","當|然")한 #ruby("천|직","天|職")이라 생각하였다. 이에 #ruby("반|대","反|對")하는 #ruby("자","者")는 사람이 아니고 #ruby("짐|승","禽|獸")이라고 여겼던 것이다. 그럴 수밖에 없었던 것이, #ruby("고|선|생","高|先|生")은 오직 우리나라에만 #ruby("일|선|양|맥","一|線|陽|脈")이 #ruby("잔|존","殘|存")하엿고#footnote(numbering: _ => [97)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “한 가닥 밝은 #ruby[맥][一線陽脈]이 남아 있고”. #ruby("명","明")나라 #ruby("멸|망","滅|亡") #ruby("이|후","以|後") #ruby("청","淸")나라는 #ruby("만|주|족","滿|洲|族")이므로 우리나라만 #ruby("유|교","儒|敎")의 #ruby("정|통","正|統")이라는 #ruby("의|식","意|識")이 있었는데, 이것을 #ruby("소|중|화","小|中|華") #ruby("의|식","意|識")이라 한다. 그런데 이러한 #ruby("소|중|화","小|中|華") #ruby("의|식","意|識")은 #ruby("명","明")나라 #ruby("멸|망","滅|亡") #ruby("후","後") #ruby("중|국","中|國")의 다른 #ruby("변|방","邊|方"), #ruby("예","例")컨대 #ruby("월|남","越|南")\(베트남) #ruby("등","等")에도 있었다.] #ruby("세|계","世|界") #ruby("각|국","各|國")이 #ruby("대|부|분","大|部|分") #ruby("피|발|좌|임","被|髮|左|袵")#footnote(numbering: _ => [98)])[#h(0.35em)머리털을 풀어헤치고 옷을 왼섶으로 입는다는 뜻으로 #ruby("미|개","未|開")함을 이르는 말이다. #ruby("유|교|적","儒|敎|的") #ruby("관|점","觀|點")에서 볼 때, 상투를 하지 않고 머리털을 풀어헤치는 것은 #ruby("부|모","父|母")가 돌아갔을 때나 하는 일이며, 옷을 왼섶으로 입는 것은 #ruby("북|방","北|方") #ruby("미|개","未|開") #ruby("종|족","種|族")들의 #ruby("관|습","慣|習")이다.]한 오랑캐들이라고 말씀하셨던 것이다. 그런데 『#ruby("태|서|신|사","泰|西|新|史")』 한 #ruby("책","冊")만 보아도, 그 눈이 움푹 들어가고 코가 우뚝 선 원숭이에서 멀지 않은 오랑캐들은 도리어 나라를 세우고 #ruby("백|성","百|姓")을 다스리는 좋은 #ruby("법|규","法|規")가 사람답다는 느낌이 들었다. 그러나 #ruby("아|관|박|대","峨|冠|博|帶")#footnote(numbering: _ => [99)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “높은 갓을 쓰고 넓은 #ruby("요|대","腰|帶")를 두른”.] #ruby("선|풍|도|골","仙|風|道|骨")의 우리 #ruby("탐|관|오|리","貪|官|汚|吏")들은 오히려 그와 같은 오랑캐의 #ruby("칭|호","稱|號")조차 받을 수 없다는 #ruby("사|실","事|實")을 깨닫게 되었다.]
#zh[从前在清溪洞只把高先生像上帝一样崇拜的时候，我也以为斥倭斥洋是我们当然的天职。反对的人，我不看作人，看作禽兽。这也难怪，高先生说只有我国还残存一线阳脉，世界各国大半是披发左衽的夷狄。可是只看一部《泰西新史》，那些眼睛凹进去、鼻子高耸、离猴子不远的夷狄，反而立国治民的好法规倒像是人的。而峨冠博带、仙风道骨的我国贪官污吏，反而连那样的夷狄称号也不配，我明白了这个事实。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[두#ruby("번","番")째, #ruby("교|육","敎|育").]
#zh[第二，教育。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") 함께 갇혀 있던 #ruby("자","者")들이 #ruby("평|균","平|均") 100#ruby("명","名") 가까이 되었는데, 들락날락하는 #ruby("민|사|소|송","民|事|訴|訟") #ruby("사|건","事|件") #ruby("외","外")에는 #ruby("대|다|수","大|多|數")가 #ruby("절|도","竊|盜"), #ruby("강|도","强|盜"), #ruby("사|주","私|鑄"),#footnote(numbering: _ => [100)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("위|조|범","僞|造|犯")”. #ruby("사|주","私|鑄")는 #ruby("사|사","私|私")로이 돈을 #ruby("불|법","不|法")으로 만드는 것.] #ruby("약|인","略|人"),#footnote(numbering: _ => [101)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("사|기","詐|欺")”. #ruby("약|인","略|人")은 사람을 꾀어 #ruby("물|건","物|件")을 빼앗는 #ruby("일|종","一|種")의 #ruby("사|기","詐|欺").] #ruby("살|인","殺|人") #ruby("등","等")을 저지른 #ruby("징|역|수","懲|役|囚")들로 열에 아홉은 #ruby("문|맹","文|盲")이었다. 내가 #ruby("문|자","文|字")를 가르쳐 주겠다고 하니, #ruby("문|자","文|字")를 배워 #ruby("자|기","自|己")가 뒷날 #ruby("긴","緊")하게 쓸 마음보다는 내게 날마다 #ruby("진|수|성|찬","珍|羞|盛|饌")을 얻어먹는 데 #ruby("대","對")한 #ruby("감|사","感|謝")의 #ruby("표|시","表|示")로 배우는 체만 하는 #ruby("자","者")가 많았다.]
#zh[当时一起关着的人平均将近一百名，除了进进出出的民事诉讼，大多数是犯了窃盗、强盗、私铸、略人、杀人等罪的惩役囚，十有九个是文盲。我说要教他们文字，许多人与其想着日后要紧时用，不如当作每天从我这里得珍馐盛馔的谢意，只装出学习的样子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("화|개|동","花|開|洞") #ruby("기|생","妓|生")#ruby("서|방","書|房")으로 #ruby("조|덕|근","曺|德|根")이라는 #ruby("자","者")가 있었는데, #ruby("창|기","娼|妓")를 #ruby("중|국","中|國")에다 팔아넘긴 #ruby("죄","罪")로 10#ruby("년","年") #ruby("징|역|형","懲|役|刑")을 받았다. 그 #ruby("자","者")가 『#ruby("대|학","大|學")』을 배우다가 ‘#ruby("인|생|팔|세|개|입|소|학","人|生|八|歲|皆|入|小|學")’#footnote(numbering: _ => [102)])[#h(0.35em)사람이 나서 8#ruby("세","歲")가 되면 모두 『#ruby("소|학","小|學")』에 #ruby("입|문","入|門")한다는 뜻.]이라는 #ruby("구|절","句|節")을 소리 높여 크게 읽다가 ‘#ruby("개|입","皆|入")’#ruby("자","字")를 잊어버리고 ‘개 아가리 #ruby("소|학","小|學")’이라고 하는 것을 보고서 #ruby("기|절","氣|絶")하여 넘어질 것처럼 웃은 일도 있다.]
#zh[有个花开洞妓女的男人叫曹德根，把娼妓卖到中国，判了十年惩役。他学《大学》，高声读到“人生八岁皆入小学”这句，忘了“皆入”二字，读成“狗嘴里的小学”，我看了几乎笑得昏过去。]
#zh[译注：韩语“皆”“狗”，“入”“口”谐音。]
