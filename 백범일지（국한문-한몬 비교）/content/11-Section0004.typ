#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[때는 #ruby("건|양","建|陽") 2#ruby("년","年")쯤이었다. 『#ruby("황|성|신|문","皇|城|新|聞")』이 #ruby("창|간","創|刊")된 때였다.#footnote(numbering: _ => [103)])[#h(0.35em)#ruby("건|양","建|陽")은 #ruby("양|력","陽|曆")을 쓰기로 한 #ruby("연|호","年|號"). 그런데 『#ruby("황|성|신|문","皇|城|新|聞")』은 1898#ruby("년","年") 9#ruby("월","月") 5#ruby("일","日") #ruby("창|간","創|刊")되기 때문에 1898#ruby("년","年") 3#ruby("월","月") #ruby("탈|옥","脫|獄")하는 #ruby("백|범","白|凡")이 #ruby("옥|중","獄|中")에서 #ruby("도|저","到|底")히 볼 수 없는 #ruby("신|문","新|聞")이다. 따라서 여기서 『#ruby("황|성|신|문","皇|城|新|聞")』은 1896#ruby("년","年") 4#ruby("월","月") 7#ruby("일","日") #ruby("창|간","創|刊")된 『#ruby("독|립|신|문","獨|立|新|聞")』으로 보는 것이 #ruby("타|당","妥|當")하다. #ruby("인|천|감|리|서","仁|川|監|理|署")에서 #ruby("백|범","白|凡")에 #ruby("대","對")한 3#ruby("차","次") #ruby("신|문","訊|問")이 끝나는 것은 1896#ruby("년","年") 9#ruby("월","月") 10#ruby("일","日")인데, 『#ruby("독|립|신|문","獨|立|新|聞")』은 #ruby("인|천|감|리","仁|川|監|理") #ruby("이|재|정","李|在|正")이 #ruby("재|판","裁|判") #ruby("결|과","結|果")를 #ruby("법|부|대|신","法|部|大|臣")에게 #ruby("보|고","報|告")한 #ruby("사|실","事|實")을 #ruby("간|단","簡|單")히 #ruby("보|도","報|道")한 바 있다. 따라서 #ruby("건|양","建|陽") 2#ruby("년","年")\(1897)도 『#ruby("독|립|신|문","獨|立|新|聞")』이 #ruby("창|간","創|刊")된 해인 #ruby("건|양","建|陽") 1#ruby("년","年")\(1896)일 #ruby("가|능|성","可|能|性")이 크다.] 어느날 #ruby("신|문","新|聞")을 보니 나의 #ruby("사|건","事|件")을 #ruby("간|략","簡|略")히 #ruby("게|재","揭|載")하고, #ruby("김|창|수","金|昌|洙")가 들어간 #ruby("후","後")로는 #ruby("인|천|감|옥","仁|川|監|獄")이 #ruby("감|옥","監|獄")이 아니라 #ruby("학|교","學|校")라고 쓴 #ruby("기|사","記|事")를 보았다.]
#zh[时候大约是建阳二年，《皇城新闻》创刊的时候。有一天看报，简略登了我的案件，并且写着：金昌洙进去以后，仁川监狱不是监狱，而是学校。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[세#ruby("번","番")째, #ruby("대|서","代|書").]
#zh[第三，代书。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("시|대","時|代")에도 #ruby("이|치","理|致")에 닿지 않는 #ruby("원|통","冤|痛") #ruby("억|울","抑|鬱")한 #ruby("송|사","訟|事")가 많았다. 내가 #ruby("감|옥","監|獄")에 갇혀 있는 #ruby("자","者")를 #ruby("위","爲")해 말을 #ruby("자|세","仔|細")히 들어보고서 #ruby("소|장","訴|狀")을 지어주면 #ruby("간|혹","間|或") #ruby("소|송","訴|訟")에서 이길 적도 있었다. 갇혀 있는 사람 #ruby("중","中")에는 #ruby("감|옥","監|獄") 바깥에 #ruby("소|식","消|息")을 보내 #ruby("대|서","代|書") #ruby("비|용","費|用")을 써가면서도 #ruby("곤|란","困|難")을 당하는 #ruby("경|우","境|遇")가 #ruby("허|다","許|多")하였다. 그러나 내가 #ruby("대|서","代|書")하면 서로 #ruby("상|의","相|議")해서 #ruby[인지][印札紙]만 사다가 써 보내면 되니 #ruby("편","便")하기도 하고, 또 #ruby("비|용","費|用") 한 푼 없이 #ruby("성|심","誠|心")껏 #ruby("소|장","訴|狀")을 지어주는 탓에 #ruby("김|창|수","金|昌|洙")가 쓴 #ruby("소|장","訴|狀")은 거의 다 #ruby("승|소","勝|訴")한다고 #ruby("와|전","訛|傳")이 되어, #ruby("옥|내","獄|內")에서는 #ruby("물|론","勿|論")이고 #ruby("심|지|어","甚|至|於") #ruby("관|리","官|吏")의 #ruby("대|서","代|書")까지도 한 일이 있다. #ruby("대|서","代|書")뿐 아니라 #ruby("백|성","百|姓")을 어려움에 빠뜨리고 돈을 #ruby("강|제","强|制")로 빼앗는 #ruby("사|건","事|件")이 있으면 #ruby("상|급","上|級") #ruby("관|리","官|吏")에게 #ruby("권|계","勸|戒")하여 #ruby("파|면","罷|免")시킨 일도 있었다. 그러므로 #ruby("간|수","看|守")들이 나를 꺼려 #ruby("죄|수","罪|囚")들을 함부로 #ruby("학|대","虐|待")하지 못하였다.]
#zh[那个时代也不合理、冤痛抑郁的讼事很多。我仔细听了关在狱里的人的话，替他们写诉状，有时也能打赢官司。关着的人里面，往狱外送信、花代书费用还遭困难的情形很多。可是我代书，商量一下，只要买了印札纸写了送去就行，又方便，而且分文不取、尽心写诉状，所以讹传说金昌洙写的诉状几乎都胜诉，狱内不必说，甚至官吏的代书我也做过。不只代书，有把百姓陷入困难、强迫夺钱的事件，我也劝戒上级官吏，有把人罢免的事。所以看守们忌惮我，不能随便虐待囚犯。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[네#ruby("번","番")째, #ruby("성|악","聲|樂").]
#zh[第四，声乐。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 시골에서 나고 자랐으나 #ruby("농|군","農|軍")들의 ‘김매는 소리’나 ‘#ruby("목|동","牧|童") 갈가보다 소리’#footnote(numbering: _ => [104)])[#h(0.35em)#ruby("목|동","牧|童")은 ‘#ruby("목|동|가","牧|童|歌")’ 또는 ‘#ruby("목|동|문|답|가","牧|童|問|答|歌")’, 갈가보다는 ‘갈까보다 갈까보다 임을 따라 갈까보다’로 시작하는 #ruby("춘|향|가","春|香|歌")의 한 #ruby("구|절","句|節")인지도 모르겠다.] 한마디 불러 본 적이 없었고, 기껏 한다고 해야 #ruby("시","詩")나 #ruby("풍|월","風|月")을 읊조린 적밖에 없었다. 그 #ruby("당|시","當|時") #ruby("감|옥","監|獄") #ruby("규|칙","規|則")이 낮잠은 #ruby("허|락","許|諾")하는 #ruby("대|신","代|身") 밤#ruby("중","中")에는 잠을 자지 못하게 하고, 밤새도록 #ruby("죄|수","罪|囚")들에게 소리나 옛이야기를 시키곤 하였는데, #ruby("이|유","理|由")는 #ruby("야|간","夜|間")에 잠을 재우면 잠든 틈을 타서 #ruby("도|주","逃|走")하기 때문이라는 것이었다. #ruby("물|론","勿|論") 내게는 그런 #ruby("규|칙","規|則")을 #ruby("시|행","施|行")하지 않았으나, #ruby("보|통","普|通") 다들 그렇게 하니까 나도 #ruby("자|연","自|然")히 밤에 오래 놀다가 잠자리에 들곤 하였다. #ruby("덕|분","德|分")에 #ruby("시|조","時|調")나 #ruby("타|령","打|令")이나 남이 잘 하는 것을 자주 들어 소리의 #ruby("운|치","韻|致")를 알게 되었다. #ruby("조|덕|근","曺|德|根")에게 온갖 #ruby("시|조","時|調")와 #ruby("여|창","女|唱")지름#footnote(numbering: _ => [105)])[#h(0.35em)지름은 ‘지른다’는 뜻으로, #ruby("창|법","唱|法")의 하나.]·#ruby("남|창","男|唱")지름·#ruby("적|벽|가","赤|壁|歌")#footnote(numbering: _ => [106)])[#h(0.35em)#ruby("적|벽|가","赤|壁|歌")는 『#ruby("삼|국|지","三|國|志")』에서 가장 재미있는 #ruby("적|벽|대|전","赤|壁|大|戰")을 노래한 것으로, 서울 12#ruby("잡|가","雜|歌")에도 있고 판소리에도 있다. 여기서는 #ruby("잡|가","雜|歌") #ruby("적|벽|가","赤|壁|歌")인 듯하다.]·가세#ruby("타|령","打|令")#footnote(numbering: _ => [107)])[#h(0.35em)#ruby("원|래","元|來") 이름은 #ruby("선|유|가","船|遊|歌")로, #ruby("경|기|지|방","京|畿|地|方") 12#ruby("잡|가","雜|歌") #ruby("중","中")의 하나. #ruby("후|렴","後|斂")에 ‘가세’라는 말이 자주 나와 #ruby("일|명","一|名") ‘가세#ruby("타|령","打|令")’이라 불린다.]·개구리#ruby("타|령","打|令")#footnote(numbering: _ => [108)])[#h(0.35em)개구리#ruby("타|령","打|令")은 #ruby("전|라|민|요","全|羅|民|謠")에도 있고 #ruby("경|기|민|요","京|畿|民|謠")에도 있다. #ruby("조|덕|근","曺|德|根")이 #ruby("인|천","仁|川")사람인 것으로 미루어 보아 여기서 말하는 개구리#ruby("타|령","打|令")은 #ruby("경|기|민|요","京|畿|民|謠") 쪽인 듯하다.] #ruby("등","等")을 배워서 #ruby("죄|수","罪|囚")들과 같이 소리를 하며 지냈다.]
#zh[我生长在乡下，可是农夫的“锄草歌”或“牧童歌”一句也没唱过，最多只吟过诗和风月。当时狱规准许午睡，夜里却不让睡觉，通宵让囚犯唱歌或讲旧故事，理由是夜里让他们睡，会趁睡着逃走。当然对我不施行这种规则，可是大家普通都那样，我也就自然夜里玩得久才睡。因此常听别人唱得好的时调、打令，知道了声音的韵致。我跟曹德根学了各种时调、女唱的“지름”、男唱的“지름”、《赤壁歌》、加世打令、青蛙打令等，和囚犯们一起唱着过。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 아침에 『#ruby("황|성|신|문","皇|城|新|聞")』을 읽어보니, #ruby("경|성","京|城")·#ruby("대|구","大|邱")·#ruby("평|양","平|壤")·#ruby("인|천","仁|川")에서 아무 날 #ruby("강|도","强|盜") 누구누구, #ruby("살|인","殺|人") 누구누구 #ruby("등","等")과 함께 #ruby("인|천","仁|川")에 있는 #ruby("살|인|강|도","殺|人|强|盜") #ruby("김|창|수","金|昌|洙")를 #ruby("교|수|형","絞|首|刑")에 #ruby("처","處")한다는 #ruby("기|사","記|事")가 나와 있었다.#footnote(numbering: _ => [109)])[#h(0.35em)#ruby("원|문","原|文"): “지금까지 紀憶되기는 七月 二十七日노 생각한다”. 『#ruby("황|성|신|문","皇|城|新|聞")』은 『#ruby("독|립|신|문","獨|立|新|聞")』의 #ruby("착|오","錯|誤"). 그런데 #ruby("김|창|수","金|昌|洙")에 대한 3#ruby("차","次") #ruby("심|문|일","審|問|日")이 9#ruby("월","月") 10#ruby("일","日"), #ruby("법|부|대|신","法|部|大|臣") #ruby("한|규|설","韓|圭|卨")이 #ruby("고|종","高|宗")에게 #ruby("김|창|수","金|昌|洙")의 #ruby("교|수|형","絞|首|刑")을 #ruby("건|의","建|議")한 것은 10#ruby("월","月") 22#ruby("일","日")\(#ruby("음|력","陰|曆") 9#ruby("월","月") 16#ruby("일","日"))이다. 따라서 7#ruby("월","月") 27#ruby("일","日")자 #ruby("신|문","新|聞")에 #ruby("교|수|형","絞|首|刑")에 처한다는 #ruby("기|사","記|事")가 실릴 수 없다. 11#ruby("월","月") 7#ruby("일","日")\(#ruby("음|력","陰|曆") 10#ruby("월","月") 3#ruby("일","日")) 『#ruby("독|립|신|문","獨|立|新|聞")』은 #ruby("김|창|수","金|昌|洙") #ruby("등","等")에 대한 #ruby("법|부","法|部")의 #ruby("교|수|형","絞|首|刑") #ruby("건|의","建|議")를 #ruby("보|도","報|道")한 바 있는데, 7#ruby("월","月") 27#ruby("일","日")자 #ruby("교|수|형","絞|首|刑") #ruby("기|사","記|事")는 이것을 말한다.] 누구나 그런 #ruby("기|사","記|事")를 본 다음에는 일부러라도 #ruby("태|연|자|약","泰|然|自|若")한 #ruby("태|도","態|度")를 가지려고 하겠지만, 어찌된 일인지 내 마음은 조금도 #ruby("경|동","驚|動")되지 않았다. #ruby("교|수|대","絞|首|臺")에 오를 #ruby("시|간","時|間")이 #ruby("반|일","半|日")밖에 남지 않았지만, #ruby("음|식","飮|食")과 #ruby("독|서","讀|書")와 사람 만나는 일을 #ruby("평|상|시","平|常|時")처럼 하였다. 그것은 #ruby("고|선|생","高|先|生") 말씀 #ruby("중","中")에 #ruby("박|태|보","朴|泰|輔")의 보습 단근질 #ruby("일|화","逸|話")가 있었는데, 그는 보습으로 단근질을 당하면서도 끝까지 #ruby("굴","屈")하지 않고 오히려 “#ruby("차|철|유|랭|갱|자|래","此|鐵|猶|冷|更|煮|來")”#footnote(numbering: _ => [110)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “이 쇠가 식었으니 다시 달구어 오너라”. #ruby("박|태|보","朴|泰|輔")\(1654〜1689). #ruby("조|선","朝|鮮") #ruby("중|기","中|期")의 #ruby("문|신","文|臣"). #ruby("호","號")는 #ruby("정|재","定|齋"). 그는 1689#ruby("년","年") #ruby("기|사|환|국","己|巳|換|局") 때 #ruby("인|현|왕|후","仁|顯|王|后")의 #ruby("폐|위","廢|位")를 #ruby("강|력","强|力")히 #ruby("반|대","反|對")하다 #ruby("심","甚")한 #ruby("고|문","拷|問")을 받고 #ruby("유|배","流|配") 가는 길목인 #ruby("노|량|진","鷺|梁|津")에서 #ruby("옥|독","獄|毒")으로 죽었다.]고 했다고 한다. 그 #ruby("일|화","逸|話")와 더불어 #ruby("삼|학|사","三|學|士")#footnote(numbering: _ => [111)])[#h(0.35em)#ruby("병|자|호|란","丙|子|胡|亂") 때 #ruby("청","淸")나라와 #ruby("화|의","和|議")를 #ruby("반|대","反|對")한 #ruby("홍|익|한","洪|翼|漢")·#ruby("윤|집","尹|集")·#ruby("오|달|제","吳|達|濟") #ruby("등","等") 세 사람. 이들은 #ruby("봉|림|대|군","鳳|林|大|君")과 함께 #ruby("청","淸")나라로 잡혀가 #ruby("처|형","處|刑")당했다.]에 관한 이야기를 힘있게 들었는데, 그 #ruby("효|험","效|驗")으로 안다.]
#zh[有一天早晨读《皇城新闻》，京城、大邱、平壤、仁川某日，把强盗某某、杀人犯某某等，和仁川的杀人强盗金昌洙一起处以绞刑，这样的记事出来了。谁看了这种记事，也会故意做出泰然自若的态度，可是不知怎么，我的心一点也不惊动。上绞首台的时间只剩半天，饮食、读书、见人仍和平常一样。那是因为高先生的话里有朴泰辅用犁头烙刑的逸话，他受着犁头烙刑到底不屈，反而说“此铁犹冷，更煮来”。连同三学士的故事，我用力听过，知道是那个效验。]
#zh[译注：朴泰辅（一六五四——一六八九），朝鲜肃宗朝之谏官。]
#zh[译注：一六三六年清太宗率兵进攻朝鲜，是为丙子胡乱。洪翼汉、尹集、吴达济三人坚决反对降清，终遭杀害，世称此三人为“三学士”。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("신|문","新|聞")이 #ruby("배|포","配|布")된 #ruby("후","後")로 #ruby("감|리|서","監|理|署")가 술렁술렁하고 #ruby("인|천|항","仁|川|港") 사람들의 ‘#ruby("산","生") #ruby("조|문","弔|問")’#footnote(numbering: _ => [112)])[#h(0.35em)#ruby("원|문","原|文"): “#ruby("산","生")弔問”. 살아 있는 사람에게 하는 #ruby("조|문","弔|問").]이 #ruby("옥|문","獄|門")에 #ruby("답|지","遝|至")하였다. 오는 사람들이 나를 #ruby("면|대","面|對")하여 “마지막으로 보러 왔소” 하고는 모두 눈물을 흘렸다. 나는 도리어 그 사람들을 #ruby("위|로","慰|勞")하여 보내고 『#ruby("대|학","大|學")』을 외우곤 하였다. 그러나 다시 “아무 나리가 오셨소” “아무 #ruby("영|감","令|監")께서 오셨소” 하며 나를 마지막으로 보고자 하는 #ruby("면|회|자","面|會|者")들이 줄을 이었다. #ruby("통|지","通|知")를 받고 나가보면 그 사람들도 #ruby("역|시","亦|是")]
#zh[那报纸散发以后，监理署乱哄哄的，仁川港人的“生吊问”涌到狱门。来的人对着我说“最后来看您”，都流泪。我反而安慰他们送走，背《大学》。可是又有人说“某老爷来了”“某令监来了”，要最后见我的面会者排成队。得到通知出去一看，那些人也一样]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리는 #ruby("김|석|사","金|碩|士")가 살아 나와서 #ruby("상|면","相|面")할 줄 알았소. 그런데 이것이 웬일이오?”]
#zh[“我们以为金硕士能活着出来见面。这是怎么回事？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고서 눈물을 비오듯 흘렸다.]
#zh[说着，泪如雨下。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 어머님은 #ruby("음|식","飮|食")을 손수 들여넣어 주시면서도 #ruby("평|상|시","平|常|時")와 조금도 다름이 없으셨다. #ruby("주|위","周|圍")에 있는 사람들이 모르게 한 것이다.]
#zh[然而奇怪的是亲自送饭来的母亲却毫无异状，也许人们都不告诉她我将被处死的消息也未可知。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("인|천|옥","仁|川|獄")에서는 #ruby("사|형|수","死|刑|囚") #ruby("집|행","執|行")을 늘#ruby("상","常") #ruby("오|후","午|後")에 끌고 나가서 #ruby("우|각|동","牛|角|洞")에서 #ruby("교|살","絞|殺")하던 터이므로, 아침밥 #ruby("점|심","點|心")밥도 잘 먹고 죽을 때는 어떻게 할 것인지 #ruby("준|비","準|備")할 마음도 없이 그냥 있었지만 #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들의 마음 아파하는 모습은 차마 보기 싫었다. 내게 #ruby("음|식","飮|食")을 얻어먹던 도둑 #ruby("죄|수","罪|囚")들과 내게 글을 배우던 #ruby("감|옥","監|獄") #ruby("제|자","弟|子")들, 그리고 내게 #ruby("소|송","訴|訟")에 #ruby("대","對")한 #ruby("지|도","指|導")를 받던 여러 #ruby("죄|수","罪|囚")들이 얼마나 #ruby("애|통","哀|痛")해 하며 울던지, #ruby("과|연","果|然") 제 #ruby("부|모","父|母") 죽을 때에도 그렇게 #ruby("애|통","哀|痛")해 하였을지 #ruby("의|문","疑|問")이었다.]
#zh[仁川监狱死囚的执刑是在下午，地方是在牛角洞。吃饱了早饭和午饭，我本想准备准备将死时该怎么做，可是却不成，因为其他囚犯为我悲伤的情形，我实在看不过去。他们有的是曾向我要过东西吃的人，有的是跟我念过书的学生，有的是请我写过诉状，接受过我指导如何打官司的，他们那种哀伤的样子，如丧考妣。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이윽고 #ruby("교|수|대","絞|首|臺")로 끌려나갈 #ruby("시|간","時|間")이 되었다. 그때까지 나는 #ruby("성|현","聖|賢")의 말씀에 마음을 가라앉혔다가 #ruby("성|현","聖|賢")과 #ruby("동|행","同|行")할 생각으로 『#ruby("대|학","大|學")』만 읽고 앉아 있었다. 그런데 #ruby("시|간","時|間")이 지나도록 아무 #ruby("소|식","消|息")이 없이 그럭저럭 저녁밥을 먹었다. 옆사람들이 #ruby("창|수","昌|洙")는 #ruby("특|수|죄|인","特|殊|罪|人")이니 #ruby("야|간|집|행","夜|間|執|行")을 하려는가 보다 하였다.]
#zh[被拖出去上绞架的时刻渐渐迫近了。我决定一直到我生命结束的刹那，依照圣贤的话做，镇定地与圣贤同行，于是就端坐着读《大学》。就这样，不知不觉中晚餐送进来了。人们以为由于我是特别囚犯，所以要在晚间执行。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[밤이 #ruby("초|경","初|更")은 하여서#footnote(numbering: _ => [113)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “저녁 무렵이 되어서”. #ruby("초|경","初|更")은 저녁 여섯 #ruby("시","時") #ruby("전|후","前|後").] 여러 사람의 발자국 소리가 나더니 #ruby("옥|문","獄|門") 열리는 소리가 들렸다.]
#zh[到了夜晚初更时分，外面人声嘈杂，忽然听见开启狱门的声音，我自言自语道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘옳지. 지금이 그때로군!’]
#zh[“对了！现在时辰到了。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 앉아 있는데, 내 얼굴을 보는 #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들은 마치 #ruby("자|기","自|己")가 죽으러 가는 듯 벌벌 떨었다.]
#zh[我坐着等，看我脸的同牢房囚犯像自己要去死似的发抖。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[안쪽 #ruby[문][內間門]을 열기도 #ruby("전","前")에 #ruby("감|옥","監|獄") 뜰에서]
#zh[里间的门还没开，监狱院子里]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|창|수","金|昌|洙") 어느 #ruby("방","房")에 있소?”]
#zh[“金昌洙在哪一间？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하는 소리가 들렸다. 내 #ruby("대|답","對|答")은 듣는지 마는지,]
#zh[传来这样的声音。我的回答听不听，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아이구, 이제 #ruby("김|창|수","金|昌|洙")는 살았소! 아이구, 우리 #ruby("감|리","監|理") #ruby("영|감","令|監")과 #ruby("감|리|서","監|理|署") #ruby("전|직|원","全|職|員")과 #ruby("각","各") #ruby("청|사","廳|舍") #ruby("직|원","職|員")이 아침부터 지금까지 밥 한 술 먹지 못하고 #ruby("창|수","昌|洙")를 어찌 차마 우리 손으로 죽인단 말이냐 하고 서로 말없이 얼굴만 물끄러미 바라보며 #ruby("한|탄","恨|歎")하였소. 그랬더니 지금 #ruby("대|군|주","大|君|主")\(#ruby("고|종","高|宗")) #ruby("폐|하","陛|下")께옵서 #ruby("대|청","大|廳")에서#footnote(numbering: _ => [114)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby[집무실][大廳]에서”. 1896#ruby("년","年") 2#ruby("월","月") 11#ruby("일","日")부터 1897#ruby("년","年") 2#ruby("월","月") 20#ruby("일","日")까지 #ruby("고|종","高|宗")은 #ruby("러|시|아","俄|羅|斯") #ruby("공|사|관","公|使|館")에 있었다. 따라서 여기서 #ruby("대|청","大|廳")은 #ruby("고|종","高|宗")의 #ruby("집|무|실","執|務|室")을 말한다.] #ruby("전|화","電|話")로 #ruby("감|리","監|理") #ruby("영|감","令|監")을 불러 계시옵고, #ruby("감|리","監|理") #ruby("영|감","令|監")은 #ruby("김|창|수","金|昌|洙")의 #ruby("사|형","死|刑")을 #ruby("정|지","停|止")하라는 #ruby("친|칙","親|勅")을 받잡고 밤#ruby("중","中")에라도 #ruby("감|옥","監|獄")에 내려가 #ruby("창|수","昌|洙")에게 알려주라는 #ruby("분|부","分|付")를 내리셨소. 오늘 하루 얼마나 #ruby("상|심","傷|心")하셨소?”]
#zh[“哎哟，现在金昌洙活了！哎哟，我们监理令监和监理署全体职员、各厅舍职员，从早晨到现在一匙饭也吃不下，说怎么忍心用我们的手杀昌洙，彼此不说话，只呆呆望着脸叹息。于是现在大君主陛下在大厅用电话召了监理令监，监理令监奉了停止金昌洙死刑的亲敕，吩咐哪怕半夜也下到监狱告诉昌洙。今天一天多么伤心啊？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하는 것이었다.]
#zh[说的就是这些。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("관|청","官|廳") #ruby("수|속","手|續")이 어떠했었는지는 모르나, 내 #ruby("요|량","料|量")으로는 #ruby("이|재|정","李|在|正")이 그 #ruby("공|문","公|文")을 받고 #ruby("상|부","上|部"), #ruby("즉","卽") #ruby("법|부","法|部")#footnote(numbering: _ => [115)])[#h(0.35em)#ruby("고|종","高|宗") 32#ruby("년","年")\(1895) #ruby("법|무|아|문","法|務|衙|門")을 #ruby("법|부","法|部")로 #ruby("개|칭","改|稱")하고 #ruby("사|법|행|정","司|法|行|政")을 #ruby("담|당","擔|當")했다.]에 #ruby("전|화","電|話")로 #ruby("교|섭","交|涉")한 것 같았다. 그러나 그#ruby("후","後")에 #ruby("대|청","大|廳")에서 나오는 #ruby("소|식","消|息")을 들으면, #ruby("사|형","死|刑")은 #ruby("형|식|적","形|式|的")으로라도 임금의 #ruby("재|가","裁|可")를 받아 #ruby("집|행","執|行")하는 #ruby("법","法")이므로, #ruby("법|부|대|신","法|部|大|臣")이 #ruby("사|형|수","死|刑|囚") 한 사람 한 사람의 #ruby[심문서][供件]를 가지고 #ruby("조|회","照|會")에 들어가서 #ruby("상|감","上|監")의 #ruby("친|감","親|監")을 거친다고 한다.#footnote(numbering: _ => [116)])[#h(0.35em)#ruby("당|시","當|時") #ruby("법|률","法|律")로 ‘#ruby("사|형","死|刑") #ruby("죄","罪")는 세 #ruby("번","番") #ruby("복|심","覆|審")하여 #ruby("왕","王")에게 아뢴다’고 #ruby("규|정","規|定")하였다. #ruby("법|부","法|部")에서 #ruby("김|창|수","金|昌|洙")의 #ruby("교|수|형","絞|首|刑")을 #ruby("왕","王")에게 #ruby("보|고","報|告")한 것은 10#ruby("월","月") 22#ruby("일","日")이다.] 그런데 그때 #ruby("입|시","入|侍")하였던 #ruby("승|지","承|旨") #ruby("중","中") 한 사람이 #ruby("각","各") #ruby("죄|수","罪|囚")의 #ruby("공|건","供|件")을 뒤적이며 보던 #ruby("중","中"), ‘#ruby("국|모|보|수","國|母|報|讐")’ 넉 #ruby("자","字")가 눈에 띄므로 #ruby("이|상","異|常")하게 여기고,#footnote(numbering: _ => [117)])[#h(0.35em)「#ruby("김|창|수","金|昌|洙") 3초」라는 #ruby("심|문|서","審|問|書")에 ‘身爲國民 含寃於國母之讐 有此擧’란 #ruby("구|절","句|節")이 있다.] 이미 #ruby("재|가","裁|可") #ruby("수|속","手|續")을 끝낸 #ruby("안|건","案|件")을 다시 꺼내 임금께 보여드렸다. 그 #ruby("내|용","內|容")을 보신 #ruby("대|군|주","大|君|主")께서는 #ruby("즉|시","卽|時") #ruby("어|전|회|의","御|前|會|議")를 여셨고, #ruby("의|결","議|決")한 #ruby("결|과","結|果") #ruby("국|제|관|계","國|際|關|係")와 #ruby("관|련","關|連")된 일이니 아직 #ruby("생|명","生|命")이나 살리고 보자 하여 #ruby("전|화","電|話")로 #ruby("친|칙","親|勅")하셨다 한다.]
#zh[那时官厅的手续怎样我不知道，我料想李在正接到公文，用电话和上部、也就是法部交涉过。可是后来听从大厅出来的消息，死刑即便形式上，也是得到国王裁可才执行的法，所以法部大臣拿着一个一个死刑囚的供件进照会，经过上监亲监。当时入侍的承旨里面有一个人翻看各囚犯的供件，“国母报仇”四个字映进眼里，觉得异常，把已经办完裁可手续的案件又拿出来给国王看。大君主看了内容，立刻开御前会议，议决的结果，既是和国际有关的事，先保住性命再说，用电话下了亲敕。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("여|하","如|何")튼 #ruby("대|군|주","李|太|皇")께서 #ruby("친","親")히 #ruby("전|화","電|話")하신 것만은 #ruby("사|실","事|實")이었다. #ruby("이|상","異|常")하게 생각되는 것은, 그때 #ruby("경|성|부","京|城|府") 안에는 이미 #ruby("전|화","電|話")가 #ruby("가|설","架|設")된 지 오래였으나, #ruby("경|성","京|城") #ruby("외","外")의 #ruby("지|역","地|域")에 #ruby("장|거|리","長|距|離") #ruby("전|화","電|話")가 #ruby("설|치","設|置")된 것은 #ruby("인|천","仁|川")이 처음이었다는 #ruby("사|실","事|實")이다. #ruby("인|천","仁|川")까지의 #ruby("전|화","電|話") #ruby("가|설|공|사","架|設|工|事")가 #ruby("완|공","完|工")된 지 3#ruby("일","日")째 되는 #ruby("병|신|년","丙|申|年")\(1896) 8#ruby("월","月") 26#ruby("일","日")의 일이었다.#footnote(numbering: _ => [118)])[#h(0.35em)#ruby("음|력","陰|曆") 8#ruby("월","月") 26#ruby("일","日")은 #ruby("양|력","陽|曆") 10#ruby("월","月") 2#ruby("일","日")이다. 이날 #ruby("인|천|감|리|서","仁|川|監|理|署")는 #ruby("일|본|영|사|관","日|本|領|事|館")의 #ruby("압|력","壓|力")에 #ruby("의","依")해 #ruby("김|창|수","金|昌|洙")에 #ruby("대","對")한 #ruby("조|속","早|速")한 #ruby("판|결","判|決")을 #ruby("법|부","法|部")에 #ruby("건|의","建|議")하였다. 그러나 #ruby("법|부","法|部")는 #ruby("당|일","當|日") #ruby("전|보","電|報")로 #ruby("왕","王")이 #ruby("결|정","決|定")할 #ruby("사|항","事|項")이라며 이를 #ruby("유|보","留|保")하였다. 따라서 ‘#ruby("고|종","高|宗")이 #ruby("전|화","電|話")로 #ruby("사|형","死|刑")을 #ruby("중|단","中|斷")시켰다’는 #ruby("유|명","有|名")한 이야기에는 #ruby("약|간","若|干")의 #ruby("착|오","錯|誤")가 있다. #ruby("즉","卽") #ruby("전|화","電|話")가 아니라 #ruby("전|보","電|報")이며, #ruby("고|종","高|宗")이 아니라 #ruby("법|부","法|部")이고, #ruby("사|형","死|刑")을 #ruby("중|지","中|止")시킨 것이 아니라 #ruby("고|종","高|宗")의 #ruby("재|가","裁|可")를 #ruby("명|분","名|分")으로 #ruby("판|결","判|決")을 #ruby("지|연","遲|延")시킨 것이다.] #ruby("만","萬")에 하나 그때까지 #ruby("전|화","電|話") #ruby("준|공","竣|工")이 못 되었다면, 바로 #ruby("사|형","死|刑")이 #ruby("집|행","執|行")되었을 거라고들 하였다.]
#zh[无论如何，大君主亲自打了电话，这是事实。觉得异常的是，那时京城府里电话架设已久，京城以外的地方架设长途电话，仁川是第一个。仁川的电话架设工程完工第三天，就是丙申年八月二十六日的事。人们说，万一那时电话还没竣工，死刑立刻就会执行。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|리|서","監|理|署")에서 내려온 #ruby("주|사","主|事")는 이런 말을 했다.]
#zh[从监理署下来的主事这样说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("관|리","官|吏")들뿐 아니라 오늘 #ruby("전","全") #ruby("항|구","港|口")의 #ruby("객|주","客|主") 32#ruby("명","名")이 #ruby("긴|급|회|의","緊|急|會|議")를 하고 #ruby[통지문][通文] 돌리는 것을 보았는데, #ruby("항|구","港|口") 안에 있는 집집마다 몇 사람씩이든지 되는 대로 #ruby("우|각|현","牛|角|峴")에 #ruby("김|창|수","金|昌|洙")의 #ruby("교|수|형","絞|首|刑")을 구경가되, #ruby("각","各") 사람이 #ruby("엽|전","葉|錢") 한 #ruby("냥","兩")씩 #ruby("준|비","準|備")하여 가지고 오라 하였소. 사람들이 돈을 가지고 오면 거기서 모인 돈으로 한 사람의 몸값을 쳐주되, #ruby("부|족","不|足")한 #ruby("액|수","額|數")는 32#ruby("객|주","客|主")가 #ruby("담|당","擔|當")하고 #ruby("김|창|수","金|昌|洙")를 살리자고까지 하였소. 그러나 지금은 #ruby("천|행","天|幸")으로 살았고, 아마 며칠이 못 되어 #ruby("궐|내","闕|內")에서 #ruby("은|명","恩|命")이 계실 터이니 아무 #ruby("염|려","念|慮") 마시고 계시오.”]
#zh[“不只我们官吏，今天看见全港口三十二名客主开紧急会议、传通文，港口里家家户户不论几个人，能去的都去牛角岘看金昌洙的绞刑，各人准备叶钱一两带来。人把钱带来，就用聚的钱作一个人的身价，不足的数目由三十二客主担当，甚至要救金昌洙的命。可是现在天幸活了，大概不几天宫里会有恩命，什么也不必忧虑。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[눈서리가 내리다가 갑자기 봄바람이 부는 듯하였다. 밤에 #ruby("옥|문","獄|門") 열리는 소리를 듣고 벌벌 떨던 #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들은 이 #ruby("소|식","消|息")을 듣고서 너무 좋아서 죽을 #ruby("지|경","地|境")인 #ruby("모|양","模|樣")이었다. 신골방맹이#footnote(numbering: _ => [119)])[#h(0.35em)짚신 삼을 때 쓰는 방망이.]로 차꼬 등을 두들기며 온갖 노래를 다 부르고, 푸른 바지저고리 차림으로 춤도 추고 우스운 짓도 하며 하룻밤을 지내는 #ruby("양","樣")이 마치 #ruby("청|의|배|우","靑|衣|俳|優")들의 #ruby("연|극|장","演|劇|場")과 같았다.]
#zh[现在大家都明白我是免了死刑。正如霜降雪飞，突然吹来了春风。被启开狱门声吓得直打哆嗦的囚犯们，听到了这消息后，高兴得要命，一面以鞋型槌子敲着足枷，一面唱各种歌曲。他们穿着蓝色囚衣高兴地跳舞、逗乐，就好像戏院里的蓝衣俳优在演戏。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들은 나를 보고 참말 #ruby("이|인","異|人")이라며 #ruby("경|탄","驚|歎")하였다. #ruby("사|형","死|刑")을 당할 날인데도 #ruby("평|소","平|素")와 똑같이 말하고 밥 먹고 #ruby("행|동","行|動")하였으니, 이는 #ruby("필|시","必|是") #ruby("선|견|지|명","先|見|之|明")이 있어 #ruby("자|기","自|己")가 죽지 않을 것을 미리 알았기 때문이라고들 하였다. #ruby("관|리","官|吏")들 #ruby("중","中")에서도 그렇게 아는 사람들이 많았다. 어머님은 그날 밤에야 비로소 그 일을 알게 되셨는데, #ruby("감|리","監|理")가 #ruby("대|군|주","大|君|主")의 #ruby("친|전","親|電")을 받고서 어머님께 알려드렸던 것이다. 이 일로 #ruby("인","因")해 누구보다도 어머님이 #ruby("당|신","當|身") 아들을 #ruby("이|인","異|人")이라 생각하게 되셨다. 배를 타고 #ruby("강|화","江|華") #ruby("갑|곶","甲|串")\(각구지목)을 지나오면서 #ruby("강","江")물에 같이 빠져 죽자고 하셨을 때 내가 #ruby("결","決")코 죽지 않을 거라 했던 일을 #ruby("기|억","記|憶")하시고, “내 아들은 미리 #ruby("자|기","自|己")가 죽지 않을 줄을 알았다”고 #ruby("확|신","確|信")하셨던 #ruby("모|양","模|樣")이다. 어머님뿐 아니라 #ruby("내|외|분","內|外|分")이 다 그런 #ruby("신|념","信|念")을 갖게 되셨다.]
#zh[还有一些囚犯胡乱解释说我在当天镇静得若无其事，是因为事先已经知道会这样平安无事的缘故，他们以为我是异人，可以预卜先知。官员中也有这么说的。尤其是母亲，她是在监理接到大君主的亲电向她传旨的那天夜里才知道这一消息的。她还记得在岬串她要我一起投海自尽时我曾说过不会死的话，以为我真是能预见什么的人。父亲好像也有这种想法。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|군|주","大|君|主")의 #ruby("친|칙","親|勅")으로 #ruby("김|창|수","金|昌|洙")의 #ruby("사|형","死|刑")이 #ruby("정|지","停|止")되었다는 #ruby("소|문","所|聞")이 #ruby("전|파","傳|播")되니, #ruby("전","前")날 나를 만나러 와서 #ruby("영|결","永|訣")을 고하던 사람들로부터 #ruby("치|하","致|賀") #ruby("면|회","面|會")하러 오는 사람이 #ruby("옥|문","獄|門")에 줄을 이었다. 나는 아예 #ruby("옥|문","獄|門") 안에 자리를 하고 앉아서 며칠 동안 손님 #ruby("응|접","應|接")을 하였다.]
#zh[大君主的亲敕停止了金昌洙的死刑，这个风声传开，从前来永诀的人又排着队到狱门来祝贺面会。我索性在狱门里设了座位，几天接待客人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("사|형","死|刑") #ruby("정|지","停|止") #ruby("이|전","以|前")에는 #ruby("순|전","純|全")히 나의 젊은 #ruby("의|기","意|氣")를 #ruby("애|석","哀|惜")하게 여기고 뜨겁게 #ruby("동|정","同|情")하던 사람들이 나를 찾아왔었지만, 이번에는 내가 머지않아 #ruby("대|군|주","大|君|主")의 #ruby("소|명","召|命")을 입어 #ruby("영|귀","榮|貴")하게 될 줄 알고, 그때 #ruby("세|도","勢|道")를 얻으면 다른 수가 생기리라 생각하고 와서 #ruby("아|부","阿|附")하는 사람도 있었다. #ruby("관|리","官|吏") #ruby("중","中")에서도 그런 사람이 있었고, #ruby("인|천","仁|川") #ruby("항|내","港|內") #ruby("인|사","人|事")들 가운데서도 그런 빛이 보였다.]
#zh[死刑停止以前，来找我的人纯粹是哀惜我年轻的义气、热心同情。这一次却有人以为我不久会蒙大君主召命、成为显贵，到那时得了势道就另有办法，所以来阿附。官吏里面也有这样的人，仁川港内人士中间也看得出这种神色。]
#heading(level: 3)[#text(font: "KOPUSGo B")[8) #ruby("파|옥","破|獄")]]
#zh[越狱]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("간|수","看|守") #ruby("중","中") 우두머리#ruby("격","格")인 #ruby("최|덕|만","崔|德|萬")은 #ruby("강|화","江|華")#ruby("읍|내","邑|內") #ruby("김|우|후","金|虞|候")#footnote(numbering: _ => [120)])[#h(0.35em)이름은 #ruby("김|주|경","金|周|卿"). #ruby("우|후","虞|候")는 #ruby("조|선|시|대","朝|鮮|時|代")의 #ruby("무|관","武|官") #ruby("직|명","職|名").]의 집에 계집종으로 있던 #ruby("여|자","女|子")의 #ruby("서|방","書|房")이었다. 아내가 죽은 다음 #ruby("인|천","仁|川")으로 와서 #ruby("경|무|청","警|務|廳") #ruby("사|령","使|令")으로 #ruby("다|년|간","多|年|間") #ruby("봉|직","奉|職")하였으므로 #ruby("사|령","使|令")들의 #ruby("두|목","頭|目")이 되었다. 그 #ruby("최|덕|만","崔|德|萬")이 #ruby("강|화","江|華")에 가서 #ruby("자|기","自|己") 옛 #ruby("상|전","上|典")이었던 #ruby("김|우|후","金|虞|候")에게 내 이야기를 하였던 듯하다. 하루는 #ruby("감|리|서","監|理|署") #ruby("주|사","主|事")가 #ruby("의|복","衣|服") 한 벌을 가지고 와서 주며 말하기를,]
#zh[看守里头目一样的崔德万，是江华邑内金虞候家婢女的丈夫。妻子死了以后来到仁川，当警务厅使令多年，成了使令们的头目。那崔德万到江华去，似乎把我的事告诉了从前的上典金虞候。有一天监理署主事拿着一套衣服来说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("강|화","江|華")에서 온 #ruby("김|주|경","金|周|卿")이란 사람이 이 #ruby("의|복","衣|服")을 지어다가 #ruby("감|리","監|理") #ruby("사|또","使|道")에게 드리고 #ruby("김|창|수","金|昌|洙")에게 #ruby("분|부","分|付")하여 입도록 하여 달라는 #ruby("청|원","請|願")을 하였으니, 이 #ruby("의|복","衣|服")을 입고 #ruby("김|주|경","金|周|卿")이란 #ruby("친|구","親|舊")가 #ruby("면|회","面|會")하거든 보시오.”]
#zh[“从江华来的一个叫金周卿的人，把这衣服做好送给监理使道，请求吩咐金昌洙穿上。你穿上这衣服，等叫金周卿的朋友来会面时见见他。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. #ruby("주|사","主|事")가 가고 나서 얼마 #ruby("후","後")에 #ruby("김|주|경","金|周|卿")이란 사람이 찾아왔다. 나이는 마흔 가까이 되어 보이고 #ruby("면|목","面|目")이 단단해 보였는데 만나서 #ruby("별","別") 말은 없었고,]
#zh[说完了。主事走了不久，一个叫金周卿的人来了。年纪看着快四十，面目结实。见了面没有别的话，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("고|생","苦|生")이나 잘 하시오. 나는 #ruby("김|주|경","金|周|卿")이오.”]
#zh[“辛苦了，好好过吧。我是金周卿。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고는 물러갔다. 어머님이 저녁밥을 가지고 오셔서 말씀하셨다.]
#zh[说罢就回去了。母亲拿晚饭来，说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아까 #ruby("강|화","江|華") 계신 #ruby("김|우|후","金|虞|候")라는 #ruby("양|반","兩|班")이 네 아버지와 나를 찾아오셨었다. 우리를 보시고 #ruby("우|선","于|先")은 네 #ruby("의|복","衣|服")만 #ruby("자|기","自|己") 집에서 지어왔다면서 우리 #ruby("양|주","兩|主") #ruby("의|복","衣|服")하라고 옷감을 끊어주시고, 또 돈 200#ruby("냥","兩")을 주시면서 #ruby("필|요","必|要")한 데 쓰라고 하셨다. 그리고는 #ruby("즉|시","卽|時") 가시면서 열흘 #ruby("후","後")에 다시 찾겠다고 하셨다. 네가 보니 어떻더냐? 밖에서 듣기에는 아주 훌륭한 사람이라고 하더라.”]
#zh[“刚才住在江华的一位叫金虞候的两班来看了你父亲和我。他先说你的衣服是从他自己家里做好带来的，又给我们老两口扯了衣料，还给了二百两，说必要的地方用。随即要走，说十天以后再来。你见了觉得怎样？外面听来，说是个很了不起的人。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[사람을 한 #ruby("번","番") 보고 어찌 잘 알 수 있을까마는 그 사람의 하는 일은 #ruby("감|사","感|謝")하다고 #ruby("모|자|간","母|子|間")에 이야기를 하였다.]
#zh[见过一次面，怎么能知道得好呢，只是他做的事值得感谢，母子之间这样说了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("최|덕|만","崔|德|萬")에게 #ruby("김|주|경","金|周|卿")의 #ruby("내|력","來|歷")과 #ruby("인|격","人|格")을 #ruby("자|세","仔|細")히 물어보았다. #ruby("김|주|경","金|周|卿")의 #ruby("자","字")는 #ruby("경|득","卿|得")이니 #ruby("원|래","元|來") #ruby("강|화","江|華") #ruby("관|아","官|衙")에 #ruby[서리배][吏屬]였고 #ruby("병|인|양|요","丙|寅|洋|擾") #ruby("이|후","以|後") #ruby("운|현","雲|峴")#footnote(numbering: _ => [121)])[#h(0.35em)#ruby("운|현|군","雲|峴|君"), 곧 #ruby("대|원|군","大|院|君")을 가리킨다. 『#ruby("백|범|일|지","白|凡|逸|志")』에 자주 나오는 #ruby("표|현","表|現")이다.]이 #ruby("강|화|도","江|華|島")에 3,000#ruby("명","名")의 #ruby("별|무|사","別|武|士")를 #ruby("양|성","養|成")하고 섬 #ruby("주|위","周|圍")에 #ruby("석|루","石|壘")를 높이 쌓고 #ruby("진|무|영","鎭|撫|營")을 세우던 때, #ruby("김|주|경","金|周|卿")이 #ruby("포|량|고|직","包|糧|庫|直")#footnote(numbering: _ => [122)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("포|량|고","包|糧|庫")지기”. ‘包糧庫直’은 ‘砲糧庫直’이 맞다. #ruby("군|수|품","軍|需|品") #ruby("창|고","倉|庫")지기.]의 일을 맡았다.]
#zh[我向崔德万仔细问了金周卿的来历和人格。金周卿字卿得，原来是江华官衙的吏属。丙寅洋扰以后，云岘在江华培养三千名别武士，把岛的周围用石垒高高筑起、设立镇抚营的时候，金周卿担当了炮粮库直的事。]
#zh[译注：1866年1月，大院君下令镇压天主教，处死了包括九名法国神甫在内的大批天主教徒，法国舰队遂入侵仁川和汉城近郊，是为丙寅洋扰。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[사람됨이 어렸을 때부터 #ruby("호|방","豪|放")하여 #ruby("초|립","草|笠")둥이#footnote(numbering: _ => [123)])[#h(0.35em)#ruby("초|립","草|笠")은 나이 어려서 #ruby("관|례","冠|禮")한 #ruby("남|자","男|子")가 쓰던 누런 풀로 결어 만든 갓. #ruby("초|립","草|笠")둥이는 #ruby("초|립","草|笠")을 쓴 젊은 사내.] 때부터 #ruby("독|서","讀|書")는 아니하고 #ruby("도|박","賭|博")을 일삼아 하였다. #ruby("부|모","父|母")가 #ruby("김|주|경","金|周|卿")을 #ruby("징|계","懲|戒")하기 #ruby("위","爲")해 곳간에 #ruby("감|금","監|禁")하였는데, 곳간에 들어가면서 #ruby("투|전","套|錢")#footnote(numbering: _ => [124)])[#h(0.35em)#ruby("화|투","花|鬪")와 비슷한 #ruby("도|박","賭|博") #ruby("기|구","器|具")의 #ruby("일|종","一|種"). #ruby("투|전","套|錢")은 #ruby("영|조","英|祖") #ruby("초|기","初|期")부터 크게 퍼져서 사람들에게 큰 #ruby("폐|해","弊|害")를 입혔으며 #ruby("관|아","官|衙")에서 #ruby("단|속","團|束")해도 #ruby("별","別") #ruby("효|과","效|果")가 없었다고 한다.] 한 목을 가지고 들어가 갇혀 있는 동안에도 #ruby("투|전","套|錢")의 #ruby("묘|법","妙|法")을 #ruby("연|구","硏|究")하였다. 나와서 서울로 올라가 #ruby("투|전","套|錢")을 몇#ruby("만","萬") 목이나 만들었는데, #ruby("자|기","自|己")만 알 수 있는 #ruby("표|시","眼|票")를 하여 #ruby("강|화","江|華")로 가지고 가서 팔았다.]
#zh[他为人从小豪放，从戴草笠的时候起就不读书，以赌博为业。父母为了惩戒他，把他关在库房里。他进库房时带了一副套钱，关着的时候也研究套钱的妙法。出来上了汉城，做了几万副套钱，做了只有自己认得的眼票，带回江华去卖。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|화","江|華")는 섬이라서 #ruby("포|구","浦|口")마다 고깃배들이 빽빽이 세워져 있는 곳이다. #ruby("김|주|경","金|周|卿")은 이 #ruby("투|전","套|錢")을 #ruby("친|구","親|舊")들에게 나누어주고 고깃배마다 들어가 팔게 했다. 그리고 #ruby("자|기","自|己")는 그 고깃배들을 돌아다니며 #ruby("투|전","套|錢")을 하여 돈을 #ruby("수|십|만","數|十|萬") #ruby("냥","兩")이나 벌었다. 그 돈으로 #ruby("각","各") #ruby("관|청","官|廳")의 #ruby("하|급","下|級") #ruby("관|속","官|屬")들을 #ruby("매|수","買|收")하여 #ruby("전|부","全|部") #ruby("자|기","自|己")의 #ruby("지|휘","指|揮") #ruby("명|령","命|令")을 받도록 해놓고, #ruby("원|근","遠|近")에서 #ruby("용|기","勇|氣")와 #ruby("지|략","智|略")이 있다는 #ruby("자","者")는 거의 다 #ruby("망|라","網|羅")하여 #ruby("자|기","自|己") #ruby("식|구","食|口")로 만들어 놓고 어떤 #ruby("양|반","兩|班")이든지 #ruby("비|리","非|理")만 저지르면 #ruby("직|접","直|接") #ruby("간|접","間|接")으로 #ruby("혼","魂")을 내주었다. #ruby("설|사","設|使") #ruby("경|내","境|內")에 #ruby("도|적","盜|賊")이 나서 #ruby("포|교","捕|校")가 #ruby("출|장","出|張") #ruby("체|포","逮|捕")를 하여도 먼저 #ruby("김|경|득","金|卿|得")에게 #ruby("보|고","報|告")해야 했다. #ruby("김|경|득","金|卿|得")이 “잡아가라” 하면 잡아가고, “내게 두고 가거라” 하면 #ruby("거|절","拒|絶")을 못하였다고 한다.]
#zh[江华是岛，每个浦口都密密停着渔船。金周卿把这套钱分给朋友，让他们上每条渔船去卖。他自己则走那些渔船赌博，赚了数十万两。用那钱收买各官厅的下级官属，使他们全部听从自己的指挥命令，远近凡有勇气和智略的人几乎都网罗来做自己的食口。哪个两班只要做下非理的事，就直接间接地给一顿教训。即使境内出了盗贼，捕校出差逮捕，也得先报告金卿得。金卿得说“抓去”就抓去，说“留在我这里”就不敢拒绝。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("강|화","江|華")에 두 사람의 #ruby("인|물","人|物")이 있었는데, #ruby("양|반","兩|班") #ruby("중","中")에서는 #ruby("이|건|창","李|健|昌")#footnote(numbering: _ => [125)])[#h(0.35em)#ruby("이|건|창","李|健|昌")\(1852〜1898). #ruby("조|선","朝|鮮") #ruby("말|기","末|期")의 #ruby("대|문|장|가","大|文|章|家")이자 #ruby("양|명|학|자","陽|明|學|者"). 그는 세 #ruby("번","番")의 #ruby("유|배","流|配") #ruby("후","後") #ruby("만|년","晩|年")을 #ruby("향|리","鄕|里") #ruby("강|화","江|華")에서 보냈다. #ruby("대|표|적","代|表|的")인 #ruby("저|작","著|作")으로 『#ruby("당|의|통|략","黨|議|通|略")』이 있다.]이요 #ruby("상","常")놈 #ruby("중","中")에서는 #ruby("김|경|득","金|卿|得")이라 했다. #ruby("대|원|군","大|院|君")이 #ruby("김|경|득","金|卿|得")의 #ruby("인|격","人|格")을 #ruby("자|세","仔|細")히 알아보고 #ruby("포|량|감","包|糧|監")#footnote(numbering: _ => [126)])[#h(0.35em)앞에서는 #ruby("포|량|고|직","包|糧|庫|直")이라 했다.]의 #ruby("중|임","重|任")을 맡겼다 한다.]
#zh[当时江华有两个人物，两班里面是李健昌，常人里面是金卿得。大院君仔细看了金卿得的人格，把炮粮监的重任交给了他。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("최|덕|만","崔|德|萬")의 말을 들어보면 #ruby("김|경|득","金|卿|得")은 #ruby("자|기","自|己") 집에 와서 #ruby("음|식","飮|食")을 먹으면서 이렇게 이야기하고 돌아갔다 한다.]
#zh[听崔德万说，金卿得到自己家里吃饭时这样说了，就回去了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|창|수","金|昌|洙")를 살려내어야 할 터인데, 지금 #ruby("정|부","政|府")#ruby("대|관","大|官")들은 모두 눈에 #ruby[구리녹][銅綠]이 슬어서 돈밖에 보이는 것이 없으니, #ruby("불|가|불","不|可|不") #ruby("금|력","金|力")을 #ruby("사|용","使|用")치 아니하면 쉽게 #ruby("방|면","放|免")치 못할 것 같다. 내가 집에 가서 #ruby("가|산","家|産") #ruby("전|부","全|部")를 팔아 가지고 와서 #ruby("김|창|수","金|昌|洙")의 #ruby("부|모","父|母")님을 모시고 #ruby("경|성","京|城")에 가서, 어느 때까지든 #ruby("김|창|수","金|昌|洙")를 #ruby("석|방","釋|放")시키도록 #ruby("주|선","周|旋")을 하겠다.”]
#zh[“该把金昌洙救出来。如今政府大官们眼睛上都长了铜绿，除了钱什么也看不见，非用金力，不容易放免。我回家把家产全部卖掉带来，陪着金昌洙的父母上京城，无论到什么时候，也要周旋到把金昌洙释放。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[열흘 남짓 지난 #ruby("후","後")에 #ruby("김|경|득","金|卿|得")이 #ruby("과|연","果|然") 왔다. #ruby("부|모","父|母")님 #ruby("중","中")에 한 분만 서울로 #ruby("동|행","同|行")하자고 하여 어머님이 서울로 가시고 아버님은 #ruby("인|천","仁|川")에 머무르셨다.]
#zh[过了十来天，金卿得果然来了。父母里面只要一位同行去汉城，于是母亲上了汉城，父亲留在仁川。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|경|득","金|卿|得")은 서울로 가서 #ruby("당|시","當|時") #ruby("법|부|대|신","法|部|大|臣") #ruby("한|규|설","韓|圭|卨")#footnote(numbering: _ => [127)])[#h(0.35em)#ruby("한|규|설","韓|圭|卨")\(1848〜1930). #ruby("을|사|조|약","乙|巳|條|約")에 #ruby("반|대","反|對")하였고, 1896#ruby("년","年") #ruby("법|부|대|신","法|部|大|臣")을 #ruby("담|당","擔|當")하고 있었다.]을 찾아가 이렇게 말했다.]
#zh[金卿得到了汉城，去找当时的法部大臣韩圭卨，这样说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("대|감","大|監")이 #ruby("책|임","責|任") 있게 #ruby("김|창|수","金|昌|洙")의 #ruby("충|의","忠|義")를 #ruby("표|창","表|彰")하고, #ruby("조|속","早|速")히 #ruby("방|면","放|免")하도록 하여야 옳지 않겠소? #ruby("폐|하","陛|下")께 #ruby("비|밀","祕|密")히 #ruby("주|청","奏|請")이라도 하여 #ruby("장|래","將|來")에 #ruby("허|다","許|多")한 #ruby("충|의|지|사","忠|義|之|士")가 생기도록 함이 #ruby("대|감","大|監")의 #ruby("직|책","職|責")이 아니겠소?”]
#zh[“大监负起责任，表彰金昌洙的忠义，从速放免，岂不应当？哪怕秘密奏请陛下，使将来生出许多忠义之士，岂不是大监的职责？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("한|규|설","韓|圭|卨")도 속으로는 그 말에 #ruby("경|복","敬|服")하였다. 그러나 #ruby("당|시","當|時") #ruby("일|본","日|本") #ruby("공|사","公|使")였던 #ruby("하야시","林") #ruby("곤스케","權助")#footnote(numbering: _ => [128)])[#h(0.35em)#ruby("하야시","林")는 #ruby("백|범","白|凡")이 #ruby("탈|옥","脫|獄")한 #ruby("이|후","以|後")인 1899#ruby("년","年") 6#ruby("월","月") #ruby("부|임","赴|任")하기 때문에 #ruby("백|범","白|凡") #ruby("구|명|운|동","救|命|運|動") #ruby("당|시","當|時") #ruby("일|본","日|本") #ruby("공|사","公|使")가 아니다. #ruby("백|범","白|凡") #ruby("투|옥","投|獄") #ruby("시|기","時|期")의 #ruby("일|본","日|本") #ruby("공|사","公|使")는 #ruby("하라","原")\(1896)와 #ruby("가|토","加|藤")\(1897〜1899)이다.]가 벌써 나의 #ruby("사|건","事|件")이 #ruby("국|제|문|제","國|際|問|題")로 #ruby("화","化")하게 될까 #ruby("염|려","念|慮")하여, #ruby("각","各") #ruby("대|신","大|臣")들 #ruby("중","中")에 이 #ruby("사|건","事|件")으로 #ruby("폐|하","陛|下")께 아뢰는 #ruby("자","者")만 있으면 #ruby("별|별","別|別") #ruby("수|단","手|段")을 가리지 않고 #ruby("위|험","危|險")한 #ruby("지|경","地|境")으로 떨어뜨릴 #ruby("흉|계","凶|計")를 꾸미고 있었다. 그러니 옳은 일인 줄은 알지만 어떻게 할 #ruby("방|도","方|道")가 없다고 하였다. #ruby("김|경|득","金|卿|得")은 #ruby("사|관","舍|館")#footnote(numbering: _ => [129)])[#h(0.35em)‘舍館’은 ‘私館’. #ruby("공|관","公|館")의 #ruby("반|대","反|對")말. #ruby("즉","卽") 여기서는 #ruby("한|규|설","韓|圭|卨")의 집을 말한다.]에서 #ruby("분|기|탱|천","憤|氣|撐|天")하여 #ruby("대|관","大|官")들에게 #ruby("욕","辱")을 퍼붓고 나왔다.]
#zh[韩圭卨心里也敬服这话。可是当时的日本公使林权助，已经担心我的事件会化成国际问题，大臣之中只要有人把这事上奏陛下，就不择手段要把他弄到危险境地，正在设下凶计。所以明知是对的，也说没有办法。金卿得在舍馆里愤气撑天，把大官们骂了一顿出来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어떻든지 #ruby("공|식|적","公|式|的")으로 #ruby("소|장","訴|狀")이나 들이자 하여, 제1#ruby("차","次") #ruby("법|부","法|部")에 #ruby("소|지","訴|紙")를 올렸다. 그러자 “#ruby("국|모","國|母")의 #ruby("원|수","怨|讐")를 갚는다고 한 말의 뜻은 #ruby("가|상","可|尙")하나, #ruby("사|건","事|件")이 #ruby("중|대","重|大")하여 여기서 마음대로 할 수 없다”라고 쓴 #ruby("제|지","題|旨")#footnote(numbering: _ => [130)])[#h(0.35em)#ruby("제|지","題|旨")는 #ruby("제|사","題|辭"). #ruby("소|장","訴|狀")에 #ruby("대","對")한 #ruby("관|청","官|廳")의 #ruby("답|변","答|辯"). 『#ruby("백|범|일|지","白|凡|逸|志")』 #ruby("원|문","原|文")의 #ruby("제|사","題|辭")는 ‘報讐爲言이 其義可尙이나 事關重大하야 未可擅便向事’이지만, #ruby("소|장","訴|狀")의 #ruby("원|본","原|本")의 #ruby("제|사","題|辭")는 ‘觀此所訴하니 其義可尙이라 雖極矜憫이나 事係法部하니 官不得 擅斷向事’(#ruby("소|장","訴|狀")을 보니 그 뜻은 #ruby("가|상","可|尙")하고 #ruby("동|정","同|情")이 가지만 #ruby("법|부","法|部") #ruby("결|정|사|항","決|定|事|項")이라 #ruby("본|관","本|官")은 함부로 #ruby("판|단","判|斷")할 수 없음)이다.]가 내려왔다. 두#ruby("번","番") 세#ruby("번","番") #ruby("각","各") #ruby("관|청","官|廳")에 #ruby("일|일","一|一")이 #ruby("소|장","訴|狀")을 올렸으나 이리 미루고 저리 미루고 #ruby("결|말","結|末")이 나지 않았다.#footnote(numbering: _ => [131)])[#h(0.35em)#ruby("백|범","白|凡")의 어머니는 #ruby("인|천|감|리|서","仁|川|監|理|署")에 제1#ruby("차","次")로 #ruby("소|장","訴|狀")을 올리고 그 다음(1898#ruby("년","年") 2#ruby("월","月") 16#ruby("일","日"))에 #ruby("법|부","法|部")에 #ruby("소|장","訴|狀")을 올렸다. 이에 #ruby("대","對")한 #ruby("제|사","題|辭")는 ‘情雖矜憐 罪關王章 必不可容貸向事’(#ruby("사|정","事|情")은 비록 안되었지만 #ruby("죄","罪")가 #ruby("왕","王")의 #ruby("결|정|사|항","決|定|事|項")에 #ruby("관|계","關|係")되므로 #ruby("용|서","容|恕")할 수 없다)이다. 이어서 2#ruby("월","月") 21#ruby("일","日") #ruby("백|범","白|凡") 아버지도 #ruby("법|부","法|部")에 #ruby("소|장","訴|狀")을 올렸다. 이에 #ruby("대","對")한 #ruby("제|사","題|辭")는 ‘當有參酌矣리니 姑爲退待할 事’(마땅히 #ruby("참|작","參|酌")할 것이니 물러가 기다리라)이다.]]
#zh[无论如何，先正式递上诉状，第一次向法部上了诉纸。于是下来题旨，写着：“说要报国母之仇，其义可尚，可是事件重大，这里不能擅自处理。”第二次、第三次向各官厅一一上了诉状，这边推那边推，没有结末。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("소|송","訴|訟")에 #ruby("전|력","專|力")하기를 7, 8#ruby("개|월","個|月") 동안 #ruby("김|경|득","金|卿|得")의 돈은 바닥이 났다. 그 동안 아버님과 어머님이 번갈아 #ruby("인|천","仁|川")과 #ruby("경|성","京|城")을 오르락내리락 하시다가, 마침내 #ruby("김|경|득","金|卿|得")이 #ruby("소|송","訴|訟")을 #ruby("중|단","中|斷")하고 돌아와서 내게 #ruby("편|지","便|紙") 한 #ruby("통","通")을 보냈다. #ruby("내|용","內|容")은 #ruby("보|통","普|通") #ruby("위|문","慰|問")#ruby("편|지","便|紙")였고, #ruby("단|율","單|律")#footnote(numbering: _ => [132)])[#h(0.35em)#ruby("형|식","形|式")에 #ruby("엄|격","嚴|格")한 #ruby("율|시","律|詩")는 #ruby("기","起")·#ruby("승","承")·#ruby("전","轉")·#ruby("결","結")이 #ruby("각","各") 2#ruby("구","句"), #ruby("총","總") 8#ruby("구","句")로 되어 있다. #ruby("단|율","單|律")이란 #ruby("기","起")·#ruby("승","承")·#ruby("전","轉")·#ruby("결","結")이 #ruby("각|각","各|各") 1#ruby("구","句")씩 #ruby("총","總") 4#ruby("구","句")로 된 #ruby("율|시","律|詩")를 말한다.] 한 #ruby("수","首")가 있었다.]
#zh[专力诉讼七八个月，金卿得的钱见了底。其间父亲和母亲轮流在仁川和京城来往，终于金卿得中断诉讼回来，给我送了一封信。内容是普通的慰问信，还有一首单律。]
#figure-block("/images/p121.jpg", caption: [#ruby("백|범","白|凡")의 #ruby("부|모","父|母")님이 올린 #ruby("소|장","訴|狀"). #ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料") 17281 『訴狀』 제13#ruby("책","冊")])
#quote-block[#ruby("조|롱","鳥|籠")을 박차고 나가야 #ruby("진|실","眞|實")로 좋은 #ruby("새이며","脫籠眞好鳥")]
#zh[冲出鸟笼，才是真正的好鸟。（脱笼真好鸟）]
#quote-block[그물을 떨치고 나가야 #ruby("예|사","例|事")스런 물고기가 아니리. (拔扈豈常鱗)]
#zh[挣脱罗网出去，才不是寻常的鱼。（拔扈岂常鳞）]
#quote-block[#ruby("충","忠")은 반드시 #ruby("효","孝")에서 #ruby("비롯되니","求忠必於孝")]
#zh[忠必从孝开始。（求忠必于孝）]
#quote-block[그대여, #ruby("자|식","子|息") 기다리는 어머니를 생각하소서. (請看依閭人)#footnote(numbering: _ => [133)])[#h(0.35em)마지막 #ruby("구|절","句|節")의 #ruby("의","依")는 #ruby("기","倚"). #ruby("기|려","倚|閭") 또는 #ruby("기|려|지|망","倚|閭|之|望")은 #ruby("문","門")에 기대어 #ruby("자|식","子|息")을 기다리는 어머니 또는 그 마음.]]
#zh[请你想想倚门等待子女的母亲。（请看依闾人）]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 #ruby("시","詩")를 읽고서 나는 #ruby("즉|시","卽|時") #ruby("김|주|경","金|周|卿")에게, 그 동안 나를 #ruby("위","爲")하여 있는 힘껏 마음을 써 준 것은 #ruby("지|극","至|極")히 #ruby("감|사","感|謝")하나, 한때 #ruby("구|차","苟|且")스럽게 사는 것을 #ruby("위","爲")하여 #ruby("생|명","生|命")보다 #ruby("중","重")한 #ruby("광|명","光|明")을 버릴 수 없으니 #ruby("과","過")히 #ruby("우|려","憂|慮")치 말라는 #ruby("내|용","內|容")으로 #ruby("회|답","回|答")을 보냈다. 그대로 #ruby("옥|중|생|활","獄|中|生|活")을 #ruby("계|속","繼|續")하며 #ruby("구|서|적","舊|書|籍")보다 #ruby("신|학|문","新|學|問")을 #ruby("열|심","熱|心")으로 #ruby("공|부","工|夫")하였다.]
#zh[读了这首诗，我立刻给金周卿回信：这段时间为我尽心，极其感谢，可是不能为了一时苟且地活着，抛弃比生命更重的光明，请不必过虑。我仍继续狱中生活，比旧书籍更热心地攻读新学问。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|경|득","金|卿|得")은 그 길로 집에 가서 #ruby("재|산","財|産")이 다 #ruby("탕|진","蕩|盡")되고 없음을 보고 새로이 #ruby("동|지","同|志")를 #ruby("규|합","糾|合")하였다. #ruby("당|시","當|時") #ruby("관|용|선","官|用|船")#footnote(numbering: _ => [134)])[#h(0.35em)#ruby("원|주","原|註"): “輪船”. 배의 #ruby("좌|우","左|右")에 물갈퀴가 달린 수레바퀴를 #ruby("설|치","設|置")하고, 배 안에서 그 #ruby("축","軸")에 달린 쇠막대를 사람의 힘으로 돌려 가는 배.]으로 #ruby("청|룡|환","靑|龍|丸"), #ruby("현|익|호","顯|益|號"), #ruby("해|룡|환","海|龍|丸") 세 #ruby("척","隻")이 있었는데, 그#ruby("중","中") 한 #ruby("척","隻")을 #ruby("탈|취","奪|取")하여 #ruby("대|양","大|洋")에서 #ruby("해|적","海|賊")질할 #ruby("준|비","準|備")를 하였다. 그러나 그 #ruby("모|의","謀|議")가 #ruby("당|시","當|時") #ruby("강|화","江|華") #ruby("군|수","郡|守") 아무개에 #ruby("의","依")해 미리 #ruby("염|탐","廉|探")되어 #ruby("도|주","逃|走")하고 말았다. #ruby("도|주","逃|走")할 때에 그 #ruby("군|수","郡|守")가 #ruby("상|경","上|京")하는 #ruby("도|중","途|中")에서 실컷 두들겨 패주고, #ruby[블라디보스토크][海蔘威] #ruby("방|면","方|面")으로 갔다고도 하고 다른 곳에 #ruby("잠|복","潛|伏")하였다고도 한다.]
#zh[据说金周卿后来纠合了同伴，打算在官船青龙号、显益号、海龙号三艘中，夺取其中之一准备作海盗，此事被江华郡守获悉而失败，后来在逃亡途中遇到郡守，把他痛打了一顿，逃亡到海参崴去了。也有人说他就在附近某处藏匿下来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後") 아버님은 #ruby("경|성","京|城")에서 #ruby("소|송","訴|訟") 걸었던 #ruby("문|서","文|書") #ruby("전|부","全|部")를 #ruby("강|화","江|華")로 가지고 오셔서 #ruby("이|건|창","李|健|昌")에게 가서 보여주고 #ruby("방|책","方|策")을 물으셨다. #ruby("이|건|창","李|健|昌") #ruby("역|시","亦|是") #ruby("탄|식","歎|息")만 하고 #ruby("별","別") #ruby("방|법","方|法")을 #ruby("지|시","指|示")하지 못했다.]
#zh[其后，父亲曾经带着金周卿向汉城各衙门呈递的全部上诉文件，去拜访江华的李健昌，请教救我的方法，可是他也只能摇首叹息而已。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 나와 함께 #ruby("감|옥","監|獄") 안에서 #ruby("고|생","苦|生")했던 사람으로는, #ruby("장|기|수","長|期|囚")로 #ruby("조|덕|근","曺|德|根")이 10#ruby("년","年"), #ruby("양|봉|구","梁|鳳|九")가 3#ruby("년","年"), #ruby("김|백|석","金|白|石")이 10#ruby("년","年") #ruby("등","等")이었고, #ruby("기|타","其|他") #ruby("종|신|수","終|身|囚")도 있었다. 이 사람들이 내게 #ruby("감","敢")히 말은 못하였으나, 내가 하려는 마음이 없어 그렇지 #ruby("만|일","萬|一") #ruby("자|기","自|己")네들을 살리려는 마음만 있으면 #ruby("자|기","自|己")들을 한 손에 몇 #ruby("명","名")씩 쥐고 #ruby("공|중","空|中")에 날아가서라도 #ruby("족","足")히 #ruby("구","救")하여 줄 #ruby("재|주","才|操")가 있는 것처럼 믿고 있는 듯하였다. #ruby("종|종","種|種") 내게 그런 #ruby("식","式")으로 #ruby("종|용","慫|慂")하기도 하였고 #ruby("잠|깐","暫|間")씩 그런 말뜻을 비추었다.]
#zh[那时和我同牢房的长期徒刑囚犯有判了十年的曹德根、金白石，判了三年的梁凤求，还有人被判无期徒刑。他们常常趁着僻静的时候，暗示要越狱。他们认为我力气大，只要我肯帮忙，一手带几个人，飞向空中，就可以救出他们。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어느날 #ruby("조|덕|근","曺|德|根")이 나를 보고 눈물을 흘리며 말했다.]
#zh[有一天，曹德根看着我流泪说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|서|방","金|書|房")님이야 언제든지 #ruby("상|감","上|監")께서 #ruby("특|전","特|典")을 내리시기만 하면 나가서 #ruby("귀","貴")하게 되시겠지요. 저도 #ruby("김|서|방","金|書|房")님을 모시고 #ruby("근","近") 2#ruby("년","年")이나 #ruby("고|생","苦|生")을 하였습지요. 그렇지만 #ruby("김|서|방","金|書|房")님만 #ruby("특|전","特|典")을 입어 나가시는 날이면 #ruby("간|수","看|守")의 #ruby("포|학","暴|虐")이 #ruby("비","比")할 데 없이 #ruby("심","甚")해질 것입니다. 그렇게 되면 우리가 어찌 10#ruby("년","年") #ruby("기|한","期|限")을 다 채우고 살아 나갈 수 있겠습니까? 우리들이 불쌍치도 않습니까? 그 동안 가르치심을 받아 #ruby("국|문","國|文") 한 #ruby("자","字") 모르던 것이 이제는 #ruby("국|한|문","國|漢|文") #ruby("편|지","便|紙")를 쓰게 되었습니다. #ruby("만|일","萬|一") 살아 #ruby("세|상","世|上")에 나간다면 죽을 때까지 보배롭게 쓰겠지만, 여기서 죽는다면 #ruby("공|부","工|夫")한 것을 무엇에 쓰겠습니까?”]
#zh[“金书房您啊，只要上监降下特典，出去就会显贵吧。我也侍奉金书房，近两年吃了苦。可是只有金书房蒙了特典出去的那天，看守的暴虐就会无比厉害。那样我们怎么能坐满十年期限活着出去呢？我们不可怜吗？受了教导，原先国文一个字不识，现在能写国汉文的信了。万一活着出去到世上，会用到死，当作宝贝；死在这里，学的东西用在什么上呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("근|엄","謹|嚴")한 #ruby("태|도","態|度")로 말하였다.]
#zh[我用谨严的态度说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("죄|수","罪|囚")가 아니냐? #ruby("피|차","彼|此")에 어느날이고 #ruby("동|시","同|時") #ruby("출|옥","出|獄")이 안되면 그 섭섭한 마음이야 어찌 말로 #ruby("표|현","表|現")할 수 있겠나?”]
#zh[“我不也是囚犯吗？彼此哪一天不能同时出狱，那惋惜的心怎么能用话说出来？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|서|방","金|書|房")님이 아직은 우리 더러운 놈들과 함께 계시지만, #ruby("내|일","來|日")이라도 #ruby("영|광","榮|光")스럽게 #ruby("감|옥","監|獄")을 나가실 분이 아니십니까? 그러니 부디 저를 살려주시면 #ruby("결|초|보|은","結|草|報|恩") 하겠습니다.”]
#zh[“金书房现在虽然还和我们这些肮脏的人在一起，明天不就能光彩地走出监狱吗？所以务必救我一命，我结草报恩。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[말의 #ruby("의|미","意|味")를 #ruby("평|평","平|平")하게 한다.#footnote(numbering: _ => [135)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “말의 #ruby("의|미","意|味")를 #ruby("확|연","確|然")하지 않게 하였다.”] 어찌 들으면 내가 #ruby("대|군|주","大|君|主")의 #ruby("특|별","特|別")한 #ruby("은|혜","恩|惠")를 입어서 나간 #ruby("후","後")에 #ruby("권|력","權|力")으로 #ruby("자|기","自|己")를 #ruby("구","救")해 달라는 것도 같고, 어찌 들으면 내가 나가기 #ruby("전","前")에 #ruby[실력행사][勇力]로 #ruby("자|기","自|己")를 #ruby("구","救")해 달라는 말로도 들렸다. 나는 아무 말도 하지 않았다. 그때부터는 #ruby("부|지|불|식|간","不|知|不|識|間")에 내 마음이 #ruby("요|동","搖|動")을 쳤다.]
#zh[他把话的意思说得含含糊糊。听来像是我蒙大君主特别恩惠出去以后，用权力救他；听来又像是我出去之前，用实力救他。我什么话也没说。从那时起，不知不觉心里动摇了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘나를 #ruby("무|한|정","無|限|定") 놓아주지 않는데도 #ruby("옥","獄")에서 죽는 것이 옳은가 그른가? #ruby("당|초","當|初")에 내가 #ruby("왜","倭")놈을 죽인 것이 우리 #ruby("국|법","國|法")에 #ruby("범|죄|행|위","犯|罪|行|爲")로 #ruby("인|정","認|定")된 것은 아니었다. #ruby("왜","倭")놈을 죽이고 내가 죽어도 #ruby("한","恨")이 없다고 생각했던 것은 내 힘이 #ruby("부|족","不|足")해서였다. #ruby("왜","倭")놈에게 죽든지, #ruby("충|의","忠|義")를 몰라주는 #ruby("조|선","朝|鮮") #ruby("관|리","官|吏")들에게 #ruby("죄|인","罪|人")으로 몰려 죽든지 #ruby("한","恨")이 없다고 #ruby("결|심","決|心")했던 것이다. 지금 #ruby("대|군|주","大|君|主")가 나를 죽일 놈이 아니라고 #ruby("인|정","認|定")하신 것은 #ruby("윤","閏") 8#ruby("월","月") 26#ruby("일","日") #ruby("전|칙","電|勅")한 #ruby("사|형","死|刑") #ruby("정|지","停|止")의 일로 #ruby("족","足")히 #ruby("증|명","證|明")할 수 있다. 또한 이때 #ruby("이|후","以|後") #ruby("감|리|서","監|理|署")로부터 #ruby("경|성","京|城") #ruby("각","各") #ruby("관|아","官|衙")에 #ruby("소|송","訴|訟")하여 받아낸 #ruby("제|지","題|旨")들만 보아도 나를 #ruby("죄|인","罪|人")이라고 #ruby("지|시","指|示")한 곳은 한 군데도 없었다. #ruby("김|경|득","金|卿|得")이 그같이 #ruby("자|기","自|己") #ruby("전","全") #ruby("재|산","財|産")을 #ruby("탕|진","蕩|盡")해 가며 내 한 목숨 살리려 했던 것도 그렇고, #ruby("인|천|항","仁|川|港")에 사는 사람들 #ruby("중","中") 한 사람도 내가 #ruby("옥|중","獄|中")에서 죽는 것을 #ruby("원","願")하는 사람이 없음은 #ruby("삼|척|동|자","三|尺|童|子")도 다 아는 #ruby("사|실","事|實")이다. 나를 죽이려 애쓰는 놈은 #ruby("왜|구","倭|寇")들뿐인데, 내가 그놈들을 즐겁게 하기 #ruby("위","爲")해 #ruby("옥","獄")에서 죽는다는 것은 아무 #ruby("의|미","意|味")가 없지 않겠는가?’]
#zh[‘他们不无限期放我，死在狱里对不对？当初我杀倭寇，我国国法并没有认作犯罪行为。我想杀了倭寇，我死也无恨，那是因为我的力量不足。被倭寇杀死，或被不知忠义的朝鲜官吏当作罪人处死，我都决心无恨。现在大君主认定我不是该杀的人，闰八月二十六日电敕停止死刑，就足以证明。此后从监理署到京城各官衙诉讼领来的题旨，没有一处指示我是罪人。金卿得那样荡尽全部财产要救我一条命，仁川港的人没有一个愿意我死在狱中，三尺童子都知道。要置我于死地的只有倭寇。我为了让他们高兴而死在狱里，有什么意义？’]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("심|사|숙|고","深|思|熟|考")하다가 #ruby("탈|옥","破|獄")하기로 #ruby("결|심","決|心")하였다.]
#zh[我深思熟虑之后，决心越狱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 #ruby("조|덕|근","曺|德|根")을 보고 #ruby("비|밀","祕|密")히 물었다.]
#zh[第二天看见曹德根，悄悄问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("조|서|방","曺|書|房")이 내가 하라는 대로만 한다면 살려줄 #ruby("도|리","道|理")를 #ruby("연|구","硏|究")하여 보겠네.”]
#zh[“曹书房只要照我的话做，我就研究救你的办法。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|덕|근","曺|德|根")은 마음 깊이 #ruby("감|동","感|動")하고 또 #ruby("감|동","感|動")하여 무엇이나 하라는 대로 #ruby("복|종","服|從")하겠다고 했다. 나는 그에게 #ruby("자|기","自|己") 집에서 밥 가지고 오는 #ruby("하|인","下|人") #ruby("편","便")에 #ruby("편|지","便|紙")를 보내 돈 200#ruby("냥","兩")만 가져다가 #ruby("은|밀","隱|密")히 몸에 감추어 두라고 하였다. 그랬더니 #ruby("조|덕|근","曺|德|根")의 집에서는 그날로 #ruby("당|장","當|場") #ruby("백|동|전","白|銅|錢")#footnote(numbering: _ => [136)])[#h(0.35em)1891#ruby("년","年") #ruby("은|본|위|제","銀|本|位|制") #ruby("채|택","採|擇") #ruby("후","後") #ruby("주|조","鑄|造")된 #ruby("근|대|화|폐","近|代|貨|幣"). #ruby("본|위|화|폐","本|位|貨|幣") #ruby("은|전","銀|錢")에 #ruby("대","對")한 #ruby("보|조|화","補|助|貨")이다. #ruby("남|발","濫|發")로 #ruby("인","因")하여 이른바 ‘#ruby("백|동|화","白|銅|貨") 인플레’를 #ruby("초|래","招|來")하기도 하였다.]200#ruby("냥","兩")을 #ruby("감|옥","監|獄")으로 가져왔다.]
#zh[曹德根深深感动了又感动，说什么都照我的话服从。我让他托家里送饭的下人带信，拿二百两钱来，秘密藏在身上。曹德根家里当天就把白铜钱二百两送到监狱来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("감|옥","監|獄")에 있던 #ruby("죄|수","罪|囚")들 #ruby("중","中") 가장 #ruby("세|력","勢|力")이 컸던 #ruby("자","者")는 #ruby("징|역","懲|役") #ruby("만|기","滿|期")가 다 되어가던 #ruby("자","者")로 #ruby("감|옥","監|獄")에서는 그에게 #ruby("죄|수","罪|囚") #ruby("감|시","監|視")를 시키고 있던 터였다. #ruby("강|화","江|華") #ruby("출|신","出|身")으로 #ruby("황|순|용","黃|順|用")이란 #ruby("자","者")였는데, #ruby("절|도|죄","竊|盜|罪")로 3#ruby("년","年")을 다 살고 #ruby("출|옥|일","出|獄|日")이 15#ruby("일","日") 남아 있었다. #ruby("황|가","黃|哥")가 #ruby("옥|중","獄|中")에서 #ruby("당|도|용|사","當|道|用|事")를 한다.#footnote(numbering: _ => [137)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “여러 가지 일을 맡아 하였다.”]]
#zh[当时囚犯中有个有势力的人叫黄顺用的。是江华人，因盗窃罪判刑三年，已经快要全部服满，离出狱日子只有十来天，他受命监督其他囚犯，所以非拉拢这家伙不能成事。这姓黄的有一个弱点，那就是他极爱金白石。金白石是个十七八岁的美少年，以重犯盗窃罪判了十年劳役，服刑才几个月。我便计划利用金白石拉拢黄顺用。]
#zh[我指使曹德根，让他说服金白石，使金白石去央求黄顺用。黄顺用因爱白石，必定会探询救助的办法，那时可让他来求我帮助越狱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|가","黃|哥")가 #ruby("남|색","男|色")#footnote(numbering: _ => [138)])[#h(0.35em)#ruby("남|자","男|子")끼리의 #ruby("동|성|연|애","同|性|戀|愛").]으로 좋아지내는 #ruby("김|백|석","金|白|石")#footnote(numbering: _ => [139)])[#h(0.35em)#ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에 #ruby("의","依")하면 그는 #ruby("강|백|석","姜|伯|石")이다.]은 나이 17, 8#ruby("세","歲")의 #ruby("절|도","竊|盜") #ruby("재|범","再|犯")으로 10#ruby("년|형","年|刑")을 받은 지 채 몇 달이 못 되는 #ruby("자","者")였다. #ruby("조|덕|근","曺|德|根")에게 #ruby("은|밀","隱|密")히 #ruby("부|탁","付|託")하여 #ruby("김|백|석","金|白|石")으로 하여금 #ruby("황|가","黃|哥")를 보고 #ruby("애|원","哀|願")하여 살려 달라고 조르게 하였다. #ruby("황|가","黃|哥")가 #ruby("백|석","白|石")에 #ruby("대","對")한 #ruby("애|정","愛|情")에 못 이겨 살릴 #ruby("방|도","方|道")를 물으면, #ruby("황|가","黃|哥")더러 #ruby("창|수","昌|洙") #ruby("김|서|방","金|書|房")이 도우면 살 #ruby("도|리","道|理")가 없지 않다고 조르게 하였다. 하루는 #ruby("황|가","黃|哥")가 #ruby("백|석","白|石")의 #ruby("애|원","哀|願")대로 #ruby("비|밀","祕|密")히 나를 찾아왔다. 그 동안 지내던 더러운 #ruby("정","情")을 못 이겼음인지, 나를 보고 #ruby("백|석","白|石")이를 살려 달라고 #ruby("간|청","懇|請")했다. 나는 #ruby("황|가","黃|哥")를 #ruby("엄","嚴")히 꾸짖었다.]
#zh[黄哥喜欢的金白石，是十七八岁的盗窃再犯，判了十年，还不满几个月。我秘密拜托曹德根，让金白石去央求黄哥救命。黄哥若因对白石的爱情问活路，就让他去央求：昌洙金书房若帮忙，不是没有活路。有一天黄哥照白石的哀求，秘密来找我。也许没能胜过那肮脏的情，求我救白石。我严厉斥责黄哥：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("출|옥","出|獄")할 #ruby("기|한","期|限")도 멀지 않았으니 #ruby("사|회","社|會")에 나가서 좋은 사람이 될 줄 알았는데, 벌써 #ruby("출|옥","出|獄")도 하기 #ruby("전","前")에 #ruby("범|죄","犯|罪")할 생각이나 하느냐? #ruby("백|석","白|石")이는 어린것이 #ruby("중","重")한 #ruby("형|벌","刑|罰")을 받았으므로 나도 불쌍히 여기지 않음이 아니나, #ruby("피|차","彼|此") #ruby("죄|수","罪|囚") #ruby("처|지","處|地")로 무슨 #ruby("도|리","道|理")가 있겠느냐?”]
#zh[“你出狱的期限也不远了，我还以为你到社会上会做个好人，怎么还没出狱就想着犯罪？白石年纪小，受了重刑，我也不是不可怜，可是彼此都是囚犯，有什么办法？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|가","黃|哥")는 #ruby("송|연","悚|然")해져서 물러갔다. 다시 #ruby("조|덕|근","曺|德|根")으로 하여금 #ruby("백|석","白|石")을 시켜 #ruby("재|차","再|次") #ruby("삼|차","三|次") #ruby("김|서|방","金|書|房")에게서 #ruby("백|석","白|石")이를 살려주마는 #ruby("허|락","許|諾")을 받아내라고 부추겼다. 다음날 #ruby("황|가","黃|哥")는 눈물을 흘리면서 내게 찾아와 말하였다.]
#zh[黄哥悚然退下。我再让曹德根叫白石再三央求金书房答应救白石。第二天黄哥流着泪来对我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 #ruby("백|석","白|石")의 #ruby("징|역","懲|役")을 #ruby("대|신","代|身")이라도 지겠습니다. #ruby("김|서|방","金|書|房")님은 하지 않으셔서 그렇지 #ruby("능","能")히 못할 일이 없으시니 #ruby("백|석","白|石")이를 살려만 주신다면 죽을 데라도 #ruby("사|양","辭|讓")치 않겠습니다.”]
#zh[“我替他坐牢都可以，求求您，您非不能也，是不为也。只要能救金白石出狱我万死不辞。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 다시 #ruby("황|가","黃|哥")를 믿지 못하겠다는 #ruby("태|도","態|度")로 말했다.]
#zh[我又以不相信黄哥的态度说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("백|석","白|石")이를 얼마나 사랑하는지 모르나, 너는 #ruby("단|지","但|只") 더러운 #ruby("정","情")으로 #ruby("백|석","白|石")이를 살렸으면 하는 생각이 있을 것이다. 그러나 그 마음이 #ruby("과|연","果|然") 내가 #ruby("백|석","白|石")에게 #ruby("대","對")하여 가지는 마음과 같을지 #ruby("의|문","疑|問")이다. 나는 그 어린것이 #ruby("필|경","畢|竟") #ruby("옥|중","獄|中") #ruby("귀|신","鬼|神")이 될 것을 불쌍히 생각하고 있거니와, #ruby("설|사","設|使") 내가 #ruby("백|석","白|石")이를 불쌍히 여기는 마음으로 살려주마고 #ruby("허|락","許|諾")하고 #ruby("수|속","手|續")을 #ruby("시|작","始|作")한다 하여도, 네가 그 일을 #ruby("순|검|청","巡|檢|廳")에 #ruby("고|발","告|發")하여 나를 #ruby("망|신","亡|身")시키지나 않을까 걱정이다. 네가 나와 함께 #ruby("근","近") 2#ruby("년","年")이나 이곳에 있으면서 익히 보았던바, #ruby("이|순|보","李|順|甫")가 #ruby("탈|옥","脫|獄")하였을 때 #ruby("감|옥","監|獄") #ruby("죄|수","罪|囚") #ruby("전|부","全|部")가 불려가 매를 맞았으나, #ruby("관|리","官|吏")들 #ruby("중","中") 누구 한 사람 내게 #ruby("대","對")하여 #ruby("감","敢")히 말 한마디 묻는 것을 보았느냐? #ruby("만|일","萬|一") 내가 #ruby("백|석","白|石")이를 살리려다가 #ruby("실|패","失|敗")하여 점잖지 못한 모습만 드러나게 되면, 오늘까지 #ruby("관|리","官|吏")들의 #ruby("경|애","敬|愛")를 받아왔던 것이 다 헛일이 되지 않겠는가? 또 #ruby("백|석","白|石")이를 살리려다가 도리어 죽이는 #ruby("결|과","結|果")만 낳을 터이니, 살고자 하는 #ruby("백|석","白|石")이보다 살리려는 네 마음을 믿을 수 없다.”]
#zh[我假装不信，对黄顺用说：“你多么爱金白石，我不知道，如今你为此暧昧之情，想救白石出狱。我也不是不可怜他，年纪轻轻，成了狱中之鬼，岂不可惜？但我要是答应了，动手救他时，你却去向巡警厅告发，我岂不倒霉？你和我在一起也快两年了，那一次李顺甫越狱，全体囚犯都被抓去挨了打，却没有人敢说我一句话。现在我要是可怜白石而救他，万一出了差错，我的英名岂不付诸东流？白石也不但未能获救，反而因此受害。我不是不相信想要活命的白石，倒是对想救白石的你不太放心。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|가","黃|哥")는 #ruby("별|별","別|別") #ruby("맹|세","盟|誓")를 다하였다. 그리고 그는 내가 같이 나가지는 않고 #ruby("자|기","自|己")들만 #ruby("옥|문","獄|門") 밖으로 나가게 해줄 #ruby("도|량","度|量")이 있는 줄 알았다. #ruby("황|가","黃|哥")에게 #ruby("절|대","絶|對") #ruby("복|종","服|從")하겠노라는 #ruby("서|약","誓|約")을 받고서야 비로소 #ruby("쾌","快")히 #ruby("승|낙","承|諾")하였다.]
#zh[黄顺用再三发誓，他以为我只是救他们出狱，而我自己并不和他们一起越狱。在他表示绝对听从我的指挥后，我才假装勉强接受了他的请求。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|덕|근","曺|德|根")·#ruby("양|봉|구","梁|鳳|九")·#ruby("황|순|용","黃|順|用")·#ruby("김|백|석","金|白|石")은 다 내가 #ruby("자|기","自|己")네들을 #ruby("옥|문","獄|門") 밖으로 나가게 해줄 줄 믿었다. 그러나 무슨 #ruby("방|법","方|法")으로 어떻게 할 것인지는 #ruby("감","敢")히 묻지도 못하고 있었다. #ruby("자|기","自|己")들 생각에 나는 #ruby("결","決")코 #ruby("도|주","逃|走")하지 않을 줄 믿고 #ruby("자|기","自|己")들만 내보내주고 나는 #ruby("의|연","毅|然")히 #ruby("감|옥","監|獄")에 있을 줄 믿었던 #ruby("모|양","模|樣")이다. #ruby("황|가","黃|哥")가]
#zh[曹德根、梁凤求、黄顺用、金白石只知道我要救他们出狱，但从不敢问我采取什么方法。他们也都认为我是决不会越狱逃走的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리가 가려면 #ruby("노|잣","路|資")돈이 있어야지요。”]
#zh[有一次，黄顺用跟我说：]
#zh[“我们要出去，得有些活动费才行。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[했을 때도 #ruby("조|덕|근","曺|德|根")이 돈을 가지고 있었지, 내게는 한 푼의 돈도 없었다.]
#zh[他只是看见曹德根弄到的钱，却知道我是身无分文。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("무|술|년","戊|戌|年")\(1898, 23#ruby("세","歲")) 3#ruby("월","月") #ruby("초","初")아흐렛날#footnote(numbering: _ => [140)])[#h(0.35em)#ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에 #ruby("의","依")하면 #ruby("탈|옥|일","脫|獄|日")은 1898#ruby("년","年") 3#ruby("월","月") 19#ruby("일","日")\(#ruby("음|력","陰|曆") 2#ruby("월","月") 27#ruby("일","日")) 밤이다.] #ruby("오|후","午|後")에 아버님을 #ruby("옥|문","獄|門") 밖으로 오시라 해서 대장장이에게 한 자 길이 #ruby("삼|릉|창","三|稜|槍")#footnote(numbering: _ => [141)])[#h(0.35em)모서리가 세 #ruby("개","個")인 #ruby("창","槍").] 하나를 만들어 달라 해서 새옷 속에 싸 들여 달라고 #ruby("부|탁","付|託")드렸다. 아버님도 무슨 일을 꾸미는 줄 #ruby("짐|작","斟|酌")하시고 #ruby("즉|시","卽|時") #ruby("삼|릉|형","三|稜|形")으로 만든 쇠#ruby("창","槍") 하나를 #ruby("의|복","衣|服") 속에 넣어주셨다. 받아서 품속에 감추었으나 #ruby("조|덕|근","曺|德|根") #ruby("등","等")은 알지 못하였다.]
#zh[戊戌年三月初九日下午，我请求见我父亲，请他弄一把一尺长的三棱枪裹在新衣服里带进来给我。父亲很敏感地觉察到我的用意，当天就在新衣服里藏了一把三棱枪递给了我。我偷偷地藏进怀里，谁也没有察觉。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님께서 저녁밥을 가지고 오셨을 때 나는,]
#zh[母亲带着晚饭来的时候，我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘 밤 #ruby("감|옥","監|獄")에서 나가오니, 아무 때나 찾을 때를 기다리시고 #ruby("부|모","父|母")님 두 분은 오늘 저녁으로 배를 타시고 #ruby("고|향","故|鄕")으로 가십시오.”]
#zh[“今天夜里我要出监狱，请二位随时等我来找，今晚就坐船回故乡。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 말씀드렸다. 어머님은]
#zh[母亲说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 나오겠니? 그럼 우리 둘이는 떠나마.”]
#zh[“你能出来吗？那我们两个就走了。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하시고 #ruby("작|별","作|別")하셨다.]
#zh[说完作别。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 #ruby("오|후","午|後")에 #ruby("간|수","看|守")를 불러 돈 150#ruby("냥","兩")을 주고 내가 오늘은 #ruby("죄|수","罪|囚")에게 한 턱을 낼 것이니 쌀과 고기와 #ruby("모|주","母|酒")#footnote(numbering: _ => [142)])[#h(0.35em)#ruby("모|주","母|酒"). #ruby("인|목|대|비","仁|穆|大|妃")의 어머니 #ruby("노|씨","盧|氏") #ruby("부|인","夫|人")이 만든 술이라고 해서 ‘#ruby("모|주","母|酒")’ 또는 ‘#ruby("대|비|모|주","大|妃|母|酒")’라고 한다. 술지게미를 타서 뿌옇게 걸러낸 술.] 한 #ruby("통","桶")을 사 오라고 #ruby("부|탁","付|託")하였다. #ruby("전","前")에도 #ruby("종|종","種|種") 그리하였으므로 #ruby("별","別")로 #ruby("이|상","異|常")해 보일 것이 없었다.]
#zh[那天下午我叫来看守，给了一百五十两，说今天要请囚犯一顿，请他买米、肉和一桶母酒。从前也常常这样，并不显得异常。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대가 오늘 밤 #ruby("당|번","當|番")이니 50#ruby("전","錢")어치 #ruby("아|편","烟|土")을 사 가지고 밤에 실컷 먹으라.”]
#zh[“你今晚值班，买五十钱的鸦片，夜里尽量吃。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. #ruby("매|일","每|日") 밤 #ruby("간|수","看|守") 한 사람씩 #ruby("감|옥","監|獄") #ruby("방","房")에서 밤을 보내는 것이 #ruby("규|칙","規|則")이었다. 그 #ruby("자","者")는 #ruby("아|편","阿|片")쟁이였고 #ruby("성|품","性|品")과 #ruby("행|동","行|動")이 #ruby("불|량","不|良")하여 #ruby("죄|수","罪|囚")들에게 #ruby("특|별","特|別")히 미움을 받는 #ruby("자","者")였다. #ruby("석|식","夕|食")에 50#ruby("여","餘") #ruby("명","名")의 #ruby("징|역|수","懲|役|囚")와 30#ruby("여","餘") #ruby("명","名")의 #ruby("잡|범","雜|犯")들까지 주렸던 창자에 고깃국과 #ruby("모|주","母|酒")를 실컷 먹었다. #ruby("흥","興")이 오를 즈음, 나는 #ruby("간|수","看|守")에게 #ruby("도|적|죄|수|간","盜|賊|罪|囚|間")에 가서 소리나 시켜 듣자고 #ruby("청","請")하였다. #ruby("간|수","看|守")는 #ruby("생|색","生|色")이나 내는 듯이 말하였다.]
#zh[每天夜里一名看守在牢房过夜是规矩。他是鸦片鬼，品性和行动不良，囚犯特别讨厌他。晚饭时五十多名惩役囚和三十多名杂犯，在饿着的肠子里把肉汤和母酒吃了个够。兴致上来的时候，我请看守到盗贼囚犯那边，让他们唱来听听。看守像是卖人情似地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|서|방","金|書|房")님 듣게 너희들 #ruby("장|기","長|技")대로 노래를 불러라。”]
#zh[“叫金书房听见，你们按自己的长技唱歌。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("명|령","命|令")이 내리자 #ruby("죄|수","罪|囚")들이 노래하느라고 #ruby("야|단","惹|端")들이었다. #ruby("간|수","看|守")는 #ruby("자|기","自|己") #ruby("방","房")에서 #ruby("아|편","阿|片")을 실컷 피우고 #ruby("정|신","精|神")이 흐릿하여 까무러져 있었다. 나는 #ruby("도|적","盜|賊") #ruby("방","房")에서 #ruby("잡|범","雜|犯") #ruby("방","房")으로, #ruby("잡|범","雜|犯") #ruby("방","房")에서 #ruby("도|적","盜|賊") #ruby("방","房")으로, #ruby("죄|수","罪|囚")들 사이로 왔다갔다 하다가, 틈을 타서 마루 속에 들어가 깔아놓은 #ruby("벽","甓")돌을 #ruby("창","槍")끝으로 들추고 땅속을 파서 #ruby("감|옥","監|獄") 밖으로 나섰다.]
#zh[命令一下，囚犯们唱得热闹。看守在自己房里把鸦片抽够，精神模糊，昏了过去。我从盗贼房到杂犯房，从杂犯房到盗贼房，在囚犯中间走来走去，趁空钻进地板下，用枪尖撬开铺着的砖，挖地，出了监狱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|옥","監|獄") 담을 넘을 줄사다리를 매어 놓고나니 문득 딴생각이 들었다.]
#zh[把翻狱墙的绳梯系好，忽然起了别的念头。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘#ruby("조|덕|근","曺|德|根") #ruby("등","等")을 데려가려다가 무슨 일이 날지 모르니 이 길로 곧 가버리는 것이 좋지 않을까? 그 #ruby("자","者")들은 #ruby("결","決")코 나의 #ruby("동|지","同|志")가 아니다. #ruby("기|필","期|必")코 건져내서 무엇하리.’]
#zh[‘带着曹德根他们，不知会出什么事，不如就这样走了。那些人决不是我的同志。一定要救出来做什么。’]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[또 한#ruby("편","便")으로는 이런 생각도 들었다.]
#zh[另一方面又这样想：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘그렇지 않다. 사람이 #ruby("현|인|군|자","賢|人|君|子")에게 #ruby("죄|인","罪|人")이 되어도 하늘을 이고 땅을 밟고 부끄러운 마음 견디기 어렵거든, 하물며 저와 같이 더러운 #ruby("죄|인","罪|人")의 #ruby("죄|인","罪|人")이 되고서야 죽을 때까지 그 부끄러움을 어찌 견디랴?’]
#zh[‘不对。人对贤人君子做了罪人，顶着天踩着地，羞耻也难以忍受，何况做了他们那种肮脏罪人的罪人，到死怎么受得住那羞耻？’]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[마침내 두#ruby("번","番")째 생각이 이기고 말았다. 나오던 구멍으로 다시 들어가서 #ruby("천|연","天|然")스럽게 내 자리에 앉아서 눈짓으로 네 #ruby("명","名")을 하나씩 다 내보내고 다섯#ruby("번","番")째로 내가 나갔다. 나가서 보니 먼저 내보낸 네 #ruby("명","名")이 #ruby("옥","獄")담 밑에 앉아 벌벌 떨기만 하고 #ruby("감","敢")히 담을 넘지 못하고 있었다. 내가 한 #ruby("명","名")씩 담 바깥으로 다 내보내고 마지막으로 담을 넘으려 할 때, 먼저 나간 #ruby("자","者")들이 #ruby("감|리|영","監|理|營")과 #ruby("옥","獄")을 #ruby("통|합","統|合")하여 #ruby("용|동","龍|洞") 마루를 #ruby("송|판","松|板")으로 둘러막은 데를 넘느라고 #ruby("요|란","擾|亂")한 소리를 내고 말았다. 밤#ruby("중","中")에 #ruby("요|란","擾|亂")한 소리가 나니 #ruby("경|무|청","警|務|廳")과 #ruby("순|검|청","巡|檢|廳")에서는 그 #ruby("즉|시","卽|時") #ruby("호|각","號|角")을 불어 #ruby("비|상|소|집","非|常|召|集")을 하는 #ruby("모|양","模|樣")이었다.]
#zh[终于第二个念头占了上风。我从出来的洞再钻回去，自然地坐回自己的位子，用眼色把四个人一个一个送出去，第五个我出去。出去一看，先送出的四个人坐在狱墙底下只是发抖，不敢翻墙。我把他们一个一个都送出墙外，最后要翻墙的时候，先出去的人翻监理营和监狱连在一起、用松板围住龙洞山梁的地方，弄出了吵闹的声音。夜里一吵，警务厅和巡检厅立刻吹号角，像是在紧急召集。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|문","獄|門") 밖에서는 벌써 그들의 발자국 소리가 들려왔다. 나는 아직 담 밑에 서 있었다. 내가 #ruby("만|일","萬|一") #ruby("감|옥","監|獄") #ruby("방","房")안에 있었다면 아무 #ruby("관|계","關|係")가 없었겠지만, 이미 담 밑에까지 나온 #ruby("후","後")였으므로 #ruby("급","急")히 #ruby("탈|주","脫|走")하는 것이 #ruby("상|책","上|策")이었다. 남을 넘겨주기는 쉬웠으나 혼자서 한 길 #ruby("반","半")이 넘는 담을 넘기란 #ruby("극","極")히 #ruby("곤|란","困|難")한 일이었다. #ruby("시|기","時|期")가 #ruby("급|박","急|迫")하지 않으면 줄사다리로라도 넘어볼 터이나, #ruby("문","門") 밖에서는 벌써 #ruby("옥|문","獄|門") 여는 소리가 나고 #ruby("감|방","監|房")에 있던 #ruby("죄|수","罪|囚")들도 떠들기 #ruby("시|작","始|作")했으므로 그럴 겨를이 없었다. 옆에서 #ruby("약","約") 한 길쯤 되는 몽둥이#footnote(numbering: _ => [143)])[#h(0.35em)#ruby("원|주","原|註"): “役囚들이 水桶을 맛머는 것인데”.]를 가져와 몸을 솟구쳐 담 꼭대기를 손으로 잡고 내리뛰었다. 그때는 #ruby("최|후","最|後") #ruby("결|심","決|心")을 한 때였으므로 누구든지 내 갈 길을 #ruby("방|해","妨|害")하는 #ruby("자","者")가 있으면 #ruby("결|단","決|斷")을 내버릴 마음으로 쇠#ruby("창","槍")을 손에 들고 #ruby("정|문","正|門")인 #ruby("삼|문","三|門")으로 바로 나갔다. #ruby("삼|문","三|門")을 지키던 #ruby("파|수","把|守") #ruby("순|검","巡|檢")도 #ruby("비|상|소|집","非|常|召|集")에 갔는지 #ruby("인|적","人|跡")이 없었다.]
#zh[我仍然站在墙下，既然已无法回到我的房间，只有赶快地想法逃走。但帮助别人爬墙容易，要自己一人爬过丈余高的围墙就难得多。这时连爬绳梯的工夫也没有了。四面传来打开狱门的声音以及囚犯们震天价响的喧闹声，趁这时，我支撑着放在对面扛水桶用的一丈多的木扁担，纵身跳起，手撑在墙边一跃而过。这时如果有人阻挡我的出路，我只有和他拼个你死我活。主意既定，也不翻越板墙，手持三棱枪，大步走向三门。把守三门的守卫，好像都跑进去紧急集合了，门口竟空无一人。我就从坦坦大道上走了出来，过了两年的牢狱生活后，终于又从仁川的监狱里出来了。]
