#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이때 #ruby[임|진|년][壬|辰|年]\(1892, 17#ruby("세","歲")) #ruby("경|과","慶|科")#footnote(numbering: _ => [1)])[#h(0.35em)#ruby("원|주","原|註"): “科制最後”. #ruby("경|과","慶|科")는 나라에 #ruby("경|사","慶|事")가 있을 때 #ruby("임|시","臨|時")로 보는 #ruby("과|거","科|擧")를 말한다. #ruby("해|주","海|州")에서 보는 #ruby("과|거","科|擧")는 #ruby("황|해|도","黃|海|道") #ruby("지|역","地|域")의 #ruby[향|시][鄕|試]이다. #ruby("백|범","白|凡")은 #ruby[임|진|년][壬|辰|年] #ruby("과|거","科|擧")를 ‘#ruby("최|후","最|後")의 #ruby("과|거","科|擧")’라고 #ruby("설|명","說|明")하였으나, #ruby("과|거","科|擧")는 #ruby[갑|오|년][甲|午|年]\(1894)까지 #ruby("실|시","實|施")되고, #ruby("갑|오|개|혁","甲|午|改|革") #ruby("이|후","以|後") #ruby("폐|지","廢|止")되었다. 아마도 #ruby("해|주","海|州")에서 보는 #ruby("향|시","鄕|試")는 #ruby[임|진|년][壬|辰|年] #ruby("경|과","慶|科")가 마지막이었을 #ruby("가|능|성","可|能|性")도 있다.]를 #ruby("해|주","海|州")에서 #ruby("거|행","擧|行")한다는 #ruby("공|포","公|布")가 있자, #ruby("정|선|생","鄭|先|生")은 이 #ruby("사|실","事|實")을 아버님께 알렸다.]
#zh[这时公布了壬辰庆科（我国最后一次科试）在海州举行。一天郑老师告诉父亲说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이번 #ruby("과|거","科|擧")에 #ruby("창|암","昌|巖")이를 데리고 가면 좋겠는데, 글씨를 #ruby("분|판","粉|板")에 쓰면 #ruby("창|암","昌|巖")이 #ruby("답|안|지","答|案|紙")#footnote(numbering: _ => [2)])[#h(0.35em)#ruby("원|문","原|文"): “明紙”. 아마도 ‘名紙’일 것이다. #ruby("명|지","名|紙")는 #ruby("과|거","科|擧") #ruby("시|험","試|驗")에 #ruby("제|출","提|出")하는 #ruby("답|안|지","答|案|紙")이다.]도 쓸 만하지만, #ruby("과|거","科|擧") #ruby("답|안|지","答|案|紙")와 같은 종이에 #ruby("연|습","練|習")하지 않으면 처음이라 잘 쓸 수 없을 것이네. 그러니 #ruby("장|지","狀|紙")#footnote(numbering: _ => [3)])[#h(0.35em)두껍고 #ruby("질","質")이 좋은 #ruby("한|지","韓|紙")의 #ruby("일|종","一|種")으로 #ruby("과|거","科|擧") #ruby("답|안|지","答|案|紙")로 #ruby("사|용","使|用")된다. #ruby("과|거","科|擧") #ruby("답|안|지","答|案|紙")는 #ruby("시|험|장","試|驗|場")에서 긁어내면서 #ruby("수|정","修|正")할 수 있도록 #ruby("특|별","特|別")히 두껍고 #ruby("질","質")이 좋다.]에 #ruby("연|습","練|習")하면 좋겠는데, #ruby("노|형","老|兄")은 #ruby("빈|한","貧|寒")하여 #ruby("주|선","周|旋")할 #ruby("도|리","道|理")가 없겠지?”]
#zh[“这次科举，应带昌岩去应试。过去光写粉板，虽也能写明纸，但因是生手，怕写不好，必须在状纸上练习书法，以准备书写明纸。老兄家境贫寒，能否买纸？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“종이는 내가 #ruby("주|선","周|旋")하여 볼 테지만 #ruby("창|암","昌|巖")이는 글씨만 쓰면 되겠나?”]
#zh[父亲说：“纸我买，能写字就行吧？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“글은 내가 지어줌세.”]
#zh[“文章我给写。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|생","先|生")의 이 말에 아버님은 무척 기뻐하시며 #ruby("장|지","狀|紙") 다섯 #ruby("장","張")을 #ruby("구|입","購|入")하셨다. 나는 기쁘고 #ruby("감|사","感|謝")하여 #ruby[필|사][筆|師]의 #ruby[교|법][敎|法]대로 #ruby("정|성","精|誠")을 다하여 #ruby("연|습","練|習")하니 하얀 종이가 온통 검게 #ruby("변","變")하였다.]
#zh[父亲很高兴，想方设法买来状纸五张。我高兴而又感激，按老师所教之笔法，勤练书法，把那五张纸写到乌黑为止。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("과|거","科|擧") #ruby("비|용","費|用")을 #ruby("준|비","準|備")하지 못했던 우리 #ruby("부|자","父|子")는 먹을 #ruby("좁|쌀","粟|米")을 등에 지고 #ruby("선|생","先|生")님을 따라 #ruby("해|주","海|州")에 #ruby("도|착","到|着")하여 아버님이 #ruby("이|전","以|前")부터 잘 알고 있던 #ruby("계|방","契|房") 집에 #ruby("기|숙","寄|宿")하였다. 드디어 #ruby("시|험","試|驗")보는 날, #ruby[선|화|당][宣|化|堂] 옆 #ruby[관|풍|각][觀|風|閣] #ruby("주|변","周|邊") #ruby("사|방","四|方")에는 새끼줄로 #ruby("망","網")을 둘러쳤고, #ruby("정","定")해진 #ruby("시|간","時|間")에 #ruby("과|거|장","科|擧|場")의 #ruby("문","門")을 열었다. 흰 베에 ‘#ruby[산|동|접][山|洞|接]’이니 ‘#ruby[석|담|접][石|潭|接]’이니#footnote(numbering: _ => [4)])[#h(0.35em)#ruby("산|동","山|洞"), #ruby("석|담","石|潭") #ruby("등","等")은 #ruby("지|역","地|域") 이름이다. 그런데 여기서 #ruby("접","接")은 #ruby("동|학","東|學")의 #ruby("조|직|체|계","組|織|體|系")인 #ruby[포|접|제][包|接|制]의 #ruby("접","接")과는 #ruby("구|별","區|別")되는 것으로, #ruby("유|교|적","儒|敎|的") #ruby("의|미","意|味")에서 #ruby("서|당","書|堂")과 #ruby("유|사","類|似")한 #ruby("의|미","意|味")이다. #ruby("접","接")의 #ruby("관|리|자","管|理|者")가 #ruby[접|장][接|長], 곧 #ruby("선|생","先|生")이다.] 하는 #ruby("접","接")의 이름을 써서 #ruby("장","長")대 끝에 매달고 #ruby("자|기","自|己") #ruby("접","接")의 자리를 먼저 잡으려고 힘있는 #ruby("자","者")를 앞세워, 큰 종이#ruby("양|산","陽|傘")을 들고 #ruby("도|포","道|袍") 입고 #ruby("유|건","儒|巾") 쓴 선비들이 #ruby[접|접][接|接]이 들어가는 #ruby("대|혼|잡","大|混|雜")의 #ruby("광|경","光|景")은 참으로 볼 만하였다.#footnote(numbering: _ => [5)])[#h(0.35em)#ruby("원|래","元|來") #ruby("과|거|장","科|擧|場")에는 #ruby("수|험|생","受|驗|生") #ruby("이|외","以|外") #ruby("출|입","出|入")이 #ruby("엄|격","嚴|格")하게 #ruby("금|지","禁|止")되었다. 그러나 #ruby("후|기","後|期")에 문란해지면서 #ruby("수|험|생","受|驗|生")을 따라 여러 사람들이 들어가는 ‘#ruby[수|종][隨|從]의 #ruby("폐","弊")’가 생겼다.] #ruby("과|거|장","科|擧|場")에는 #ruby("노|소","老|少") #ruby("귀|천","貴|賤")이 없이 #ruby("무|질|서","無|秩|序")한 것이 내려오는 #ruby("풍|습","風|習")이라 한다.]
#zh[科试的日子一天一天接近，由于我们父子没有钱，所以背着足够考试期间吃的小米，随着郑老师去了海州。没有钱住客栈，就在父亲以前认识的禊房家里暂时安身。]
#zh[考试那一天，在宣化堂旁边的观风阁，四周用绳子围起来。据说要准时排队赴考场，考生们随着本院的学生队伍，各队拿着用白布做的旗帜，上面写着各书院名称“山洞接”、“石潭接”等字样，考生们头戴巾，身穿道袍，高举纸伞，随着接旗，以勇士为先导，争先恐后地抢占位子，拥了进去。科场中是不分老幼贵贱的，不讲秩序，当时称之为“遗风”。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[또 볼 만한 것은 늙은 #ruby("선|비","老|儒")들이 #ruby[걸|과][乞|科]#footnote(numbering: _ => [6)])[#h(0.35em)#ruby("걸|과","乞|科")의 #ruby("원|래","元|來") 뜻은 #ruby[소|과][小|科]에서 떨어진 늙은 선비가 #ruby("자|기","自|己")의 #ruby("실|력","實|力")을 믿고 #ruby[시|관][試|官]의 #ruby("면|전","面|前")에서 #ruby("자|기","自|己") #ruby("실|력","實|力")을 다시 #ruby("시|험","試|驗")해 달라고 #ruby("간|청","懇|請")하는 것이지만, 여기서는 #ruby("실|력","實|力")도 없으면서 #ruby("무|조|건","無|條|件") #ruby("합|격","合|格")시켜 달라고 #ruby("애|걸","哀|乞")하는 것을 #ruby("의|미","意|味")한다.]하는 모습이었다. #ruby[관|풍|각][觀|風|閣]을 #ruby("향","向")하여 새끼줄#ruby("망","網") 구멍 사이로 머리를 들이밀고]
#zh[还有许多老儒生头伸出围网，面向观风阁高声“乞科”①：]
#zh[译注：希望科举考试及格的祷告。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("소|생","小|生")의 #ruby("성|명","姓|名")은 아무개이옵는데 먼 시골에 살면서 #ruby("과|거","科|擧") 때마다 #ruby("참|석","參|席")하여 #ruby("금|년","今|年") #ruby("칠|십","七|十") 살입니다. 요다음 다시 #ruby("과|거","科|擧")에 #ruby("참|석","參|席")하지는 못하겠습니다. #ruby[초|시][初|試]#footnote(numbering: _ => [7)])[#h(0.35em)#ruby("과|거","科|擧")의 1#ruby("차","次") #ruby("시|험","試|驗"). 이에 #ruby("합|격","合|格")해야 2#ruby("차","次") #ruby("시|험","試|驗")인 #ruby[복|시][覆|試]에 #ruby("응|시","應|試")할 수 있다.]라도 한 #ruby("번","番") #ruby("합|격","合|格")하면 죽어도 #ruby("한","恨")이 없습니다.”]
#zh[考生某某，家住某乡，路途遥远，每次科举均参加，现年七十余岁，当无法参加下次科举，此次纵为初试，若能及第，死而无憾！]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[며 #ruby("진|정","陳|情")하는 것이다. 어떤 이는 큰소리로 외치고, 어떤 이는 목놓아 우니 #ruby("비|굴","卑|屈")하기도 하고 가엾기도 하였다.]
#zh[场中乱哄哄的，有的大声喧哗，有的放声痛哭，真是可怜又可笑！]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[본|접][本|接]에 와서 보니 #ruby("선|생","先|生")과 #ruby("접|장","接|長")들이 #ruby("작|자|작","作|者|作") #ruby("서|자|서","書|者|書")하드라.#footnote(numbering: _ => [8)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “글을 짓는 #ruby("자","者")는 짓기만 하고 글씨를 쓰는 #ruby("자","者")는 쓰기만 하였다.” 이것은 #ruby("응|시|자","應|試|者")가 #ruby("직|접","直|接") 짓고 쓰는 것이 아니라 #ruby[대|작][代|作] #ruby[대|필][代|筆]하는 #ruby("과|거","科|擧") #ruby("부|정","不|正")을 #ruby("묘|사","描|寫")한 것이다.] 나는 #ruby("선|생","先|生")님에게 늙은 선비들의 #ruby("걸|과","乞|科")하는 모습을 말씀드린 #ruby("후","後")]
#zh[本来我的文章决定由郑老师代作，只是由我誊写。我到了本接旗下一看，老师和接长们正在写作者、作书者。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이번에 제가 아니라 아버님 #ruby("명|의","名|義")로 #ruby("과|거","科|擧") #ruby("답|안|지","答|案|紙")를 #ruby("작|성","作|成")하여 주시면 좋겠습니다. 저는 앞으로도 #ruby("기|회","機|會")가 많지 않겠습니까?”]
#zh[我向老师诉说了老儒生乞科的情景，说明我不愿以我的名义参加科试，想以父亲的名义报考，而我以后的机会还多。]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("부|탁","付|託")하자 #ruby("선|생","先|生")님은 내 말에 #ruby("감|동","感|動")하여 #ruby("흔|쾌","欣|快")히 #ruby("수|락","受|諾")하셨다. 이런 #ruby("대|화","對|話")를 들은 어떤 #ruby[접|장][接|長] 한 분이]
#zh[老师听了，高兴而又感动。有个接长也赞同我的话说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네 글씨가 나만은 못할 터, 네 아버님 #ruby("답|안|지","答|案|紙")의 글씨는 내가 써 주마. 너는 #ruby("후|일","後|日") #ruby("과|거","科|擧") #ruby("공|부","工|夫")를 더 해서 #ruby("직|접","直|接") 짓고 쓰도록 해라.”]
#zh[“好吧，你写的字不如我，由我来写你父亲的明纸。你再多读些书，日后科试由你自己作书誊写。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 거들어 주신다. 나는]
#zh[他从旁应承下来。我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 고맙습니다.”]
#zh[“是，谢谢。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[며 #ruby("감|사","感|謝")하였다. 이렇게 #ruby("선|생","先|生")님이 짓고 #ruby("접|장","接|長")이 쓴, 아버님 #ruby("명|의","名|義")의 #ruby("과|거","科|擧") #ruby("답|안|지","答|案|紙")를 새끼줄#ruby("망","網") 사이로 #ruby[시|관][試|官] 앞을 #ruby("향","向")해 쏘아 들여보냈다.#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("과|거","科|擧")에 #ruby("응|시|자","應|試|者")가 #ruby("증|가","增|加")하면서 앞#ruby("부|분","部|分")의 #ruby("답|안|지","答|案|紙")만 #ruby("채|점","採|點")하는 #ruby("폐|단","弊|端")이 있어 다투어 #ruby("답|안|지","答|案|紙")를 먼저 내고자 하였다. 이것을 ‘#ruby[조|정][早|呈]의 #ruby("폐","弊")’라고 한다.]]
#zh[那天就以我父亲的名义，写好卷子，穿过绳网呈递给试官。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리고 나서 #ruby("과|거","科|擧")에 얽힌 이런 말 저런 말을 들었다. #ruby("시|관","試|官")에 대해 #ruby("불|평","不|平")하는 말로는 “#ruby[통|인][通|引]#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("수|령","守|令")의 #ruby("신|변","身|邊")에서 #ruby("사|환","使|喚") 일을 하는 #ruby("하|급","下|級") 구실아치.]놈들이 #ruby("시|관","試|官")에게는 보이지도 않고 #ruby("과|거","科|擧") #ruby("답|안|지","答|案|紙") 한아름을 #ruby("도|적","盜|賊")하여 갔다”는 것이나, “#ruby("과|거|장","科|擧|場")에서 글을 짓고 쓸 때 남에게 보이지 말아야 하는데 그 #ruby("이|유","理|由")는 글을 지을 줄 모르는 #ruby("자","者")가 남의 글을 보고 가서 #ruby("자|기","自|己") 글로 #ruby("제|출","提|出")한다”는 것이다.#footnote(numbering: _ => [11)])[#h(0.35em)#ruby("과|거","科|擧") #ruby("비|리","非|理") #ruby("중","中")의 하나로 #ruby("차|술","借|述")이라 한다.] 또 #ruby("괴|이","怪|異")한 말은 “돈만 많으면 #ruby("과|거","科|擧")도 벼슬도 다 할 수 있다. 글을 모르는 #ruby("부|자","富|者")들이 큰 선비의 글을 몇백 #ruby("냥","兩") 몇천 #ruby("냥","兩")씩 주고 사서 #ruby("진|사","進|士")도 하고 #ruby("급|제","及|第")도 하였다”고 한다. 그뿐인가. “이번 #ruby("시|관","試|官")은 누구인즉, 서울 아무 #ruby("대|신","大|臣")에 #ruby("편|지","便|紙")를 부쳤으니까 반드시 된다”고 #ruby("자|신","自|信")하는 사람, “아무개는 #ruby("시|관","試|官")의 #ruby("수|청","守|廳") #ruby("기|생","妓|生")에게 #ruby("주|단","紬|緞") 몇 #ruby("필","疋")을 #ruby("선|사","膳|賜")하였으니 이번에 꼭 #ruby("과|거","科|擧")를 한다”고 #ruby("자|신","自|信")하는 #ruby("자","者")도 있었다.#footnote(numbering: _ => [12)])[#h(0.35em)#ruby("과|거","科|擧")의 #ruby("대|표|적","代|表|的")인 #ruby("폐|단","弊|端")이 #ruby("시|관","試|官")과 #ruby("수|험|생","受|驗|生") #ruby("측","側")이 #ruby("결|탁","結|託")하는 것이다.]]
#zh[此时我环顾四周，只见众人议论纷纷。有的不满试官，大发牢骚；有的说皂隶们不把试卷给试官批阅，偷走了一些试卷；有的说在科场作文时千万别让人看，因为有不通笔墨者偷看后，以自己的名义誊写了呈递上去。还有这样的怪话，说是只要有钱，就能科试当官，不通文墨的富豪出钱几百两、几千两买来大儒的文章，就能进士及第。岂止这些，还有人充满自信，说是汉城某大臣给试官写了书翰，这次必中无疑；还有人夸口说赠送给试官的守厅艺妓数匹绸缎，这次必然金榜题名。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[드디어 나는 #ruby("과|거","科|擧")에 대한 #ruby("의|문","疑|問")이 생기기 #ruby("시|작","始|作")하였다. 위의 몇 가지 #ruby("현|상","現|象")만 보아도 #ruby("과|거","科|擧")가 무슨 #ruby("필|요","必|要")가 있으며 무슨 #ruby("가|치","價|値")가 있는가? 내가 #ruby("심|혈","心|血")을 다하여 #ruby("장|래","將|來")를 #ruby("개|척","開|拓")하기 #ruby("위","爲")해 #ruby("공|부","工|夫")하는 것인데, 선비가 되는 #ruby("유|일","唯|一")한 #ruby("통|로","通|路")인 #ruby("과|거|장","科|擧|場")의 꼬락서니가 이 #ruby("모|양","模|樣")이니,#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("매|천","梅|泉") #ruby[황|현][黃|玹]도 “낫 놓고 ㄱ#ruby("자","字")도 모르는 사람이 #ruby("과|거","科|擧") #ruby("급|제|자","及|第|者")로 #ruby("선|발","選|拔")된다”는 #ruby("당|시","當|時")의 #ruby("속|담","俗|談")을 #ruby("소|개","紹|介")하면서 #ruby("과|거","科|擧") #ruby("부|정","不|正")을 #ruby("개|탄","慨|歎")하였다.] 내가 #ruby[시][詩]·#ruby[부][賦]를 지어 과문6#ruby("체","科文六體")#footnote(numbering: _ => [14)])[#h(0.35em)#ruby("문|과","文|科") #ruby("과|거","科|擧") 때 #ruby("시|험","試|驗")보는 6가지 글의 #ruby("체","體"), 즉 #ruby[시][詩]·#ruby[부][賦]·#ruby[표][表]·#ruby[책][策]·#ruby[의][疑]·#ruby[의][義].]에 #ruby("능|통","能|通")하더라도 아무 #ruby("선|생","先|生") 아무 #ruby("접|장","接|長") #ruby("모|양","模|樣")으로 #ruby("과|거|장","科|擧|場")의 #ruby("대|서|업|자","代|書|業|者")에 #ruby("불|과","不|過")할 것이니 나도 이제 다른 길을 #ruby("연|구","硏|究")하리라 #ruby("결|심","決|心")하였다.]
#zh[我对科举产生了疑问。从上述几种现状来看，推行科举制度的国家（国即王、王即国的时代）举办这种科举，究竟有多大价值？我为开拓未来，倾注心血，用功读书，即使成为儒生，其出路只有一条，那就是科举。现在科举是这种样子，国家大事又将如何？我就是能吟诗作赋，精通科文，也只能和某老师、某接长一样，作个科场的代书人。我必须转变方向，探索今后的道路。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 이처럼 #ruby("과|거","科|擧")길에서 #ruby("불|쾌","不|快")한 느낌과 #ruby("비|관|적","悲|觀|的")인 생각만 품은 채 집으로 돌아와 아버님과 #ruby("상|의","相|議")하였다.]
#zh[我怀着不快的感觉和悲观的情绪，回到家中和父亲商议：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 어떻게든 #ruby("공|부","工|夫")로 #ruby[입|신|양|명][立|身|揚|名]하여 #ruby("강|가","姜|哥")·#ruby("이|가","李|哥")에게 #ruby("당","當")한 #ruby("압|제","壓|制")를 #ruby("면","免")할까 하였는데, 그 #ruby("유|일","唯|一")한 #ruby("방|법","方|法")이라는 #ruby("과|거|장","科|擧|場")의 #ruby("폐|해","弊|害")가 이와 같은즉, 제 비록 큰 선비가 되어 #ruby("학|력","學|力")으로 #ruby("강","姜")·#ruby("이|씨","李|氏")를 #ruby("압|도","壓|倒")하더라도 그들에게는 #ruby("공|방","孔|方")#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("엽|전","葉|錢")”. #ruby("공|방","孔|方")은 네모난 구멍, 즉 #ruby("엽|전","葉|錢")으로서 #ruby("재|력","財|力")을 #ruby("의|미","意|味")한다.]의 #ruby("마|력","魔|力")이 있는데 어찌하오리까. 또한 큰 선비가 되도록 #ruby("공|부","工|夫")를 하려면 #ruby("다|소","多|少")의 #ruby("금|전","金|錢")이라도 있어야 하는데, 집안이 이같이 가난하니 앞으로 #ruby("서|당","書|堂") #ruby("공|부","工|夫")를 그만두겠습니다.”]
#zh[“这次在科场中见到种种怪事。我原想学有所成、立身扬名，以免再受姜、李两家的欺凌。现在作为我唯一出路的科场竟有如此弊端，我即便成为大儒，学力压倒姜、李，他们有孔方兄的魔力，又能奈何？况且要想读书、成为大儒，多少要有些钱财，现在家中一贫如洗，我是不再想读书了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아버님 #ruby("역|시","亦|是") 옳게 여기시고 이렇게 말씀하신다.]
#zh[父亲也认为我说得有理，便说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너 그러면 #ruby("풍|수|공|부","風|水|工|夫")나 #ruby("관|상|공|부","觀|相|工|夫")를 해보아라. #ruby("풍|수","風|水")에 #ruby("능","能")해 #ruby("명|당","明|堂")에 #ruby("조|상","祖|上")을 모시면 #ruby("자|손","子|孫")이 #ruby("복|록","福|祿")을 누리게 되고, #ruby("관|상","觀|相")을 잘 보면 #ruby("선","善")한 사람과 #ruby("군|자","君|子")를 만날 수 있다.”]
#zh[“那么你试一试学习看风水，或看相吧！如果学而有成的话，便替自己祖先找一处风水好的祖坟，不愁子孙发达，享受富贵了。看相看得好，或许会遇到圣人君子也未可知。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("이|치","理|致")에 맞는 말이라 생각되어]
#zh[我认为这话很有道理，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그것을 #ruby("공|부","工|夫")하여 보겠습니다. #ruby("서|적","書|籍")을 얻어주십시오.”]
#zh[“那我就学一学。请给我弄来书籍。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("부|탁","付|託")하였다. 아버님이 #ruby("우|선","優|先") 『#ruby[마|의|상|서][麻|衣|相|書]』#footnote(numbering: _ => [16)])[#h(0.35em)『#ruby("마|의|상|서","麻|衣|相|書")』는 『#ruby[마|의|상|법][麻|衣|相|法]』. #ruby("관|상|학","觀|相|學")의 2#ruby("대","大") #ruby("경|전","經|典")으로는 #ruby("달|마|대|사","達|磨|大|師")가 지은 『#ruby[달|마|상|법][達|摩|相|法]』과 #ruby[마|의|도|사][麻|衣|道|士]가 지은 『#ruby("마|의|상|법","麻|衣|相|法")』이 있다. 『#ruby("달|마|상|법","達|摩|相|法")』은 #ruby("불|교|계","佛|敎|界"), 『#ruby("마|의|상|법","麻|衣|相|法")』은 #ruby("도|가|계","道|家|界")의 #ruby("대|표|적","代|表|的")인 #ruby("관|상|학","觀|相|學") #ruby("경|전","經|典")이다.] 한 #ruby[권][冊]을 빌려 주셔서 나는 #ruby("독|방","獨|房")에서 이것을 #ruby("공|부","工|夫")하였다. #ruby("관|상|서","觀|相|書")를 #ruby("공|부","工|夫")하는 #ruby("방|법","方|法")은 먼저 거울로 #ruby("자|신","自|身")의 #ruby("상","相")을 보면서 #ruby("부|위","部|位")와 #ruby("개|념","概|念")을 익힌 다음, 다른 사람의 #ruby("상","相")으로 #ruby("확|대","擴|大")·#ruby("적|용","適|用")해 나가는 것이 #ruby("첩|경","捷|徑")이다. 나는 #ruby("두|문|불|출","杜|門|不|出")하고 석 달 동안이나 내 #ruby("상","相")을 #ruby("관|상|학","觀|相|學")에 따라 #ruby("면|밀","綿|密")하게 #ruby("관|찰","觀|察")하였다. 그러나 어느 한 군데도 #ruby("귀|격","貴|格")·#ruby("부|격","富|格")의 좋은 #ruby("상","相")은 없고, 얼굴과 온몸에 #ruby("천|격","賤|格")·#ruby("빈|격","貧|格")·#ruby("흉|격","凶|格")밖에 없다. #ruby("과|거|장","科|擧|場")에서 얻은 #ruby("비|관","悲|觀")에서 벗어나기 #ruby("위","爲")해 #ruby("관|상|서","觀|相|書")를 #ruby("공|부","工|夫")했는데 오히려 #ruby("과|거|장","科|擧|場") #ruby("이|상","以|上")의 #ruby("비|관","悲|觀")에 빠져버렸다. 짐승과 같이 살기 #ruby("위","爲")해 산다면 모르지만 #ruby("인|간","人|間")으로서 #ruby("세|상","世|上") 살고 싶은 마음이 없어졌다. 그런데 『#ruby("상|서","相|書")』 #ruby("중","中")에 이런 #ruby("구|절","句|節")이 있다.]
#zh[我这样拜托了。父亲先借来一本《麻衣相书》，我独自在房里潜心研究。学习相书的捷径是对着镜子记下自己面孔各部位的名字，这样由己及人。]
#zh[颇有意思的是我发现比起看别人的面相，更有必要好好看看自己的面相。于是杜门不出三个月，根据相法、相论，观察自己的面相。看来看去也无富贵之相，倒是有些贫贱凶相而已。过去科场失败，原要想在相书上得到补偿，可是反而觉得更加颓丧。]
#zh[人生是否也像禽兽一样，仅只为活命而生存，最后与草木同朽呢？《麻衣相书》中有一句话给陷于绝望中的我带来一线希望：]
#quote-block[#ruby("상","相") 좋은 것이 몸 좋은 것만 #ruby("못하고","相好不如身好")]
#zh[“相好不如身好；”]
#quote-block[몸 좋은 것이 마음 좋은 것만 못하다. (身好不如心好)]
#zh[“身好不如心好。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이것을 보고 나는 #ruby("상","相") 좋은 #ruby[사람][好相人]보다 마음 좋은 #ruby[사람][好心人]이 되어야겠다고 #ruby("결|심","決|心")하였다. 이제부터 밖을 가꾸는 #ruby("외|적","外|的") #ruby("수|양","修|養")에는 #ruby("무|관|심","無|關|心")하고 마음을 닦는 #ruby("내|적","內|的") #ruby("수|양","修|養")에 힘써 사람 구실을 하겠다고 마음먹으니, #ruby("종|전","從|前")에 #ruby("공|부","工|夫") 잘하여 #ruby("과|거","科|擧")하고 벼슬하여 #ruby("천","賤")한 #ruby("신|세","身|世")에서 벗어나겠다는 생각은 #ruby("순|전","純|全")히 #ruby("허|영","虛|榮")이고 #ruby("망|상","妄|想")이요, 마음 좋은 사람이 #ruby("취","取")할 바 아니라고 생각되었다. 그러나 마음 좋지 못한 사람이 마음 좋은 사람으로 되는 #ruby("방|법","方|法")이 있는가 스스로 물어보니 #ruby("역|시","亦|是") #ruby("막|연","漠|然")하였다.]
#zh[看了这话，我于是放心了，坚决抱定要做好人的信念。我决心不管相貌如何，首先致力于内心的修养，做一个真正的人。过去想靠科举当官，以摆脱贫贱，这是虚荣、是妄想，不为好人所取。可是心地不好的人，有什么好方法会变成好心人呢？对此仍感茫然。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[『#ruby("상|서","相|書")』를 그만 덮어버리고 #ruby("지|리","地|理")에 #ruby("관","關")한 #ruby[책][地家書]도 좀 보았으나 #ruby("취|미","趣|味")를 얻지 못하고, #ruby("병|서","兵|書")인 『#ruby[손|무|자][孫|武|子]』,#footnote(numbering: _ => [17)])[#h(0.35em)『#ruby("손|무|자","孫|武|子")』 또는 『#ruby[손|자][孫|子]』. #ruby("중|국","中|國")의 #ruby[손|무][孫|武]\(孫子)가 지은 #ruby("병|서","兵|書"). 1#ruby("권","卷") 3#ruby("편","篇")으로, #ruby("병|서","兵|書")로서 가장 #ruby("유|명","有|名")한 #ruby("명|저","名|著")이다.] 『#ruby[오|기|자][吳|起|子]』,#footnote(numbering: _ => [18)])[#h(0.35em)『#ruby("오|기|자","吳|起|子")』 또는 『#ruby[오|자][吳|子]』. #ruby("중|국","中|國") #ruby("춘|추|전|국|시|대","春|秋|戰|國|時|代")에 #ruby[오|기][吳|起]\(吳子)가 지은 #ruby("병|서","兵|書"). 1#ruby("권","卷") 6#ruby("편","篇")으로, 『#ruby("손|자","孫|子")』와 #ruby("쌍|벽","雙|璧")을 이루는 #ruby("명|저","名|著")이다.] 『#ruby[삼|략][三|略]』,#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("중|국","中|國") #ruby("한","漢")나라 사람 #ruby[장|량][張|良]이 #ruby[황|석|공][黃|石|公]에게 받았다는 #ruby("병|서","兵|書"). #ruby[상|략][上|略], #ruby[중|략][中|略], #ruby[하|략][下|略]의 세 #ruby("권","卷")으로 나뉘어진다.] 『#ruby[육|도][六|韜]』#footnote(numbering: _ => [20)])[#h(0.35em)#ruby("주","周")나라 #ruby[태|공|망][太|公|望]이 #ruby("편|찬","編|纂")한 #ruby("병|법|서","兵|法|書"). #ruby[문|도][文|韜], #ruby[무|도][武|韜], #ruby[용|도][龍|韜], #ruby[호|도][虎|韜], #ruby[표|도][豹|韜], #ruby[견|도][犬|韜]의 6#ruby("권","卷") 60#ruby("편","篇")이다.] #ruby("등","等")을 보니 #ruby("이|해","理|解")하지 못할 곳이 많다. 그러나 #ruby("장|수","將|帥")가 될 훌륭한 #ruby("재|질","才|質")을 #ruby("논","論")하면서]
#zh[因而合上相书，再稍浏览地家书，可是这也不能引起我的兴趣，又转而开始研读兵书。看《孙武子》、《吴起子》、《三略》、《六韬》等，不明白的地方很多。可是读到论将帅才质的地方，有这样的句子：]
#quote-block[#ruby("태|산","泰|山")이 앞에서 무너져도 #ruby("결","決")코 흔들리지 않는다. (泰山覆於前 心不妄動)]
#zh[“泰山覆于前，心不妄动。”]
#quote-block[#ruby("병|사","兵|士")들과 더불어 #ruby("고|락","苦|樂")을 함께 한다. (與士卒 同甘苦)]
#zh[“与士卒同甘苦。”]
#quote-block[나아가고 물러섬을 호랑이와 같이 한다. (進退如虎)]
#zh[“进退如虎。”]
#quote-block[#ruby("적","敵")을 알고 나를 알면 #ruby("백","百") #ruby("번","番") 싸워 지지 않는다. (知彼知己 百戰不敗)]
#zh[“知彼知己，百战不败。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("등","等")의 #ruby("구|절","句|節")을 매우 #ruby("흥|미","興|味") 있게 #ruby("낭|송","朗|誦")하였다. 나이 열일곱 살 때 나는 1#ruby("년|간","年|間") #ruby("일|가","一|家") 아이들을 모아 #ruby("훈|장","訓|長")질하면서 #ruby("의|미","意|味")도 잘 모르는 #ruby("병|서","兵|書")만 읽었다.]
#zh[这些章句我读得极有兴味，朗声诵读。我十七岁那年，集合一家子弟，自己当训长教他们，一面读着自己也不大明白的兵书，这样过了一年。]
#heading(level: 3)[#text(font: "KOPUSGo B")[2) #ruby("동|학","東|學")의 #ruby("세|계","世|界")로]]
#zh[加入东学党]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 즈음 #ruby("사|방","四|方")에서 #ruby("괴|이","怪|異")한 이야기들이 #ruby("분|분","紛|紛")하였다.]
#zh[是时，四方怪异的传闻纷纷而起。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어디에는 #ruby[이|인][異|人]이 나타나 바다에 떠다니는 #ruby[기|선][汽|船]을 못 가게 딱 붙여놓고 #ruby("세|금","稅|金")을 내야 놓아준다.”]
#zh[“某地出现异人，把海上行驶的轮船定住，不缴税就不放行。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“곧 #ruby("정|도|령","鄭|道|令")#footnote(numbering: _ => [21)])[#h(0.35em)『#ruby[정|감|록][鄭|鑑|錄]』 #ruby("등","等") #ruby("조|선","朝|鮮") #ruby("후|기","後|期") #ruby[비|기][祕|記]#ruby("류","類")의 #ruby("책","冊")에서는 #ruby("이|씨","李|氏") #ruby("조|선","朝|鮮")이 #ruby("멸|망","滅|亡")하고 #ruby("정|씨","鄭|氏") #ruby("성","姓")을 가진 #ruby[진|인][眞|人], 즉 #ruby("정|도|령","鄭|道|令")이 나타나 #ruby("계|룡|산","鷄|龍|山")을 새 #ruby("도|읍|지","都|邑|地")로 하여 나라를 일으킨다고 #ruby("예|언","豫|言")하였다.]이 #ruby("계|룡|산","鷄|龍|山")에 #ruby("도|읍","都|邑")을 #ruby("정","定")하여 #ruby("이|조","李|朝") #ruby("국|가","國|家")는 없어질 것이니 밧흔 목#footnote(numbering: _ => [22)])[#h(0.35em)‘바른 목’ ‘바깥목’ #ruby("등","等") 풀이가 #ruby("구|구","區|區")하다. #ruby("정|감|록","鄭|鑑|錄") #ruby("신|앙","信|仰")에는 #ruby("난|세","亂|世")에는 #ruby("풍|수|설","風|水|說")에 #ruby("입|각","立|脚")해 #ruby[십|승|지|지][十|勝|之|地]처럼 #ruby[복|정][卜|定]된 곳에 #ruby("피|난","避|難")해서 살아야 #ruby("복","福")을 누릴 수 있다고 한다. ‘밧흔 목’은 바로 그러한 곳을 말한다.]에 가서 살아야 다음 #ruby("세|상","世|上")에 #ruby("양|반","兩|班")이 된다며 아무개는 #ruby("계|룡|산","鷄|龍|山")으로 #ruby("이|사","移|徙")했다.”]
#zh[“不久郑道令将定都鸡龙山，李朝国家就要灭亡，得到那地方去住，来世才能做两班。某人已经变卖财产，举家迁往鸡龙山了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 우리 동네에서 #ruby("남","南")쪽으로 20#ruby("리","里") 떨어진 #ruby[포|동][浦|洞]에 사는 #ruby[오|응|선][吳|膺|善]과 그 옆동네 #ruby[최|유|현][崔|琉|鉉] #ruby("등","等")은 #ruby("충|청|도","忠|淸|道")에서 #ruby[최|도|명][崔|道|明]#footnote(numbering: _ => [23)])[#h(0.35em)#ruby("동|학","東|學")의 2#ruby("대","大") #ruby("교|주","敎|主") #ruby[최|시|형][崔|時|亨]이라 #ruby("짐|작","斟|酌")된다.]이란 #ruby("동|학","東|學") #ruby("선|생","先|生")에게 #ruby("입|도","入|道")해서 #ruby("공|부","工|夫")하는데, #ruby("방|문","房|門")을 열고 닫음이 없이 #ruby("홀|연","忽|然")히 나타났다 사라지곤 하며 #ruby("공|중","空|中")으로도 걸어다닌다 한다. 그 #ruby("선|생","先|生") #ruby[최|도|명][崔|道|明]은 하룻밤 사이에 #ruby("능","能")히 #ruby("충|청|도","忠|淸|道")를 왔다갔다 한다고 한다. 나는 #ruby("호|기|심","好|奇|心")이 생겨 가서 보고 싶었다. 그런데 그 집을 찾아가는 #ruby("예|절","禮|節")은 고기를 먹지 않고 #ruby("목|욕","沐|浴")하고 새 옷으로 갈아입고 가야 #ruby("접|대","接|待")를 한다고 한다.]
#zh[又听说距我们村子南面二十多里的浦洞，有个名叫吴膺善的，与他邻村有一位叫崔琉铉的人同在忠清道东学老师崔道明门下学道，能飞檐走壁，忽隐忽现，并且能御风而行；他们的老师崔道明先生去忠清道，能在一夜之间来回。因此我又对“东学”发生兴趣，决定去寻访此人。据别人说，必须斋戒沐浴，穿上新衣，才会被收录授业。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내 나이 #ruby("십|팔|세","十|八|歲") 되든 #ruby("정|초","正|初"),#footnote(numbering: _ => [24)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “열여덟이 되는 #ruby[계|사|년][癸|巳|年]\(1893) #ruby("정|초","正|初")”. #ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에서도 #ruby("백|범","白|凡")의 #ruby("동|학","東|學") #ruby("입|도|시|기","入|道|時|期")는 1893#ruby("년","癸巳年")이다.] 나는 고기도 먹지 않고 #ruby("목|욕","沐|浴")하고 머리 땋고, 푸른 #ruby("도|포","靑|袍")에 #ruby[녹|대][綠|帶]를 매고#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("일|반|적","一|般|的")으로 #ruby("평|상|시","平|常|時")에는 흰#ruby("색","色") #ruby("도|포","道|袍")를, #ruby("특|별","特|別")한 #ruby("경|사|일","慶|事|日")에는 푸른#ruby("색","色") #ruby("도|포","道|袍")를 입는다. #ruby("백|범","白|凡")이 차림에 #ruby("정|성","精|誠")을 다한 모습을 볼 수 있다.] #ruby[포|동][浦|洞] #ruby[오|씨][吳|氏] #ruby("댁","宅")으로 #ruby("방|문","訪|問")하였다. #ruby("문","門")에 이르자 #ruby("방","房")에서는 무슨 글 읽는 소리가 들리는데 #ruby("시","詩")나 #ruby("경|전","經|典")을 읽는 소리와는 다르고 노래를 #ruby("합|창","合|唱")하는 것 같으나 그 #ruby("의|미","意|味")를 알 수 없었다. #ruby("공|경","恭|敬")하는 #ruby("자|세","姿|勢")로 #ruby("문","門")에 나아가 #ruby("주|인","主|人") #ruby("면|회","面|會")를 #ruby("청","請")하였더니 #ruby("젊|은","妙|妙") #ruby("청|년","靑|年") 한 사람이 나와 #ruby("접|대","接|待")하였다. 나는 그가 #ruby("양|반","兩|班")임을 알고 있었는데, #ruby("과|연","果|然") 상투를 짜고 #ruby[통|천|관][通|天|冠]#footnote(numbering: _ => [26)])[#h(0.35em)#ruby("통|천|관","通|天|冠")은 #ruby("원|래","元|來") 임금이 #ruby("정|사","政|事")를 보거나 #ruby("조|칙","詔|勅")을 내릴 때 쓰는 #ruby("관","冠")으로, #ruby[옥|잠][玉|簪]과 #ruby[홍|영][紅|纓]을 갖추어 쓴다. #ruby("후|대","後|代")에는 #ruby("양|반","兩|班")들도 #ruby("사|용","使|用")하였다. 여기서는 그가 #ruby("양|반","兩|班")이어서 #ruby("과|연","果|然") #ruby("일|반|인","一|般|人")과는 달리 #ruby("귀","貴")한 #ruby("통|천|관","通|天|冠")을 쓰고 있더라는 #ruby("의|미","意|味")이다.]을 쓰고 있었다. 내가 #ruby("공|손","恭|遜")히 절을 하니 그 사람도 #ruby("공|손","恭|遜")히 맞절을 하고서는]
#zh[在十八岁那年正月初，我斋戒沐浴，头梳长辫，身穿青袍，腰系丝带，登程拜访浦洞吴宅。]
#zh[至其门前，里面传出读书的声音，与一般读诵经典或吟诗声音全然不同，倒像是在合唱，也听不懂是什么意思。]
#zh[我恭敬地来到门前，请求面见主人，屋内闻声出来一个面目清秀的青年接待了我，原知这家是两班，现在看来，果然不错。他束着发髻，头戴通天冠。我恭敬地行礼，他也恭敬地还礼，问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("도|령","道|令")은 어디서 오셨소?”]
#zh[“公子从哪儿来？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 묻는다. 나는 #ruby("황|공","惶|恐")하여 #ruby("본|색","本|色")을 말하였다.]
#zh[他问道。我惶恐地道出自己的本分：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어른이 되어도 #ruby("당|신","當|身")께 #ruby("공|대","恭|待")를 듣지 못하련만 하물며 저는 아직 아이인데 어찌 #ruby("공|대","恭|待")를 하나이까.”]
#zh[“便是成年，也受不起您的答礼，何况我还是个孩子，怎么敢承当？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그이는 #ruby("감|동","感|動")하는 빛을 보이면서]
#zh[那人脸上露出感动的神色，说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("천|만","千|萬")의 말씀이오. 나는 다른 사람과 달리 #ruby("동|학","東|學") #ruby("도|인","道|人")이기 때문에 #ruby("선|생","先|生")의 #ruby("교|훈","敎|訓")을 받들어 #ruby("빈|부","貧|富") #ruby("귀|천","貴|賤")에 #ruby("차|별","差|別") #ruby("대|우","待|遇")가 없습니다. 조금도 #ruby("미|안","未|安")해 마시고 찾아오신 뜻이나 말씀하시오.”]
#zh[“哪里的话。我与常人不同，是东学道人，遵照老师的训诫，不论贫富贵贱，一概没有差别。请丝毫不必不安，只说来意吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 이 말만 들어도 #ruby("별|세|계","別|世|界")에 온 것 같았다. 그와의 #ruby("문|답","問|答")이 #ruby("시|작","始|作")되었다.]
#zh[我听了这话，仿佛到了另一个世界。于是和他问答应答起来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 오기는 #ruby("선|생","先|生")이 #ruby("동|학","東|學")을 하신다는 말을 듣고 #ruby("도|리","道|理")를 알고 싶어 왔습니다. 이런 아이에게도 말씀하여 주실 수 있습니까?”]
#zh[“我来，是听说先生在学东学，想知道其中的道理。像我这样的孩子，也能讲给我听吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그처럼 알고 싶어 오셨다는데 내가 아는 데까지 말씀드리겠습니다.”]
#zh[他很高兴地向我说明了东学的由来和道理。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|학","東|學")이란 어떤 #ruby("취|지","宗|旨")이며 어느 #ruby("선|생","先|生")이 #ruby("천|명","闡|明")하였습니까?”]
#zh[“东学是什么宗旨，是哪一位先生阐明的？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|학","東|學")은 #ruby[용|담][龍|潭] #ruby[최|수|운][崔|水|雲]#footnote(numbering: _ => [27)])[#h(0.35em)#ruby("수|운","水|雲")은 #ruby("동|학","東|學")의 #ruby("창|시|자","創|始|者") 즉 #ruby("교|조","敎|祖")인 #ruby[최|제|우][崔|濟|愚]\(1824〜1864)의 #ruby("호","號"). #ruby("용|담","龍|潭")은 그가 #ruby("수|련","修|鍊")한 곳이다. 그는 16#ruby("세","歲") 때 #ruby("출|가","出|家")한 #ruby("이|후","以|後") 1860#ruby("년","年")\(37#ruby("세","歲")) #ruby("동|학","東|學")을 #ruby("창|시","創|始")하고, 이듬해부터 #ruby("동|학","東|學")을 #ruby("포|교","布|敎")하기 #ruby("시|작","始|作")하였다. #ruby("폭|발|적","爆|發|的")인 #ruby("호|응","呼|應")으로 #ruby("당|국","當|局")의 #ruby("주|목","注|目")을 받아 그는 1863#ruby("년","年") #ruby("경|주","慶|州")에서 #ruby("체|포","逮|捕")되어, 이듬해 #ruby("대|구","大|邱")에서 #ruby[사|도|난|정][邪|道|亂|正]의 #ruby("죄|목","罪|目")으로 #ruby("처|형","處|刑")되었다. 그#ruby("후","後") #ruby("동|학|교|도","東|學|敎|徒")들은 끊임없이 #ruby[교|조|신|원|운|동][敎|祖|伸|寃|運|動]을 #ruby("전|개","展|開")하였다.] #ruby("선|생","先|生")이 #ruby("천|명","闡|明")하였으나 이미 #ruby("순|교","殉|敎")하셨고, #ruby("지|금","只|今")은 그 조카 #ruby[최|해|월][崔|海|月]#footnote(numbering: _ => [28)])[#h(0.35em)#ruby[최|시|형][崔|時|亨]\(1827〜1898). #ruby("동|학","東|學")의 2#ruby("대","大") #ruby("교|주","敎|主").] #ruby("선|생","先|生")이 #ruby[대|도|주][大|道|主]가 되어 #ruby("포|교","布|敎")#ruby("중","中")입니다. #ruby("동|학","東|學")의 #ruby("종|지","宗|旨")로 말하면 #ruby("말|세","末|世")의 #ruby("사|악","邪|惡")한 #ruby("인|간","人|間")들로 하여금 #ruby("개|과|천|선","改|過|遷|善")하여 새 #ruby("백|성","百|姓")이 되어 #ruby("장|래","將|來") #ruby[참주인][眞主]을 모시고 #ruby("계|룡|산","鷄|龍|山")에 #ruby[신|국|가][新|國|家]를 #ruby("건|설","建|設")하는 것입니다.”]
#zh[原来东学道是龙潭崔水云先生首创的，崔先生已殉教，现由他的侄子崔海月任大道主继续布道。这个道的宗旨，乃在使末世的子民改恶从善，成为新百姓，准备将来侍奉真主，在鸡龙山建立新国家。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("설|명","說|明")을 듣고 나는 매우 마음이 #ruby("흡|족","洽|足")하였다. #ruby("과|거","科|擧")에 #ruby("낙|방","落|榜")하고 난 뒤 #ruby("관|상|공|부","觀|相|工|夫")에서 마음 좋은 사람이 되기로 #ruby("결|심","決|心")한 나에게 #ruby("천|주","天|主")#footnote(numbering: _ => [29)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “하늘님”. #ruby("동|학","東|學")에서는 ‘하늘님’으로, 그 뒤 #ruby("천|도|교","天|道|敎")에서는 ‘한울님’으로 불렀다.]를 모시고 #ruby("도","道")를 #ruby("행","行")한다는 말이 가장 마음에 와 닿았다. 또한 #ruby("상","常")놈된 #ruby("원|한","怨|恨")이 #ruby("골|수","骨|髓")에 사무친 나에게 #ruby("동|학","東|學")에 #ruby("입|도","入|道")만 하면 #ruby("차|별","差|別") #ruby("대|우","待|遇")를 #ruby("철|폐","撤|廢")한다는 말이나 #ruby[이|조][李|朝]의 #ruby("운|수","運|數")가 다하여 #ruby("장|래","將|來") 새 #ruby("국|가","國|家")를 #ruby("건|설","建|設")한다는 말에서는 #ruby("작|년","昨|年") #ruby("과|거|장","科|擧|場")에서 품은 #ruby("비|관","悲|觀")이 #ruby("연|상","聯|想")되었다.]
#zh[听了这道理，使我欣喜若狂。我曾发誓要做好心人，听到侍奉真主，替天行道这话，不觉为之动心。而我又一向对阶级差别恨之入骨，东学的平等主义给我增添无比的力量，听到李朝运数已尽，要建新国之说，联想到在海州参加科举时所见的事实，我好像着魔似的，立即询问入道手续。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("동|학","東|學")에 #ruby("입|도","入|道")할 마음이 불길같이 일어났다. #ruby("오|씨","吳|氏")에게 #ruby("입|도","入|道") #ruby("절|차","節|次")를 물어보니 #ruby[백|미][白|米] 한 말, #ruby[백|지][白|紙] 세 묶음, 누런 #ruby[초][黃燭] 한 #ruby("쌍","雙")을 가져오면 #ruby("입|도|식","入|道|式")을 #ruby("행","行")해 준다고 한다.#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("동|학","東|學")의 #ruby("입|도|식","入|道|式") #ruby("자|체","自|體")는 #ruby[청|수][淸|水]를 모셔놓고 #ruby("주|문","呪|文")을 외는 것이다. 위에 #ruby("언|급","言|及")된 #ruby("백|미","白|米") #ruby("등","等")은 #ruby("입|도|식","入|道|式")에 가지고 가는 #ruby("예|물","禮|物")의 #ruby("일|종","一|種")일 따름이다.] 나는 『#ruby[성|경|대|전][聖|經|大|全]』#footnote(numbering: _ => [31)])[#h(0.35em)#ruby[최|제|우][崔|濟|愚]의 『#ruby[동|경|대|전][東|經|大|全]』을 #ruby("동|학","東|學")에서는 #ruby("최|고","最|高") #ruby("중|요","重|要")한 #ruby("경|전","經|典")이란 #ruby("의|미","意|味")에서 『#ruby("성|경|대|전","聖|經|大|全")』이라고 한다.] 『#ruby[팔|편|가|사][八|編|歌|辭]』#footnote(numbering: _ => [32)])[#h(0.35em)#ruby[최|제|우][崔|濟|愚]가 지은 한글 #ruby("가|사|체","歌|辭|體")의 #ruby("경|전","經|典")인 『#ruby("용|담|유|사","龍|潭|遺|詞")』가 8#ruby("편","篇")으로 #ruby("구|성","構|成")되어 있어 #ruby("일|명","一|名") 『#ruby("팔|편|가|사","八|編|歌|辭")』라고도 한다.] 『#ruby[궁|을|가][弓|乙|歌]』#footnote(numbering: _ => [33)])[#h(0.35em)『#ruby("용|담|유|사","龍|潭|遺|詞")』 #ruby("이|후","以|後")의 #ruby("가|사|체","歌|辭|體") #ruby("동|학","東|學") #ruby("경|전","經|典")으로 ‘#ruby[궁|궁|을|을][弓|弓|乙|乙] #ruby[성|도][成|道]로다’라는 #ruby("후|렴|구","後|斂|句")가 #ruby("반|복","反|復")된다. #ruby("용|담|대|사","龍|潭|大|師")의 #ruby("필|사|본","筆|寫|本")과 #ruby[김|주|희][金|周|熙]의 #ruby("목|각|본","木|刻|本")\(1932)에 #ruby("수|록","收|錄")되어 있다. #ruby("백|범","白|凡")이 1893#ruby("년","年")에 이미 『#ruby("궁|을|가","弓|乙|歌")』를 보았다는 위의 #ruby("언|급","言|及")으로 보아 이 #ruby("책","冊")은 #ruby("일|반|적","一|般|的")으로 알려진 것보다 #ruby("상|당","相|當")히 오래 #ruby("전","前"), #ruby[최|시|형][崔|時|亨] #ruby("생|존|시","生|存|時")부터 있었다는 것을 알 수 있다.] #ruby("등","等") #ruby("동|학","東|學") #ruby("경|전","經|典")을 #ruby("열|람","閱|覽")한 #ruby("후","後") 집으로 돌아왔다. 아버님께 #ruby("오|씨","吳|氏")와 나눈 #ruby("대|화","對|話")를 #ruby("소|상","昭|詳")히 #ruby("보|고","報|告")하니 아버님은 나의 #ruby("동|학","東|學") #ruby("입|도","入|道")를 #ruby("흔|쾌","欣|快")히 #ruby("승|낙","承|諾")하시고 #ruby("필|요","必|要")한 #ruby("예|물","禮|物")을 #ruby("준|비","準|備")해 주셨다.]
#zh[遵照道规，须缴白米一斗，白纸三卷和黄烛一对，方能入道。我阅读了《圣经大全》、《八编歌词》和《弓乙歌》等东学典籍后，回到家中，禀告父亲此行经过，父亲立即答应了，给我准备了入道所需的礼物。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 곧바로 #ruby("예|물","禮|物")을 가지고 가서 #ruby("입|도","入|道")하여 #ruby("동|학","東|學")을 #ruby("열|심","熱|心")히 #ruby("공|부","工|夫")하기 #ruby("시|작","始|作")했고, 아버님도 #ruby("동|학","東|學")에 #ruby("입|도","入|道")하셨다. #ruby("당|시","當|時") #ruby("양|반","兩|班")들은 #ruby("동|학","東|學")에 #ruby("가|입","加|入")하는 #ruby("자","者")가 드물었던 #ruby("반|면","反|面"), 내가 #ruby("상","常")놈인 만큼 #ruby("상","常")놈들이 #ruby("동|학","東|學")으로 많이 쏠려 들어왔다. #ruby("불|과","不|過") #ruby("수|개|월","數|個|月") 만에 나의 #ruby[연|비][連|臂]#footnote(numbering: _ => [34)])[#h(0.35em)#ruby("원|주","原|註"): “部下라 할가 弟子라 할가”. #ruby("동|학","東|學")에서는 #ruby("도","道")를 #ruby("전","傳")한 #ruby[사람][傳道人]을 #ruby[연|원][淵|源]이라 하고, #ruby("도","道")를 받은 #ruby[사람][受道人]을 #ruby[연|비][連|臂]라고 한다. 즉 #ruby("백|범","白|凡")의 #ruby("연|원","淵|源")은 #ruby[오|응|선][吳|膺|善]이고, #ruby("연|비","連|臂")는 #ruby("백|범","白|凡")이 #ruby("포|교","布|敎")한 사람들이다.]는 #ruby("수|백","數|百") #ruby("명","名")에 이르렀다.]
#zh[从此我就成为东学的一员，用功学习东学。父亲也跟着我入了道。]
#zh[就当时情况而言，两班加入东学的极少，而平民却甚为踊跃，不到数月，“连臂”（布道后发展的信徒，或称弟子）已达数百人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") 나에 대한 #ruby("근|거","根|據") 없는 이야기가 #ruby("인|근","隣|近")에 두루 #ruby("유|포","流|布")되었다. 사람들이 찾아와 “그대가 #ruby("동|학","東|學")을 해보니 무슨 #ruby("조|화","造|化")가 생기더냐?”고 물으면, “나쁜 일을 하지 않고 #ruby("선","善")한 일 하게 되는 것이 #ruby("동|학","東|學")의 #ruby("조|화","造|化")이다”라고 #ruby("정|직","正|直")하게 #ruby("대|답","對|答")하였다. 그러나 듣는 이들은 내가 #ruby("자|기","自|己")네들에게 아직 #ruby("조|화","造|化")를 보여주지 않은 것으로 생각하고 “#ruby[김|창|수][金|昌|洙]#footnote(numbering: _ => [35)])[#h(0.35em)#ruby("백|범","白|凡")의 #ruby("아|명","兒|名")은 #ruby[창|암][昌|巖]이었으나, 1893#ruby("년","年") #ruby("동|학","東|學")에 #ruby("입|도","入|道")하면서 #ruby[김|창|수][金|昌|洙]로 #ruby("개|명","改|名")하였다.]가 한 길 이상 #ruby("공|중","空|中")에서 걸어가는 것을 보았다”고 한 것이다. 나의 #ruby("도|력","道|力")에 대한 #ruby("근|거","根|據") 없는 #ruby("소|문","所|聞")은 #ruby("황|해|도","黃|海|道")는 #ruby("물|론","勿|論")이고 #ruby("평|안|남|북|도","平|安|南|北|道")에까지 퍼져 #ruby("연|비","連|臂")가 #ruby("수|천","數|千")에 #ruby("달","達")하였다. 나는 #ruby("황|해|도","黃|海|道")·#ruby("평|안|도","平|安|道")의 #ruby("동|학|당","東|學|黨") #ruby("중","中") 나이 어린 #ruby("자","者")로 가장 많은 #ruby("연|비","連|臂")를 가졌기 때문에 #ruby("별|명","別|名")이 ‘아기 #ruby[접|주][接|主]’#footnote(numbering: _ => [36)])[#h(0.35em)#ruby("동|학","東|學")의 #ruby("조|직|체|계","組|織|體|系")는 #ruby[포|접|제][包|接|制]인데, #ruby("접","接")은 #ruby[접|주][接|主]를 #ruby("중|심","中|心")으로 하는 #ruby("동|학","東|學") #ruby("기|초|조|직","基|礎|組|織")이다. #ruby("포","包")는 여러 #ruby("접","接")을 #ruby("포|괄","包|括")하는 큰 #ruby("조|직","組|織")이다.]였다.]
#zh[因此我的名声，遐迩咸知，很多人找我来求教入道途径，也有人造我的谣言。故而常常有人问我：]
#zh[“你信仰东学，会有什么造化呢？”]
#zh[我总是这样回答：]
#zh[“不要作恶，多行善，便是造化。”]
#zh[这是我的率直而正当的回答，可是往往不能使听者满意，他们还以为我把造化藏起来，不让他们看见。也有人说看见过金昌洙（此时我开始用这个名字）凌空一丈多高走路，这种毫无根据的谣言，散播到各地，使我名盛一时，不仅在黄海道一带，甚至远至平安南北道，只要提到我的名字，众人皆知。当年我手下的“连臂”多达数千之众。在黄海平安两西地方的东学当中，我是年纪最轻而拥有“连臂”最多的，因此大家别称我为“幼接主”①。]
#zh[译注：“接主”是东学首领的意思，是从上面赐下的职衔。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("익","翌") #ruby("계|사|년","癸|巳|年")#footnote(numbering: _ => [37)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby[계|사|년][癸|巳|年]\(1893)”. #ruby("동|학","東|學")에 #ruby("입|문","入|門")한 때, 즉 ‘열여덟 살 되는 #ruby("정|초","正|初")’도 #ruby[계|사|년][癸|巳|年]이기 때문에 #ruby("연|도","年|度") #ruby("기|억","記|憶")에 #ruby("착|각","錯|覺")이 있다. 다음해 #ruby[갑|오|년][甲|午|年]\(1894)으로 #ruby("수|정","修|正")해야 #ruby("타|당","妥|當")할 듯하다.] 가을에 #ruby[오|응|선][吳|膺|善]·#ruby[최|유|현][崔|琉|鉉] #ruby("등","等")이 “#ruby("충|청|도","忠|淸|道") #ruby[보|은][報|恩]에 계신 #ruby[해|월][海|月] #ruby[대|도|주][大|道|主]에게 #ruby("각|자","各|自") #ruby("자|기","自|己") #ruby("연|비","連|臂")를 #ruby("보|고","報|告")하라”는 #ruby[경|통][敬|通]#footnote(numbering: _ => [38)])[#h(0.35em)#ruby("원|주","原|註"): “公函”. #ruby("경|통","敬|通")은 #ruby("동|학","東|學") #ruby("지|도|부","指|導|部")에서 #ruby("각","各") #ruby("교|도","敎|徒")들에게 내리는 #ruby("통|문","通|文")을 말한다.]에 따라 #ruby("황|해|도","黃|海|道")에서는 #ruby("명|망","名|望") 있는 #ruby[도|유][道|儒] 열다섯 #ruby("명","名")을 #ruby("선|발","選|拔")하는데 나도 뽑히게 되었다. 땋은 머리가 #ruby("여|행","旅|行")에 #ruby("불|편","不|便")하다고 해서 나는 #ruby("관","冠")을 쓰고 #ruby("출|발","出|發")하였다. #ruby("연|비","連|臂")들이 #ruby("여|비","旅|費")를 거두어 #ruby("해|주","海|州")에서 #ruby("특|별","特|別")히 만든 #ruby("향|먹","香|墨")#footnote(numbering: _ => [39)])[#h(0.35em)#ruby[해|주|먹][海|州|墨]. #ruby("일|명","一|名") #ruby[해|먹][海|墨]. #ruby("해|주","海|州") #ruby("일|원","一|圓")에서 #ruby("생|산","生|産")되는 먹은 #ruby("품|질","品|質")이 좋고 #ruby("향|기","香|氣")가 나 #ruby("전|국|적","全|國|的")으로 #ruby("유|명","有|名")한 #ruby("명|물","名|物")이다.]을 #ruby("토|산","土|産") #ruby("예|품","禮|品")으로 가지고, #ruby("육|로","陸|路")와 #ruby("수|로","水|路")를 통해 #ruby("충|청|도","忠|淸|道") #ruby[보|은|군][報|恩|郡] #ruby[장|안][長|安]이라는 동네에 #ruby("도|착","到|着")하였다.#footnote(numbering: _ => [40)])[#h(0.35em)아마도 #ruby("제","第")3#ruby("차","次") #ruby[교|조|신|원|운|동][敎|祖|伸|寃|運|動] #ruby("집|회","集|會")가 열린 #ruby[장|내|리][長|內|里]일 것이다. 1863#ruby("년","年") #ruby[최|제|우][崔|濟|愚]가 #ruby("체|포","逮|捕")된 #ruby("후","後") #ruby[최|시|형][崔|時|亨]은 #ruby[대|구][大|邱]·#ruby[평|해][平|海]·#ruby[울|진][蔚|珍]·#ruby[영|양][英|陽]·#ruby[영|해][寧|海]·#ruby[영|월][寧|越]·#ruby[인|제][麟|蹄]·#ruby[단|양][丹|陽] #ruby("등","等")을 #ruby("전|전","轉|轉")하다 1885#ruby("년","年") #ruby("충|청|도","忠|淸|道") #ruby[보|은|군][報|恩|郡] #ruby[장|내|리][長|內|里]에 #ruby("근|거|지","根|據|地")를 #ruby("마|련","磨|鍊")하였다. 그는 1892#ruby("년","年") #ruby[삼|례][參|禮] #ruby("집|회","集|會"), 1893#ruby("년","年") 2#ruby("월","月") #ruby[광|화|문][光|化|門] #ruby("상|소","上|疏"), 1893#ruby("년","年") 3#ruby("월","月") #ruby("보|은","報|恩")의 #ruby[장|내|리][長|內|里] #ruby("집|회","集|會") #ruby("등","等") 3#ruby("차","次")에 걸친 #ruby[교|조|신|원|운|동][敎|祖|伸|寃|運|動]을 벌였다.] 그 동네의 이집 저집 이 구석 저 구석에서는,]
#zh[癸巳年秋天，海月大道主从忠清道报恩发给吴膺善、崔琉铉等《敬通》（公函），让他们上报各自“连臂”的名单，并在道内选拔十五名深孚众望的“道儒”直接去晋见大道主。我也当选。因梳着辫子不方便，故盛冠启程。]
#zh[“连臂”们捐助我旅费并以特制的海州香墨作献给道主的礼物，一路水陆兼程，到达了海月先生居住的忠清道报恩郡长安。一进村子，但闻家家户户诵读咒文：]
#quote-block[“#ruby("지|기|금|지|원|위|대|강","至|氣|今|至|願|爲|大|降")”#footnote(numbering: _ => [41)])[#h(0.35em)#ruby("동|학","東|學")에서는 이것을 #ruby("특|별","特|別")히 ‘#ruby("초|학|주|문","初|學|呪|文")’ 또는 ‘8#ruby("자","字") #ruby("주|문","呪|文")’이라고 한다. #ruby("동|학","東|學")에 처음 #ruby("입|도","入|道")한 #ruby("초|심|자","初|心|者")들이 외는 #ruby("주|문","呪|文")으로, 뜻은 ‘#ruby("지|극","至|極")한 #ruby("기|운","氣|運")과 #ruby("원","願")을 내려주소서’이다.]]
#zh[“至气今至，愿为大降。”]
#quote-block[“#ruby("시|천|주|조|화|정 |영|세|불|망|만|사|지","侍|天|主|造|化|定 |永|世|不|忘|萬|事|知")”#footnote(numbering: _ => [42)])[#h(0.35em)#ruby("동|학","東|學")의 #ruby("본|주|문","本|呪|文")으로 ‘13#ruby("자","字") #ruby("주|문","呪|文")’이라고 한다. 뜻은 ‘하늘님을 모시면 #ruby("조|화","造|化")의 #ruby("경|지","境|地")가 이루어지고, #ruby("영|원","永|遠")히 잊혀지지 않고 #ruby("만|물","萬|物")의 #ruby("이|치","理|致")를 알 수 있다’로 #ruby("번|역","飜|譯")할 수 있다. #ruby("본|주|문","本|呪|文") 13#ruby("자","字")와 앞의 #ruby("초|학|주|문","初|學|呪|文") 8#ruby("자","字")를 합쳐 ‘21#ruby("자","字") #ruby("주|문","呪|文")’이라고 한다. 『#ruby[백|범|일|지][白|凡|逸|志]』 #ruby("원|문","原|文")에는 8#ruby("자","字")의 #ruby("초|학|주|문","初|學|呪|文")과 13#ruby("자","字") #ruby("본|주|문","本|呪|文")의 #ruby("순|서","順|序")가 바뀌어 있다.]]
#zh[“侍天主，造化定。永世不忘，万事知。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("등","等") #ruby("주|문","呪|文") 외는 소리가 들렸다. 동네 한쪽에서는 사람들이 떼지어 나가고, 다른 한쪽에서는 떼지어 들어와 집집마다 사람이 가득가득하였다.]
#zh[咒文之声不绝于耳。村子一边成群出去，另一边成群进来，家家都挤满了人。来晋见海月大道主的以及回程中的徒众，络绎不绝。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("접|대|인","接|待|人")에게 우리 #ruby("일|행","一|行") 열다섯의 #ruby("명|단","名|單")을 주어 #ruby[해|월][海|月] #ruby("선|생","先|生")에게 #ruby("통|지","通|知")하였다. #ruby("시|간","時|間")이 지나고 나서 #ruby("황|해|도","黃|海|道") #ruby("도|인","道|人")들을 부른다는 #ruby("통|지","通|知")를 받고 우리는 #ruby("일|제","一|齊")히 #ruby("인|도|자","引|導|者")의 뒤를 따라 #ruby[해|월][海|月] #ruby("선|생","先|生")이 계시는 #ruby("처|소","處|所")에 갔다. 집에 들어가 우리 열다섯 #ruby("명","名")이 #ruby[해|월][海|月] #ruby("선|생","先|生") 앞에 한꺼번에 절하자 #ruby("선|생","先|生")도 #ruby("역|시","亦|是") #ruby("상|체","上|體")를 구부리고 손을 땅에 짚고 #ruby("답|례","答|禮")로 절을 했다. 그리고는 “멀리서 #ruby("수|고","受|苦")시레 왔다”는 #ruby("간|단","簡|單")한 #ruby("인|사","人|事")를 하였다. 우리 #ruby("일|행","一|行") #ruby("중","中") #ruby("대|표","代|表")가 열다섯이 #ruby("각|각","各|各") 만든 #ruby("명|부|책","名|簿|冊")을 #ruby("선|생","先|生") 앞에 드렸다. #ruby("선|생","先|生")은 그 #ruby("명|부|책","名|簿|冊")을 #ruby("문|서","文|書") #ruby("책|임|자","責|任|者")에게 맡기면서 “#ruby("처|리","處|理")하라”고 #ruby("분|부","分|付")하였다.]
#zh[我们向接待人呈上十五人的名单，拜托他报告大道主我们到达的消息。]
#zh[不一会儿，通知要召见从黄海道来的道人。]
#zh[我们十五人随着向导，晋见海月先生，向先生行礼，先生坐着，躬身答礼，并对远道跋涉的我们道劳。我们献上信徒名册，先生命文书接过去处理。]
#figure-block("/images/p40.jpg", caption: [#ruby("제","第")2#ruby("대","代") #ruby("동|학","東|學") #ruby("교|주","敎|主") #ruby[해|월][海|月] #ruby[최|시|형][崔|時|亨].#linebreak()1898#ruby("년","年") #ruby("체|포","逮|捕")되어 #ruby("교|수|형","絞|首|刑")을 #ruby("당","當")했다.])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다른 사람들도 같은 생각이었겠지만 내가 #ruby("천|리","千|里")를 멀다 않고 #ruby("보|은","報|恩")에 간 것은 #ruby("선|생","先|生")이 무슨 #ruby("조|화","造|化")주머니나 주지 않나 하는 #ruby("기|대","期|待")와 #ruby("선|생","先|生")의 #ruby("도|골|도|풍","道|骨|道|風")은 어떠한가 살펴보려는 생각이 #ruby("간|절","懇|切")하였기 때문이다. #ruby("선|생","先|生")은 나이가 예순 가까이 되어 보이는데,#footnote(numbering: _ => [43)])[#h(0.35em)1894#ruby("년","年") #ruby("갑|오|농|민|전|쟁","甲|午|農|民|戰|爭") #ruby("당|시","當|時") #ruby[최|시|형][崔|時|亨]의 나이는 68#ruby("세","歲")였다.] #ruby("수|염","鬚|髥")은 길며 #ruby("색","色")은 보기 좋을 #ruby("정|도","程|度")로 #ruby("약|간","若|干") 검은 가닥이 있었다. #ruby("선|생","先|生")의 얼굴은 맑고 여위었으며, 머리에 큰 검은 #ruby[갓][黑笠]#footnote(numbering: _ => [44)])[#h(0.35em)검은 #ruby[갓][黑笠]의 양태\(둘레의 창)는 #ruby("유|행","流|行")과 #ruby("규|범","規|範")에 따라 크기가 #ruby("변","變")하였다. #ruby[대|원|군][大|院|君] #ruby("집|정","執|政") #ruby("후","後") #ruby("사|회|개|혁","社|會|改|革")의 #ruby("일|환","一|環")으로 큰 갓을 #ruby("금","禁")하여 주로 작은 갓을 #ruby("사|용","使|用")하였다. #ruby[백|범][白|凡]의 눈에는 #ruby[최|시|형][崔|時|亨]의 큰 갓이 #ruby("인|상|적","印|象|的")이었던 #ruby("모|양","模|樣")이다.]을 쓰고, 저고리만 입고 앉아서 일을 보셨다. #ruby("방|문","房|門") 앞의 #ruby("무|쇠","水|鐵") #ruby("화|로","火|爐")의 #ruby("약|탕|관","藥|湯|罐")에서는 #ruby("독|삼|탕","獨|蔘|湯")#footnote(numbering: _ => [45)])[#h(0.35em)맹물에 #ruby("인|삼","人|蔘") 한 가지만 넣고 끓이는 것으로 더운 #ruby("약","藥")으로 쓰인다.] 달이는 김과 냄새가 나는데, #ruby("선|생","先|生")이 잡수신다고 하였다.]
#zh[我们不远千里而来，不仅想请先生传授一点神奇的造化，还想瞻仰先生的道骨仙风。先生看来年近六旬，长着美好的连鬓胡子及少许黑毛，面貌清瘦，头戴黑笠，穿着上衣，端坐视事。门前放着一只铁炉，炉上煎药罐正在滚着，参汤的香气四溢，据说是先生所服用的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|생","先|生")의 #ruby("방","房") 안팎에는 많은 #ruby("제|자","弟|子")들이 #ruby("옹|위","擁|衛")하고 있는데 그#ruby("중","中") #ruby("측|근","側|近")에서 모시는 #ruby("자","者")는 #ruby[손|응|구][孫|應|九]\(秉熙)#footnote(numbering: _ => [46)])[#h(0.35em)#ruby[손|병|희][孫|秉|熙]\(1861〜1922). #ruby("초|명","初|名")이 #ruby("응|구","應|九"). #ruby("천|도|교","天|道|敎") 3#ruby("대","代") #ruby("교|주","敎|主"). #ruby("도|호","道|號") #ruby("의|암","義|菴"). 1897#ruby("년","年") #ruby[최|시|형][崔|時|亨]으로부터 #ruby("도|통","道|統")을 #ruby("전|수","傳|授")받는다. #ruby[백|범][白|凡]이 만난 #ruby("당|시","當|時") #ruby[손|병|희][孫|秉|熙]의 나이는 우리 나이 33#ruby("세","歲")였다. 그는 3·1#ruby("운|동","運|動") 때 #ruby("천|도|교","天|道|敎") #ruby("대|표","代|表")로 33#ruby("인","人") #ruby("중","中") 한 사람이다.]·#ruby("김|연|국","金|演|局")#footnote(numbering: _ => [47)])[#h(0.35em)#ruby[김|연|국][金|演|局]\(1857〜1944). #ruby("도|호","道|號") #ruby("구|암","龜|菴"). #ruby[의|암][義|菴] #ruby[손|병|희][孫|秉|熙], #ruby[송|암][松|菴] #ruby[손|천|민][孫|天|民]과 더불어 이른바 #ruby("천|도|교","天|道|敎")의 #ruby("삼|암","三|菴")이라 불린다. 나중에 #ruby[손|병|희][孫|秉|熙]와의 #ruby("불|화","不|和")로 #ruby("시|천|교","侍|天|敎") #ruby("대|선|사","大|仙|師")가 되고, 1925#ruby("년","年")에는 #ruby("신|도|안","新|都|安")에 #ruby("상|제|교","上|帝|敎")를 #ruby("창|시","創|始")하여 #ruby("교|주","敎|主")가 되었다. #ruby[백|범][白|凡]이 만난 #ruby("당|시","當|時") 나이는 우리 #ruby("식","式")으로 37#ruby("세","歲")였다.] #ruby("등","等") #ruby("선|생","先|生")의 사위 두 사람이고, 그 외에도 #ruby("유|명","有|名")한 #ruby("박|인|호","朴|寅|浩")#footnote(numbering: _ => [48)])[#h(0.35em)#ruby[박|인|호][朴|寅|浩]\(1855〜1940). #ruby("도|호","道|號")는 #ruby("춘|암","春|菴"). #ruby("보|은","報|恩") #ruby[장|내|리][長|內|里] #ruby("시|위","示|威")에 많은 #ruby("교|도","敎|徒")들을 #ruby("동|원","動|員")하여 #ruby[최|시|형][崔|時|亨]으로부터 #ruby("대|접|주","大|接|主")에 #ruby("임|명","任|命")되었고, 그#ruby("후","後") #ruby("동|학","東|學") #ruby("제","第")4#ruby("세","世") #ruby("대|도|주","大|道|主")가 된다.] #ruby("등","等") 많은 #ruby("제|자","弟|子")들이 있었다. 나의 #ruby("인|상","印|象")으로는, #ruby("김|씨","金|氏")는 나이 #ruby("사|십","四|十") 가까운 #ruby("순|박","淳|朴")한 #ruby("농|군","農|軍") 같았고 #ruby("손|씨","孫|氏")는 젊은 #ruby("청|년","靑|年")으로 #ruby("지|식","知|識")도 있어 보이고 #ruby("부|적","符|畵")에 ‘#ruby("천|을|천|수","天|乙|天|水")’라 쓴 것으로 보아 #ruby("필|재","筆|才")도 있어 보였다.]
#zh[房间内外由诸弟子们侍卫。其中先生最亲近的人是孙应九秉熙和金寅局，这两人是先生的女婿，此外还有有名的弟子朴寅浩等。]
#zh[看起来，孙秉熙是个清秀的青年，金寅局年纪约有四十，好像是诚实的农夫。]
#zh[孙先生曾在符书上写下“天乙天水”几个字，似乎是位书法家。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리가 그 #ruby("방","房")에 있을 때 #ruby("선|생","先|生")께 #ruby("보|고","報|告")하는 것을 들었다. 그 #ruby("내|용","內|容")은]
#zh[我们在那房里的时候，听见有人向先生报告。内容是：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("남|도|지|방","南|道|地|方")의 #ruby("각","各") #ruby("관|청","官|廳")에서 #ruby("동|학|당","東|學|黨")을 #ruby("체|포","逮|捕")하여 #ruby("압|박","壓|迫")하는 #ruby("반|면","反|面"), #ruby("고|부","古|阜")에서는 #ruby("전|봉|준","全|奉|準")이 벌써 #ruby("병|사","兵|士")를 일으켰습니다.”#footnote(numbering: _ => [49)])[#h(0.35em)이것은 1894#ruby("년","年") 9#ruby("월","月") #ruby[전|봉|준][全|奉|準] #ruby("주|도","主|導")의 #ruby("동|학|농|민|군","東|學|農|民|軍") #ruby("제","第")2#ruby("차","次") #ruby("봉|기","蜂|起")를 #ruby("의|미","意|味")하는 것으로 보인다.]]
#zh[“南道各官府一面逮捕东学党，加以压迫，古阜的全琫准已经起兵了。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아무 #ruby("군|수","郡|守")는 #ruby[도|유][道|儒]#footnote(numbering: _ => [50)])[#h(0.35em)#ruby("원|주","原|註"): “道儒는 東學黨人의 自稱 他稱의 名詞”. #ruby("도|유","道|儒")는 #ruby("동|학|교|도","東|學|敎|徒")들에 대한 #ruby("통|칭","通|稱")이다.]의 #ruby("전","全") #ruby("가|족","家|族")을 #ruby("체|포","逮|捕")하고 #ruby("가|산","家|産") #ruby("전|부","全|部")를 #ruby("강|탈","强|奪")하였습니다.”]
#zh[接着报告又说某郡的郡守逮捕了道儒的全家，又勒索钱财。]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("등","等")이었다. #ruby("선|생","先|生")은 #ruby("진|노","震|怒")하는 #ruby("안|색","顔|色")에 #ruby("순","純") #ruby("경|상|도","慶|尙|道") #ruby("어|조","語|調")로,]
#zh[先生听过报告，显出震怒之色，用庆尚道方言说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“호랑이가 물러 들어오면 가만히 앉아서 죽을까! 참나무 몽둥이라도 들고 나가서 싸우자!”]
#zh[“老虎扑过来了，怎么还坐着等死，手里就是只拿着一根木棒也得应战呀！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|생","先|生")의 이 말은 곧 ‘#ruby("동|원|령","動|員|令")’이다. #ruby("각|지","各|地")에서 와서 #ruby("대|령","待|令")하던 #ruby("대|접|주","大|接|主")들이 물끓듯이 밀려 나가기 #ruby("시|작","始|作")하였다. 우리 열다섯 사람에게도 #ruby("접|주","接|主")로 #ruby("임|명","任|命")하는 #ruby[첩|지][貼|紙]를 내려주는데, #ruby("첩|지","貼|紙") #ruby("원|형","圓|形")에 #ruby[전자체][篆字]로 새긴 #ruby("해|월|인","海|月|印")이 찍혀 있었다.]
#zh[先生的话就是动员令。来自各地待命的大接主们，顿时群情激愤，纷纷告退，潮水般地涌了出去。]
#zh[我们来自黄海道的一行也分别接受了“接主”的牒纸，上面盖有篆字刻的圆印“海月印”三字。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|생","先|生")에게 #ruby("하|직","下|直") #ruby("인|사","人|事")를 드리고 난 뒤 우리는 #ruby[속|리|산][俗|離|山]을 구경하고 #ruby("귀|로","歸|路")에 접어들었다. 돌아오는 #ruby("도|중","途|中") 곳곳에서 흰옷을 입고 칼 찬 #ruby("동|학|당","東|學|黨")을 만났다. #ruby("광|혜|원","廣|惠|院")#footnote(numbering: _ => [51)])[#h(0.35em)#ruby("충|북","忠|北") #ruby[진|천|군][鎭|川|郡] #ruby[만|승|면][萬|升|面] #ruby[광|혜|원|리][廣|惠|院|里]. #ruby[진|천|군][鎭|川|郡]의 #ruby("북|부|지|역","北|部|地|域")으로 #ruby[경|기|도][京|畿|道]와 #ruby("인|접","隣|接")한 곳이다.] #ruby("장","場")에 #ruby("도|착","到|着")하니 #ruby("수|만","數|萬")의 #ruby("동|학|군","東|學|軍")이 #ruby("진|영","陣|營")을 차리고 #ruby("행|인","行|人")들을 #ruby("검|사","檢|査")하였는데, 그곳에서 볼 만한 것은 #ruby("양|반","兩|班")으로 #ruby("평|소","平|素") #ruby("동|학|당","東|學|黨")을 #ruby("학|대","虐|待")하던 #ruby("자","者")들을 잡아와서 길가에서 짚신을 삼게 하는 것이었다.]
#zh[我们辞别了先生，游览了俗离山后踏上归途。]
#zh[各地的人们成群聚集，平民穿着白衣，佩带着军刀。我们到达广惠院场时，数万东学军在各处布岗检查行人，他们把附近两班中平时虐待东学党的人抓来，迫使他们坐在路边编草鞋。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|학|군","東|學|軍")은 우리 #ruby("일|행","一|行")의 #ruby("증|명|서","證|明|書")를 보고는 #ruby("무|사","無|事")히 #ruby("통|과","通|過")시켰다. #ruby("부|근","附|近")의 #ruby("촌|락","村|落")에서는 밥을 짐으로 지어서 #ruby("도|소","都|所")#footnote(numbering: _ => [52)])[#h(0.35em)#ruby("동|학|농|민|전|쟁","東|學|農|民|戰|爭")시 그 #ruby("지|역","地|域")의 #ruby("사|령|부","司|令|部")를 말한다.]로 보내는데 그 #ruby("수","數")를 헤아릴 수 없을 #ruby("정|도","程|度")로 많았다. 한#ruby("편","便") #ruby("동|학|당","東|學|黨")이 몰려와 #ruby("집|회","集|會")하는 것을 보고 놀라 논에서 벼를 베던 #ruby("농|군","農|軍")들이 낫을 버리고 #ruby("도|망","逃|亡")가는 것도 보았다. #ruby("경|성","京|城")을 지나는데 벌써 #ruby("경|군","京|軍")이 #ruby("삼|남|지|방","三|南|地|方")을 #ruby("향","向")하여 #ruby("행|군","行|軍")하는 것도 보았다.]
#zh[我们一行则拿出证件给他们检查后，很容易地通过了。]
#zh[一路上看见很多人从附近村落背着饭菜到“都所”①去，人群望不到头。在水田间割稻的农民看到东学军像潮水般地涌来，相继丢弃镰刀逃走。我们到了汉城时，与开向三南的京军②相遇。九月才回到海州。]
#zh[译注：即司令部。]
#zh[译注：“三南”指忠清道、全罗道、庆尚道。“京军”即卫戍首都的军队。]
#heading(level: 3)[#text(font: "KOPUSGo B")[3) #ruby("팔|봉","八|峯") #ruby("접|주","接|主")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[갑|오|년][甲|午|年]\(1894) 9#ruby("월","月")#ruby("경","頃")#footnote(numbering: _ => [53)])[#h(0.35em)#ruby("원|문","原|文"): “同年 九月”. #ruby("동|년","同|年")의 #ruby("연|기","年|紀")를 #ruby("추|적","追|跡")하면 #ruby[백|범][白|凡]이 #ruby("충|청|도","忠|淸|道")로 떠난 翌 癸巳年（‘다음해 #ruby[계|사|년][癸|巳|年]’）이 되는데, 이것은 ‘다음해 #ruby[갑|오|년][甲|午|年]’의 #ruby("착|오","錯|誤")라고 #ruby("지|적","指|摘")한 바 있다. 따라서 여기서 #ruby("동|년","同|年")도 #ruby[갑|오|년][甲|午|年]\(1894)으로 보는 것이 #ruby("타|당","妥|當")하며, #ruby("본|문","本|文")의 #ruby("내|용","內|容")에도 맞다. #ruby[백|범][白|凡]이 #ruby("충|청|도","忠|淸|道")에서 #ruby("귀|향","歸|鄕")한 것은 1894#ruby("년","年") 9#ruby("월","月")인 것이 #ruby("확|실","確|實")하다.] 우리는 #ruby("고|향","故|鄕")으로 돌아왔다. #ruby("황|해|도","黃|海|道")에도 #ruby("양|반","兩|班")과 #ruby("관|리","官|吏")의 #ruby("압|박","壓|迫")이 있는데다 #ruby("삼|남","三|南")에서 #ruby("향|응","響|應")하라는 #ruby("경|통","敬|通")이 잇따라 #ruby("도|착","到|着")하여, 우리 15#ruby("인","人") #ruby("접|주","接|主")를 #ruby("위|시","爲|始")하여 #ruby("회|의","會|議")한 #ruby("결|과","結|果") #ruby("거|사","擧|事")하기로 #ruby("결|정","決|定")하였다. 맨 처음 #ruby("총|집|결","總|集|結") #ruby("장|소","場|所")로는 #ruby[포|동][浦|洞] #ruby("부|근","附|近") #ruby("시|장","市|場")인 #ruby("죽|천|장","竹|川|場")으로 #ruby("정","定")하고 #ruby("각|지","各|地")에 #ruby("경|통","敬|通")을 보냈다. 나는 #ruby("팔|봉|산","八|峯|山") 아래 산다고 해서 #ruby("팔|봉","八|峯")이란 #ruby("접|명","接|名")을 짓고, 푸른 #ruby("비|단","緋|緞")에 ‘#ruby("팔|봉|도|소","八|峯|都|所")’ 넉 #ruby("자","字")를 크게 쓰고, #ruby("표|어","標|語")로는 ‘#ruby("척|왜|척|양","斥|倭|斥|洋")’ 넉 #ruby("자","字")를 써서 높이 걸었다.]
#zh[黄海道的东学党们也正在跃跃欲动。由于平日受到两班与官吏的欺压太甚，民不聊生，立即响应三南东学的《敬通》（公函）。于是十五个“接主”与诸头领商议的结果决定举事，以海州竹川场浦洞附近的市场为总集合地，对各处道人发出“敬通”。]
#zh[我住在八峰山下，就以八峰为名，在青纱上写了“八峰都所”四个大字，又高悬“斥洋斥倭”标语。为了准备与汉城来的京军和倭兵作战，召集“连臂”中备有枪械的壮丁们，编组军队。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리는 #ruby("회|의","會|議") #ruby("결|과","結|果") 곧바로 #ruby("거|사","擧|事")하면 #ruby("경|군","京|軍")과 #ruby("왜|병","倭|兵")이 와서 #ruby("접|전","接|戰")이 될 터이니, #ruby("동|학","東|學") #ruby("연|비","連|臂") #ruby("중","中") #ruby("무|기","武|器") 가진 #ruby("자","者")를 모아 #ruby("우|선","優|先") #ruby("군|대","軍|隊")를 #ruby("편|성","編|成")하기로 하였다. 나는 #ruby("본|래","本|來") #ruby("산","山")골 #ruby("출|신","出|身")인데다 #ruby("상","常")놈이기 때문에 나의 #ruby("연|비","連|臂")에는 #ruby("산|포|수","山|砲|手")가 가장 많았다. 사람들은 #ruby("인|근","隣|近") #ruby("부|잣","富|者")집에서 #ruby("약|간","若|干")의 #ruby("호|신|용","護|身|用") #ruby("무|기","武|器")를 거두어 오기는 하지만 #ruby("무|기","武|器")는 #ruby("대|부|분","大|部|分") #ruby("산|포|수","山|砲|手")들이 #ruby("자|신","自|身")의 #ruby("총|기","銃|器")를 가져온 것이었다. #ruby("부|대","部|隊")를 #ruby("편|성","編|成")하니 나의 #ruby("접","接")에는 #ruby("총","銃") 가진 #ruby("군|인","軍|人")이 700#ruby("여","餘") #ruby("명","名")으로 다른 어느 #ruby("접","接")보다 #ruby("우|세","優|勢")한 #ruby("무|력","武|力")을 #ruby("확|보","確|保")하였다.]
#zh[由于我本是在山地生长，又是平民，所以我们这个接的同志中有很多打猎的“连臂”，除了将邻近富户家藏的若干自卫用武器搜集来以外，大部分都是猎户自己带来的猎枪，总计配有枪械武器的共有七百多人，声势浩大，举事之初比任何“接主”的实力都强。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("최|고|회|의","最|高|會|議")에서는 #ruby("황|해|도","黃|海|道")의 #ruby("수|부","首|府")인 #ruby("해|주|성","海|州|城")을 먼저 #ruby("함|락","陷|落")하고 #ruby("탐|관|오|리","貪|官|汚|吏")와 #ruby("왜","倭")놈을 다 잡아 죽이기로 #ruby("결|정","決|定")하고, #ruby("팔|봉","八|峯") #ruby("접|주","接|主") #ruby[김|창|수][金|昌|洙]를 #ruby("선|봉","先|鋒")으로 #ruby("임|명","任|命")하였다. 나를 #ruby("선|봉","先|鋒")으로 #ruby("임|명","任|命")한 것은 비록 나이 어리지만 #ruby("평|소","平|素")에 #ruby("병|법","武|學")을 #ruby("연|구","硏|究")하였고, 또한 나의 #ruby("접","接")이 #ruby("산|포|수","山|砲|手")로 잘 #ruby("무|장","武|裝")되어 있다는 것 때문이었다. 그러나 그러한 #ruby("결|정","決|定")의 #ruby("이|면","裏|面")에는 #ruby("자|신","自|身")들이 #ruby("총","銃")알받이가 되기 싫다는 #ruby("이|유","理|由")도 있었다.]
#zh[讨伐行动按照先前最高会议中所拟定的战略，决定首先夺取黄海道首府海州城。打倒贪官污吏和日本鬼子，大家推选我八峰接主金昌洙为先锋将。因我虽年幼，平日阅读兵书，颇晓用兵之道，加之我部队中拥有很多射击精良的猎户，但实际上也有别的头领不愿打头阵首当其冲的缘故。我虽然知道他们的用意，但仍然乐于被选为先锋，请其他部队跟在我的部队后面前进。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("최|고|회|의","最|高|會|議")의 #ruby("결|정","決|定")을 #ruby("승|낙","承|諾")하였다. #ruby("즉|시","卽|時")로 #ruby("출|동","出|動")하여 #ruby("전|군","全|軍")을 #ruby("후|방","後|方")에 따르도록 하고 나는 #ruby("선|두","先|頭")에서 말을 타고 #ruby("선|봉","先|鋒")이라는 #ruby("사|령|기","司|令|旗")를 잡고 #ruby("해|주|성","海|州|城")으로 달려갔다. #ruby("해|주|성","海|州|城") #ruby("서|문","西|門") 밖 #ruby("선|녀|산","仙|女|山") 위에 #ruby("진","陣")을 친 #ruby("후","後") #ruby("총|사|령|부","總|司|令|部")는 #ruby("총|공|격|령","總|攻|擊|令")을 내리면서 #ruby("선|봉","先|鋒")인 나에게 #ruby("작|전|계|획","作|戰|計|劃")을 맡겼다. 나는 다음과 같은 #ruby("계|획","計|劃")을 #ruby("제|시","提|示")하였다.]
#zh[我答应了最高会议的决定，立即出动，令全军跟在后面，我自己骑着马走在前头，手执“先锋”司令旗，向海州城奔去。在海州城西门外仙女山上扎营之后，总司令部下达总攻击令，把作战计划交给我这先锋。我提出如下计划：]
#quote-block[지금 #ruby("성|내","城|內")에 아직 #ruby("경|군","京|軍")은 #ruby("도|착","到|着")하지 못하였고 #ruby("오|합|지|졸","烏|合|之|卒")로 #ruby("편|성","編|成")한 #ruby("수|성|군","守|城|軍") 200#ruby("여","餘") #ruby("명","名")과 #ruby("왜|병","倭|兵") 7#ruby("명","名")이 있다. 먼저 #ruby("선|발|대","先|發|隊")가 #ruby("남|문","南|門")으로 #ruby("진|공","進|攻")하면, 내 #ruby("지|휘|하","指|揮|下")의 #ruby("선|봉|부|대","先|鋒|部|隊")는 #ruby("최|대","最|大")의 #ruby("속|력","速|力")으로 #ruby("서|문","西|門")을 #ruby("공|격","攻|擊")하여 #ruby("함|락","陷|落")할 것이다. #ruby("총|사|령|부","總|司|令|部")에서는 #ruby("정|황","情|況")을 보고 #ruby("아|군","我|軍")이 #ruby("허|약","虛|弱")한 곳을 #ruby("응|원","應|援")한다.]
#zh[如今城内京军尚未到达，只有乌合之众编成的守城军两百余名，倭兵七名。先由先遣队向南门进攻，我指挥下的先锋部队就以最大速度攻击西门，将其攻陷。总司令部视情况，支援我军薄弱之处。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("계|획","計|劃")은 받아들여졌다. 그런데 #ruby("작|전","作|戰")을 #ruby("개|시","開|始")할 무렵 #ruby("왜|병","倭|兵")들이 #ruby("성","城") 위에 올라가 #ruby("공|포","空|砲") 네댓 #ruby("방","放")을 쏘았다. #ruby("남|문","南|門")으로 #ruby("향","向")하던 #ruby("선|발|대","先|發|隊")는 이 #ruby("총","銃")소리에 놀라 #ruby("도|주","逃|走")하기 #ruby("시|작","始|作")했고, #ruby("왜|병","倭|兵")은 #ruby("남|문","南|門") 밖으로 나와 #ruby("도|주","逃|走")하는 #ruby("군|중","群|衆")을 #ruby("향","向")하여 #ruby("연|발","連|發")로 #ruby("총","銃")을 쏘았다.]
#zh[我把这一作战计划向总部报告，总部采纳了我的计划，派出一支部队进攻南门。不料正在这个时候，几名倭兵爬上城头放了五六枪，向南门进攻的先遣部队立即四散逃亡。]
#zh[倭兵见了这般光景，出了南门，向逃亡的士兵开始猛烈地射击。我正在指挥全军向西门展开猛烈的攻击时，突然从总部下来了退却的命令，我先锋队尚未掉头退却前，只见前后左右的军士们纷纷向山野逃亡。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("전|군","全|軍")을 #ruby("지|휘","指|揮")하며 #ruby("선|봉|대","先|鋒|隊")를 이끌고 #ruby("서|문","西|門") 아래 #ruby("도|착","到|着")하여 #ruby("맹|렬","猛|烈")하게 #ruby("공|격","攻|擊")하였다. 그런데 갑자기 #ruby("총|사|령|부","總|司|令|部")에서 #ruby("퇴|각","退|却")을 #ruby("명|령","命|令")하였다. #ruby("선|봉|대","先|鋒|隊")가 #ruby("퇴|각","退|却")을 #ruby("위","爲")해 머리도 돌리기 #ruby("전","前")에 #ruby("사|령|부","司|令|部") #ruby("병|사","兵|士")들은 #ruby("산","山")과 들로 #ruby("도|망","逃|亡")갔다. 내가 #ruby("퇴|각","退|却")하는 #ruby("원|인","原|因")을 물으니 #ruby[도|유][道|儒] 서너 #ruby("명","名")이 #ruby("남|문","南|門") 밖에서 #ruby("총","銃")에 맞아 죽었기 때문이라 한다. 그러니 #ruby("선|봉|군","先|鋒|軍")도 #ruby("퇴|각","退|却")하지 않을 수 없었다. 그래도 우리 #ruby("접","接")은 #ruby("비|교|적","比|較|的") #ruby("정|연","整|然")하게 #ruby("퇴|각","退|却")하였다. 나는 #ruby("해|주","海|州") #ruby("서","西")쪽 80#ruby("리","里") #ruby("후|방","後|方")인 #ruby("회|학|동","回|鶴|洞") #ruby("곽|감|역","郭|監|役")#footnote(numbering: _ => [54)])[#h(0.35em)#ruby[감|역][監|役]은 #ruby[감|역|관][監|役|官]의 준말. #ruby[선|공|감][繕|工|監]에 둔 #ruby("종","從")9#ruby("품","品")의 벼슬로 #ruby("건|축","建|築")에 #ruby("관","關")한 #ruby("사|무","事|務")를 #ruby("관|장","管|掌")한다.] #ruby("가","家")에 #ruby("집|결","集|結")하기로 하고 #ruby("선|발|대","先|發|隊")를 #ruby("파|견","派|遣")하였다. 마지막으로 내가 #ruby("군|사","軍|士")들을 #ruby("수|습","收|拾")하여 #ruby("회|학|동","回|鶴|洞")에 #ruby("도|착","到|着")하니 우리 #ruby("접","接")의 #ruby("무|장|군|인","武|裝|軍|人")들은 흩어지지 않고 모두 모였다. 나는 #ruby("일|단","一|旦") #ruby("병|사","兵|士")들을 #ruby("정|돈","整|頓")시키고 난 뒤 이번 #ruby("실|패","失|敗")에 #ruby("분|개","憤|慨")하여 #ruby("군|대","軍|隊") #ruby("훈|련","訓|鍊")에 #ruby("주|력","注|力")하기로 하여, #ruby("동|학|교|도","東|學|敎|徒") #ruby("여|부","與|否")를 가리지 않고 #ruby("각","各") #ruby("지|방","地|方")에 #ruby("장|교","將|校")의 #ruby("경|력","經|歷")이 있는 #ruby("자","者")를 #ruby("정|중","鄭|重")하게 모셔와 #ruby("병|사","兵|士")들에게 #ruby("총|술","銃|術")·#ruby("행|군","行|軍")·#ruby("체|조","體|操") #ruby("등","等")을 #ruby("교|련","敎|鍊")시켰다.]
#zh[我问了下退却令的原因，说是南门外有三四个道儒中弹阵亡，大军就因此溃散。]
#zh[这样一来，先锋队无法单独固守，因此决定有秩序地退却到离海州以西八十多里的回鹤洞郭监役宅驻扎，并集合随后而来的退兵。所幸武装军士们没有失散，又都集合起来进行整顿。]
#zh[这一次的失败使我很激愤，下决心要训练精良的军队。无论是不是东学道儒，只要是有经验的军官就聘请为训练部队的教官，开始操练步法做体操，射击术更不在话下。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러던 어느날 어떤 사람이 #ruby("면|회","面|會")를 #ruby("요|청","要|請")하였다. 그들은 #ruby("문|화","文|化") #ruby("구|월|산","九|月|山") 아래 사는 #ruby("정|덕|현","鄭|德|鉉")과 #ruby("우|종|서","禹|鍾|瑞")라 했다. 나이는 나보다 열 살 남짓 많아 보이는데 보고 아는 것이 많은 #ruby("식|견","識|見") 있는 사람이었다. 내가 찾아온 #ruby("이|유","理|由")를 묻자, 그들은 #ruby("태|연","泰|然")하게]
#zh[有一天，有两个人来请求面见。他们是住在文化九月山下的郑德铉和禹钟瑞，年纪看来比我大十多岁，是见多识广的人。我问他们的来意，他们泰然说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|학|군","東|學|軍")이란 한 놈도 쓸 만한 것이 없는데 그대가 좀 낫다는 말을 듣고 한#ruby("번","番") 보고 싶어 왔노라.”]
#zh[“东学军没有一个是顶用的，听说你稍好一点，特地来看看。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("대|답","對|答")하였다. 그러자 같이 앉아 있던 나의 #ruby("연|비","連|臂")들로부터 ‘#ruby("동|학","東|學")을 #ruby("비|방","誹|謗")하는 #ruby("자","者")’니 ‘#ruby("무|례","無|禮")한 #ruby("자","者")’니 하는 온갖 #ruby("비|난","非|難")이 일어났다. 나는 크게 #ruby("화","火")를 내며]
#zh[他们这样回答。一同坐着的连臂们纷纷责难，有的说是诽谤东学的人，有的说是无礼的人。我大怒，呵斥道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“손님과 #ruby("면|담","面|談")하는데 이렇게 #ruby("무|례","無|禮")한 것은 나를 돕는 것이 아니라 #ruby("멸|시","蔑|視")하는 것이다.”]
#zh[“宾客和我面谈，你们如此无礼，这不是帮助我，而是蔑视我！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 꾸짖고, 좀 나가 달라고 #ruby("요|청","要|請")하여 우리 세 사람만 #ruby("회|담","會|談")하게 되었다. 나는 #ruby("공|손","恭|遜")히]
#zh[我这样喝斥，请他们出去，只剩我们三人对坐。我恭顺地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")들이 이와 같이 먼 길을 오신 것은 저에게 좋은 #ruby("방|책","方|策")을 가르쳐 주고자 하심이 아닙니까?”]
#zh[“两位先生如此远道而来，不是要教我一个好办法吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 물었다. #ruby("정|씨","鄭|氏")는 #ruby("설|혹","設|或") #ruby("대|책","對|策")을 말해도 #ruby("실|행","實|行")할 #ruby("자|격","資|格")이 있는지 #ruby("의|문","疑|問")이라며]
#zh[我问道。姓郑的怀疑，即便说出对策，我也未必有实行的资格，便说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“요새 #ruby("동|학|군","東|學|軍") #ruby("접|주","接|主")라는 #ruby("자","者")들이 #ruby("호|기|충|천","豪|氣|衝|天")해서 #ruby("선|배","先|輩")를 #ruby("무|시","無|視")하는 판#ruby("국","局")에, #ruby("군","君")도 #ruby("동|학","東|學") #ruby("접|주","接|主") 아닌가?”]
#zh[“如今那些号称东学军接主的人，意气冲天，无视先辈，你不也是东学接主吗？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("반|문","反|問")하였다. 나는 더욱 #ruby("공|손","恭|遜")히 하여]
#zh[他反问道。我更加恭顺地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“먼저 가르쳐 주신 #ruby("후","後") 제가 #ruby("실|천","實|踐")하는 것을 보신 다음에, 다른 #ruby("접|주","接|主")와 마찬가지인지 아닌지 #ruby("판|단","判|斷")하시는 것은 어떻습니까?”]
#zh[“请先指教，等看过我实行之后，再判断我和别的接主是不是一样，如何？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("제|안","提|案")하였다. 이 말에 #ruby("정|씨","鄭|氏")는 #ruby("흔|쾌","欣|快")히 #ruby("악|수","握|手")하고 다음의 #ruby("방|책","方|策")을 말하였다.]
#zh[我这样提议。郑氏听了这话，欣然握着我的手，说出下面的方策：]
#para(first: 1em, rest: 2em, size: 0.9em)[#text(font: "KOPUSMj M")[1\.] #ruby("군|기|정|숙","軍|紀|正|肅"): #ruby("병|졸","兵|卒")에게 서로 절하거나 #ruby("경|어","敬|語") 쓰는 것을 #ruby("폐|지","廢|止")할 것.#footnote(numbering: _ => [55)])[#h(0.35em)#ruby("원|본","原|本")에 ‘#ruby("폐|지","廢|止")’가 #ruby("초|서","草|書")로 씌어 있어, #ruby("출|간|본","出|刊|本")의 #ruby("경|우","境|遇") ‘절하고 #ruby("경|어","敬|語")를 쓸 것’으로 #ruby("반|대","反|對")로 #ruby("해|석","解|釋")한 것이 많다. 이것은 ‘#ruby("농|민|적","農|民|的") #ruby("평|등|주|의","平|等|主|義")’ 때문에 #ruby("동|학|군","東|學|軍")의 #ruby("군|기","軍|紀")가 #ruby("문|란","紊|亂")해진 것을 보고 #ruby("수|습|책","收|拾|策")으로 #ruby("상|하","上|下")의 #ruby("엄|격","嚴|格")한 #ruby("질|서","秩|序")를 #ruby("강|조","强|調")한 #ruby("중|요","重|要")한 #ruby("구|절","句|節")이다.]]
#zh[一、整肃军纪：对兵卒不可对拜，不用敬语。]
#para(first: 1em, rest: 2em, size: 0.9em)[#text(font: "KOPUSMj M")[2\.] #ruby("민|심","民|心")을 얻을 것: #ruby("동|학|당","東|學|黨")이 #ruby("총","銃")을 가지고 마을을 다니면서 #ruby("곡|식","穀|食")이나 돈을 빼앗는 #ruby("강|도|적","强|盜|的") #ruby("행|위","行|爲")를 #ruby("금|지","禁|止")할 것.]
#zh[二、争取民心：必须严禁东学军携械私入民家强索钱财粮食等行为。]
#para(first: 1em, rest: 2em, size: 0.9em)[#text(font: "KOPUSMj M")[3\.] #ruby("현|자","賢|者")를 #ruby("초|빙","招|聘")하는 글을 #ruby("발|포","發|布")하여 #ruby("경|륜","經|綸") 있는 #ruby("인|사","人|士")를 #ruby("다|수","多|數") #ruby("구","求")할 것.]
#zh[三、招贤纳士：四处张贴求贤文告，广纳贤士。]
#para(first: 1em, rest: 2em, size: 0.9em)[#text(font: "KOPUSMj M")[4\.] #ruby("전|군","全|軍")을 #ruby("구|월|산","九|月|山") 안에 모아 #ruby("군|사","軍|事") #ruby("훈|련","訓|鍊")을 #ruby("실|시","實|施")할 것.]
#zh[四、全军驻屯于九月山施以严格训练。]
#para(first: 1em, rest: 2em, size: 0.9em)[#text(font: "KOPUSMj M")[5\.] #ruby("재|령","載|寧")·#ruby("신|천","信|川") 두 #ruby("군","郡")에 #ruby("왜","倭")놈이 #ruby("무|미","貿|米") #ruby("수|천","數|千") #ruby("석","石")을 쌓아두었으니, 그것을 #ruby("몰|수","沒|收")하여 #ruby("패|엽|사","貝|葉|寺")로 옮겨 #ruby("양|식","糧|食")에 #ruby("충|당","充|當")할 것.]
#zh[五、没收日本人储藏在载宁、信川两郡的大米数千石，运至九月山的贝叶寺以充军粮。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 매우 기뻐하며 다섯 #ruby("방|책","方|策")을 모두 #ruby("시|행","施|行")하기로 #ruby("결|정","決|定")하였다. 곧바로 #ruby("전|군","全|軍")을 #ruby("소|집","召|集")하여 #ruby("정|씨","鄭|氏")를 #ruby("모|주","謀|主"), #ruby("우|씨","禹|氏")를 #ruby("종|사","從|事")라 #ruby("선|언","宣|言")하고 두 분에게 #ruby("최|고","最|高")의 #ruby("예","禮")를 #ruby("표|시","表|示")하게 했다. 이어서 #ruby("간|단","簡|單")한 #ruby("군|령","軍|令") 몇 #ruby("조","條")를 #ruby("공|포","公|布")하고 #ruby("위|반|자","違|反|者")에게는 #ruby[태][笞]·#ruby[곤][棍]으로 다스리게 하고, #ruby("전|군","全|軍")을 #ruby("구|월|산","九|月|山")으로 옮길 #ruby("준|비","準|備")를 하였다.]
#zh[我听后大喜，立即决定实施这个计划，马上集合全军于大操场，宣布郑氏为“谋主”，禹氏为“从事”，且指挥全军向他们两位行最敬礼。我请从事宣布了几条简易的军令，申明对违令者将施以笞刑杖刑。正积极准备向九月山迁移时，一天夜晚从安进士处派来了一位密使。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러던 어느날 밤 #ruby("신|천","信|川")의 #ruby("안|진|사","安|進|士")로부터 #ruby("밀|사","密|使")가 왔다. #ruby("안|진|사","安|進|士") #ruby("태|훈","泰|勳")은 #ruby("회|학|동","回|鶴|洞")에서 #ruby("동","東")으로 20#ruby("리","里") #ruby("천|봉|산","千|峯|山")이란 큰 #ruby("산","山") 너머에 있는 #ruby("신|천|군","信|川|郡") #ruby("청|계|동","淸|溪|洞")에 살고 있었다. 그는 #ruby("문|장","文|章")과 글씨는 #ruby("물|론","勿|論") #ruby("지|략","智|略")까지 #ruby("겸|비","兼|備")하여, #ruby("명|성","名|聲")이 #ruby("해|서|지|방","海|西|地|方")은 #ruby("물|론","勿|論") #ruby("전|국","全|國")에 널리 알려져 #ruby("조|정","朝|廷") #ruby("대|신","大|臣")들도 크게 #ruby("대|접","待|接")하는 이였다.]
#zh[安进士名泰勋，住在距回鹤洞以东二十四里千峰山那边的信川郡清溪洞，他以文章书法闻名于海西、汉城，智略兼备，颇具胆识，甚至当时朝廷的大官也对他优礼有加。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 그는 #ruby("동|학","東|學")이 #ruby("궐|기","蹶|起")하는 것을 보고 이를 #ruby("토|벌","討|伐")하기 #ruby("위","爲")하여 #ruby("동|생","同|生")과 아들로 #ruby("병|사","兵|士")를 #ruby("담|당","擔|當")케 하고 300#ruby("여","餘") #ruby("명","名")의 #ruby("산|포|수","山|砲|手")를 #ruby("모|집","募|集")하여 #ruby("청|계|동","淸|溪|洞") #ruby("자|택","自|宅")에 #ruby("의|려|소","義|旅|所")를 세우고, #ruby("경|성","京|城") #ruby("모","某") #ruby("대|신","大|臣")의 #ruby("원|조","援|助")와 #ruby("황|해","黃|海") #ruby("감|사","監|司")의 #ruby("지|도","指|導") 아래 벌써 #ruby("동|학","東|學") #ruby("토|벌","討|伐")에 나서 #ruby("신|천|지|역","信|川|地|域")의 #ruby("동|학","東|學") #ruby("토|벌","討|伐")에 좋은 #ruby("성|적","成|績")을 거두고 있었다.#footnote(numbering: _ => [56)])[#h(0.35em)#ruby[안|태|훈][安|泰|勳]은 #ruby("동|학","東|學")에 맞서 #ruby("격|문","檄|文")을 뿌리고 #ruby("의|병","義|兵")을 일으키고 #ruby("산|포|수","山|砲|手")를 불러모으는 한편 아들과 #ruby("처|자","妻|子")들까지 #ruby("행|렬","行|列")에 #ruby("편|입","編|入")시켰다. #ruby[안|중|근][安|重|根]은 처음 #ruby("소|집","召|集")된 #ruby("병|력","兵|力")이 70#ruby("여","餘") #ruby("명","名")의 #ruby("소|규|모","小|規|模")라고 밝히고 있으나, #ruby[백|범][白|凡]과 비슷한 #ruby("시|기","時|期")에 #ruby[안|태|훈][安|泰|勳]을 찾게 되는 #ruby[김|형|진][金|亨|鎭]은 #ruby("의|병","義|兵") #ruby("총|수","總|數")를 ‘#ruby("수|천","數|千") #ruby("명","名")’이라고 #ruby("언|급","言|及")하고 있다. #ruby("군|대","軍|隊")의 #ruby("규|모","規|模")는 #ruby("시|기|별","時|期|別")로 #ruby("차|이","差|異")가 있었을 것이다. #ruby[안|태|훈][安|泰|勳] #ruby("부|대","部|隊")는 1894#ruby("년","年") 12#ruby("월","月") #ruby[안|중|근][安|重|根] #ruby("등","等")의 #ruby("활|약","活|躍")으로 #ruby("동|학","東|學") #ruby("접|주","接|主") #ruby[원|용|일][元|容|日] #ruby("부|대","部|隊") 2,000#ruby("여","餘") #ruby("명","名")을 #ruby("대|파","大|破")한 적이 있다. #ruby[안|태|훈][安|泰|勳]은 #ruby("당|시","當|時") #ruby("갑|오|정|권","甲|午|政|權") #ruby[김|홍|집][金|弘|集]#ruby("내|각","內|閣")에 #ruby("참|여","參|與")한 #ruby[김|종|한][金|宗|漢]과 가까운 사이였다.] 때문에 #ruby("동|학","東|學") #ruby("각","各") #ruby("접","接")은 #ruby[안|태|훈][安|泰|勳]을 두려워하고 있었고, 우리 #ruby("접","接")도 #ruby("청|계|동","淸|溪|洞")을 #ruby("경|비","警|備")하였던 터였다.]
#zh[东学之乱一起，安进士就为了讨伐东学军，在他的故里清溪洞自宅设立“义旅所”，让他的子弟们都当了兵，又招募枪手三百人，在京城大官的援助和黄海监史的指导下，声讨信川境内的东学党颇有成绩，所以各接主对他都感到恐惧而保持戒备。我们也对清溪洞严加戒备，不敢稍有懈怠。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러한 #ruby[안|태|훈][安|泰|勳]이 우리에게 #ruby("밀|사","密|使")를 보내온 것이다. #ruby("정|씨","鄭|氏") #ruby("등","等")이 #ruby("밀|사","密|使")를 만나 본 #ruby("결|과","結|果") #ruby("안|진|사","安|進|士")는 #ruby("비|밀|리","祕|密|裡")에 나를 #ruby("조|사","調|査")하고 난 뒤, “#ruby("군","君")이 나이 어리지만 #ruby("대|담","大|膽")한 #ruby("인|품","人|品")을 지닌 것을 사랑하여 #ruby("토|벌","討|伐")하지 않을 터이지만, #ruby("군","君")이 #ruby("만|일","萬|一") #ruby("청|계","淸|溪")를 #ruby("침|범","侵|犯")하다가 #ruby("패|멸","敗|滅")#ruby("당","當")하게 되면 #ruby("인|재","人|材")가 아깝다”는 #ruby("후|의","厚|意")에서 #ruby("밀|사","密|使")를 보냈다고 한다. 나는 #ruby("즉|시","卽|時") #ruby("참|모|회|의","參|謀|會|議")를 열고 #ruby("논|의","論|議")한 #ruby("결|과","結|果") ‘나를 치지 않으면 나도 치지 않는다’, ‘어느 한쪽이 #ruby("불|행","不|幸")에 빠지면 서로 돕는다’는 #ruby("밀|약","密|約")이 #ruby("성|립","成|立")되었다.#footnote(numbering: _ => [57)])[#h(0.35em)앞#ruby("부|분","部|分")은 #ruby("불|가|침|협|정","不|可|侵|協|定")이라 할 수 있고, 뒷#ruby("부|분","部|分")은 #ruby("공|동|원|조|계|획","共|同|援|助|計|劃")이다. #ruby("동|학","東|學")과 #ruby("토|벌|군","討|伐|軍")이 이러한 #ruby("공|수|동|맹","攻|守|同|盟")을 맺은 것은 재미있는 #ruby("사|실","事|實")이다.]]
#zh[我派郑谋主与密使会晤，据他报告，安进士曾秘密调查，得知我年少胆大，颇器重我的人品，将不派兵讨伐。但我军基地回鹤洞，与安进士的清溪洞，两地相距仅二十里，且拥有重兵，万一我攻击清溪洞失败的话，那么我的声誉即将毁于一旦，甚至生命难保，也将丧失一个有才干的人，所以安进士是为我着想才派来密使。我立即召开参谋会议共商对策，决定与安进士订立密约，双方互不侵犯，如有任何一方陷于困境时，对方立即驰援。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리는 이미 #ruby("정","定")한 #ruby("방|침","方|針")대로 #ruby("구|월|산","九|月|山") #ruby("패|엽|사","貝|葉|寺")로 #ruby("군|대","軍|隊")를 옮겼다. #ruby("패|엽|사","貝|葉|寺")에 #ruby("본|영","本|營")을 두고 #ruby("동","洞") 어귀에 #ruby("파|수|막","把|守|幕")을 지어 #ruby("군|인","軍|人")의 #ruby("산","山") 밖 #ruby("출|입","出|入")을 #ruby("엄|금","嚴|禁")하였다. 우리는 #ruby("신|천|군","信|川|郡")에 #ruby("왜","倭")놈들이 #ruby("비|치","備|置")한 #ruby("백|미","白|米") #ruby("천|여","千|餘") #ruby("석","石")을 #ruby("몰|수","沒|收")하여, #ruby("산","山") 아래 마을에 “#ruby("백|미","白|米") #ruby("일","一") #ruby("석","石")을 #ruby("패|엽|사","貝|葉|寺")까지 #ruby("운|반","運|搬")하는 #ruby("자","者")는 #ruby("백|미","白|米") 세 #ruby[말][三斗]을 준다”고 #ruby("훈|령","訓|令")하여 #ruby("운|반","運|搬")하는 #ruby("비|용","費|用")을 #ruby("후","厚")하게 쳐 주었더니 하루 만에 모두 #ruby("패|엽|사","貝|葉|寺")로 옮길 수 있었다. 나는 #ruby("각","各") 동네에 “#ruby("동|학|당","東|學|黨")을 #ruby("빙|자","憑|藉")하면서 #ruby("금|전","金|錢")을 #ruby("강|제","强|制")로 빼앗거나 #ruby("행|패","行|悖")하는 #ruby("자","者")가 있으면 #ruby("즉|각","卽|刻") #ruby("보|고","報|告")하라”고 #ruby("훈|령","訓|令")을 보내고, #ruby("고|발","告|發")되는 대로 #ruby("체|포","逮|捕")하여 #ruby("무|기","武|器") 있는 #ruby("자","者")는 #ruby("무|기","武|器")를 빼앗고 #ruby("곤|장","棍|杖")·#ruby("태|장","笞|杖")으로 다스리고, 맨손으로 #ruby("행|패","行|悖")를 부리는 #ruby("자","者")도 #ruby("엄","嚴")히 다스렸다. 그러자 #ruby("사|방","四|方")이 #ruby("평|안","平|安")해지고 #ruby("민|심","民|心")이 #ruby("안|정","安|定")되었다.]
#zh[按预定计划，我的军队向九月山贝叶寺集结，并以后寺为本营，村口设了门岗，严禁军人下山外出。还没收了倭寇堆存在信川的白米千余石，下令给山下各户，凡搬运白米一石至贝叶寺者，奖以白米三斗，于是白米在当天就搬运到寺内。我们每天集中进行军事训练、实弹演习，操练战术。又通告各村凡有自称为东学党人而有扰民行为、横征暴敛者，应立即告发，以便收缴其枪械，将其扣押，施以笞刑杖刑，严加惩罚。结果没有几天就很快地恢复了秩序，老百姓也安定下来。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 날마다 #ruby("군|인","軍|人")들에게 #ruby("실|탄","實|彈") #ruby("연|습","練|習")과 #ruby("전|술","戰|術")을 배우게 하는 한#ruby("편","便"), #ruby("현|인","賢|人")을 #ruby("초|빙","招|聘")하는 글을 #ruby("발|포","發|布")하고 또 #ruby("구|월|산","九|月|山") #ruby("주|위","周|圍")에 #ruby("지|혜","智|慧") 있다는 #ruby("인|사","人|士")를 #ruby("조|사","調|査")하여 혼자 #ruby("직|접","直|接") 걸어서 #ruby("방|문","訪|問")하기도 하였다. 그러던 #ruby("중","中") #ruby("신|천|군","信|川|郡") #ruby("월|정|동","月|精|洞")의 #ruby("송|종|호","宋|宗|鎬")를 스승으로 삼고 사람과 말을 보내어 #ruby("산|사","山|寺")에 모셔와 #ruby("자|문","咨|問")을 받았다. #ruby("송|씨","宋|氏")는 일찍이 #ruby("상|해","上|海") #ruby("등|지","等|地")에 다녀와 #ruby("해|외","海|外") #ruby("사|정","事|情")에도 #ruby("정|통","精|通")하고 사람됨이 #ruby("걸|출","傑|出")하여 #ruby("영|웅","英|雄")의 #ruby("기|풍","氣|風")이 있었다. 또한 #ruby("풍|천|군","豐|川|郡")에서는 #ruby("허|곤","許|坤")이란 #ruby("명|사","名|士")가 찾아와 #ruby("합|류","合|流")하였다. #ruby("허|씨","許|氏")는 #ruby("문|필","文|筆")이 뛰어나고 #ruby("시|무","時|務")에 밝은 사람이었다. 또한 #ruby("패|엽|사","貝|葉|寺")에는 #ruby("도|승","道|僧")으로 #ruby("명|성","名|聲")이 #ruby("자|자","藉|藉")한 #ruby("하|은|당","荷|隱|堂")이란 스님이 #ruby("주|지","住|持")였는데,#footnote(numbering: _ => [58)])[#h(0.35em)1898#ruby("년","年") #ruby[백|범][白|凡]은 #ruby("탈|옥","脫|獄") #ruby("후","後") #ruby("남|부|지|방","南|部|地|方")을 #ruby("전|전","轉|轉")하다, #ruby[공|주][公|州] #ruby[마|곡|사][麻|谷|寺]에서 #ruby("백|발|노|승","白|髮|老|僧") #ruby("하|은|당","荷|隱|堂")과 처음 만나 #ruby("면|담","面|談")한 #ruby("후","後") 하룻밤 사이에 스님이 되기로 #ruby("결|심","決|心")한다(152〜153쪽). #ruby[마|곡|사][麻|谷|寺]의 #ruby("하|은|당","荷|隱|堂")과 #ruby("법|명","法|名")이 #ruby("동|일","同|一")한 것이 #ruby("기|묘","奇|妙")하지만, 『#ruby[신|천|군|지][信|川|郡|誌]』에 #ruby("의","依")하면 #ruby("하|은|대|사","荷|隱|大|師")라는 분이 #ruby("패|엽|사","貝|葉|寺")를 #ruby("중|창","重|創")하고 #ruby[한|산|사][寒|山|寺]로 이름을 고쳤다고 한다.(#ruby[배|경|식][裵|景|植], 2008, 85쪽)] 그 #ruby("제|자","弟|子")와 #ruby("학|인","學|人")을 합쳐 #ruby("수|백","數|百") #ruby("명","名")의 #ruby("남|녀","男|女") #ruby("승|도","僧|徒")가 있었다. 나는 때때로 #ruby("하|은|대|사","荷|隱|大|師")에게 #ruby("도|학","道|學")을 들었다.]
#zh[又公布《招贤文告》，广征人才。我在向导指引下，查访九月山内外的有识之士，然后单身徒步去拜访。我师事月精洞之宋宗镐。他早年游历上海，精通海外之事，为人豪爽，颇具英雄气概。我派人把他请上山寺，委以顾问之职。丰川郡名士许坤也来投奔，他文笔流利，精于时务。]
#zh[在贝叶寺有位闻名于京乡各地的高僧荷隐堂，他总管寺中事务，拥有数百名弟子和善男信女，我常听他说法。]
#figure-block("/images/p47.jpg", caption: [#ruby("동|학","東|學") #ruby("접|주","接|主") #ruby("시|절","時|節"), #ruby[백|범][白|凡]이 #ruby("동|학|군","東|學|軍")을 #ruby("주|둔","駐|屯")시켰던 #ruby("구|월|산","九|月|山") #ruby("패|엽|사","貝|葉|寺")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("패|엽|사","貝|葉|寺")에서 우리는 #ruby("간|간","間|間")이 #ruby("최|고|회|의","最|高|會|議")를 열어 #ruby("장|래","將|來") #ruby("방|침","方|針")을 #ruby("의|논","議|論")하였다. #ruby("당|시","當|時") #ruby("경|군","京|軍")과 #ruby("왜|병","倭|兵")이 #ruby("해|주|성","海|州|城")을 #ruby("점|거","占|據")하고 #ruby("주|위","周|圍")에 흩어진 #ruby("동|학|교|도","東|學|敎|徒")를 #ruby("소|탕","掃|蕩")하고 #ruby("점|차","漸|次") #ruby("서","西")쪽으로 #ruby("옹|진","瓮|津")·#ruby("강|령","康|翎") #ruby("등","等")을 #ruby("평|정","平|定")하고 이제 #ruby("학|령","鶴|嶺")으로 넘어온다고 한다. 그런데 #ruby("구|월|산","九|月|山") #ruby("주|변","周|邊")에는 #ruby("이|동|엽","李|東|燁")이란 #ruby("접|주","接|主")가 이끄는 #ruby("동|학|군","東|學|軍")이 큰 #ruby("세|력","勢|力")을 #ruby("형|성","形|成")하고 있었다. 이 #ruby("부|대","部|隊")의 #ruby("동|학|군","東|學|軍")이 #ruby("패|엽|사","貝|葉|寺") #ruby("부|근","附|近") #ruby("촌|락","村|落")을 #ruby("노|략","擄|掠")질하다 우리 #ruby("군|인","軍|人")에게 잡혀 #ruby("총|기","銃|器")를 빼앗기고 #ruby("벌","罰")을 받은 #ruby("후","後") 돌아가기도 하였다. 그런데 나의 #ruby("부|하","部|下") 가운데 #ruby("촌|락","村|落")으로 내려가 #ruby("재|물","財|物")과 #ruby("보|물","寶|物")을 #ruby("약|탈","掠|奪")하다 #ruby("발|각","發|覺")되어 #ruby("엄","嚴")한 #ruby("형|벌","刑|罰")을 받으면 #ruby("도|망","逃|亡")가서 #ruby("이|동|엽","李|東|燁")의 #ruby("부|하","部|下")가 되거나, 아예 #ruby("도|적","盜|賊")질을 하고 싶어서 #ruby("야|간","夜|間")에 #ruby("도|주","逃|走")하여 #ruby("이|동|엽","李|東|燁")의 #ruby("부|하","部|下")가 되는 #ruby("자","者")들이 #ruby("증|가","增|加")하여 나의 #ruby("세|력","勢|力")은 나날이 줄어들었다.]
#zh[我们有时召开最高会议，讨论将来的方针。这时消息传来京军和倭兵占领了海州，平定了雍津、康翎等地，大有越过鹤岭的企图，不用说他们的目标就是九月山了。]
#zh[然而可虑的不在京军和倭兵，而是与我同为东学党的李东烨的势力。]
#zh[李东烨是九月山一带最有势力的接主，他的部下常侵犯我的防地，恣意抢劫，被我军逮捕后加以严惩，以致彼此间结怨日深。再者在我军中，违反军律而被罚者也有很多人怀恨在心，投奔李东烨军的日益增多，因此李东烨的势力日见壮大而我军兵力则逐渐削弱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("최|고|회|의","最|高|會|議")는 #ruby("기|회","機|會")를 보아 나에게 #ruby("동|학","東|學") #ruby("접|주","接|主")의 감투를 벗기기로 #ruby("결|정","決|定")하였는데, 이것은 나에게서 #ruby[병|권][兵|權]을 #ruby("박|탈","剝|奪")하자는 #ruby("야|심","野|心")이 아니요, 나의 몸을 #ruby("보|전","保|全")케 하려는 #ruby("방|책","方|策")이었다. #ruby("회|의","會|議")의 #ruby("복|안","腹|案")은 #ruby("허|곤","許|坤")을 #ruby("평|양","平|壤")에 보내어 #ruby("장|호|민","張|好|民")의 #ruby("소|개","紹|介")로 #ruby("황|주|병|사","黃|州|兵|使")#footnote(numbering: _ => [59)])[#h(0.35em)#ruby("갑|오|농|민|전|쟁","甲|午|農|民|戰|爭") #ruby("당|시","當|時") #ruby("농|민|군","農|民|軍")은 #ruby("감|사","監|司")·#ruby("현|감","縣|監")·#ruby("판|관","判|官")·#ruby("병|사","兵|使")·#ruby("중|군","中|軍") #ruby("등","等") #ruby("자|체","自|體")의 #ruby("통|치|체|계","統|治|體|系")와 #ruby("군|사|조|직","軍|事|組|織")을 #ruby("정|비","整|備")하였다. 여기서 #ruby("황|주|병|사","黃|州|兵|使")는 #ruby("농|민|군","農|民|軍")의 #ruby("대|체|권|력","代|替|權|力")으로서 #ruby("황|주|병|사","黃|州|兵|使")를 #ruby("의|미","意|味")한다.]의 #ruby("양|해","諒|解")를 얻고 난 뒤, #ruby("패|엽|사","貝|葉|寺")에 있는 #ruby("군|대","軍|隊")를 나 #ruby("대|신","代|身") #ruby("허|곤","許|坤")에게 #ruby("인|도","引|渡")한다는 것이었다. 이러한 일로 #ruby("허|곤","許|坤")은 #ruby("송|종|호","宋|宗|鎬")의 #ruby("편|지","便|紙")를 지니고 #ruby("평|양","平|壤")으로 #ruby("출|발","出|發")하였다.]
#zh[因此我召开最高会议，见机行事，我放弃了接主的名义，并决定派许坤去平壤，通过张好民的介绍，以取得黄州兵使的谅解，将贝叶寺的军队移交给他。]
#zh[于是许坤拿着宋宗镐的介绍信，去了平壤。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 내 나이 열아홉 살, #ruby[갑|오|년][甲|午|年]\(1894) #ruby("섣|달","臘|月")#ruby("경","頃")이었다. 나는 며칠 동안 #ruby("신|열","身|熱")과 #ruby("두|통","頭|痛")이 #ruby("심","甚")하여 #ruby("방","房")에 누워 #ruby("치|료","治|療")#ruby("중","中")이었다. #ruby("하|은|당","荷|隱|堂")이 #ruby("문|병","問|病")와서 나를 #ruby("자|세","仔|細")히 보더니 “#ruby("홍|역","紅|疫")도 치르지 못한 #ruby("대|장","大|將")이로구려” 하면서 #ruby("영|장","領|將") #ruby[이|용|선][李|龍|善]에게 나의 #ruby("방","房") #ruby("출|입","出|入")을 #ruby("금|지","禁|止")시키게 하고, #ruby("자|신","自|身")이 #ruby("직|접","直|接") #ruby("치|료","治|療")를 #ruby("전|담","專|擔")하고 #ruby("홍|역","紅|疫")에 #ruby("경|험","經|驗")이 있는 나이 든 #ruby("여|승","女|僧")으로 하여금 #ruby("간|호","看|護")케 하였다.]
#zh[甲午年十二月，我十九岁那年，一日忽然全身发烧，头痛欲裂，卧倒病榻，住在一间静室里。荷隐大师来探病，经他仔细地诊断，才知是出疹子。荷隐堂笑着说：“是位连疹子还没有出过的大将呢！”于是通知头领李龙善，禁止人们出入我的房间，由荷隐大师给我治病，并从女僧堂找来一位治疹子有经验的老修士来护理我。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어느날 #ruby("이|동|엽","李|東|燁")이 #ruby("전|군","全|軍")을 이끌고 우리를 #ruby("침|공","侵|攻")한다는 #ruby("급|보","急|報")가 있자마자, #ruby("이|동|엽","李|東|燁") #ruby("군|대","軍|隊")들은 #ruby("총","銃") 쏘고 칼 휘두르면서 절 안으로 쏟아져 들어왔다. 우리 #ruby("군|인","軍|人")들은 뿔뿔이 #ruby("도|망","逃|亡")가거나 #ruby("육|박|전","肉|搏|戰")을 벌였다. #ruby("이|동|엽","李|東|燁")은 #ruby("자|신","自|身")의 #ruby("부|하","部|下")들에게 “#ruby[김|접|주][金|接|主]에게 #ruby("하|수","下|手")하는#footnote(numbering: _ => [60)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “손대는”. 손을 대서 사람을 죽임.] #ruby("자","者")는 #ruby("사|형","死|刑")에 #ruby("처","處")한다”고 #ruby("호|령","號|令")하였다. #ruby("이|동|엽","李|東|燁")이 나를 미워하지 않아서 그런 것이 아니라 나를 #ruby("박|해","迫|害")하면 #ruby("후|일","後|日") 큰 #ruby("화","禍")를 입을까 두려워했기 때문이다. 왜냐하면 나는 #ruby[해|월][海|月] #ruby("선|생","先|生")이 #ruby("임|명","任|命")한 #ruby("접|주","接|主")이니 #ruby("동|학","東|學")의 #ruby("정|통","正|統")인 #ruby("반|면","反|面"), #ruby("이|동|엽","李|東|燁")은 #ruby("임|시","臨|時") #ruby("방|편","方|便")으로 #ruby("임|종|현","林|宗|鉉")#footnote(numbering: _ => [61)])[#h(0.35em)#ruby("임|종|현","林|宗|鉉")은 #ruby("황|해|도|지|역","黃|海|道|地|域") #ruby("동|학|농|민|군","東|學|農|民|軍") #ruby("중","中") 가장 #ruby("과|격","過|激")한 #ruby("지|도|자","指|導|者")로 #ruby("유|명","有|名")하며, #ruby("농|민|군","農|民|軍")의 #ruby("현|지","現|地") #ruby("대|체|권|력","代|替|權|力") #ruby("구|상","構|想")에서 #ruby("감|사","監|司")로 #ruby("내|정","內|定")된 바 있다.]으로부터 #ruby[임명장][差帖]을 받은 #ruby("제","第")2#ruby("세","世") #ruby("접|주","接|主")이기#footnote(numbering: _ => [62)])[#h(0.35em)#ruby("원|문","原|文"): “李東燁의 接主는 第二世인데 臨時的으로 林宗鉉의 差帖을 受한 者임으로”. #ruby("제","第")2#ruby("세","世") #ruby("접|주","接|主")란, #ruby("교|주","敎|主") #ruby[최|시|형][崔|時|亨]이 아닌 다른 #ruby("접|주","接|主")로부터 다시 #ruby("접|주","接|主")로 #ruby("임|명","任|命")된 것을 #ruby("의|미","意|味")한다. #ruby("임|종|현","林|宗|鉉")이 #ruby("독|자|적","獨|自|的")으로 #ruby("황|해|도|지|역","黃|海|道|地|域")의 #ruby("접|주","接|主")를 #ruby("임|명","任|命")하였음을 보여주는 #ruby("중|요","重|要")한 #ruby("증|거","證|據")이다.] 때문이다.]
#zh[一日传来李东烨领军攻向贝叶寺的急报，立时听见一片骚乱的枪声。转瞬间，两军在寺庙附近短兵相接，原来就士气沮丧，再加上领军将帅不得其人的我军，不意中突遭袭击，遂一败涂地，本军防地亦为敌所控制，我军犹如惊弓之鸟，四下散逃而去，接着又听见李东烨的号令：]
#zh[“有敢冒犯金接主者，处死刑。赶快追杀头领李龙善！”]
#zh[他所以不敢加害于我，是因为我乃海月先生盖章任命的接主，而他只不过是受林宗铉委任的第二代接主，怕杀害了我，以后难免杀身之祸。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|동|엽","李|東|燁")은 #ruby("영|장","領|將") #ruby[이|용|선][李|龍|善]만 #ruby("사|형","死|刑")에 #ruby("처","處")하라고 #ruby("명|령","命|令")하였다. 나는 그 말을 듣고 #ruby("돌|연","突|然")히 자리를 박차고 나가 “#ruby[이|용|선][李|龍|善]은 나의 #ruby("지|휘|명|령","指|揮|命|令")에 따라 #ruby("행|동","行|動")한 것뿐이다. 만일 #ruby[이|용|선][李|龍|善]이 죽을#ruby("죄","罪")가 있다면 그것은 곧 나의 #ruby("죄","罪")이니 나를 #ruby("총|살","銃|殺")하라”고 큰소리로 #ruby("호|령","號|令")하였다. 그러나 #ruby("이|동|엽","李|東|燁")은 #ruby("부|하","部|下")들을 #ruby("지|휘","指|揮")하여 나의 손과 발을 꼭 껴안아 움직이지 못하게 해놓고 #ruby[이|용|선][李|龍|善]만 끌고 갔다.]
#zh[我听了他这号令后，一跃而起，跑到廊下高声大呼：]
#zh[“李龙善是按照我的命令行事的，有罪该由我来承担，要杀杀我好了！”]
#zh[李东烨命令部下逮住我，使我动弹不得，眼看着李龙善被士兵们推出去，接着远远地从村口传来枪声，然后李东烨的部下就全部退走了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[얼마 #ruby("후","後") 동네 어귀에서 #ruby("총","銃")소리가 났다. 절 안에 있던 #ruby("이|동|엽","李|東|燁") #ruby("부|하","部|下")는 거의 #ruby("퇴|각","退|却")하였는데 #ruby[이|용|선][李|龍|善]이 #ruby("총|살","銃|殺")되었다는 #ruby("보|고","報|告")가 들어왔다. #ruby("즉|각","卽|刻") 동네 어귀로 달려가 보니 #ruby("과|연","果|然") #ruby[이|용|선][李|龍|善]은 #ruby("총","銃")에 맞아 죽었고, 입은 옷이 #ruby("전|부","全|部") 불타고 있었다. 나는 #ruby[이|용|선][李|龍|善]의 머리를 껴안고 #ruby("통|곡","痛|哭")하다 저고리를 벗어 #ruby[이|용|선][李|龍|善]의 머리를 감싸고 동네사람들을 #ruby("지|휘","指|揮")하여 #ruby("정|성","精|誠")껏 묻어주게 했다. 그 저고리는 어머님이 내가 #ruby("동|학","東|學") #ruby("접|주","接|主")로 #ruby("지|도|자","指|導|者") 노릇 한다고 처음으로 지어 보내신 #ruby("명|주","明|紬")저고리였다. 내가 눈 속에서 벌거벗은 몸으로 #ruby("호|곡","號|哭")하는 것을 본 이웃사람들이 #ruby("의|복","衣|服")을 갖다 주었다.]
#zh[听到杀死李龙善的枪声后，我快步跑到村口，只见他中弹倒地，他身上的衣服，仍然在燃烧着。我抱着他的头，不禁放声痛哭，随即脱下我的上衣，盖上他的头。这衣服是我当首领后，妈妈在近二十年里第一次亲自为我缝制的绸缎上衣。村民见我赤身哭倒在雪地里，赶紧拿来衣服给我披上，于是我含悲指挥村民埋葬了李龙善。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[이|용|선][李|龍|善]은 #ruby("함|경|도","咸|鏡|道") #ruby("정|평","定|平") #ruby("출|신","出|身")인데 장사하러 #ruby("황|해|도","黃|海|道")에 와서 살고 있었다. 그는 사냥하는 #ruby("총|술","銃|術")이 있고 #ruby("무|식","無|識")하지만 사람을 다스리는 재주가 있어 내가 #ruby("화|포|영|장","火|砲|領|將")#footnote(numbering: _ => [63)])[#h(0.35em)여기서 #ruby("화|포","火|砲")는 #ruby("포","砲")가 아니라 #ruby("화|승|총","火|繩|銃")이다. #ruby("당|시","當|時")에는 #ruby("화|승|총","火|繩|銃")을 #ruby[포][砲], #ruby[화|포][火|砲], #ruby[토|총][土|銃]이라 불렀다. #ruby("화|포|영|장","火|砲|領|將")은 #ruby("부|대","部|隊")에서 #ruby("총","銃")으로 #ruby("무|장","武|裝")된 #ruby("자","者")들을 이끄는 #ruby("직|책","職|責")을 #ruby("의|미","意|味")한다.]에 #ruby("임|명","任|命")하였던 것이다. 그#ruby("후","後") 아들과 조카가 와서 #ruby("정|평","定|平") #ruby("본|향","本|鄕")으로 #ruby[이|용|선][李|龍|善]의 주검을 #ruby("이|장","移|葬")할 때, 동네사람들로부터 #ruby("피|살","被|殺") #ruby("당|시","當|時")의 #ruby("정|황","情|況")을 #ruby("설|명","說|明") 듣고 또 #ruby("시|신","屍|身")을 꺼내다가 내 저고리로 얼굴을 싼 것을 보고서 나에게 나쁜 #ruby("감|정","感|情")을 품지 않고 돌아갔다는 말을 들었다.]
#zh[李龙善是咸镜道定平人，因经商而寄居黄海道，枪法很准，善于行猎，虽然没有什么大的学问，可是却颇有领导才干，故而我委他为火炮头领。]
#zh[他死以后，听说其子侄来到九月山，要把他迁葬回定平故里。那时，他们听了村民叙述龙善被害经过，知道了我用上衣盖住他的头部，所以回去时对我并无任何恶感。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[이|용|선][李|龍|善]이 죽은 날 밤 나는 #ruby("부|산|동","缶|山|洞") #ruby("정|덕|현","鄭|德|鉉")의 집으로 가서 그#ruby("간","間")의 #ruby("사|정","事|情")을 #ruby("설|명","說|明")하였다. #ruby("정|씨","鄭|氏")는]
#zh[埋葬好后，我未回到贝叶寺，而直接去缶山洞见郑德铉，把事情的经过详细地报告一遍。郑氏说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby[이|용|선][李|龍|善]의 죽음은 #ruby("불|행","不|幸")한 일이지만, #ruby("형","兄")은 #ruby("지|금","只|今")부터 일을 마무리지어야 할 #ruby[장부][了事丈夫]이니, #ruby("수|일|간","數|日|間") #ruby("홍|역","紅|疫")의 #ruby("여|독","餘|毒")을 풀고 난 뒤 나와 함께 #ruby("풍|진","風|塵")을 #ruby("피","避")하여 #ruby("유|람","遊|覽")이나 떠납시다.”]
#zh[“李龙善之死，固然不幸，但兄台从现在起该做个能了却事情的大丈夫。不妨调养几天，消了麻疹的余毒，然后和我避开风尘，去游历一番吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아니오, #ruby[이|용|선][李|龍|善]의 #ruby("복|수","復|讎")를 해야 합니다.”]
#zh[“不。我要为李龙善报仇。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("복|수","復|讎")는 #ruby("의|리","義|理")에 #ruby("당|연","當|然")하나 #ruby("경|군","京|軍")과 #ruby("왜|병","倭|兵")이 아직 #ruby("구|월|산","九|月|山")을 #ruby("소|탕","掃|蕩")하지 못하는 것은 #ruby("산","山") 밖에 #ruby("이|동|엽","李|東|燁") #ruby("부|대","部|隊")가 크고, #ruby("산","山")속 #ruby("패|엽|사","貝|葉|寺")의 우리 #ruby("부|대","部|隊")가 #ruby("험","險")한 #ruby("산|세","山|勢")에 #ruby("의|거","依|據")하고 또한 #ruby("정|예|부|대","精|銳|部|隊")라고 #ruby("탐|문","探|問")하였기 때문입니다. 이제 두 #ruby("부|대","部|隊")의 싸움 #ruby("소|식","消|息")을 듣고서 #ruby("경|군","京|軍")과 #ruby("왜|병","倭|兵")은 #ruby("즉|각","卽|刻") #ruby("이|동|엽","李|東|燁") #ruby("부|대","部|隊")를 #ruby("섬|멸","殲|滅")하고 #ruby("즉|시","卽|時") #ruby("패|엽|사","貝|葉|寺")를 #ruby("점|령","占|領")할 것이니 #ruby("복|수","復|讎")를 말할 #ruby("여|지","餘|地")가 없습니다.”]
#zh[“报仇于义理当然。京军和倭兵至今未能扫荡九月山，是因为山外李东烨的部队强大，而山里贝叶寺我军据着险要山势，又被探明是精锐。现在他们听到两军交战的消息，必将立即歼灭李东烨的部队，随即占领贝叶寺，复仇已无余地。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("정|씨","鄭|氏") 집에 2〜3#ruby("일|간","日|間") #ruby("요|양","療|養")한 #ruby("후","後") 나는 #ruby("난","亂")을 #ruby("피","避")해 #ruby("장|연|군","長|淵|郡") #ruby("몽|금|포","夢|金|浦") #ruby("부|근","附|近")의 동네로 옮겨 세 달#ruby("간","間") #ruby("은|거","隱|居")하였다.#footnote(numbering: _ => [64)])[#h(0.35em)#ruby[백|범][白|凡]은 1894#ruby("년","年") 12#ruby("월","月")부터 1895#ruby("년","年") 2#ruby("월","月")까지 세 달 동안 #ruby("몽|금|포","夢|金|浦")에 #ruby("은|거","隱|居")하였다. 그런데 1895#ruby("년","年") #ruby("청","淸")나라에 다녀온 #ruby[백|범][白|凡]은 8#ruby("월","月")에 #ruby[김|형|진][金|亨|鎭]과 더불어 다시 #ruby("몽|금|포","夢|金|浦") #ruby("장|산","長|山")곶 #ruby("근|처","近|處") ‘나는 새도 #ruby("출|입","出|入")하기 어려운 마을’로 들어와 한 달 이상 머물면서 #ruby("거|사","擧|事") #ruby("계|획","計|劃")을 #ruby("도|모","圖|謀")한다.] 들려오는 #ruby("소|문","所|聞")에 #ruby("의","依")하면 #ruby("이|동|엽","李|東|燁")은 벌써 잡혀가 #ruby("사|형","死|刑")을 #ruby("당","當")하고 #ruby("각","各") #ruby("군","郡")의 #ruby("동|학|군","東|學|軍")은 거의 #ruby("소|탕","掃|蕩")되었다 한다.]
#zh[我在郑家疗养了两三天后，便到长洞郡梦金浦附近避难，在那里隐居了三个月。此时从东边传来了风声，说是李东烨已被捕，处以死刑，而海州各郡的东学党终于全部瓦解。]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) #ruby("청|계|동","淸|溪|洞") #ruby("안|진|사","安|進|士")]]
#zh[清溪洞时期]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("정|씨","鄭|氏")와 같이 텃골 #ruby("본|가","本|家")에 와서 #ruby("부|모","父|母")님을 뵈었다. #ruby("당|시","當|時") #ruby("왜|병","倭|兵")들이 #ruby("죽|천|장","竹|川|場")에 #ruby("진","陣")을 치고 #ruby("동|학|당","東|學|黨")을 #ruby("수|색","搜|索")하는 #ruby("중","中")이라 #ruby("부|모","父|母")님은 매우 #ruby("불|안","不|安")해 하셨다. #ruby("부|모","父|母")님은 나에게 다시 멀리 가서 #ruby("화","禍")를 #ruby("피","避")할 것을 #ruby("권|유","勸|誘")하였다.]
#zh[我偕同郑氏回到基洞本家探望父母。当时倭兵已在竹川场布阵，正在搜捕东学党，父母十分不安，劝我再远远避开这场祸。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 #ruby("정|씨","鄭|氏")가 #ruby("청|계|동","淸|溪|洞") #ruby("안|진|사","安|進|士")에게 가 보자고 하나, 나는 #ruby("주|저","躊|躇")하였다. #ruby("안|씨","安|氏")가 받아들인다고 하더라도 #ruby("패|군","敗|軍")의 #ruby("장|수","將|帥")인 내가 #ruby("포|로","捕|虜") 같은 #ruby("대|우","待|遇")를 받는다면 두고두고 #ruby("후|회","後|悔")될 것이 #ruby("염|려","念|慮")되었다. 그러나 #ruby("정|씨","鄭|氏")는 “#ruby("안|진|사","安|進|士")가 #ruby("밀|사","密|使")를 #ruby("파|견","派|遣")한 #ruby("진|의","眞|意")는 #ruby("군|사|적","軍|事|的")인 #ruby("원|조","援|助")나 #ruby("계|략","計|略")이라기보다는 나이 어린 #ruby("형","兄")의 #ruby("담|대","膽|大")한 #ruby("기|개","氣|槪")를 아낀 것이니 #ruby("염|려","念|慮") 말고 같이 가자”고 힘써 #ruby("권|고","勸|告")하였다.]
#zh[次日郑氏要我去投奔清溪洞的安进士，我却犹豫。我担心即便安氏收留，我这败军之将若受到俘虏般的待遇，必将后悔长久。可是郑氏极力劝道：“安进士派遣密使的真意，与其说是军事上的援助或计略，不如说是爱惜年少而胆大的兄长的气概，不必顾虑，一同去吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("정|씨","鄭|氏")와 같이 그날 #ruby("천|봉|산","千|峯|山")을 넘어 #ruby("청|계|동","淸|溪|洞") #ruby("입|구","入|口")에 #ruby("도|착","到|着")하였다. #ruby("청|계|동","淸|溪|洞")은 #ruby("사|면","四|面")이 #ruby("험|준","險|峻")하고도 #ruby("수|려","秀|麗")한 #ruby("산","山")으로 둘러싸여 있고, #ruby("민|가","民|家")는 40〜50채로 드문드문 흩어져 있었다. 동네 앞에는 한 줄기 긴 #ruby("강","江")이 흘러가고 그 옆 #ruby("암|벽","岩|壁")에는 #ruby("안|진|사","安|進|士")의 #ruby("친|필","親|筆")을 새긴 ‘#ruby("청|계|동|천","淸|溪|洞|天")’#footnote(numbering: _ => [65)])[#h(0.35em)#ruby("동|천","洞|天")은 내가 흐르는 #ruby("경|치","景|致") 좋은 #ruby("명|산","名|山")으로, #ruby("신|선","神|仙")이 사는 곳을 말한다.]이란 네 글#ruby("자","字")가 흐르는 물소리에 따라 살아 움직이는 것 같았다.#footnote(numbering: _ => [66)])[#h(0.35em)#ruby("신|천|군","信|川|郡") #ruby("두|라|면","斗|羅|面") #ruby("천|봉|산","千|峯|山") #ruby("남","南")쪽 기슭에 있는 깊고도 #ruby("신|묘","神|妙")한 오목골. #ruby("한|말","韓|末") #ruby("해|서|지|방","海|西|地|方")의 #ruby("유|명","有|名")한 #ruby("문|인","文|人") #ruby[유|응|두][劉|應|斗]는 #ruby("청|계|동","淸|溪|洞")을 ‘#ruby("별|천|지","別|天|地")’ ‘#ruby("무|이|구|곡","武|夷|九|曲")’에 #ruby("비|유","比|喩")하였다.]]
#zh[我和郑氏一起，当天越过千峰山，抵达清溪洞入口。清溪洞四周围绕着险峻而灵秀的峰峦，村里四五十户人家稀疏散落。村前有一条长溪流过，岩壁上刻有安进士的手迹“清溪洞天”四个大字，这四个字就像随着流水声活着一般。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[동네 어귀에는 작은 #ruby("산","山")이 하나 있었는데, #ruby("산","山")꼭대기에는 #ruby("포|대","砲|臺")가 #ruby("설|치","設|置")되어 있었다. #ruby("파|수|병","把|守|兵")의 #ruby("질|문","質|問")에 #ruby("명|함","名|刺")을 #ruby("제|시","提|示")하니, “#ruby("의|려|장","義|旅|長")이 #ruby("허|가","許|可")하였다”며 #ruby("호|위|병","護|衛|兵")이 우리를 #ruby("인|도","引|導")한다. #ruby("호|위|병","護|衛|兵")을 따라 #ruby[의|려|소][義|旅|所]\(安進士宅)에 들어가면서 #ruby("관|찰","觀|察")하니, #ruby("문","門") 앞에는 자그마한 #ruby("연|못","蓮|塘")과 그 안에 한 칸의 #ruby("초|가|정|자","草|家|亭|子")가 있었다. 이곳에서 #ruby("안|진|사","安|進|士") 6#ruby("형|제","兄|弟")가 #ruby("평|소","平|素") 술 마시고 #ruby("시","詩")를 지으면서 #ruby("소|일","消|日")한다고 한다.]
#zh[村口有一座小山，山顶设着炮台。把守兵查问，我们递上名片，他们说“义旅长许可了”，护卫兵便来引导。跟着走进义旅所（安进士宅），见门前有一座小小莲塘，塘中一间草亭。据说安进士六兄弟平日在此饮酒作诗消遣。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("본","本")채의 #ruby("대|청","大|廳")에 올라가니 #ruby("벽","壁") 위에는 #ruby("안|진|사","安|進|士")가 #ruby("친|필","親|筆")로 가로쓴 ‘#ruby("의|려|소","義|旅|所")’ 세 글#ruby("자","字")의 #ruby("현|판","懸|板")이 붙어 있었다. 우리의 #ruby("명|함","名|銜")을 본 #ruby("안|진|사","安|進|士")는 #ruby("본|채","正|堂")에서 #ruby("친|절","親|切")하게 #ruby("영|접","迎|接")하였다. #ruby("수|인|사","修|人|事") #ruby("후","後") #ruby("안|진|사","安|進|士")는]
#zh[登上正房大厅，墙上横挂着安进士亲笔横书“义旅所”三个字的匾额。安进士看了我们的名帖，在正厅亲切迎接。行礼之后，第一句话便说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|석|사","金|碩|士")#footnote(numbering: _ => [67)])[#h(0.35em)#ruby("석|사","碩|士")는 벼슬 없는 선비를 높여 부르는 말.]가 #ruby("패|엽|사","貝|葉|寺")에서 #ruby("위|험","危|險")을 벗어난 #ruby("후","後") #ruby("심","甚")히 #ruby("우|려","憂|慮")되어 애써 #ruby("탐|색","探|索")하였으나 계신 곳을 모르던 터에 #ruby("금|일","今|日") 이처럼 찾아주시니 #ruby("감|사","感|謝")합니다.”]
#zh[“获悉金硕士在贝叶寺幸免于难，曾派专人去探听，却没有消息，非常焦虑，不意大驾今天亲临寒舍，深感荣幸。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 말#ruby("문","門")을 연 뒤 물었다.]
#zh[他这样开了头，接着问道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("부|모","父|母")님이 모두 계신다고 들었는데 어디 #ruby("편","便")히 계실 곳이 있습니까?”]
#zh[“听说令尊令堂都在，不知有没有可以安居的地方？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“달리 계실 곳이 없어 아직 #ruby("본|동","本|洞")에 계십니다.”]
#zh[我回答尚无安居之处，现在暂住本乡。]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("대|답","對|答")하자, #ruby("즉|시","卽|時") #ruby("오|일|선","吳|日|善")에게 #ruby("총","銃") 가진 #ruby("병|사","兵|士") 30#ruby("명","名")을 #ruby("지|정","指|定")하게 하여]
#zh[我这样回答。安进士立即指定吴日善，率领荷枪兵士三十名，命令他说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘 #ruby("중","中")으로 텃골에 가서 #ruby("김|석|사","金|碩|士") #ruby("부|모","父|母")님을 모시고 가까이에서 #ruby("우|마","牛|馬")를 잡아 #ruby("가|산","家|産") #ruby("전|부","全|部")를 옮기라.”]
#zh[“限今天之内到基洞去，把金硕士的父母接来，就近征用牛马，把全部家产搬来。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("명|령","命|令")하고 #ruby("인|근","隣|近")에 #ruby("가|옥","家|屋") 한 채를 #ruby("매|입","買|入")해 주었다.]
#zh[他又这样命令，并在近处买下一栋房屋给了我们。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이리하여 그날 바로 #ruby("청|계|동","淸|溪|洞") #ruby("생|활","生|活")이 #ruby("시|작","始|作")되었다. 이때 내 나이 스무 살 #ruby[을|미|년][乙|未|年]\(1895) 2#ruby("월","月")이었다. #ruby("안|진|사","安|進|士")는 “날마다 #ruby("사|랑","舍|廊")에 와서 내가 없을 때라도 내 #ruby("동|생","同|生")들과 놀고 #ruby("친|구","親|舊")들과도 #ruby("담|화","談|話")하든지 #ruby("서|적","書|籍")을 보든지 마음대로 #ruby("안|심","安|心")하여 지내라”고 #ruby("친|절","親|切")히 #ruby("부|탁","付|託")하였다.]
#zh[于是当天就在清溪洞过起日子来。这时我二十岁，是乙未年二月。安进士亲切地嘱咐我：“每天到客舍来，即使我不在，也可以和我的兄弟们玩耍，和朋友们谈话，或者看书，尽管放心过。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|진|사","安|進|士") 여섯 #ruby("형|제","兄|弟")는 큰#ruby("형","兄")이 #ruby("태|진","泰|鎭"), 다음이 #ruby("태|현","泰|鉉"), #ruby("안|진|사","安|進|士") #ruby("태|훈","泰|勳")은 세#ruby("번","番")째이고, 넷째는 #ruby("태|건","泰|健"), 다섯째는 #ruby("태|민","泰|民"),#footnote(numbering: _ => [68)])[#h(0.35em)#ruby("본|명","本|名")은 ‘泰敏’이다.] 여섯째가 #ruby("태|순","泰|純")이다. 여섯 #ruby("형|제","兄|弟") 모두 #ruby("학|식","學|識")이 #ruby("풍|부","豐|富")하고 #ruby("인|격","人|格")이 높았는데, 그#ruby("중","中")에서도 #ruby("안|진|사","安|進|士")는 #ruby("탁|월","卓|越")했다.]
#zh[安进士兄弟六人，老大名泰镇，老二泰铉，安进士泰勋行三，老四泰健，老五泰民，最小的弟弟名泰纯。他们都学识丰富，人品高尚，尤其是安进士，无论是学识，还是气量，均卓越非凡。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|진|사","安|進|士")는 나를 #ruby("시|험","試|驗")하기 #ruby("위","爲")해 #ruby("종|종","種|種") #ruby("질|의","質|疑")도 하고 #ruby("담|론","談|論")도 하였지만, #ruby("당|시","當|時") 나는 #ruby("유|치","幼|稚")한 #ruby("수|준","水|準")의 #ruby("행|동","行|動")이 많은 때였다. #ruby("화|창","和|暢")한 봄날, #ruby("안|진|사","安|進|士")는 술과 #ruby("안|주","按|酒")를 차려 #ruby("포|꾼","砲|軍")들을 데리고 놀면서 씨름판을 벌였다. 마지막 #ruby("결|승","決|勝")에 오른 두 사람은 재주와 힘이 #ruby("비|등","比|等")하여 쉽게 #ruby("승|부","勝|負")가 나지 않았다. #ruby("안|진|사","安|進|士")는 #ruby("용|맹","勇|猛")스럽게 씨름하는 것을 구경하다가 내게 물었다.]
#zh[他为了考我，时常跟我海阔天空，高谈阔论，而我的举止却经常显得很幼稚。和畅的春日，安进士备下酒肴，带着炮军玩耍，摆开摔跤场。最后决赛的两个人技艺和力气不相上下，胜负一时难分。安进士看着他们勇猛地摔跤，问我：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("창|수","昌|洙")가 보기에 어느 사람이 이길 것 같은가?”]
#zh[“依昌洙看来，哪一个会赢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“키가 크고 힘이 세 보이는 사람이 질 것 같습니다.”]
#zh[“身高者看似力大，我看将输给身材较矮者。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("대|답","對|答")하자 #ruby("안|진|사","安|進|士")는 다시 그 #ruby("이|유","理|由")를 물었다.]
#zh[我这样回答，安进士又问那理由：“何以见得？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아까 씨름할 때 키 큰 사람의 바지가 찢어져 볼기가 드러나 그 사람은 #ruby("기|운","氣|運")을 다 쓰지 못하는 듯하니 #ruby("단|연","斷|然")코 그 사람이 질 것입니다.”]
#zh[“刚才摔跤的时候，高个子的裤子撕破，臀部露了出来，那人仿佛使不出全部力气，断然是他要输。”]
#figure-block("/images/p52.jpg", caption: [#ruby("안|중|근","安|重|根") #ruby("의|사","義|士")의 아버지 #ruby("안|태|훈","安|泰|勳") #ruby("진|사","進|士").#linebreak()#ruby("동|학","東|學") #ruby("접|주","接|主")로서 #ruby("피|신","避|身")#ruby("중","中")인 #ruby("백|범","白|凡")을#linebreak()#ruby("청|계|동","淸|溪|洞")에 머물게 하고 #ruby("극|진","極|盡")히 #ruby("대|우","待|遇")했다.])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내 말이 끝나기도 #ruby("전","前")에 #ruby("과|연","果|然") 그 사람이 지는 것을 본 #ruby("안|진|사","安|進|士")는 나를 더욱 사랑하였다.]
#zh[言犹未了，那人果然被摔倒在地。从此安进士对我更加钟爱。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("진|사","進|士")는 아들이 셋 있었는데 맏아들은 #ruby("중|근","重|根")으로 #ruby("당|년","當|年") 열여섯에 상투를 틀었고#footnote(numbering: _ => [69)])[#h(0.35em)1895#ruby("년","年") #ruby("안|중|근","安|重|根")은 열일곱이었고, 1894#ruby("년","年")에 이미 #ruby("결|혼","結|婚")하여 상투를 틀었다.] #ruby("자|색","紫|色") #ruby("명|주","明|紬")#ruby("수|건","手|巾")으로 머리를 동이고서 돔방총#footnote(numbering: _ => [70)])[#h(0.35em)#ruby("원|주","原|註"): “普通 長銃이 아니고 메고 다니기에 便利하도록 만든 것”.]을 메고 #ruby("노|인|당","老|人|堂")과 #ruby("신|상|동","薪|上|洞")으로 날마다 사냥을 다녔다. #ruby("중|근","重|根")은 #ruby("영|기","英|氣")가 넘치고 여러 #ruby("군|인","軍|人")들 #ruby("중","中")에도 #ruby("사|격|술","射|擊|術")이 #ruby("제|일","第|一")로, 나는 새 달리는 짐승을 #ruby("백|발|백|중","百|發|百|中")으로 맞추는 재주가 있었다. #ruby("태|건","泰|健") #ruby("씨","氏")와 #ruby("숙|질","叔|姪")이 늘 #ruby("동|행","同|行")했는데, 어떤 때는 하루에 노루와 고라니 #ruby("등","等")을 여러 마리 잡아와 그것으로 #ruby("군|사","軍|士")들을 #ruby("위|로","慰|勞")하기도 하였다.]
#zh[进士有三子，长子重根当年十六岁，梳着顶髻，以紫色绸巾束头，扛着一支东洋猎枪（非普通之长枪，携带极为方便），每天去老人堂和薪上洞打猎。他英姿勃勃，在军士中，他的射击技术首屈一指，无论飞禽走兽，他都百发百中，常跟他叔父泰健去打猎，有时一天能猎获狍子、马鹿多头，拿来犒赏军士们。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("진|사","進|士")의 여섯 #ruby("형|제","兄|弟")는 거의 다 술과 #ruby("독|서","讀|書")를 좋아하여 짐승을 사냥해 오면 #ruby("형|제","兄|弟")가 반드시 한데 모였고, 그 외에도 #ruby("오|주|부","吳|主|簿"), #ruby("고|산|림","高|山|林"), #ruby("최|선|달","崔|先|達") #ruby("등","等")이 모였다. 나는 술 마시고 #ruby("시","詩")를 읊조리는 데 아무 재주가 없었지만 함께 #ruby("초|청","招|請")받아 #ruby("산","山")짐승과 들새 고기의 #ruby("진|미","眞|味")를 같이 맛보고 즐겼다.]
#zh[进士六兄弟均喜饮酒吟诗，捕猎到野兽，就相聚一堂，用作佐酒的佳肴，同席还有吴主簿、高山林、崔先达等人。我虽然不善于饮酒吟诗，也常应邀共尝山珍海味。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|진|사","安|進|士")는 #ruby("자|기","自|己")의 아들과 조카들을 #ruby("위","爲")하여 #ruby("서|재","書|齋")를 만들었다. #ruby("당|시","當|時") 빨간 두루마기를 입고 머리를 땋아 늘어뜨린 8, 9#ruby("세","歲")의 #ruby("정|근","定|根")·#ruby("공|근","恭|根")에게는 “글을 읽어라” “써라” #ruby("독|려","督|勵")하면서도, 맏아들 #ruby("중|근","重|根")에게는 #ruby("공|부","工|夫") 않는다고 #ruby("질|책","叱|責")하는 것을 보지 못하였다.#footnote(numbering: _ => [71)])[#h(0.35em)#ruby("안|중|근","安|重|根")이 어려서부터 사냥을 좋아하여 글#ruby("공|부","工|夫")를 뒷전으로 미루자, #ruby("부|모","父|母")와 #ruby("선|생","先|生")은 꾸중하였다. 그러나 #ruby("안|중|근","安|重|根")은 #ruby("초|패|왕","楚|霸|王")처럼 #ruby("장|부","丈|夫")로써 살기로 #ruby("결|심","決|心")하고 글#ruby("공|부","工|夫")에는 #ruby("연|연","戀|戀")하지 않았다. 그#ruby("후","後") 아버지는 #ruby("안|중|근","安|重|根")에게 글#ruby("공|부","工|夫")를 재촉하지 않았다고 한다.]]
#zh[进士还为其子侄营建了书斋。定根、恭根当时是八岁、九岁，身穿红色长袍，留着长辫，正在读书，进士对他们总是严加督促，可是似乎对重根不怎么管束。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|진|사","安|進|士") 여섯 #ruby("형|제","兄|弟")는 모두 #ruby("문|사","文|士")의 #ruby("풍|모","風|貌")가 있었으나 #ruby("유|약","柔|弱")해 보이는 #ruby("점","點")이 하나도 없었고, #ruby("특","特")히 #ruby("안|진|사","安|進|士")는 눈빛이 찌를 듯 빛나 사람을 #ruby("압|도","壓|倒")하는 #ruby("기|운","氣|運")이 있었다. #ruby("당|시","當|時") #ruby("조|정","朝|廷") #ruby("대|관","大|官")들 #ruby("중","中")에 글로써 #ruby("항|쟁","抗|爭")하던 #ruby("자","者")들도 처음에는 #ruby("안|진|사","安|進|士")를 #ruby("악|평","惡|評")하였지만, 얼굴만 마주 #ruby("대","對")하게 되면 #ruby("부|지|불|식|간","不|知|不|識|間")에 #ruby("경|외","敬|畏")하는 #ruby("태|도","態|度")를 가지게 되었다고 한다. 나의 #ruby("관|찰","觀|察")로도 그는 퍽 #ruby("소|탈","疎|脫")하여 #ruby("무|식","無|識")한 아랫사람들에게도 #ruby("교|만","傲|慢")한 빛 하나 없이 #ruby("친|절","親|切")하고 #ruby("정|중","鄭|重")하여 위아래 모두 더불어 함께 하길 좋아하였다. #ruby("안|진|사","安|進|士")는 #ruby("면|모","面|貌")도 맑고 #ruby("수|려","秀|麗")하였지만 다만 #ruby("주|량","酒|量")이 #ruby("과","過")하여 코끝이 빨간 것이 #ruby("흠","欠")이었다.]
#zh[进士六兄弟均体格强壮，无一人虚弱，而其中老三安进士更是目光如炬，有一种威慑的力量。当时朝廷大臣中有的遭到他口诛笔伐，他们虽然对他抱有恶感，但和他见面时也不由得肃然起敬。]
#zh[依我看来，他为人洒脱，对于目不识丁的一般平民，从不骄傲，不要态度，和蔼亲切而彬彬有礼。因此，上流社会与下流社会的人们，都对他怀有好感。他面貌清秀，但由于饮酒过度，鼻端略呈红色，这可以说是他的瑕疵。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("당|시","當|時") #ruby("시|객","詩|客")들이 #ruby("안|진|사","安|進|士")가 지은 #ruby("명|작","名|作") #ruby("율|시","律|詩")들을 외우는 것을 많이 들었다. #ruby("안|진|사","安|進|士")도 #ruby("종|종","種|種") 나를 #ruby("청","請")하여 스스로 잘된 #ruby("작|품","作|品")이라 생각하는 #ruby[것][得意作]을 많이 들려주었다. 그러나 내 #ruby("기|억","記|憶")에 남는 것으로는 #ruby("동|학|당","東|學|黨")이 #ruby("창|궐","猖|獗")할 때 지은 #ruby("시","詩")만 생각난다.]
#zh[当时我常听见诗客们诵读安进士所作的名作律诗。安进士也常常请我去，把他自以为得意的作品吟给我听。可是留在我记忆里的，只有东学党猖獗时所作的一首：]
#quote-block[새벽 굼벵이는 살고자 #ruby("흔|적","痕|跡") 없이 #ruby("가버리나","曉蝎求生無跡去")]
#zh[“晓蝎求生无迹去，”]
#quote-block[저녁 모기는 죽기를 무릅쓰고 소리치며 달려든다. (夕蚊寧死有聲來)#footnote(numbering: _ => [72)])[#h(0.35em)‘#ruby("원|본","原|本")’의 #ruby("별|도","別|途")로 #ruby("삽|입","揷|入")된 #ruby("부|분","部|分")이라 그런지 ‘#ruby("등|사|본","謄|寫|本")’ ‘#ruby("필|사|본","筆|寫|本")’ 그리고 #ruby("대|부|분","大|部|分")의 ‘#ruby("출|간|본","出|刊|本")’에서 이 #ruby("시","詩")는 #ruby("누|락","漏|落")되어 있다. #ruby("시","詩") #ruby("내|용","內|容")은 아마도 1894#ruby("년","年") #ruby("동|학|농|민|전|쟁","東|學|農|民|戰|爭") 때 삶을 좇아 소리 없이 #ruby("피|신","避|身")한 #ruby("경|우","境|遇")와, 곧 죽을 줄 모르고 날뛰는 무리(#ruby("동|학|교|도","東|學|敎|徒")?)를 #ruby("양|반|적","兩|班|的") #ruby("입|장","立|場")에서 #ruby("풍|자","諷|刺")한 것으로 보인다.]]
#zh[“夕蚊宁死有声来。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|진|사","安|進|士")는 또한 #ruby("황|석|공","黃|石|公")의 『#ruby("소|서","素|書")』#footnote(numbering: _ => [73)])[#h(0.35em)#ruby("중|국","中|國") #ruby("진","秦")나라 #ruby("말|엽","末|葉")의 #ruby("병|법|가","兵|法|家"). #ruby("장|량","張|良")에게 #ruby("병|서","兵|書")를 #ruby("전","傳")해주었다고 한다. 『#ruby("소|서","素|書")』는 그가 #ruby("찬","撰")한 #ruby("책","冊")이다.] #ruby("구|절","句|節")을 #ruby("자|필","自|筆")로 써서 #ruby("벽|장","壁|欌") #ruby("문","門")에 붙이고 술#ruby("기|운","氣|運")이 있을 때마다 #ruby("낭|독","朗|讀")하였다.]
#zh[安进士又把黄石公《素书》的句子亲笔写下，贴在壁柜门上，每有酒兴便高声朗诵。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|진|사","安|進|士")의 아버지 #ruby("인|수","仁|壽") #ruby("씨","氏")는#footnote(numbering: _ => [74)])[#h(0.35em)#ruby("원|문","原|文"): “安進士 祖父 仁壽氏는”. #ruby("원|문","原|文")에서 #ruby("조|부","祖|父")는 #ruby("부|친","父|親")의 #ruby("착|오","錯|誤"). #ruby("안|인|수","安|仁|壽")는 #ruby("안|중|근","安|重|根")의 할아버지이다.]12, 3#ruby("세","世") 동안이나 #ruby("해|주","海|州") #ruby("부|내","府|內")에서 살았는데, 진해 #ruby("현감","鎭海縣監")을 #ruby("역|임","歷|任")한 뒤에 많은 #ruby("재|산","財|産")을 #ruby("친|척","親|戚")들에게 나눠주고 300#ruby("여","餘") #ruby("석","石") #ruby("추|수","秋|收")할 #ruby("자|본","資|本")만 남겨가지고, #ruby("청|계|동","淸|溪|洞")이 #ruby("산|수","山|水")가 #ruby("수|려","秀|麗")할 뿐 아니라 #ruby("피|난|지","避|難|地")가 될 만하다고 생각하고, #ruby("장|손","長|孫") #ruby("중|근","重|根")이 두 살 때 #ruby("청|계|동","淸|溪|洞")으로 #ruby("이|사","移|徙")하였다.#footnote(numbering: _ => [75)])[#h(0.35em)#ruby("안|중|근","安|重|根")이 말하는 #ruby("청|계|동","淸|溪|洞") #ruby("이|사","移|徙")의 #ruby("내|력","來|歷")은 『#ruby("백|범|일|지","白|凡|逸|志")』와 조금 다르다. #ruby("안|진|사","安|進|士")는 1884#ruby("년","年") #ruby("갑|신|정|변","甲|申|政|變") #ruby("당|시","當|時") #ruby("경|성","京|城")에 머물면서 #ruby("박|영|효","朴|泳|孝")가 #ruby("모|집","募|集")한 #ruby("해|외|파|견","海|外|派|遣") #ruby("유|학|생","留|學|生") 70#ruby("명","名")에 #ruby("선|발","選|拔")되었다. 그런데 #ruby("갑|신|정|변","甲|申|政|變")이 #ruby("실|패","失|敗")하고 #ruby("박|영|효","朴|泳|孝")가 #ruby("일|본","日|本")으로 #ruby("망|명","亡|命")하자 #ruby("안|태|훈","安|泰|勳")도 몸을 #ruby("피","避")해 #ruby("해|주","海|州")로 내려왔다. #ruby("안|태|훈","安|泰|勳")은 #ruby("출|세","出|世")의 길을 버리고 #ruby("산","山")속으로 들어가 구름과 달과 더불어 살기로 #ruby("결|심","決|心")하고, 아버지 #ruby("인|수","仁|壽")의 #ruby("승|낙","承|諾")을 받아 #ruby("가|산","家|産")을 #ruby("정|리","整|理")하고 70〜80#ruby("명","名") #ruby("대|가|족","大|家|族")을 이끌고 #ruby("청|계|동","淸|溪|洞")으로 #ruby("피|신","避|身")하였다. 그때 #ruby("안|중|근","安|重|根")의 나이는 예닐곱 살이었다.] #ruby("안|진|사","安|進|士")는 #ruby("과|거","科|擧") #ruby[수험생][擧子]으로 #ruby("경|성","京|城")의 #ruby("김|종|한","金|宗|漢")#footnote(numbering: _ => [76)])[#h(0.35em)#ruby[김|종|한][金|宗|漢]\(1844〜1932). #ruby("조|선","朝|鮮") #ruby("말|기","末|期") #ruby("문|인","文|人")·#ruby("정|치|가","政|治|家"). #ruby("홍|문|관","弘|文|館") #ruby("교|리","校|理"), #ruby("승|정|원","承|政|院") #ruby("부|승|지","副|承|旨"), #ruby("성|균|관","成|均|館") #ruby("대|사|성","大|司|成") #ruby("등","等")을 거쳐 1894#ruby("년","年") #ruby("도|승|지","都|承|旨")에 오르고 이어서 #ruby("김|홍|집","金|弘|集") #ruby("내|각","內|閣")에도 #ruby("참|여","參|與")하였다. 그는 #ruby("경|술|국|치","庚|戌|國|恥")를 #ruby("전|후","前|後")하여 #ruby("친|일","親|日")의 길을 걸었다.] 집에 #ruby("다|년|간","多|年|間") 머무르면서 #ruby("김|종|한","金|宗|漢")이 #ruby("시|관","試|官")일 때 #ruby("소|과","小|科")에 #ruby("합|격","合|格")하였다. 그리하여 #ruby("안|진|사","安|進|士")는 ‘#ruby("김|종|한","金|宗|漢")의 #ruby("문|객","門|客")’이니 ‘#ruby("식|구","食|口")’니 하는 #ruby("소|문","所|聞")이 있었다.]
#zh[进士的祖父仁寿历任镇海县监，后来将其大部分家产分给了众至亲，自己带着约可收成三百石的资金，迁移到清溪洞来隐居。此地山水秀丽，环境清幽，是个避乱的世外桃源。这时长孙重根才两岁。]
#zh[进士还是举子时，曾在京城金宗汉家住过多年，并参加了科试。他小科及第时的试官就是金宗汉，因此当时曾风传安进士是金宗汉的门客，或是他的家属。]
#heading(level: 3)[#text(font: "KOPUSGo B")[5) 스승 #ruby("고|능|선","高|能|善")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 날마다 그 집 #ruby("사|랑","舍|廊")에 다니며 놀았다. 나이가 50#ruby("여","餘") #ruby("세","歲") 되어 보이고 #ruby("기|골","氣|骨")이 #ruby("장|대","長|大")하고 #ruby("의|관","衣|冠")이 매우 #ruby("검|소","儉|素")한 #ruby("노|인","老|人") 한 분이 #ruby("종|종","種|種") #ruby("사|랑","舍|廊")에 들렀는데, #ruby("안|진|사","安|進|士")는 그분을 #ruby("지|극","至|極")히 #ruby("공|경","恭|敬")하여 #ruby("영|접","迎|接")하고 높은 자리로 모시곤 하였다. 하루는 #ruby("진|사","進|士")가 나를 #ruby("소|개","紹|介")하여 그분께 #ruby("배|알","拜|謁")시킨 #ruby("후","後") 나의 #ruby("약|력","略|歷")을 #ruby("소|개","紹|介")해 드렸다. 그분은 #ruby("고|능|선","高|能|善")#footnote(numbering: _ => [77)])[#h(0.35em)#ruby("유|인|석","柳|麟|錫")의 『#ruby("소|의|신|편","昭|義|新|編")』에 #ruby("의","依")하면 #ruby("고|능|선","高|能|善")의 이름은 #ruby("고|석|로","高|錫|魯")이다. 한#ruby("편","便") #ruby("김|형|진","金|亨|鎭")의 『#ruby("노|정|약|기","路|程|略|記")』에서는 그의 이름을 #ruby("고|석|규","高|錫|奎")라고 #ruby("기|록","記|錄")하고 있다. 아마도 『#ruby("소|의|신|편","昭|義|新|編")』의 #ruby("기|록","記|錄")이 #ruby("정|확","正|確")할 것이다.]이라는 #ruby("학|자","學|者")로, 사람들은 “#ruby("고|산|림","高|山|林"), #ruby("고|산|림","高|山|林")” 하고 불렀다. #ruby("고|능|선","高|能|善")은 #ruby("해|주","海|州") #ruby("서|문","西|門") 밖 #ruby("비|동","飛|洞")에서 #ruby("대|대","代|代")로 살았고, #ruby("유|중|암","柳|重|庵") #ruby("중|교|씨","重|敎|氏")#footnote(numbering: _ => [78)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("중|암","重|菴") #ruby("유|중|교","柳|重|敎")”. #ruby("화|서","華|西") #ruby("이|항|로","李|恒|老")의 #ruby("학|맥","學|脈")은 #ruby("중|암","重|菴") #ruby("김|평|묵","金|平|默")—#ruby("성|재","省|齋") #ruby("유|중|교","柳|重|敎")로 이어지는데, #ruby("백|범","白|凡")은 #ruby("중|암","重|菴") #ruby("김|평|묵","金|平|默")과 #ruby("성|재","省|齋") #ruby("유|중|교","柳|重|敎")를 #ruby("구|별","區|別")하지 못하고 #ruby("중|암","重|菴") #ruby("유|중|교","柳|重|敎")라 하여 #ruby("약|간","若|干")의 #ruby("착|오","錯|誤")가 있다.]의 #ruby("제|자","弟|子")며 #ruby("의|암","毅|菴") #ruby("유|인|석","柳|麟|錫")#footnote(numbering: _ => [79)])[#h(0.35em)#ruby[유|인|석][柳|麟|錫]\(1842〜1915). #ruby("한|말","韓|末")의 #ruby("위|정|척|사|론|자","衛|正|斥|邪|論|者")·#ruby("의|병|장","義|兵|將"). #ruby("호","號")는 #ruby("의|암","毅|菴"). #ruby("위|정|척|사|사|상","衛|正|斥|邪|思|想")의 #ruby("원|류","源|流")인 #ruby("이|항|로","李|恒|老")의 #ruby("문|하|생","門|下|生")으로 1895#ruby("년","年") #ruby("을|미|의|병|운|동","乙|未|義|兵|運|動")의 #ruby("핵|심","核|心") #ruby("인|사","人|士")이다.]과 #ruby("동|문","同|門")인, #ruby("당|시","當|時") #ruby("해|서|지|방","海|西|地|方")에서 #ruby("품|행","品|行")이 #ruby("방|정","方|正")하기로 이름난 #ruby("굴|지","屈|指")의 #ruby("학|자","學|者")였다. #ruby("안|진|사","安|進|士")는 #ruby("의|병","義|兵")을 일으키던 #ruby("초|기","初|期")에 #ruby("고|능|선","高|能|善")을 #ruby("모|사","謀|師")로 모셔오고, 그 집안의 세간을 다 옮겨와 #ruby("청|계|동","淸|溪|洞")에 #ruby("거|주","居|住")케 했던 터였다.]
#zh[我天天去进士府中的客舍玩耍，常见到一位老人，年约五十多岁，身材高大，衣着朴素。他来客舍，安进士向他介绍了我的简历。他就是学者高能善，人们常称他为高山林先生。]
#zh[高能善世居在海州西门外飞洞，是重庵柳仲教的门人，跟毅庵柳麟锡同门，在海西地方算是首屈一指的学者。安进士举义之初，任他为谋师，遂举家迁居到清溪洞。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 #ruby("역|시","亦|是") #ruby("안|진|사","安|進|士") #ruby("사|랑","舍|廊")에서 #ruby("고|씨","高|氏")를 만나 #ruby("종|일","終|日") 함께 논 #ruby("후","後") 헤어질 즈음에 #ruby("고|씨","高|氏")가 내게 이러한 말을 했다.]
#zh[有一天，仍在安进士客舍遇见高氏，终日相聚，临别时高氏对我这样说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("창|수","昌|洙"), 내 #ruby("사|랑","舍|廊") 구경은 좀 아니하겠나?”]
#zh[“昌洙，我的客舍，不去看看吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("감|동","感|動")하여]
#zh[我很感动，]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님 #ruby("사|랑","舍|廊")에도 가서 놀겠습니다.”]
#zh[“我也要到先生的客舍去玩。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. 다음날 #ruby("고|선|생","高|先|生") #ruby("댁","宅")을 #ruby("방|문","訪|問")하였다. #ruby("고|선|생","高|先|生")은 #ruby("노|안","老|顔")에 기쁜 빛을 띠고 #ruby("친|절","親|切")히 맞이하며 맏아들 #ruby("원|명","元|明")을 불러서 #ruby("인|사","人|事")시켰다. #ruby("원|명","元|明")은 나이가 서른이 넘었는데 그 됨됨이가 #ruby("명|민","明|敏")하게는 보였으나, #ruby("비|범","非|凡")하고 너그러운 #ruby("기|질","氣|質")은 #ruby("부|친","父|親")에게 미치지 못해 보였다. 둘째 아들은 #ruby("성|인","成|人")이 된 #ruby("후","後") #ruby("사|망","死|亡")하여 #ruby("과|부","寡|婦")며느리만 거느리고 살고 있었다. #ruby("원|명","元|明")은 열대여섯 살 된 맏딸과 네댓 살 된 딸 둘을 두었고, 아직 아들은 없다고 하였다.]
#zh[我答应了。次日便去拜访高先生府上。先生老脸上带着喜色，亲切地迎接我，叫出长子元明来见礼。元明年过三十，看来聪敏，可是那非凡而宽厚的气质不及父亲。次子成年后亡故，只留着寡居的儿媳。元明有一个十五六岁的长女，还有两个四五岁的女儿，还没有儿子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")이 #ruby("거|처","居|處")하는 #ruby("사|랑","舍|廊")은 작은 #ruby("방","房")인데, #ruby("방","房")안 가득 #ruby("서|적","書|籍")들이 쌓여 있었고, #ruby("사|면","四|面") #ruby("벽","壁")에는 이름난 옛 선비들이 남긴 #ruby("좌|우|명","左|右|銘")들과 #ruby("선|생","先|生") #ruby("자|신","自|身")이 마음 깊이 깨우쳐 얻은 #ruby[글][心得書] #ruby("등","等")을 둘러 붙여 놓았다. #ruby("고|선|생","高|先|生")은 #ruby("염|슬|위|좌","斂|膝|危|坐")#footnote(numbering: _ => [80)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “무릎을 개고 #ruby("단|정","端|正")히 앉아”. 무릎을 개고 #ruby("단|정","端|正")히 앉음.] 마음을 닦기도 하고, #ruby("간|간","間|間")이 『#ruby("손|무|자","孫|武|子")』와 『#ruby("삼|략","三|略")』 #ruby("등","等")의 #ruby("병|서","兵|書")를 읽기도 하였다.]
#zh[高先生寓居的客舍是一间小屋，房里堆满了书籍，四面墙上贴着古代名儒留下的座右铭，和他心中体悟写下的心得。高先生或敛膝危坐、静心修养，或间或读《孙武子》、《三略》等兵书。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")은 #ruby("대|화","對|話")#ruby("중","中")에 나를 보고 이런 말을 하였다.]
#zh[高先生在谈话中看着我，这样说道：]
#figure-block("/images/p56.jpg", caption: [#ruby("후|조","後|凋") #ruby("고|능|선","高|能|善") #ruby("선|생","先|生")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“자네가 #ruby("매|일","每|日") #ruby("안|진|사","安|進|士") #ruby("사|랑","舍|廊")에 다니며 놀지만, 내가 보기에는 자네에게 #ruby("절|실","切|實")히 #ruby("유|익","有|益")한 #ruby("정|신","精|神") #ruby("수|양","修|養")에는 #ruby("별","別") 도움이 없을 듯하니, #ruby("매|일","每|日") 내 #ruby("사|랑","舍|廊")에 와서 나와 같이 #ruby("세|상|사","世|上|事")도 #ruby("논","論")하고 #ruby("학|문","學|問")도 #ruby("토|론","討|論")함이 어떻겠나?”]
#zh[“你每天到安进士客舍去玩，对精神修养可能没有多大帮助，不如每天来我的客舍，一起讨论讨论学问如何？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("황|공","惶|恐") #ruby("감|사","感|謝")하였다.]
#zh[这位鸿儒对我的关切，使我诚惶诚恐，感激不已。我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님이 이처럼 저를 너그럽게 받아주시지만, #ruby("소|생","小|生")이 어찌 #ruby("감|당","堪|當")할 만한 #ruby("재|질","才|質")이 있겠습니까?”]
#zh[“先生如此厚爱，小生无才无德，愧不敢当。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")은 #ruby("미|소","微|笑")를 띠고 #ruby("명|백","明|白")히 #ruby("설|명","說|明")은 아니하였으나, 나를 아끼고 사랑하는 마음이 #ruby("충|만","充|滿")한 것을 엿볼 수 있었다.]
#zh[先生含笑不语，但可体会到他对我的一片钟爱之情。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") 나의 #ruby("심|리","心|理") #ruby("상|태","狀|態")는 매우 #ruby("절|박","切|迫")하였다. 먼저 #ruby("과|거|장","科|擧|場")에서 #ruby("비|관|적","悲|觀|的")인 생각을 품었다가 #ruby("희|망","希|望")을 #ruby("관|상|서","觀|相|書") #ruby("공|부","工|夫")로 옮겼고, 나 #ruby("자|신","自|身")의 #ruby("관|상","觀|相")이 너무도 못생긴 것을 슬퍼하다가 마음 좋은 사람이 되리라는 #ruby("결|심","決|心")을 했었다. 그러나 마음 좋은 사람이 되는 #ruby("방|법","方|法") 또한 #ruby("묘|연","渺|然")하던 #ruby("차","次")에 #ruby("동|학|당","東|學|黨")의 #ruby("수|양","修|養")을 받아 #ruby("신|국|가","新|國|家")·#ruby("신|국|민","新|國|民")을 꿈꾸었으나, 이제 와서 보면 그도 #ruby("역|시","亦|是") #ruby("포|풍","捕|風")이었다.#footnote(numbering: _ => [81)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “바람 잡듯 헛된 일”. #ruby("포|풍","捕|風") 또는 #ruby("포|풍|착|영","捕|風|捉|影")은 바람과 그림자를 잡는다는 뜻으로 헛된 것을 쫓는 것을 말한다.] 이제 #ruby("패|전","敗|戰")한 #ruby("장|수","將|帥")의 #ruby("신|세","身|世")가 되어 #ruby("안|진|사","安|進|士")의 #ruby("후|의","厚|意")를 입어 #ruby("생|명","生|命")만은 #ruby("안|전","安|全")하게 지키게 되었지만, #ruby("장|래","將|來")를 생각하면 #ruby("과|연","果|然") 어떤 곳에다 발을 디뎌야 나아갈 길을 찾을 수 있을까 하는 생각에 가슴이 답답하고 스스로 #ruby("의|심","疑|心")을 느끼던 참이었다.]
#zh[我当时心里十分抑郁苦闷，意气颓丧。我先是科场失意，继而学习观相，算知自己命途多舛，决心想做个好人，但又不知从何着手，感到渺茫，遂入东学修道，梦想建设新国家，培育新国民，至今也不过是捕风捉影。现在又成了败军之将，幸蒙安进士不弃，留给我一条生路。一想到将来，我又立足于何处？哪儿是我的进身之路？就茫然不知所措。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")이 저처럼 나를 사랑하지만, 참으로 내게 저토록 #ruby("고|명","高|明")한 #ruby("선|생","先|生")의 사랑을 받을 만한 #ruby("소|질","素|質")이 있는가? 내가 #ruby("선|생","先|生")의 #ruby("과|분","過|分")한 사랑을 받는다 해도 #ruby("종|전","從|前")에 #ruby("과|거","科|擧")니 #ruby("관|상","觀|相")이니 #ruby("동|학","東|學")이니 하던 것과 같이 아무 #ruby("효|과","效|果")도 내지 못한다면, 내 #ruby("자|신","自|身")이 #ruby("타|락","墮|落")됨은 둘째요, #ruby("고|선|생","高|先|生")과 같이 #ruby("순|결","純|潔")한 #ruby("양|반","兩|班")에게까지 #ruby("누","累")를 끼치게 될지 모른다는 두려움이 생겼다. 나는 #ruby("고|선|생","高|先|生")을 보고서 마음에 있는 그대로 말을 하였다.]
#zh[高先生那样爱我，可我真有资格承受这位高明先生的爱吗？我即便承受先生过分的爱，若像从前科举、观相、东学那样一无成效，自己堕落倒在其次，只怕连累了高先生这样纯洁的两班。我见到高先生，把心里的话照实说了：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님! #ruby("선|생","先|生")님은 저를 #ruby("분|명","分|明")히 살펴 가르쳐 주십시오. 저는 #ruby("불|과","不|過") 스무 살에 #ruby("일|생","一|生")의 #ruby("진|로","進|路")에 대하여 스스로를 속이고 그르쳐 #ruby("허|다","許|多")한 #ruby("실|패","失|敗")를 #ruby("경|험","經|驗")한바 #ruby("민|망","憫|惘")하기 이를 데 없습니다. #ruby("선|생","先|生")님이 저의 #ruby("자|격","資|格")과 #ruby("품|성","品|性")을 밝히 보시고 좋은 #ruby[점][長就]이 있다면 사랑도 하여 주시고 #ruby("교|훈","敎|訓")도 하여 주십시오. 그렇지 못하다면 저의 #ruby("발|전","發|展")은 #ruby("고|사","姑|捨")하고 #ruby("선|생","先|生")님 높으신 #ruby("덕","德")에 #ruby("누","累")를 끼치고 말 것입니다. 그렇게 되는 것은 #ruby("원","願")치 않습니다.”]
#zh[“先生不弃，开导于我。但我年方二十，误入歧途，遭受了多次失败，至今心中仍感不安。先生如认为孺子可教，将来必有长进，那就请先生多加指教。但万一我成不了大器，岂不辱没了先生崇高的德行？这实非我之所愿。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[모르는 결에 눈물이 앞을 가린다. #ruby("고|선|생","高|先|生")은 내 마음에 그러한 #ruby("고|통","苦|痛")이 있음을 #ruby("극","極")히 #ruby("동|정","同|情")하는 말로 #ruby("위|로","慰|勞")해 주셨다.]
#zh[说罢，我不由热泪盈眶。]
#zh[高先生非常理解我的心情，他同情地说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“사람이 #ruby("자|기","自|己")를 알기도 쉽지 않거든 하물며 남을 어찌 밝히 알 수 있겠는가? 그러므로 #ruby("성|현","聖|賢")을 #ruby("목|표","目|標")로 하여 발자취를 밟아가도록 하게. 예로부터 #ruby("성|현","聖|賢")의 #ruby("지|위","地|位")까지 #ruby("도|달","到|達")한 #ruby("자","者")도 있고, 좀 모자라는 #ruby("자","者")도 있고, #ruby("성|현","聖|賢")이 되는 길이 너무 높고 멀다 하여 #ruby("중|도","中|途")에 달아나거나 #ruby("자|포|자|기","自|暴|自|棄")하여 #ruby("금|수","禽|獸")만도 못한 자리에 몰려 있는 #ruby("자","者")도 있다네. 자네가 마음 좋은 사람이 되려는 생각을 가졌다면 몇 #ruby("번","番") 길을 잘못 들어서서 #ruby("실|패","失|敗")나 #ruby("곤|란","困|難")을 #ruby("경|험","經|驗")하였더라도, 그 마음 #ruby("변","變")치 말고 #ruby("개|지|불|이","改|之|不|已") #ruby("진|지|불|이","進|之|不|已")하노라면#footnote(numbering: _ => [82)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “끊임없이 고치고 나아가게”.] #ruby("목|적|지","目|的|地")에 #ruby("도|달","到|達")하는 날이 반드시 있을 것이네. #ruby("지|금","只|今")은 마음에 #ruby("고|통","苦|痛")을 가지는 것보다 #ruby("행","行")하기에 힘써야 할 것이 아닌가? #ruby("실|패","失|敗")는 #ruby("성|공","成|功")의 어머니요 #ruby("고|민","苦|悶")은 즐거움의 뿌리이니, 자네, #ruby("상|심","傷|心") 말게. 나 같은 늙은이가 자네 앞길에 #ruby("혹|시","或|是") 보탬이 된다면 그 또한 #ruby("영|광","榮|光")이 아닌가?”]
#zh[“一个人要想知己亦非易事，何况知人！古来以圣贤为标准，在踏着圣贤的足迹前进的过程中，有到达圣贤的境界的，有达不到的，也有误入歧途，自暴自弃，自甘堕落而无异于禽兽的。虽然以往你抱着做好人的宗旨，而几次误入歧途，经受了磨难和失败，但只要勿失初衷，过不惮改，日进再进的话，总有一天会达到目的的。失败乃成功之母，苦闷为快乐之本，所以不要难过，努力去做就行了！我虽老朽，能对你的前程有所补益，也很光荣啊。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")의 말씀은 내게 #ruby("위|안","慰|安")이 되었을 뿐만 아니라, 주리던 아이가 어머니 젖을 빨아먹는 것과 같았다. 나는 #ruby("고|선|생","高|先|生")에게 다시 물었다.]
#zh[听了这些话后，我感到莫大的安慰，犹如饥饿的婴儿嘬到了母亲的乳汁。我又跟高先生说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러시면 앞으로 갈 길에 대한 모든 것을 #ruby("선|생","先|生")님 보시는 대로 #ruby("교|훈","敎|訓")하여 주십시오. 마음을 다해 받들어 #ruby("행","行")하겠습니다.”]
#zh[“那么，今后该走的路，就请先生照您所看见的指教我。我一定尽心奉行。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“자네가 그같이 #ruby("결|심","決|心")하였으면, 내 눈빛이 미치는 데까지, 자네 #ruby("역|량","力|量")이 있는 데까지 내 모든 #ruby("역|량","力|量")을 다할 터이니 젊은 사람이 너무 #ruby("상|심","傷|心") 말고 #ruby("매|일","每|日") 나와 같이 노세. 갑갑할 때는 우리 #ruby("원|명","元|明")이와 #ruby("산","山") 구경도 다니며 놀게.”]
#zh[“你既有如此决心，我定按你之力所能及，尽我所知，悉心助你。年轻人不必伤心，每天来我处玩耍，闲闷无聊时也可和元明一起游山观景。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날부터 나는 밥을 안 먹어도 배고픈 줄 모르겠고, #ruby("고|선|생","高|先|生")이 죽으라면 죽을 수 있을 것 같았다. 그 다음부터는 날마다 #ruby("고|선|생","高|先|生") #ruby("사|랑","舍|廊")에 가서 놀며 지냈다. #ruby("선|생","先|生")은 #ruby("고|금","古|今")의 #ruby("위|인","偉|人")들을 #ruby("비|평","批|評")하여 주시고, #ruby("자|기","自|己")가 #ruby("연|구","硏|究")하여 깨달은 #ruby("요|체","要|諦")와 『#ruby("화|서|아|언","華|西|雅|言")』#footnote(numbering: _ => [83)])[#h(0.35em)#ruby("조|선","朝|鮮") #ruby("말|기","末|期")의 #ruby("학|자","學|者") #ruby("화|서","華|西") #ruby("이|항|로","李|恒|老")의 #ruby("저|서","著|書").]이나 『#ruby("주|자|백|선","朱|子|百|選")』#footnote(numbering: _ => [84)])[#h(0.35em)#ruby("중|국","中|國") #ruby("송","宋")나라의 #ruby("대|철|학|자","大|哲|學|者") #ruby("주|자","朱|子")가 쓴 글 #ruby("중","中")에서 100#ruby("편","篇")을 모아 엮은 #ruby("책","冊").] #ruby("중","中")에 나오는 #ruby("긴|요","緊|要")한 #ruby("절|구","節|句")를 가르쳐 주셨다.]
#zh[从这天起，我似乎忘记了饥渴，高先生若要我死，我也能以死相从。]
#zh[我每天去高先生的客舍，先生为我评论分析古今的伟人，并将他自己研究学问的心得传授给我。他给我指出《华西雅言》、《朱子百选》中重要的章句。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|생","先|生")은 주로 #ruby("의|리","義|理")가 어떤 것인지에 대해 말씀하셨다. 아무리 #ruby("발|군","拔|群")의 뛰어난 재주와 #ruby("능|력","能|力") 있는 #ruby("자","者")라도 #ruby("의|리","義|理")에서 벗어나면 #ruby("재|능","才|能")이 도리어 #ruby("화|근","禍|根")이 된다는 것과, 사람의 #ruby("처|세","處|世")는 마땅히 #ruby("의|리","義|理")에 #ruby("근|본","根|本")을 두어야 한다는 것, 그리고 일을 할 때에는 #ruby("판|단","判|斷")·#ruby("실|행","實|行")·#ruby("계|속","繼|續")의 세 #ruby("단|계","段|階")로 #ruby("사|업","事|業")을 #ruby("성|취","成|就")해야 한다는 것 #ruby("등","等"), 여러 가지 좋은 #ruby("말|씀","金|言")을 들려주셨다. 가만히 보면 언제나 내게 보여주기 #ruby("위","爲")해 #ruby("책|장","冊|張")을 접어두었다가 들쳐 보이곤 했는데, 그것만 보아도 #ruby("선|생","先|生")이 얼마나 #ruby("열|심","熱|心")히 나를 가르치고 있는지 알 수 있었다. #ruby("고|선|생","高|先|生")은 #ruby("경|서","經|書")를 #ruby("차|례","次|例")로 가르쳐 주는 것보다 나의 #ruby("정|신","精|神")과 #ruby("재|질","才|質")을 보아 떨어진 곳을 기워주고 빈 구석을 채워주는 #ruby("구|전|심|수","口|傳|心|受")#footnote(numbering: _ => [85)])[#h(0.35em)‘口傳心受’의 ‘受’는 ‘授’. #ruby("문|헌","文|獻")에 #ruby("의|존","依|存")하는 것이 아니라, #ruby("상|대|방","相|對|方")에 #ruby("절|실","切|實")히 #ruby("필|요","必|要")한 바를 #ruby("파|악","把|握")하여 말과 마음으로 #ruby("전|수","傳|授")하여 주는 것을 말한다.]의 #ruby("교|법","敎|法")이 가장 빠른 길이라 여기신 듯하였다.]
#zh[先生主要讲的是义理。一个人即便才具出众，若脱离义理，才能反成祸根；人之处世，应以义理为根本；做事则须以判断、实行、继续三段来成就事业。这些都是金玉良言。我看他总是预先把要给我看的书页折叠好，翻开来指给我，可见先生教我何等热心。高先生似乎认为，与其按次序教经书，不如看我的精神与资质，补其所缺、填其所空，以口传心授为最快的途径。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")이 나를 겪어보시고 가장 #ruby("결|점","缺|點")으로 생각한 #ruby("점","點")은 #ruby("과|단|력","果|斷|力")이 #ruby("부|족","不|足")한 #ruby("점","點")인 듯하였다. #ruby("항|상","恒|常") 무슨 일이나 밝히 보고 잘 #ruby("판|단","判|斷")하여 놓고도 #ruby("실|행","實|行")의 첫 #ruby("출|발|점","出|發|點")이 되는 #ruby("과|단|성","果|斷|性")이 없으면 다 쓸데없다는 말을 하시면서]
#zh[高先生与我相处之后，似乎认为我最大的缺点是缺乏果断。他常说，无论什么事，即便看明白了、判断对了，若没有作为实行起点的果断，便全无用处。于是讲道：]
#quote-block[가지 잡고 나무를 오르는 것은 #ruby("대|단","大|端")한 일이 아니지만, (得樹攀枝無足奇)]
#zh[“得树攀枝无足奇，”]
#quote-block[벼랑에 매달려 잡은 손을 놓는 것이 #ruby("가","可")히 #ruby("장|부","丈|夫")라 할 수 있다.(懸崖撒手丈夫兒)]
#zh[“悬崖撒手丈夫儿。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라는 #ruby("구|절","句|節")을 힘있게 #ruby("설|명","說|明")하였다.]
#zh[他用力讲解了这两句。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리 하기를 몇 달이 지났다. #ruby("안|진|사","安|進|士")도 #ruby("종|종","種|種") #ruby("고|선|생","高|先|生")을 #ruby("방|문","訪|問")하였는데, 세 사람이 모여 앉은 자리에서 #ruby("진|사","進|士")와 #ruby("고|선|생","高|先|生")이 서로 주거니 받거니 #ruby("고|금","古|今")의 일을 #ruby("강|론","講|論")하는 것을 곁에서 듣는 재미가 #ruby("비","比")할 바 없었다.]
#zh[如此过了数月。偶尔安进士来访先生，在旁边倾听他们两位谈论古今，是非常有趣的事。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("청|계|동","淸|溪|洞")에 #ruby("거|주","居|住")하면서 처음에는 갈 곳도 없고 아는 사람도 없었으므로 주로 #ruby("안|진|사","安|進|士") #ruby("사|랑","舍|廊")에 가서 놀았다. 그런데 #ruby("안|진|사","安|進|士")가 자리에 없으면 #ruby("포","砲")꾼들이 나를 #ruby("향","向")하여 들리도록 큰소리로 떠들어대곤 했다.]
#zh[我住在清溪洞，起初没处可去，也不认识人，多半到安进士客舍去玩。安进士若不在座，炮军们就故意提高嗓门，说给我听：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“저 #ruby("자","者")는 #ruby("진|사","進|士")님만 아니었으면 벌써 썩어졌을 것이다. 아직도 #ruby("접|주","接|主")님 소리 들으면서 여러 사람에게 #ruby("대|접","待|接")받던 생각이 날걸.”]
#zh[“那家伙若不是进士，早就烂掉了。还想着听人叫他接主、受众人款待的时候呢。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇고말고. 저 #ruby("자","者")는 우리 같은 #ruby("포","砲")꾼들을 #ruby("초|개","草|芥")같이 볼걸.”]
#zh[“可不是。那家伙把我们这些炮军看得跟草芥一样。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어떤 이는 입을 삐죽대며 이렇게 말하기도 했다.]
#zh[有的人撇着嘴，这样说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보게, 그런 말들 말게. 귀에 담아두었다가 #ruby("후|일","後|日") #ruby("동|학","東|學")이 다시 #ruby("득|세","得|勢")하는 날 #ruby("원|수","怨|讐") 갚을지 누가 알겠나!”]
#zh[“老兄，别说那些话。谁知道他听进耳朵里，日后东学再得势，会不会报仇！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 말을 들을 때면 #ruby("당|장","當|場")이라도 #ruby("청|계|동","淸|溪|洞") #ruby("생|활","生|活")을 벗어나고 싶은 생각이 불같이 일어났지만, #ruby("주|인","主|人")인 #ruby("안|진|사","安|進|士")가 그같이 #ruby("후|대","厚|待")하는데 #ruby("무|식","無|識")한 #ruby("병|졸","兵|卒")의 #ruby("행|동","行|動")을 탓하는 것이 못난 #ruby("행|동","行|動")이라 여겨져서 꾹 참고 견디며 지냈다.]
#zh[我听到这些冷言冷语，火冒三丈，真想立刻离开清溪洞。但转念一想，主将安进士对我不薄，现在和这些无知兵卒意气用事，反显得我气量太小，因此又忍下了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|진|사","安|進|士")는 #ruby("사|랑","舍|廊")에서 잔치를 벌이고 #ruby("흥|취","興|趣") 있게 놀 때마다 반드시 #ruby("고|선|생","高|先|生")을 모셨고, 술로나 글로나 나이로나 겉#ruby("모|양","模|樣")으로나 #ruby("좌|석","座|席")에 #ruby("광|채","光|彩")를 #ruby("감|손","減|損")식힐 것밧게 업는#footnote(numbering: _ => [86)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “자리에는 #ruby("전","全")혀 어울리지 않는”.] 나를 #ruby("초|청","招|請")하곤 하였다. 내가 #ruby("초|청","招|請")을 받고 조금만 늦어도 #ruby("포","砲")꾼이나 #ruby("하|인","下|人")에게 #ruby("분|부","分|付")하기를,]
#zh[安进士每当在客舍设宴、兴致勃勃地玩乐时，必定请来高先生，也邀请我。论酒、论文、论年纪、论外表，我在座席上只能减损光彩，可他仍邀我。我受邀稍迟一点，他就吩咐炮军或下人：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너 #ruby("속","速")히 돼지골 가서 #ruby("창|수","昌|洙") #ruby("서|방","書|房")님 모셔오너라.”]
#zh[“你快去猪谷，把昌洙书房请来。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[한다. #ruby("안|진|사","安|進|士")가 이처럼 나를 #ruby("대|우","待|遇")하니 #ruby("자|연","自|然")히 #ruby("포","砲")꾼들의 #ruby("태|도","態|度")도 내게 #ruby("공|손","恭|遜")해져 갔다. 뿐만 아니라, #ruby("안|진|사","安|進|士")의 #ruby("친","親")아우들도 #ruby("종|전","從|前")과 달리 나를 #ruby("대","對")하였다. #ruby("안|진|사","安|進|士")의 아우들은, #ruby("포","砲")꾼들이 나를 #ruby("대","對")하는 #ruby("희|롱","戲|弄") 섞인 말과 #ruby("행|동","行|動")을 곁에서 보면서도 #ruby("주|의","注|意")시키지 않았다. 이것은 처음 만나 술 한 #ruby("잔","盞")씩 나누어 보니 내게 #ruby("별","別")로 볼 것이 없다고 #ruby("판|단","判|斷")했기 때문인지, 아니면 #ruby("포","砲")꾼들의 #ruby("언|동","言|動")을 #ruby("형","兄")님에게 #ruby("보|고","報|告")하여 #ruby("안|진|사","安|進|士")가 #ruby("무|식","無|識")한 #ruby("포","砲")꾼들을 #ruby("직|접","直|接") #ruby("질|책","叱|責")하는 것은 도리어 나한테 이롭지 못할 것이라 #ruby("판|단","判|斷")해서 그런지는 잘 모르겠다. 어떻든지 #ruby("군|인","軍|人")들의 #ruby("태|도","態|度")는 #ruby("점|차","漸|次") #ruby("공|손","恭|遜")해졌고, 더욱이 #ruby("고|선|생","高|先|生")이 나를 #ruby("친|근","親|近")히 #ruby("대|접","待|接")하는 것을 본 동네 뭇사람들의 #ruby("태|도","態|度")까지도 #ruby("차|차","次|次") 달라졌다.]
#zh[他这样吩咐。安进士如此待我，炮军们的态度自然也恭顺起来。不止如此，安进士的亲兄弟也和从前不同。他们眼看炮军对我戏弄，却不加拦阻。不知是初次见面、喝过一杯，便断定我没有什么可看的，还是认为把炮军的言行报告给兄长、让安进士当面责骂这些无知的炮军，反而于我不利。不管怎样，军人们的态度渐渐恭顺了。况且村里众人看见高先生亲切待我，态度也渐渐变了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("산|증","疝|症")#footnote(numbering: _ => [87)])[#h(0.35em)#ruby("고|환","睾|丸")이나 #ruby("음|낭","陰|囊") 따위의 #ruby("질|환","疾|患")으로 일어나는 #ruby("신|경|통","神|經|痛"), #ruby("요|통","腰|痛"). #ruby("산|기","疝|氣") 또는 #ruby("산|병","疝|病")이라고도 한다.]이 몇#ruby("년","年") #ruby("전","前")부터 #ruby("시|작","始|作")되어 #ruby("종|종","種|種") #ruby("고|생","苦|生")을 하였다. 그때에도 #ruby("산|기","疝|氣")가 생겨나 #ruby("안|진|사","安|進|士") #ruby("사|랑","舍|廊")에 늘 다니는 #ruby("오|주|부","吳|主|簿")에게 물었는데, 그는 #ruby("사|삼","沙|蔘")#footnote(numbering: _ => [88)])[#h(0.35em)더덕의 뿌리. #ruby("성|질","性|質")이 차서 가래를 삭이고 #ruby("음","陰")을 돕고, #ruby("폐","肺")가 #ruby("열","熱")한 데 #ruby("사|용","使|用")한다.]을 많이 먹으면 뿌리뽑을 수 있다고 하였다. #ruby("고|선|생","高|先|生") #ruby("댁","宅")에서 놀다가 #ruby("원|명","元|明")과 함께 #ruby("약|초","藥|草") 캐는 괭이를 둘러메고 뒷#ruby("산","山")에 올라가 #ruby("사|삼","沙|蔘")도 캐고, 바위 위에 앉아서 #ruby("정|담","情|談")도 나누며 #ruby("세|월","歲|月")을 보냈다. 석 달 동안 #ruby("사|삼","沙|蔘")을 #ruby("복|용","服|用")하였더니 #ruby("과|연","果|然") #ruby("산|증","疝|症")은 깨끗이 #ruby("치|료","治|療")되었다. #ruby("소|문","所|聞")을 들은 #ruby("당|시","當|時") #ruby("신|천","信|川") #ruby("군수","信川郡守") #ruby("모|씨","某|氏")가 #ruby("안|진|사","安|進|士")에게 #ruby("청","請")하여, 내가 #ruby("사|삼","沙|蔘") 한 구럭을 캐어 보낸 일도 있다.]
#zh[我从几年前害了疹子后，体质虚弱，此时又发了病，请教常来安进士客舍的吴主簿，他说常服沙参，能断病根。因此在安进士府上玩耍后，常扛起药锄，和元明一起上后山采药，也常和元明坐在岩石上亲切交谈。采来沙参，连服三个月，疾病果然得到根治。当时信川郡守闻知此事，曾请安进士转请我采药，我采了一网兜沙参送给了他。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("매|일","每|日") #ruby("고|선|생","高|先|生") #ruby("댁","宅")에서 놀다가 밥도 #ruby("선|생","先|生")과 같이 먹고, 밤 깊고 #ruby("인|적","人|跡")이 고요할 때는 #ruby("국|사","國|事")를 #ruby("논|의","論|議")했다. #ruby("고|선|생","高|先|生")은 이런 말씀을 하셨다.]
#zh[我常常到高先生的府上去玩，跟高先生一同进餐，夜阑人寂时则谈论国事。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("만|고","萬|古") #ruby("천|하","天|下")에 #ruby("흥","興")해 보지 못한 나라가 없고 #ruby("망","亡")해 보지 못한 나라가 없네. #ruby("종|전","從|前")에는 #ruby("토|지","土|地")와 #ruby("백|성","百|姓")은 가만두고 #ruby("군|주","君|主") 자리만 빼앗는 것으로 #ruby("흥|망","興|亡")을 #ruby("논","論")하였지. 그러나 #ruby("지|금","只|今")의 #ruby("망|국","亡|國")이란 나라의 #ruby("토|지","土|地")와 #ruby("백|성","百|姓")과 #ruby("주|권","主|權")을 모두 #ruby("강|제","强|制")로 집어삼키는 것이네. 우리나라도 #ruby("필|경","畢|竟")은 #ruby("왜","倭")놈에게 #ruby("망","亡")하게 되었네. #ruby("소|위","所|謂") #ruby("조|정|대|관","朝|廷|大|官")들은 #ruby("전|부","全|部") #ruby("외|세","外|勢")에 #ruby("영|합","迎|合")하려는 #ruby[사상][媚外思想]만 가지고, 러시아를 #ruby("친","親")하여 #ruby("자|기","自|己") #ruby("지|위","地|位")를 #ruby("보|전","保|全")할까, #ruby("혹","或")은 #ruby("영|국","英|國")이나 #ruby("미|국","美|國")을, #ruby("혹","或")은 프랑스를, #ruby("혹","或")은 #ruby("일|본","日|本")을 #ruby("친","親")하여 #ruby("자|기","自|己") #ruby("지|위","地|位")를 #ruby("견|고","堅|固")히 할까, #ruby("순|전","純|全")히 이런 생각들뿐이라네. 나라는 #ruby("망","亡")하는데, #ruby("국|내","國|內")의 #ruby("최|고","最|高") #ruby("학|식","學|識")을 가졌다는 #ruby("산|림|학|자","山|林|學|者")#footnote(numbering: _ => [89)])[#h(0.35em)벼슬을 하지 않고 #ruby("재|야","在|野")에 있는, #ruby("지|조","志|操")와 #ruby("덕|망","德|望") 있는 #ruby("학|자","學|者").]들도 #ruby("한|탄","恨|歎")하고 혀만 차고 있을 뿐 어떠한 #ruby("구|국","救|國")의 #ruby("경|륜","經|綸")도 보이지 않으니 큰 #ruby("유|감","遺|憾")일세. 나라가 #ruby("망","亡")하는 데도 #ruby("신|성","神|聖")하게 #ruby("망","亡")하는 것과 더럽게 #ruby("망","亡")하는 것이 있는데, 우리나라는 더럽게 #ruby("망","亡")하게 되겠네.”]
#zh[高先生曾说，自古以来，天下没有不曾兴旺过的国家，也没有不曾灭亡过的国家。但过去所谓亡国，只指夺得君位而言，今则不同，土地、人民、主权，俱皆并吞。我国也是要亡的，最终将亡于日本。朝廷大臣都有媚外思想，有的亲俄，有的亲英、美、法、日，以保全和巩固自己的地位，全然不顾国家之兴亡。拥有最高学识的山林学者，也只是发发感叹，提不出任何救国的纲领，实为最大的憾事。亡国，有的亡得伟大，有的亡得可耻，我国将是亡得最可耻。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 놀라 #ruby("질|문","質|問")하자, #ruby("선|생","先|生")은 #ruby("대|답","對|答")하였다.]
#zh[我大吃一惊，问了。先生回答说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("일|반","一|般") #ruby("백|성","百|姓")들이 #ruby("의","義")를 붙잡고 끝까지 싸우다가 #ruby("복|몰","覆|沒")하는 것은#footnote(numbering: _ => [90)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “함께 죽는 것”. #ruby("복|몰","覆|沒")은 배가 뒤집혀 가라앉듯 #ruby("이|탈|자","離|脫|者") 없이 함께 죽는 것.] #ruby("신|성","神|聖")하게 #ruby("망","亡")하는 것이요, #ruby("일|반","一|般") #ruby("백|성","百|姓")과 #ruby("신|하","臣|下")가 #ruby("적","敵")에게 #ruby("아|부","阿|附")하다 꾐에 빠져 #ruby("항|복","降|伏")하는 것은 더럽게 #ruby("망","亡")하는 것일세. #ruby("지|금","只|今") #ruby("왜","倭")놈 #ruby("세|력","勢|力")은 온 나라에 차고 넘쳐 #ruby("대|궐","大|闕") 안까지 #ruby("침|입","侵|入")하여 #ruby("대|신","大|臣")들을 마음대로 내치니 우리나라를 #ruby("제","第")2의 #ruby("왜|국","倭|國")으로 만든 것 아니겠는가? #ruby("만|고|천|하","萬|古|天|下")에 #ruby("무","無") #ruby("장|존|불|망|지|국","長|存|不|亡|之|國")이오, #ruby("만|고|천|하","萬|古|天|下")에 #ruby("무","無") #ruby("장|생|불|사|지|인","長|生|不|死|之|人")인즉,#footnote(numbering: _ => [91)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("만|고","萬|古") #ruby("천|하","天|下")에 #ruby("망","亡")하지 않은 나라 없고 죽지 않는 사람이 없은즉”.] 자네나 나나 죽음으로 #ruby("충|성","忠|誠")하는 #ruby("일|사|보|국","一|死|報|國") 한 가지 일만 남아 있네.”]
#zh[“所谓亡得伟大，是其国民为义而战，力尽而亡；所谓亡得可耻，乃是向敌人阿谀奉承，最终中了敌人圈套，投降而亡。]
#zh[目前倭寇的势力遍布我国，甚至于宫中也不免，大臣任免也要受敌人的支配，我国岂不是成了倭寇的一部分了吗？天下哪里有万古不亡之国和不死之人乎？目前我们只有一死报国之一途罢了！”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|생","先|生")은 슬픈 낯빛으로 나를 보았다. 나도 울고 또 물었다.]
#zh[说过这些话后，先生以沉重的表情看着我，我也无法克制悲愤而失声。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그런데 #ruby("망","亡")할 것으로 하여금 #ruby("망","亡")치 않게 할 #ruby("방|침","方|針")은 없습니까?”]
#zh[“可是，有没有办法使将亡的不至于亡呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“자네 말이 옳네. #ruby("기|왕","旣|往") #ruby("망","亡")할 나라라도 #ruby("망","亡")치 않게 힘써 보는 것이 #ruby("백|성","百|姓")된 #ruby("자","者")의 #ruby("의|무","義|務")지. #ruby("지|금","只|今") #ruby("조|정","朝|廷") #ruby("대|신","大|臣")과 같이 #ruby("무|조|건","無|條|件") #ruby("외|세","外|勢")에 #ruby("영|합","迎|合")하지 말고 #ruby("청|국","淸|國")과 서로 #ruby("연|합","聯|合")할 #ruby("필|요","必|要")가 있네. #ruby("작|년","昨|年") #ruby("청|일|전|쟁","淸|日|戰|爭")에서 #ruby("패","敗")했으니 #ruby("청","淸")나라도 언젠가 #ruby("복|수|전|쟁","復|讐|戰|爭")을 한#ruby("번","番") 벌이려 할 것이네. #ruby("적|당","適|當")한 #ruby("인|재","人|材")가 있으면 #ruby("청","淸")나라에 가서 #ruby("사|정","事|情")도 #ruby("조|사","調|査")하고 #ruby("인|물","人|物")과 #ruby("연|락","連|絡")하여 #ruby("후|일","後|日") 한 목소리로 #ruby("대|처","對|處")하는 것이 #ruby("절|대","絶|對") #ruby("필|요","必|要")한데, 자네 한#ruby("번","番") 가 보려나?”]
#zh[“你说得对。即便是将亡之国，也要努力使它不亡，这是做百姓的义务。不可像当今朝廷大臣那样无条件迎合外势，而须与清国互相联合。去年清日战争清国打了败仗，清国总有一天要打一场复仇之战。若有适当的人才，就该到清国去调查情形，和人物联络，日后同声对付，这是绝对必要的。你可愿去一趟？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“저같이 #ruby("무|지","無|知")하고 #ruby("지|각","知|覺") 없는 어린것이 간들 무슨 #ruby("효|과","效|果")를 얻겠습니까?”]
#zh[我问他：]
#zh[“像我这样一个年少不懂事的人，去了能有什么作为呢？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")은 #ruby("반","半")쯤 웃으시면서 이런 말씀을 하셨다.]
#zh[高先生半笑着这样说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“자네만으로 생각하면 그렇지. 그렇지만 이런 생각을 하는 #ruby("동|지","同|志")들이 많으면 #ruby("청","淸")나라의 #ruby("정|계","政|界")·#ruby("학|계","學|界")·#ruby("상|계","商|界") #ruby("각","各") #ruby("방|면","方|面")으로 들어가서 #ruby("활|동","活|動")을 할 수 있지 않겠나? #ruby("지|금","只|今")은 누가 그런 뜻을 가진 사람인지 알 수 없으니 자네 한 사람이라도 그렇게 하는 것이 #ruby("유|익","有|益")하겠다 싶으면 그대로 #ruby("실|행","實|行")하여 보는 것뿐이지.”]
#zh[“光你一人，自然不行，如果我们有很多同志前往清国，在政治界、学术界或商业界活动，这样的人就会日益增多，现在虽然只有你一人，但这样努力下去，往后必有裨益。你不妨一试。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("흔|쾌","欣|快")히 #ruby("약|조","約|條")하였다.]
#zh[我欣然约定了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“마음이 #ruby("항|상","恒|常") #ruby("울|적","鬱|寂")하니 먼 곳 바람도 쏘일 #ruby("겸","兼") 떠나보겠습니다.”]
#zh[“心里常常郁闷，就借此去远处吹吹风，我动身吧。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")은 #ruby("심","甚")히 #ruby("만|족","滿|足")해 하며 말씀하셨다.]
#zh[高先生十分满意，说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“자네가 떠나고 나면 #ruby("부|모","父|母")님이 외롭고 쓸쓸할 터이니, 자네 아버님과 내가 우리 #ruby("사|랑","舍|廊")에 모여 이야기나 하고 놀겠네.”]
#zh[“你走后你双亲会感到孤独，令尊可到我客舍和我闲谈消遣。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 고맙게 생각하며 또 물었다.]
#zh[我无限感激。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("안|진|사","安|進|士")와도 #ruby("상|의","相|議")를 하면 어떻겠습니까?”]
#zh[“和安进士也商量一下，如何？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|선|생","高|先|生")은 이러한 말을 한다.]
#zh[高先生这样说道：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("안|진|사","安|進|士")의 #ruby("의|향","意|向")을 #ruby("짐|작","斟|酌")하는바, #ruby("천|주|학","天|主|學")을 해볼 마음이 있으니, #ruby("만|일","萬|一") 그와 같이 #ruby("서|양","西|洋") 오랑캐를 #ruby("의|뢰","依|賴")할 마음이 있다면 그것은 #ruby("대|의","大|義")에 #ruby("위|반","違|反")된 #ruby("행|동","行|動")이네. #ruby("안|진|사","安|進|士")에 대한 #ruby("태|도","態|度")는 #ruby("후|일","後|日") #ruby("결|정","決|定")할 날이 또 있을 것이니, #ruby("출|국","出|國") #ruby("문|제","問|題")는 말하지 않는 것이 좋겠네. 다만 #ruby("안|진|사","安|進|士")는 #ruby("확|실","確|實")한 #ruby("인|재","人|材")이니, 자네가 #ruby("청|국","淸|國")에 가서 #ruby("유|력","遊|歷")한 #ruby("결|과","結|果") #ruby("양|호","良|好")한 #ruby("동|기","動|機")가 잇을 지경이면#footnote(numbering: _ => [92)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “여러 곳을 다녀보고 그 #ruby("결|과","結|果") 좋은 #ruby("기|회","機|會")가 생기게 되면”.] 그때 가서 #ruby("상|의","相|議")하여도 늦지 않을 것이네. 그러니 이#ruby("번","番") 일은 #ruby("비|밀","祕|密")에 부치고 떠나는 것이 좋을 것 같네.”]
#zh[“我揣摩安进士的意向，他有心学天主学。万一他存着依赖西洋夷狄的心，那便是违反大义的行为。对安进士的态度，日后还有决定的日子，出国的事还是不说为好。不过安进士确是个人才，你到清国游历，结果若有良好的机会，那时再商量也不晚。所以这一次还是保密动身的好。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("고|선|생","高|先|生")의 말씀을 옳게 여기고 #ruby("출|발","出|發")을 #ruby("준|비","準|備")하였다.]
#zh[我认为他说得有理，于是便悄悄地准备启程远行。]
