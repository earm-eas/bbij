#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제","第")1#ruby("차","次")로 #ruby("비|행|기","飛|行|機")로 #ruby("김|포","金|浦")를 #ruby("출|발","出|發")하여 #ruby("제|주|도","濟|州|島")에 #ruby("착|륙","着|陸")하였다. #ruby("제|주|도","濟|州|島")에 #ruby("주|재","駐|在")한 #ruby("미|군|정|청","美|軍|政|廳")을 비롯하여 #ruby("각","各") #ruby("정|당|단|체","政|黨|團|體")와 #ruby("교|육","敎|育")·#ruby("교|회","敎|會") #ruby("각","各") #ruby("공|장","工|場") #ruby("부|문","部|門")에서 #ruby("총|출|동","總|出|動")하여 #ruby("개|최","開|催")한 #ruby("환|영|회","歡|迎|會")를 #ruby("일|대","一|大") #ruby("성|황|리","盛|況|裡")에 끝마쳤다. 그런 다음 #ruby("고","高")·#ruby("부","夫")·#ruby("양","梁") 3#ruby("씨","氏")의 #ruby("시|조","始|祖")인 #ruby("삼|성|전","三|聖|殿")에 #ruby("참|배","參|拜")한 #ruby("후","後"), 그 아래 #ruby("삼|성|혈","三|聖|穴")#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("제|주|시","濟|州|市") #ruby("동|문","東|門") 밖 #ruby("송|림","松|林")에 있는 #ruby("굴","窟"). 이곳에서 #ruby("고|을|나","高|乙|那"), #ruby("부|을|나","夫|乙|那"), #ruby("양|을|나","良|乙|那")의 세 #ruby("신","神")이 나와 #ruby("탐|라|국","耽|羅|國")을 #ruby("건|국","建|國")하였다고 한다.]을 #ruby("시|찰","視|察")하고, 다시 #ruby("해|안","海|岸")으로 나가 #ruby("제|주|도","濟|州|島")의 #ruby("특|색","特|色")인 #ruby("해|녀","海|女")들이 #ruby("잠|수","潛|水")하여 #ruby("해|산|물","海|産|物")을 #ruby("섭|취","攝|取")하는 #ruby("광|경","光|景")을 #ruby("관|람","觀|覽")하였다. 마침 #ruby("우|기","雨|期")라 #ruby("일|기","日|氣") #ruby("관|계","關|係")로 마음에 #ruby("정","定")해 두었던 #ruby("한|라|산","漢|拏|山")은 #ruby("관|람","觀|覽")치 못하고 #ruby("귀|환","歸|還")하였다.]
#zh[第一次乘飞机从金浦出发，在济州岛着陆。驻济州岛的美军政厅，以及各政党团体、教育、教会、各工厂部门总出动，欢迎会在一大盛况里结束。然后参拜高、夫、良三氏始祖的三圣殿，视察下面的三圣穴，再出海边，观看济州岛特有的海女潜水采取海产。正值雨期，因为天气，心里定要看的汉拏山没有看成，就回来了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後") 다시 #ruby("삼|남","三|南") #ruby("시|찰|차","視|察|次") #ruby("열|차","列|車")로 #ruby("부|산|역","釜|山|驛")에 #ruby("도|착","到|着")하였다.#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("백|범","白|凡")의 #ruby("삼|남|지|방","三|南|地|方") #ruby("순|회","巡|廻") #ruby("시|기","時|期")는 1946#ruby("년","年") 9#ruby("월","月")이었다.] 그곳에서 다시 #ruby("자|동|차","自|動|車")로 갈아타고 #ruby("진|해","鎭|海")에 가서, #ruby("해|군","海|軍") #ruby("총|사|령|장|관","總|司|令|長|官") #ruby("손|원|일","孫|元|一")의 #ruby("안|내","案|內")로 그가 #ruby("지|도","指|導")하는 #ruby("해|안|경|비|대","海|岸|警|備|隊")의 #ruby("열|병|식","閱|兵|式")을 마쳤다. 그리고는 #ruby("과|거","過|去") #ruby("임|진|란","壬|辰|亂") 때 #ruby("충|무|공","忠|武|公") #ruby("이|순|신","李|舜|臣") #ruby("장|군","將|軍")이 #ruby("왜|적","倭|敵")을 #ruby("격|침","擊|沈")하였던 #ruby("한|산|도","閑|山|島") #ruby("제|승|당","制|勝|堂")#footnote(numbering: _ => [11)])[#h(0.35em)#ruby("경|상|남|도","慶|尙|南|道") #ruby("통|영|군","統|營|郡") #ruby("한|산|면","閑|山|面") #ruby("한|산|도","閑|山|島")에 #ruby("소|재","所|在")하는 #ruby("이|순|신","李|舜|臣")의 #ruby("사|령|부","司|令|部")가 있던 곳. 1740#ruby("년","年")에 #ruby("통|제|사","統|制|使") #ruby("조|경","趙|儆")이 이 옛터에 #ruby("유|허|비","遺|墟|碑")를 세우고 #ruby("제|승|당","制|勝|堂")이라 이름한 데서 그 #ruby("명|칭","名|稱")이 #ruby("유|래","由|來")되었다.]을 #ruby("방|문","訪|問")하고 #ruby("충|무|공","忠|武|公") #ruby("영|정","影|幀")에 #ruby("참|배","參|拜")하였다. #ruby("참|배","參|拜") #ruby("후","後") #ruby("좌|우","左|右")를 살펴보니 #ruby("제|승|당","制|勝|堂")이라는 #ruby("현|판","懸|板")이 땅에 떨어져 있는 것이 아닌가. 그 #ruby("연|고","緣|故")를 물으니, #ruby("왜|정|시|대","倭|政|時|代")에 떼고 달지 못한 것이라 하였다. 나는 #ruby("지|금","只|今")까지 #ruby("보|관","保|管")한 것만도 #ruby("다|행","多|幸")이라 #ruby("생|각","生|覺")하여 #ruby("즉|시","卽|時")로 그 #ruby("현|판","懸|板")을 걸게 하고 돌아나와 #ruby("진|해","鎭|海")를 #ruby("시|찰","視|察")하였다.]
#zh[后来又为视察三南，坐火车到了釜山站。从那里换乘汽车去镇海，由海军总司令长官孙元一引导，看完了他指导的海岸警备队阅兵式。然后访问壬辰乱时忠武公李舜臣将军击沉倭船的闲山岛制胜堂，参拜忠武公的影像。参拜后左右一看，制胜堂的匾额竟掉在地上。问缘故，说是倭政时代摘下来，没能再挂。我想能保存到现在已经是幸事，立刻让人把匾挂上，出来视察了镇海。]
#figure-block("/images/p408.jpg", caption: [#ruby("한|산|도","閑|山|島") #ruby("제|승|당","制|勝|堂")을 #ruby("방|문","訪|問")하여])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("진|해","鎭|海")는 #ruby("원|래","元|來") #ruby("조|선","朝|鮮")의 #ruby("요|새|지","要|塞|地")로 #ruby("해|군","海|軍")의 #ruby("근|거|지","根|據|地")일 뿐만 아니라 #ruby("각|종","各|種") #ruby("해|산|물","海|産|物")이 #ruby("풍|부","豐|富")히 #ruby("생|산","生|産")되는 곳이었다. 그곳에서 #ruby("경|비|함","警|備|艦")을 타고 #ruby("통|영","統|營")에 #ruby("상|륙","上|陸")하여 #ruby("여|수","麗|水")·#ruby("순|천","順|天") #ruby("등|지","等|地")를 #ruby("시|찰","視|察")하니 가는 곳마다 #ruby("환|영|회","歡|迎|會")가 끊이지 않았다.]
#zh[镇海本来是朝鲜的要塞，不仅是海军的根据地，各种海产也出产丰富。从那里坐警备舰在统营上岸，视察丽水、顺天等地，所到之处欢迎会不断。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("보|성|군","寶|城|郡") #ruby("득|량|면","得|粮|面") #ruby("득|량|리","得|粮|里")#footnote(numbering: _ => [12)])[#h(0.35em)#ruby("원|주","原|註"): “古名은 松谷”. #ruby("현|지","現|地")에서는 ‘쇠실마을’이라고 부른다.]는 48#ruby("년","年") #ruby("전","前") #ruby("망|명","亡|命")할 때 #ruby("수|삼","數|三") #ruby("개|월","個|月")이나 머물렀던 곳이다. 그곳은 나의 #ruby("동|족","同|宗")들이 일군 #ruby("동|족","同|宗")#ruby("부|락","部|落")인데, #ruby("동|족","同|宗")들은 #ruby("물|론","勿|論")이고 #ruby("인|근","隣|近") #ruby("지|방","地|方") #ruby("동|포","同|胞")들의 #ruby("환|영","歡|迎") #ruby("역|시","亦|是") #ruby("성|황","盛|況")을 이루었다. #ruby("입|구","入|口")의 #ruby("도|로","道|路")를 #ruby("수|리","修|理")하고 #ruby("솔|문","松|門")#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("경|축","慶|祝")이나 #ruby("환|영","歡|迎")의 뜻을 나타내기 #ruby("위","爲")해 대나 나무로 기둥을 하고 푸른 솔잎으로 싸서 만든 #ruby("문","門").]을 세웠으며, #ruby("환|영","歡|迎")나온 #ruby("남|녀","男|女") #ruby("동|포","同|胞")들이 #ruby("도|열","堵|列")하여 나를 맞이하는지라 #ruby("차","車")를 멈추고 걸어서 동네로 들어갔다.]
#zh[我巡回三南地方的途中，顺道去看宝城郡得粮面得粮里的金氏村庄。我在四十八年前曾经在这地方匿居了三个月，加以金氏和我是同宗，听到我要来的消息，便在村口搭起松枝牌楼，路也都扫得干干净净，男女村民们在村口排着长队迎接我。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 48#ruby("년","年") #ruby("전","前") #ruby("유|숙","留|宿")하며 글을 보던 #ruby("고","故") #ruby("김|광|언","金|廣|彦") #ruby("씨","氏")의 #ruby("가|옥","家|屋")은 옛날 그대로의 모습으로 나를 #ruby("환|영","歡|迎")하니, #ruby("불|귀","不|歸")의 #ruby("객","客")이 된 #ruby("김|광|언","金|廣|彦") #ruby("씨","氏")에 #ruby("대","對")한 #ruby("감|회","感|懷")를 #ruby("금","禁")할 수 없었다. 그 옛날 내가 #ruby("식|사","食|事")하던 그 자리에서 다시 한#ruby("번","番") #ruby("음|식","飮|食")을 #ruby("대|접","待|接")하고자 한다 하여, 마루 위에 #ruby("병|풍","屛|風")을 두르고 #ruby("정|결","淨|潔")한 자리에 #ruby("편","便")히 앉으니, 눈앞에 보이는 #ruby("산|천","山|川")은 예전 그대로이나 옛 사람들은 #ruby("별","別")로 없었다. 모인 #ruby("동|포","同|胞")들을 #ruby("향","向")하여,]
#zh[四十八年前我留宿念书的故金广彦的房屋，还是从前的样子欢迎我，对已经作了不归之客的金广彦，感怀不能自禁。他们说要在从前我吃饭的那个位子再招待一次，廊上围了屏风，坐在洁净的位子上，眼前的山川还是旧时，旧人却没有了。我对聚集的同胞问：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("혹|시","或|是") 나를 아는 사람이 있는가?”]
#zh[“有没有认识我的人？”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 물으니, 동네 #ruby("여|자","女|子") #ruby("노|인","老|人") 한 분이 #ruby("대|답","對|答")하였다.]
#zh[这样一问，村里一位女子老人回答。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 일곱 살 때 #ruby("선|생","先|生")님 글#ruby("공|부","工|夫")하시던 #ruby("좌|석","座|席")에서 놀던 #ruby("기|억","記|憶")이 새롭습니다.”]
#zh[“我七岁的时候，在先生念书的座位上玩过，那记忆还新。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("외","外") #ruby("동|족","同|宗") #ruby("중","中") 한 사람인 #ruby("김|판|남","金|判|男") #ruby("씨","氏")가 나와서, 48#ruby("년","年") #ruby("전","前") 나의 #ruby("필|적","筆|跡")이 #ruby("완|연","宛|然")한 #ruby("책","冊") 한 #ruby("권","卷")을 내보이며#footnote(numbering: _ => [14)])[#h(0.35em)#ruby("백|범","白|凡")이 #ruby("인|천|감|옥","仁|川|監|獄") #ruby("탈|옥","脫|獄") #ruby("후","後") #ruby("김|광|언","金|廣|彦") #ruby("가","家")에 #ruby("피|신","避|身")하면서 #ruby("애|독","愛|讀")하고 헤어질 때 #ruby("선|물","膳|物")로 준 #ruby("책","冊")은 『#ruby("동|국|사|기","東|國|史|記")』이다.] 옛일이 어제 같다고 말하였다. #ruby("전","前")에 나와 알던 이는 이 두 사람뿐이었다.]
#zh[此外同宗里的金判男出来，拿出四十八年前我笔迹宛然的一本书，说旧事像昨天一样。从前认识我的，只有这两个人。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("중","中")에 또 잊지 못할 한 가지 #ruby("사|실","事|實")이 있다. 다름 아닌 48#ruby("년","年") #ruby("전","前") #ruby("동|갑","同|甲") 되는 #ruby("선","宣")#ruby("씨","氏") 한 사람이 있어, 나와 #ruby("격|의","隔|意") 없이 지내다가 내가 그 동네를 떠날 때, 그 #ruby("부|인","夫|人")의 손으로 만든 #ruby("필|낭","筆|囊")#footnote(numbering: _ => [15)])[#h(0.35em)붓을 넣어서 차던 주머니.] 하나를 #ruby("작|별","作|別") #ruby("기|념","紀|念")으로 내게 주었던 일이 눈에 선하다. 그 #ruby("선|씨","宣|氏")에 #ruby("대","對")해서 물으니,]
#zh[其中还有一件不能忘记的事。四十八年前有一位和我同庚的宣氏，和我没有隔意，我离开村子的时候，他夫人亲手做的一只笔囊作为作别纪念送给我，还像在眼前。我问起那位宣氏：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|씨","宣|氏")는 이미 #ruby("세|상","世|上")을 떠났고, 그 #ruby("부|인","夫|人")과 #ruby("가|족","家|族")은 #ruby("보|성|읍","寶|城|邑") #ruby("부|근","附|近")에 #ruby("거|주","居|住")합니다. 그 #ruby("노|부|인","老|夫|人") #ruby("역|시","亦|是") 옛일을 잊지 않고 #ruby("선|생","先|生")님이 #ruby("지|금","只|今") 가시는 #ruby("보|성|읍","寶|城|邑")으로 마중나온다 합니다.”]
#zh[“宣氏已经离开了人世，夫人和家族住在宝城邑附近。那位老夫人也没有忘记旧事，听说要到先生现在要去的宝城邑来迎接。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("소|식","消|息")을 #ruby("전","傳")하였다.]
#zh[这样把消息传了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 그 동네를 떠나 #ruby("보|성|읍","寶|城|邑")에 #ruby("도|달","到|達")하니, #ruby("과|연","果|然") 그 #ruby("부|인","夫|人")이 #ruby("전","全") #ruby("가|족","家|族")을 거느리고 마중나온 #ruby("광|경","光|景")은 참으로 #ruby("감|격","感|激")에 넘치었다. 만나는 자리에서 나이를 물으니 나와 #ruby("역|시","亦|是") #ruby("동|갑","同|甲")이라, #ruby("과|거|사","過|去|事")를 잠깐 #ruby("토|론","討|論")하며 만나고 헤어지는 #ruby("예","禮")를 마치었다.]
#zh[那天离开村子到了宝城邑，果然那位夫人带着全家来迎接，光景真是充满感激。见面问年纪，也和我同庚。略谈往事，行了相见相别的礼。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그곳에서 #ruby("환|영","歡|迎")과 #ruby("강|연","講|演")을 마친 #ruby("후","後") #ruby("보|성","寶|城")을 떠나 #ruby("광|주","光|州")까지 가는 사이에 #ruby("환|영","歡|迎")은 이루 #ruby("언|급","言|及")하기조차 어려울 #ruby("정|도","程|度")였다. #ruby("역|로","驛|路")마다 #ruby("수","數")많은 #ruby("동|포","同|胞")들이 #ruby("대|기","待|機")·#ruby("환|영","歡|迎")하니, 어떤 날은 3, 4#ruby("차","次")를 #ruby("경|유","經|由")한 적도 있었다. 이로부터 며칠 #ruby("후","後") #ruby("광|주","光|州")에 #ruby("도|착","到|着")하여 보니, #ruby("도|처","到|處")에서 #ruby("동|포","同|胞")들이 주는 #ruby("각|종","各|種") #ruby("기|념|선|물","紀|念|膳|物")·#ruby("해|산|물","海|産|物")·#ruby("육|산|물","陸|産|物")·#ruby("금|품","金|品") #ruby("등","等")을 #ruby("종|합","綜|合")한 것이 #ruby("차","車")에 가득 찼다. #ruby("광|주","光|州")에 #ruby("전|재|민","戰|災|民")이 많다는 말을 듣고 #ruby("시|장","府|尹")을 #ruby("초|청","招|請")하여, #ruby("다|소|간","多|少|間") #ruby("전|재|민","戰|災|民")을 돕는 데 보태어 쓰라고 #ruby("부|탁","付|託")하여 주고 #ruby("광|주","光|州") #ruby("환|영|회","歡|迎|會")를 마쳤다.]
#zh[在那里结束欢迎和讲演后离开宝城，到光州的路上，欢迎热闹得难以一一说。每一段驿路都有许多同胞等候欢迎，有的日子绕道三四处。几天后到了光州，各处同胞送的各种纪念品、海产、陆产、金钱，合起来装满了车子。听说光州战灾民很多，我请来府尹，拜托他把这些多少添在救助战灾民上，结束了光州的欢迎会。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("광|주","光|州")를 #ruby("출|발","出|發")하여 #ruby("나|주","羅|州")를 #ruby("향","向")하는 #ruby("도|중","途|中") #ruby("함|평|군","咸|平|郡")을 지날 때였다. #ruby("수","數")많은 #ruby("동|포","同|胞")가 길을 막고 #ruby("잠|시","暫|時")라도 #ruby("함|평|읍","咸|平|邑")을 들러 달라고 #ruby("소|원","所|願")하기에, #ruby("부|득|이","不|得|已") #ruby("함|평|읍","咸|平|邑")을 들러서 #ruby("학|교","學|校") #ruby("광|장","廣|場")에서 #ruby("수","數")많은 #ruby("동|포","同|胞")를 #ruby("상|대","相|對")로 #ruby("환|영","歡|迎") #ruby("강|연","講|演")을 마치고, 날이 저물 무렵에서야 #ruby("나|주|읍","羅|州|邑")에 #ruby("도|착","到|着")하였다.#footnote(numbering: _ => [16)])[#h(0.35em)이때는 1946#ruby("년","年") 가을로 #ruby("백|범","白|凡")은 #ruby("대|한|독|립|촉|성|국|민|회","大|韓|獨|立|促|成|國|民|會") #ruby("나|주|지|부","羅|州|支|部")에 ‘萬衆一心’(모든 사람이 한마음으로)이란 #ruby("휘|호","揮|毫")를 써 주었다.]]
#zh[从光州出发去罗州，途中经过咸平郡。许多同胞挡住路，希望哪怕暂时也到咸平邑去，不得已绕到咸平邑，在学校广场对许多同胞结束了欢迎讲演，天色将黑才到罗州邑。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("팔|각|정","八|角|亭") #ruby("이|진|사","李|進|士") #ruby("댁","宅")#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("이|진|사","李|進|士")의 이름은 #ruby("이|동|범","李|東|範")\(1869〜1940)이며, #ruby("팔|각|정","八|角|亭")은 #ruby("육|모|정","六|角|亭")의 #ruby("착|오","錯|誤")이다. #ruby("함|평","咸|平") #ruby("읍|내","邑|內")의 #ruby("이|진|사","李|進|士") #ruby("댁","宅") #ruby("본","本")채는 아직 남아 있으나 #ruby("백|범","白|凡")이 #ruby("은|거","隱|居")하였던 #ruby("초|옥","草|屋")의 #ruby("육|모|정","六|角|亭")은 1935#ruby("년","年") #ruby("신|작|로","新|作|路")가 #ruby("개|통","開|通")되면서 헐렸다.]의 #ruby("소|식","消|息")을 #ruby("탐|문","探|問")하니 #ruby("이|진|사","李|進|士") #ruby("댁","宅")은 #ruby("함|평|읍","咸|平|邑")인데, 아까 #ruby("만|세","萬|歲")를 #ruby("선|창","先|唱")한 그이가 바로 #ruby("이|진|사","李|進|士")의 둘째 아들이라고 하였다. 그때서야 #ruby("세|월","歲|月")이 #ruby("장|구","長|久")한 #ruby("관|계","關|係")로 #ruby("함|평","咸|平") #ruby("이|진|사","李|進|士") #ruby("댁","宅")을 #ruby("나|주","羅|州")로 #ruby("혼|동","混|同")한 것을 깨달았다. #ruby("함|평|군","咸|平|郡") #ruby("함|평|면","咸|平|面") #ruby("함|평|리","咸|平|里")의 #ruby("이|재|혁","李|在|赫")·#ruby("이|재|승","李|在|承") #ruby("등","等")은 #ruby("이|진|사","李|進|士")의 #ruby("손|자","孫|子")들이다.#footnote(numbering: _ => [18)])[#h(0.35em)‘李在承’은 ‘李載昇’. ‘李在赫’은 ‘李載爀’의 #ruby("착|오","錯|誤")이다. 또한 이들은 #ruby("이|진|사","李|進|士")의 #ruby("손|자","孫|子")가 아니라 첫째·둘째 아들이다.] 이들이 얼마 #ruby("후","後")에 #ruby("예|물","禮|物")을 #ruby("휴|대","携|帶")하고 서울로 나를 찾아왔기에, 나는 그때 #ruby("착|각","錯|覺")한 #ruby("사|실","事|實")을 #ruby("솔|직","率|直")히 #ruby("사|과","謝|過")하였다.]
#zh[探问八角亭李进士的家，李进士家在咸平邑，刚才领头呼万岁的人就是李进士的二儿子。这才明白，因为岁月长久，把咸平李进士家和罗州混同了。咸平郡咸平面咸平里的李在赫、李在承等是李进士的孙子。他们过了不久带着礼物到汉城来看我，我把当时错觉的事坦白道歉了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("나|주","羅|州")를 떠나 #ruby("김|해","金|海")에 #ruby("도|착","到|着")하니 때마침 #ruby("수|로|왕|릉","首|露|王|陵")의 #ruby("추|향","秋|享")이었다.#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("원|문","原|文"): “秋饗”. ‘秋饗’은 ‘秋享’. #ruby("추|향|대|제","秋|享|大|祭") 또는 #ruby("추|향|대|례","秋|享|大|禮")는 #ruby("초","初")가을에 #ruby("종|묘|사|직","宗|廟|社|稷")에 지내는 큰 #ruby("제|사","祭|祀")를 말한다. #ruby("당|시","當|時") #ruby("김|수|로|왕|릉","金|首|露|王|陵")의 #ruby("추|향|일","秋|享|日")은 1946#ruby("년","年") 9#ruby("월","月") 15#ruby("일","日")이었는데, #ruby("백|범","白|凡")은 #ruby("김|수|로","金|首|露") #ruby("왕|릉","王|陵")에 #ruby("참|배","參|拜")한 #ruby("기|념","紀|念")으로 ‘安東后人 金九’ #ruby("명|의","名|義")로 ‘崇善殿 秋享大祭’란 #ruby("휘|호","揮|毫")를 써 주었고, #ruby("현|재","現|在") #ruby("능|내","陵|內") #ruby("박|물|관","博|物|館")에서는 이 글씨를 #ruby("양|각","陽|刻")으로 #ruby("목|각","木|刻")으로 #ruby("전|시","展|示")하고 있다.] #ruby("김|씨","金|氏")와 #ruby("허|씨","許|氏")가 #ruby("다|수","多|數") 모인 자리에서 #ruby("참|배","參|拜") #ruby("준|비","準|備")로 나에게 #ruby("사|모|각|대","紗|帽|角|帶")를 갖추어 주었다. 이로 #ruby("인","因")해 #ruby("출|생","出|生") #ruby("후","後") 처음으로 #ruby("사|모","紗|帽")와 #ruby("각|대","角|帶")를 차리고 #ruby("참|석","參|席"), #ruby("배|알","拜|謁")하였다.]
#zh[这次顺路到了金海，恰值首露王①陵的秋享大祭，有许多金姓和许姓的族人在参拜，我也生平第一次穿着他们替我准备的纱帽和角带行参拜之礼。]
#zh[译注：①金海地区古有伽耶国，始祖为首露王。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 길로 다시 #ruby("창|원","昌|原"), #ruby("진|전","鎭|田")을 #ruby("향","向")해 #ruby("출|발","出|發")하여, #ruby("과|거","過|去") #ruby("상|해","上|海") #ruby("재|류|시","在|留|時") #ruby("본|국","本|國")으로 #ruby("파|견","派|遣")하여 #ruby("운|동","運|動")하다가 #ruby("옥|중","獄|中") #ruby("고|문","拷|問")을 받고 #ruby("결|국","結|局") 그 #ruby("여|독","餘|毒")으로 #ruby("세|상","世|上")을 떠난 #ruby("이|교|제","李|敎|載") #ruby("지|사","志|士")의 #ruby("유|가|족","遺|家|族")을 #ruby("방|문","訪|問"), #ruby("위|로","慰|勞")하였다. 그런 다음 #ruby("진|주","晉|州")로 가서 #ruby("애|국","愛|國") #ruby("기|녀","妓|女") #ruby("논|개","論|介")#footnote(numbering: _ => [20)])[#h(0.35em)#ruby("논|개","論|介")\(?〜1593). #ruby("이|조","李|朝") #ruby("선|조","宣|祖") 때의 #ruby("여|인","女|人"). #ruby("임|진|란","壬|辰|亂") 때 #ruby("진|주|성","晉|州|城")이 #ruby("함|락","陷|落")되고 #ruby("왜|장","倭|將")들이 #ruby("촉|석|루","矗|石|樓")에서 #ruby("주|연","酒|宴")을 베풀고 있을 때 #ruby("왜|장","倭|將") 게다니를 끼고 #ruby("남|강","南|江")에 떨어져 함께 죽었다. #ruby("후|세","後|世")에 #ruby("논|개","論|介")의 #ruby("정|렬","貞|烈")을 기리기 #ruby("위","爲")해 #ruby("비","碑")와 #ruby("사|당","祠|堂")을 세워 #ruby("제|사","祭|祀")를 지내고 있다.]의 옛 #ruby("혼","魂")을 #ruby("위|로","慰|勞")하는 마음으로 #ruby("촉|석|루","矗|石|樓")#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("경|상|남|도","慶|尙|南|道") #ruby("진|주|시","晉|州|市") #ruby("본|성|동","本|城|洞") #ruby("진|주|성","晉|州|城") #ruby("남|단","南|端") 벼랑 위에 있는 #ruby("저|명","著|名")한 #ruby("누|각","樓|閣"). #ruby("창|건","創|建")은 #ruby("고|려|시|대","高|麗|時|代")로 #ruby("추|정","推|定")하고 있으나 #ruby("확|실","確|實")하지 않으며, #ruby("화|재","火|災")로 #ruby("인","因")하여 여러 #ruby("차|례","次|例")의 #ruby("중|수","重|修")를 거쳤다. #ruby("현|재","現|在")의 #ruby("건|물","建|物")은 #ruby("한|국|전|쟁","韓|國|戰|爭") 때 #ruby("소|실","燒|失")된 것을 1960#ruby("년","年")에 #ruby("재|건","再|建")한 것이다.]를 #ruby("시|찰","視|察")하였다.]
#zh[接着又向昌原、镇田出发，慰问从前留在上海时被派回本国从事运动、在狱中受拷问、终于因余毒去世的李教载志士的遗族。然后到晋州，为安慰爱国妓女论介的旧魂，视察了矗石楼。]
#figure-block("/images/p411.jpg", caption: [1946#ruby("년","年") #ruby("경|교|장","京|橋|莊")에서 #ruby("김|형|진","金|亨|鎭") #ruby("가|족","家|族")과])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|주","全|州")에 #ruby("도|착","到|着")하니 #ruby("무|수","無|數")한 #ruby("남|녀","男|女") #ruby("동|포","同|胞")들이 #ruby("출|영","出|迎")하여 주었다. 그 가운데서도 #ruby("김|맹|문","金|孟|文") #ruby("씨","氏")와 그 #ruby("사|촌|동|생","四|寸|同|生") #ruby("김|맹|열","金|孟|悅"), #ruby("고|종","姑|從") #ruby("사|촌|형","內|從|兄") #ruby("최|경|열","崔|景|烈") 세 사람을 #ruby("특","特")히 #ruby("역|사|적","歷|史|的") #ruby("관|계","關|係")가 두터운 사람들이었다. 그들은 내가 21#ruby("세","歲") 때 #ruby("신|천","信|川") #ruby("청|계|동","淸|溪|洞") #ruby("안|중|근","安|重|根") #ruby("의|사","義|士") #ruby("부|친","父|親") #ruby("안|진|사","安|進|士") #ruby("태|훈","泰|勳") #ruby("씨","氏") #ruby("댁","宅")에서 #ruby("상|봉","相|逢")한 #ruby("김|형|진","金|亨|鎭") #ruby("씨","氏")의 아들, 조카, #ruby("생|질","甥|姪")이었다. #ruby("전|주","全|州") #ruby("동|포","同|胞")들의 #ruby("성|대","盛|大")한 #ruby("환|영","歡|迎")이 끝난 #ruby("후","後")에 #ruby("김|맹|문","金|孟|文") #ruby("외","外") 세 사람의 #ruby("전","全") #ruby("가|족","家|族")을 #ruby("상|대","相|對")로 한 #ruby("특|별|환|영","特|別|歡|迎") #ruby("기|념|사|진","紀|念|寫|眞")까지 #ruby("촬|영","撮|影")하니 #ruby("피|차","彼|此") #ruby("간","間")에 #ruby("고","故") #ruby("김|형|진","金|亨|鎭") #ruby("씨","氏")에 #ruby("대","對")한 #ruby("감|회","感|懷")를 #ruby("금","禁")할 수 없었다.]
#zh[在全州见到了老友金亨镇的儿子孟文和他的堂弟孟悦、他的叔伯内兄崔景烈三位，感到很高兴。全州的欢迎会结束之后，跟他们三位的家属聚在一起追忆故人，并摄影留念。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("목|포","木|浦")·#ruby("군|산","群|山")·#ruby("강|경","江|景") #ruby("등|지","等|地")를 #ruby("일|일","一|一")이 #ruby("시|찰","視|察")하니, 이곳은 모두 잊지 못할 #ruby("역|사","歷|史")가 맺혀 있는 곳이다. #ruby("목|포","木|浦")에서 #ruby("양|봉|구","梁|鳳|九")를 찾아가기 #ruby("위","爲")해, 지게 지고 #ruby("노|동|자","勞|動|者")로 #ruby("변|장","變|裝")하여 #ruby("양|봉|구","梁|鳳|九")를 #ruby("상|대","相|對")하던 #ruby("기|억","記|憶")이 새로웠다. 그 자리에서 #ruby("양|봉|구","梁|鳳|九") #ruby("씨","氏")의 #ruby("유|가|족","遺|家|族")과 #ruby("기|타","其|他") #ruby("내|력","來|歷")을 #ruby("탐|문","探|問")하였으나 #ruby("결|국","結|局") #ruby("단|서","端|緖")를 얻지 못하였다.]
#zh[木浦、群山、江景等地一一视察，这些地方都结着不能忘记的历史。在木浦，为了找梁凤九，背上背架扮成劳动者去见他的记忆又新了。当场探问梁凤九的遗族和其他来历，终于没有得到线索。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("군|산","群|山")을 거쳐 #ruby("강|경","江|景")에 #ruby("도|착","到|着")하여 #ruby("공|종|렬","孔|鍾|烈") #ruby("씨","氏")의 #ruby("소|식","消|息")을 #ruby("탐|문","探|問")해 보니, 젊어서 #ruby("자|살","自|殺")하였고 #ruby("자|손","子|孫")도 없었다. #ruby("당|시","當|時") #ruby("공|씨","孔|氏") 집안에서 #ruby("돌|발","突|發")하였던 #ruby("괴|변","怪|變")은#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("상|권","上|卷")에 #ruby("소|개","紹|介")되어 있는바, #ruby("공|종|렬","孔|鍾|烈") 누이의 #ruby("부|정","不|貞")과 그로 #ruby("인","因")한 아이의 #ruby("살|해","殺|害") #ruby("사|건","事|件")을 말한다.] 그 #ruby("친|척|간","親|戚|間")에 일어난 일이라고 말하였다.]
#zh[在江景打听孔钟烈的消息，得知他年轻时便自杀了，没有子嗣，我留宿他家的那天晚上的悲剧，据说是发生在亲戚之间的事。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("춘|천","春|川") #ruby("가|정|리","柯|亭|里") #ruby("의|암","毅|庵") #ruby("유|인|석","柳|麟|錫") #ruby("선|생","先|生")의 #ruby("묘","墓")에 #ruby("참|배","參|拜")하고#footnote(numbering: _ => [23)])[#h(0.35em)1946#ruby("년","年") 9#ruby("월","月") 12#ruby("일","日")\(#ruby("음|력","陰|曆") 8#ruby("월","月") 17#ruby("일","日")). #ruby("백|범","白|凡")은 #ruby("유|인|석","柳|麟|錫") #ruby("선|생","先|生")의 #ruby("묘","墓")를 찾아 #ruby("제|문","祭|文")을 바치고 #ruby("분|향","焚|香")하였다.] 그 #ruby("유|족","遺|族")을 #ruby("위|문","慰|問")한 뒤 서울로 #ruby("귀|환","歸|還")하였다.]
#zh[参拜春川柯亭里毅庵柳麟锡先生的墓，慰问遗族之后，回到汉城。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[얼마#ruby("후","後") #ruby("강|화","江|華")를 #ruby("순|시|차","巡|視|次") #ruby("인|천","仁|川")에서 #ruby("경|비|선","警|備|船")을 타고 #ruby("무|의|도","舞|衣|島")에 #ruby("도|착","到|着")하였다. 그곳 #ruby("동|포","同|胞")들의 #ruby("환|영","歡|迎")과 #ruby("강|연","講|演")을 마치고 #ruby("강|화","江|華")에 #ruby("도|착","到|着")하여, #ruby("김|경|득","金|卿|得") #ruby("씨","氏")의 셋째 #ruby("동|생","同|生") #ruby("진|경","鎭|卿")의 집을 찾아보았다. 그 집은 46#ruby("년","年") #ruby("전","前") 내가 #ruby("변|성|명","變|姓|名")하고 그 #ruby("사|랑","舍|廊")에서 #ruby("사|숙","私|塾")을 #ruby("개|설","開|設")하고 #ruby("교|편","敎|鞭")을 잡은 지 3#ruby("개|월","個|月") 만에 #ruby("본|색","本|色")이 #ruby("탄|로","綻|露")나 물러났던 곳이었다. 옛날 그대로 있는 그 집을 #ruby("방|문","訪|問")하여 #ruby("환|영","歡|迎")하는 #ruby("친|척","親|戚")들과 #ruby("기|념|사|진","紀|念|寫|眞")을 #ruby("촬|영","撮|影")하였다. #ruby("합|일|학|교","合|一|學|校") #ruby("운|동|장","運|動|場")에서 #ruby("환|영","歡|迎")과 아울러 #ruby("강|연","講|演")을 할 때,]
#zh[过了不久，为巡视江华，从仁川坐警备船到了舞衣岛。结束了那里同胞的欢迎和讲演，到达江华，去找金卿得的三弟镇卿的家。四十六年前我改了姓名，在那间舍廊开私塾教了三个月，本色败露才离开。房子还是从前的样子，和出来欢迎的亲戚照了纪念相。在合一学校运动场上，欢迎并讲演的时候，我说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("과|거","過|去") 나에게서 #ruby("수|학","修|學")하였던 #ruby("학|생","學|生") #ruby("삼|십","三|十") #ruby("명","名") #ruby("중","中") 이 자리에 #ruby("참|석","參|席")한 #ruby("자","者") 있거든 나서 보라.”]
#zh[“从前跟我念过书的三十个学生，今天在座的，出来看看。”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 두세 #ruby("번","番") 외쳐 보았으나 #ruby("결|국","結|局") 한 사람도 없었다. 그런데 그 저녁에야 #ruby("경|관","警|官")과 #ruby("동|반","同|伴")하여 한 사람이 찾아와 아뢰었다.]
#zh[喊了两三遍，到底没有一个人。到了晚上，才有一个人跟着警官来禀告。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 #ruby("과|연","果|然") #ruby("선|생","先|生")님의 #ruby("제|자","弟|子")올시다.”]
#zh[“我果然是先生的弟子。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 나에게서 배운 #ruby("기|억","記|憶")이 나느냐?”]
#zh[“那么还记得跟我学的事吗？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("생|각","生|覺")납니다.”]
#zh[“记得。”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 아까 #ruby("운|동|장","運|動|場")에 오고도 #ruby("대|답","對|答")이 없었느냐?”]
#zh[“那么刚才到了运动场，为什么不答应？”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“저도 #ruby("운|동|장","運|動|場")에 #ruby("참|석","參|席")하였으나 #ruby("선|생","先|生")님의 #ruby("강|연","講|演")을 듣고 너무도 #ruby("감|격","感|激")한 나머지 눈물을 #ruby("금","禁")할 수 없어 #ruby("대|답","對|答")을 못하였습니다.”]
#zh[“我也到了运动场，可是听了先生的讲演，感激得忍不住流泪，没有回答。”]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) #ruby("서|부|지|방","西|部|地|方") #ruby("순|회","巡|廻")]]
#zh[西部地方巡回]
#figure-block("/images/p413.jpg", caption: [#ruby("서|부|지|방","西|部|地|方") #ruby("순|회|시","巡|廻|時") #ruby("선|죽|교","善|竹|橋")를 찾은 #ruby("백|범","白|凡")])
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("삼|남","三|南") #ruby("일|대","一|帶") #ruby("시|찰","視|察")을 #ruby("대|강","大|綱") 마치고 서울로 돌아와서 얼마#ruby("간","間") #ruby("휴|식","休|息")을 #ruby("취","取")한 #ruby("후","後"), 다시 38#ruby("선","線") #ruby("이|남","以|南") #ruby("서|부|조|선","西|部|朝|鮮") #ruby("일|대","一|帶")를 #ruby("시|찰","視|察")하기로 하였다.]
#zh[三南一带的视察大体结束，回到汉城休息了一些时候，决定再视察三八线以南的西部朝鲜一带。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제","第")1#ruby("차","次")로 #ruby("개|성","開|城")에 #ruby("도|착","到|着")하여 18〜19#ruby("세","歲") 때에 #ruby("유|람","遊|覽")하던 #ruby("명|승|고|적","名|勝|古|蹟") #ruby("만|월|대","滿|月|臺")와 #ruby("선|죽|교","善|竹|橋")를 #ruby("구|경","求|景")하고, #ruby("개|성","開|城") #ruby("특|산","特|産") #ruby("고|려|인|삼","高|麗|人|蔘") #ruby("제|조|공|장","製|造|工|場")을 #ruby("시|찰","視|察")하였다. 이때 #ruby("개|성","開|城")의 #ruby("각","各") #ruby("정|당","政|黨")·#ruby("사|회","社|會") #ruby("단|체","團|體")는 #ruby("물|론","勿|論")이고 #ruby("일|반","一|般") #ruby("남|녀|노|소","男|女|老|少") #ruby("동|포","同|胞")들이 #ruby("총|출|동","總|出|動")하여 #ruby("환|영|식","歡|迎|式")을 열었다.]
#zh[第一次到了开城，游览了十八九岁时游过的名胜古迹满月台和善竹桥，视察了开城特产高丽人参制造工厂。这时开城各政党、社会团体不必说，一般男女老少同胞也总出动，开了欢迎式。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 #ruby("배|천","白|川")#ruby("온|천","溫|泉")을 #ruby("경|유","經|由")하여 #ruby("연|안","延|安")#ruby("온|천","溫|泉")에 #ruby("도|착","到|着")하니, #ruby("역|전","驛|前")마다 마중나온 #ruby("동|포","同|胞")들의 #ruby("감|격","感|激")은 이루 헤아릴 수 없었다. #ruby("환|영","歡|迎")과 아울러 #ruby("인|사","人|事")의 말을 #ruby("대|강","大|綱") 마치고 #ruby("연|안|온|천","延|安|溫|泉")에서 하룻밤을 묵은 #ruby("후","後") #ruby("연|안|읍","延|安|邑")을 #ruby("향","向")하였다. 가는 길에 #ruby("기|억","記|憶")에 새로운 #ruby("이|효|자","李|孝|子") #ruby("묘","墓")를 #ruby("배|알","拜|謁")하기 #ruby("위","爲")해 시골 늙은이에게 길을 물어보니, 49#ruby("년","年") #ruby("전","前")과 #ruby("변","變")함없다고 하였다.]
#zh[第二天经白川温泉到了延安温泉，每一站前出来迎接的同胞，感激无法计量。欢迎和打招呼的话大体说完，在延安温泉住了一夜，然后向延安邑。路上为了拜谒记忆里新鲜的李孝子墓，问乡下老人路，说和四十九年前没有变。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|효|자","李|孝|子") #ruby("묘","墓") 앞에 #ruby("당|도","當|到")하여 #ruby("차","車")를 #ruby("정|차","停|車")하고 걸어서 #ruby("효|자","孝|子") #ruby("고","故") #ruby("이|창|매","李|昌|梅")의 발자국을 따라 #ruby("참|배","參|拜")하였다. 49#ruby("년","年") #ruby("전","前") #ruby("해|주|감|옥","海|州|監|獄")에서 #ruby("철|망","鐵|網")에 #ruby("구|속","拘|束")되어 #ruby("인|천|감|옥","仁|川|監|獄")으로 #ruby("이|감","移|監")되던 길에 #ruby("효|자","孝|子") #ruby("이|창|매","李|昌|梅") #ruby("묘|비","墓|碑") 앞에 쉬었던 일을 #ruby("의|미|심|장","意|味|深|長")한 #ruby("감|격","感|激")으로 #ruby("생|각","生|覺")하였다. 눈#ruby("짐|작","斟|酌")으로 어머님이 앉으셨던 자리를 찾아보았다. #ruby("묘","墓")와 #ruby("산|천","山|川")은 옛모습 그대로 나를 #ruby("환|영","歡|迎")하였고, #ruby("좌|우","左|右") #ruby("추|종","追|從")하는 #ruby("경|관","警|官")들도 그때 나를 #ruby("구|속","拘|束")해가던 그 #ruby("경|관","警|官")들과 #ruby("흡|사","恰|似")하였다. 그러나 문득 뒤를 돌아보니 그 옛날 나를 따라오시던 어머님 얼굴만은 뵈올 길이 없으니, 앞이 캄캄하여 쏟아지는 옛#ruby("추|억","追|憶")의 눈물을 #ruby("금","禁")할 길 없었다. #ruby("중|경","重|慶")에서 #ruby("운|명","殞|命")하실 때,]
#zh[到了李孝子墓前，停了车，步行跟着孝子故李昌梅的足迹参拜。四十九年前从海州监狱被铁丝网拘束、移监仁川监狱的路上，在孝子李昌梅墓碑前休息的事，以意味深长的感激想了起来。用眼估量，找母亲坐过的位子。墓和山川以旧貌欢迎我，左右跟随的警官也和那时押我的警官相似。可是忽然回头，从前跟着来的母亲的脸却无从得见，眼前一片黑，旧回忆的眼泪忍不住涌出来。想起母亲在重庆临终的时候说：]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나의 #ruby("원|통","冤|痛")한 #ruby("생|각","生|覺")을 어찌하면 좋으냐.”]
#zh[“我真是死不瞑目啊！”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하시던 어머님 #ruby("최|후","最|後")의 말씀을 #ruby("생|각","生|覺")하니, 그것이 이날 이 자리에 #ruby("모|자","母|子")가 같이 옛이야기를 하지 못할 줄 #ruby("예|측","豫|測")하시고 하신 말씀 같아 슬픈 마음을 #ruby("진|정","鎭|靜")키 어려웠다.]
#zh[想起母亲最后说的话，好像她预先知道今天在这个位子上母子不能一起说旧话，悲伤的心难以镇定。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("지|금","只|今"), 사람과 땅이 #ruby("생|소","生|疎")한 #ruby("서|촉","西|蜀") #ruby("화|상|산","和|尙|山") #ruby("남","南")쪽 자락에 #ruby("손|자","孫|子")와 같이 누워 계신 것을 #ruby("생|각","生|覺")하니, 슬픈 마음을 #ruby("금","禁")할 길 없다. #ruby("영|혼","靈|魂")이라도 #ruby("고|국","故|國")에 돌아오셔서 이몸과 같이 #ruby("환|영","歡|迎")을 받으신다면 #ruby("다|소","多|少") #ruby("위|안","慰|安")이나 되지 않을까 #ruby("생|각","生|覺")하니 #ruby("만|감","萬|感")이 #ruby("교|차","交|叉")하였다. 그러나 이것은 내 #ruby("개|인","個|人")의 #ruby("감|상","感|傷")일 뿐이다. #ruby("연|안","延|安")의 #ruby("동|포","同|胞")들이 #ruby("남|녀|노|소","男|女|老|少")를 #ruby("막|론","莫|論")하고 #ruby("총|출|동","總|出|動")하여, #ruby("연|안","延|安")에서 #ruby("제|일","第|一") 큰 #ruby("학|교","學|校") #ruby("운|동|장","運|動|場")에 빽빽하게 #ruby("운|집","雲|集") #ruby("도|열","堵|列")한 #ruby("성|대","盛|大")한 #ruby("환|영","歡|迎")이 있었고, 아울러 #ruby("강|연","講|演")을 마쳤다.]
#zh[现在一想她和孙子一起躺在人和地都生疏的西蜀和尚山南边山脚，悲伤不能自禁。灵魂若能回到故国，和我一样接受欢迎，也许多少是安慰，万感交叉。可是这只是我个人的感伤。延安的同胞不论男女老少总出动，在延安第一大的学校运动场密密云集列队，有盛大的欢迎，讲演也结束了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 길로 #ruby("청|단","靑|丹")에 #ruby("도|착","到|着")하니, #ruby("역|시","亦|是") #ruby("환|영","歡|迎")하는 #ruby("동|포","同|胞")들의 #ruby("열|정","熱|情")은 #ruby("도|처","到|處")에 #ruby("일|반","一|般")이나, #ruby("소|위","所|謂") 38#ruby("선","線") #ruby("관|계","關|係")로 내가 태어난 곳을 멀리서 바라보기만 할 뿐 가 보지는 못하였다. 돌아서 서울을 #ruby("향","向")하게 되니 그때의 #ruby("감|개|무|량","感|慨|無|量")한 #ruby("회|포","懷|抱")란 #ruby("필|설","筆|舌")로 다 할 수가 없다.]
#zh[接着到了青丹，欢迎的同胞的热情到处一样，可是因为所谓三八线，我出生的地方只能远远望着，不能去。转身向汉城，那时感慨无量的怀抱，笔和舌头都说不尽。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[늦게 #ruby("백|천","白|川")에 #ruby("도|착","到|着")하여 #ruby("종|일","終|日") 나를 기다리고 서 있던 #ruby("동|포","同|胞") #ruby("대|중","大|衆")을 #ruby("향","向")하여 #ruby("간|단","簡|單")한 #ruby("인|사","人|事") #ruby("겸","兼") #ruby("강|연","講|演")을 마치고 #ruby("유|숙","留|宿")하였다. 그곳은 40#ruby("년","年") #ruby("전","前") #ruby("군|수","郡|守") #ruby("전|봉|훈","全|鳳|薰") #ruby("씨","氏")의 #ruby("요|청","要|請")을 받아, #ruby("평|안","平|安")·#ruby("황|해","黃|海") #ruby("지|역","地|域")에서 #ruby("명|성","名|聲")이 #ruby("쟁|쟁","錚|錚")한 #ruby("최|광|옥","崔|光|玉") #ruby("선|생","先|生")을 #ruby("주|임","主|任") #ruby("강|사","講|師")로 모시고 #ruby("사|범|강|습","師|範|講|習")을 #ruby("진|행","進|行")했던 곳이다. #ruby("불|행","不|幸")히 #ruby("최","崔")#ruby("선|생","先|生")이 #ruby("폐|병","肺|病")으로 #ruby("객|사","客|死")하여 #ruby("읍|내","邑|內") #ruby("유|지","有|志")들과 #ruby("전","全")#ruby("군|수","郡|守")와 #ruby("협|의","協|議")하여 #ruby("백|천","白|川") #ruby("남|산","南|山") 위 #ruby("운|동|장","運|動|場") 옆에 #ruby("안|장","安|葬")했었다. 떠난 지 40#ruby("년","年") 만에 비로소 이곳에 #ruby("당|도","當|到")하니, #ruby("도|처","到|處")에 스며 있는 옛 #ruby("기|억","記|憶")의 #ruby("감|상","感|想")은 이루 다 헤아릴 수 없다.]
#zh[很晚到了白川，向终日站着等我的同胞大众，结束了简单的招呼兼讲演，留宿。这里是四十年前应郡守全凤薰的邀请，请平安、黄海一带名声铮铮的崔光玉先生做主任讲师，办过师范讲习的地方。不幸崔先生因肺病客死，和邑内有志以及全郡守商议，安葬在白川南山上运动场旁边。离开四十年才到这里，到处浸透的旧记忆，感想无法一一计量。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 #ruby("백|천","白|川")을 떠나 서울로 #ruby("향","向")하는 길에 #ruby("장|단","長|湍") #ruby("고|랑|포","皐|浪|浦")를 들러서 #ruby("선|조","先|祖") #ruby("경|순|왕|릉","敬|順|王|陵")에 #ruby("참|배","參|拜")하였다. 그때 #ruby("능|촌","陵|村")에 사는 #ruby("경|주","慶|州") #ruby("김|씨","金|氏")들이 내가 올 것을 #ruby("예|측","豫|測")하고 미리 #ruby("제|전","祭|典")을 #ruby("준|비","準|備")하였다. #ruby("참|배","參|拜") #ruby("후","後") #ruby("문|산","汶|山")에 #ruby("도|착","到|着")하여 #ruby("역|시","亦|是") #ruby("환|영","歡|迎")과 #ruby("강|연","講|演")을 마치고 서울로 #ruby("귀|환","歸|還")하니, #ruby("서|부|지|방","西|部|地|方") #ruby("순|회","巡|廻")는 이로써 마감되었다.]
#zh[第二天离开白川向汉城，路上到长湍皋浪浦参拜祖先敬顺王陵。那时住在陵村的庆州金氏预测我要来，预先准备了祭典。参拜后到汶山，同样结束欢迎和讲演，回到汉城，西部地方的巡回就此结束。]
#zh[我决定等待大韩民国自主独立之日到来时，再续写未完的篇章，现在就此搁笔。]
#zh[——于汉城新门外——]
