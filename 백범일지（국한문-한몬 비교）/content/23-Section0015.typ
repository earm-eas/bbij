#zh[踏上祖国的大地]
#heading(level: 3)[#text(font: "KOPUSGo B")[1) #ruby("감|격","感|激")의 #ruby("귀|환","歸|還")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|국","故|國")을 떠난 지 27#ruby("년","年") 만에 기쁨과 슬픔이 뒤엉킨 #ruby("심|정","心|情")으로 #ruby("상|공","上|空")에 높이 떠서 #ruby("신|선","新|鮮")한 #ruby("공|기","空|氣")를 #ruby("호|흡","呼|吸")하며, #ruby("상|해","上|海") #ruby("출|발","出|發") 3#ruby("시|간","時|間") 만에 #ruby("김|포","金|浦") #ruby("비|행|장","飛|行|場")에 #ruby("착|륙","着|陸")하였다. #ruby("착|륙","着|陸") #ruby("즉|시","卽|時") 눈앞에 보이는 두 가지 #ruby("감|격","感|激")이 있으니, 기쁨이 그 하나요 슬픔도 그 하나이다. 내가 #ruby("해|외","海|外")에 있을 때 우리 #ruby("후|손","後|孫")들이 #ruby("왜|적","倭|敵")의 #ruby("악|정","惡|政")에 주름을 펴지 못하리라 #ruby("우|려","憂|慮")하였던 바와는 딴판으로, #ruby("책|보","冊|褓")를 메고 길에 줄지어 돌아가는 #ruby("학|생","學|生")의 #ruby("활|발","活|潑") #ruby("명|랑","明|朗")한 #ruby("기|상","氣|像")을 보니 우리 #ruby("민|족","民|族") #ruby("장|래","將|來")가 #ruby("유|망|시","有|望|視")되었다. 이것이 기쁨의 하나이다. #ruby("반|면","反|面") #ruby("차|창","車|窓")으로 내다보이는 #ruby("동|포","同|胞")들의 사는 #ruby("가|옥","家|屋")을 보니, 빈틈없이 이어져 집이 땅같이 낮게 붙어 있었다. #ruby("동|포","同|胞")들의 #ruby("생|활","生|活") #ruby("수|준","水|準")이 저만치 #ruby("저|열","低|劣")하다는 것을 #ruby("짐|작","斟|酌")한 것이 #ruby("유|감","遺|憾")의 하나였다.]
#zh[离开上海三个小时以后，飞机飞抵金浦机场。我怀着悲喜交集的心情，呼吸着离开了二十七年的祖国的新鲜空气，踏上了日夜怀念的土地。]
#zh[我一踏上祖国的土地，看到学生们背着书包去上学，他们朝气蓬勃，活泼开朗，这是一件十分可喜的事；和这相反的是，同胞住的房子，又低又矮，看起来非常贫寒，这又是一件令人悲伤的事。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("수","數")많은 #ruby("동|포","同|胞")들이 나를 #ruby("환|영","歡|迎")하기 #ruby("위","爲")하여 여러 날을 모여들어 #ruby("고|대","苦|待")하였는데 #ruby("당|일","當|日") 마중나온 #ruby("동|포","同|胞")가 얼마 되지 않은 것은, #ruby("미|군","美|軍")을 #ruby("경|유","經|由")하기 때문에 #ruby("통|신","通|信")이 #ruby("불|철|저","不|徹|底")했기 때문이라 한다. 늙은 몸을 #ruby("자|동|차","自|動|車")에 #ruby("의|지","依|支")하고 #ruby("차|창","車|窓")으로 #ruby("좌|우","左|右")를 바라보며 서울에 #ruby("도|착","到|着")하니 #ruby("의|구","依|舊")한 #ruby("산|천","山|川")도 나를 반겨주는 듯했다.]
#zh[据说同胞们为了欢迎我们，好几天聚集在机场，但不知道飞机到达的准确时间，所以今天来迎接我们的同胞并不很多。我这老迈之躯，靠在汽车的后座上，进入汉城时，只见故国山川如旧，好像正在欢迎远方归来的游子。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("숙|소","宿|所")인 #ruby("죽|첨|정","竹|添|町") #ruby("최|창|학","崔|昌|學") #ruby("씨","氏") #ruby("사|택","私|宅")으로 #ruby("향","向")하였고,#footnote(numbering: _ => [1)])[#h(0.35em)#ruby("죽|첨|장","竹|添|莊")은 #ruby("원|래","元|來") #ruby("일|제|시|기","日|帝|時|期") #ruby("광|산","鑛|山")으로 #ruby("치|부","致|富")한 #ruby("최|창|학","崔|昌|學")의 #ruby("별|장","別|莊")이었는데, #ruby("백|범","白|凡")이 #ruby("거|처","居|處")하면서 #ruby("경|교|장","京|橋|莊")으로 이름을 바꾸었다. #ruby("경|교|장","京|橋|莊")은 #ruby("백|범","白|凡") #ruby("사|후","死|後") 다시 #ruby("최|창|학","崔|昌|學")에게 #ruby("반|환","返|還")되었다가 1967#ruby("년","年") #ruby("삼|성|재|단","三|星|財|團")이 #ruby("인|수","引|受")하여 #ruby("고|려|병|원","高|麗|病|院")\(#ruby("현|재","現|在") #ruby("강|북|삼|성|병|원","江|北|三|星|病|院"))을 세웠다.] #ruby("국|무|위|원","國|務|委|員")들과 그 #ruby("외","外") #ruby("일|행","一|行")은 #ruby("한|미","韓|美")호텔에 #ruby("숙|소","宿|所")를 #ruby("정","定")하였다.]
#zh[欢迎我们的人士预先给我们准备好了宿舍，我住在新门外的崔昌学先生家里，国务员一行则住在韩美旅社。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("도|착","到|着") #ruby("즉|시","卽|時") #ruby("윤|봉|길","尹|奉|吉")·#ruby("이|봉|창","李|奉|昌")·#ruby("김|경|득","金|卿|得")의 #ruby("유|가|족","遺|家|族")이 있으면 찾아오라고 #ruby("신|문","新|聞")에 #ruby("보|도","報|道")하였다. #ruby("윤|봉|길","尹|奉|吉") #ruby("의|사","義|士")의 #ruby("자|제","子|弟")는 #ruby("덕|산","德|山")으로부터 찾아왔고, #ruby("이|봉|창","李|奉|昌") #ruby("의|사","義|士")의 #ruby("질|녀","姪|女")가 서울에서 찾아오고, #ruby("김|경|득","金|卿|得") #ruby("선|생","先|生")의 아들 윤태는 #ruby("이|북","以|北")에 있는 #ruby("관|계","關|係")로 오지 못하고 그 #ruby("친","親")딸과 #ruby("친|척","親|戚") #ruby("등","等")은 #ruby("강|화","江|華")·#ruby("김|포","金|浦") #ruby("등|지","等|地")로부터 찾아와서, 기쁜 마음과 슬픈 마음으로 서로 #ruby("대|면","對|面")하였다.]
#zh[我通过报纸，表示很想会见尹奉吉、李奉昌两位义士和江华金周卿先生的遗族。不久，尹义士的公子从德山来看我，李义士的侄女也从汉城来看我，金周卿先生的公子润泰，由于留在三八线以北，未能碰面，但他的女公子和亲戚们，有的从江华，有的从金浦来看我，我既感到高兴，又感到难过。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("친|척","親|戚")과 헤어지고 #ruby("묘|소","墓|所")를 버리고 #ruby("고|향","故|鄕")을 떠난 지 27#ruby("년","年"), #ruby("고|국","故|國")에 돌아왔으나 그리운 #ruby("출|생|지","出|生|地")인 #ruby("고|향","故|鄕")인 #ruby("소|위","所|謂") 38#ruby("선","線") #ruby("장|벽","障|壁") 때문에 돌아가 보지도 못하고, 다만 #ruby("재|종|형|제","再|從|兄|弟")들과 #ruby("사|촌","四|寸")누이 #ruby("가|족","家|族")들이 #ruby("상|경","上|京")하여 기쁘게 만나보았을 뿐이다.]
#zh[我所怀念的祖坟和亲戚故旧所在的故乡，由于横亘着一条所谓的三八线而不能去探访，可是表兄弟和表妹们来京探望我，我们又很高兴地重逢了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("국|내","國|內")에서 #ruby("환|영","歡|迎") #ruby("선|풍","旋|風")이 일어나자 #ruby("군|정|청","軍|政|廳") #ruby("소|속|기|관","所|屬|機|關")과 #ruby("정|당","政|黨")·#ruby("사|회|단|체","社|會|團|體")며 #ruby("교|육","敎|育")·#ruby("교|회","敎|會")·#ruby("공|장","工|場") #ruby("등","等") #ruby("각|종","各|種") #ruby("부|문","部|門")이 쉴 틈 없이 #ruby("연|합|환|영|회","聯|合|歡|迎|會")를 #ruby("조|직","組|織")하였다. 나 #ruby("자|신","自|身")과 우리 #ruby("일|행","一|行")은 #ruby("개|인","個|人")의 #ruby("형|식","形|式")으로 #ruby("입|국","入|國")하였지만, #ruby("국|내","國|內") #ruby("동|포","同|胞")들이 #ruby("정|식","正|式")으로 ‘#ruby("임|시|정|부","臨|時|政|府") #ruby("환|영|회","歡|迎|會")’라고 크게 쓴 글씨를 #ruby("태|극|기","太|極|旗")와 아울러 #ruby("창|공","蒼|空")에 휘날리고 #ruby("수|십|만","數|十|萬") 겨레가 #ruby("총|출|동","總|出|動")하여 #ruby("일|대","一|大") #ruby("성|황|리","盛|況|裡")에 #ruby("시|위|행|렬","示|威|行|列")을 #ruby("진|행","進|行")하니, #ruby("만|리","萬|里") #ruby("해|외","海|外")에서 #ruby("풍|상","風|霜")을 겪은 온갖 #ruby("고|통","苦|痛")을 #ruby("동|정","同|情")하는 듯 싶었다.]
#zh[国内掀起欢迎的旋风，军政厅所属机关和政党、社会团体、教育、教会、工厂等各部门不停地组织联合欢迎会。我和我们一行虽以个人形式入国，国内同胞却正式写下“临时政府欢迎会”的大字，和太极旗一起在苍空飞舞，数十万同胞总出动，在一大盛况里进行示威行列，好像在同情我们在万里海外饱经风霜的一切苦痛。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("행|렬","行|列")을 마친 #ruby("후","後") #ruby("덕|수|궁","德|壽|宮")에서 #ruby("연|회","宴|會")가 열렸는데 그 #ruby("성|황","盛|況")은 참으로 #ruby("찬|란","燦|爛")하였다. 서울 #ruby("기|생","妓|生")은 #ruby("총|출|동","總|出|動")하여 400#ruby("명","名") #ruby("이|상","以|上")이요, #ruby("식|탁","食|卓")이 400#ruby("여","餘") #ruby("개","個")며, 이루 다 #ruby("기|록","記|錄")하기 어려울 만큼의 #ruby("성|황","盛|況")을 이루었다. 하지 #ruby("중|장","中|將")을 비롯하여 #ruby("미|군|정","美|軍|政") #ruby("간|부","幹|部")들과 #ruby("참|석","參|席")한 #ruby("동|포","同|胞")들이 이루 헤아릴 수 없을 #ruby("정|도","程|度")로 많아서 #ruby("덕|수|궁","德|壽|宮") #ruby("광|장","廣|場")이 비좁을 #ruby("지|경","地|境")이었다.]
#zh[行列结束之后，在德寿宫开了宴会，盛况真是灿烂。汉城艺妓总出动，四百名以上，餐桌四百余个，盛况难以一一记录。哈奇中将为首，美军政干部和出席的同胞多得不可胜数，德寿宫广场挤得狭窄。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("비|단","非|但") 서울뿐이랴. #ruby("인|천","仁|川")·#ruby("개|성","開|城") #ruby("등","等") #ruby("지|방","地|方") #ruby("각|지","各|地")에서도 #ruby("임|시|정|부","臨|時|政|府") #ruby("환|영|회","歡|迎|會")를 #ruby("일|제","一|齊")히 #ruby("거|행","擧|行")하였다. 그러나 38#ruby("선","線") #ruby("이|북","以|北")에서는 이와 #ruby("반|대","反|對")로 #ruby("환|영|회","歡|迎|會") #ruby("대|신","代|身") #ruby("무|쌍","無|雙")한 #ruby("욕|설","辱|說")을 #ruby("반|포","頒|布")한다 하니 참으로 #ruby("탄|식","歎|息")과 쓴웃음이 나올 뿐이다.]
#zh[岂止汉城。仁川、开城等地方各地也一齐举行临时政府欢迎会。可是三八线以北正好相反，听说举行欢迎会的反而是颁布无比的辱骂，真只有叹息和苦笑。]
#heading(level: 3)[#text(font: "KOPUSGo B")[2) 지나온 자취를 찾아서]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그럭저럭 #ruby("민|국","民|國") 28#ruby("년","年")\(1946)을 맞이하자 나는 38#ruby("선","線") #ruby("이|남","以|南") #ruby("지|방","地|方") #ruby("순|회","巡|廻")를 #ruby("시|작","始|作")하였다. #ruby("제","第")1#ruby("차","次")로 #ruby("인|천","仁|川")을 #ruby("순|시","巡|視")하였는데, #ruby("인|천","仁|川")은 #ruby("의|미|심|장","意|味|深|長")한 #ruby("역|사|지|대","歷|史|地|帶")라 할 수 있다.]
#zh[不知不觉迎来民国二十八年（一九四六），我开始巡回三八线以南。第一站巡视仁川。仁川可以说是意味深长的历史地带。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|술","前|述")한 바를 #ruby("대|강","大|綱") 다시 #ruby("음|미","吟|味")하게 된다. 22#ruby("세","歲") 때 #ruby("인|천|감|옥","仁|川|監|獄")에서 #ruby("사|형","死|刑")을 받았다가 23#ruby("세","歲") 때 #ruby("탈|옥","脫|獄")·#ruby("도|주","逃|走")하였고, 41#ruby("세","歲") 때 17#ruby("년","年") #ruby("징|역","懲|役")을 #ruby("언|도","言|渡")받고 #ruby("인|천|감|옥","仁|川|監|獄")으로 #ruby("이|감","移|監")하였다.#footnote(numbering: _ => [2)])[#h(0.35em)#ruby("연|도","年|度")와 나이에 #ruby("약|간","若|干")의 #ruby("착|오","錯|誤")가 있다. #ruby("백|범","白|凡")이 #ruby("사|형","死|刑")을 #ruby("언|도","言|渡")받았을 때 나이는 21#ruby("세","歲")\(1896), 3#ruby("차","次") #ruby("투|옥","投|獄")으로 받은 #ruby("형","刑")은 17#ruby("형","刑")이 아닌 15#ruby("년|형","年|刑"), 그 #ruby("시|기","時|期")는 36#ruby("세","歲")\(1911), #ruby("인|천|감|옥","仁|川|監|獄")으로 다시 #ruby("이|감","移|監")되어 #ruby("축|항|공|사","築|港|工|事")를 한 #ruby("시|기","時|期")는 39#ruby("세","歲")\(1914)이다.]17#ruby("년","年") #ruby("전","前")에 #ruby("파|괴","破|壞")하고 #ruby("탈|주","脫|走")하였던 그 #ruby("감|옥","監|獄")을 다시 #ruby("철|망","鐵|網")에 얽히어 들어가니 말없는 #ruby("감|옥","監|獄")도 나를 아는 듯, 내가 있던 자리는 옛날 그대로 나를 맞아주었다. 그러나 17#ruby("년","年") #ruby("전","前") #ruby("김|창|수","金|昌|洙")는 #ruby("김|구","金|九")로 이름을 바꾸었고, #ruby("세|월","歲|月") 또한 오래 흐른 #ruby("관|계","關|係")로 아는 사람은 #ruby("별","別")로 없었다.]
#zh[前面说过的事，又大略回味了一遍。二十二岁在仁川监狱被判死刑，二十三岁越狱逃走，四十一岁被宣判十七年徒刑，移监到仁川监狱。十七年前破坏逃走的那座监狱，又被铁丝网缠着进去，无言的监狱也像认识我，我待过的位子还像从前一样迎接我。可是十七年前的金昌洙已经改名金九，岁月也过得久了，认识的人并没有几个。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("구|속","拘|束")된 몸으로 #ruby("징|역","懲|役") #ruby("공|사","工|事")한 곳이 #ruby("축|항|공|사|장","築|港|工|事|場")이었다. 그 #ruby("항|구","港|口")를 바라보니 나의 피와 땀이 젖은 듯하고, #ruby("면|회|차","面|會|次") #ruby("부|모","父|母")님이 #ruby("내|왕","來|往")하시던 길에는 눈물 #ruby("흔|적","痕|跡")이 남아 있는 듯 49#ruby("년","年") #ruby("전","前") 옛날 #ruby("기|억","記|憶")도 새로워 #ruby("감|개|무|량","感|慨|無|量")하였다. 지난 일에 #ruby("대","對")한 #ruby("감|회","感|懷")를 #ruby("금","禁")할 수 없는 #ruby("인|천","仁|川") #ruby("순|시","巡|視")는 #ruby("대|환|영|리","大|歡|迎|裡")에 마쳤다.]
#zh[被拘束着做徒刑工事的地方是筑港工场。望着那港口，好像浸透了我的血和汗；父母为面会来往的路上，好像还留着泪痕。四十九年前的旧记忆又新了，感慨无量。对往事禁不住感怀的仁川巡视，在大欢迎里结束。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제","第")2#ruby("차","次")로는 #ruby("공|주","公|州") #ruby("마|곡|사","麻|谷|寺")를 #ruby("시|찰","視|察")키로 하고 #ruby("공|주","公|州")에 #ruby("도|착","到|着")하니, #ruby("충|청|남|북","忠|淸|南|北") 11#ruby("군","郡")의 10#ruby("여|만","餘|萬") #ruby("동|포","同|胞")들이 #ruby("운|집","雲|集")하여 #ruby("환|영|회","歡|迎|會")를 #ruby("거|행","擧|行")하였다. #ruby("감|격|리","感|激|裡")에 #ruby("환|영|회","歡|迎|會")를 마치고 #ruby("공|주","公|州")를 떠나 #ruby("고","故") #ruby("김|복|한","金|福|漢")#footnote(numbering: _ => [3)])[#h(0.35em)#ruby("김|복|한","金|福|漢")\(1860〜1924). #ruby("호","號")는 #ruby("지|산","志|山"). 1895#ruby("년","年") #ruby("충|청|도","忠|淸|道") #ruby("홍|성","洪|城")에서 #ruby("을|미|의|병","乙|未|義|兵")을 일으키고, 1905#ruby("년","年") #ruby("을|사|조|약","乙|巳|條|約") #ruby("이|후","以|後") 다시 #ruby("의|병","義|兵")을 일으켰다. 1919#ruby("년","年") #ruby("유|림","儒|林")들의 #ruby("파|리|장|서","巴|里|長|書")#ruby("운|동","運|動")에도 #ruby("관|여","關|與")하였다.] #ruby("선|생","先|生")의 #ruby("영|정","影|幀")과 #ruby("면|암","勉|菴") #ruby("최|익|현","崔|益|鉉")#footnote(numbering: _ => [4)])[#h(0.35em)#ruby("최|익|현","崔|益|鉉")\(1833〜1906). 1895#ruby("년","年") #ruby("단|발|령","斷|髮|令")을 #ruby("계|기","契|機")로 #ruby("항|일|척|사|운|동","抗|日|斥|邪|運|動")을 벌였고, #ruby("을|사|조|약","乙|巳|條|約")에 #ruby("반|대","反|對")하여 1906#ruby("년","年") #ruby("전|북","全|北") 태안에서 #ruby("봉|기","蜂|起")하였다. 그#ruby("후","後") #ruby("대|마|도","對|馬|島")에 #ruby("유|배","流|配")되어 #ruby("옥|사","獄|死")하였다. #ruby("현|재","現|在") 그의 #ruby("춘|추|대|의|비","春|秋|大|義|碑")가 #ruby("충|남","忠|南") #ruby("예|산|군","禮|山|郡")에 세워져 있고, #ruby("충|남","忠|南") #ruby("청|양|군","靑|陽|郡")의 #ruby("모|덕|사","慕|德|祠") #ruby("등","等")에서 그를 #ruby("봉|향","奉|享")하고 있다.] #ruby("선|생","先|生")의 #ruby("영|정","影|幀")을 #ruby("심|방","尋|訪")·#ruby("배|알","拜|謁")하고, #ruby("동|민","洞|民")의 #ruby("환|영","歡|迎")과 아울러 #ruby("유|가|족","遺|家|族")을 #ruby("위|로","慰|勞")하였다.]
#zh[第二站决定视察公州麻谷寺。到了公州，忠清南北十一郡的十余万同胞云集，举行欢迎会。在感激里结束欢迎会，离开公州，寻访拜谒故金福汉先生的影像和勉庵崔益铉先生的影像，受到洞民的欢迎，并慰问了遗族。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("마|곡|사","麻|谷|寺")를 #ruby("향","向")하는 길에는 따라온 #ruby("각","各") #ruby("군","郡")의 #ruby("정|당","政|黨")·#ruby("사|회","社|會") #ruby("단|체","團|體")의 #ruby("대|표|자","代|表|者")만 350#ruby("명","名") #ruby("이|상","以|上")이었다. #ruby("소|식","消|息")을 #ruby("전","傳")해 들은 #ruby("마|곡|사","麻|谷|寺")에서는 #ruby("승|려","僧|侶")들이 #ruby("선|발|대","先|發|隊")로 #ruby("공|주","公|州")까지 #ruby("출|영","出|迎")하였고, #ruby("마|곡|사","麻|谷|寺") #ruby("동|구","洞|口")에는 #ruby("남|녀","男|女") #ruby("승|려","僧|侶")들이 #ruby("도|열","堵|列")하여 #ruby("지|성","至|誠")껏 #ruby("환|영","歡|迎")하니, 그 #ruby("이|유","理|由")는 옛날 #ruby("일|개","一|介") #ruby("승|려","僧|侶")의 몸으로 #ruby("일|국","一|國") #ruby("주|석","主|席")이 되어 오신다는 #ruby("감|격","感|激") 때문이었다.]
#zh[走向麻谷寺的路上，跟着来的各郡政党、社会团体代表就有三百五十名以上。得到消息的麻谷寺，僧侣作为先发队出迎到公州。麻谷寺洞口男女僧侣列队，至诚欢迎。理由是，从前一个僧侣之身，如今做了一国主席回来，他们为此感激。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[48#ruby("년","年") #ruby("전","前")에 중이 되어 굴갓#footnote(numbering: _ => [5)])[#h(0.35em)중이 쓰던 갓. 대로 만들었는데 #ruby("모|자","帽|子") 위가 둥글게 되어 있다.]을 쓰고 #ruby("염|주","念|珠") 걸고 바랑 지고 #ruby("출|입","出|入")하던 길로 #ruby("좌|우","左|右")를 살펴보며 천천히 들어가니, #ruby("의|구","依|舊")한 #ruby("산|천","山|川")은 나를 반겨주는 듯하다. #ruby("법|당|문","法|堂|門") 앞에 #ruby("당|도","當|到")하니, #ruby("대|웅|전","大|雄|殿") 기둥에 걸려 있는 #ruby("주|련","柱|聯")도 #ruby("변","變")치 않고 나를 맞아준다. 48#ruby("년","年") #ruby("전","前") #ruby("무|심","無|心")히 보았던 글#ruby("귀","句")를 #ruby("금|일","今|日") #ruby("자|세","仔|細")히 보니,]
#zh[四十八年前做了和尚，戴着僧笠，挂着念珠，背着行囊出入的那条路，我左右看着慢慢走进去，依旧的山川像在欢迎我。到了法堂门前，大雄殿柱子上挂的柱联也没有变，迎接我。四十八年前无心看过的文句，今天仔细一看：]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[물러나 #ruby("속|세","俗|世")의 일을 #ruby("돌아보니","却來觀世間")]
#zh[却来观世间]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[마치 꿈속의 일만 같다. (猶如夢中事)]
#zh[犹如梦中事。]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 되어 있다. 지나온 일들을 #ruby("생|각","生|覺")하니 이 글#ruby("귀","句")는 #ruby("과|연","果|然") 나를 두고 말한 것이 아닌가 #ruby("생|각","生|覺")되었다.]
#zh[写的是这样。想想走过的事，这文句果然像是指着我说的。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[옛날 #ruby("용|담|스|님","龍|潭|師|主")에게 #ruby("보|각|서|장","普|覺|書|狀")을 배우던 #ruby("염|화|실","拈|花|室")에서 하룻밤을 #ruby("의|미|심|장","意|味|深|長")하게 #ruby("유|숙","留|宿")하였다. 그날 밤 #ruby("승|려","僧|侶")들은 나를 #ruby("위","爲")하여 #ruby("지|성","至|誠")껏 #ruby("불|공","佛|供")을 울리었다. #ruby("사|찰","寺|刹")은 예나 #ruby("지|금","只|今")이나 #ruby("변","變")함없는 #ruby("기|상","氣|像")으로 나를 #ruby("환|영","歡|迎")하여주나, 48#ruby("년","年") #ruby("전","前")의 #ruby("승|려","僧|侶")들은 한 #ruby("명","名")도 볼 수 없었다.]
#zh[在从前跟龙潭师主教普觉书状的拈花室，意味深长地留宿了一夜。那天夜里僧侣们为我至诚做了佛供。寺刹以今昔不变的气象欢迎我，四十八年前的僧侣却一个也看不见了。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 아침 #ruby("영|원","永|遠")히 잊지 않는다는 #ruby("기|념","紀|念")으로 #ruby("무|궁|화","無|窮|花") 한 포기와 #ruby("향","香")나무 한 그루를 심고 #ruby("마|곡|사","麻|谷|寺")를 떠났다.#footnote(numbering: _ => [6)])[#h(0.35em)이때 #ruby("김|구","金|九")가 #ruby("방|문","訪|問")하여 심었다는 #ruby("향","香")나무는 #ruby("지|금","只|今")도 #ruby("마|곡|사","麻|谷|寺") #ruby("대|광|보|전","大|光|寶|殿") 앞에 남아 있다.]]
#zh[第二天早晨，作为永远不忘的纪念，种了一株无穷花和一棵香树，离开了麻谷寺。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제","第")3#ruby("차","次")로는 #ruby("예|산","禮|山") #ruby("시|량|리","枾|梁|里") #ruby("윤|봉|길","尹|奉|吉") #ruby("의|사","義|士")의 #ruby("본|댁","本|宅")을 #ruby("방|문","訪|問")하니 때는 4#ruby("월","月") 29#ruby("일","日")이었다. 거기서 #ruby("윤","尹")#ruby("의|사","義|士") #ruby("기|념|제","紀|念|祭")를 #ruby("거|행","擧|行")하고 다시 서울로 #ruby("귀|환","歸|還")하였다.]
#zh[第三站访问礼山柿梁里尹奉吉义士的本宅，时候是四月二十九日。在那里举行了尹义士纪念祭，又回到汉城。]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("즉|시","卽|時")로 #ruby("일|본","日|本")에 #ruby("체|류","滯|留")하고 있던 #ruby("박|렬","朴|烈")#footnote(numbering: _ => [7)])[#h(0.35em)#ruby("박|렬","朴|烈")\(1902〜1974). #ruby("무|정|부|주|의","無|政|府|主|義") #ruby("계|통","系|統")의 #ruby("독|립|운|동|가","獨|立|運|動|家"). #ruby("경|상|북|도","慶|尙|北|道") #ruby("문|경","聞|慶") #ruby("출|신","出|身"). #ruby("흑|도|회","黑|濤|會")·#ruby("흑|우|회","黑|友|會") #ruby("등","等")의 #ruby("비|밀|조|직","祕|密|組|織")을 #ruby("결|성","結|成")하였다. 1923#ruby("년","年") #ruby("비|밀|결|사","祕|密|結|社")인 #ruby("불|령|사","不|逞|社")를 #ruby("조|직","組|織")하여 #ruby("일|본","日|本") #ruby("황|태|자","皇|太|子") #ruby("결|혼|식","結|婚|式")을 #ruby("기","期")하여 #ruby("일|본","日|本") #ruby("천|황","天|皇")과 #ruby("일|본","日|本") #ruby("황|실","皇|室")의 #ruby("요|인","要|人")을 #ruby("폭|발","爆|發")시키려 하였으나 #ruby("실|패","失|敗")하여 #ruby("체|포","逮|捕")당한 #ruby("후","後"), #ruby("무|기|징|역","無|期|懲|役")으로 #ruby("복|역","服|役")#ruby("중","中") #ruby("해|방","解|放")이 되어 #ruby("석|방","釋|放")되었다. #ruby("정|부","政|府") #ruby("수|립","樹|立") #ruby("직|후","直|後") #ruby("일|본","日|本")에서 #ruby("귀|국","歸|國")했고, #ruby("한|국|전|쟁","韓|國|戰|爭") 때 #ruby("납|북","拉|北")당했다.] #ruby("동|지","同|志")에게 #ruby("부|탁","付|託")하여 #ruby("조|국","祖|國") #ruby("광|복","光|復")에 몸을 바쳐 #ruby("무|도","無|道")한 #ruby("왜|적","倭|敵")에게 #ruby("각|각","各|各") #ruby("학|살","虐|殺")을 #ruby("당","當")한 #ruby("윤|봉|길","尹|奉|吉")·#ruby("이|봉|창","李|奉|昌")·#ruby("백|정|기","白|貞|基") 3#ruby("열|사","烈|士")의 #ruby("유|골","遺|骨")을 #ruby("환|골","還|骨")시키게 하고 #ruby("국|내","國|內")에서 #ruby("장|례","葬|禮") #ruby("준|비","準|備")를 #ruby("진|행","進|行")하였다. 그러던 #ruby("중","中") “#ruby("유|골","遺|骨")이 #ruby("부|산","釜|山")에 #ruby("도|착","到|着")하였다”는 #ruby("기|별","奇|別")을 듣고, #ruby("영|접|차","迎|接|次") #ruby("특|별|열|차","特|別|列|車")로 #ruby("부|산","釜|山")을 #ruby("향","向")하였다. 3#ruby("열|사","烈|士")의 말없는 #ruby("개|선","凱|旋")에 #ruby("유|골|봉|환|식","遺|骨|奉|還|式")을 #ruby("거|행","擧|行")하고, #ruby("영|구","靈|柩")를 서울로 #ruby("봉|환","奉|還")하기 #ruby("위","爲")해 #ruby("부|산|역","釜|山|驛")을 #ruby("출|발","出|發")하였다. #ruby("부|산|역","釜|山|驛") 앞에서 서울까지 #ruby("각","各") #ruby("역|전","驛|前")마다, #ruby("사|회|단|체","社|會|團|體")와 #ruby("교|육|기|관","敎|育|機|關")은 #ruby("물|론","勿|論")이고 #ruby("일|반","一|般") #ruby("인|사","人|士")들까지 #ruby("운|집","雲|集")·#ruby("도|열","堵|列")하여 #ruby("추|도|식","追|悼|式")을 #ruby("거|행","擧|行")하니, #ruby("산|천|초|목","山|川|草|木")도 슬퍼하는 듯 #ruby("감|개|무|량","感|慨|無|量")하였다.]
#zh[我立刻拜托滞留日本的朴烈同志，把为祖国光复献身、各被无道倭寇虐杀的尹奉吉、李奉昌、白贞基三位烈士的遗骨还回来，在国内进行葬礼准备。这时听说“遗骨到了釜山”，为迎接坐特别列车前往釜山。为三位烈士无言的凯旋举行了遗骨奉还式，为把灵柩奉还汉城，从釜山站出发。从釜山站前到汉城，每一站前，社会团体和教育机关不必说，一般人士也云集列队举行追悼式，山川草木也像在悲伤，感慨无量。]
