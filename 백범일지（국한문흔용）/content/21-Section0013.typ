#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("안|심","安|心")하고 #ruby("홍|콩","香|港")으로 #ruby("출|발","出|發")하였다. #ruby("홍|콩","香|港")으로 간 것은 #ruby("안|정|근","安|定|根")·#ruby("안|공|근","安|恭|根") 두 사람에게 #ruby("부|탁","付|託")한 #ruby("대|사|건","大|事|件"), #ruby("즉","卽") 그들 #ruby("형|수","兄|嫂")인 #ruby("안|중|근","安|重|根") #ruby("의|사","義|士")의 #ruby("부|인","夫|人")을 #ruby("상|해","上|海")에서 모셔내어 #ruby("왜","倭")놈 #ruby("점|령|구","占|領|區")를 빠져나오게 할 #ruby("목|적","目|的")이었다. #ruby("당|초","當|初") #ruby("남|경","南|京")에서 #ruby("대|가|족","大|家|族")을 #ruby("장|사","長|沙")로 옮기기로 하고 #ruby("공|근","恭|根")을 #ruby("상|해","上|海")에 #ruby("밀|파","密|派")할 때, #ruby("자|동|차","自|動|車")를 #ruby("사|용","使|用")하여#footnote(numbering: _ => [2)])[#h(0.35em)#ruby("원|주","原|註"): “寧鐵道가 戰爭으로 因하여 不通됨.” #ruby("호|령|철|도","滬|寧|鐵|道")는 #ruby("상|해","上|海")〜#ruby("남|경","南|京")#ruby("간","間") #ruby("철|도","鐵|道"). #ruby("남|경","南|京")이 일찍이 #ruby("강|령|부","江|寧|府")에 #ruby("속","屬")해 있었기 때문에 #ruby("령","寧")은 #ruby("남|경","南|京")을 뜻한다.] #ruby("자|기","自|己") #ruby("가|족","家|族")을 #ruby("남|경","南|京")으로 #ruby("이|주","移|住")하도록 하였는데, 이때 #ruby("형|수","兄|嫂") #ruby("댁","宅") #ruby("식|구","食|口")를 같이 데려오라 하였으나 #ruby("성|공","成|功")치 못한 것이 #ruby("일|대","一|大") #ruby("유|감","遺|憾")이었던 까닭이다. #ruby("홍|콩","香|港")서 마침 #ruby("비|밀|공|작","祕|密|工|作") #ruby("임|무","任|務")를 띠고 #ruby("상|해","上|海")로 #ruby("파|송","派|送")되던 #ruby("유|서","柳|絮")와 같이 #ruby("안|군","安|君") #ruby("형|제","兄|弟")와 #ruby("회|의","會|議")할 때, 나는 #ruby("강|경","强|硬")한 #ruby("주|장","主|張")으로 #ruby("안|의|사","安|義|士") #ruby("부|인","夫|人")을 #ruby[적치구역][淪陷區]인 #ruby("상|해","上|海")에서 모셔오자고 하였으나 그들이 #ruby("난|색","難|色")을 보였다. 나는]
