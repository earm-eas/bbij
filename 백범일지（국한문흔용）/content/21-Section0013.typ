#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런 까닭에 나는 한 걸음 더 나아가 #ruby("유|주","柳|州")에 있는 #ruby("동|지","同|志")와, #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")의 #ruby("동|포","同|胞")들에 #ruby("대","對")해서도 #ruby("의|견","意|見") #ruby("일|치","一|致")를 #ruby("구","求")하였다. 그런데 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")에서 #ruby("회|답","回|答")이 오기를,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("통|일","統|一")은 #ruby("찬|성","贊|成")하나, #ruby("김|약|산","金|若|山")은 #ruby("공|산|주|의|자","共|産|主|義|者")요. #ruby("선|생","先|生")이 #ruby("공|산|당","共|産|黨")과 #ruby("합|작","合|作")하여 #ruby("통|일","統|一")하는 날, 우리 #ruby("미|국","美|國") #ruby("교|포","僑|胞")와는 #ruby("인|연","因|緣")이 끊어지는 줄 알고 #ruby("통|일|운|동","統|一|運|動")을 하시오.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("약|산","若|山")과 #ruby("상|의","相|議")한 #ruby("결|과","結|果") #ruby("연|명|선|언","聯|名|宣|言")으로 #ruby("조|국|광|복","祖|國|光|復")을 #ruby("위","爲")해 #ruby("민|족|운|동","民|族|運|動")이 #ruby("필|요","必|要")하다고 #ruby("발|표","發|表")하였다.#footnote(numbering: _ => [14)])[#h(0.35em)‘#ruby("연|명|선|언","聯|名|宣|言")’은 1939#ruby("년","年") 5#ruby("월","月") #ruby("김|구","金|九")와 #ruby("김|원|봉","金|元|鳳")이 #ruby("공|동","共|同")으로 #ruby("발|표","發|表")한 「#ruby("동|지","同|志")·#ruby("동|포","同|胞") #ruby("제|군","諸|君")에게 #ruby("고","告")함」을 가리킨다. 이 #ruby("연|명|선|언","聯|名|宣|言")에서는 #ruby("현|단|계","現|段|階")의 10#ruby("대","大") #ruby("정|치|강|령","政|治|綱|領")을 #ruby("제|시","提|示")하였는데, #ruby("주|요","主|要") #ruby("내|용","內|容")은 #ruby("자|주|독|립","自|主|獨|立")의 #ruby("민|주|공|화|제","民|主|共|和|制") #ruby("수|립","樹|立"), #ruby("기|업","企|業")의 #ruby("국|유|화","國|有|化"), #ruby("토|지|국|유|제","土|地|國|有|制"), #ruby("토|지","土|地")의 #ruby("농|민","農|民") #ruby("분|배","分|配")와 #ruby("매|매","賣|買") #ruby("금|지","禁|止") #ruby("등","等")이다.] #ruby("유|주","柳|州") #ruby("국|민|당","國|民|黨") #ruby("간|부","幹|部")들로부터는 #ruby("좌|우|간","左|右|間") #ruby("중|경","重|慶")에 가서 #ruby("토|론","討|論")하여 #ruby("결|정","決|定")하자는 #ruby("회|답","回|答")이 왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|강","綦|江") #ruby("선|발|대","先|發|隊")가 #ruby("도|착","到|着")하고, 뒤이어 #ruby("백|여","百|餘") #ruby("식|구","食|口")들도 다들 #ruby("무|사","無|事")히 #ruby("중|경","重|慶")에 #ruby("안|착","安|着")하였다. 그러나 #ruby("유|독","唯|獨") 어머님만은 #ruby("병","病")이 #ruby("점|점","漸|漸") #ruby("중|태","重|態")에 빠져들었다. #ruby("당|신","當|身")도 이미 #ruby("회|생","回|生")치 못할 것을 #ruby("각|오","覺|悟")하시고 말씀하셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어서 #ruby("독|립","獨|立")이 #ruby("성|공","成|功")되도록 #ruby("노|력","努|力")하고, #ruby("성|공","成|功")하여 #ruby("귀|국","歸|國")할 때 나의 #ruby("유|골","遺|骨")과 #ruby("인","仁")이 어미의 #ruby("유|골","遺|骨")까지 가지고 돌아가 #ruby("고|향","故|鄕")에 묻어라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 50#ruby("여","餘") #ruby("년","年") #ruby("고|생","苦|生")하다가 #ruby("자|유","自|由") #ruby("독|립","獨|立")되는 것도 보지 못하고 #ruby("극","極")히 #ruby("원|통","冤|痛")하게 돌아가셨다. #ruby("대|한|민|국","大|韓|民|國") 21#ruby("년","年")\(1939) 4#ruby("월","月") 26#ruby("일","日") #ruby("손|가|화|원","孫|家|花|園") 안에서 #ruby("영|영","永|永") 다시 돌아올 수 없는 길을 가셨다. 그곳에서 5#ruby("리","里") #ruby("가|량","假|量") 되는 #ruby("화|상|산","和|尙|山") #ruby("공|동|묘|지","共|同|墓|地")에 #ruby("석|실","石|室")을 만들어 어머님을 모셨다. #ruby("모|친","母|親")은 살아 #ruby("생|전","生|前")에도 #ruby("대|가|족","大|家|族") #ruby("중","中") #ruby("최|고|령","最|高|齡")인 #ruby("관|계","關|係")로 #ruby("존|장","尊|丈") #ruby("대|접","待|接")을 받으시더니, 돌아가신 뒤에도 #ruby("매|장|지","埋|葬|地") #ruby("부|근","附|近")에 #ruby("현|정|경","玄|正|卿")·#ruby("한|일|래","韓|一|來") #ruby("등","等") #ruby("수|십","數|十") #ruby("명","名")의 #ruby("한|인","韓|人") #ruby("연|하|자","年|下|者")들의 ‘#ruby("지|하|회|장","地|下|會|長")’인 듯싶다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 #ruby("생|전","生|前")에 모든 일을 손수 #ruby("처|리","處|理")하셨다. #ruby("종|전","從|前")에 우리나라는 #ruby("노|복","奴|僕")을 #ruby("사|용","使|用")하였으나, #ruby("국|가","國|家")가 #ruby("병|탄","倂|呑")된 뒤 #ruby("경|향","京|鄕")에서 #ruby("동|포","同|胞")들의 #ruby("양|심","良|心") #ruby("발|동","發|動")으로 “내가 #ruby("일|본|인","日|本|人")의 #ruby("노|예","奴|隸")가 되어 어찌 차마 #ruby("동|포","同|胞")를 종으로 #ruby("사|용","使|用")하랴” 하고 #ruby("자|연","自|然")히 #ruby("노|복|제","奴|僕|制")를 물리치고 #ruby("고|용|제","雇|傭|制")를 #ruby("사|용","使|用")하였다. 어머님은 일찍이 #ruby("노|복","奴|僕")은 #ruby("물|론","勿|論")이고, #ruby("팔|십","八|十") #ruby("평|생","平|生") ‘#ruby("고|용","雇|傭")’ 두 글#ruby("자","字")와도 #ruby("상|관","相|關")이 없으셨다. 돌아가실 때까지 손수 옷을 꿰매고 밥을 짓고, #ruby("일|생","一|生") 동안 다른 사람의 손으로 #ruby("당|신","當|身")의 일을 시켜보지 않으신 것도 #ruby("특|이","特|異")하다고 하겠다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|가|족","大|家|族")이 #ruby("기|강","綦|江")에 #ruby("무|사","無|事")히 #ruby("도|착","到|着")한 뒤, 나는 #ruby("조|완|구","趙|琬|九")·#ruby("엄|항|섭","嚴|恒|燮") #ruby("등","等") #ruby("국|민|당","國|民|黨") #ruby("간|부","幹|部")들을 불러모아 #ruby("통|일|문|제","統|一|問|題")를 #ruby("토|의","討|議")하였다. 그런데 그들의 #ruby("견|해","見|解")는 나와 #ruby("정|반|대","正|反|對")였다. #ruby("간|부","幹|部")는 #ruby("물|론","勿|論")이고 #ruby("국|민|당","國|民|黨") #ruby("전|체","全|體") #ruby("당|원","黨|員")뿐 아니라 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨")·#ruby("한|국|독|립|당","韓|國|獨|立|黨") #ruby("양|당","兩|黨")도 모두 #ruby("연|합|통|일","聯|合|統|一")을 #ruby("주|장","主|張")하였다. 그 #ruby("이|유","理|由")는 #ruby("주|의","主|義")가 같지 않은 #ruby("단|체","團|體")와 #ruby("단|일|조|직","單|一|組|織")은 #ruby("불|가|능","不|可|能")하다는 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("각","各") #ruby("당","黨")이 #ruby("자|기","自|己") #ruby("본|체","本|體")를 그대로 두고 #ruby("연|합|조|직","聯|合|組|織")을 만든다면, #ruby("통|일|기|구","統|一|機|構") 안에서 #ruby("각|기","各|其") #ruby("자|기","自|己") #ruby("단|체","團|體")의 #ruby("발|전","發|展")을 #ruby("도|모","圖|謀")할 터이니, 도리어 #ruby("마|찰","摩|擦")이 더욱 #ruby("심","甚")할 것으로 생각하였다. 또한 그 #ruby("전","前")에는 #ruby("사|회|주|의|자","社|會|主|義|者")들이 #ruby("민|족|운|동","民|族|運|動")을 #ruby("반|대","反|對")하였으나, #ruby("사|회|운|동","社|會|運|動")은 #ruby("독|립","獨|立") #ruby("완|성","完|成") #ruby("후","後") #ruby("본|국","本|國")에 가서 하고 #ruby("지|금","只|今") #ruby("해|외|운|동","海|外|運|動")은 #ruby("순|전","純|全")히 #ruby("민|족|적","民|族|的")으로 #ruby("국|권","國|權")의 #ruby("완|전","完|全") #ruby("회|복","回|復")에만 #ruby("전|력","全|力")하자고 #ruby("극|력","極|力") #ruby("주|장","主|張")하니, 나는 #ruby("단|일|조|직","單|一|組|織")을 만들 수 있을 것으로 생각하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("국|민|당","國|民|黨") #ruby("간|부","幹|部")들은]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("이|사|장","理|事|長") #ruby("의|견","意|見")이 그러시다면 #ruby("속","速")히 #ruby("기|강","綦|江")에 같이 가셔서 우리 #ruby("국|민|당","國|民|黨") #ruby("전|체","全|體") #ruby("당|원","黨|員")들과 두 #ruby("우|당","友|黨") #ruby("당|원","黨|員")들의 #ruby("의|사","意|思")가 #ruby("일|치","一|致")되도록 #ruby("노|력","努|力")하지 않으면 #ruby("성|공","成|功")하기 어려울 것입니다. #ruby("유|주","柳|州")에서는 #ruby("국|민|당","國|民|黨")은 #ruby("물|론","勿|論")이고 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨")·#ruby("한|국|독|립|당","韓|國|獨|立|黨") #ruby("우|당","友|黨") #ruby("당|원","黨|員")들까지도 #ruby("연|합|론","聯|合|論")이 #ruby("강","强")합니다.”]
