#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리하여 #ruby("기|강","綦|江")에서 7#ruby("당","黨") #ruby("통|일|회|의","統|一|會|議")를 #ruby("개|최","開|催")하였다. #ruby("한|국|국|민|당","韓|國|國|民|黨")·#ruby("한|국|독|립|당","韓|國|獨|立|黨")·#ruby("조|선|혁|명|당","朝|鮮|革|命|黨") #ruby("등","等")은 #ruby("광|복|진|선","光|復|陣|線") #ruby("소|속","所|屬")의 #ruby("원|동|지|역","遠|東|地|域") 3#ruby("당","黨")이며, #ruby("조|선|민|족|혁|명|당","朝|鮮|民|族|革|命|黨")·#ruby("조|선|민|족|해|방|동|맹","朝|鮮|民|族|解|放|同|盟")·#ruby("조|선|민|족|전|위|동|맹","朝|鮮|民|族|前|衛|同|盟")·#ruby("조|선|혁|명|자|연|맹","朝|鮮|革|命|者|聯|盟") #ruby("등","等") 4#ruby("개","個") #ruby("단|체","團|體")는 #ruby("민|족|전|선|연|맹","民|族|戰|線|聯|盟") #ruby("소|속","所|屬")이다.#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("기|강","綦|江") 7#ruby("당|회|의","黨|會|議")는 1939#ruby("년","年") 8#ruby("월","月") 27#ruby("일","日") #ruby("개|최","開|催")되었다. 이 #ruby("회|의","會|議")에는 7#ruby("당","黨")의 #ruby("대|표","代|表") 2#ruby("명","名")씩 #ruby("총","總") 14#ruby("명","名")의 #ruby("대|표","代|表")가 #ruby("참|석","參|席")하였다.] #ruby("개|회","開|會") #ruby("후","後") #ruby("대|다|수","大|多|數") #ruby("쟁|점","爭|點")이 #ruby("단|일|화","單|一|化")되는 것을 #ruby("간|파","看|破")한 #ruby("해|방","解|放")·#ruby("전|위","前|衛") #ruby("양|동|맹","兩|同|盟")은, #ruby("자|기","自|己") #ruby("단|체","團|體")가 #ruby("해|소","解|消")되기 #ruby("원","願")하지 않는다는 #ruby("이|유","理|由")를 #ruby("설|명","說|明")하고 #ruby("퇴|장","退|場")해 버렸다. #ruby("양|동|맹","兩|同|盟")은 #ruby("공|산|주|의|자","共|産|主|義|者") #ruby("단|체","團|體")이므로 #ruby("민|족|운|동","民|族|運|動")을 #ruby("위","爲")하여 #ruby("자|기","自|己") #ruby("단|체","團|體")를 #ruby("희|생","犧|牲")하는 것은 #ruby("불|가|능","不|可|能")하다고 #ruby("이|전","以|前")부터 #ruby("주|장","主|張")하던 터이니, 크게 놀라거나 #ruby("괴|이","怪|異")하게 생각할 것은 없다.#footnote(numbering: _ => [16)])[#h(0.35em)「#ruby("기|강","綦|江") #ruby("한|국","韓|國") 7#ruby("당","黨") #ruby("통|일|회|의","統|一|會|議") #ruby("경|과|보|고|서","經|過|報|告|書")」에 #ruby("의","依")하면 #ruby("김|원|봉","金|元|鳳") #ruby("측","側")은 #ruby("김|구","金|九") #ruby("측","側")이 #ruby("제|시","提|示")한 #ruby("토|지|국|유","土|地|國|有"), #ruby("신|당","新|黨")의 #ruby("상|무|위|원|제","常|務|委|員|制") #ruby("채|택","採|擇"), #ruby("신|당","新|黨")의 #ruby("임|시|정|부","臨|時|政|府") #ruby("옹|호","擁|護")와 #ruby("군|사|외|교","軍|事|外|交") #ruby("임|정","臨|政") #ruby("경|유","經|由") #ruby("처|리","處|理"), #ruby("당|원","黨|員") #ruby("자|격","資|格") #ruby("문|제","問|題"), #ruby("삼|균|주|의","三|均|主|義") #ruby("실|행","實|行") #ruby("등","等") 5#ruby("대","大") #ruby("절|대|조|건","絶|對|條|件")이 #ruby("실|패","失|敗")의 #ruby("주|요","主|要")한 #ruby("원|인","原|因")이라고 #ruby("지|적","指|摘")하였다. #ruby("반|면","反|面") #ruby("김|구","金|九") #ruby("측","側")은 #ruby("당|원","黨|員") #ruby("자|격","資|格") #ruby("문|제","問|題")와 #ruby("임|시|정|부","臨|時|政|府") #ruby("불|신|임","不|信|任") #ruby("문|제","問|題")를 #ruby("원|인","原|因")으로 #ruby("지|적","指|摘")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이에 곧장 5#ruby("당","黨") #ruby("통|일","統|一")의 #ruby("순|서","順|序")를 밟아 #ruby("순|전","純|全")한 #ruby("민|족|주|의|적","民|族|主|義|的") #ruby("신|당","新|黨")을 #ruby("조|직","組|織")하여 #ruby("각","各") #ruby("당","黨") #ruby("수|석","首|席") #ruby("대|표","代|表")들이 8#ruby("개|조","個|條")의 #ruby("협|정","協|定")에 #ruby("친|필","親|筆") #ruby("서|명","署|名")하고 며칠#ruby("간","間")의 #ruby("휴|식","休|息")에 들어갔다.#footnote(numbering: _ => [17)])[#h(0.35em)5#ruby("당|회|의","黨|會|議") 때 #ruby("공|식|적","公|式|的")으로 #ruby("합|의","合|意")한 8#ruby("개","個") #ruby("조|항","條|項")은 #ruby("자|료","資|料")에 나와 있지 않아서 무엇인지 #ruby("구|체|적","具|體|的")으로 알 수 없다. #ruby("혹|시","或|是") #ruby("김|원|봉","金|元|鳳")과 #ruby("연|명","聯|名")으로 #ruby("발|표","發|表")한 「#ruby("동|지","同|志")·#ruby("동|포","同|胞") #ruby("제|군","諸|君")에게 #ruby("고","告")함」이라는 #ruby("공|동|성|명","共|同|聲|明")에서 #ruby("합|의","合|意")한 10#ruby("대","大") #ruby("정|치|강|령","政|治|綱|領")일 수도 있다.] 그런데 #ruby("민|족|혁|명|당","民|族|革|命|黨") #ruby("대|표","代|表") #ruby("김|약|산","金|若|山") #ruby("등","等")이 갑자기]
