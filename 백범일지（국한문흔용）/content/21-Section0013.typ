#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 3#ruby("당","黨") #ruby("동|지","同|志")들과 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷") #ruby("각","各") #ruby("단|체","團|體")를 #ruby("향","向")하여 #ruby("사|과","謝|過")하고, #ruby("원|동|지|역","遠|東|地|域") 3#ruby("당","黨") #ruby("통|일|회|의","統|一|會|議")를 #ruby("계|속","繼|續") 열어 #ruby("한|국|독|립|당","韓|國|獨|立|黨")이 새로 #ruby("탄|생","誕|生")되었다. 7#ruby("당","黨"), 5#ruby("당","黨") #ruby("통|일","統|一")은 #ruby("실|패","失|敗")하였으나 3#ruby("당","黨") #ruby("통|일","統|一")이 #ruby("완|성","完|成")될 때, #ruby("하|와|이|애|국|단","夏|威|夷|愛|國|團")과 #ruby("하|와|이|단|합|회","夏|威|夷|團|合|會")가 #ruby("자|기","自|己") #ruby("단|체","團|體")를 #ruby("취|소","取|消")하고 #ruby("한|국|독|립|당","韓|國|獨|立|黨") #ruby("하|와|이|지|부","夏|威|夷|支|部")#footnote(numbering: _ => [18)])[#h(0.35em)#ruby("하|와|이|단|합|회","夏|威|夷|團|合|會")는 1931#ruby("년","年") 전녹영·#ruby("현|순","玄|楯") #ruby("등","等") #ruby("하|와|이","夏|威|夷") #ruby("동|포","同|胞")들이 #ruby("임|정","臨|政")의 #ruby("재|정","財|政") #ruby("후|원","後|援")을 #ruby("목|표","目|標")로 #ruby("결|성","結|成")한 #ruby("단|체","團|體")인데, 1939#ruby("년","年") 4#ruby("월","月") 29#ruby("일","日") #ruby("하|와|이|애|국|단","夏|威|夷|愛|國|團")에 #ruby("합|류","合|流")하였다. 1940#ruby("년","年") 5#ruby("월","月") 9#ruby("일","日") #ruby("중|국","中|國")에서 #ruby("한|국|독|립|당","韓|國|獨|立|黨")이 #ruby("결|성","結|成")되자 #ruby("하|와|이|애|국|단","夏|威|夷|愛|國|團")은 #ruby("한|독|당","韓|獨|黨") #ruby("하|와|이|지|부","夏|威|夷|支|部")로 #ruby("변|경","變|更")되었다. 이 #ruby("지|부","支|部")는 #ruby("임|정","臨|政")의 #ruby("특|무|공|작","特|務|工|作")과 #ruby("한|국|광|복|군","韓|國|光|復|軍") #ruby("편|성","編|成")에 #ruby("경|제|적","經|濟|的")으로 #ruby("후|원","後|援")하였고, 1941#ruby("년","年") 4#ruby("월","月") #ruby("재|미|한|족|연|합|위|원|회","在|美|韓|族|聯|合|委|員|會")에 #ruby("참|가","參|加")하였다.]로 #ruby("성|립","成|立")되니, #ruby("실","實")은 3#ruby("당","黨")이 아니라 5#ruby("당","黨")이 #ruby("통|일","統|一")된 것이다. #ruby("한|국|독|립|당","韓|國|獨|立|黨") #ruby("집|행|위|원|장","執|行|委|員|長")은 #ruby("김|구","金|九"), #ruby("집|행|위|원","執|行|委|員")으로는 #ruby("홍|진","洪|震")·#ruby("조|소|앙","趙|素|昻")·#ruby("조|시|원","趙|時|元")·#ruby("이|청|천","李|靑|天")·#ruby("김|학|규","金|學|奎")·#ruby("유|동|열","柳|東|說")·#ruby("안|훈","安|勳")·#ruby("송|병|조","宋|秉|祚")·#ruby("조|완|구","趙|琬|九")·#ruby("엄|항|섭","嚴|恒|燮")·#ruby("김|붕|준","金|朋|濬")·#ruby("양|묵","楊|墨")·#ruby("조|성|환","曺|成|煥")·#ruby("박|찬|익","朴|贊|翊")·#ruby("차|리|석","車|利|錫")·#ruby("이|복|원","李|復|源"), #ruby("감|찰|위|원|장","監|察|委|員|長")은 #ruby("이|동|녕","李|東|寧"), #ruby("감|찰|위|원","監|察|委|員")은 #ruby("이|시|영","李|始|榮")·#ruby("공|진|원","公|鎭|遠")·#ruby("김|의|한","金|毅|漢") #ruby("등","等")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("임|시|의|정|원","臨|時|議|政|院")에서는 #ruby("임|시|정|부","臨|時|政|府") #ruby("국|무|위|원","國|務|委|員")을 #ruby("개|선","改|選")하고, #ruby("국|무|회|의","國|務|會|議") #ruby("주|석","主|席")을 #ruby("종|래","從|來")와 같이 돌아가며 하던 ‘#ruby("윤|회|주|석|제","輪|回|主|席|制")’를 #ruby("폐|지","廢|止")하고, #ruby("주|석","主|席")에게 #ruby("회|의","會|議") #ruby("주|석","主|席") #ruby("외","外") #ruby("대|내|외","對|內|外")에 #ruby("책|임","責|任")을 지는 #ruby("권|한","權|限")을 #ruby("부|여","附|與")하였다.#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("임|정","臨|政")은 1940#ruby("년","年") 4#ruby("차","次") #ruby("개|헌","改|憲")을 #ruby("단|행","斷|行")하여 #ruby("종|래","從|來") #ruby("집|단|지|도|체|제","集|團|指|導|體|制")를 #ruby("개|편","改|編")하고 #ruby("국|무|위|원|회","國|務|委|員|會") #ruby("주|석","主|席")의 #ruby("권|한","權|限")을 크게 #ruby("강|화","强|化")시켰다. 이제 #ruby("임|정","臨|政")의 #ruby("주|석","主|席")은 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("대|표","代|表")하는 #ruby("최|고|직|책","最|高|職|責")일 뿐만 아니라 #ruby("군|사|권","軍|事|權")을 #ruby("지|휘","指|揮")할 수 있는 #ruby("권|한","權|限")까지 가지게 되었다.] 나는 #ruby("국|무|회|의","國|務|會|議") #ruby("주|석","主|席")으로 #ruby("피|임","被|任")되었고, #ruby("미|국","美|國") #ruby("수|도","首|都") #ruby("워|싱|턴","華|盛|頓")에 #ruby("외|교|위|원|부","外|交|委|員|部")를 #ruby("설|치","設|置")하고 #ruby("이|승|만","李|承|晩") #ruby("박|사","博|士")를 #ruby("위|원|장","委|員|長")으로 #ruby("임|명","任|命")하여 #ruby("취|임","就|任")케 하였다.]
