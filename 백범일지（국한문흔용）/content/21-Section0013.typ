#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리(#ruby("백|범","白|凡")·#ruby("조|성|환","曺|成|煥")·#ruby("나|태|섭","羅|泰|燮"))는 #ruby("중|경","重|慶")으로 #ruby("출|발","出|發")하여 10#ruby("여","餘") #ruby("일","日") #ruby("후","後") #ruby("귀|양","貴|陽")에 #ruby("도|착","到|着")하였다. 여러 해 동안 #ruby("남|중|국","南|中|國")의 #ruby("토|지","土|地")가 #ruby("비|옥","肥|沃")하고 #ruby("물|산","物|産")이 #ruby("풍|부","豐|富")한 곳만 보아서 그런지 알 수 없지만, #ruby("귀|양|시","貴|陽|市")에 #ruby("왕|래","往|來")하는 사람 #ruby("중","中") #ruby("극|소|수","極|少|數")를 #ruby("제|외","除|外")한 나머지 #ruby("절|대","絶|對") #ruby("다|수","多|數")가 #ruby("현|순|백|결","懸|鶉|百|結")이고 #ruby("안|면|채|색","顔|面|菜|色")이라.#footnote(numbering: _ => [8)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “누덕누덕 기운 옷을 입었고 얼굴#ruby("색","色")도 굶주린 사람처럼 누르스름했다.” ‘#ruby("현|순|백|결","懸|鶉|百|結")’은 옷이 갈가리 찢어진 모습, ‘#ruby("안|면|채|색","顔|面|菜|色")’은 사람이 굶주려 얼굴빛이 누르스름한 것을 말한다.] #ruby("귀|양","貴|陽")의 #ruby("산|천","山|川")에는 돌이 많고 흙이 적었다. #ruby("농|가","農|家")에서 흙을 져다가 #ruby("암|석","巖|石") 위에 깔고 씨를 뿌린 것을 보아도 흙이 #ruby("지|극","至|極")히 #ruby("귀","貴")한 것을 알 수 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("한|족","漢|族")보다 #ruby("특","特")히 #ruby("묘|족","苗|族")의 #ruby("형|색","形|色")이 #ruby("극","極")히 #ruby("궁|핍","窮|乏")하고 #ruby("행|동","行|動")이 #ruby("야|만","野|蠻")스러워 보였다. #ruby("중|국","中|國")말을 모르는 내가 #ruby("언|어","言|語")로 #ruby("한|족","漢|族")과 #ruby("묘|족","苗|族")을 #ruby("구|별","區|別")하기는 어려웠으나, #ruby("묘|족","苗|族") #ruby("여|자","女|子")는 #ruby("의|복","衣|服")으로 #ruby("구|별","區|別")하고, #ruby("묘|족","苗|族") #ruby("남|자","男|子")는 #ruby[야만스런][文野] #ruby("눈|빛","眼|光")으로 #ruby("분|별","分|別")할 수 있었는데, #ruby("한|족","漢|族")#ruby("화","化")한 #ruby("묘|족","苗|族")들도 많은 듯했다.#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("원|문","原|文"): “苗族化한 漢人도 많은 듯하다.” 뒤의 #ruby("문|맥","文|脈")과의 #ruby("일|치|성","一|致|性")이나 #ruby("역|사|적","歷|史|的") #ruby("사|실","事|實")로 볼 때 #ruby("근|래","近|來") #ruby("한|족","漢|族")#ruby("화","化")한 #ruby("묘|족","苗|族")도 많다고 해야 #ruby("타|당","妥|當")할 것이다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("묘|족","苗|族")은 4,000#ruby("여","餘") #ruby("년","年") #ruby("전","前") #ruby("삼|묘","三|苗")#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("중|국","中|國") #ruby("요|순","堯|舜")#ruby("시|대","時|代")에 있던 #ruby("남|방","南|方") #ruby("묘|족","苗|族")의 #ruby("선|조","先|祖").] #ruby("씨","氏")의 #ruby("자|손","子|孫")이니, #ruby("삼|묘","三|苗") #ruby("씨","氏")는 #ruby("전|생","前|生")에 무슨 #ruby("업|보","業|報")가 있기로 #ruby("자|손","子|孫")들이 #ruby("누|천|년","累|千|年") #ruby("역|사|상","歷|史|上")에 #ruby("특|출","特|出")한 #ruby("인|물","人|物")이 있다는 #ruby("역|사|기|록","歷|史|記|錄")을 보지 못하였다. 그런 까닭에 나는 #ruby("삼|묘","三|苗") #ruby("씨","氏")라는 것이 #ruby("고|대","古|代") #ruby("명|칭","名|稱")으로 #ruby("잔|존","殘|存")할 뿐 #ruby("근|대","近|代")에는 없어진 줄 알았다. 그런데 이제 #ruby("묘|족","苗|族")도 #ruby("수|십","數|十") #ruby("수|백","數|百") #ruby("종|별","種|別")로 #ruby("변|화","變|化")하여 #ruby("호|남","湖|南")·#ruby("광|동","廣|東")·#ruby("광|서","廣|西")·#ruby("운|남","雲|南")·#ruby("귀|주","貴|州")·#ruby("사|천","四|川")·#ruby("서|강","西|康") #ruby("등","等")에 널리 퍼져 있다. #ruby("근|대","近|代")에 #ruby("한|족","漢|族")#ruby("화","化")한 #ruby("묘|족","苗|族") #ruby("중","中") #ruby("영|걸","英|傑")이 있다는데, #ruby[풍문][風便傳說]에 #ruby("의","依")하면 #ruby("광|서","廣|西") #ruby("백|숭|희","白|崇|禧") #ruby("장|군","將|軍")과 #ruby("운|남","雲|南") #ruby("주|석","主|席") #ruby("용|운","龍|雲") #ruby("등","等")이 #ruby("묘|족","苗|族")이라 한다. 그러나 #ruby("묘|족","苗|族")의 #ruby("선|조","先|祖")를 알지 못하는 나로서는 #ruby[풍문][風便傳說]의 옳고 그름을 말할 수 없다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("귀|양","貴|陽")에서 8#ruby("일","日")을 보내고 #ruby("중|경","重|慶")까지 #ruby("무|사","無|事")히 #ruby("도|착","到|着")하였다. 그#ruby("간","間")에 #ruby("광|주","廣|州")가 #ruby("함|락","陷|落")되어 #ruby("대|가|족","大|家|族")의 #ruby("소|식","消|息")이 #ruby("극","極")히 궁금하던 차에, #ruby("일|행","一|行")이 #ruby("고|요","高|要")·#ruby("계|평","桂|平")을 거쳐 #ruby("유|주","柳|州")에 #ruby("도|착","到|着")했다는 #ruby("전|보","電|報")를 받고서 적이 #ruby("안|심","安|心")이 되었다. 그러나 #ruby("중|경","重|慶") 가까운 곳으로 #ruby("이|사","移|徙")시키는 것이 큰 #ruby("문|제","問|題")였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|국","中|國") #ruby("중|앙|정|부","中|央|政|府")도 #ruby("차|량","車|輛") #ruby("부|족","不|足")으로 #ruby("곤|란","困|難")을 겪고 있었다. #ruby("군|수|품","軍|需|品")을 #ruby("운|반","運|搬")하는 데 #ruby("차|량","車|輛") 1,000#ruby("량","輛")으로도 #ruby("부|족","不|足")한 #ruby("형|편","形|便")인데 100#ruby("량","輛")밖에 없으니, 도와주고 싶어도 도와줄 #ruby("처|지","處|地")가 아니라는 것이다. 그런데도 #ruby("정|부","政|府")의 #ruby("교|통|부","交|通|部")와 #ruby("중|앙|당|부","中|央|黨|部")에 여러 #ruby("차|례","次|例") #ruby("교|섭","交|涉")하여 #ruby("자|동|차","自|動|車") 6#ruby("량","輛")을 #ruby("확|보","確|保")하여 #ruby("식|구","食|口")와 짐을 #ruby("운|반","運|搬")하였고, #ruby("여|비","旅|費")까지 챙겨 보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("식|구","食|口")들이 #ruby("안|전","安|全")하게 #ruby("거|처","居|處")할 곳을 어디로 하려느냐 묻기에, #ruby("귀|양","貴|陽")서 #ruby("중|경","重|慶") 오던 길에 #ruby("기|강","綦|江")이 좋아 보이므로 그곳으로 #ruby("정","定")하고, #ruby("청|사","晴|蓑") #ruby("조|성|환","曺|成|煥")#footnote(numbering: _ => [11)])[#h(0.35em)#ruby[조|성|환][曺|成|煥]\(1875〜1948). 서울 #ruby("출|신","出|身"). #ruby("독|립|운|동|가","獨|立|運|動|家"). 1906#ruby("년","年") #ruby("신|민|회","新|民|會")에 #ruby("참|여","參|與"), 1907#ruby("년","年") #ruby("국|외","國|外")로 #ruby("망|명","亡|命")하여 #ruby("연|해|주","沿|海|州")·#ruby("만|주","滿|洲")·#ruby("북|경","北|京") #ruby("등|지","等|地")에서 #ruby("독|립|운|동","獨|立|運|動"), #ruby("대|종|교","大|倧|敎")에 #ruby("입|교","入|敎")하여 #ruby("활|동","活|動")하였다. 1919#ruby("년","年") 4#ruby("월","月") #ruby("군|무|부","軍|務|部") #ruby("차|장","次|長")으로 #ruby("상|해","上|海") #ruby("임|시|정|부","臨|時|政|府")에 #ruby("잠|시","暫|時") #ruby("참|여","參|與")하였으나, 그해 8#ruby("월","月") 다시 #ruby("만|주","滿|洲")로 가서 #ruby("북|로|군|정|서","北|路|軍|政|署") #ruby("군|무|부|장","軍|務|部|長")으로 #ruby("청|산|리|전|투","靑|山|里|戰|鬪")에 #ruby("기|여","寄|與"), 1925#ruby("년","年") #ruby("신|민|부","新|民|部") #ruby("조|직","組|織")에 #ruby("참|여","參|與")하여 #ruby("외|교|위|원|장","外|交|委|員|長")을 #ruby("역|임","歷|任")하였다. 1926#ruby("년","年") #ruby("북|경","北|京")에서 #ruby("한|국|유|일|독|립|당|촉|성|회","韓|國|唯|一|獨|立|黨|促|成|會")를 #ruby("조|직","組|織")하고, #ruby("상|해","上|海")에서 열린 #ruby("각|지|촉|성|회|연|합|회","各|地|促|成|會|聯|合|會")에 #ruby("북|경","北|京") #ruby("대|표","代|表")로 #ruby("참|여","參|與")하였다. 1931#ruby("년","年") #ruby("임|시|정|부","臨|時|政|府") #ruby("의|정|원","議|政|院") #ruby("의|원","議|員"), 1934#ruby("년","年") #ruby("국|무|위|원","國|務|委|員")에 #ruby("피|선","被|選")되었고, 1936#ruby("년","年") #ruby("임|정","臨|政") #ruby("국|무|위|원","國|務|委|員") #ruby("및","及") #ruby("군|무|총|장","軍|務|總|長")을 #ruby("역|임","歷|任")하였다. 그는 #ruby("광|복|군","光|復|軍") #ruby("창|설","創|設")에도 #ruby("기|여","寄|與")하였다.] #ruby("형","兄")을 #ruby("파|견","派|遣")하여 #ruby("가|옥","家|屋")과 #ruby("약|간","若|干")의 #ruby("가|구","家|具") #ruby("등","等") #ruby("물|건","物|件")을 #ruby("준|비","準|備")하게 하였다. 그리고 우리가 #ruby("중|경","重|慶")으로 #ruby("이|사","移|徙")한 것을 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")에 #ruby("통|지","通|知")하고, #ruby("답|장","答|狀")을 보기 #ruby("위","爲")해 날마다 #ruby[우체국][郵政總局]에 #ruby("직|접","直|接") #ruby("왕|래","往|來")하였다. 하루는 #ruby[우체국][郵政總局]에 갔더니 #ruby("인","仁")이가 와서 #ruby("인|사","人|事")하기를,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("유|주","柳|州")서 할머님이 #ruby("병","病")이 나셨는데, 빨리 #ruby("중|경","重|慶")에 가시겠다고 말씀하시므로 #ruby("신","信")이와 제가 모시고 왔습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[따라가 뵈오니 내가 묵고 있는 #ruby("저|기|문","儲|奇|門") #ruby("홍|빈|여|관","鴻|賓|旅|舍") 바로 맞은#ruby("편","便")이었다. 어머님을 모시고 #ruby("홍|빈|여|관","鴻|賓|旅|舍")으로 와서 하룻밤을 지낸 뒤, #ruby("김|홍|서","金|弘|敍") #ruby("군","君")이 #ruby("자|기","自|己") 집으로 모시기로 하여, 어머님은 #ruby("남|안","南|岸") #ruby("아|궁|보","鵝|宮|堡") #ruby("손|가|화|원","孫|家|花|園")으로 가셨다. 어머님의 #ruby("병","病")은 #ruby("인|후|증","咽|喉|症")이니, #ruby("의|사","醫|師")의 말을 듣건대 #ruby("광|서","廣|西")#ruby("지|방","地|方")의 #ruby("풍|토|병","風|土|病")이라 한다. #ruby("고|령","高|齡")만 아니라면 #ruby("수|술","手|術")을 받을 수도 있고 #ruby("병","病")이 #ruby("초|기","初|期")이면 다룰 #ruby("방|법","方|法")이 있으나, 이미 때가 너무 늦었다고 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님께서 오실 줄 알고, #ruby("노|쇠","老|衰")하신 어머님을 모실 #ruby("성|심","誠|心")을 품고 #ruby("중|경","重|慶")으로 온 #ruby("일|가|족","一|家|族")이 있으니, 그들은 다른 사람이 아닌 #ruby("유|진|동","劉|振|東") #ruby("군","君")과 그 #ruby("부|인","夫|人") #ruby("강|영|파","姜|暎|波")이다. #ruby("유|진|동","劉|振|東")은 #ruby("상|해","上|海")에서 #ruby("동|제|대|학","同|濟|大|學") #ruby("의|과","醫|科")를 #ruby("졸|업","卒|業")하고 #ruby("고|령","牯|嶺") #ruby("폐|병|요|양|원","肺|病|療|養|院") #ruby("원|장","院|長")으로 #ruby("개|업","開|業")하다가, #ruby("고|령","牯|嶺")이 #ruby("전|쟁","戰|爭") #ruby("거|점","據|點")이 될 것을 #ruby("간|파","看|破")하고 #ruby("의|창","宜|昌")·#ruby("만|현","萬|縣")을 거쳐서 #ruby("중|경","重|慶")에 #ruby("도|착","到|着")하였다. 그들 #ruby("부|부","夫|婦")는 #ruby("상|해","上|海") #ruby("학|생","學|生") #ruby("시|절","時|節")부터 나를 #ruby("특|별","特|別")히 따르던 #ruby("동|지","同|志")들이었다. 그들은 어머님을 잘 모시지 못하는 나의 #ruby("형|편","形|便")을 알고, #ruby("자|신","自|身")들이 어머님 시중을 들겠으니 나는 마음 놓고 #ruby("독|립|사|업","獨|立|事|業")에만 #ruby("전|념","專|念")하라는 것이었다. 그들이 그런 #ruby("성|심","誠|心")을 품고 #ruby("남|안","南|岸")에 #ruby("도|착","到|着")하였을 때, 어머님은 이미 #ruby("인|제|의|원","仁|濟|醫|院")에서도 손을 놓고 #ruby("퇴|원","退|院")하여 죽을 날만 기다리던 때였으니, #ruby("한","恨")스럽기 그지없다.]
