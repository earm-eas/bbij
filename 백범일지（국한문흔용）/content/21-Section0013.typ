 #ruby("제","第")3#ruby("지|대|장","支|隊|長")이었다. 그런데 1942#ruby("년","年") 7#ruby("월","月") #ruby("조|선|의|용|대","朝|鮮|義|勇|隊")의 #ruby("광|복|군","光|復|軍") #ruby("편|입","編|入")으로 #ruby("김|원|봉","金|元|鳳")이 #ruby("제","第")1#ruby("지|대|장","支|隊|長")으로 #ruby("임|명","任|命")됨에 따라, #ruby("제","第")2#ruby("지|대|장","支|隊|長")에 #ruby("이|범|석","李|範|奭"), #ruby("제","第")3#ruby("지|대|장","支|隊|長")에 #ruby("김|학|규","金|學|奎")가 새로 #ruby("임|명","任|命")되었다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|남","江|南") #ruby("강|서|성","江|西|省") #ruby("상|요","上|饒")의 #ruby("중|국","中|國") #ruby("제","第")3#ruby("전|구","戰|區") #ruby("사|령|부","司|令|部") #ruby("정|치|부","政|治|部")에 #ruby("근|무|중","勤|務|中")이던 #ruby("황|해|도","黃|海|道") #ruby("해|주","海|州")사람 #ruby("김|문|호","金|文|鎬") #ruby("군","君")은 #ruby("일|본","日|本") #ruby("유|학|생","留|學|生")으로, 큰 뜻을 품고 #ruby("중|국","中|國")으로 건너와 #ruby("각|지","各|地")를 #ruby("유|랑","流|浪")하다, #ruby("절|강|성","浙|江|省") #ruby("동|남","東|南") #ruby("금|화","金|華") #ruby("방|면","方|面")에서 #ruby("정|탐","偵|探") #ruby("혐|의","嫌|疑")로 #ruby("체|포","逮|捕")되었다. #ruby("심|문","審|問")을 받던 #ruby("중","中") 마침 #ruby("중|국|인","中|國|人")으로 #ruby("일|본","日|本")에서 같이 #ruby("공|부","工|夫")를 하였던 #ruby("친|구","親|舊")를 #ruby("우|연","偶|然")히 만나, 그들과 같이 #ruby("제","第")3#ruby("전|구","戰|區") #ruby("사|령|부","司|令|部")에 #ruby("복|무","服|務")하게 되었다. 그러다가 #ruby("김|구","金|九")란 이름이 #ruby("신|문|지|상","新|聞|紙|上")에 오르내리는 것을 보고 먼저 #ruby("서|신","書|信")으로 그곳 #ruby("사|정","事|情")을 #ruby("전|달","傳|達")하다 #ruby("후|일","後|日") #ruby("중|경","重|慶")으로 와서 모든 #ruby("사|실","事|實")을 #ruby("보|고","報|告")했다. 이에 #ruby("상|요","上|饒")에 #ruby("한|국|광|복|군","韓|國|光|復|軍") #ruby("징|모|처","徵|募|處") #ruby("제","第")3#ruby("분|처","分|處")를 #ruby("설|치","設|置")하고 #ruby("김|문|호","金|文|鎬")를 #ruby("주|임","主|任")으로, #ruby[신|정|숙][申|貞|淑]\(鳳彬)을 #ruby("회|계|조|장","會|計|組|長")으로, #ruby("이|지|일","李|志|一")을 #ruby("정|보|조|장","情|報|組|長")으로, #ruby("한|도|명","韓|道|明")을 #ruby("훈|련|조|장","訓|練|組|長")으로, #ruby("선|전|조","宣|傳|組")는 #ruby("주|임","主|任") #ruby("김|문|호","金|文|鎬")를 #ruby("겸|임","兼|任")으로 #ruby("각|각","各|各") #ruby("임|명","任|命")한 #ruby("후","後") #ruby("상|요","上|饒")로 #ruby("파|견","派|遣")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[모든 #ruby("당","黨")·#ruby("정","政")·#ruby("군","軍")의 #ruby("비|용","費|用")은 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")·멕시코·쿠바의 #ruby("교|포","僑|胞")들이 #ruby("만|강","滿|腔")의 #ruby("열|성","熱|誠")으로 거두어 보내주는 것을 가지고 #ruby("대|략","大|略") #ruby("분|배","分|配")하여 3#ruby("부","部") #ruby("사|업","事|業")을 #ruby("진|행","進|行")하였다. 그러던 #ruby("중","中") #ruby("장|개|석","蔣|介|石") #ruby("부|인","夫|人") #ruby("송|미|령","宋|美|齡") #ruby("여|사","女|史")의 #ruby("부|녀|위|로|총|회","婦|女|慰|勞|總|會")에서 #ruby("한|국|광|복|군","韓|國|光|復|軍")에 주는 #ruby("중|국","中|國")돈 10#ruby("만","萬") #ruby("원","元")을 #ruby("특|별|위|로|금","特|別|慰|勞|金")으로 #ruby("원|조","援|助")받기도 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("광|복|군","光|復|軍") #ruby("제","第")3#ruby("징|모|처","徵|募|處") #ruby("신|봉|빈","申|鳳|彬") #ruby("여|사","女|史")의 #ruby("내|력","來|歷")이 하도 #ruby("이|상","異|常")하므로 여기에 #ruby("기|록","記|錄")하고자 한다. 내가 #ruby("이|전","以|前")에 #ruby("장|사","長|沙") #ruby("상|아|의|원","湘|雅|醫|院")에서 가슴에 #ruby("총","銃")을 맞고 #ruby("치|료","治|療")하던 때이다. 하루는 #ruby("병|상","病|床")에 앉아 바깥을 바라보고 있노라니, #ruby("방|문","房|門")이 #ruby("반","半")쯤 열리면서 한 #ruby("여|자","女|子")가 #ruby("편|지","便|紙") 한 #ruby("통","通")을 내 #ruby("방","房")안에 슬그머니 밀어넣고 소리 없이 사라지는 것이 아닌가. #ruby("전|담","專|擔") #ruby("간|호|사","看|護|師") #ruby("당|화|영","唐|華|英")이 마침 #ruby("방","房")안에 있었으므로, 나는 그 #ruby("편|지","便|紙")를 집어 달라고 하여 읽어보았다. #ruby("정","正")말 영문을 알 수 없는 #ruby("기|묘","奇|妙")한 일이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("우|편","郵|便")이 아닌 #ruby("인|편","人|便")으로 보내온 #ruby("서|신","書|信")인데, #ruby("상|덕","常|德") #ruby("포|로|수|용|소","捕|虜|收|容|所")에 #ruby("포|로","捕|虜")로 #ruby("수|감","收|監")되어 있는 #ruby("봉|빈","鳳|彬")이란 #ruby("여|자","女|子")가 나에게 #ruby("해|방","解|放")시켜 주기를 #ruby("청|원","請|願")한 #ruby("진|정|서","陳|情|書")였다. #ruby("자|기","自|己")는, #ruby("상|해","上|海")에 살다가 4·29 #ruby("홍|구|폭|탄","虹|口|爆|彈") #ruby("사|건","事|件") #ruby("후","後") #ruby("귀|국","歸|國")한 #ruby("이|영|근","李|永|根")의 #ruby("처|제","妻|弟")요, #ruby("당|시","當|時") #ruby("민|단","民|團") #ruby("사|무|원","事|務|員")으로 #ruby("체|포","逮|捕")되어 #ruby("귀|국","歸|國")한 #ruby("송|진|표","宋|鎭|杓")#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("원|주","原|註"): “眞姓命 張鉉根”. #ruby("진","眞")짜 #ruby("이|름","姓|名")은 #ruby("장|현|근","張|鉉|根").]의 아내라 하였다. 언니나 #ruby("남|편","男|便")에게서 #ruby("선|생","先|生")님이 언니의 집에 오시면 #ruby("냉|면","冷|麪")을 차려 #ruby("특|별","特|別")히 #ruby("접|대","接|待")하였던 이야기를 잘 들어서 #ruby("평|소","平|素") 우러러 #ruby("흠|모","欽|慕")하였다고 한다. 그런데 #ruby("상|업|적","商|業|的")인 일로 #ruby("산|동","山|東") #ruby("평|원","平|原")에 갔다가 #ruby("중|국","中|國") #ruby("유|격|대","遊|擊|隊")에게 붙잡혀 이곳까지 오는 #ruby("도|중","途|中")에 #ruby("장|사","長|沙")를 #ruby("통|과","通|過")하였으나, #ruby("선|생","先|生")이 계신 곳을 알지 못하여 그대로 #ruby("상|덕","常|德")까지 끌려왔으니, #ruby("사|지","死|地")에서 #ruby("구|출","救|出")해 달라는 #ruby("요|청","要|請")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("백|번","百|番") 생각해 보아도 이 #ruby("편|지","便|紙")가 오게 된 #ruby("내|력","來|歷")을 알 수 없었다. 이 #ruby("여|자","女|子")가 #ruby("이|영|근","李|永|根")의 #ruby("처|제","妻|弟")인 것은 #ruby("의|심","疑|心")할 바 없고, 일찍이 #ruby("본|국","本|國")에서부터 나를 알고 있었다는 것도 #ruby("사|실","事|實")인 듯했다. 그러나 #ruby("죄|수","罪|囚")의 #ruby("서|신","書|信")이 어디서 왔는가? #ruby("본|국","本|國")에서 내 이름#ruby("자","字")는 들어서 알고 있었을 터이나, #ruby("지|금","只|今") 내가 #ruby("장|사","長|沙") #ruby("상|아|의|원","湘|雅|醫|院")에서 #ruby("입|원","入|院")·#ruby("치|료","治|療")하는 것을 #ruby("수|백","數|百") #ruby("리","里") 떨어진 #ruby("상|덕|수|용|소","常|德|收|容|所")에서 어떻게 알고 #ruby("편|지","便|紙")를 보냈으며, #ruby("우|표","郵|票")도 없고 날짜 #ruby("소|인","消|印")도 없는 #ruby("순|전","純|全")히 #ruby("인|편","人|便") #ruby("서|신","書|信")인즉, 그렇다면 아까 #ruby("방|문","房|門") 밖에서 그림자만 어른거리고 없어진 #ruby("여|자","女|子")는 #ruby("천|사","天|使")였던가?]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("하|여","何|如")튼 #ruby("조|사","調|査")해 볼 #ruby("필|요","必|要")가 있다고 #ruby("인|정","認|定")되어, #ruby("퇴|원","退|院") #ruby("후","後") #ruby("한|구","漢|口") #ruby("장","蔣")#ruby("위|원|장","委|員|長")에게 #ruby("청|구","請|求")하여 #ruby("포|로","捕|虜") #ruby("조|사","調|査")의 #ruby("특|권","特|權")을 얻은 뒤, #ruby("노|태|준","盧|泰|俊")·#ruby("송|면|수","宋|冕|秀") 두 사람을 #ruby("상|덕","常|德")에 #ruby("파|견","派|遣")하여 #ruby("조|사","調|査")한 #ruby("결|과","結|果")는 아래와 같았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|덕","常|德") #ruby("포|로|수|용|소","捕|虜|收|容|所")에는 #ruby("한|인","韓|人") #ruby("포|로","捕|虜")가 30#ruby("여","餘") #ruby("명","名")이고 #ruby("일|본|인","日|本|人")은 #ruby("수|백","數|百") #ruby("명","名")인데, 한 #ruby("방","房")에 같이 섞여 있는 #ruby("한|인","韓|人")과 #ruby("일|인","日|人") #ruby("포|로","捕|虜")들 사이에서도 #ruby("한|인","韓|人")은 #ruby("일|인","日|人")의 #ruby("지|휘","指|揮")를 받았다. #ruby("운|동|체|조","運|動|體|操")에도 #ruby("일|인","日|人")이 #ruby("명|령","命|令")·#ruby("지|도","指|導")하고, #ruby("일|체","一|切") #ruby("사|물","事|物")에 #ruby("대","對")해서도 #ruby("일|인","日|人")의 #ruby("권|리","權|利")가 더 많았다. 그런데 #ruby("신|봉|빈","申|鳳|彬")은 #ruby("극|단","極|端")으로 #ruby("일|인","日|人")의 #ruby("지|휘","指|揮")와 #ruby("간|섭","干|涉")을 받지 않고 오히려 #ruby("유|창","流|暢")한 #ruby("일|어","日|語")로 #ruby("일|인","日|人")에 #ruby("대","對")해 #ruby("극|렬","極|烈")하게 #ruby("항|쟁","抗|爭")을 #ruby("전|개","展|開")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이것을 본 #ruby("중|국","中|國") #ruby("관|원","官|員")들은 #ruby("신|봉|빈","申|鳳|彬")이 #ruby("인|격|자","人|格|者")임을 알게 되어, #ruby("비|밀","祕|密") #ruby("신|문","訊|問")으로 #ruby("봉|빈","鳳|彬")이 지닌 #ruby("배|일|사|상","排|日|思|想")의 #ruby("유|래","由|來")를 #ruby("조|사","調|査")하였다. 그런 #ruby("후","後") #ruby("중|국","中|國")에서 #ruby("활|동","活|動")하는 #ruby("한|국","韓|國") #ruby("독|립|운|동|자","獨|立|運|動|者") #ruby("중","中")에 #ruby("친|숙","親|熟")한 사람이 있는가 #ruby("질|문","質|問")하니, #ruby("봉|빈","鳳|彬")은]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|九")를 잘 아노라.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. #ruby("관|원","官|員")이 다시 묻기를,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇다면 #ruby("김|구","金|九")가 #ruby("지|금","只|今") 어디에 있는가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“모른다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|九")에게 #ruby("편|지","便|紙")를 보내고 #ruby("구|원","救|援")을 #ruby("청","請")하면, 그가 너를 #ruby("구|원","救|援")하여 줄 #ruby("신|념","信|念")이 있는가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|九") #ruby("선|생","先|生")이 알기만 하면 반드시 나를 #ruby("구|원","救|援")할 것이다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|사","調|査")를 하던 #ruby("관|원","官|員")은 다름 아닌 #ruby("장|사","長|沙")사람이었다. #ruby("당|시","當|時")는 5#ruby("월","月") 6#ruby("일","日") #ruby("사|변","事|變")#footnote(numbering: _ => [26)])[#h(0.35em)1938#ruby("년","年") 5#ruby("월","月") 6#ruby("일","日") #ruby("남|목|청","楠|木|廳")에서 #ruby("이|운|환","李|雲|煥")이 #ruby("백|범","白|凡") #ruby("등","等")을 #ruby("저|격","狙|擊")한 #ruby("사|건","事|件")을 말한다.]으로 #ruby("장|사","長|沙") #ruby("일|대","一|帶")에 큰 #ruby("소|동","騷|動")이 일어났으므로, #ruby("김|구","金|九")가 #ruby("저|격","狙|擊")을 #ruby("당","當")하여 #ruby("상|아|의|원","湘|雅|醫|院")에서 #ruby("치|료|중","治|療|中")이라는 #ruby("소|식","消|息")은 모르는 사람이 없던 때였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("관|원","官|員")은 #ruby("장|사","長|沙") #ruby("자|기","自|己") 집에 오는 길에 #ruby("봉|빈","鳳|彬")의 #ruby("서|신","書|信")을 #ruby("휴|대","携|帶")하고 #ruby("상|아|의|원","湘|雅|醫|院")을 찾아서 #ruby("김|구","金|九")가 어느 #ruby("방","房")에 있는가를 #ruby("탐|문","探|問")하였다. 그런 뒤 나의 #ruby("방|문","房|門") 밖에는 #ruby("헌|병","憲|兵") #ruby("파|출|소","派|出|所")가 #ruby("감|시","監|視")하므로 #ruby("직|접","直|接") #ruby("전","傳")하지는 못하고, #ruby("친","親")한 #ruby("간|호|원","看|護|員")으로 하여금 나의 #ruby("방","房")안으로 #ruby("편|지","便|紙")를 던지게 하였다. #ruby("편|지","便|紙")가 #ruby("무|사","無|事")히 #ruby("전|달","傳|達")된 것을 본 #ruby("관|원","官|員")은 #ruby("급","急")히 그곳을 떠나버렸다는 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이로부터 #ruby("수|용|소","收|容|所")에서는 #ruby("봉|빈","鳳|彬")을 #ruby("특|대","特|待")하였다고 한다. #ruby("장|사","長|沙")가 #ruby("위|급","危|急")하여 #ruby("광|주","廣|州")로 물러간 뒤 나는 #ruby("중|경","重|慶")으로 가면서, #ruby("장|사","長|沙")까지 #ruby("기|차","汽|車")를 타고 #ruby("장|사","長|沙")에서 다시 #ruby("자|동|차","自|動|車")를 타고 #ruby("상|덕","常|德")을 지나갔다. 그러나 #ruby("시|간","時|間") #ruby("관|계","關|係")로 #ruby("포|로|수|용|소","捕|虜|收|容|所")를 찾아보지는 못하고, #ruby("신|봉|빈","申|鳳|彬")에게 한 #ruby("통","通")의 #ruby("편|지","便|紙")를 #ruby("전","傳")해주었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|경","重|慶")에 와서 #ruby("구|원","救|援")의 길을 #ruby("강|구","講|究")하였다. #ruby("의|용|대","義|勇|隊")에서 벌써 #ruby("포|로","捕|虜") #ruby("해|방","解|放")을 #ruby("교|섭","交|涉")하여 #ruby("일|부","一|部") #ruby("포|로","捕|虜")와 #ruby("신|봉|빈","申|鳳|彬") #ruby("등","等")은 #ruby("석|방","釋|放")되었고, #ruby("신|봉|빈","申|鳳|彬")은 여러 #ruby("차|례","次|例") 내게 오기를 #ruby("요|구","要|求")했다는 것이다. 나는 #ruby("김|약|산","金|若|山") #ruby("군","君")에게 #ruby("편|지","便|紙")를 보내 #ruby("신|봉|빈","申|鳳|彬")을 #ruby("계|림","桂|林")에서 #ruby("중|경","重|慶")으로 데려다가 #ruby("직|접","直|接") 만나본 #ruby("후","後"), #ruby("기|강","綦|江")과 #ruby("토|교","土|橋") #ruby("대|가|족","大|家|族")들과 함께 지내게 하였다가 나중에 #ruby("상|요","上|饒")로 보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("봉|빈","鳳|彬")은 비록 #ruby("여|성","女|性")이나 #ruby("총|명","聰|明")·#ruby("과|감","果|敢")하여 #ruby("전|시|공|작","戰|時|工|作")의 #ruby("효|과","效|果")와 #ruby("능|률","能|率")이 #ruby("중|국","中|國") #ruby("방|면","方|面")에까지 널리 알려져 #ruby("칭|찬","稱|讚")을 받았으며, #ruby("봉|빈","鳳|彬") #ruby("자|신","自|身")도 #ruby("항|상","恒|常") #ruby("자|기","自|己")가 #ruby("경|이|적","驚|異|的")인 #ruby("공|헌","貢|獻")을 하리라고 마음먹고 있어 #ruby("장|래","將|來")가 #ruby("촉|망","屬|望")되는 바이다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) #ruby("대|가|족","大|家|族")과 #ruby("대|륙","大|陸")에 묻힌 #ruby("영|혼","靈|魂")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("비|통","悲|痛")한 일이다. #ruby("대|가|족","大|家|族") #ruby("중","中")에 빠진 #ruby("식|구","食|口")들이 있으니 #ruby("상|해","上|海")의 #ruby("오|영|선","吳|泳|善")·#ruby[이|의|순][李|義|橓]\(#ruby("이|동|휘","李|東|輝")의 딸) #ruby("내|외","內|外")와 그 #ruby("자|녀","子|女")들이다. 그들 #ruby("중","中") #ruby("오|영|선","吳|泳|善") #ruby("군","君")은 #ruby("신|체","身|體") #ruby("장|애","障|礙")로 움직이지 못해 #ruby("대|가|족","大|家|族")에 #ruby("편|입","編|入")되는 것이 #ruby("불|가|능","不|可|能")하였다. #ruby("오|영|선","吳|泳|善") #ruby("군","君")은 #ruby("연|전","年|前")에 #ruby("작|고","作|故")하였다는 #ruby("소|문","所|聞")이 있었으나, #ruby("상|해","上|海")가 #ruby("완|전","完|全")히 #ruby("적","敵")에게 #ruby("함|락","陷|落")되어 버렸으니 어떻게 손을 쓸 #ruby("여|지","餘|地")가 없었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음은 #ruby("이|명|옥","李|溟|玉") #ruby("군","君")의 #ruby("가|족","家|族")이다. #ruby("명|옥","溟|玉") #ruby("군","君")은 #ruby("본|시","本|是") #ruby("금|천","金|川")사람으로 3·1#ruby("운|동","運|動")에 #ruby("참|가","參|加")하여 #ruby("일|본","日|本")의 #ruby("정|탐","偵|探")꾼을 #ruby("암|살","暗|殺")한 뒤 #ruby("상|해","上|海")로 건너와서 #ruby("민|단","民|團") #ruby("사|무|원","事|務|員")이 되었다. 그러다 그 #ruby("처|자","妻|子")가 #ruby("상|해","上|海")로 찾아온 뒤 #ruby("생|계","生|計")를 #ruby("위","爲")해 #ruby("영|국","英|國") #ruby("상|인","商|人")이 #ruby("운|영","運|營")하는 #ruby("전|차","電|車") #ruby("검|표|원","檢|票|員")으로 일을 하였다. 그#ruby("후","後") 내가 #ruby("남|경","南|京")으로 #ruby("이|주","移|住")한 뒤에도 #ruby("종|종","種|種") #ruby("비|밀|공|작","祕|密|工|作")으로 #ruby("왕|래","往|來")하다가 #ruby("왜|구","倭|寇")에게 #ruby("체|포","逮|捕")되어 #ruby("본|국","本|國")에 가서 20#ruby("년","年") #ruby("징|역|형","懲|役|刑")을 #ruby("언|도","言|渡")받았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("명|옥","溟|玉") #ruby("군","君")의 #ruby("부|인","夫|人") #ruby("이|정|숙","李|貞|淑") #ruby("여|사","女|史")는 #ruby("본|국","本|國")으로 돌아가지 않고 #ruby("자|녀","子|女")를 데리고 #ruby("상|해|생|활","上|海|生|活")을 #ruby("계|속","繼|續")하였다. 내가 #ruby("남|경","南|京")에 #ruby("거|주","居|住")할 때 #ruby("생|활|비","生|活|費")를 #ruby("보|조","補|助")하다 #ruby("대|가|족","大|家|族")으로 #ruby("편|입","編|入")하기를 #ruby("통|지","通|知")하였다. #ruby("이|씨","李|氏") #ruby("부|인","夫|人")은 #ruby("본|국","本|國") #ruby("감|옥","監|獄")에 있는 #ruby("남|편","男|便")에게 두 달에 한 #ruby("번","番")씩 #ruby("왕|복","往|復")하는 #ruby("서|신","書|信")을 보냈는데 그 #ruby("성|심","誠|心")으로 #ruby("인","因")해 차마 #ruby("상|해","上|海")를 떠나지 못하겠다고 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그렇게 지내다가 #ruby("장|자","長|子") #ruby("호|상","好|相")이 #ruby("조|선|의|용|대","朝|鮮|義|勇|隊")에 #ruby("참|가","參|加")하여 #ruby("절|강|성","浙|江|省") #ruby("동|부","東|部") #ruby("일|대","一|帶")에서 #ruby("공|작","工|作")하다 어머님과 #ruby("남|동|생","男|同|生"), 누이들이 그리웠는지 #ruby("동|지","同|志") 세 사람을 #ruby("대|동","帶|同")하고 #ruby("상|해","上|海")에 #ruby("잠|입","潛|入")하여 #ruby("활|동","活|動")하였다. #ruby("활|동|중","活|動|中") #ruby("간|간","間|間")이 #ruby("자|기","自|己") 어머님께 #ruby("비|밀","祕|密")히 #ruby("왕|래","往|來")하다 #ruby("왜|구","倭|寇")에게 #ruby("발|각","發|覺")되어 #ruby("이|씨","李|氏") #ruby("부|인","夫|人")이 #ruby("체|포","逮|捕")되었다. 아들이 있는 곳을 #ruby("엄|중","嚴|重")히 #ruby("신|문","訊|問")하나 #ruby("발|설","發|說")치 않으므로 #ruby("당|장","當|場")에 #ruby("타|살","打|殺")#ruby("당","當")하였고, #ruby("호|상","好|相")은 #ruby("동|지","同|志") 세 사람과 #ruby("기|차","汽|車")를 타고 #ruby("도|망","逃|亡")하다 #ruby("차","車") 안에서 네 사람 모두 #ruby("체|포","逮|捕")되었다. #ruby("체|포","逮|捕")되어 #ruby("국|내","國|內")로 #ruby("호|송","護|送")되던 #ruby("중","中") #ruby("호|상","好|相")은 배 안에서 작은누이를 만났다. 누이로부터 어머님과 어린 #ruby("동|생","同|生")이 #ruby("왜","倭")놈에게 #ruby("살|해","殺|害")되고 #ruby("자|기","自|己")는 #ruby("국|내","國|內")로 #ruby("압|송","押|送")되어 간다는 말을 듣고 #ruby("호|상","好|相")은 #ruby("기|절","氣|絶")하여 죽었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("비|통","悲|痛")하고 슬프도다! 하느님이 #ruby("진|정","眞|正") #ruby("무|심","無|心")하신가. 어린 아들, 어린 딸도 #ruby("왜","倭")의 #ruby("마|수","魔|手")에 목숨을 잃었단 말인가. 이러고도 #ruby("인|간","人|間")이란 말인가. 나라를 잃은 #ruby("이|래","以|來") #ruby("왜|구","倭|寇")에게 #ruby("일|가|족","一|家|族")이 #ruby("도|륙","屠|戮")됨이 무릇 몇#ruby("백","百") 몇#ruby("천","千") 집이랴만, #ruby("기|미","己|未") 3·1#ruby("운|동","運|動") #ruby("이|래","以|來") #ruby("상|해","上|海") #ruby("운|동|가","運|動|家")들이 #ruby("당","當")한 것에서는 #ruby("이|명|옥","李|溟|玉") #ruby("군","君")이 #ruby("당","當")한 #ruby("비|극","悲|劇")을 첫손가락에 꼽을 수 있다. 무릇 우리 #ruby("동|포","同|胞") #ruby("자|손","子|孫")들에게 한마디를 남기노니, #ruby("광|복","光|復") #ruby("완|성","完|成") #ruby("후","後") #ruby("이|명|옥","李|溟|玉") #ruby("일|가","一|家")를 #ruby("위","爲")해 #ruby("충|렬|문","忠|烈|門")을 #ruby("수|안","遂|安") #ruby("고|향","故|鄕")에 세워서 #ruby("영|구","永|久")히 #ruby("기|념","紀|念")하기를 #ruby("부|탁","付|託")하여 두노라.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[처음부터 #ruby("대|가|족","大|家|族")들과 같이 움직이던 #ruby("중","中") #ruby("장|사|사|변","長|沙|事|變")으로 #ruby("인","因")하여 #ruby("왜|구","倭|寇")의 #ruby[사냥개][鷹犬] #ruby("이|운|환","李|雲|煥")에게 #ruby("총","銃")을 맞아 #ruby("순|국","殉|國")한 #ruby[현익철][默觀]#footnote(numbering: _ => [27)])[#h(0.35em)#ruby[현|익|철][玄|益|哲]\(1890〜1938), #ruby("호","號")는 #ruby("묵|관","默|觀"). #ruby("평|북","平|北") #ruby("박|천","博|川") #ruby("출|신","出|身"). 1926#ruby("년","年") #ruby("만|주","滿|洲")에서 #ruby("양|기|탁","梁|起|鐸") #ruby("등","等")과 #ruby("고|려|혁|명|당","高|麗|革|命|黨")을 #ruby("조|직","組|織")하였고, 1927#ruby("년","年") #ruby("국|민|부","國|民|府") #ruby("중|앙|집|행|위|원","中|央|執|行|委|員")을 #ruby("역|임","歷|任")했다. 1931#ruby("년","年") 7#ruby("년|형","年|刑")으로 #ruby("신|의|주|감|옥","新|義|州|監|獄")에 #ruby("투|옥","投|獄")되었고, 그#ruby("후","後") #ruby("병|보|석","病|保|釋")으로 풀려나자 #ruby("만|주","滿|洲")로 #ruby("탈|출","脫|出")하였다. 1937#ruby("년","年")에 #ruby("한|국|광|복|진|선","韓|國|光|復|陣|線")에 #ruby("참|여","參|與")했고, 1938#ruby("년","年") #ruby("임|시|정|부","臨|時|政|府") #ruby("군|사|학|편|수|위|원|회","軍|事|學|編|修|委|員|會") #ruby("위|원","委|員")을 맡았으나, 그해 5#ruby("월","月") #ruby("장|사","長|沙")에서 #ruby("이|운|환","李|雲|煥")의 #ruby("저|격","狙|擊")으로 #ruby("사|망","死|亡")하였다.] #ruby("군","君")은 나이 50#ruby("세","歲") #ruby("미|만","未|滿")이었다. 그는 사람됨이 #ruby("강|개","慷|慨")하고 아는 것이 많았다. #ruby("과|거","過|去") #ruby("만|주","滿|洲")에서 #ruby("정|의|부","正|義|府") #ruby("수|뇌","首|腦")로 #ruby("왜|구","倭|寇")와 #ruby("공|산|당","共|産|黨"), #ruby("장|작|림","張|作|霖")의 #ruby("부|하","部|下") #ruby("친|일|분|자","親|日|分|子")들에게 3#ruby("면","面") #ruby("포|위","包|圍")된 가운데서도 #ruby("독|립|운|동","獨|立|運|動")을 #ruby("위","爲")하여 #ruby("격|렬","激|烈")히 #ruby("투|쟁","鬪|爭")하였다. 그러다가 #ruby("결|국","結|局") #ruby("왜|구","倭|寇")에게 #ruby("체|포","逮|捕")되어 #ruby("신|의|주|감|옥","新|義|州|監|獄")에서 #ruby("중|징|역","重|懲|役")을 마친 뒤, #ruby("만|주","滿|洲")는 #ruby("완|전","完|全")히 #ruby("왜|구","倭|寇")의 #ruby("천|지","天|地")가 되었으므로 #ruby("중|국","中|國") #ruby("관|내|지|역","關|內|地|域")으로 들어왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後") #ruby("이|청|천","李|靑|天")·#ruby("김|학|규","金|學|奎") #ruby("등","等") 옛 #ruby("동|지","同|志")들과 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨")을 #ruby("조|직","組|織")하였고, #ruby("남|경","南|京")에서 #ruby("의|열|단","義|烈|團")이 #ruby("주|도","主|導")한 #ruby("민|족|혁|명|당","民|族|革|命|黨")에 #ruby("참|여","參|與")하였다가 #ruby("탈|퇴","脫|退")하고, #ruby("광|복|진|선","光|復|陣|線") 9#ruby("개","個") #ruby("단|체","團|體")\(#ruby("원|동","遠|東") #ruby("지|역","地|域")의 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨")·#ruby("한|국|독|립|당","韓|國|獨|立|黨")·#ruby("한|국|국|민|당","韓|國|國|民|黨")과 #ruby("미|주|국|민|회","美|洲|國|民|會")·#ruby("하|와|이|국|민|회","夏|威|夷|國|民|會")·#ruby("애|국|단","愛|國|團")·#ruby("부|인|구|제|회","婦|人|救|濟|會")#footnote(numbering: _ => [28)])[#h(0.35em)‘#ruby("직|해|본","直|解|本")’ ‘#ruby("필|사|본","筆|寫|本")’ ‘#ruby("학|민|사|본","學|民|社|本")’은 #ruby("애|국|단","愛|國|團")·#ruby("부|인|구|제|회","婦|人|救|濟|會")를 하나의 #ruby("단|체","團|體")로 #ruby("취|급","取|扱")하였다. 그러나 『#ruby("백|범|일|지","白|凡|逸|志")』 앞#ruby("부|분","部|分")에도 나와 있듯이 #ruby("애|국|단","愛|國|團")은 #ruby("하|와|이|단|합|회","夏|威|夷|團|合|會")와 #ruby("연|합","聯|合")하여 #ruby("한|독|당","韓|獨|黨") #ruby("하|와|이|지|부","夏|威|夷|支|部")가 되는 #ruby("단|체","團|體")이며, #ruby("부|인|구|제|회","婦|人|救|濟|會")\(#ruby("정|식","正|式") #ruby("명|칭","名|稱")은 #ruby("대|한|부|인|구|제|회","大|韓|婦|人|救|濟|會"))는 이와 #ruby("전|연","全|然") #ruby("별|개","別|個")로 3·1#ruby("운|동","運|動") #ruby("이|후","以|後") #ruby("하|와|이","夏|威|夷")에서 #ruby("결|성","結|成")된 #ruby("여|성|단|체","女|性|團|體")이다. 9#ruby("개","個") #ruby("단|체","團|體") #ruby("중","中") 앞의 3#ruby("개","個")는 #ruby("중|국","中|國") #ruby("관|내|지|방","關|內|地|方")\(#ruby("원|동","遠|東")), 뒤의 6#ruby("개","個")는 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷") #ruby("지|방","地|方")의 #ruby("단|체","團|體")이다.]·#ruby("단|합|회","團|合|會")·#ruby("동|지|회","同|志|會"))에 #ruby("참|가","參|加")하였다. #ruby("남|경","南|京")에서 #ruby("장|사","長|沙")로 #ruby("대|가|족","大|家|族")에 #ruby("편|입","編|入")하여 #ruby("부|인","夫|人") #ruby("방|순|희","方|順|熙")와 어린 아들 #ruby("종|화","鐘|華")를 데리고 #ruby("장|사","長|沙")에 #ruby("도|착","到|着")하였다. 그 뒤 #ruby("고|초","苦|楚")와 #ruby("행|동","行|動")을 같이 하는 3#ruby("당","黨") #ruby("통|일","統|一")부터 #ruby("실|현","實|現")하자는 #ruby("묵|관","默|觀") #ruby("현|익|철","玄|益|哲")의 #ruby("제|의","提|議")에 #ruby("응","應")하여, #ruby("회|의","會|議")를 #ruby("약|속","約|束")하고 나 #ruby("역|시","亦|是") #ruby("연|회|석","宴|會|席")에 #ruby("참|가","參|加")하였다. 그랬는데 #ruby("불|행","不|幸")히도 #ruby("묵|관","默|觀") 한 사람만 목숨을 잃었던 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後") #ruby("광|주","廣|州")에서 #ruby("조|성|환","曺|成|煥")·#ruby("나|태|섭","羅|泰|燮") 두 #ruby("동|지","同|志")와 같이 #ruby("중|경","重|慶")으로 오던 길에 #ruby("장|사","長|沙")에서 #ruby("귀|양|행","貴|陽|行") #ruby[자동차][汽車]#footnote(numbering: _ => [29)])[#h(0.35em)여기서 #ruby("기|차","汽|車")는 #ruby("철|로","鐵|路")를 달리는 #ruby("기|차","汽|車")가 아니라 #ruby("자|동|차","自|動|車")를 말한다. #ruby("철","鐵")길 #ruby("기|차","汽|車")는 #ruby("중|국|어","中|國|語")로 #ruby("화|차","火|車")이다. #ruby("백|범","白|凡")은 앞#ruby("부|분","部|分")에서 #ruby("조|성|환","曺|成|煥")·#ruby("나|태|섭","羅|泰|燮") #ruby("등","等")과 함께 #ruby("장|사","長|沙")에서 #ruby("중|경","重|慶")으로 갈 때 #ruby("성","省") #ruby("주|석","主|席") #ruby("장|치|중","張|治|中")이 #ruby("국|도","公|路")#ruby("용","用") #ruby("차|표","車|票") 3#ruby("매","枚")를 #ruby("구","求")해주었다고 밝힌 바 있다.]를 기다리던 때가 바로 #ruby("음|력","陰|曆") #ruby("추|석","秋|夕")이었다. 나는 #ruby("현|묵|관","玄|默|觀")의 #ruby("묘|소","墓|所")를 찾아 절할 것을 #ruby("주|장","主|張")하였지만 두 #ruby("동|지","同|志")는 나의 #ruby("참|배","參|拜")를 #ruby("극|력","極|力") #ruby("만|류","挽|留")하고, 그들만 술과 #ruby("안|주","按|酒")로 #ruby("참|배","參|拜")하였다. 이것은 나의 몸이 아직 #ruby("완|전","完|全") #ruby("회|복","回|復")되지 못하였고, 먼 길을 가는 #ruby("중","中") 내가 #ruby("묵|관","默|觀")의 #ruby("묘","墓") 앞에 #ruby("당|도","當|到")하면 #ruby("애|절","哀|切")·#ruby("통|절","痛|切")하여 #ruby("정|신|상","精|神|上")·#ruby("신|체|상","身|體|上")에 무슨 #ruby("변|화","變|化")가 생길까 #ruby("우|려","憂|慮")하여 #ruby("동|행","同|行")을 말렸던 것이다.]
