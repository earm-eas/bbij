#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다시 거슬러 올라가서 #ruby("서|술","敍|述")하면, 내가 #ruby("중|경","重|慶")에 처음 #ruby("도|착","到|着")하여 #ruby("추|진","推|進")한 일은 세 가지였다. 첫째는 #ruby("중|국","中|國") #ruby("당|국","當|局")과 #ruby("교|섭","交|涉")하여 #ruby("차|량","車|輛")을 얻고 #ruby("이|사","移|徙") #ruby("비|용","費|用")을 마련하여 #ruby("유|주","柳|州")로 보내는 일이고, 둘째는 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")의 #ruby("각","各") #ruby("단|체","團|體")에 #ruby("임|시|정|부","臨|時|政|府")와 #ruby("직|원","職|員") #ruby("가|족","家|族")을 #ruby("중|경","重|慶")으로 #ruby("이|주","移|住")시킨 것을 #ruby("통|지","通|知")하고 #ruby("원|조","援|助")를 #ruby("요|청","要|請")하는 일이고, 셋째는 #ruby("각","各") #ruby("단|체","團|體")의 #ruby("통|일|문|제","統|一|問|題")를 #ruby("제|기","提|起")한 것이다.#footnote(numbering: _ => [12)])[#h(0.35em)첫#ruby("번","番")째와 두#ruby("번","番")째 #ruby("내|용","內|容")은 위에서 #ruby("기|술","記|述")했었다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("통|일|문|제","統|一|問|題")를 #ruby("제|기","提|起")하기 #ruby("위","爲")하여 #ruby("남|안","南|岸") #ruby("아|궁|보","鵝|宮|堡") #ruby("조|선|의|용|대","朝|鮮|義|勇|隊")와 #ruby("민|족|혁|명|당","民|族|革|命|黨") #ruby("본|부","本|部")를 #ruby("방|문","訪|問")하였다. #ruby("당|시","當|時") #ruby[김약산][若山]\(金元鳳)은 #ruby("계|림","桂|林")에 있었으나, #ruby("민|족|혁|명|당","民|族|革|命|黨") #ruby("간|부","幹|部")인 #ruby("윤|기|섭","尹|琦|燮")·#ruby("성|준|용","成|俊|用")·#ruby("김|홍|서","金|弘|敍")·#ruby("석|정","石|丁")·#ruby("최|석|순","崔|錫|淳")·#ruby("김|상|덕","金|尙|德") #ruby("등","等")이 나를 맞이하여 #ruby("환|영|회","歡|迎|會")를 #ruby("개|최","開|催")하였다.#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("성|준|용","成|俊|用")은 #ruby("성|주|식","成|周|寔"), #ruby("석|정","石|丁")은 #ruby("윤|세|주","尹|世|胄")이다.] 그 자리에서 내가 #ruby("통|일|문|제","統|一|問|題")로 #ruby("민|족|주|의","民|族|主|義") #ruby("단|일|당","單|一|黨") #ruby("결|성","結|成")을 #ruby("주|장","主|張")하니 모두 #ruby("찬|성","贊|成")하였다.]
