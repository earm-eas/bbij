#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("중|경","重|慶")에 #ruby("도|착","到|着")한 #ruby("이|후","以|後") #ruby("중|국","中|國") #ruby("당|국","當|局")과 #ruby("교|섭","交|涉")한 #ruby("결|과","結|果"), #ruby("교|통|기|구","交|通|機|構")가 #ruby("곤|란","困|難")할 때인데도 #ruby("자|동|차","自|動|車") 5, 6#ruby("량","輛")을 #ruby("무|료","無|料")로 빌려주어 #ruby("대|가|족","大|家|族")과 #ruby("다|수","多|數") 짐을 #ruby("수|천","數|千") #ruby("리","里") #ruby("험","險")한 길에도 #ruby("무|사","無|事")히 #ruby("운|반","運|搬")할 수 있게 되었다. 또한 #ruby("진|제|위|원|회","振|濟|委|員|會")에 #ruby("교|섭","交|涉")하여#footnote(numbering: _ => [20)])[#h(0.35em)#ruby("진|제|위|원|회","振|濟|委|員|會")는 2#ruby("차|대|전","次|大|戰") #ruby("중","中") #ruby("중|국","中|國") #ruby("국|민|당","國|民|黨")에서 #ruby("설|치","設|置")한 #ruby("일|종","一|種")의 #ruby("전|시|구|호|기|관","戰|時|救|護|機|關"). 1938#ruby("년","年") 10#ruby("월","月") 13#ruby("일|자","日|字") #ruby("백|범","白|凡")의 #ruby("편|지","便|紙")에 #ruby("대","對")한 11#ruby("월","月") 17#ruby("일|자","日|字") #ruby("답|신","答|信")에 #ruby("의","依")하면, #ruby("국|민|당","國|民|黨") #ruby("진|제|위|원|회","振|濟|委|員|會")는 #ruby("임|시|정|부","臨|時|政|府") #ruby("측","側")의 #ruby("요|청","要|請")을 #ruby("대|체","大|體")로 받아들여 #ruby("중|국","中|國")돈 22,520#ruby("원","元")을 #ruby("보|조","補|助")하기로 #ruby("허|락","許|諾")하였다.] #ruby("토|교","土|橋") #ruby("동|감","東|坎")#ruby("폭|포","瀑|布") 위쪽의 한 #ruby("구|역","區|域")을 #ruby("매|입","買|入")한 #ruby("후","後") 기와집 3#ruby("동","棟")을 #ruby("건|축","建|築")하였고, #ruby("도|로|변","道|路|邊")에 2#ruby("층","層") 기와집 1#ruby("동","棟")을 #ruby("매|입","買|入")하여 100#ruby("여","餘") #ruby("식|구","食|口")의 머물 곳을 #ruby("정","定")해 주었다.#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("정|정|화","鄭|靖|和")의 #ruby("회|고","回|顧")에 #ruby("의","依")하면 1941#ruby("년","年") 1#ruby("월","月")에 #ruby("임|정","臨|政") #ruby("가|족","家|族")들은 #ruby("기|강","綦|江")에서 #ruby("중|경","重|慶") 쪽으로 #ruby("약","約") 10킬로미터 남짓 떨어진 #ruby("동|감","東|坎")이란 마을로 #ruby("이|사","移|徙")했다. #ruby("동|감","東|坎")마을의 #ruby("행|정|구|역|상","行|政|區|域|上") 이름은 #ruby("파|현","巴|縣") #ruby("토|문|향","土|文|鄕")인데 흔히 #ruby("토|교","土|橋")라고 불렸다. #ruby("중|경","重|慶")과 #ruby("토|교","土|橋")는 마치 서울과 #ruby("안|양","安|養") 같은 사이였다. #ruby("토|교","土|橋")에 자리를 잡은 #ruby("임|정","臨|政") #ruby("가|족","家|族")들은 #ruby("해|방","解|放")이 되어 #ruby("중|경","重|慶")을 떠날 때까지 그곳에서 머물렀다.] 그밖에도 우리 #ruby("독|립|운|동","獨|立|運|動")에 #ruby("관","關")한 #ruby("원|조","援|助")를 #ruby("청","請")하였으나 #ruby("냉|담","冷|淡")한 #ruby("태|도","態|度")를 보이므로 #ruby("중|앙|당|부","中|央|黨|部")의 #ruby("당|국|자","當|局|者") #ruby("서|은|증","徐|恩|曾")과 #ruby("교|섭","交|涉")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("중|국","中|國")의 #ruby("대|일|항|전","對|日|抗|戰")이 이와 같이 #ruby("곤|란","困|難")한 때 도리어 #ruby("원|조","援|助")를 #ruby("구","求")함이 #ruby("심","甚")히 #ruby("미|안","未|安")하오. #ruby("미|국","美|國")에 #ruby("만|여","萬|餘") #ruby("명","名")의 #ruby("동|포","同|胞")들이 나를 오라 하고, 또한 #ruby("미|국","美|國")은 #ruby("부|국","富|國")이며 #ruby("장|차","將|次") #ruby("미|일","美|日") #ruby("개|전","開|戰")을 #ruby("준|비|중","準|備|中")이니 #ruby("대|미|외|교","對|美|外|交")도 #ruby("개|시","開|始")하고 싶소. #ruby("여|비","旅|費")도 #ruby("문|제","問|題") 없으니 #ruby("여|행|권","旅|行|券") #ruby("수|속","手|續")만 #ruby("청|구","請|求")하오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")이 #ruby("중|국","中|國")에 있으니 #ruby("중|국","中|國")과 #ruby("약|간","若|干")의 #ruby("관|계","關|係")를 맺고 난 뒤, #ruby("해|외","海|外")로 나가는 것이 좋지 않겠소?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나 #ruby("역|시","亦|是") 그런 뜻에서 여러 해 #ruby("중|국","中|國") #ruby("수|도","首|都")만 따라온 것이나, #ruby("중|국","中|國")이 5, 6#ruby("개","個")의 #ruby("대|도|시","大|都|市")를 #ruby("상|실","喪|失")한 나머지 #ruby("독|자|적","獨|自|的")인 #ruby("전|쟁","戰|爭") #ruby("수|행","遂|行")만으로도 #ruby("극|도","極|度")로 #ruby("곤|란","困|難")한 것을 보고, 차마 #ruby("한|국","韓|國") #ruby("독|립","獨|立")을 #ruby("원|조","援|助")해 달라고 #ruby("요|구","要|求")하기 #ruby("미|안","未|安")한 까닭이오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("책|임","責|任")지고 #ruby("선|생","先|生")의 #ruby("계|획|서","計|劃|書")를 #ruby("상|부","上|部")에 #ruby("보|고","報|告")할 터이니, 한 #ruby("부","部")를 #ruby("작|성","作|成")하여 보내주시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이에 #ruby("계|획|서","計|劃|書")를 #ruby("작|성","作|成")하여, #ruby("광|복|군","光|復|軍")\(#ruby("즉","卽") #ruby("한|국","韓|國") #ruby("국|군","國|軍")) #ruby("결|성","結|成")을 #ruby("허|락","許|諾")해 주는 것이 3#ruby("천|만","千|萬") #ruby("한|족","韓|族")의 #ruby("총|동|원|적","總|動|員|的") #ruby("요|소","要|素")임을 #ruby("설|명","說|明")하여 #ruby("장|개|석","蔣|介|石") #ruby("장|군","將|軍")에게 보냈다. 그랬더니 #ruby("즉|시","卽|時")로 #ruby("김|구","金|九")의 #ruby("광|복|군","光|復|軍") #ruby("계|획","計|劃")을 #ruby("흔|쾌","欣|快")히 #ruby("허|락","許|諾")한다는 #ruby("회|신","回|信")이 #ruby("도|착","到|着")하였다.]
