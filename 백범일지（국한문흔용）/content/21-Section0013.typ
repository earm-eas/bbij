#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님께서는 #ruby("중|경","重|慶")에서 #ruby("세|상","世|上")을 떠나셨고, #ruby("대|가|족","大|家|族")을 따라 #ruby("기|강","綦|江")에 #ruby("도|착","到|着")한 지 1#ruby("년","年")이 지났을 때, #ruby("석|오","石|吾") #ruby("이|동|녕","李|東|寧") #ruby("선|생","先|生")이 71#ruby("세","歲") #ruby("노|령","老|齡")으로 #ruby("작|고","作|故")하여 이곳에 #ruby("안|장","安|葬")하였다. 내가 #ruby("선|생","先|生")을 처음 만난 것은 30#ruby("여","餘") #ruby("년","年") #ruby("전","前")이다. #ruby[을사늑약][乙巳新條約] 때 #ruby("경|성","京|城")의 #ruby("상|동","尙|洞")예수#ruby("교|당","敎|堂")에서 #ruby("진|사","進|士") #ruby("이|석","李|石")으로 #ruby("행|세","行|世")할 때 #ruby("상|봉","相|逢")하여 같이 #ruby("상|소|운|동","上|疏|運|動")에 #ruby("참|가","參|加")하였다. #ruby("합|병","合|倂") #ruby("후","後") #ruby("경|성","京|城") #ruby("양|기|탁","梁|起|鐸")의 #ruby("사|랑","舍|廊")에서 다시 #ruby("밀|회","密|會")하여 #ruby("장|래","將|來")의 #ruby("독|립|운|동","獨|立|運|動")을 #ruby("위","爲")한 #ruby("서|간|도","西|間|島") #ruby("무|관|학|교","武|官|學|校") #ruby("설|립","設|立")에 #ruby("관","關")한 #ruby("일|체","一|切") #ruby("사|무","事|務")를 #ruby("선|생","先|生")에게 #ruby("위|임","委|任")하였다. 그#ruby("후","後") #ruby("기|미|년","己|未|年") #ruby("상|해","上|海")에서 또다시 #ruby("상|봉","相|逢")하여 20#ruby("여","餘") #ruby("년","年") #ruby("고|초","苦|楚")도 같이 겪고 #ruby("사|업","事|業")도 함께 해오면서 한마음 한뜻으로 지냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("선|생","先|生")은 #ruby("재|덕","才|德")이 #ruby("출|중","出|衆")하나, #ruby("일|생","一|生")을 #ruby("자|기","自|己")만 못한 #ruby("동|지","同|志")를 도와서 #ruby("선|두","先|頭")에 내세우고, 스스로는 남의 #ruby("부|족","不|足")을 #ruby("보|충","補|充")하고 고쳐 #ruby("인|도","引|導")하는 일이 #ruby("일|생","一|生")의 #ruby("미|덕","美|德")이었다. #ruby("최|후","最|後")의 한#ruby("순|간","瞬|間")까지 #ruby("선|생","先|生")의 #ruby("애|호","愛|護")를 받은 사람은 오직 나 한 사람이었다. #ruby("석|오","石|吾") #ruby("선|생","先|生")이 #ruby("별|세","別|世")한 뒤, 일을 만나면 #ruby("당|장","當|場") #ruby("선|생","先|生") 생각부터 하게 되니 이는 #ruby("선|생","先|生")만한 #ruby("고|문","顧|問")이 없기 때문이다. 그런 사람이 어찌 나 한 사람뿐이랴. 우리 #ruby("운|동|계","運|動|界")의 #ruby("대|손|실","大|損|失")이라 할 수 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 다음으로는 #ruby("손|일|민","孫|逸|民") #ruby("동|지","同|志")의 #ruby("사|망","死|亡")이다. 나이 60#ruby("세","歲")에 #ruby("항|상","恒|常") #ruby("병","病")을 안고 지내다 끝내 #ruby("기|강","綦|江")에서 한줌 흙이 되었다. 그는 #ruby("청|년","靑|年") #ruby("시|절","時|節")부터 나라를 되찾겠다는 큰 뜻을 품고 #ruby("만|주","滿|洲") #ruby("방|면","方|面")에서 #ruby("다|년|간","多|年|間") #ruby("활|동","活|動")하였고 #ruby("북|경","北|京")·#ruby("남|경","南|京")·#ruby("장|사","長|沙")·#ruby("광|주","廣|州")·#ruby("유|주","柳|州")로 다니다가 #ruby("결|국","結|局") #ruby("기|강","綦|江")까지 와서 #ruby("대|가|족","大|家|族")에 #ruby("편|입","編|入")되었다. 그는 #ruby("자|녀","子|女")가 없고 #ruby("근","近") 60#ruby("세","歲") 된 #ruby("미|망|인","未|亡|人")이 있을 뿐이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|강","綦|江")에서 #ruby("대|가|족","大|家|族")이 두 해 남짓 지내는 사이에 #ruby("괴|이","怪|異")한 #ruby("장|례","葬|禮")도 겪었다. #ruby("조|소|앙","趙|素|昻")의 #ruby("부|모","父|母")는 다같이 70#ruby("여","餘") #ruby("세","歲")의 #ruby("고|령","高|齡")이었는데, #ruby("모|친","母|親")이 #ruby("별|세","別|世")한 뒤 #ruby("부|친","父|親")이 물에 빠져 #ruby("자|살","自|殺")하고 말았다. #ruby("정","情")에 못 이긴 죽음인지 #ruby("세|상","世|上")을 #ruby("비|관","悲|觀")한 죽음인지 모르겠지만 보기 드문 일임에는 #ruby("분|명","分|明")하다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|가|족","大|家|族")이 #ruby("토|교","土|橋")로 #ruby("이|사","移|徙")한 #ruby("후","後") #ruby("근","近") 2#ruby("년","年")이 되는 24#ruby("년","年")\(1942) 2#ruby("월","月")에 #ruby("김|광|요","金|光|耀")의 #ruby("모|친","母|親")이 #ruby("폐|병","肺|病")으로 #ruby("세|상","世|上")을 뜬 뒤, #ruby("송|신|암","宋|新|岩") #ruby("병|조","秉|祚") #ruby("동|지","同|志")가 나이 65#ruby("세","歲")에 #ruby("병","病")으로 #ruby("세|상","世|上")을 떠났다. 그는 #ruby("임|시|의|정|원","臨|時|議|政|院") #ruby("의|장","議|長")으로 #ruby("한|국|독|립|당","韓|國|獨|立|黨") #ruby("중|앙|집|행|위|원","中|央|執|行|委|員")과 #ruby("임|시|정|부","臨|時|政|府") #ruby("고|문","顧|問") #ruby("겸","兼") #ruby("회|계|검|사|원","會|計|檢|査|院") #ruby("원|장","院|長")이었다. 그는 일찍이 7#ruby("인","人")의 #ruby("국|무|위|원","國|務|委|員")들이 #ruby("대|부|분","大|部|分") #ruby("직","職")을 버리고 #ruby("남|경","南|京") #ruby("의|열|단","義|烈|團")이 #ruby("주|창","主|唱")하는 5#ruby("당","黨") #ruby("통|일","統|一")에 #ruby("동|조","同|調")했을 때, #ruby("차|이|석","車|利|錫") #ruby("위|원","委|員")과 단둘이서 #ruby("정|부","政|府")를 #ruby("고|수","固|守")한 #ruby("공|로|자","功|勞|者")였다. 그런 그가 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("국|제|적","國|際|的") #ruby("승|인|문|제","承|認|問|題")가 떠오르는 이때, #ruby("천|추","千|秋")의 #ruby("원|한","怨|恨")을 품고 #ruby("영|영","永|永") 돌아올 수 없는 먼길을 떠나 #ruby("토|교","土|橋")에 한줌 흙으로 남은 것은, 오랜 #ruby("세|월","歲|月") 동안 #ruby("영|웅","英|雄")들에게 눈물로 옷깃을 적시게 할 일이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("임|시|정|부","臨|時|政|府")와 #ruby("독|립|당","獨|立|黨")과 #ruby("광|복|군","光|復|軍")은 #ruby("삼|위|일|체","三|位|一|體")로, 그 #ruby("중|심","中|心") #ruby("인|물","人|物")은 #ruby("한|독|당|원","韓|獨|黨|員")이었다. #ruby("한|독|당","韓|獨|黨")은 #ruby("한|국|혁|명","韓|國|革|命")의 #ruby("노|선|배","老|先|輩")들이 #ruby("집|중","集|中")한 곳이라 #ruby("생|산|율","生|産|率")보다 #ruby("사|망|률","死|亡|率")이 더 많음은 어찌할 수 없는 #ruby("사|실","事|實")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이제 #ruby("대|가|족","大|家|族") #ruby("명|부","名|簿")를 #ruby("작|성","作|成")하여 #ruby("후|세","後|世")에 #ruby("전","傳")하고자 한다. #ruby("기|미","己|未") 3·1#ruby("운|동","運|動")으로 #ruby("인","因")하여 #ruby("상|해","上|海")에 와서 살던 500#ruby("여","餘") #ruby("동|포","同|胞")가 거의 #ruby("대|가|족","大|家|族")이라 말할 수 있으나, 여기 #ruby("일|지","逸|志")에 #ruby("기|재","記|載")하는 #ruby("대|가|족","大|家|族")은 #ruby("홍|구|폭|탄","虹|口|爆|彈") #ruby("사|건","事|件")으로 말미암아 #ruby("상|해","上|海")를 빠져나온 #ruby("동|지","同|志")들과 그 #ruby("가|족","家|族")들이 #ruby("대|부|분","大|部|分")이다. #ruby("손|일|민","孫|逸|民")·#ruby("이|광","李|光") #ruby("등","等") #ruby("동|지","同|志")들은 #ruby("북|경","北|京") #ruby("방|면","方|面")에서 여러 해 #ruby("거|주","居|住")하다가, #ruby("노|구|교","蘆|溝|橋") #ruby("전|쟁","戰|爭") #ruby("폭|발","爆|發") #ruby("이|후","以|後") #ruby("가|족","家|族")들을 거느리고 #ruby("남|하","南|下")하여 #ruby("남|경","南|京")에서 #ruby("합|류","合|流")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|부|분","大|部|分")이 #ruby("상|해","上|海")를 빠져나온 #ruby("가|족","家|族")들이지만, 그#ruby("중","中")에서도 #ruby("남|경","南|京")에서 두 #ruby("파","派")로 갈려 빠져나왔으니, 한쪽은 #ruby("김|원|봉","金|元|鳳") #ruby("군","君")의 #ruby("조|선|민|족|혁|명|당","朝|鮮|民|族|革|命|黨")이요, 우리#ruby("측","側")은 #ruby("한|국|국|민|당","韓|國|國|民|黨")·#ruby("조|선|혁|명|당","朝|鮮|革|命|黨")·#ruby("한|국|독|립|당","韓|國|獨|立|黨") 3#ruby("당","黨")이었다. #ruby("김|원|봉","金|元|鳳")은 #ruby("동|지","同|志")들과 #ruby("가|족","家|族")들을 거느리고 #ruby("남|경","南|京")을 빠져나와 #ruby("한|구","漢|口")를 #ruby("경|유","經|由")하여 #ruby("중|경","重|慶")으로 옮겼다. 나는 #ruby("동|지","同|志")들과 그 #ruby("권|속","眷|屬")을 이끌고 #ruby("한|구","漢|口")를 #ruby("경|유","經|由")하여 #ruby("장|사","長|沙")로 가서 8#ruby("개|월","個|月"), #ruby("광|주","廣|州")로 가서 3#ruby("개|월","個|月"), #ruby("유|주","柳|州")로 가서 몇 달, #ruby("기|강","綦|江")으로 가서 #ruby("근","近") 1#ruby("년","年") 있다가 #ruby("토|교","土|橋") #ruby("동|감","東|坎")에 왔다. 이곳에서 새로 지은 #ruby("가|옥","家|屋") 4#ruby("동","棟")에 #ruby("대|부|분","大|部|分") #ruby("가|족","家|族")이 #ruby("거|주","居|住")하였다. 그 #ruby("외","外")에 #ruby("중|경","重|慶")에는 #ruby("당|부","黨|部")·#ruby("정|부","政|府")·#ruby("군|부","軍|部")의 #ruby("기|관","機|關")에 #ruby("복|무","服|務")하는 #ruby("동|지","同|志")들과 #ruby("가|족","家|族")들이 있었다. #ruby("대|가|족","大|家|族") #ruby("명|부","名|簿")는 #ruby("별|지","別|紙")로 #ruby("작|성","作|成")한다.#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("당|시","當|時") #ruby("별|지","別|紙")에 #ruby("작|성","作|成")된 #ruby("대|가|족","大|家|族") #ruby("명|부","名|簿")는 #ruby("현|재","現|在") #ruby("확|인","確|認")할 수 없지만, 이를 #ruby("추|정","推|定")할 수 있는 #ruby("방|증","傍|證") #ruby("자|료","資|料")들은 있다. #ruby("본|서","本|書") 뒤쪽에 #ruby("첨|부","添|附")된 【#ruby("자|료","資|料")1〜3】 #ruby("참|고","參|考").]]
