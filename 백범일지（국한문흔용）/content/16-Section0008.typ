#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("재|정","財|政")으로 말하면, #ruby("본|국","本|國") #ruby("동|포","同|胞")들의 #ruby("비|밀","祕|密") #ruby("연|납","捐|納")과 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷") #ruby("한|인","韓|人") #ruby("동|포","同|胞")들의 #ruby("세|금","稅|金") #ruby("명|목","名|目") #ruby("상|납","上|納")으로 #ruby("충|당","充|當")했는데, #ruby("왜","倭")의 #ruby("강|압","强|壓")과 #ruby("운|동","運|動")의 #ruby("퇴|조","退|潮")로 #ruby("원|년","元|年")\(1919)보다 2#ruby("년","年")\(1920)의 #ruby("숫|자","數|字")가 #ruby("감|소","減|少")되고, 그#ruby("후","後") #ruby("점|점","漸|漸") 더 #ruby("감|소","減|少")되었다. 이에 따라 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("직|무","職|務")도 #ruby("정|지","停|止")되고 #ruby("총|장","總|長")·#ruby("차|장","次|長") 들 #ruby("중","中")에서 #ruby("투|항","投|降")하거나 #ruby("귀|국","歸|國")하는 #ruby("자","者")가 한둘이 아니었다. 이러한 #ruby("지|경","地|境")이니 그 아랫사람은 더 말하지 않아도 알만하며, 그 #ruby("중|요","重|要") #ruby("원|인","原|因")은 #ruby("경|제|적","經|濟|的") #ruby("곤|란","困|難")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("윤|봉|길","尹|奉|吉") #ruby("의|사","義|士")의 #ruby("홍|구","虹|口") #ruby("사|건","事|件") #ruby("이|후","以|後") #ruby("내","內")·#ruby("외|국|인","外|國|人")의 #ruby("임|시|정|부","臨|時|政|府")에 #ruby("대","對")한 #ruby("태|도","態|度")가 #ruby("호|전","好|轉")되어, #ruby("정|부","政|府")의 #ruby("재|정","財|政") #ruby("수|입|고","收|入|高")도 해마다 #ruby("증|가","增|加")하여 23#ruby("년","年")\(1941)에는 #ruby("수|입","收|入")이 53#ruby("만|원","萬|圓") #ruby("이|상","以|上")에 #ruby("달","達")하니, #ruby("임|시|정|부","臨|時|政|府") #ruby("설|립","設|立") #ruby("이|래","以|來") #ruby("최|고","最|高") #ruby("기|록","記|錄")을 #ruby("돌|파","突|破")하였다. 이때부터 #ruby("수|백","數|百") #ruby("수|천","數|千") #ruby("배","倍")로 #ruby("증|가","增|加")될 #ruby("단|계","段|階")에 들어섰다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海") #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地") #ruby("보|경|리","普|慶|里") 4#ruby("호","號") 2#ruby("층","層")에서 #ruby("참|담","慘|憺")하고 #ruby("고|난","苦|難")한 #ruby("환|경","環|境")을 #ruby("극|복","克|服")하기 #ruby("위","爲")해 #ruby("최|대","最|大")·#ruby("최|후","最|後")의 #ruby("결|심","決|心")을 하고 #ruby("본","本") #ruby("일|지","逸|志") #ruby("상|권","上|卷")을 쓰던 때에 #ruby("비","比")하면, #ruby("지|금","只|今")의 #ruby("임|시|정|부","臨|時|政|府")는 #ruby("약|간","若|干")의 #ruby("진|보","進|步") #ruby("상|태","狀|態")로 볼 수 있다. 그러나 나 #ruby("자|신","自|身")으로 말하면 날마다 늙어가고 #ruby("병","病")드니, #ruby("상|해","上|海")#ruby("시|대","時|代")를 ‘죽자꾸나 #ruby("시|대","時|代")’라 한다면 #ruby("중|경","重|慶")#ruby("시|대","時|代")는 ‘죽어가는 #ruby("시|대","時|代")’라 하겠다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어떤 사람이 나에게 “어떻게 죽기를 #ruby("원","願")하는가?” 물으면, 나의 #ruby("최|대","最|大") #ruby("소|원","所|願")은 #ruby("독|립","獨|立")이 #ruby("성|공","成|功")한 #ruby("후","後") #ruby("본|국","本|國")에 들어가 #ruby("입|성|식","入|城|式")을 하고 죽는 것이며, 작은 #ruby("소|망","所|望")은 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷") #ruby("동|포","同|胞")들을 만나보고 돌아오다 #ruby("비|행|기","飛|行|機") 위에서 죽으면 #ruby("시|신","屍|身")을 아래로 던져, #ruby("산|중","山|中")에 떨어지면 짐승들의 뱃속에, 바다 가운데 떨어지면 물고기 뱃속에 #ruby("영|원","永|遠")히 잠드는 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("세|상","世|上")은 #ruby("고|해","苦|海")라더니 살기도 어렵거니와 죽기도 또한 어렵다. #ruby("타|살","他|殺")보다 #ruby("자|살","自|殺")은 #ruby("결|심","決|心")만 #ruby("강","强")하면 쉬운 듯하지만, #ruby("자|살","自|殺")도 #ruby("자|유","自|由")가 있는 데서나 #ruby("가|능","可|能")한 것이다. 나도 #ruby("옥|중","獄|中")에서 두 #ruby("번","番")이나 —#ruby("치|하|포","鴟|河|浦") #ruby("사|건","事|件")으로 #ruby("투|옥","投|獄")되어 #ruby("인|천|옥","仁|川|獄")에서 장티푸스에 걸렸을 때, 그리고 17#ruby("년","年") #ruby("후","後") 다시 #ruby("인|천|감|옥","仁|川|監|獄")으로 돌아와 #ruby("인|천|항","仁|川|港") #ruby("축|항|공|사","築|港|工|事")를 할 때— #ruby("자|살","自|殺")하려다 #ruby("실|패","失|敗")하였다. #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 #ruby("안|매|산","安|梅|山") #ruby("명|근","明|根") #ruby("형","兄")이 굶어 죽기를 #ruby("결|심","決|心")하고 조용히 묻거늘 나는 #ruby("찬|성","贊|成")하였다. 그가 3〜4#ruby("일","日") 동안 배가 아프니 머리가 아프니 하는 핑계로 #ruby("음|식","飮|食")을 끊었으나, 눈치 빠른 #ruby("왜","倭")놈 #ruby("간|수","看|守")가 알아차리고 #ruby("의|사","醫|師")에게 #ruby("진|찰","診|察")케 하고 #ruby("매|산","梅|山")을 #ruby("결|박","結|縛")한 #ruby("후","後") #ruby("강|제","强|制")로 입을 벌리고 #ruby("계|란","鷄|卵")을 풀어 넣었다. #ruby("결|국","結|局") #ruby("매|산","梅|山")이 “#ruby("자|살","自|殺")을 #ruby("단|념","斷|念")하겠노라”고 #ruby("통|고","通|告")를 한 것을 보면, #ruby("자|유","自|由")를 잃으면 #ruby("자|살","自|殺")도 쉬운 일이 아니다]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("칠|십","七|十") #ruby("평|생","平|生")을 #ruby("회|고","回|顧")하면, 살려고 산 것이 아니고 살아져서 산 것이며, 죽으려도 죽지 못한 이 몸이 끝내는 죽어져서 죽게 되었도다.]
