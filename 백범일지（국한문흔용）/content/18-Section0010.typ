#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("윤|봉|길","尹|奉|吉") #ruby("군","君")은 #ruby("내|일","來|日") 이른 아침에 #ruby("중|대","重|大") #ruby("임|무","任|務")를 띄워 #ruby("동|북","東|北") 3#ruby("성","省")으로 #ruby("파|견","派|遣")할 터이니, 저녁에 쇠고기를 사다가 #ruby("내|일","來|日") 새벽 아침을 #ruby("부|탁","付|託")하오.”]
