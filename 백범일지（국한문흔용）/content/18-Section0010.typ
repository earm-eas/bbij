#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("편|지","便|紙")를 보내고 그 길로 또 #ruby("석|오","石|吾") #ruby("이|동|녕","李|東|寧") #ruby("선|생","先|生") #ruby("처|소","處|所")로 가서 그 동안의 #ruby("진|행","進|行") #ruby("경|과","經|過")를 #ruby("보|고","報|告")하고, #ruby("점|심","點|心")을 먹고 난 뒤 무슨 #ruby("소|식","消|息")이 있기를 기다렸다. 마침내 #ruby("오|후","午|後") 1#ruby("시","時")쯤 되자 곳곳에서 #ruby("허|다","許|多")한 #ruby("중|국","中|國")사람들이 술렁거리는 소리가 들려왔지만, #ruby("전","傳")하는 말이 달라 #ruby("정|확","正|確")한 #ruby("상|황","狀|況")을 #ruby("확|인","確|認")할 수 없었다. “#ruby("홍|구|공|원","虹|口|公|園")에서 #ruby("중|국|인","中|國|人")이 #ruby("폭|탄","爆|彈")을 던져서 #ruby("다|수","多|數") #ruby("일|본|인","日|本|人")이 #ruby("즉|사","卽|死")하였다” “#ruby("고|려","高|麗")사람의 짓이다”라는 #ruby("등","等") #ruby("소|문","所|聞")이 #ruby("분|분","紛|紛")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어저께까지 #ruby("채|소","菜|蔬")바구니를 메고 날마다 #ruby("홍|구","虹|口")로 다니면서 장사하던 #ruby("윤|봉|길","尹|奉|吉")이 #ruby("세|상","世|上")을 깜짝 놀라게 할 큰 #ruby("사|건","事|件")을 #ruby("연|출","演|出")할 줄이야. 나 #ruby("이|외","以|外")에 #ruby("이|동|녕","李|東|寧")·#ruby("이|시|영","李|始|榮")·#ruby("조|완|구","趙|琬|九") #ruby("등","等") 몇 #ruby("명","名")만 이 #ruby("사|실","事|實")을 #ruby("짐|작","斟|酌")하였을 뿐이고, 그날의 #ruby("거|사","擧|事")는 나 혼자만 알고 있었다. 그런 까닭에 #ruby("즉|시","卽|時") #ruby("석|오","石|吾") #ruby("선|생","先|生")에게 가서 #ruby("자|초|지|종","自|初|至|終")을 #ruby("보|고","報|告")하고 나서 #ruby("자|세","仔|細")한 #ruby("소|식","消|息")을 기다렸던 것이다. 그러자 #ruby("오|후","午|後") 두세 #ruby("시","時")#ruby("경","頃")에 다음과 같은 #ruby("신|문","新|聞") #ruby("호|외","號|外")가 터져 나왔다.]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("홍|구|공|원","虹|口|公|園") #ruby("일|본|인","日|本|人")의 #ruby("경|축|대","慶|祝|臺") 위에서 #ruby("대|량","大|量")의 #ruby("폭|탄","爆|彈")이 #ruby("폭|발","爆|發")하여 #ruby("민|단|장","民|團|長") #ruby("가와바다","河端")는 #ruby("즉|사","卽|死")하고, #ruby("시라카와","白川") #ruby("대|장","大|將"), #ruby("시게미츠","重光") #ruby("대|사","大|使"), #ruby("우에다","植田") #ruby("중|장","中|將"), #ruby("노무라","野村") #ruby("중|장","中|將") #ruby("등","等") #ruby("문|무|대|관","文|武|大|官")이 모두 #ruby("중|상","重|傷") #ruby("운|운","云|云").#footnote(numbering: _ => [26)])[#h(0.35em)#ruby("상|해|파|견|군","上|海|派|遣|軍") #ruby("사|령|관","司|令|官") #ruby("시라카와","白川") #ruby("대|장","大|將")도 #ruby("이|후","以|後") #ruby("사|망","死|亡")하였다. #ruby("당|시","當|時") #ruby("가와바다","河端")는 #ruby("상|해","上|海") #ruby("일|본|인","日|本|人") #ruby("거|류|민|단|장","居|留|民|團|長"), #ruby("노무라","野村吉三郞") #ruby("중|장","中|將")은 #ruby("제|3|함|대","第|三|艦|隊") #ruby("사|령|관","司|令|官"), #ruby("우에다","植田謙吉") #ruby("중|장","中|將")은 #ruby("제|9|사|단|장","第|九|師|團|長")이었다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("일|본|인","日|本|人") #ruby("신|문","新|聞")에서는 ‘#ruby("중|국|인","中|國|人")의 #ruby("소|행","所|行")’이라고 하였으나, 그 다음날 #ruby("각","各") #ruby("신|문","新|聞")에는 한결같이 #ruby("윤|봉|길","尹|奉|吉")의 이름#ruby("자","字")를 큰 #ruby("활|자","活|字")로 #ruby("게|재","揭|載")하였다. 곧이어 #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地")에 #ruby("대","對")한 #ruby("대|대|적","大|大|的")인 #ruby("수|색","搜|索")이 벌어졌다. 나는 #ruby("안|공|근","安|恭|根")·#ruby("엄|항|섭","嚴|恒|燮") 두 사람을 가만히 불러 #ruby("부|탁","付|託")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("이|후","以|後")로 #ruby("군","君") #ruby("등","等")의 집안 #ruby("생|활","生|活")을 내가 #ruby("책|임","責|任")질 테니, 오로지 우리 #ruby("사|업","事|業")에만 #ruby("전|념","專|念")하라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리고는 #ruby("미|국|인","美|國|人") #ruby[피치][費吾生]에게 #ruby("당|분|간","當|分|間") 내가 지낼 #ruby("피|신|처","避|身|處")를 #ruby("교|섭","交|涉")하였다. 그의 #ruby("부|친","父|親")이 살아 있을 때 우리에게 크게 #ruby("동|정","同|情")하던 터라서 그런지, 그는 #ruby("대|단","大|端")히 기쁜 마음으로 우리들을 받아들였다. 나를 비롯하여 #ruby("일|강","一|江") #ruby("김|철","金|澈")과 #ruby("안","安")·#ruby("엄","嚴") #ruby("양|군","兩|君")을 #ruby("포|함","包|含")한 네 #ruby("명","名")이 그의 집으로 옮겨갔다. 그곳에서 우리는 2#ruby("층","層")을 #ruby("전|부","全|部") #ruby("사|용","使|用")하였고, #ruby("피치","費吾生") #ruby("부|인","夫|人")의 #ruby("극|진","極|盡")한 #ruby("정|성","精|誠")이 담긴 #ruby("식|사","食|事")까지 #ruby("대|접","待|接")받았다.#footnote(numbering: _ => [27)])[#h(0.35em)#ruby("피치","費吾生") #ruby("부|인","夫|人")의 #ruby("회|고","回|顧")에 #ruby("의","依")하면, 1932#ruby("년","年") 4#ruby("월","月") 29#ruby("일","日") 네 #ruby("명","名")의 #ruby("한|국|인","韓|國|人")이 찾아와 숨겨 달라고 했고, 다음날 #ruby("백|범","白|凡")은 자신이 이번 #ruby("사|건","事|件")의 #ruby("주|모|자","主|謀|者")라고 말했다 한다.] 벌써부터 우리는 #ruby("윤|의|사","尹|義|士")가 #ruby("희|생","犧|牲")한 #ruby("공|덕","功|德")을 톡톡히 #ruby("대|접","待|接")받기 #ruby("시|작","始|作")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("피치","費吾生") #ruby("댁","宅") #ruby("전|화","電|話")를 #ruby("사|용","使|用")하여 #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지|내","租|界|地|內") 우리 #ruby("동|포","同|胞")들의 집에 #ruby("연|락","連|絡")해 본 #ruby("결|과","結|果"), 때때로 우리 #ruby("동|포","同|胞")들이 #ruby("체|포","逮|捕")되는 #ruby("보|고","報|告")를 들었다. 나는 #ruby("체|포","逮|捕")된 우리 #ruby("동|포","同|胞")들을 #ruby("법|률","法|律")로써 #ruby("구|제","救|濟")하기 #ruby("위","爲")해 돈을 주고 #ruby("서|양","西|洋") #ruby("변|호|사","辯|護|士")를 #ruby("고|용","雇|傭")하여 보았으나 #ruby("별","別") #ruby("효|과","效|果")가 없었다. 나는 돈을 줘서 잡혀간 #ruby("동|지","同|志")들의 #ruby("생|계","生|計")를 돕게 하고, #ruby("만|약","萬|若") #ruby("피|신","避|身")하고자 하는 #ruby("자","者")가 있으면 #ruby("여|비","旅|費")를 #ruby("마|련","磨|鍊")해 주게 하였다. 이때 #ruby("체|포","逮|捕")된 사람으로는 #ruby("안|창|호","安|昌|浩")#footnote(numbering: _ => [28)])[#h(0.35em)#ruby("안|창|호","安|昌|浩")는 이 #ruby("사|건","事|件")으로 #ruby("일|경","日|警")에게 #ruby("체|포","逮|捕")되어 #ruby("본|국","本|國")으로 #ruby("압|송","押|送")되어 #ruby("서|대|문|형|무|소","西|大|門|刑|務|所")에서 3#ruby("년|간","年|間") #ruby("복|역","服|役")하였다.]·#ruby("장|헌|근","張|憲|根")·#ruby("김|덕|근","金|德|根") #ruby("등","等")과 그 #ruby("외","外")에 젊은 #ruby("학|생","學|生")들이 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[날마다 #ruby("왜","倭")놈들이 미친개와 같이 사람을 잡으려고 돌아다녀 우리 #ruby("임|시|정|부","臨|時|政|府")와 #ruby("민|단","民|團") #ruby("직|원","職|員")들은 말할 것도 없고, #ruby("심|지|어","甚|之|於") #ruby("부|녀|단|체","婦|女|團|體")인 #ruby("애|국|부|인|회","愛|國|婦|人|會")까지도 #ruby("전","全")혀 #ruby("활|동","活|動")을 할 수 없게 되었다. 이렇게 되자 우리 #ruby("동|포","同|胞")들 사이에서 나를 #ruby("비|난","非|難")하는 소리가 생기기 #ruby("시|작","始|作")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이번 #ruby("홍|구|사|변","虹|口|事|變")의 #ruby("주|모|책|임|자","主|謀|責|任|者")는 따로 있으면서, #ruby("자|기","自|己")가 #ruby("사|건","事|件")을 감추고서 #ruby("관|계","關|係")가 없는 #ruby("자","者")들만 잡히게 하는 것은 옳지 못하다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이것은 #ruby("이|유|필","李|裕|弼")#footnote(numbering: _ => [29)])[#h(0.35em)#ruby("이|유|필","李|裕|弼")\(1885〜1945). #ruby("독|립|운|동|가","獨|立|運|動|家"). #ruby("평|안|북|도","平|安|北|道") #ruby("의|주","義|州") #ruby("출|신","出|身"). 105#ruby("인","人") #ruby("사|건","事|件"), 3·1#ruby("운|동","運|動")에 #ruby("참|여","參|與")하였다. 1922#ruby("년","年") #ruby("한|국|노|병|회","韓|國|勞|兵|會")를 #ruby("결|성","結|成")하고 #ruby("이|사|장","理|事|長")을 #ruby("역|임","歷|任")했으며, 그#ruby("후","後") #ruby("상|해|교|민|단","上|海|僑|民|團") #ruby("단|장","團|長"), #ruby("상|해","上|海") #ruby("인|성|학|교","仁|成|學|校") #ruby("교|장","校|長"), #ruby("임|시|정|부","臨|時|政|府") #ruby("국|무|위|원","國|務|委|員") #ruby("등","等")을 #ruby("역|임","歷|任")하였다. 그는 1933#ruby("년","年") #ruby("치|안|유|지|법","治|安|維|持|法") #ruby("위|반","違|反")으로 #ruby("체|포","逮|捕")되어 3#ruby("년|형","年|刑")을 받아 #ruby("복|역","服|役")한 적이 있으며, #ruby("해|방","解|放") #ruby("이|후","以|後") #ruby("평|북","平|北")에서 #ruby("반|공|지|도|자","反|共|指|導|者")로 #ruby("활|동","活|動")하다 #ruby("월|남","越|南")하던 #ruby("도|중","途|中") 38#ruby("선|상","線|上")인 #ruby("청|단","靑|丹")에서 #ruby("심|장|마|비","心|臟|麻|痹")로 #ruby("사|망","死|亡")하였다.] #ruby("등","等") #ruby("일|부","一|部") #ruby("인|사","人|士")들의 말이었다. 나의 #ruby("편|지","便|紙")를 보고도 그날은 아무 일이 없으리라 #ruby("짐|작","斟|酌")하고 #ruby("이|씨","李|氏") 집을 찾아갔던 #ruby("안|창|호","安|昌|浩") #ruby("선|생","先|生")이 #ruby("체|포","逮|捕")된 것은 그의 #ruby("불|찰","不|察")이나, #ruby("주|모|자","主|謀|者")가 아무 #ruby("발|표","發|表")가 없는 #ruby("관|계","關|係")로 사람들이 함부로 #ruby("체|포","逮|捕")된다는 #ruby("원|성","怨|聲")이 있었다. 이런 까닭에 나는 “#ruby("사|건","事|件")의 #ruby("진|상","眞|相")을 #ruby("세|상","世|上")에 #ruby("공|개","公|開")할 #ruby("필|요","必|要")가 있다”고 여러 #ruby("동|지","同|志")들에게 #ruby("주|장","主|張")했다. 앉아 있던 #ruby("안|공|근","安|恭|根")은 펄쩍 뛰면서,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("형","兄")님이 #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地")에 계시면서 이같은 #ruby("발|표","發|表")를 하는 것은 #ruby("지|극","至|極")히 #ruby("위|험","危|險")합니다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("반|대","反|對")하였다. 그러나 나는 그의 #ruby("주|장","主|張")을 받아들이지 않고, #ruby("엄|항|섭","嚴|恒|燮")으로 하여금 #ruby("선|언|문","宣|言|文")을 #ruby("기|초","起|草")하게 하고 #ruby("피치","費吾生") #ruby("부|인","夫|人")에게 #ruby("영|문","英|文")으로 #ruby("번|역","飜|譯")시켜 로이터 #ruby("통|신|사","通|信|社")에 #ruby("투|고","投|稿")하였다.#footnote(numbering: _ => [30)])[#h(0.35em)1932#ruby("년","年") 5#ruby("월","月") 10#ruby("일","日") #ruby("백|범","白|凡")은 #ruby("한|인|애|국|단","韓|人|愛|國|團") #ruby("영|수","領|袖") #ruby("명|의","名|義")로 #ruby("윤|봉|길","尹|奉|吉") #ruby("의|거","義|擧")의 #ruby("진|상","眞|相")을 밝히는 #ruby("장|문","長|文")의 #ruby("성|명|서","聲|明|書")를 #ruby("발|표","發|表")하였다. #ruby("성|명|서","聲|明|書")는 머리말에서 #ruby("홍|구|공|원","虹|口|公|園") #ruby("의|거","義|擧")로 #ruby("한|인","韓|人")들이 #ruby("체|포","逮|捕")되는 #ruby("상|황","狀|況")을 #ruby("묵|과","默|過")할 수 없는 #ruby("인|간|적","人|間|的") #ruby("도|리","道|理")와, #ruby("일|제","日|帝") #ruby("타|도","打|倒")를 #ruby("위","爲")해 #ruby("세|계","世|界")에 #ruby("진|상","眞|相")을 #ruby("공|포","公|布")한다고 밝히고, #ruby("본|문","本|文")은 「#ruby("계|획","計|劃")과 #ruby("실|행","實|行")」, 「#ruby("윤|봉|길","尹|奉|吉") #ruby("약|력","略|歷")」, 「#ruby("한|인|애|국|단","韓|人|愛|國|團")」, 「나는 어떠한 사람인가」 #ruby("등","等")의 #ruby("소|제|목","小|題|目")으로 #ruby("구|성","構|成")되어 있다.] 이 #ruby("발|표","發|表")를 #ruby("통","通")하여 비로소 #ruby("세|계","世|界") #ruby("각|국","各|國")에서는 #ruby("동|경","東|京") #ruby("사|건","事|件")과 #ruby("상|해","上|海") #ruby("홍|구","虹|口") #ruby("사|건","事|件")의 #ruby("주|모|계|획|자","主|謀|計|劃|者")는 #ruby("김|구","金|九")요, #ruby("집|행|자","執|行|者")는 #ruby("이|봉|창","李|奉|昌")과 #ruby("윤|봉|길","尹|奉|吉")이라는 #ruby("사|실","事|實")을 알게 되었다. ‘#ruby("신|천","信|川") #ruby("사|건","事|件")’과 ‘#ruby("대|련","大|連") #ruby("사|건","事|件")’#footnote(numbering: _ => [31)])[#h(0.35em)#ruby("신|천","信|川") #ruby("사|건","事|件")은 #ruby("이|덕|주","李|德|柱")·#ruby("유|진|식","兪|鎭|植")을 #ruby("파|견","派|遣")하여 #ruby("조|선|총|독","朝|鮮|總|督")을 #ruby("암|살","暗|殺")하려 한 #ruby("사|건","事|件"). #ruby("대|련","大|連") #ruby("사|건","事|件")은 #ruby("유|상|근","柳|相|根")·#ruby("최|흥|식","崔|興|植")을 #ruby("파|견","派|遣")하여 #ruby("만|주","滿|洲")의 #ruby("관|동|군","關|東|軍") #ruby("사|령|관","司|令|官")인 #ruby("혼|조","本|庄") #ruby("시게루","繁")를 #ruby("암|살","暗|殺")하라고 #ruby("명|령","命|令")한 #ruby("사|건","事|件")이다.]은 다 #ruby("실|패","失|敗")하였으나 아직 #ruby("발|표","發|表")할 때가 아니라고 #ruby("생|각","生|覺")하였기 때문에, 위 두 #ruby("사|건","事|件")만을 #ruby("우|선","優|先") #ruby("발|표","發|表")한 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海")에서 #ruby("중|대","重|大") #ruby("사|건","事|件")이 #ruby("발|생","發|生")한 것을 알고 #ruby("남|경","南|京")에 있던 #ruby("남|파","南|坡") #ruby("박|찬|익","朴|贊|翊")#footnote(numbering: _ => [32)])[#h(0.35em)#ruby("박|찬|익","朴|贊|翊")\(1884〜1949). #ruby("경|기|도","京|畿|道") #ruby("파|주","坡|州") #ruby("출|신","出|身"). 그는 #ruby("특","特")히 #ruby("중|국|어","中|國|語")에 #ruby("능|통","能|通")하여 #ruby("임|정","臨|政")의 #ruby("대|중|외|교","對|中|外|交") #ruby("책|임|자","責|任|者")로 #ruby("활|약","活|躍")하였다. #ruby("한|독|당","韓|獨|黨") #ruby("중|앙|집|행|위|원","中|央|執|行|委|員"), #ruby("임|시|정|부","臨|時|政|府") #ruby("국|무|위|원","國|務|委|員") #ruby("등","等")을 #ruby("역|임","歷|任")하였다. #ruby("조|완|구","趙|琬|九")·#ruby("엄|항|섭","嚴|恒|燮")과 함께 #ruby("김|구","金|九")의 #ruby("핵|심","核|心") #ruby("측|근","側|近")으로 #ruby("활|약","活|躍")하였으며, #ruby("해|방","解|放") #ruby("후","後") #ruby("임|정","臨|政")이 #ruby("귀|국","歸|國")한 뒤에는 #ruby("주|화","駐|華")#ruby("대|표|단","代|表|團") #ruby("단|장","團|長")으로 #ruby("임|정","臨|政")과 #ruby("중|국","中|國") #ruby("국|민|당","國|民|黨") 사이의 #ruby("외|교|업|무","外|交|業|務")를 #ruby("처|리","處|理")하였다.] #ruby("형","兄")이 #ruby("상|해","上|海")로 옮겨와서 #ruby("중|국","中|國") #ruby("인|사","人|士")들과 #ruby("접|촉","接|觸")한 #ruby("결|과","結|果"), 우리는 #ruby("물|질|상","物|質|上")으로만이 아니라 #ruby("여|타","餘|他") #ruby("방|면","方|面")에서도 #ruby("중|국","中|國") #ruby("측","側")으로부터 많은 #ruby("편|의","便|宜")를 #ruby("제|공","提|供")받았다. 나는 낮에는 #ruby("전|화","電|話")로 잡혀간 #ruby("동|포","同|胞")의 #ruby("가|족","家|族")들을 #ruby("위|로","慰|勞")하고 밤에는 #ruby("안","安")·#ruby("엄","嚴")·#ruby("박","朴") #ruby("등","等")의 #ruby("동|지","同|志")들과 #ruby("출|근","出|勤")하여, #ruby("체|포","逮|捕")된 #ruby("가|족","家|族")들의 #ruby("구|제","救|濟")와 그와 #ruby("관|련","關|聯")된 #ruby("교|섭|작|업","交|涉|作|業")을 #ruby("진|행","進|行")하였다. 그러던 #ruby("중","中") #ruby("중|국","中|國")의 #ruby("유|명|인|사","有|名|人|士")인 #ruby("은|주|부","殷|鑄|夫")·#ruby("주|경|란","朱|慶|瀾")·#ruby("사|량|교","査|良|釗") #ruby("등","等")의 #ruby("면|회","面|會") #ruby("요|구","要|求")에 #ruby("응","應")하기 #ruby("위","爲")하여 #ruby("야|간","夜|間")에 #ruby("자|동|차","自|動|車")를 타고 #ruby("홍|구","虹|口") #ruby("방|면","方|面")과 #ruby("정|안|사|로","靜|安|寺|路") #ruby("방|면","方|面")으로 돌아다녔다. #ruby("평|일","平|日")에는 한 걸음도 #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地") 밖으로 나다니지 않던 나의 #ruby("행|동|거|지","行|動|擧|止")로 볼 때, 그것은 #ruby("일|대|변|동","一|大|變|動")이 아닐 수 없었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[여기서 #ruby("잠|시","暫|時") #ruby("중|국","中|國") #ruby("인|사","人|士")들의 우리들에 #ruby("대","對")한 #ruby("태|도","態|度"), #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")·멕시코·쿠바 #ruby("교|포","僑|胞")들의 나에 #ruby("대","對")한 #ruby("태|도","態|度"), #ruby("중|국","中|國") #ruby("관|내","關|內") 우리 #ruby("인|사","人|士")들의 나에 #ruby("대","對")한 #ruby("태|도","態|度")를 #ruby("간|략","簡|略")히 #ruby("기|술","記|述")하겠다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째는 #ruby("중|국","中|國")사람들인데, #ruby("왜|구","倭|寇")의 #ruby("중","中")·#ruby("한","韓") #ruby("양|민|족","兩|民|族")에 #ruby("대","對")한 ‘#ruby("감|정|악|화","感|情|惡|化") #ruby("정|책","政|策")’의 #ruby("일|환","一|環")으로 ‘#ruby("만|보|산","萬|寶|山") #ruby("사|건","事|件")’이 터졌다. 이를 #ruby("기|화","奇|貨")로 #ruby("중|국","中|國") #ruby("상|인","商|人")과 #ruby("노|동|자","勞|動|者")들에 #ruby("대","對")한 #ruby("감|정","感|情")이 #ruby("폭|발","爆|發")하여 #ruby("조|선","朝|鮮") 곳곳에서 #ruby("한|인","韓|人") #ruby("무|뢰|배","無|賴|輩")들이 #ruby("총|동|원","總|動|員")되어 그들을 만나는 대로 때려죽이는 #ruby("소|동","騷|動")이 벌어졌다. #ruby("중|류","中|流") #ruby("이|상","以|上")의 #ruby("중|국|인","中|國|人")들은 #ruby("만|보|산|사|건","萬|寶|山|事|件")이 #ruby("왜|구","倭|寇")의 #ruby("간|계","奸|計")임을 #ruby("간|파","看|破")하였지만, #ruby("하|류|계|급","下|流|階|級") 사이에서는 “#ruby("고|려|인","高|麗|人")이 #ruby("중|국|인","中|國|人")을 때려죽인다”는 #ruby("악|감|정","惡|感|情")이 #ruby("동|경","東|京") #ruby("사|건","事|件")\(#ruby("이|봉|창","李|奉|昌") #ruby("의|거","義|擧")) #ruby("이|후","以|後")에도 좀체 사그라지지 않았다. 게다가 1·28 #ruby("상|해|전|쟁","上|海|戰|爭")으로 #ruby("왜|병","倭|兵")이 #ruby("민|가","民|家")에 함부로 불을 지를 때 #ruby("최|영|택","崔|英|澤") 같은 #ruby("악|한","惡|漢")을 #ruby("사|주","唆|嗾")하여 #ruby("중|국|인","中|國|人") 집에 들어가 많은 사람들이 지켜보는 가운데 #ruby("재|물","財|物")을 #ruby("약|탈","掠|奪")하게 하는 일들이 #ruby("허|다","許|多")하게 일어났다. 이로 #ruby("인","因")해 #ruby("주","主")로 #ruby("자|동|차","自|動|車")와 #ruby("전|차","電|車")의 #ruby("한|인","韓|人") #ruby("검|표|원","檢|票|員")들이 #ruby("중|국|인","中|國|人") #ruby("노|동|자","勞|動|者")들에게 아무 #ruby("이|유","理|由") 없이 #ruby("구|타","毆|打")당하는 일이 #ruby("종|종","種|種") #ruby("발|생","發|生")하였다. 그러나 4·29 #ruby("사|건","事|件")으로 #ruby("인","因")하여 #ruby("중|국|인","中|國|人")들의 #ruby("한|인","韓|人")들에 #ruby("대","對")한 #ruby("감|정","感|情")은 놀랄 만큼 #ruby("호|전","好|轉")되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[둘째, 이 #ruby("거|사","擧|事")로 #ruby("인","因")하여 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")·멕시코·쿠바 #ruby("등|지","等|地")의 #ruby("한|인","韓|人") #ruby("교|포","僑|胞")들의 #ruby("임|시|정|부","臨|時|政|府")에 #ruby("대","對")한 #ruby("성|원","聲|援")이 #ruby("대|단","大|端")하였다. #ruby("동|경","東|京") #ruby("사|건","事|件")은 #ruby("완|전","完|全")히 #ruby("성|공","成|功")하지는 못하였지만 조금이라도 #ruby("민|족|혼","民|族|魂")을 떨친 터에, 이번 #ruby("홍|구","虹|口") #ruby("사|건","事|件")이 #ruby("절|대|적","絶|對|的")인 #ruby("성|공","成|功")을 거두었기 때문이다. 이로부터 #ruby("임|시|정|부","臨|時|政|府")에 #ruby("대","對")한 #ruby("납|세","納|稅")와 나에 #ruby("대","對")한 #ruby("후|원","後|援")은 #ruby("급|격","急|激")하게 #ruby("증|가","增|加")하여, #ruby("점|차","漸|次") #ruby("사|업","事|業")이 #ruby("확|장","擴|張")되는 #ruby("단|계","段|階")로 나가게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("관|내","關|內") 우리 #ruby("독|립|운|동|가","獨|立|運|動|家")들의 나에 #ruby("대","對")한 #ruby("태|도","態|度")는 #ruby("낙|관|적","樂|觀|的")이라기보다도 #ruby("비|관|적","悲|觀|的")인 #ruby("편","便")이 더 많았다. 나에 #ruby("대","對")한 #ruby("한|인","韓|人") #ruby("교|포","僑|胞")들의 #ruby("유|일","唯|一")한 #ruby("불|만","不|滿")은, 4·29 #ruby("사|건","事|件") #ruby("이|후","以|後") #ruby("신|변","身|邊")이 #ruby("위|험","危|險")하여 내가 #ruby("평|소","平|素") #ruby("친|지","親|知")들의 #ruby("면|담","面|談") #ruby("요|구","要|求")에 함부로 #ruby("응","應")할 수 없었다는 것이었다. 한#ruby("번","番")은 이런 일이 있었다. 나는 #ruby("전|차","電|車") #ruby("검|표|원","檢|票|員")으로 #ruby("별|명","別|名")이 ‘#ruby("박|대|장","朴|大|將")’이란 #ruby("사|리|원","沙|里|院") #ruby("출|신","出|身") 젊은이의 #ruby("청|첩","請|帖")을 받고, 그의 #ruby("혼|인","婚|姻")잔치에 #ruby("축|하|차","祝|賀|次") #ruby("잠|시","暫|時") #ruby("방|문","訪|問")한 적이 있었다. 그 집에 #ruby("도|착","到|着")하여 #ruby("주|방","廚|房")에서 일하는 #ruby("부|인","夫|人")들을 보고,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("속","速")히 가야겠으니, 빨리 국수 한 그릇만 말아 달라.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("부|탁","付|託")하였다. 그리고는 #ruby("냉|면","冷|麵") 한 그릇을 받아서 #ruby("급","急")히 먹고, 담배 한 개피를 피워 물고 곧장 그 집을 나왔다. 그 집 #ruby("문|간","門|間")을 나서면 바로 이웃하여 우리 #ruby("동|포","同|胞")가 #ruby("운|영","運|營")하는 가게가 하나 있었다. 왔던 길에 #ruby("잠|시","暫|時") 들렀다 가려고 가게에 들어가 미처 앉기도 #ruby("전","前")에, #ruby("주|인","主|人")이 내 옆구리를 쿡쿡 찌르며 손으로 #ruby("하|비|로","霞|飛|路")를 가리켰다. 가리키는 곳을 돌아보니 #ruby("왜|경","倭|警") 10#ruby("여","餘") #ruby("명","名")이 길에 늘어서서 #ruby("전|차","電|車")가 지나가기를 기다리는 것이 아닌가.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 달리 #ruby("피","避")할 곳이 없어 #ruby("유|리|창","琉|璃|窓")으로 #ruby("왜","倭")놈의 #ruby("동|향","動|向")을 #ruby("주|시","注|視")하였더니, 그들이 쏜살같이 #ruby("박|대|장","朴|大|將")의 집으로 들어가는 것이 보였다. 나는 #ruby("급","急")히 그 가게를 빠져나와 #ruby("전|차","電|車") #ruby("선|로","線|路")를 따라 #ruby("김|의|한","金|毅|漢") #ruby("군","君")의 집으로 가, 그 #ruby("부|인","夫|人")을 #ruby("박|대|장","朴|大|將") 집으로 보내 #ruby("상|황","狀|況")을 살펴보게 하였다. 그랬더니 바로 #ruby("전","前")의 #ruby("왜","倭")놈이 들어와서는,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("방|금","方|今") 들어온 #ruby("김|구","金|九")가 어디 있는가?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 다그쳐 물으면서 집안을 #ruby("수|색","搜|索")하기 #ruby("시|작","始|作")하였고, #ruby("심|지|어","甚|之|於") 아궁이 속까지 뒤지고 갔다는 것이다. 이와 같은 #ruby("사|건","事|件")은 누구나 다 아는 잘 알려진 #ruby("사|실","事|實")이다.]
