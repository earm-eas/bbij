#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제 #ruby("시|계","時|計")는 어제 #ruby("선|서|식","宣|誓|式") #ruby("후","後") #ruby("선|생","先|生")님의 말씀에 따라 6#ruby("원","元")을 주고 #ruby("구|입","購|入")한 것인데, #ruby("선|생","先|生")님 #ruby("시|계","時|計")는 #ruby("불|과","不|過") 2#ruby("원","元")짜리입니다. 저는 이제 1#ruby("시|간","時|間")밖에 더 #ruby("소|용","所|用")없습니다.”]
