#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("일|본|인","日|本|人")은 #ruby("한|인","韓|人")에게 당한 이 한 가지 #ruby("사|건","事|件")만으로는 #ruby("침|략|전|쟁","侵|略|戰|爭")을 #ruby("개|시","開|始")하기가 #ruby("체|면","體|面")이 서지 않았던지, #ruby("상|해","上|海")에서 #ruby("중|국|인","中|國|人")이 #ruby("일|본","日|本") #ruby("승|려","僧|侶") 한 #ruby("명","名")을 #ruby("타|살","打|殺")하였다는 #ruby("등","等"), 두 가지 #ruby("이|유","理|由")를 들어 #ruby("상|해|사|변","上|海|事|變")을 일으켰다.#footnote(numbering: _ => [7)])[#h(0.35em)1932#ruby("년","年") 1#ruby("월","月") 18#ruby("일","日") #ruby("상|해","上|海")에서 5#ruby("명","名")의 #ruby("승|려","僧|侶")가 #ruby("중|국|인","中|國|人") #ruby("무|뢰|배","無|賴|輩")에게 #ruby("습|격","襲|擊")당하여 1#ruby("명","名")이 #ruby("사|망","死|亡")하였다. #ruby("중|국|인","中|國|人")의 #ruby("습|격","襲|擊")은 #ruby("관|동|군","關|東|軍") #ruby("고|급|참|모","高|級|參|謀") #ruby("세이시","板垣征四郞"), #ruby("일|본","日|本") #ruby("공|사|관","公|使|館") #ruby("소|속","所|屬") #ruby("무|관","武|官")인 #ruby("다나카","田中隆吉") #ruby("등","等")의 #ruby("음|모","陰|謀")에 #ruby("의","依")한 것이었지만, #ruby("일|본","日|本")은 이를 핑계로 1#ruby("월","月") 28#ruby("일","日") #ruby("상|해|사|변","上|海|事|變")을 일으켰다. 이를 #ruby("송|호|전|쟁","淞|滬|戰|爭") 또는 1·28#ruby("전|쟁","戰|爭")이라고도 한다.] #ruby("왜","倭")는 #ruby("개|전|중","開|戰|中")이라 그런지 나를 #ruby("체|포","逮|捕")하려는 #ruby("적|극|적","積|極|的")인 움직임은 보이지 않았다. 그러나 #ruby("동|지","同|志")들은 #ruby("안|심","安|心")을 못하고, 나에게 먹고 자는 것도 #ruby("일|정","一|定")하게 하지 말라고 #ruby("당|부","當|付")하였다. 나는 낮에는 #ruby("행|동","行|動")을 쉬고, 밤#ruby("중","中")에는 #ruby("동|지","同|志")들의 집이나 #ruby("창|기","娼|妓")의 집에서 잤다. #ruby("식|사","食|事")는 #ruby("동|포","同|胞")의 집으로 찾아가면 누구나 ‘#ruby("단|사|호|장","簞|食|壺|漿")’#footnote(numbering: _ => [8)])[#h(0.35em)#ruby("원|문","原|文"): “單食壺漿”. 대나무로 만든 그릇에 밥을 담고, #ruby("장","醬")을 항아리에 넣었다는 말로, #ruby("군|사","軍|士")가 #ruby("입|성","入|城")할 때 #ruby("백|성","百|姓")들이 #ruby("음|식","飮|食")을 들고 #ruby("성","城") 밖까지 #ruby("환|영","歡|迎")을 나와 #ruby("대|접","待|接")한다는 뜻이다. #ruby("출|전","出|典"): 『#ruby("맹|자","孟|子")』.]으로 #ruby("정|성","精|誠")껏 #ruby("대|접","待|接")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|일|전|쟁","中|日|戰|爭")#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("중|일|전|쟁","中|日|戰|爭")은 #ruby("통|상","通|常") 1937#ruby("년","年") #ruby("노|구|교","盧|溝|橋") #ruby("사|건","事|件")으로 #ruby("시|작","始|作")된 #ruby("일|본","日|本")과 #ruby("중|국","中|國")#ruby("간","間")의 #ruby("전|면|전","全|面|戰")을 가리킨다. 그러나 여기서 말하는 #ruby("중|일|전|쟁","中|日|戰|爭")은 그것이 아니라 1932#ruby("년","年")의 #ruby("상|해|사|변","上|海|事|變")을 말한다.]이 #ruby("개|시","開|始")된 #ruby("후","後") 19#ruby("로|군","路|軍")의 #ruby("채|진|개","蔡|進|鍇")#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("원|문","原|文"): “蔡廷楷”. #ruby("채|정|해","蔡|廷|楷")는 #ruby("채|진|개","蔡|進|鍇")의 #ruby("오|류","誤|謬").] #ruby("군|대","軍|隊")와 #ruby("중|앙|군","中|央|軍")의 #ruby("제|5|군|장","第|五|軍|長") #ruby("장|치|중","張|治|中")이 #ruby("용|감","勇|敢")하게 싸워 #ruby("전|쟁","戰|爭")은 #ruby("격|렬","激|烈")하게 #ruby("전|개","展|開")되었다. 그런데 #ruby("일|본|군","日|本|軍")은 #ruby("상|해","上|海") #ruby("갑|북","閘|北")에서 불을 지르고는 #ruby("화|염","火|焰") 속에 #ruby("남|녀|노|유","男|女|老|幼")를 가리지 않고 모두 던져 넣어 #ruby("잔|인","殘|忍")하게 죽이는 #ruby("만|행","蠻|行")을 저질렀다. #ruby("참|혹","慘|酷")하여 차마 눈뜨고 볼 수 없는 #ruby("비|극","悲|劇")이 벌어졌다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地") 안에서도 곳곳에 #ruby("후|방|병|원","後|方|病|院")을 #ruby("설|립","設|立")하고, #ruby("전|사|병","戰|死|兵")의 #ruby("시|체","屍|體")와 #ruby("부|상|병","負|傷|兵")들을 트럭에 가득 실어 날랐다. 나무#ruby("판|자","板|子") 틈으로 붉은 피가 흘러나오는 것을 #ruby("목|격","目|擊")하고 가슴 가득한 #ruby("열|성","熱|誠")으로 #ruby("경|의","敬|意")를 #ruby("표","表")하니, 나도 모르게 눈물이 비오듯 흘러내렸다. 우리도 어느 때 저와 같이 #ruby("왜","倭")와 #ruby("혈|전","血|戰")을 벌여, #ruby("본|국","本|國") #ruby("강|산","江|山")을 #ruby("충|성","忠|誠")스런 피로 물들일 날이 있을까? 눈물이 쉴새없이 흘러내려, 길 가는 사람들이 #ruby("수|상","殊|常")하게 여길까 봐 그 자리를 물러났다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|경","東|京")의 #ruby("이|봉|창","李|奉|昌") #ruby("의|거","義|擧")가 #ruby("세|계","世|界")에 #ruby("전|파","傳|播")되자 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")·멕시코·쿠바의 우리 #ruby("동|포","同|胞")들 #ruby("중","中") 나를 #ruby("동|정","同|情")하던 #ruby("동|지","同|志")들은 크게 #ruby("흥|분","興|奮")되어, 나를 #ruby("애|호","愛|好")·#ruby("신|임","信|任")하는 #ruby("서|신","書|信")이 #ruby("태|평|양","太|平|洋")을 건너서 눈송이같이 날아들었다. 그#ruby("중","中")에는 #ruby("이|전","以|前")에 #ruby("임|시|정|부","臨|時|政|府")에 #ruby("반|대","反|對")하던 #ruby("동|지","同|志")들도 있었는데, 이제 #ruby("태|도","態|度")를 바꾸어 오히려 나를 #ruby("격|려","激|勵")해 주었다. #ruby("금|전|적","金|錢|的")인 #ruby("지|원","支|援")이 더욱 #ruby("광|범|위","廣|範|圍")하게 #ruby("전|개","展|開")되어, #ruby("중|국|전|쟁","中|國|戰|爭")에 #ruby("동|반","同|伴")하여 다시 우리 #ruby("민|족","民|族")을 빛낼 #ruby("사|업","事|業")을 하라는 #ruby("부|탁","付|託")이 #ruby("답|지","沓|至")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 목이 마르고 나서 우물 #ruby[파듯][臨渴掘井] #ruby("사|전","事|前") #ruby("준|비","準|備") 없이 무슨 일을 할 수 있으랴. 우리 #ruby("청|년","靑|年")들 #ruby("중","中")에는 #ruby("장","壯")한 뜻을 품고 #ruby("상|해","上|海")에 왔던, #ruby("친","親")하게 믿는 #ruby("지|사","志|士")요 #ruby("제|자","弟|子")인 #ruby("나|석|주","羅|錫|疇")·#ruby("이|승|춘","李|承|春") #ruby("등","等")이 있었다. #ruby("나","羅")#ruby("의|사","義|士")는 #ruby("총","銃")과 #ruby("폭|탄","爆|彈")을 품고 #ruby("연|전","年|前")에 #ruby("경|성","京|城")에 #ruby("잠|입","潛|入")하여 #ruby("동|양|척|식|회|사","東|洋|拓|殖|會|社")에 #ruby("침|입","侵|入"), #ruby("일|본|인","日|本|人") 7#ruby("명","名")을 #ruby("사|살","射|殺")한 #ruby("후","後") #ruby("자|살","自|殺")하였고, #ruby("이|승|춘","李|承|春")은 #ruby("천|진","天|津")에서 #ruby("체|포","逮|捕")되어 #ruby("사|형","死|刑")당하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("현|재","現|在") #ruby("상|해","上|海")에 #ruby("거|주","居|住")하는 믿을 만한 #ruby("청|년","靑|年") #ruby("중","中")에는 1#ruby("월","月") 28#ruby("일","日")에 #ruby("개|시","開|始")된 #ruby("상|해|사|변","淞|滬|戰|爭")을 #ruby("계|기","契|機")로, 우리 #ruby("민|족","民|族")에게 #ruby("영|광","榮|光")될 만한 #ruby("사|업","事|業")을 해보려는 #ruby("지|사","志|士")들도 있었다. 이들은 #ruby("왜|군","倭|軍")이 우리 #ruby("한|인","韓|人") #ruby("노|동|자","勞|動|者")를 #ruby("채|용","採|用")하는 것을 #ruby("계|기","契|機")로, 몇 #ruby("명","名")의 #ruby("청|년","靑|年")들과 #ruby("결|탁","結|託")하여 #ruby("홍|구","虹|口") #ruby("방|면","方|面")으로 가서 #ruby("일|본|군","日|本|軍") #ruby("부|역|노|동|자","賦|役|勞|動|者")가 되었다. 이들 #ruby("중","中") 몇 #ruby("명","名")은 #ruby("일|본|군","日|本|軍") #ruby("군|용|창|고","軍|用|倉|庫")에 #ruby("일|본|인","日|本|人") #ruby("노|동|자","勞|動|者")와 같이 어렵지 않게 #ruby("출|입","出|入")할 수 있게 되었다. 이들은 #ruby("폭|탄|창|고","爆|彈|倉|庫")와 #ruby("비|행|기","飛|行|機") #ruby("격|납|고","格|納|庫")를 #ruby("조|사","調|査")하고 그곳에 #ruby("연|소|탄","燃|燒|彈")을 #ruby("장|치","裝|置")하기로 #ruby("계|획","計|劃")을 세웠다. 그리하여 #ruby("왕|웅","王|雄")에게 #ruby("부|탁","付|託")하여 #ruby("상|해","上|海") #ruby("병|공|창","兵|工|廠")에 #ruby("교|섭","交|涉")하여 #ruby("연|소|탄","燃|燒|彈")을 #ruby("제|조","製|造")하기로 하고 날마다 그 #ruby("실|행","實|行")을 #ruby("재|촉","再|促")하였다. 그러던 #ruby("차","次")에 #ruby("중","中")·#ruby("일","日")#ruby("간","間")에 #ruby("송|호|협|정","淞|滬|協|定")이 #ruby("조|인","調|印")되는 바람에 그 #ruby("계|획","計|劃")은 #ruby("무|산","霧|散")되고 말았다. #ruby("협|정","協|定") #ruby("체|결","締|結")의 #ruby("중|국","中|國") #ruby("대|표","代|表")는 #ruby("곽|태|기","郭|泰|祺")였다.#footnote(numbering: _ => [11)])[#h(0.35em)#ruby("송|호|협|정","淞|滬|協|定")은 1932#ruby("년","年") 3#ruby("월","月") 14#ruby("일","日")부터 #ruby("협|상","協|商")이 #ruby("시|작","始|作")되어 5#ruby("월","月") 5#ruby("일","日") #ruby("체|결","締|結")되었다. #ruby("협|정","協|定") 3#ruby("개|조","個|條")에는 #ruby("중|국","中|國") #ruby("정|부","政|府")가 #ruby("항|일|운|동","抗|日|運|動")을 #ruby("단|속","團|束")한다는 #ruby("조|항","條|項")이 #ruby("포|함","包|含")되어 있다. #ruby("송|호|협|정","淞|滬|協|定")의 #ruby("중|국","中|國") #ruby("측","側") #ruby("대|표","代|表") #ruby("곽|태|기","郭|泰|祺")는 뒤에 #ruby("주|영","駐|英") #ruby("대|사","大|使")와 #ruby("중|국","中|國") #ruby("국|민|당","國|民|黨") #ruby("외|교|부|장","外|交|部|長") #ruby("등","等")을 #ruby("역|임","歷|任")하면서 #ruby("한|국","韓|國")의 #ruby("독|립|운|동","獨|立|運|動")에 많은 #ruby("영|향|력","影|響|力")을 #ruby("행|사","行|使")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 일을 몹시 #ruby("한|탄","恨|歎")하고 있던 #ruby("차","次")에 #ruby("열|혈","熱|血") #ruby("청|년","靑|年")들이 #ruby("비|밀|리","祕|密|裏")에 나를 #ruby("내|방","來|訪")하여, 나라일에 #ruby("헌|신","獻|身")할 터이니 알맞은 일감을 달라고 #ruby("간|청","懇|請")하였다. #ruby("동|경","東|京") #ruby("사|건","事|件")을 보고 #ruby("청|년","靑|年")들은 #ruby("생|각","生|覺")하기를 ‘#ruby("김|구","金|九")의 머리 속에는 #ruby("부|단","不|斷")히 무슨 #ruby("연|구","硏|究")가 있을 것’이라고 #ruby("생|각","生|覺")한 #ruby("모|양","模|樣")이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리하여 #ruby("이|덕|주","李|德|柱")#footnote(numbering: _ => [12)])[#h(0.35em)#ruby("이|덕|주","李|德|柱")\(1908〜1935). #ruby("독|립|운|동|가","獨|立|運|動|家"). #ruby("황|해|도","黃|海|道") #ruby("신|천","信|川") #ruby("출|신","出|身"). 1932#ruby("년","年") #ruby("초","初") #ruby("상|해","上|海") #ruby("한|인|청|년|당|원","韓|人|靑|年|黨|員")으로, #ruby("김|구","金|九")로부터 #ruby("유|진|식","兪|鎭|植") #ruby("등","等")과 함께 #ruby("조|선|총|독","朝|鮮|總|督")을 #ruby("살|해","殺|害")하라는 #ruby("지|시","指|示")를 받고 #ruby("국|내","國|內")에 들어와 #ruby("활|동","活|動")하던 #ruby("중","中") #ruby("일|본","日|本") #ruby("경|찰","警|察")에 잡혀 #ruby("징|역","懲|役") 7#ruby("년|형","年|刑")을 #ruby("언|도","言|渡")받고 #ruby("해|주|형|무|소","海|州|刑|務|所")에서 #ruby("복|역|중","服|役|中") #ruby("옥|사","獄|死")하였다.]·#ruby("유|진|식","兪|鎭|植")에게는 #ruby("왜|총|독","倭|總|督") #ruby("암|살","暗|殺")을 #ruby("명","命")하여 #ruby("선|발","選|拔")·#ruby("파|견","派|遣")하여 #ruby("입|국","入|國")하게 하고, #ruby("유|상|근","柳|相|根")#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("유|상|근","柳|相|根")\(1910〜1945). #ruby("독|립|운|동|가","獨|立|運|動|家"). #ruby("강|원|도","江|原|道") #ruby("통|천","通|川") #ruby("출|신","出|身"). 1932#ruby("년","年") 5#ruby("월","月") #ruby("김|구","金|九")의 #ruby("지|시","指|示")로 #ruby("대|련","大|連")에서 #ruby("한|인|애|국|단","韓|人|愛|國|團") #ruby("최|흥|식","崔|興|植")·#ruby("이|성|원","李|盛|元")·#ruby("이|성|발","李|盛|發") #ruby("등","等")과 함께 #ruby("일|본","日|本") #ruby("관|동|군","關|東|軍") #ruby("사|령|관","司|令|官")과 #ruby("남|만|철|도","南|滿|鐵|道") #ruby("총|재","總|裁") #ruby("등","等")을 #ruby("폭|살","爆|殺")하고자 #ruby("활|약","活|躍")하다 #ruby("일|본","日|本") #ruby("경|찰","警|察")에 잡혀 #ruby("무|기|징|역","無|期|懲|役")을 #ruby("언|도","言|渡")받았다. 그는 #ruby("대|련","大|連")·#ruby("여|순","旅|順") #ruby("감|옥","監|獄")에서 #ruby("복|역","服|役")하다 #ruby("광|복","光|復")을 하루 앞두고 #ruby("참|살","慘|殺")당했다.]·#ruby("최|흥|식","崔|興|植")#footnote(numbering: _ => [14)])[#h(0.35em)#ruby("최|흥|식","崔|興|植"). #ruby("생|몰|년","生|沒|年") #ruby("미|상","未|詳"). 서울 #ruby("출|신","出|身"). 1932#ruby("년","年") #ruby("유|상|근","柳|相|根") #ruby("등","等")과 함께 #ruby("일|본","日|本") #ruby("관|동|군","關|東|軍") #ruby("사|령|관","司|令|官")과 #ruby("남|만|철|도","南|滿|鐵|道") #ruby("총|재","總|裁") #ruby("폭|살","爆|殺")을 #ruby("시|도","試|圖")하였으나, #ruby("체|포","逮|捕")되어 #ruby("무|기|징|역","無|期|懲|役")을 #ruby("언|도","言|渡")받았다.]은 #ruby("만|주","滿|洲")의 #ruby("관|동|군","關|東|軍") #ruby("사|령|관","司|令|官") #ruby("혼|조","本|庄") #ruby("시게루","繁")#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("원|문","原|文"): “本臧番”. #ruby("일|본","日|本") #ruby("관|동|군","關|東|軍") #ruby("사|령|관","司|令|官") 이름. ‘本臧番’은 ‘本庄繁’의 #ruby("착|오","錯|誤").] #ruby("등","等")의 #ruby("암|살","暗|殺")을 #ruby("명","命")하여 #ruby("기|회","機|會")를 보아 #ruby("진|행","進|行")하고자 하였다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[3) #ruby("윤|봉|길","尹|奉|吉")과의 짧은 만남]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러던 어느날, #ruby("동|포","同|胞") #ruby("박|진","朴|震")의 #ruby("종|품","鬃|品")#ruby("공|장","工|場")#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("원|주","原|註"): “말총으로 帽子와 日用品을 만드는 工場”.]에서 #ruby("노|동|자","勞|動|者")로 일한 적이 있는 #ruby("윤|봉|길","尹|奉|吉")#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("윤|봉|길","尹|奉|吉")\(1908〜1932). #ruby("충|남","忠|南") #ruby("예|산","禮|山") #ruby("출|신","出|身"). #ruby("보|통|학|교","普|通|學|校")를 #ruby("중|퇴","中|退")하고 #ruby("한|학","漢|學")을 #ruby("독|학","獨|學")하였다. 1926#ruby("년","年") #ruby("중|국","中|國") #ruby("청|도","靑|島")로 #ruby("망|명","亡|命"), #ruby("백|범","白|凡")의 #ruby("한|인|애|국|단","韓|人|愛|國|團")에 #ruby("가|입","加|入")하여 #ruby("상|해","上|海") #ruby("홍|구|공|원","虹|口|公|園") #ruby("의|거","義|擧")를 일으켰다. #ruby("거|사","擧|事") #ruby("후","後") #ruby("체|포","逮|捕")되어 #ruby("오사카","大阪")로 #ruby("이|송","移|送")되어 #ruby("군|법|회|의","軍|法|會|議")에서 #ruby("사|형|선|고","死|刑|宣|告")를 받고 #ruby("순|국","殉|國")하였다.] #ruby("군","君")이 #ruby("홍|구|시|장","虹|口|市|場")에서 #ruby("채|소","菜|蔬")장사를 하다가 조용히 나를 찾아왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 #ruby("채|소","菜|蔬")바구니를 등 뒤에 메고 날마다 #ruby("홍|구","虹|口") #ruby("방|면","方|面")으로 다니는 것은 큰 뜻을 품고 #ruby("천|신|만|고","千|辛|萬|苦") 끝에 #ruby("상|해","上|海")에 온 #ruby("목|적","目|的")을 #ruby("달|성","達|成")하기 #ruby("위","爲")해서입니다. 그런데 #ruby("중|일|전|쟁","中|日|戰|爭")도 #ruby("중|국","中|國")에서 #ruby("굴|욕|적","屈|辱|的")으로 #ruby("정|전|협|정","停|戰|協|定")이 #ruby("성|립","成|立")되는 #ruby("형|세","形|勢")인즉, 아무리 #ruby("생|각","生|覺")해 보아도 마땅히 죽을 자리를 #ruby("구","求")할 수 없습니다. 그렇지만 #ruby("선|생","先|生")님께는 #ruby("동|경","東|京") #ruby("사|건","事|件")과 같은 #ruby("경|륜","經|綸")이 계실 줄 믿습니다. 저를 믿으시고 #ruby("지|도","指|導")하여 주시면 #ruby("은|혜","恩|惠")는 죽어도 잊지 못할 것입니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("종|전","從|前")에 #ruby("공|장","工|場") #ruby("구|경","求|景")을 다니며 #ruby("윤|군","尹|君")을 보고, 그가 #ruby("진|실","眞|實")한 #ruby("청|년","靑|年") #ruby("노|동|자","勞|動|者")로 #ruby("학|식","學|識")은 있으나 #ruby("생|활","生|活")을 #ruby("위","爲")해 #ruby("노|동","勞|動")을 하거니 #ruby("생|각","生|覺")하였다. 그런데 이제 마음을 터놓고 이야기해 보니 자신의 몸을 바쳐 큰 뜻을 이룰 #ruby("의","義")로운 #ruby("대|장|부","大|丈|夫")였다. 나는 #ruby("감|복","感|服")하여 다음과 같이 말하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“‘#ruby("뜻을 품으면 마침내 일을 이룬다","有志者 事竟成")’고 했으니 #ruby("안|심","安|心")하시오. 내가 요사이 #ruby("연|구","硏|究")하는 바가 있으나 마땅한 사람을 #ruby("구","求")하지 못해 #ruby("번|민","煩|悶")하던 참이었소. #ruby("전|쟁|중","戰|爭|中")에 #ruby("연|구","硏|究")·#ruby("실|행","實|行")코자 한 일이 있었으나 #ruby("준|비","準|備") #ruby("부|족","不|足")으로 #ruby("실|패","失|敗")하였소. 그런데 #ruby("지|금","只|今") #ruby("신|문","新|聞")을 보니 #ruby("왜","倭")놈이 #ruby("전|쟁","戰|爭")에 이긴 #ruby("위|세","威|勢")를 업고, 4#ruby("월","月") 29#ruby("일","日")에 #ruby("홍|구|공|원","虹|口|公|園")에서 이른바 #ruby("천|황","天|皇")의 #ruby("천|장|절","天|長|節") #ruby("경|축|식","慶|祝|式")#footnote(numbering: _ => [18)])[#h(0.35em)#ruby("일|본","日|本") #ruby("천|황","天|皇")의 #ruby("생|일","生|日")\(#ruby("천|장|절","天|長|節"))을 #ruby("축|하","祝|賀")하는 #ruby("의|식","儀|式").]을 #ruby("성|대","盛|大")하게 #ruby("거|행","擧|行")하며 #ruby("군|사|적","軍|事|的") #ruby("위|세","威|勢")를 크게 #ruby("과|시","誇|示")할 #ruby("모|양","模|樣")이오. 그러니 #ruby("군","君")은 #ruby("일|생","一|生")의 #ruby("대|목|적","大|目|的")을 이날에 #ruby("달|성","達|成")해 봄이 어떠하오?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이에 #ruby("윤|군","尹|君")은 #ruby("쾌","快")히 #ruby("응|낙","應|諾")하며 말하기를,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“저는 이제부터 가슴에 한 #ruby("점","點") #ruby("번|민","煩|悶")이 없어지고 마음이 #ruby("편|안","便|安")해집니다. #ruby("준|비","準|備")해 주십시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("자|기","自|己") #ruby("숙|소","宿|所")로 돌아갔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("운|퇴|뇌|굉|천|복|비|격","運|退|雷|轟|薦|福|碑|格")”#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("운","運")이 다하면 #ruby("천|복|비","薦|福|碑")에도 벼락친다”. #ruby("천|복|비","薦|福|碑")는 #ruby("복","福")을 비는 #ruby("비|석","碑|石"). #ruby("운","運")이 다하면 잘 되고자 하는 일도 도리어 #ruby("화","禍")가 된다는 #ruby("의|미","意|味"). 여기서는 #ruby("행|사","行|事")를 #ruby("안|내","案|內")하는 #ruby("일|본","日|本") #ruby("영|사|관","領|事|館")의 #ruby("포|고|문","布|告|文")이 도리어 #ruby("윤|의|사","尹|義|士")가 #ruby("거|사","擧|事")를 #ruby("단|행","斷|行")하는 데 도움이 된 것을 #ruby("지|적","指|摘")한 말이다.]고, #ruby("왜","倭")놈의 #ruby("상|해","上|海") #ruby("영|사|관","領|事|館")은 『#ruby("일|일|신|문","日|日|新|聞")』을 #ruby("통","通")하여 #ruby("자|기","自|己") #ruby("주|민","住|民")들에게 다음과 같이 #ruby("포|고","布|告")하였다.]
#quote-block[4#ruby("월","月") 29#ruby("일","日") #ruby("홍|구|공|원","虹|口|公|園")에서 #ruby("천|장|절","天|長|節") #ruby("축|하|식","祝|賀|式")을 #ruby("거|행","擧|行")한다. 그날 #ruby("식|장","式|場")에 #ruby("참|석","參|席")하는 #ruby("자","者")는 물#ruby("병","甁") 하나와 #ruby("점|심","點|心")으로 도시락, #ruby("일|본","日|本") #ruby("국|기","國|旗") 하나씩을 가지고 #ruby("입|장","入|場")하라.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("즉|시","卽|時") #ruby("서|문|로","西|門|路")의 #ruby("왕|웅","王|雄")\(#ruby("김|홍|일","金|弘|壹")) #ruby("군","君")을 #ruby("방|문","訪|問")하고 #ruby("상|해","上|海") #ruby("병|공|창|장","兵|工|廠|長") #ruby("송|식|표","宋|式|驫")에게 #ruby("교|섭","交|涉")하여, #ruby("일|본|인","日|本|人")들이 #ruby("사|용","使|用")하는 어깨에 메는 물#ruby("통","桶")과 도시락을 사서 보낼 터이니, 속에 #ruby("폭|탄","爆|彈")을 #ruby("장|치","裝|置")하여 3#ruby("일","日") #ruby("이|내","以|內")로 보내 달라고 #ruby("부|탁","付|託")하였다. #ruby("왕|군","王|君")이 돌아와서 #ruby("보|고","報|告")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("창|장","廠|長")이 #ruby("내|일","來|日") #ruby("오|전","午|前")에 #ruby("선|생","先|生")님을 모시고 #ruby("병|공|창","兵|工|廠")으로 와서 #ruby("선|생","先|生")님이 #ruby("친","親")히 #ruby("시|험","試|驗")하는 것을 눈으로 #ruby("확|인","確|認")해 보라고 하니, 같이 가십시다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 좋다고 #ruby("승|낙","承|諾")하고, 다음날 이른 아침 #ruby("강|남","江|南") #ruby("조|선|소","造|船|所")를 찾아갔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그곳 #ruby("내|부","內|部")에는 #ruby("일|부|분","一|部|分") #ruby("병|공|창","兵|工|廠")이 있는데, 그다지 #ruby("규|모","規|模")가 크지 않아서 #ruby("대|포","大|砲")나 #ruby("소|총","小|銃") #ruby("등","等")을 #ruby("수|리","修|理")하는 것이 #ruby("주","主")된 #ruby("임|무","任|務")인 듯했다. #ruby("기|사","技|師") #ruby("왕|백|수","王|伯|修")의 #ruby("영|도|하","領|導|下")에 물#ruby("통","桶")과 도시락, 두 #ruby("종|류","種|類")의 #ruby("폭|탄","爆|彈")을 #ruby("시|험","試|驗")하는 것을 #ruby("구|경","求|景")하였다. 마당 한곳에 #ruby("토|굴","土|窟")을 파고 네 #ruby("벽","壁")을 #ruby("철|판","鐵|板")으로 두른 후, 그 속에 #ruby("폭|탄","爆|彈")을 #ruby("장|치","裝|置")한다. 그런 #ruby("후","後") #ruby("뇌|관","雷|管") 끝에 긴 끈을 잇더니, 한 #ruby("명","名")이 끈 끝을 끌고 #ruby("수|십","數|十") #ruby("보","步") 밖으로 기어가서 노끈을 잡아당겼다. 그러자 #ruby("토|굴","土|窟") 속에서 #ruby("벽|력","霹|靂") 같은 소리가 #ruby("진|동","震|動")하며 #ruby("파|편","破|片")이 나는 것이 #ruby("일|대","一|大") #ruby("장|관","壯|觀")이었다. #ruby("시|험","試|驗") #ruby("법|칙","法|則")은, #ruby("뇌|관","雷|管") 20#ruby("개","個")를 #ruby("시|험","試|驗")하여 20#ruby("개","個") #ruby("전|부","全|部")가 #ruby("폭|발","爆|發")된 후라야 #ruby("실|물","實|物")에 #ruby("장|치","裝|置")하는 것이라 하는데, 이번 #ruby("시|험","試|驗")은 #ruby("성|적","成|績")이 #ruby("양|호","良|好")하다는 말을 듣고 나는 마음속으로 기뻐하였다.]
