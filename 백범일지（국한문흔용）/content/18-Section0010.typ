#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날이 4#ruby("월","月") 29#ruby("일","日")이다. 새벽에 #ruby("윤|군","尹|君")과 같이 #ruby("김|해|산","金|海|山")의 집에 가서, 마지막으로 #ruby("윤|군","尹|君")과 #ruby("식|탁","食|卓")을 같이하여 아침밥을 먹었다. #ruby("윤|군","尹|君")의 #ruby("기|색","氣|色")을 살피니 #ruby("태|연|자|약","泰|然|自|若")한 모습이었다. #ruby("농|부","農|夫")가 논밭일을 나가기 #ruby("위","爲")해 일찍 일어나, 자던 입에 일부러 밥 먹는 것을 보면 할 일이 얼마나 힘든 것인가를 알 수 있다.#footnote(numbering: _ => [24)])[#h(0.35em)#ruby("농|부","農|夫")가 힘든 일 나갈 때 아침밥을 잘 먹듯이, #ruby("윤|봉|길","尹|奉|吉")도 #ruby("대|사","大|事")를 앞두고 #ruby("태|연","泰|然")히 잘 먹는 것을 #ruby("비|유","比|喩")한 말이다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|해|산","金|海|山") #ruby("군","君")은 #ruby("윤|군","尹|君")의 #ruby("침|착","沈|着")하고 #ruby("용|감","勇|敢")한 #ruby("태|도","態|度")를 보고 조용히 나에게 이런 #ruby("권|고","勸|告")를 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님, #ruby("지|금","只|今") #ruby("상|해","上|海")는 우리의 #ruby("행|동","行|動")이 있어야 #ruby("민|족|적","民|族|的") #ruby("체|면","體|面")을 #ruby("보|전","保|全")할 수 있는 #ruby("상|황","狀|況")인데, #ruby("하|필","何|必")이면 왜 이런 #ruby("중|요","重|要")한 때 #ruby("윤|군","尹|君")을 구태여 다른 곳으로 #ruby("파|견","派|遣")하십니까?”]
