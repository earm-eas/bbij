#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海") #ruby("병|공|창","兵|工|廠")에서 이같이 #ruby("친|절","親|切")하게 20#ruby("여","餘") #ruby("개","個")의 #ruby("폭|탄","爆|彈")을 #ruby("무|료","無|料")로 #ruby("제|조","製|造")하여 주는 #ruby("원|인","原|因")이 무엇인가? 그것은 바로 #ruby("이|봉|창","李|奉|昌") #ruby("의|사","義|士")의 #ruby("은|혜","恩|惠") #ruby("덕|분","德|分")이라 할 수 있다. #ruby("창|장","廠|長")은 #ruby("자|기","自|己")네가 빌려주었던 #ruby("폭|탄","爆|彈")의 #ruby("능|력","能|力")이 #ruby("미|약","微|弱")하여 #ruby("일|본","日|本") #ruby("황|제","皇|帝")를 #ruby("폭|살","爆|殺")하지 못한 것을 #ruby("유|감","遺|憾")으로 #ruby("생|각","生|覺")하고 있었다. 그러던 차에 #ruby("김|구","金|九")가 다시 #ruby("요|구","要|求")한다고 하니 #ruby("성|심","誠|心")으로 #ruby("제|조","製|造")해 주는 것이었다. 다음날 그들은, #ruby("위|험","危|險")한 #ruby("폭|탄","爆|彈")을 우리가 #ruby("운|반","運|搬")하기 #ruby("곤|란","困|難")하리라는 것을 알고, #ruby("병|공|창","兵|工|廠") #ruby("자|동|차","自|動|車")로 #ruby("서|문|로","西|門|路") #ruby("왕|웅","王|雄") #ruby("군","君")의 집으로 가져다 주었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 일을 마친 #ruby("후","後") 나는 거지 #ruby("복|색","服|色")인 #ruby("중|국","中|國")옷을 벗어버리고 넝마#ruby("전","廛")에 가서 #ruby("양|복","洋|服") 한 벌을 사서 갈아입었다. 그러고 보니 나도 #ruby("엄|연","儼|然")한 #ruby("신|사","紳|士")라. 물#ruby("통","桶")과 도시락을 한 #ruby("개","個")씩, 두 #ruby("개","個")씩 #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지|내","租|界|地|內") #ruby("친","親")한 #ruby("동|포","同|胞")들의 집으로 #ruby("운|반","運|搬")하였다. 이렇게 옮긴 #ruby("폭|탄","爆|彈")을 #ruby("주|인","主|人")도 몰라보도록, “#ruby("귀","貴")한 #ruby("약|품","藥|品")이니 불만 #ruby("조|심","操|心")하게”라고 #ruby("부|탁","付|託")하고, 까마귀 떡 감추듯 하였다.#footnote(numbering: _ => [20)])[#h(0.35em)까마귀가 다른 새의 알을 물어다 여기저기 감추어 두고는 나중에는 어디에다 두었는지 모르는 데서 비롯된 말. #ruby("원|래","元|來")는 #ruby("정|신","精|神") 없이 일하고 나중에 잊어버리는 사람을 #ruby("비|유","比|喩")한 말이지만, 여기서는 #ruby("주|인","主|人")도 모르게 잘 감추었다는 #ruby("의|미","意|味")다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|경","東|京") #ruby("사|건","事|件") #ruby("이|후","以|後") 우리 #ruby("동|포","同|胞")들의 나에 #ruby("대","對")한 #ruby("동|정","同|情")은 #ruby("비","比")할 데 없이 깊었다. #ruby("본|국","本|國") #ruby("풍|속","風|俗")이면 #ruby("내|외","內|外")할 #ruby("처|지","處|地")이지만, 오랜 #ruby("해|외|생|활","海|外|生|活")에 #ruby("형|제","兄|弟")·#ruby("친|척","親|戚")과 같아서 #ruby("남|자","男|子")들보다 #ruby("부|인","夫|人")들이 더욱 나를 #ruby("애|호","愛|好")하였다. 어느 집에 가든지,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님, 아이 좀 안아주시오. 내 맛있는 #ruby("음|식","飮|食") 해드리리다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. 내가 아이를 안아주면 아이들이 잘 잔다고 하여, #ruby("부|인","夫|人")들은 아이가 울면 내게 안겨주었다. 그런 까닭에 #ruby("음|식","飮|食") #ruby("박|대","薄|待")는 받지 않았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러는 가운데 #ruby("운|명","運|命")의 날, 4#ruby("월","月") 29#ruby("일","日")이 #ruby("점|점","漸|漸") #ruby("임|박","臨|迫")하였다. #ruby("윤|봉|길","尹|奉|吉") #ruby("군","君")은 말쑥하게 #ruby("일|본|식","日|本|式") #ruby("양|복","洋|服")으로 갈아입고, 날마다 #ruby("홍|구|공|원","虹|口|公|園")으로 나가 #ruby("식|장","式|場") #ruby("설|치","設|置")하는 것을 살펴보며 #ruby("거|사","擧|事")할 #ruby("위|치","位|置")를 #ruby("점|검","點|檢")하였다. 또한 #ruby("시라카와","白川") #ruby("대|장","大|將")의 #ruby("사|진","寫|眞")을 #ruby("구","求")하고 #ruby("일|장|기","太|陽|旗")를 #ruby("마|련","磨|鍊")하였다. 그리고는 자신이 보고들은 것을 나에게 #ruby("보|고","報|告")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘 #ruby("홍|구","虹|口")에 가서 #ruby("식|장","式|場") #ruby("설|비","設|備")를 #ruby("구|경","求|景")하는데 #ruby("시라카와","白川") 놈도 왔습디다. 제가 그놈 곁에 섰을 때 ‘어떻게 #ruby("내|일","來|日")까지 기다리나. 오늘 #ruby("폭|탄","爆|彈")을 가졌더라면 이 자리에서 #ruby("당|장","當|場") 쳐죽일 텐데’ 하는 #ruby("생|각","生|覺")이 문득 들었습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 말을 듣고 나는 #ruby("윤|군","尹|君")에게 이렇게 #ruby("주|의","注|意")시켰다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여보, 그것이 무슨 말이오? 사냥#ruby("포|수","砲|手") #ruby("치","雉")를 #ruby("사","射")할 #ruby("시","時")에 #ruby("타|비","打|飛")하게 하고 #ruby("사|락","射|落")함과 #ruby("임|하|숙|록","林|下|宿|鹿")을 #ruby("불|사","不|射")하고 #ruby("타|주|시","打|走|時")에 #ruby("사|격","射|擊")하는 것은 #ruby("쾌|미","快|味")를 #ruby("위","爲")함이니.#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("포|수","砲|手")가 꿩을 쏠 때에도 날게 하고 쏘아 떨어뜨리고, 숲 속에서 자고 있는 사슴은 달리게 한 #ruby("후","後") 쏘는 것이 사냥의 #ruby("진|정","眞|正")한 맛이오”.] #ruby("군","君")이 #ruby("지|금","只|今") 그러는 것은 #ruby("내|일","來|日") #ruby("거|사","擧|事")에 #ruby("성|공","成|功")할 #ruby("자|신|감","自|信|感")이 #ruby("미|약","微|弱")하기 때문이 아니오?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아닙니다. 그놈이 내 곁에 선 것을 보았을 때 #ruby("홀|연","忽|然")히 그런 #ruby("생|각","生|覺")이 나더란 말입니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("윤|군","尹|君")을 #ruby("안|심","安|心")시키기 #ruby("위","爲")하여 다음 말을 건네주었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 이번 #ruby("거|사","擧|事")가 #ruby("확|실","確|實")히 #ruby("성|공","成|功")할 것을 미리 알고 있소. #ruby("군","君")이 #ruby("일|전","日|前")에 하던 말씀 #ruby("중","中") 이제는 가슴의 #ruby("번|민","煩|悶")이 그치고 #ruby("편|안","便|安")해진다는 것은 #ruby("성|공","成|功")의 #ruby("확|실","確|實")한 #ruby("증|거","證|據")라 믿소. 돌이켜보면 내가 #ruby("치|하|포","鴟|河|浦")에서 #ruby("쓰치다","土田")를 죽이려 했을 때 가슴이 몹시 울렁거렸지만, #ruby("고|능|선","高|能|善") #ruby("선|생","先|生")이 가르쳐 주신 ‘#ruby("득|수|반|지|무|족|기","得|樹|攀|枝|無|足|奇") #ruby("현|애|살|수|장|부|아","懸|崖|撒|手|丈|夫|兒")’란 #ruby("구|절","句|節")을 떠올리니 마음이 가라앉았소. #ruby("군|아","君|我")의 #ruby("결|심|행|사","決|心|行|事")가 #ruby("요|요|상|동","遙|遙|相|同")한 까닭이오.”#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("군","君")과 내가 #ruby("거|사","擧|事")하는 #ruby("심|정","心|情")은 서로 같은 것 아니겠소?”]]
