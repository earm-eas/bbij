#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내 #ruby("육|십","六|十") #ruby("평|생","平|生")을 #ruby("회|고","回|顧")하면 너무도 #ruby("상|식","常|識")에 벗어나는 일이 한두 가지가 아니다. #ruby("대|개","大|槪") 사람이 #ruby("귀","貴")하면 #ruby("궁","窮")함이 없겠고 #ruby("궁","窮")하면 #ruby("귀","貴")함이 없을 것이나, 나는 #ruby("귀","貴")해도 #ruby("궁|하|고","貴|亦|窮") #ruby("궁","窮")해도 #ruby[궁한][窮亦窮] #ruby("일|생","一|生")을 지냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("국|가","國|家")가 #ruby("독|립","獨|立")을 하면 #ruby("삼|천|리","三|千|里") #ruby("강|산","江|山")이 다 내 것이 될는지 모르겠으나, #ruby("천|하","天|下")의 넓고 큰 #ruby("지|구|면","地|球|面")에 한 치의 땅, #ruby("반","半") 칸의 집도 내 #ruby("소|유","所|有")가 없다. #ruby("과|거","過|去")에는 #ruby("영|욕","榮|辱")의 #ruby("심|리","心|理")를 가지고 #ruby("궁","窮")을 #ruby("면","免")하려고 버둥거려 보기도 하고, #ruby[독장수셈][瓮算]#footnote(numbering: _ => [23)])[#h(0.35em)#ruby("옹|기","甕|器")장수가 잠이 들어 꿈에 큰 #ruby("부|자","富|者")가 되어 좋아서 뛰는 바람에 지게를 걷어차 독이 모두 깨어졌다는 #ruby("고|사","故|事")에서 온 말. 부질없는 헛된 #ruby("계|산","計|算")을 말한다.]도 많이 하여 보았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("지|금","只|今")에 이르러서는 이런 생각을 한다. 옛날에 #ruby("한|유","韓|愈")는 「#ruby("송|궁|문","送|窮|文")」#footnote(numbering: _ => [24)])[#h(0.35em)#ruby("한|유","韓|愈")는 #ruby("당|송","唐|宋") #ruby("팔|대|가","八|大|家")의 하나로 #ruby("저|명","著|名")한 #ruby("문|장|가","文|章|家"). 그는 811#ruby("년","年")\(44#ruby("세","歲")) #ruby("정|초","正|初")에 「#ruby("송|궁|문","送|窮|文")」을 지어 다섯 가지 가난 #ruby("귀|신","鬼|神")을 쫓아버리고자 하였으나, #ruby("귀|신","鬼|神")들의 이야기를 듣고 나서 오히려 그들을 #ruby("상|좌","上|座")에 모시고 살기로 했다는 글이다. #ruby("역|경","逆|境")을 견디며 #ruby("자|신","自|身")의 #ruby("신|념","信|念")을 지키고자 하는 #ruby("결|의","決|意")를 #ruby("우|화|적","寓|話|的")으로 다짐하는 글이다.]을 지었다지만 나는 「#ruby("우|궁|문","友|窮|文")#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("궁","窮")함을 떨쳐 보낼 수 없기 때문에 차라리 벗하며 살겠다는 뜻.]을 짓고 싶으나 #ruby("문|장","文|章")이 아니므로 그것도 할 수 없다. #ruby("자|식","子|息")들에게 #ruby("대","對")하여도 아비된 #ruby("의|무","義|務")를 조금도 못하였으므로 내가 아비라 하여 #ruby("자|식","子|息")되니 #ruby("의|무","義|務")를 하여 주기도 #ruby("원","願")치 않는다. 너희들은 #ruby("사|회","社|會")의 #ruby("은|택","恩|澤")을 입어서 먹고 입고 배우는 터이니, #ruby("사|회","社|會")의 아들이라는 #ruby("심|정","心|情")으로 #ruby("사|회","社|會")를 #ruby("부|모","父|母")처럼 #ruby("효","孝")로 섬기면 내 #ruby("소|망","所|望")은 이에서 더 #ruby("만|족","滿|足")이 없을 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|미|년","己|未|年")\(1919, 44#ruby("세","歲")) 2#ruby("월","月") 26#ruby("일","日")#footnote(numbering: _ => [26)])[#h(0.35em)#ruby("기|미|년","己|未|年")\(1919) 2#ruby("월","月") 26#ruby("일","日")은 #ruby("양|력","陽|曆")으로 3#ruby("월","月") 27#ruby("일","日")이며, #ruby("백|범","白|凡")이 #ruby("안|악","安|岳")에서 #ruby("중|국","中|國")으로 #ruby("출|발","出|發")한 날은 이틀 뒤인 3#ruby("월","月") 29#ruby("일","日")이다.]이 어머님 #ruby("환|갑","還|甲")이었으므로, #ruby("약|간","若|干")의 술과 #ruby("안|주","按|酒")를 #ruby("마|련","磨|鍊")하여 #ruby("친|구","親|舊")들이나 모으고 #ruby("축|하|연","祝|賀|宴")이나 하자고 아내와 #ruby("의|논","議|論")을 하고 #ruby("진|행","進|行")하려는데, 이 눈치를 아시고 어머님은 #ruby("극","極")히 말리셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 1#ruby("년","年") #ruby("추|수","秋|收")만 더 지내도 좀 #ruby("생|활","生|活")이 나을 터이니, 한다면 네 #ruby("친|구","親|舊")들을 다 #ruby("청","請")하여 하루 놀아야 하지 않느냐? 네가 #ruby("곤|란","困|難")한 #ruby("중","中")에서 무엇을 #ruby("준|비","準|備")한다면 도리어 내 마음이 #ruby("불|안","不|安")하니 다음으로 미루라.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하시므로 이루지 못했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[며칠이 지나지 않아 내가 나라를 떠나게 되고 그#ruby("후","後") 어머님께서도 #ruby("상|해","上|海")에 오셨으나, #ruby("공|적","公|的")이든 #ruby("사|적","私|的")이든 어려운 #ruby("경|제","經|濟") #ruby("여|건","與|件")으로도 #ruby("불|가|능","不|可|能")하였지만, #ruby("설|사","設|使") #ruby("역|량","力|量")이 있다 하여도 #ruby("독|립|운|동","獨|立|運|動")을 하다 목숨 잃고 집안 #ruby[망하는][殺身亡家] #ruby("동|포","同|胞")들이 #ruby("매|일","每|日") #ruby("수|십","數|十") #ruby("수|백","數|百")이란 #ruby("비|참","悲|慘")한 #ruby("소|식","消|息")을 듣고 앉아서, 어머님을 #ruby("위","爲")하여 #ruby("수|연","壽|宴")을 #ruby("준|비","準|備")할 #ruby("용|기","勇|氣")부터 없었다. 그러므로 내 #ruby("생|일","生|日") 같은 것은 입 밖에 내지않고 지냈는데, #ruby("민|국","民|國") 8#ruby("년","年")\(1926) #ruby("나|석|주","羅|錫|疇")가 #ruby("식|전","食|前")에 많은 #ruby("양","量")의 고기와 #ruby("채|소","菜|蔬")를 사 가지고 와서 어머님에게 드렸다.#footnote(numbering: _ => [27)])[#h(0.35em)1925#ruby("년","年") 11#ruby("월","月") #ruby("곽|낙|원","郭|樂|園") #ruby("여|사","女|士")가 #ruby("본|국","本|國")으로 돌아갔고, #ruby("나|석|주","羅|錫|疇") 또한 #ruby("상|해","上|海")를 떠나 #ruby("북|경","北|京")으로 갔다. 따라서 #ruby("나|석|주","羅|錫|疇")가 차려준 #ruby("백|범","白|凡")의 #ruby("생|일","生|日")은 1926#ruby("년","年")이 아니라, 1925#ruby("년","年") 7#ruby("월","月") 11#ruby("일","日")\(#ruby("양|력","陽|曆") 8#ruby("월","月") 29#ruby("일","日"))이다. 1919#ruby("년","年") #ruby("상|해","上|海") #ruby("망|명","亡|命") #ruby("후","後") #ruby("나|석|주","羅|錫|疇")는 #ruby("임|시|정|부","臨|時|政|府")에서 #ruby("백|범","白|凡")이 맡은 #ruby("경|무|국","警|務|局")의 #ruby("경|호|원","警|護|員")으로 일한 적이 있고, 1923#ruby("년","年") #ruby("중|국","中|國") #ruby("육|군|군|관|강|습|소","陸|軍|軍|官|講|習|所")에 #ruby("입|교","入|校")하여 이듬해 #ruby("중|국|군","中|國|軍") #ruby("장|교","將|校")로 #ruby("복|구","復|舊")하였다. 1925#ruby("년","年") 그는 #ruby("상|해","上|海")로 돌아왔다가 1926#ruby("년","年") #ruby("북|경","北|京")으로 가 #ruby("의|열|단","義|烈|團")에 #ruby("입|단","入|團")하였다. 그해 #ruby("본|국","本|國")으로 들어가 12#ruby("월","月") 28#ruby("일","日") #ruby("식|산|은|행","殖|産|銀|行")과 #ruby("동|양|척|식|회|사","東|洋|拓|殖|會|社")에 #ruby("폭|탄","爆|彈")을 #ruby("투|척","投|擲")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“오늘의 #ruby("선|생","先|生")님 #ruby("생|신","生|辰")이 아닙니까? 돈은 없고 해서, #ruby("의|복","衣|服")을 #ruby("전|당","典|當")하여 고기#ruby("근","斤")이나 좀 사 가지고 밥해 먹으러 왔습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[가장 #ruby("영|광","榮|光")스러운 #ruby("대|접","待|接")을 받은 것을 #ruby("영|원","永|遠")히 #ruby("기|념","紀|念")할 #ruby("결|심","決|心")과, 어머님에게 너무도 #ruby("죄|송","罪|悚")하여, 내 죽는 날까지 내 #ruby("생|일","生|日")을 #ruby("기|념","紀|念")하지 않기로 하고 날짜를 #ruby("기|입","記|入")하지 아니한다.#footnote(numbering: _ => [28)])[#h(0.35em)『#ruby("백|범|일|지","白|凡|逸|志")』 #ruby("상|권","上|卷") 앞부분에 #ruby("백|범","白|凡")이 #ruby("자|신","自|身")의 #ruby("생|일","生|日")을 #ruby("기|록","記|錄")한 것은 나중에 새로 #ruby("정|리","整|理")한 것이다. 아마도 어머님이 돌아가셨기 때문에 #ruby("사|정","事|情")이 #ruby("변","變")했다고 #ruby("판|단","判|斷")한 듯하다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海")에서 #ruby("인|천","仁|川")의 #ruby("소|식","消|息")을 듣건대, #ruby("박|영|문","朴|永|文")은 #ruby("별|세","別|世")하였고 #ruby("안|호|연","安|浩|然")은 #ruby("생|존","生|存")하였다 하기로, 믿을 만한 #ruby("편","便")에 #ruby("회|중|시|계","懷|中|時|計") 한 #ruby("개","個")를 사서 보내며 나의 #ruby("행|적","行|蹟")을 #ruby("전","傳")해 달라고 #ruby("부|탁","付|託")하였으나 아직 #ruby("답|변","答|辯")이 없다. #ruby("성|태|영","成|泰|英")은 #ruby("그|간","其|間") #ruby("길|림","吉|林")에 #ruby("내|왕","來|往")하였으므로 #ruby("통|신","通|信")을 하였다. #ruby("유|완|무","柳|完|茂")는 #ruby("북|간|도","北|間|島")에서 누구에게 #ruby("피|살","被|殺")되었고 아들 #ruby("한|경","漢|卿")은 아직 #ruby("북|간|도","北|間|島")에서 살고 있다 한다. #ruby("이|종|근","李|種|根")은 러시아 #ruby("여|자","女|子")를 아내로 맞아 #ruby("상|해","上|海")에 와서 #ruby("종|종","種|種") 만나보았다. #ruby("김|형|진","金|亨|鎭") #ruby("유|족","遺|族")의 #ruby("소|식","消|息")은 아직 듣지 못하였고, #ruby("김|경|득","金|卿|得") #ruby("유|족","遺|族")은 #ruby("탐|문","探|問") #ruby("중","中")이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 지나온 #ruby("기|록","記|錄") #ruby("중","中")에 #ruby("연|월|일|자","年|月|日|字")를 #ruby("기|입","記|入")한 것은, 나는 #ruby("기|억","記|憶")하지 못하겠으므로 #ruby("본|국","本|國")의 어머님에게 #ruby("서|신","書|信")으로 물어서 쓴 것이다.#footnote(numbering: _ => [29)])[#h(0.35em)『#ruby("백|범|일|지","白|凡|逸|志")』가 이러한 #ruby("열|악","劣|惡")한 #ruby("조|건","條|件")에서 #ruby("집|필","執|筆")되었다는 것을 #ruby("감|안","勘|案")하면, #ruby("일|지","日|誌")의 #ruby("연|월|일","年|月|日")은 다른 #ruby("자|료","資|料")와 #ruby("비|교","比|較")하여 #ruby("확|인","確|認")해야만 #ruby("확|실","確|實")하다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내 #ruby("일|생","一|生")에서 #ruby("제|일","第|一") #ruby("행|복","幸|福")이라 할 것은 #ruby("기|질","氣|質")이 튼튼한 것이다. 거의 5#ruby("년","年")의 #ruby("감|옥","監|獄") #ruby("고|역","苦|役")에 하루도 #ruby("병","病")으로일 못한 적 없었고, #ruby("인|천|감|옥","仁|川|監|獄")에서 #ruby("학|질","瘧|疾")에 걸려 #ruby("반","半")나절 동안 #ruby("역","役")을 쉰 적이 있을 뿐이다. #ruby("병|원","病|院")이란 곳에는 혹을 떼러 #ruby("제|중|원","濟|衆|院")에 1#ruby("개|월","個|月"), #ruby("상|해","上|海")에 온 #ruby("후","後") #ruby("서|반|아|감|기","西|班|牙|感|氣")로 20#ruby("일","日") 동안 #ruby("치|료","治|療")한 것뿐이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|미|년","己|未|年")에 #ruby("중|국","中|國")으로 건너온 #ruby("이|후","以|後") #ruby("지|금","只|今")까지 10#ruby("여","餘") #ruby("년","年"), #ruby("그|간","其|間") 지내온 일에 비하여 #ruby("중|요","重|要")하고도 #ruby("진|기","珍|奇")한 #ruby("사|실","事|實")이 많으나, #ruby("독|립","獨|立") #ruby("이|전","以|前")에는 #ruby("절|대","絶|對") #ruby("비|밀","祕|密")로 할 것이므로 너희들에게 알려주지 못함이 #ruby("극","極")히 #ruby("유|감","遺|憾")이다. #ruby("이|해","理|解")하여 주기를 바라고 이만 그친다.]
