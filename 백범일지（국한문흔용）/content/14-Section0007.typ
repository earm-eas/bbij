#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|상","以|上") 몇 #ruby("조","條")를 #ruby("선|포","宣|布")한 #ruby("후","後")에 #ruby("동|산|평","東|山|坪")에 #ruby("소|학|교","小|學|校")를 #ruby("설|립","設|立")하여, #ruby("교|사","敎|師") 한 #ruby("명","名")을 #ruby("초|빙","招|聘")하고 #ruby("학|생","學|生") 20#ruby("여","餘") #ruby("명","名")을 #ruby("모|집","募|集")하여 #ruby("개|학","開|學")하였다. #ruby("교|원","敎|員")이 #ruby("부|족","不|足")하므로 나도 #ruby("시|간","時|間")으로 #ruby("교|과","敎|科")를 #ruby("담|당","擔|當")하였다. 이제 #ruby("소|작|인","小|作|人")으로 #ruby("토|지","土|地")를 #ruby("청|구","請|求")하고자 하는 자는 #ruby("학|부|형","學|父|兄")이 아니면 말 붙이기가 어렵게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("여|전","如|前")히 #ruby("전|감|관","前|監|官") #ruby("노|형|극","盧|亨|極") 5, 6#ruby("형|제","兄|弟")는 따르지 않고 내 #ruby("방|침","方|針")과 #ruby("농|정","農|政")을 #ruby("반|대","反|對")하는 #ruby("입|장","立|場")에 있었다. #ruby("노|가","盧|家") #ruby("형|제","兄|弟")의 #ruby("소|작|지","小|作|地")는 #ruby("평|내","坪|內")에서 #ruby("상|등|지","上|等|地")였다. 그 #ruby("토|지","土|地") #ruby("전|부","全|部")의 #ruby("소|작|권","小|作|權")을 #ruby("회|수","回|收")하겠다는 #ruby("통|지","通|知")를 보내어 놓고, #ruby("학|부|형","學|父|兄")에게 #ruby("분|배","分|配")하고자 하나 한 #ruby("명","名")도 감히 #ruby("경|작","耕|作")하겠다는 사람이 없었다. #ruby("이|유","理|由")를 물으니 #ruby("노|가","盧|家")의 #ruby("위|세","威|勢")를 두려워함이었다. 내 #ruby("소|작|지","小|作|地")를 #ruby("대|신","代|身") #ruby("분|배","分|配")해 주고, #ruby("노|가","盧|家")에게 #ruby("회|수","回|收")한 #ruby("농|지","農|地")를 내가 #ruby("경|작","耕|作")하기로 하였다.]
