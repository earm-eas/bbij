#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|용|승","金|庸|昇") #ruby("진|사","進|士")가 이름짓기를 맡아 #ruby("김|린","金|麟")이라 한 것을, #ruby("왜","倭")의 #ruby("민|적","民|籍")에 #ruby("등|록","登|錄")된 까닭에 #ruby("인","仁")으로 고쳤다.]
