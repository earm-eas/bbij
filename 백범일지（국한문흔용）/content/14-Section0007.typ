#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("인","仁")이 난 지 석 달, 구름 끼어 어두웠던 겨울 추위가 지나고 따사한 #ruby[봄바람][陽春和風]이 부는 #ruby("기|미|년","己|未|年")\(1919, 44#ruby("세","歲")) 2#ruby("월","月")이 돌아왔다.#footnote(numbering: _ => [8)])[#h(0.35em)여기서 2#ruby("월","月")은 #ruby("음|력","陰|曆")이다. #ruby("참|고","參|考")로 #ruby("기|미|년","己|未|年")\(1919) 3#ruby("월","月") 1#ruby("일","日")은 #ruby("음|력","陰|曆")으로 1#ruby("월","月") 29#ruby("일","日")이다.] #ruby("청|천|벽|력","靑|天|霹|靂")과 같이 #ruby("경|성","京|城") #ruby("탑|동|공|원","塔|洞|公|園")에서는 #ruby("독|립|만|세","獨|立|萬|歲") 소리가 일었고, #ruby("독|립|선|언|서","獨|立|宣|言|書")가 #ruby("각","各") #ruby("지|방","地|方")에 #ruby("배|포","配|布")되자 #ruby("평|양","平|壤")·#ruby("진|남|포","鎭|南|浦")·#ruby("신|천","信|川")·#ruby("안|악","安|岳")·#ruby("온|정","溫|井")·#ruby("문|화","文|化") #ruby("각|지","各|地")에서 벌써 #ruby("인|민","人|民")이 #ruby("궐|기","蹶|起")하여 #ruby("만|세","萬|歲")를 부르고, #ruby("안|악","安|岳")에서도 #ruby("계|획","計|劃")하고 #ruby("준|비","準|備")하던 때였다.#footnote(numbering: _ => [7)])[#h(0.35em)이 #ruby("절","節")은 #ruby("하|권","下|卷")과 #ruby("내|용","內|容")이 많이 #ruby("중|복","重|複")된다.]]
