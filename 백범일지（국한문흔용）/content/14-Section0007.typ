#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("독|립","獨|立")은 벌써 되었지요. 아직 #ruby("왜","倭")가 물러가지만 않은 것뿐이니 #ruby("전|국","全|國")의 #ruby("인|민","人|民")이 다 떠들고 일어나 #ruby("만|세","萬|歲")를 부르면 #ruby("왜","倭")놈이 #ruby("자|연","自|然")히 쫓겨나고야 말지요.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 말하기도 했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런 이야기에 배고픈 것도 잊고 #ruby("신|의|주|역","新|義|州|驛")에 #ruby("하|차","下|車")하였다. 그 #ruby("전","前")날에 #ruby("신|의|주","新|義|州")에서 #ruby("만|세","萬|歲")를 부르고 21#ruby("명","名")이 #ruby("구|금","拘|禁")되었다 한다. #ruby("개|찰|구","改|札|口")에 #ruby("왜","倭")놈이 지키고 #ruby("여|객","旅|客")을 #ruby("엄|밀","嚴|密")히 #ruby("검|사","檢|査")한다. 나는 아무 짐보따리도 없이 #ruby("수|건","手|巾")에 #ruby("여|비","旅|費")만 싸서 #ruby("요|대","腰|帶")에 잡아매었다. 어떤 #ruby("물|건","物|件")이냐 물어서 돈이라 하였고, 무엇 하는 사람이냐 물어서 #ruby("재|목|상","材|木|商")이라 하였다. #ruby("왜","倭")놈은]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("재|목","材|木")이 사람이야?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하더니 가라고 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("신|의|주","新|義|州") #ruby("시|내","市|內")에 들어가 #ruby("요|기","療|飢")를 하며 #ruby("공|기","空|氣")를 살펴보니 그곳 #ruby("역|시","亦|是") #ruby("흉|흉","洶|洶")하였다. 오늘밤에 또 #ruby("만|세","萬|歲") 부르자고 아까 #ruby("통|지","通|知")가 돌았다는 둥 술렁술렁한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("중|국|인","中|國|人")의 #ruby("인|력|거","人|力|車")를 불러 타고 바로 큰 다리 위로 지나서 #ruby("안|동|현","安|東|縣")의 어떤 #ruby("여|관","旅|館")에서 #ruby("변|성|명","變|姓|名")하고 #ruby[좁쌀장수][小米商]라 하고서 7#ruby("일","日")을 #ruby("경|과","經|過")한 뒤, #ruby("이|륭|양|행","怡|隆|洋|行")#footnote(numbering: _ => [12)])[#h(0.35em)아일랜드 출신의 #ruby("영|국|인","英|國|人") 테러리스트 죠지 쇼우(L. S. Jeorge)가 #ruby("운|영","運|營")하는 #ruby("선|박|회|사","船|舶|會|社"). 그는 #ruby("외|국|인","外|國|人")이란 #ruby("신|분","身|分")을 #ruby("이|용","利|用")하여 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("통|신|연|락","通|信|連|絡")과 #ruby("인|원","人|員") 및 #ruby("물|자","物|資") #ruby("수|송","輸|送")을 #ruby("적|극","積|極") 도와주었다.]의 배를 타고 #ruby("상|해","上|海")로 #ruby("출|발","出|發")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|해|안","黃|海|岸")을 지나갈 때 #ruby("일|본","日|本") #ruby("경|비|선","警|備|船")이 #ruby("나|팔","喇|叭")을 불고 따라오며 배를 세울 것을 #ruby("요|구","要|求")하나 #ruby("영|국|인","英|國|人") #ruby("선|장","船|長")은 들은 체도 아니하고 #ruby("전|속|력","全|速|力")으로 #ruby("경|비|구|역","警|備|區|域")을 지나서 4#ruby("일","日") #ruby("후","後") #ruby("무|사","無|事")히 #ruby("포|동","浦|東") #ruby("선|창","船|艙")#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("황|포|강","黃|浦|江")과 바다가 만나는 #ruby("상|해","上|海")의 #ruby("연|해|지|역","沿|海|地|域"). #ruby("포|동","浦|東")은 100#ruby("년","年") #ruby("전","前")부터 #ruby("번|창","繁|昌")한 #ruby("항|구|지|역","港|口|地|域")이었고, #ruby("지|금","只|今")은 #ruby("중|국","中|國")의 #ruby("첨|단|산|업|기|지","尖|端|産|業|基|地")를 #ruby("위","爲")한 #ruby("포|동|특|구","浦|東|特|區")가 #ruby("건|설","建|設")되고 있다.]에 내렸다. 같이 탄 #ruby("동|지","同|志")는 모두 15#ruby("명","名")이었다. #ruby("안|동|현","安|東|縣")에서는 아직 얼음덩이가 #ruby("첩|첩","疊|疊")이 쌓인 것을 보았는데, #ruby("황|포","黃|浦") #ruby("선|창","船|艙")에 내리며 바라보니 #ruby("녹|음","綠|陰")이 우거졌다. #ruby("공|승|서|리","公|昇|西|里") 15#ruby("호","號")에서 하룻밤 #ruby("숙|박","宿|泊")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이때 #ruby("상|해","上|海")에 #ruby("집|합","集|合")된 #ruby("인|물","人|物") #ruby("중","中") #ruby("평|소","平|素") 나와 #ruby("친|숙","親|熟")한 사람은 #ruby("이|동|녕","李|東|寧"),#footnote(numbering: _ => [14)])[#h(0.35em)#ruby("이|동|녕","李|東|寧")\(1869〜1940). #ruby("호","號")는 #ruby("석|오","石|吾"). 그는 1906#ruby("년","年")에 이미 #ruby("북|간|도","北|間|島") #ruby("용|정|촌","龍|井|村")에 #ruby("망|명","亡|命")하였고, 그#ruby("후","後") #ruby("서|간|도","西|間|島")에서 #ruby("경|학|사","耕|學|社")와 #ruby("신|흥|학|교","新|興|學|校")를 #ruby("설|립","設|立")하였다.] #ruby("이|광|수","李|光|洙"),#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("이|광|수","李|光|洙")는 1919#ruby("년","年") #ruby("동|경","東|京")에서 2·8 #ruby("선|언|문","宣|言|文")을 #ruby("작|성","作|成")한 #ruby("이|후","以|後") #ruby("상|해","上|海")에 와 있었다.] #ruby("김|홍|서","金|弘|敍"),#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("김|홍|서","金|弘|敍")\(1886〜1959). 그는 105#ruby("인","人") #ruby("사|건","事|件") #ruby("이|후","以|後") #ruby("체|포","逮|捕")되지 않고 #ruby("은|신","隱|身")하다 1915#ruby("년","年") #ruby("체|포","逮|捕")되어 4#ruby("개|월","個|月")의 #ruby("옥|고","獄|苦")를 치르고 1916#ruby("년","年") #ruby("상|해","上|海")로 #ruby("망|명","亡|命")하였다. 그는 #ruby("초|기","初|期")에는 #ruby("임|시|정|부","臨|時|政|府")에서, 그#ruby("후","後")에는 #ruby("조|선|민|족|혁|명|당","朝|鮮|民|族|革|命|黨")에서 #ruby("활|동","活|動")하였다.] #ruby("서|병|호","徐|丙|浩")#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("서|병|호","徐|丙|浩")\(1885〜1972). 그는 1914#ruby("년","年") #ruby("중|국","中|國")으로 #ruby("망|명","亡|命")하여 #ruby("남|경","南|京")의 #ruby("금|릉|대|학","金|陵|大|學")에 다니고 있었다. 1919#ruby("년","年") #ruby("김|규|식","金|奎|植")·#ruby("여|운|형","呂|運|亨") 등과 #ruby("신|한|청|년|당","新|韓|靑|年|黨")을 #ruby("조|직","組|織")하여 #ruby("당|수","黨|首")를 맡는다.]4#ruby("명","名")이었고, 그밖은 #ruby("구|미","歐|美")와 #ruby("일|본","日|本")에서 #ruby("도|래","渡|來")한 #ruby("인|사","人|士")들, #ruby("중|아|령","中|俄|領")과 #ruby("본|국","內|地")에서 찾아온 #ruby("인|사","人|士"), #ruby("전","前")부터 #ruby("중|국","中|國")에서 #ruby("유|학","留|學") 및 #ruby("상|업","商|業")을 하는 #ruby("동|포","同|胞")들로 그 #ruby("수","數")를 #ruby("통|계","統|計")하면 500#ruby("여","餘")#ruby("명","名")이라 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이튿날 아침, #ruby("전","前")부터 #ruby("상|해","上|海")에 #ruby("가|족","家|族")을 이끌고 먼저 와 살고 있던 #ruby("김|보|연","金|甫|淵") #ruby("군","君")이 와서 #ruby("자|기","自|己") 집으로 #ruby("인|도","引|導")하여 #ruby("숙|식","宿|食")을 같이 했다. #ruby("김|군","金|君")은 #ruby("장|연|읍","長|淵|邑") #ruby("김|두|원","金|斗|元")의 큰아들이며 #ruby("경|신|학|교","敬|信|學|校") #ruby("출|신","出|身")으로, #ruby("전","前")날 내가 #ruby("장|연","長|淵")에서 #ruby("학|교","學|校") #ruby("사|무","事|務")를 #ruby("총|괄","總|括")할 때부터 나를 #ruby("존|경","尊|敬")하고 따르던 #ruby("청|년","靑|年")이었다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) #ruby("경|무|국|장","警|務|局|長")에서 #ruby("국|무|령","國|務|領")까지]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|동|녕","李|東|寧"), #ruby("이|광|수","李|光|洙"), #ruby("김|홍|서","金|弘|敍"), #ruby("서|병|호","徐|丙|浩") #ruby("등","等") 옛 #ruby("동|지","同|志")들을 찾아가 만나 #ruby("악|수","握|手")하였다. 그때 #ruby("임|시|정|부","臨|時|政|府")가 #ruby("조|직","組|織")되었다. 이에 #ruby("대","對")하여는 #ruby("국|사","國|史")에 #ruby("자|세","仔|細")히 #ruby("기|록","記|錄")될 것이므로 #ruby("생|략","省|略")한다. 나는 #ruby("내|무|위|원","內|務|委|員")의 한 사람으로 #ruby("피|선","被|選")되었다. 그#ruby("후","後") #ruby("안|창|호","安|昌|浩") #ruby("동|지","同|志")는 #ruby("미|주","美|洲")로부터 #ruby("상|해","上|海")로 건너와서 #ruby("내|무|총|장","內|務|總|長")으로 #ruby("취|임","就|任")하고, #ruby("정|부|제|도","政|府|制|度")는 #ruby("차|장|제","次|長|制")를 #ruby("채|용","採|用")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("안|씨","安|氏")에게 #ruby("정|부","政|府")의 #ruby("문","門")지기를 #ruby("청|원","請|願")하였다. #ruby("이|유","理|由")는, #ruby("종|전","從|前")에 #ruby("본|국","本|國")에 있을 때 내 #ruby("자|격","資|格")을 #ruby("시|험","試|驗")하기 #ruby("위","爲")하여 #ruby("순|사","巡|査") #ruby("시|험|과|목","試|驗|科|目")을 혼자 #ruby("시|험","試|驗")쳐 본 #ruby("결|과","結|果") #ruby("합|격","合|格")하기 어려움을 알았던 스스로의 #ruby("경|험","經|驗")과, #ruby("허|영","虛|榮")을 #ruby("탐","貪")하여 #ruby("실|무","實|務")에 #ruby("소|홀","疏|忽")할 #ruby("우|려","憂|慮")가 있었기 때문이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|내|무|총|장","安|內|務|總|長")은 #ruby("쾌","快")히 받아들였다. #ruby("자|기","自|己")가 #ruby("미|국","美|國")에서 본바 #ruby("특","特")히 #ruby[백악관][白官]만 #ruby("수|호","守|護")하는 #ruby("관|리","官|吏")를 두었으니, 우리도 #ruby("백|범","白|凡")같은 이가 #ruby("정|부|청|사","政|府|廳|舍")를 #ruby("수|호","守|護")하게 되는 것이 좋으니 #ruby("국|무|회|의","國|務|會|議")에 #ruby("제|출","提|出")하여 #ruby("결|정","決|定")한다 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 #ruby("도|산","島|山")은 나에게 #ruby("홀|연","忽|然") #ruby("경|무|국|장","警|務|局|長") #ruby("임|명|장","辭|令|書")을 #ruby("교|부","交|付")하여 #ruby("취|임","就|任")하여 #ruby("근|무","勤|務")할 것을 힘써 #ruby("권","勸")하였다. 그때는 #ruby("국|무|회|의","國|務|會|議")에 #ruby("각","各") #ruby("부","部") #ruby("총|장","總|長")들이 아직 다 #ruby("취|임","就|任")하지 않았으므로, #ruby("각","各") #ruby("부","部")의 #ruby("차|장","次|長")이 #ruby("총|장","總|長")의 #ruby("직|권","職|權")을 #ruby("대|리","代|理")하여 #ruby("국|무|회|의","國|務|會|議")를 #ruby("진|행","進|行")하던 때였다. 그때 #ruby("차|장","次|長") #ruby("등","等")은 #ruby("윤|현|진","尹|顯|振"), #ruby("이|춘|숙","李|春|塾") #ruby("등","等") 젊은 #ruby("청|년","靑|年")들이므로 #ruby("노|인","老|人")에게 #ruby("문","門")을 여닫게 하고 #ruby("통|과","通|過")하기가 #ruby("미|안","未|安")하다 하고, #ruby("백|범","白|凡")이 여러 해 #ruby("감|옥|생|활","監|獄|生|活")로 #ruby("왜","倭")놈의 #ruby("실|정","實|情")을 잘 알 터이니 #ruby("경|무|국|장","警|務|局|長")이 #ruby("적|합","適|合")하다고 #ruby("인|정","認|定")되었다 한다.]
