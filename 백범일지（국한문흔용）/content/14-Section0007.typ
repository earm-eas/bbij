#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("독|립","獨|立")은 #ruby("만|세","萬|歲")만 불러서 되는 것이 아니고 #ruby("장|래","將|來") 일을 #ruby("계|획","計|劃")·#ruby("진|행","進|行")하여야 할 터인즉 나의 #ruby("참","參"), #ruby("불|참","不|參")이 #ruby("문|제","問|題")가 아니니, 자네들은 어서 #ruby("만|세","萬|歲")를 부르라.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 돌려보냈다. 그날 #ruby("안|악|읍","安|岳|邑")에서도 #ruby("만|세","萬|歲")를 불렀다.#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("민|족|운|동","民|族|運|動")의 #ruby("선|진|지|대","先|進|地|帶")였던 #ruby("안|악|군","安|岳|郡")에서는 3·1#ruby("만|세|운|동","萬|歲|運|動")이 #ruby("격|렬","激|烈")하게 #ruby("진|행","進|行")되었다. 서울에서 돌아온 박치간·유용원 #ruby("등","等")의 #ruby("주|도","主|導")로 3#ruby("월","月") 8#ruby("일","日") #ruby("만|세|운|동","萬|歲|運|動")이 일어난 다음, #ruby("기|독|교|인","基|督|敎|人")·#ruby("천|도|교|인","天|道|敎|人")·#ruby("학|생","學|生") 등의 #ruby("주|도","主|導")로 4#ruby("월","月") 8#ruby("일","日")까지 #ruby("만|세|운|동","萬|歲|運|動")이 이어졌다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그 다음날 아침에 #ruby("평|내","坪|內") #ruby("소|작|인","小|作|人")들을 #ruby("지|휘","指|揮")하여 #ruby("농|기|구","農|器|具")를 가지고 #ruby("일|제","一|齊")히 모이라 하고, 지팡이를 짚고 #ruby("제|방","堤|防")에 올라 #ruby("제|방","堤|防") #ruby("수|리","修|理")에 #ruby("몰|두","沒|頭")하였다. 내 집을 #ruby("감|시","監|視")하던 #ruby("헌|병","憲|兵")놈들이 내 #ruby("동|정","動|靜")을 보아야 #ruby("종|사","從|事") #ruby("준|비","準|備")만 하기 때문인지, #ruby("정|오","正|午")자 되자 #ruby("유|천","柳|川")으로 올라가버렸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("점|심","點|心")#ruby("시|간","時|間")에 #ruby("소|작|인","小|作|人")들에게 일을 잘 끝마치도록 #ruby("부|탁","付|託")한 #ruby("후","後") #ruby("잠|시","暫|時") “이웃마을에 다녀오마”하고 #ruby("안|악|읍","安|岳|邑")에 #ruby("도|착","到|着")하니, #ruby("김|용|진","金|庸|震") #ruby("군","君")이 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("홍|량","鴻|亮")더러 #ruby("상|해","上|海")에 가라고 했더니 10#ruby("만","萬") #ruby("원","元")을 주어야 가지 그렇지 못하면 떠나지 못한다고 하니, #ruby("선|생","先|生")부터 가십시오. #ruby("홍|량","鴻|亮")은 #ruby("추|후","追|後")에 갈 셈 치구요.”#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("김|용|진","金|庸|震")은 #ruby("백|범","白|凡")에게 300#ruby("원","元")을 주어 #ruby("중|국","中|國") #ruby("망|명","亡|命")을 #ruby("지|원","支|援")하였다고 한다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("지|체","遲|滯")할 수 없는 #ruby("형|편","形|便")을 보고 #ruby("즉|시","卽|時") #ruby("출|발","出|發")하여#footnote(numbering: _ => [11)])[#h(0.35em)#ruby("백|범","白|凡")이 #ruby("안|악","安|岳")에서 #ruby("상|해","上|海")로 #ruby("출|발","出|發")한 날은 1919#ruby("년","年") 3#ruby("월","月") 29#ruby("일","日")이다.] #ruby("사|리|원","沙|里|院")에 #ruby("도|착","到|着")하여 #ruby("김|우|범","金|禹|範") #ruby("군","君")에게서 하룻밤을 자고 이튿날 아침 #ruby("신|의|주|행","新|義|州|行") #ruby("기|차","汽|車")에 올랐다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|차","汽|車") 안에는 물끓는듯하는 말소리가 #ruby("만|세","萬|歲") 부르는 이야기뿐이다. #ruby("황|해|도","黃|海|道")에서 #ruby("평|산","平|山") #ruby[금천][平金川]은 어느날 불렀고, #ruby("연|백","延|白")은 어느날, #ruby("황|주","黃|州") #ruby[봉산][黃鳳山]에서는 어떻게 불렀고 하는 이야기들이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("평|양","平|壤")을 지나는데 #ruby("역|시","亦|是") 어디서 #ruby("만|세","萬|歲") 부르다가 사람 몇 #ruby("명","名")이 #ruby("상","傷")하였다는 #ruby("등","等")의 이야기 뿐이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리가 죽지 않고 #ruby("독|립","獨|立")이 되오.”]
