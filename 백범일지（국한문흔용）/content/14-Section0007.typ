#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("그|간","其|間") 아내는 #ruby("신","信")이를 #ruby("해|산","解|産")한 #ruby("후","後") #ruby("낙|상","落|傷")으로 #ruby("인","因")해 #ruby("폐|렴","肺|炎")에 걸려 몇 #ruby("년","年")을 #ruby("고|생","苦|生")하다, #ruby("상|해","上|海") #ruby("보|륭|의|원","寶|隆|醫|院")에서 #ruby("진|찰","診|察")을 받고, #ruby("역|시","亦|是") #ruby("서|양","西|洋") #ruby("시|설","施|設")을 갖춘 #ruby("홍|구","虹|口") #ruby("폐|병|원","肺|病|院")에 #ruby("격|리","隔|離"), #ruby("입|원","入|院")하게 되었다. 나와는 #ruby("보|륭|의|원","寶|隆|醫|院")에서 마지막 #ruby("작|별","作|別")을 하였고, #ruby("민|국","民|國") 6#ruby("년","年")\(1924, 49#ruby("세","歲")) 1#ruby("월","月") 1#ruby("일","日") #ruby("홍|구","虹|口") #ruby("폐|병|원","肺|病|院")에서 #ruby("영|원","永|遠")의 길을 떠났다.#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("정|정|화","鄭|靖|和")의 『#ruby("녹|두","綠|豆")꽃』에 의하면 #ruby("최|준|례","崔|遵|禮") #ruby("여|사","女|士")는 #ruby("형|편","形|便")이 어려워 #ruby("외|국|인","外|國|人") #ruby("선|교|회","宣|敎|會")에서 #ruby("무|료","無|料")로 #ruby("시|술","施|術")하는 #ruby("홍|구","虹|口") #ruby("폐|병|원","肺|病|院")으로 옮겼는데, 그곳은 #ruby("일|본","日|本") #ruby("조|계|지","租|界|地")이므로 #ruby("백|범","白|凡")은 #ruby("부|인","夫|人")이 #ruby("위|독","危|篤")하다는 #ruby("연|락","連|絡")을 받고도 #ruby("임|종","臨|終")을 지켜보지 못하였다. #ruby("곽|낙|원","郭|樂|園") #ruby("여|사","女|士")가 #ruby("병|원","病|院")으로 달려갔을 때, #ruby("최|준|례","崔|遵|禮") #ruby("여|사","女|士")는 이미 #ruby("영|안|실","靈|安|室")로 옮겨진 #ruby("후","後")였다.] 나는 아내를 #ruby("불|란|서","佛|蘭|西") #ruby("조|계","法|界") #ruby("숭|산|로","嵩|山|路") #ruby[경찰서][捕房] #ruby("후|면","後|面")의 #ruby("공|동|묘|지","共|同|墓|地")에 #ruby("매|장","埋|葬")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("본","本")뜻은 우리가 #ruby("독|립|운|동","獨|立|運|動") #ruby("기|간","期|間") #ruby("중","中") #ruby("혼|례","婚|禮")나 #ruby("장|례","葬|禮")의 #ruby("성|대","盛|大")한 #ruby("의|식","儀|式")으로 #ruby("금|전","金|錢")을 #ruby("소|비","消|費")하는 것에 #ruby("찬|성","贊|成")하지 않았으므로, 아내의 #ruby("장|례","葬|禮")는 #ruby("극","極")히 #ruby("검|약","儉|約")하게 하기로 하였다. 그러나 여러 #ruby("동|지","同|志")들이 아내가 나로 #ruby("인","因")해 #ruby("무|한","無|限")한 #ruby("고|생","苦|生")을 겪은 것이 곧 나라일에 #ruby("공|헌","貢|獻")한 것이라 하여, 나의 #ruby("주|장","主|張")을 #ruby("불|허","不|許")하고 #ruby("각|기","各|其") #ruby("연|금","捐|金")하여 #ruby("장|의","葬|儀")도 #ruby("성|대","盛|大")하게 지내고 #ruby("묘|비","墓|碑")까지 세워주었다. 그#ruby("중","中")에 #ruby("유|세|관","柳|世|觀") #ruby("인|욱","寅|旭") #ruby("군","君")은 #ruby("병|원","病|院") #ruby("교|섭","交|涉")과 #ruby("묘|지","墓|地") #ruby("주|선","周|旋")에 #ruby("성|력","誠|力")을 다하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아내가 #ruby("병|원","病|院")에 #ruby("입|원","入|院")했을 때 #ruby("인","仁")이도 #ruby("병","病")이 #ruby("중","重")하여 #ruby("공|제|의|원","共|濟|醫|院")에 #ruby("입|원","入|院") #ruby("치|료","治|療")하다가 아내 #ruby("장|례","葬|禮") #ruby("후","後") #ruby("완|전","完|全")히 나아 #ruby("퇴|원","退|院")하였다. #ruby("신","信")이는 겨우 걸음마를 익힐 때요, 아직 젖먹을 때였다. 먹는 것은 #ruby("우|유","牛|乳")를 #ruby("사|용","使|用")하나, 잘 때는 반드시 할머님의 빈 젖을 물고야 잠이 들었다. #ruby("차|차","次|次") 말을 배울 때는 #ruby("단|지","但|只") 할머님만 알고 어머니가 무엇인지 몰랐다.]
