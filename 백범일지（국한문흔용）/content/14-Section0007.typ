#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그해 11#ruby("월","月"), 나는 #ruby("국|무|령","國|務|領")으로 #ruby("피|선","被|選")되었다. 나는 #ruby("의|정|원","議|政|院") #ruby("의|장","議|長") #ruby("이|동|녕","李|東|寧")에게, #ruby("지|금","只|今") #ruby("정|부","政|府")가 #ruby("위|축","萎|縮")된 #ruby("추|형","雛|形")#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("추|형","雛|形")은 #ruby("사|정","事|情")이 #ruby("여|의","如|意")치 않아 #ruby("축|소","縮|小")한 #ruby("형|태","形|態").]이라고 하더라도, 내가 #ruby("김|존|위","金|尊|位")의 아들로 #ruby("일|국","一|國")의 #ruby("원|수","元|首")가 되는 것은 #ruby("국|가","國|家")의 #ruby("위|신","威|信")을 #ruby("추|락","墜|落")케 하는 것이니 #ruby("감|당","堪|當")할 수 없다 하였으나, #ruby("혁|명","革|命") #ruby("시|기","時|期")에는 #ruby("관|계","關|係") 없다고 #ruby("강|권","强|勸")하므로 #ruby("부|득|이","不|得|已") #ruby("승|낙","承|諾")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("윤|기|섭","尹|琦|燮")·#ruby("오|영|선","吳|永|善")·#ruby("김|갑","金|甲")·#ruby("김|철","金|澈")·#ruby("이|규|홍","李|圭|洪")으로 #ruby("내|각","內|閣")을 #ruby("조|직","組|織")한 #ruby("후","後") #ruby("헌|법|개|정|안","憲|法|改|正|案")을 #ruby("의|원","議|院")에 #ruby("제|출","提|出")하여 #ruby("독|재|제","獨|裁|制")인 #ruby("국|무|령|제","國|務|領|制")를 고쳐 #ruby("평|등|제","平|等|制")인 #ruby("위|원|제","委|員|制")로 #ruby("개|정","改|正") #ruby("실|시","實|施")하여, 나는 #ruby("당|장","當|場")은 #ruby("위|원","委|員")의 한 사람으로 #ruby("집|무","執|務")하였다.#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("임|시|정|부","臨|時|政|府")는 여러 #ruby("번","番") #ruby("개|헌","改|憲")을 하였는데, #ruby("김|구","金|九") #ruby("주|도","主|導")의 1927#ruby("년","年") #ruby("제","第")3#ruby("차","次") #ruby("개|헌","改|憲")은 #ruby("국|무|령|제","國|務|領|制")를 #ruby("집|단|지|도|체|제","集|團|指|導|體|制")인 #ruby("국|무|위|원|제","國|務|委|員|制")로 #ruby("채|택","採|擇")하였다.]]
