#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("평|양","平|壤")에 #ruby("무|사","無|事")히 #ruby("도|달","到|達")하기 #ruby("불|가|능","不|可|能")하니 #ruby("고|향","故|鄕")으로 돌아가라.”]
