#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“여러 사람들은 저자의 말을 #ruby("명|심","銘|心")하라. 어느날이고 내 집에 #ruby("화|재","火|災")가 나면 저 놈들의 짓이니, 여러 사람들은 그때에 #ruby("입|증","立|證")하라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("형|근","亨|根")이가 물러간 #ruby("후","後")에 여러 사람들은 나에게 #ruby("노|가","盧|家") #ruby("형|제","兄|弟")들과 #ruby("원|수","怨|讐")를 맺지 말라고 #ruby("권","勸")하였다. 나는 #ruby("준|엄","峻|嚴")하게 꾸짖고 밤을 지냈다. 어머님은 밤에 #ruby("안|악","安|岳")으로 #ruby("통|보","通|報")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 아침에 #ruby("김|용|진","金|庸|震")·#ruby("김|홍|량","金|鴻|亮")이 #ruby("의|사","醫|師") #ruby("송|영|서","宋|永|瑞")를 데리고, #ruby("급","急")한 걸음으로 달려와서 내 #ruby("상|처","傷|處")를 #ruby("진|단","診|斷")하며 #ruby("소|송","訴|訟") #ruby("수|속","手|續")을 #ruby("준|비","準|備")하였다. #ruby("노|가","盧|家") #ruby("형|제","兄|弟")들은 몰려와서 머리를 조아리며 #ruby("사|죄","謝|罪")를 했다. #ruby("김|용|진","金|庸|震")·#ruby("김|홍|량","金|鴻|亮") #ruby("양|군","兩|君")을 #ruby("만|류","挽|留")하고 #ruby("노|가","盧|家")에게 다시는 이와 같은 #ruby("행|위","行|爲")가 #ruby("결|단","決|斷")코 없을 것이라는 #ruby("서|약","誓|約")을 받고 그 #ruby("문|제","問|題")는 #ruby("낙|착","落|着")을 보았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|후","以|後")로는 이미 #ruby("반|포","頒|布")한 #ruby("농|규","農|規")를 좇아서 #ruby("시|행","施|行")하였다. 나는 날마다 일찍 일어나서 #ruby("소|작|인","小|作|人")의 집을 찾아, #ruby("나|태","懶|怠")해서 늦도록 잠을 자는 자가 있으면 깨워서 집안 일을 하도록 하며, #ruby("가|정","家|庭")이 더러운 자는 #ruby("청|결","淸|潔")하게 하며, #ruby("땔|감","柴|草")을 #ruby("마|련","磨|鍊")케 하고, 짚신삼기와 자리짜기를 #ruby("장|려","獎|勵")하였다. #ruby("평|상|시","平|常|時") #ruby("소|작|인","小|作|人")들의 『#ruby("근|만|부","勤|慢|簿")』#footnote(numbering: _ => [6)])[#h(0.35em)#ruby("성|실","誠|實")한가 #ruby("나|태","懶|怠")한가를 #ruby("점|검","點|檢")하는 #ruby("일|종","一|種")의 #ruby("근|무|일|지","勤|務|日|誌").]를 #ruby("작|성","作|成")하여 #ruby("추|수|절","秋|收|節")에 #ruby("농|장|주","農|場|主")의 #ruby("허|가","許|可")를 얻은 #ruby("범|위","範|圍")#ruby("내","內")에서 부지런한 자에게는 #ruby("후","厚")한 #ruby("상","賞")을 주고, 게으른 자에게는 다시 게으르면 #ruby("경|작|권","耕|作|權")을 #ruby("허|락","許|諾")하지 않는 다고 #ruby("예|고","豫|告")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("종|전","從|前") #ruby("추|수|시","秋|收|時")에는 #ruby("타|작","打|作") 마당에서 #ruby("채|무|자","債|務|者")가 모여들어 #ruby("곡|물","穀|物") #ruby("전|부","全|部")를 다 가져가고 #ruby("작|인","作|人")들의 #ruby("거|반","居|半")은 #ruby("타|작|기|구","打|作|器|具")만 들고 집으로 돌아갔다. 그러나 내 #ruby("감|독","監|督")을 받은 #ruby("후","後") #ruby("곡|식","穀|食") #ruby("포|대","包|袋")를 #ruby("자|기","自|己") 집으로 가져가 쌓아두게 되니, #ruby("농|가","農|家") #ruby("부|인","夫|人")들이 더욱 #ruby("감|심","感|心")하여 나를 집안 늙은이 #ruby("모|양","模|樣")으로 #ruby("친|절","親|切")하게 #ruby("대|우","待|遇")하였고, #ruby("도|박","賭|博")의 #ruby("풍|습","風|習")은 거의 #ruby("근|절","根|絶")이 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("장|덕|준","張|德|俊") #ruby("군","君")이 #ruby("재|령","載|寧")에서 #ruby("명|신|여|교","明|信|女|校") #ruby("소|유","所|有") #ruby("장|토","庄|土")를 #ruby("관|리","管|理")하게 되었는데, #ruby("장|군","張|君")의 #ruby("평|시","平|時") #ruby("연|구","硏|究")와 #ruby("일|본","日|本") #ruby("유|학|시","留|學|時") #ruby("시|찰","視|察")한 #ruby("농|촌","農|村") #ruby("개|발","開|發")의 #ruby("방|안","方|案")을 갖추어 #ruby("장|래","將|來") #ruby("협|조","協|助")하기로 #ruby("수|차","數|次") #ruby("서|신","書|信")이 #ruby("왕|복","往|復")되었다. #ruby("동|산|평","東|山|坪")에서 같이 #ruby("농|토","農|土")를 #ruby("간|검","看|檢")하는 #ruby("동|업|자","同|業|者")요, 아울러 #ruby("동|지","同|志")인 #ruby("지|일|청","池|一|淸") #ruby("군","君")은 #ruby("이|전","以|前") #ruby("교|육|시|대","敎|育|時|代")부터 #ruby("친|우","親|友")이므로 힘을 합쳐 #ruby("진|행","進|行")해 나가니 그 #ruby("효|과","效|果")가 더욱 두드러졌다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어린 딸아이 #ruby("은|경","恩|敬")이가 #ruby("사|망","死|亡")하고 #ruby("처|형","妻|兄") #ruby("역|시","亦|是") #ruby("사|망","死|亡")하여 그 땅 #ruby("공|동|묘|지","共|同|墓|地")에 #ruby("매|장","埋|葬")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("무|오|년","戊|午|年")\(1918, 43#ruby("세","歲")) 11#ruby("월","月")에 #ruby("인","仁")이가 #ruby("출|생","出|生")했다. #ruby("인","仁")이가 #ruby("태|중","胎|中")에 있을 때 어머님은 #ruby("물|론","勿|論")이고 여러 #ruby("친|구","親|舊")들이 아들 낳기를 바랐던 것은, 내 아이가 40#ruby("여","餘") #ruby("세","歲")에 누이도 없는 #ruby("독|자","獨|子")로 #ruby("자|식","子|息")이 없음을 #ruby("우|려","憂|慮")함이었다. #ruby("인","仁")이가 난 #ruby("후","後") #ruby("김|용|제","金|庸|濟")는 어머님께 #ruby("치|하","致|賀")하여 말했다.]
