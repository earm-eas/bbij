#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[6, 7#ruby("월","月") 더위가 심한 어느날, 갑자기 #ruby("수|인","囚|人") #ruby("전|부","全|部")를 #ruby("교|회|당","敎|會|堂")에 모이라 하므로 나도 가서 앉았다. #ruby("소|위","所|謂") #ruby("분|감|장","分|監|長")인 #ruby("왜","倭")놈이 #ruby("좌|중","座|中")을 #ruby("향","向")하여 55#ruby("호","號")를 부른다. 내가 #ruby("대|답","對|答")하니 “일어나 #ruby[나오라][起來]”고 #ruby("호|령","號|令")한다. #ruby("단|상","壇|上")에 나가니 #ruby("가|출|옥","假|出|獄")으로 #ruby("방|면","放|免")한다는 뜻을 #ruby("선|언","宣|言")한다. 나는 꿈인 듯 #ruby("생|시","生|時")인 듯 #ruby("좌|중","座|中") #ruby("수|인","囚|人")들을 #ruby("향","向")하여 #ruby("점|두|례","點|頭|禮")#footnote(numbering: _ => [1)])[#h(0.35em)머리를 끄덕거려 절하는 것.]를 하고 곧 #ruby("간|수","看|守")의 #ruby("인|도","引|導")로 #ruby("사|무|실","事|務|室")에 나가니, 벌써 #ruby("준|비","準|備")한 흰옷 한 벌을 내준다. 그때부터 붉은 옷을 입은 #ruby[죄수][赤衣軍]가 흰옷을 입은 #ruby[사람][白衣人]으로 #ruby("변","變")하였다. 맡겨두었던 #ruby("금|품","金|品")과 #ruby("출|역","出|役")한 #ruby[품삯][出役工錢]을 #ruby("계|산","計|算")하여 주었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|문","獄|門") 밖으로 나와서 걸음걸음 #ruby("생|각","生|覺")한다. #ruby("박|영|문","朴|永|文")이나 #ruby("안|호|연","安|浩|然")을 #ruby("의|당","宜|當") 찾아뵈어야 할 터이나, #ruby("의|연","依|然")히 두 집에 #ruby("객|주","客|主") #ruby("문|패","門|牌")가 붙어 있으니 집안이 #ruby("조|용","從|容")하지 못할 것은 뻔한 #ruby("사|실","事|實")이요, 또한 내가 두 분을 찾아보면 #ruby("김|창|수","金|昌|洙")란 #ruby("본|명","本|名")을 말해야 그들이 깨달을 터이고, 그러면 #ruby("자|연","自|然") 안#ruby("식|구","食|口")에게 이야기하게 될 것이다. #ruby("남|자","男|子")는 #ruby("고|사","姑|捨")하고 #ruby("부|인","夫|人")들은 내가 왔다는 말을 들으면 20#ruby("년","年") 동안이나 #ruby("생|사","生|死")를 모르던 터에 #ruby("기|이","奇|異")하다고 이야기를 퍼뜨리게 될 터이니, 그러면 내 #ruby("신|변","身|邊")은 #ruby("위|험|천|만","危|險|千|萬")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("박|씨","朴|氏")나 #ruby("안|씨","安|氏") 집을 지날 때 발길이 떨어지지 않는 것을 억지로 견뎠다. #ruby("옥|중","獄|中")에서 친하던 #ruby("중|국|인","中|國|人")을 찾아가서 밤을 지내고, 이튿날 아침 #ruby("전|화|국","電|話|局")에 가서 #ruby("안|악","安|岳")으로 #ruby("전|화","電|話")를 걸어 아내를 불렀다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악|국","安|岳|局")에서 #ruby("전|화","電|話")받은 #ruby("직|원","職|員")이 #ruby("성|명","姓|名")을 묻는다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|九")요.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님, #ruby("옥","獄")에서 나오셨소?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 나와서 #ruby("지|금","只|今") 차 타러 나갑니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 그러시면 제가 #ruby("댁","宅")에 가서 말씀드리겠습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그만 끊겠습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|화|국","電|話|局") #ruby("직|원","職|員")은 내 #ruby("제|자","弟|子")였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 #ruby("경|성|역","京|城|驛")에서 #ruby("경|의|선","京|義|線") #ruby("차","車")를 타고 #ruby("신|막","新|幕")에서 하루 자고, 이튿날 #ruby("사|리|원","沙|里|院")에서 #ruby("하|차","下|車")하였다. #ruby("선|유|진","船|踰|津")을 거쳐 #ruby("여|물|평","餘|物|坪")을 건너가며 살펴보니, 전에 없던 #ruby("신|작|로","新|作|路")에 #ruby("수|십","數|十") #ruby("명","名")이 쏟아져 나오는데, #ruby("선|두","先|頭")에 계신 어머님이 내 걸음걸이를 보시고 눈물을 흘리며 와서 붙들고 말씀하셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너는 오늘 살아오지만, 너를 #ruby("심","甚")히 사랑하고 늘 보고 싶어하던 네 딸 #ruby("화|경","花|慶")이는 서너 달 전에 죽었구나. 네 #ruby("친|구","親|舊")들이 네게 알릴 것 없다고 #ruby("권","勸")하기로 #ruby("기|별","奇|別")도 하지 않았다. 7#ruby("세","歲") #ruby("미|만","未|滿")의 어린것이 죽을 때 ‘나 죽었다고 #ruby("옥","獄")에 계신 아버지께는 #ruby("기|별","奇|別")하지 마십시오. 아버지가 들으시면 오죽이나 마음이 #ruby("상","傷")하겠소’하더라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그#ruby("후","後") 곧 #ruby("안|악|읍","安|岳|邑") #ruby("동|산","東|山") #ruby("공|동|묘|지","共|同|墓|地")에 있는 #ruby("화|경","花|慶")이 #ruby("묘|지","墓|地")에 가 보았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[뒤이어 #ruby("김|용|제","金|庸|濟") #ruby("등","等") #ruby("수|십","數|十") #ruby("명","名") #ruby("친|구","親|舊")들이 다투어 달려와 #ruby("희|비","喜|悲")가 #ruby("교|차","交|叉")하는 얼굴로 #ruby("인|사","人|事")를 했다. 나는 돌아와서 #ruby("안|신|학|교","安|新|學|校")에 들어갔다. 그때까지 아내가 #ruby("안|신|여|교","安|新|女|校") #ruby("교|원","敎|員") #ruby("사|무","事|務")를 보고 #ruby("교|실","敎|室") 한 칸에 #ruby("거|주","居|住")하고 있었으므로, 나는 #ruby("예|배|당","禮|拜|堂")에 앉아서 오는 손님을 맞았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아내는 #ruby("극","極")히 #ruby("수|척","瘦|瘠")한 모습으로 여러 #ruby("부|인","夫|人")들과 같이 #ruby("잠|시","暫|時") 내 얼굴을 보는지 마는지 하고 #ruby("음|식","飮|食") #ruby("준|비","準|備")에 #ruby("골|몰","汨|沒")했다. 어머님과 아내가 #ruby("상|의","相|議")하여 #ruby("친|구","親|舊")들과 같이 앉아 먹는 내 모습을 보겠다는 마음으로 #ruby("정|성","精|誠")을 다해 #ruby("음|식","飮|食")을 #ruby("준|비","準|備")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[며칠 #ruby("후","後") #ruby("읍|내","邑|內")의 #ruby("친|구","親|舊")들이 #ruby("이|인|배","李|仁|培") 집에서 나를 #ruby("위","爲")하여 #ruby("위|로|회","慰|勞|會")를 #ruby("개|최","開|催")하고 나를 #ruby("청","請")했다. 한#ruby("편","便")에는 #ruby("노|인","老|人")들이, 한#ruby("편","便")에는 #ruby("중|년","中|年")의 #ruby("친|구","親|舊")들이, 또 한#ruby("편","便")에는 내 #ruby("제|자","弟|子")들인 #ruby("청|년","靑|年")들이 모였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("음|식","飮|食")이 차려질 즈음 갑자기 #ruby("기|생","妓|生") 한 떼와 #ruby("악|기","樂|器")가 들어왔다. 나는 놀랐다. #ruby("최|창|림","崔|昌|林") #ruby("등","等") 몇몇 #ruby("청|년","靑|年")들이 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님을 오래간만에 뵈온즉 너무 좋아서 저희들은 즐겁게 좀 놀렵니다. #ruby("선|생","先|生")님은 아무 말씀도 마시고, 여러분과 #ruby("진|지","進|止")나 잡수셔요.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("노|인","老|人")들 #ruby("중","中")에도 내게 #ruby("대","對")해 이런 말을 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|선|생","金|先|生")은 젊은 사람들의 일을 묻지 마시고 이야기나 합시다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("청|년","靑|年")들이 #ruby("지|정","指|定")하여 “아무 #ruby("기|생","妓|生")으로 #ruby("김|선|생","金|先|生")님께 #ruby("수|배","壽|盃")를 올려라” 하는 말이 끝나자, 한 #ruby("기|생","妓|生")이 술잔을 부어들고 #ruby("권|주|가","勸|酒|歌")를 부른다. #ruby("청|년","靑|年")들이 #ruby("일|제","一|齊")히 일어나 나에게 #ruby("부|탁","付|託")한다. 저희들이 #ruby("성|의","誠|意")로 #ruby("진|상","進|上")하는 #ruby("수|주","壽|酒") 한 잔을 마셔 달라는 것이다. 나는 웃고 #ruby("사|양","辭|讓")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("평|일","平|日") #ruby("음|주","飮|酒")하는 것을 군들이 보았는가? 먹을 줄 모르는 술을 어찌 마시는가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“물 마시듯 마셔봅시다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하더니, #ruby("기|생","妓|生")의 손에 든 술잔을 받아서 잔을 입에다 대며 #ruby("강|권","强|勸")하였다. 나는 그 #ruby("청|년","靑|年")들 #ruby("감|흥","感|興")을 없앨까 하여 술 한 잔을 받아 마셨다. #ruby("청|년","靑|年")들이 한#ruby("편","便")으로는 나에게 술을 #ruby("권","勸")하는 사이 #ruby("기|생","妓|生")의 #ruby("가|무","歌|舞")가 #ruby("시|작","始|作")되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 #ruby("이|인|배","李|仁|培") 집 앞이 #ruby("안|신|학|교","安|新|學|校")이므로, #ruby("음|악","音|樂")소리와 #ruby("기|생","妓|生") 노랫소리가 어머님과 아내의 귀에 들렸던 것이다. 어머님은 바로 사람을 보내어 나를 부르셨다. 그 눈치를 안 #ruby("청|년","靑|年")들이 어머님께 가서 말씀드렸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님은 술도 안 잡수시고, #ruby("노|인","老|人")들과 이야기나 하십니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 말을 들으시고, 어머님이 #ruby("친","親")히 오셔서 부르셨다. 나는 어머님을 따라 집에 왔다. 어머님은 #ruby("노","怒")하셔서 #ruby("책|망","責|望")하신다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 여러 해 동안 #ruby("고|생","苦|生")을 한 것이, 오늘 네가 #ruby("기|생","妓|生") 데리고 술 먹는 것을 보려 하였더냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("무|조|건","無|條|件") #ruby("대|죄","待|罪")하였다. 어머님도 어머님이거니와, 아내가 어머님께 #ruby("고|발","告|發")하여 자리에서 물러나게 할 #ruby("계|획","計|劃")을 낸 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아내와 어머님은 #ruby("종|전","從|前")에는 #ruby("고|부|간","姑|婦|間")에 #ruby("충|돌","衝|突")되는 #ruby("점","點")도 없지 않았으나, 내가 #ruby("체|포","逮|捕")된 #ruby("후","後")부터 6, 7#ruby("년","年")#ruby("간","間") #ruby("경|향","京|鄕")을 #ruby("전|전","轉|轉")하며 #ruby("별|별","別|別") #ruby("고|생","苦|生")을 같이 하여 #ruby("일|심|동|체","一|心|同|體")로 #ruby("반|점","半|點")의 #ruby("충|돌","衝|突")도 없어졌다고 한다. #ruby("경|성","京|城")에서 지낼 때 아내는 #ruby("연|동","蓮|洞") #ruby("안|득|은","安|得|恩") #ruby("여|사","女|士")와 #ruby("곽|귀|맹","郭|貴|孟") #ruby("여|사","女|士")의 돌봄도 많이 받았고, #ruby("경|제|적","經|濟|的") #ruby("궁|핍","窮|乏") 때문에 #ruby("화|경","花|慶")이를 어머님에게 맡기고 #ruby("매|일","每|日") #ruby("왜","倭")놈 #ruby("토|지|국","土|地|局")의 #ruby("책","冊") 만드는 #ruby("공|장","工|場")에서 고된 일도 하였다. 또한 어느 #ruby("서|양|여|자","西|洋|女|子")가 아내의 #ruby("학|비","學|費")를 #ruby("부|담","負|擔")하고 #ruby("공|부","工|夫")를 시켜주마 하였으나 설움에 파묻힌 어머님과 어린 #ruby("화|경","花|慶")이를 돌볼 #ruby("결|심","決|心")으로 #ruby("공|부","工|夫")도 못하였노라고, #ruby("종|종","種|種") #ruby("자|기","自|己") #ruby("의|사","意|思")와 맞지 않을 때 아내는 반드시 이런 말을 하여 나를 괴롭게 했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다른 #ruby("가|정","家|庭")에서는 #ruby("보|통","普|通") #ruby("남|편","男|便")과 아내 사이의 말다툼이 생기면 주로 #ruby("모|친","母|親")이 아들 #ruby("편","便")을 들건만, 우리집에서는 아내가 내 #ruby("의|견","意|見")에 #ruby("반|대","反|對")할 때 어머님이 열#ruby("백","百") #ruby("배","倍")의 #ruby("권|위","權|威")로 나만 몰아세우신다. 가만 #ruby("경|험","經|驗")하여 보면 #ruby("고|부|간","姑|婦|間")에 귓속말이 있은 #ruby("후","後")에는 반드시 내게 #ruby("불|리","不|利")한 #ruby("문|제","問|題")가 #ruby("발|생","發|生")된다. 그러므로 한 #ruby("번","番")도 내 마음대로 집안일을 #ruby("처|리","處|理")한 적이 없다 해도 #ruby("과|언","過|言")이 아니다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 아내의 말에 #ruby("반|대","反|對")하면, 어머님이 #ruby("만|장","萬|丈")의 #ruby("기|염","氣|焰")으로 #ruby("호|령","號|令")하신다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("감|옥","監|獄")에 들어간 #ruby("후","後") 네 #ruby("동|지","同|志")들 #ruby("중","中")에 젊은 #ruby("처|자","妻|子")가 #ruby("남|편","男|便")이 죽을 곳에 있음에도 돌아보지 않고 #ruby("이|혼","離|婚")을 하느니 #ruby("추|행","醜|行")을 하느니 하는 판에 네 #ruby("처","妻")의 #ruby("절|행","節|行")은, 나는 #ruby("고|사","姑|捨")하고 너의 #ruby("친|구","親|舊")들이 #ruby("감|동","感|動")하였다. 네 #ruby("처","妻")를 #ruby("결","決")코 #ruby("박|대","薄|待")해서는 못쓴다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이런 말씀을 하시기 때문에 #ruby("내|외","內|外") 싸움에서 나는 한 #ruby("번","番")도 이기지 못하고 늘 지기만 하였다. 어머님은 또 #ruby("분|부","分|付")하셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("체|포","逮|捕")된 #ruby("후","後") 우리 세 #ruby("식|구","食|口")가 #ruby("해|주","海|州") #ruby("고|향","故|鄕")에 다녀와서 #ruby("경|성","京|城")으로 가려 하니, 네 #ruby("준|영","俊|永") #ruby("삼|촌","三|寸")이 #ruby("극|력","極|力") #ruby("만|류","挽|留")하며, ‘내가 집이나 한 칸 짓고 살림을 차려 드릴 터이니 다른 곳으로 가지 말라’ ‘조카 돌아올 때까지 #ruby("형|수","兄|嫂")와 #ruby("질|부","姪|婦")를 #ruby("고|생","苦|生") 시키지 않을 테니 조밥이라도 먹으면서 같이 살자’ ‘젊은 며느리 데리고 다니다 #ruby("무|식","無|識")한 놈들에게 빼앗기면 어찌하느냐’고 #ruby("야|단","惹|端")하지만, 내가 네 #ruby("처","妻")의 #ruby("성|결","聖|潔")한 #ruby("심|지","心|志")를 알기 때문에 그 같은 #ruby("권|유","勸|誘")도 돌아보지 않고 #ruby("경|성","京|城")으로 #ruby("출|발","出|發")하였다. 네가 #ruby("장|기","長|期")로 #ruby("판|결","判|決")이 된 #ruby("후","後") 아무리 #ruby("고|생","苦|生")하더라도 네 #ruby("근|처","近|處")에 머물며 살아보고자 하나, 그도 #ruby("여|의","如|意")치 못하므로 다시 #ruby("고|향","故|鄕")으로 돌아와 #ruby("종|산","鍾|山") #ruby("우|종|서","禹|鍾|瑞") #ruby("목|사","牧|師")의 #ruby("주|선","周|旋")으로 그곳에서 지낼 때, #ruby("준|영","俊|永") #ruby("삼|촌","三|寸")은 #ruby("양|식","糧|食")과 쌀을 소달구지에 싣고 그곳까지 찾아왔더라. #ruby("삼|촌","三|寸")의 네게 #ruby("대","對")한 #ruby("정|분","情|分")이 #ruby("전","前")보다는 매우 #ruby("애|절","哀|切")하였다. 네가 #ruby("출|옥","出|獄")한 줄 알면 와보실 것이다. #ruby("편|지","便|紙")나 하여 드려라. 네 #ruby("장|모","丈|母")도 #ruby("전","前")보다 더욱 너를 #ruby("애|중","愛|重")해 하니 곧 #ruby("통|지","通|知")하여라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("서|대|문","西|大|門")에서 한 #ruby("번","番")은 어머님을, 한 #ruby("번","番")은 아내를 #ruby("면|회","面|會")한 뒤, #ruby("매|번","每|番") #ruby("면|회|기|간","面|會|期|間")이면 #ruby("장|모","丈|母")가 늘 오는 것을 보고서, #ruby("전","前")날 #ruby("처|형","妻|兄") #ruby("관|계","關|係")로 너무 #ruby("박","薄")하게 한 것도 #ruby("후|회","後|悔")되고 #ruby("매|번","每|番") #ruby("면|회","面|會") 온 것을 #ruby("감|사","感|謝")하게 여겼다. #ruby("준|영","俊|永") #ruby("삼|촌","三|寸")과 #ruby("장|모","丈|母")에게 #ruby("출|옥","出|獄")된 #ruby("사|유","事|由")를 #ruby("편|지","便|紙")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳") #ruby("헌|병|대","憲|兵|隊")에 #ruby("출|두","出|頭")를 하니 #ruby("장|래","將|來") #ruby("취|업","就|業")에 #ruby("대","對")해 #ruby("질|문","質|問")한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("평|소","平|素")에 아무 #ruby("기|술","技|術")이 없고 다만 #ruby("학|교","學|校")에 여러 해 #ruby("근|무","勤|務")를 하였으며, 또 #ruby("안|신|학|교","安|新|學|校")에서 내 아내가 #ruby("교|편","敎|鞭")을 잡고 있으니 #ruby("조|교|수","助|敎|授")나 하면 어떠한가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")는 #ruby("공|식","公|式")으로는 #ruby("불|가|능","不|可|能")하나 #ruby("비|공|식","非|公|式")으로 도와준다면 #ruby("경|찰","警|察")은 #ruby("묵|과","默|過")하겠노라고 한다. 나는 날마다 #ruby("안|신|학|교","安|新|學|校")에서 어린 아이들을 가르치며 #ruby("세|월","歲|月")을 보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("장|모","丈|母")는, 이미 #ruby("정|절","貞|節")을 잃고 #ruby("헌|병|보|조|원","憲|兵|補|助|員")의 #ruby("첩","妾")이 되었다가 #ruby("폐|렴","肺|炎")이란 #ruby("중|병","重|病")을 얻은 큰딸과 다시 #ruby("동|거","同|居")하면서 #ruby("생|활","生|活")할 길이 없어 #ruby("곤|란","困|難")하던 #ruby("차","次")에, 내 #ruby("편|지","便|紙")를 보고 좋아라 하고 #ruby("염|치","廉|恥")도 돌아보지 않고 #ruby("병","病")든 딸을 데리고 우리집에 들어왔다. 전과 같이 #ruby("헌|병|보|조|원","憲|兵|補|助|員")의 #ruby("첩","妾")이라면 #ruby("문","門")에 들어오는 것을 #ruby("허|락","許|諾")하지 않을 터이나, 죽을 #ruby("병","病")이 들어 #ruby("자|기","自|己") #ruby("동|생","同|生") 집으로 오는 것이니 미움보다는 #ruby("연|민","憐|憫")이 느껴져 다같이 살았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("울|적","鬱|寂")한 나머지 이리저리 다니며 바람이나 쐴 마음도 있었으나, #ruby("소|위","所|謂") #ruby("가|출|옥|기|간","假|出|獄|期|間")이 7, 8#ruby("개|월","個|月")이나 남았으니, 무슨 볼일이 있어 어디를 가려면 반드시 #ruby("사|유","事|由")를 #ruby("헌|병|대","憲|兵|隊")에 #ruby("부|탁","付|託")하여 #ruby("허|가","許|可")를 얻은 #ruby("후","後") 나갈 수 있었다. #ruby("부|탁","付|託")하는 것이 싫어 나는 이웃 #ruby("군","郡") #ruby("출|입","出|入")도 하지 않았다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[2) #ruby("농|감|생|활","農|監|生|活")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後")에 #ruby("가|출|옥","假|出|獄")이 #ruby("해|제","解|除")되자 #ruby("김|용|진","金|庸|震") #ruby("군","君")의 #ruby("부|탁","付|託")을 받고 #ruby("문|화","文|化")의 #ruby("궁|궁","弓|弓")#ruby("농|장","農|場")에 #ruby("추|수","秋|收")를 #ruby("검|사","檢|査")해 주고 돌아왔다. 그 사이에 #ruby("해|주","海|州") #ruby("준|영","俊|永") #ruby("삼|촌","三|寸")께서 점잖은 조카를 보러 가면서 초라하게 갈 수 없다 하여 남의 말을 얻어 타고 와서, 이틀이나 지내도 내가 돌아올 #ruby("시|기","時|期")를 모르므로 섭섭하게 돌아갔다고 한다. 나도 #ruby("역|시","亦|是") 섭섭하나 그해 #ruby("연|말","年|末")이 멀지 않았으니 #ruby("정|초","正|初")를 기다려서 #ruby("삼|촌","三|寸")에게 #ruby("신|정","新|正") #ruby("문|안","問|安")도 하고 #ruby("선|친","先|親")의 #ruby("묘","墓")에 #ruby("성|묘","省|墓")도 하기로 했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러다 새해가 되었다. #ruby("정|초","正|初") 3, 4#ruby("일|간","日|間")은 나도 이곳 어른들을 찾아뵙고 어머님을 뵈려고 오는 #ruby("친|구","親|舊")들을 #ruby("접|대","接|待")하기로 하고, #ruby("초","初")닷새에 #ruby("해|주|행","海|州|行")을 #ruby("작|정","作|定")하였다. 그런데 #ruby("초","初")나흗날 #ruby("석|양","夕|陽")에 #ruby("재|종","再|從") 아우 #ruby("태|운","泰|運")이가 와서,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("준|영","俊|永") #ruby("당|숙","堂|叔")이 #ruby("별|세","別|世")하였습니다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 알렸다. 듣자마자 #ruby("경|악|천|만","驚|愕|萬|千")이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[여러 해 동안 #ruby("옥|중","獄|中") #ruby("고|생","苦|生")을 하던 나를 보고 싶어 찾아오셨고, #ruby("정|초","正|初")에는 볼 줄 알고 기다리시다, 끝내 내 얼굴을 못 보시고 멀고 먼 길을 떠나실 때 그 마음이 어떠하였을까? 하물며 #ruby("당|신","當|身") #ruby("역|시","亦|是"), 딸은 하나 있으나 아들이 없고, 4#ruby("형|제","兄|弟") #ruby("소|생","所|生") #ruby("중","中")에 오직 하나뿐인 조카인 나#footnote(numbering: _ => [2)])[#h(0.35em)#ruby("원|문","原|文"): “伯父 伯永은 兩男 觀洙 泰洙가 有하엿으나. 觀洙는 二十餘歲에 成妻까지 하고 死亡하엿고. 泰洙는 나보다 二個月 먼저 난 同甲으로 長連에서 나와 同居하다가 急卒하야 亦是無后이고, 딸 둘도 擧皆 出嫁하야 죽어 無嗣하엿고. 弼永 叔은 딸 한 개 #inline-glyph("/images/293.jpg", cls: ())이고 俊永 叔도 亦是 딸 한 개 #inline-glyph("/images/p293.jpg", cls: ("txt_vm",))이다.]를 대하고 #ruby("영|결","永|訣")하고 싶은 마음이 얼마나 #ruby("간|절","懇|切")하였을까?]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 아침 #ruby("태|운","泰|運")을 #ruby("동|반","同|伴")하여 그 동네에 #ruby("도|착","到|着")해서 #ruby("장|례","葬|禮")를 #ruby("주|관","主|管")하여 #ruby("텃|골","基|洞") #ruby("동|산","東|麓")에 묻어드렸다. #ruby("가|사","家|事")의 #ruby("대|강","大|綱")을 #ruby("처|리","處|理")하고 #ruby("선|친","先|親") #ruby("묘|소","墓|所")에 나아가 내 손으로 심은 잣나무 두 #ruby("개","個")를 살펴보고서 다시 #ruby("안|악","安|岳")으로 돌아온 #ruby("후","後"), 다시는 #ruby("다|정|다|감","多|情|多|感")한 #ruby("텃|골","基|洞") #ruby("산|천","山|川")을 보지 못하고 아직 #ruby("생|존","生|存")하신 #ruby("당|숙|모","堂|叔|母")와 #ruby("재|종|조","再|從|祖")를 #ruby("배|알","拜|謁")하지 못하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 해에 셋째 딸 #ruby("은|경","恩|敬")을 낳았다. 나는 #ruby("계|속","繼|續") #ruby("안|신|학|교","安|新|學|校")에서 #ruby("교|사","敎|師")를 하고 있던바, #ruby("매|번","每|番") #ruby("추|수","秋|收") #ruby("시|기","時|期")에는 #ruby("김|용|진","金|庸|震")의 #ruby("농|장","農|場")에 가 #ruby("타|작","打|作")을 #ruby("간|검","看|檢")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("읍|내|생|활","邑|內|生|活")에 #ruby("취|미","趣|味")가 없어져서 #ruby("홍|량","鴻|亮")과 #ruby("용|진","庸|震")·#ruby("용|정","庸|鼎")에게 #ruby("농|촌|생|활","農|村|生|活")을 #ruby("부|탁","付|託")했다. 그들은 #ruby("자|기","自|己")네 #ruby("소|유","所|有") #ruby("중","中")에 #ruby("산|천","山|川")이 맑고 아름다운 곳을 #ruby("택","擇")하여 드리겠으니 #ruby("농|사","農|事") #ruby("감|독","監|督")이나 하라고 #ruby("흔|쾌","欣|快")히 #ruby("허|락","許|諾")한다. 나는 해마다 #ruby("추|수","秋|收")를 #ruby("감|독","監|督")하고 #ruby("시|찰","視|察")한바, 가장 성가시고 말썽 많고 #ruby("자|고","自|古")로 ‘#ruby("토|질","土|疾")\(#ruby("풍|토|병","風|土|病")) 구덩이’로 #ruby("유|명","有|名")한 #ruby("동|산|평","東|山|坪")으로 보내 달라고 #ruby("요|구","要|求")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그이들 #ruby("숙|질","叔|姪")은 놀란다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|산|평","東|山|坪")이야 되겠습니까? #ruby("소|작|인","小|作|人")들의 #ruby("인|품","人|品")이 #ruby("극","極")히 #ruby("험","險")할 뿐 아니라 #ruby("풍|토","水|土")#footnote(numbering: _ => [3)])[#h(0.35em)#ruby("수|토","水|土")는 ‘물과 땅’ 또는 ‘무논’이 아니고, 그 지방의 기후와 #ruby("풍|토","風|土")를 말한다.]가 #ruby("극","極")히 좋지 못한 곳에 가서 어찌 견디겠습니까?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나 #ruby("역|시","亦|是") 몇 #ruby("년","年")#ruby("간","間") 그곳 #ruby("소|작|인","小|作|人")들의 #ruby("악|습|패|속","惡|習|敗|俗")을 자세히 살폈으므로 그런 곳에 가서 #ruby("농|촌","農|村") #ruby("개|량","改|良")에나 #ruby("취|미","趣|味")를 붙이고자 하네.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("풍|토","風|土")가 나쁜 것은 #ruby("주|의","注|意")하여 지낼 셈치고, #ruby("기|어","期|於")이 #ruby("동|산","東|山")에 가겠다고 강하게 #ruby("요|청","要|請")하였다. 그이들은 ‘#ruby("바라는 바지만 감히 청하지 못하는","固所願不敢請")’ #ruby("격","格")으로 #ruby("다|행","多|幸")스럽게 생각한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|산","東|山")은 예로부터 #ruby("궁|방","宮|房")의 #ruby("장|토","宮|庄")로, #ruby("감|독","監|官")이나 #ruby("소|작|인","小|作|人")이 서로 #ruby("협|잡","挾|雜")하여 #ruby("천","千") #ruby("석","石") #ruby("수|확","收|穫")하면 몇#ruby("백","百") #ruby("석","石")이라고 #ruby("궁","宮")에 #ruby("보|고","報|告")하여 #ruby("감|독","監|督")이 가로채고, #ruby("소|작|인","小|作|人")들은 #ruby("수|확|기","收|穫|期")에 벼를 베고 #ruby("운|반","運|搬")하고 #ruby("타|작","打|作")할 때 #ruby("도|적","盜|賊")질을 하여, #ruby("실|제","實|際") #ruby("수|확|량","收|穫|量")이 얼마 못 되는데다 #ruby("감|관","監|官") #ruby("역|시","亦|是") #ruby("도|적","盜|賊")질하여 오기를 여러 #ruby("백","百") #ruby("년","年")이니, #ruby("소|작|인","小|作|人")의 #ruby("악|습|악|풍","惡|習|惡|風")이 #ruby("극","極")에 달했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|씨","金|氏") #ruby("가|문","家|門")에서 이 #ruby("농|장","農|場")을 처음 #ruby("매|수","買|收")한 것은 #ruby("진|사","進|士") #ruby("용|승","庸|昇")으로, #ruby("단|독","單|獨")으로 #ruby("매|입","買|入")하여 #ruby("거|대","巨|大")한 #ruby("손|해","損|害")를 입고 #ruby("파|산","破|産") #ruby("지|경","地|境")에 빠졌다. 그런데 #ruby("우|애","友|愛")가 남다른 여러 #ruby("형|제","兄|弟")가 그 #ruby("손|해","損|害")를 #ruby("분|담","分|擔")하고 #ruby("동|산|평","東|山|坪")을 #ruby("김|씨","金|氏") #ruby("가|문","家|門") #ruby("공|유","共|有")로 한 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[전부터 #ruby("노|형|극","盧|亨|極")이란 자가 #ruby("동|산|평","東|山|坪") #ruby("감|관","監|官")으로 와서. #ruby("소|작|인","小|作|人")들을 #ruby("자|기","自|己") 집에 #ruby("소|집","召|集")하고 #ruby("도|박","賭|博")을 하게 하여, #ruby("추|수","秋|收")할 때 #ruby("소|작|인","小|作|人") #ruby("분|량","分|量")의 #ruby("곡|물","穀|物")을 #ruby("전|부","全|部") #ruby("탈|취","奪|取")하였는데, #ruby("도|박","賭|博")에 #ruby("응","應")하지 않는 자는 #ruby("농|작|지","農|作|地")를 얻기 어려웠다. #ruby("소|작|인","小|作|人")의 #ruby("악|습","惡|習")은, 아버지나 #ruby("형","兄")이 #ruby("도|박","賭|博")하면 아이나 #ruby("동|생","同|生")은 #ruby("경|찰","警|察")이 오는가 #ruby("망","望")보는 것이 #ruby("보|통","普|通")이다. 내가 굳게 그곳의 #ruby("간|농","看|農")을 #ruby("요|구","要|求")한 #ruby("본","本")뜻은 그러한 #ruby("풍|기","風|紀")를 #ruby("개|선","改|善")하고자 함이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("정|사|년","丁|巳|年")\(1917, 42#ruby("세","歲")) 2#ruby("월","月")에 #ruby("동|산|평","東|山|坪")으로 #ruby("이|사","移|徙")하였다. 내가 어머니에게 #ruby("주|의","注|意")드리기를, #ruby("소|작|인","小|作|人")들 #ruby("중","中") #ruby("뇌|물","賂|物")을 가지고 오는 자 있으면 내가 없는 사이라도 #ruby("일|체","一|切") #ruby("거|절","拒|絶")하시라고 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 내 앞에 #ruby("연|초","煙|草")·닭·#ruby("생|선","生|鮮")·#ruby("과|실","果|實") #ruby("등","等") #ruby("물|건","物|件")을 갖다주는 자가 있었다. 그러면 반드시 #ruby("소|작|지","小|作|地")에 #ruby("대","對")한 #ruby("요|청","要|請")이 있다. 나는 그들에게 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대가 빈손으로 왔다면 생각해 볼 #ruby("여|지","餘|地")가 있으나, #ruby("뇌|물","賂|物")을 가지고 와서 #ruby("요|청","要|請")하면 그 말부터 듣지 않을 터인즉, #ruby("물|건","物|件")을 도로 가져가고 #ruby("후|일","後|日") 다시 빈손으로 와서 말하시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("뇌|물","賂|物")이 아니올시다. #ruby("선|생","先|生")께서 새로 오셨는데, 내가 그저 오기 섭섭하여 좀 가져왔습니다.”]
