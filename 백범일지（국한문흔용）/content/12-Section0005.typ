#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("자|기","自|己") #ruby("방","房")에 들어가 #ruby("곡|절","曲|折")을 물었다. 나는 바른 대로 말을 하였다. #ruby("진|오|위|장","陳|五|衛|將")은 나를 앉힌 #ruby("후","後") #ruby("자|기","自|己") #ruby("식|구","食|口")들을 불러 #ruby("인|사","人|事")시키는 한#ruby("편","便"), 그때 같이 #ruby("감|옥","監|獄")에 갇혔던 #ruby("공|범","共|犯")들을 불러모았다. 내 #ruby("행|색","行|色")이 #ruby("수|상","殊|常")한 것을 보고는 걱정이 되었던지, 제#ruby("각|기","各|其") #ruby[갓][白笠]과 #ruby[두루마기][周衣]와 #ruby("망|건","網|巾")을 하나씩 사다 주고 #ruby("속","速")히 갖추어 입으라고 하였다. 3〜4#ruby("년","年") 만에 비로소 #ruby("망|건","網|巾")을 쓰니 어찌된 일인지 저절로 눈물이 떨어졌다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[며칠 동안 그 사람들과 잘 놀다가 #ruby("청|파","靑|坡") #ruby("조|덕|근","曺|德|根")의 집을 찾아갔다. #ruby("문","門") 밖에서 “이리 오너라” 하고 불렀다. #ruby("조|덕|근","曺|德|根")의 큰마누라는 내가 온 줄 알고 꺼리는 빛이 #ruby("역|력","歷|歷")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리집 #ruby("선|달","先|達")님이 #ruby("옥","獄")에서 나왔다고 #ruby("인|천","仁|川") 집에서 #ruby("기|별","奇|別")은 해주었으나, #ruby("혹|시","或|是") #ruby("이|모","姨|母") #ruby("댁","宅")에 나와 계신지 내가 오늘 가 보고 #ruby("내|일","來|日") 오시면 말씀드리겠습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러려니 여기고 돌아왔다가 다음날 또 그 집에 찾아갔다. #ruby("역|시","亦|是") 모른다고 말을 하는 눈치가, #ruby("조|덕|근","曺|德|根")과 #ruby("상|의","相|議")한 #ruby("후","後") 나는 #ruby("조|덕|근","曺|德|根")보다 #ruby("중|죄|인","重|罪|人")이니 이미 #ruby("출|옥","出|獄")한 바에는 다시 보아 #ruby("이|익","利|益")이 없다고 생각하고 잡아떼는 #ruby("수|작","酬|酌")이었다. 새삼 내가 퍽도 어리석다는 생각이 들었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘나는 먼저 #ruby("탈|옥","脫|獄")해서 #ruby("단|신","單|身")으로 쉽게 달아나려다가, 그의 #ruby("애|걸","哀|乞")하던 모습을 떠올리고는 #ruby("이|중","二|重")의 #ruby("험|지","險|地")로 다시 들어가 #ruby("위|험|지|대","危|險|地|帶")를 다 #ruby("면","免")케 해준 것이었는데, #ruby("지|금","只|今") 내가 빈손으로 #ruby("자|기","自|己")를 찾았을 줄 알고 #ruby("금|전|상","金|錢|上") #ruby("해","害")를 입게 될까 봐 #ruby("거|절","拒|絕")하는구나. 그 사람의 그 #ruby("행|실","行|實")인즉 깊이 꾸짖을 것도 없다.’]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이렇게 생각하고는 돌아와서 다시 그 집에 가지 않았다. 며칠을 두고 이 사람 저 사람들에게 #ruby("성|찬","盛|饌")을 잘 #ruby("대|접","待|接")받고 #ruby("헐|각","歇|脚")도 하엿다.#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “다리도 쉬었다.”] #ruby("팔|도|강|산","八|道|江|山") #ruby("구|경","求|景")이나 하겠다 하고 #ruby("작|별","作|別")하니, 그 사람들이 추렴하여 #ruby("노|자","路|資")를 한 짐 지워주었다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[2) #ruby("삼|남","三|南")#ruby("견|문|록","見|聞|錄")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날로 #ruby("동|적|강","銅|赤|江")을 건너 #ruby("삼|남|지|방","三|南|地|方")으로 #ruby("향","向")했다. 그때 내 마음이 매우 #ruby("울|적","鬱|積")하여 #ruby("승|방","僧|房") 뜰에서부터 #ruby("폭|음","暴|飮")을 #ruby("시|작","始|作")했다. 밤낮으로 #ruby("계|속","繼|續") 술을 마셔대면서 #ruby("과|천","果|川")을 지나 겨우 #ruby("수|원","水|原") #ruby("오|산|장","烏|山|場")에 #ruby("도|착","到|着")하자 한 짐이나 되었던 #ruby("노|자","路|資")가 다 떨어지고 말았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("오|산|장","烏|山|場") #ruby("서","西")쪽 동네에 #ruby("김|삼|척","金|三|陟")이라는 사람의 집이 있었는데, #ruby("주|인","主|人") #ruby("영|감","令|監")은 #ruby("전","前")에 #ruby("삼|척","三|陟") #ruby("영|장","營|將")#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("감|영","監|營")이나 #ruby("병|영","兵|營")에 딸린 #ruby("진|영","陣|營")의 #ruby("무|관|직","武|官|職") 벼슬.]을 지낸 사람이었다. 아들이 여섯 있었는데, 그#ruby("중","中") 맏아들이 #ruby("인|천|항","仁|川|港")에서 #ruby("상|업","商|業")을 #ruby("경|영","經|營")하다가 #ruby("실|패","失|敗")한 #ruby("관|계","關|係")로 #ruby("인|천|옥","仁|川|獄")에서 한 달 #ruby("가|량","假|量") #ruby("고|생","苦|生")한 적이 있었다. #ruby("감|옥","監|獄")에 있는 동안 나를 몹시 사랑하였는데, #ruby("자|기","自|己")가 #ruby("방|면","放|免")될 때에도 #ruby("불|인|분|수","不|忍|分|手")에 #ruby("정|의","情|義")로#footnote(numbering: _ => [18)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “차마 헤어지기 힘든 마음에”.] 뒷날 다시 만날 것을 굳게 #ruby("약|속","約|束")한 터였다. 그 집에 찾아가서 그들 여섯 #ruby("형|제","兄|弟")와 같이 술 마시고 노래 부르며 며칠을 보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("약|간","若|干")의 #ruby("노|자","路|資")를 얻어가지고 #ruby("공|주","公|州")를 지나 #ruby("은|진","恩|津") #ruby("강|경|포","江|景|浦")에 있는 #ruby("공|종|열","孔|鍾|烈")의 집에 찾아 들어갔다. #ruby("공|종|열","孔|鍾|烈")도 #ruby("역|시","亦|是") #ruby("감|옥","監|獄") #ruby("친|구","親|舊")였는데, #ruby("자|기","自|己") #ruby("부|친","父|親") #ruby("공|중|군","孔|中|軍")#footnote(numbering: _ => [19)])[#h(0.35em)#ruby("중|군","中|軍") #ruby("역|시","亦|是") #ruby("군|대","軍|隊")의 벼슬 이름.]이 #ruby("작|고","作|故")하여 #ruby("상|중","喪|中")인 몸이었다. 사람됨이 어린 나이에도 #ruby("영|리","伶|俐")하고 #ruby("학|문","文|學")도 어느 #ruby("정|도","程|度") 할 줄 알았다. 일찍이 #ruby("운|현|궁","雲|峴|宮") #ruby("청","廳")지기를 지냈고, #ruby("당|시","當|時")는 #ruby("조|병|식","趙|秉|式")#footnote(numbering: _ => [20)])[#h(0.35em)‘趙秉軾’은 ‘趙秉式’. #ruby("조|병|식","趙|秉|式")\(1823〜1907)은 #ruby("조|선","朝|鮮") #ruby("말|기","末|期")의 #ruby("요|직","要|職")을 두루 #ruby("역|임","歷|任")하였고, #ruby("충|청","忠|淸") #ruby("감|사","監|司") #ruby("재|임","在|任")시에 #ruby("탐|학","貪|虐")을 비롯하여 이른바 ‘5#ruby("흉","凶")’으로 #ruby("지|목","指|目")될 #ruby("정|도","程|度")로 #ruby("횡|포","橫|暴")가 #ruby("심","甚")하였다.]의 #ruby("마|름","舍|音")으로 #ruby("강|경|포","江|景|浦")에서 #ruby("물|상|객|주","物|商|客|主")를 #ruby("경|영","經|營")하다가 #ruby("금|전|관|계","金|錢|關|係")로 #ruby("살|인","殺|人") #ruby("소|송","訴|訟")에 걸려들어 여러 달 #ruby("인|천|감|옥","仁|川|監|獄")에 갇혀 있었다. #ruby("감|옥","監|獄")에 있는 동안 나와 매우 #ruby("절|친","切|親")하게 지냈었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|경|포","江|景|浦")에 들어가 #ruby("공|종|열","孔|鍾|烈")의 집에 #ruby("당|도","當|到")하여 보니 집이 매우 크고 넓었다. #ruby("공|종|열","孔|鍾|烈")이 나의 손을 끌고 일곱째 #ruby("대|문","大|門")으로 들어가서 #ruby("자|기","自|己") #ruby("부|인","夫|人") #ruby("방","房")에 나를 #ruby("유|숙","留|宿")하도록 하였다. #ruby("공|종|열","孔|鍾|烈")의 어머니도 #ruby("인|천","仁|川")에서 만나 알게 되었으므로 반갑게 절하고 #ruby("인|사","人|事")하였다. #ruby("공|군","孔|君")이 나를 이같이 #ruby("특|별","特|別")히 #ruby("대|우","待|遇")한 것은 #ruby("옥|중","獄|中") #ruby("친|구","親|舊")로서의 #ruby("동|정","同|情") 때문이기도 했고, 또 그 #ruby("포|구","浦|口")가 #ruby("인|천","仁|川")에서 아침저녁으로 오갈 수 있는 가까운 곳이기 때문이기도 했다. #ruby("각","各") #ruby("사|랑|방","舍|廊|房")마다 #ruby("동|서|남|북","東|西|南|北") #ruby("각|지","各|地") 사람들이 드나들었기 때문에 내 #ruby("비|밀","祕|密")이 #ruby("탄|로","綻|露")될까 #ruby("염|려","念|慮")하였던 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[며칠을 #ruby("휴|양","休|養")하며 지내던 어느날 밤이었다. 달빛이 뜰에 가득한데, #ruby("공|군","孔|君") 어머니의 #ruby("방|문","房|門") 여닫히는 소리가 들렸다. 나는 가만히 일어나 앉아 #ruby("창|문","窓|門")에 댄 #ruby("유|리","琉|璃")를 #ruby("통","通")해 뜨락을 내다보았다. 갑자기 칼빛이 번쩍하였다. #ruby("자|세","仔|細")히 살펴보니 #ruby("공|종|열","孔|鍾|烈")은 칼을 들고 어머니는 #ruby("창","槍")을 끌며, #ruby("모|자","母|子")가 #ruby("동|병","動|兵")을 한다.#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("군|사","軍|士")를 #ruby("동|원","動|員")하였다.”] 행여 뜻밖의 #ruby("변","變")이 있을까 하여 #ruby("의|복","衣|服")을 #ruby("정|돈","整|頓")하고 앉았노라니, 얼마 #ruby("후","後") #ruby("공|군","孔|君")이 어떤 #ruby("청|년","靑|年")의 상투를 끌고 들어왔다. #ruby("하|인","下|人")을 불러모아 두레집#footnote(numbering: _ => [22)])[#h(0.35em)여기서 두레는 물을 긷거나 옮기는 데 쓰는 #ruby("도|구","道|具"). 물을 퍼내는 것은 두레박. 두레집은 두레를 매달기 #ruby("위","爲")해 긴 나무 3#ruby("개","個")의 윗#ruby("부|분","部|分")을 묶고 밑을 넓게 벌려놓은 것으로 도르레틀 비슷한 것이다.]을 짓고 그 #ruby("청|년","靑|年")을 거꾸로 매달더니 열 살 안팎의 사내아이 둘을 불러 방망이 한 개씩을 주면서]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너희들의 #ruby("원|수","怨|讐")니 너희들 손으로 때려죽여라.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 하였다. 그러다가 #ruby("공|군","孔|君")이 내 #ruby("방","房")에 들어와 이런 말을 했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("형","兄")이 매우 놀랐을 터이니 #ruby("미|안","未|安")하오. 그러나 #ruby("형","兄")과 나 사이에 무슨 숨기고 꺼릴 일이 있겠소. 내 누님 한 분이 #ruby("과|부","寡|婦")로 혼자 살면서 #ruby("수|절","守|節")하다가 내 집 #ruby("상|노","床|奴")#footnote(numbering: _ => [23)])[#h(0.35em)밥#ruby("상","床")을 나르고 잔심부름하는 #ruby("하|인","下|人").] 놈과 #ruby("간|통","姦|通")하여 얼마 #ruby("전","前")에 #ruby("해|산","解|産")을 하고 죽고 말았소. 그놈을 불러 ‘네 #ruby("자|식","子|息")을 데리고 먼 곳으로 가서 기르고 내 앞에 보이지 말라’고 하였소. 그런데 그놈이 #ruby("천|주|학","天|主|學")을 하여 #ruby("신|부","神|父")의 #ruby("세|력","勢|力")을 믿고 내 집 곁에 #ruby("유|모","乳|母")를 두어 내 집안에 #ruby("수|치","羞|恥")를 끼치는 것 아니겠소. #ruby("형","兄")이 나가서 #ruby("호|령","號|令")하여 그놈이 멀리 달아나도록 하여 주오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 어디로 보든지 그만한 #ruby("청","請")을 안 들어주지 못할 #ruby("처|지","處|地")였다. #ruby("승|낙","承|諾")하고 나가서 달아맨 것을 풀어 앉히고 그 #ruby("자","者")의 #ruby("죄","罪")를 하나하나 세어가며 꾸짖었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 이 #ruby("댁","宅")에서 길러준 #ruby("은|혜","恩|惠")를 생각한들 #ruby("주|인","主|人")의 #ruby("면|목","面|目")을 그다지도 #ruby("무|시","無|視")할 수 있느냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이렇게 #ruby("호|령","號|令")을 하니, 그 #ruby("자","者")는 나를 슬쩍 보고서 겁나고 두려운 #ruby("표|정","表|情")으로]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나리 #ruby("분|부","分|付")대로 하겠습니다. 살려주십시오.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[한다. #ruby("공|종|열","孔|鍾|烈")은 그 #ruby("자","者")를 #ruby("향","向")하여 다그쳤다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 오늘밤으로 네 #ruby("자|식","子|息")을 내다버리고 이 #ruby("지|방","地|方")을 떠날 터이냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("자","者")는 “예, 예” #ruby("대|답","對|答")하고서 물러갔다. 나는 #ruby("공|군","孔|君")에게 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그 #ruby("자","者")가 #ruby("자|식","子|息")을 데리고 갈 곳이나 있는가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“개울 건너 #ruby("임|피","臨|陂")#footnote(numbering: _ => [24)])[#h(0.35em)#ruby("현|재","現|在")는 #ruby("전|북","全|北") #ruby("옥|구|군","沃|溝|郡") #ruby("임|피|면","臨|陂|面"), 1914#ruby("년","年") #ruby("이|전","以|前")은 #ruby("임|피|군","臨|陂|郡")이었다. #ruby("금|강","錦|江")과 #ruby("만|경|강","萬|頃|江") 사이의 #ruby("호|남|평|야","湖|南|平|野") #ruby("지|역","地|域")이다.] 땅에 제 #ruby("형","兄")이 사니까, 그리로 가면 #ruby("자|식","子|息")도 기를 수 있을 거요.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아까 내가 보았던 그 두 사내아이는 누군가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내 누님의 #ruby("아|이","甥|姪")들이오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 날이 밝으면 어느 곳으로나 #ruby("출|발","出|發")하겠다는 말을 하였다. 그 집 #ruby("형|편","形|便")이 그러하니, 나 또한 몰래 숨어 있던 것이 #ruby("탄|로","綻|露")났을 것이었다. #ruby("공|군","孔|君") #ruby("역|시","亦|是") 그렇게 생각하고, #ruby("자|기","自|己") #ruby("매|부","妹|夫") #ruby("진|선|전","陳|宣|傳")#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("선|전","宣|傳") 또는 #ruby("선|전|관","宣|傳|官")은 #ruby("선|전|관|청","宣|傳|官|廳")에 있던 #ruby("무|관","武|官") 벼슬.]이 #ruby("무|주|읍","茂|朱|邑")에 살고 있는데, #ruby("부|자","富|者")일 뿐 아니라 그 #ruby("읍","邑")이 #ruby("한|적","閑|寂")하고 깊숙한 곳이니 그리 가서 #ruby("세|월","歲|月")을 기다림이 좋을 것 같다 하며 #ruby("소|개","紹|介") #ruby("편|지","便|紙") 한 #ruby("장","張")을 써 주었다. 다음날 아침에 #ruby("공|군","孔|君")과 #ruby("작|별","作|別")하고 #ruby("무|주","茂|朱")로 길을 떠났다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|경|포","江|景|浦")를 채 벗어나기 #ruby("전","前"), 거리에서 사람들이 웅성웅성거리는 것을 보았다. 지난 새벽에 갯가에서 어린 아이 우는 소리가 들렸는데, 그 소리가 끊어진 지 이미 오래 됐으니, 아마도 그 아이는 죽은 것이라고 #ruby("야|단","惹|端")들이었다. 그 말을 들으니, #ruby("천|지","天|地")가 아득하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘오늘 #ruby("살|인","殺|人")을 하고 가는 길이로구나. 그 #ruby("자","者")가 밤에 내 얼굴을 #ruby("대","對")하면서 #ruby("심","甚")히 무서워하더니, #ruby("공|종|열","孔|鍾|烈")의 말을 곧 내 #ruby("명|령","命|令")으로 생각하고 제 #ruby("자|식","子|息")을 안아다가 #ruby("강|변","江|邊")에 버리고 #ruby("도|주","逃|走")한 것 아닌가?’]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[가뜩이나 가슴 속이 #ruby("울|적","鬱|積")한데다가, #ruby("세|상","世|上")에 아무 #ruby("죄","罪") 없는 어린 아이를 죽이게 하였으니 얼마나 큰 #ruby("죄|악","罪|惡")인가. #ruby("일|생","一|生")을 #ruby("위","爲")하여 #ruby("심","甚")히 #ruby("비|관","悲|觀")된다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[마침내 #ruby("무|주|읍","茂|朱|邑")에 있는 #ruby("진|선|전","陳|宣|傳")의 집에 갔으나, #ruby("구|구","區|區")하게 한 곳에 오래 머물러 있는 것은 더욱 #ruby("우|울","憂|鬱")한 마음만 쌓이게 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[드디어 #ruby("무|전|여|행","無|錢|旅|行")을 떠났다. 내 걸음이 #ruby("이|왕","已|往") #ruby("삼|남|지|방","三|南|地|方")을 돌아다니는 바에는 #ruby("남|원","南|原")에 가서 #ruby("김|형|진","金|亨|鎭")을 만나보리라 하는 생각이 들었다. #ruby("평|소","平|素")에 들은 말이 있어, #ruby("전|주","全|州") #ruby("남|문","南|門") 안에 있는 #ruby("한|약|국","韓|藥|局") #ruby("주|인","主|人") #ruby("최|군|선","崔|君|善")이 #ruby("김|형|진","金|亨|鎭")의 #ruby("매|형","妹|兄")임을 알았으나, 먼저 #ruby("남|원","南|原") #ruby("이|동","耳|洞")#footnote(numbering: _ => [26)])[#h(0.35em)#ruby("김|형|진","金|亨|鎭")의 #ruby("본|향","本|鄕")은 #ruby("이|동","耳|洞")이 아니라 #ruby("남|원|군","南|原|郡") #ruby("산|동|방","山|東|坊") #ruby("이|사|동","耳|寺|洞")이다.]에 찾아가서 #ruby("김|형|진","金|亨|鎭")이 사는 곳을 물었다. 그 동네사람들이 놀라고 #ruby("의|아","疑|訝")해 하며 #ruby("김|형|진","金|亨|鎭")을 찾는 #ruby("연|유","緣|由")를 물었다. 나는 #ruby("경|성","京|城")에서 알게 되어 지나는 길에 들렀다고 하였다. 동네사람들의 말에 #ruby("의","依")하면, #ruby("김|형|진","金|亨|鎭")이 이 동네에서 #ruby("대|대","代|代")로 살기는 하였으나 #ruby("연|전","年|前")에 #ruby("동|학","東|學")에 #ruby("가|입","加|入")했다가 다 #ruby("망","亡")한 #ruby("후","後")에 #ruby("식|솔","食|率")을 이끌고 #ruby("도|망","逃|亡")간 #ruby("후","後")로는 다시 #ruby("소|식","消|息")을 모른다 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 듣기에 좀 섭섭하였다. #ruby("김|형|진","金|亨|鎭")은 나와 #ruby("청","淸")나라까지 #ruby("동|행","同|行")하여 많고 적은 #ruby("위|험","危|險")을 같이 넘긴, #ruby("친|형|제","親|兄|弟")보다 #ruby("정|의","情|義")가 깊고 #ruby("간|절","懇|切")한 사이였다. 그런 #ruby("처|지","處|地")로 #ruby("자|기","自|己")는 나의 #ruby("일|생","一|生")에 #ruby("대","對")해 빠짐없이 다 알면서 #ruby("자|기","自|己") #ruby("내|력","來|歷")은 나에게 숨기고 #ruby("비|밀","祕|密")로 하였으니 어떻게 #ruby("이|해","理|解")할 수 있을까?#footnote(numbering: _ => [27)])[#h(0.35em)#ruby("김|형|진","金|亨|鎭")이 #ruby("최|시|형","崔|時|亨")으로부터 #ruby("금|구","金|溝") #ruby("접|주","接|主")로 #ruby("임|명","任|命")된 것은 #ruby("백|범","白|凡")과 헤어지고 난 #ruby("후","後")인 1897#ruby("년","年")이기 때문에 굳이 #ruby("자|신","自|身")의 #ruby("동|학","東|學") #ruby("행|적","行|跡")을 #ruby("비|밀","祕|密")로 한 것은 아니었다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("여|하","如|何")튼 #ruby("전|주","全|州")까지 가서 그 뒷일을 알아보리라 #ruby("작|정","作|定")하였다. #ruby("전|주|읍","全|州|邑")에 있는 #ruby("최|군|선","崔|君|善")을 찾아가 #ruby("김|형|진","金|亨|鎭")의 #ruby("친|구","親|舊")임을 밝히고 어디에 사는지를 물었다. #ruby("최|군|선","崔|君|善")은 #ruby("냉|담","冷|淡")한 #ruby("어|조","語|調")로 #ruby("대|답","對|答")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|형|진","金|亨|鎭") 말씀이오? #ruby("김|형|진","金|亨|鎭")은 #ruby("분|명","分|明") 내 #ruby("처|남","妻|男")이지만, 내게 지기 어려운 무거운 짐만 지우고 #ruby("자|기","自|己")는 벌써 #ruby("황|천|객","黃|泉|客")이 되었소.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("천|신|만|고","千|辛|萬|苦")를 겪으면서 찾아간 나는 슬픈 #ruby("감|회","感|懷")를 #ruby("금","禁")하기 어려웠다. 그런 #ruby("중","中")에 #ruby("최|군|선","崔|君|善")의 #ruby("응|접","應|接")이 너무 #ruby("불|친|절","不|親|切")한 것을 보고 나니 다시 더 물어볼 생각도 없었다. 곧 #ruby("작|별","作|別")하고 그날이 #ruby("전|주","全|州") #ruby("장","場")날이었으므로 #ruby("장","場")터에 나가서 #ruby("구|경","求|景")을 했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이리저리 다니다가 #ruby("포|목|점","白|木|廛")에 가서 #ruby("포|목","布|木") #ruby("환|매","換|買")하는 #ruby("광|경","光|景")을 보고 있었다. 그러다가 시골 #ruby("농|사","農|事")꾼으로 보이는 #ruby("청|년","靑|年") 한 사람이 #ruby("포|목","布|木")을 #ruby("환|매","換|買")하는 것을 보았는데, #ruby("용|모","容|貌")가 #ruby("흡|사","恰|似") #ruby("김|형|진","金|亨|鎭") 같았다. #ruby("김|형|진","金|亨|鎭")보다는 어려 보였지만, 말하는 것과 #ruby("행|동|거|지","行|動|擧|止")가 꼭 #ruby("김|형|진","金|亨|鎭") 같았다. 다만 #ruby("김|형|진","金|亨|鎭")에게서는 #ruby("문|사","文|士")의 #ruby("자|태","姿|態")가 보였으나, 이 사람은 #ruby("농|사","農|事")꾼처럼 보이는 것이 다를 뿐이었다. 나는 그 사람이 일을 다 끝내고 돌아가려는 틈을 타서 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("당|신","當|身") #ruby("김|서|방","金|書|房") 아니시오?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 그렇지라오마는 #ruby("당|신","當|身")은 뉘시오니까?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|형","老|兄")이 #ruby("김|형|진","金|亨|鎭") #ruby("씨","氏") #ruby("계|씨","季|氏")#footnote(numbering: _ => [28)])[#h(0.35em)#ruby("계|씨","季|氏")는 아우, #ruby("백|씨","伯|氏")는 #ruby("형","兄").]가 아니오?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 사람이 머뭇머뭇하고 말#ruby("대|답","對|答")을 못하였다. 나는 #ruby("계|속","繼|續")해서 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("당|신","當|身") #ruby("면|모","面|貌")를 보고 #ruby("김|형|진","金|亨|鎭") #ruby("씨","氏") #ruby("계|씨","季|氏")임을 #ruby("짐|작","斟|酌")하였소. 나는 #ruby("황|해|도","黃|海|道") #ruby("해|주","海|州")에 사는 #ruby("김|창|수","金|昌|洙")요. #ruby("노|형","老|兄") #ruby("백|씨","伯|氏") #ruby("생|전","生|前")에 #ruby("혹|시","或|是") 내 이야기를 들은 적이 있소?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("청|년","靑|年")은 두 눈에 눈물이 가득 고여 말을 잇지 못하다가 흐느끼며 슬피 울었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("과|연","果|然") 그랬습니까? 내 #ruby("형","兄") #ruby("생|전","生|前")에 #ruby("당|신","當|身")께 #ruby("관","關")한 말씀을 들었을 뿐 아니라, #ruby("별|세","別|世")하실 때에도 #ruby("창|수","昌|洙")를 #ruby("생|전","生|前")에 다시 못 보고 죽는 것이 #ruby("한","恨")이 된다고 하였지라오. 제 집으로 가십시다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("금|구","金|溝") #ruby("원|평","院|坪")으로 가서 조그마한 집으로 들어갔다. 그 사람이 #ruby("자|기","自|己") 어머니와 #ruby("형|수","兄|嫂")에게 내가 찾아온 것을 말하자, 그 집에 #ruby("곡|성","哭|聲")이 #ruby("진|동","震|動")하였다. #ruby("김|형|진","金|亨|鎭")이 #ruby("작|고","作|故")한 지 열아흐레 뒤라 하였다.#footnote(numbering: _ => [29)])[#h(0.35em)#ruby("김|형|진","金|亨|鎭")의 #ruby("사|망|일","死|亡|日")이 #ruby("음|력","陰|曆") 1898#ruby("년","年") 2#ruby("월","月") 27#ruby("일","日")\(#ruby("양|력","陽|曆") 3#ruby("월","月") 19#ruby("일","日"))이니, 열아흐레 뒤는 #ruby("양|력","陽|曆")으로 4#ruby("월","月") 7#ruby("일","日")이다.] #ruby("영|전","靈|筵")에 들어가 절하였다. #ruby("육|십","六|十") #ruby("노|모","老|母")는 #ruby("자|기","自|己") 아들 생각에, #ruby("삼|십","三|十") #ruby("청|상|과|부","靑|孀|寡|婦")는 #ruby("남|편","男|便") 생각에 눈물을 흘렸지만, 아들 #ruby("맹|문","孟|文")은 아직 8, 9#ruby("세","歲")밖에 되지 않아 아무 철이 없었다. #ruby("장","場")터에서 만났던 사람이 바로 #ruby("형|진","亨|鎭")의 둘째 아우니, 아들 #ruby("맹|열","孟|悅")이가 있고 #ruby("농|사","農|事")를 지어서 #ruby("생|활","生|活")하고 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그곳에서 #ruby("수|일|간","數|日|間") 쉬고, #ruby("무|안","務|安")·#ruby("목|포","木|浦")로 #ruby("향","向")했다. #ruby("목|포","木|浦")에 #ruby("도|착","到|着")하니 새로 열린 #ruby("항|구","港|口")로 아직 #ruby("관|사","官|舍") #ruby("건|축","建|築")도 미처 못하고 모든 일이 다 엉성하여 보였다. #ruby("양|봉|구","梁|鳳|九")를 만나서 #ruby("인|천","仁|川") #ruby("소|식","消|息")을 물었다. #ruby("조|덕|근","曺|德|根")은 서울에서 잡혀 #ruby("인|천|감|옥","仁|川|監|獄")으로 도로 들어갔는데, 눈 한 #ruby("개","個")가 빠졌고 다리가 부러졌다고 하였다.#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에 #ruby("의","依")하면 #ruby("조|덕|근","曺|德|根")은 #ruby("탈|옥","脫|獄") #ruby("후","後") 열흘 남짓 만인 1898#ruby("년","年") 4#ruby("월","月") #ruby("초","初")에 붙잡혔다.] 그때 #ruby("간|수","看|守")였던 #ruby("김|가","金|哥")는 #ruby("아|편|독","阿|片|毒")이 몰려서 #ruby("옥|중","獄|中")에서 죽었다 하고, 나에 #ruby("관","關")한 #ruby("소|문","所|聞")은 듣지 못했다 한다. 그리고 #ruby("인|천","仁|川")과 #ruby("목|포","木|浦")#ruby("간","間")에 #ruby("순|검","巡|檢")들이 서로 #ruby("내|왕","來|往")하고 있으니, 오래 머무를 곳이 못 된다며 #ruby("약|간","若|干")의 #ruby("여|비","旅|費")를 #ruby("준|비","準|備")하여 주면서 #ruby("항|구","港|口")를 떠나라 했다.]
