#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("당|신","當|身")이 내 #ruby("상|좌","上|佐")만 되면 #ruby("고|명","高|名")한 #ruby("대|사","大|師")에게서 #ruby("각|종","各|種") #ruby("불|학","佛|學")을 배우고 익힐 수 있을 거요. #ruby("장|래","將|來") 큰 #ruby("강|사","講|師")가 될지도 모르니 부디 #ruby("결|심","決|心")하고 #ruby("삭|발","削|髮")하시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[밤을 지낸 뒤에 보니 #ruby("이|서|방","李|書|房")은 이미 #ruby("삭|발","削|髮")하고 #ruby("계|란","鷄|卵")처럼 반질반질해진 #ruby[머리][鷄卵頭]로 나와서 #ruby("문|안","問|安")을 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|형","老|兄")도 #ruby("주|저","躊|躇") 마시고 곧 #ruby("삭|발","削|髮")을 하시오. 어제 찾아왔던 #ruby("하|은|당","荷|隱|堂")은 이 절에서 #ruby("재|산","財|産")이 #ruby("갑|부","甲|富")인 #ruby("보|경|대|사","寶|鏡|大|師")의 #ruby("상|좌","上|佐")요. 그러니 #ruby("후|일","後|日") #ruby("노|형","老|兄")이 #ruby("공|부","工|夫")를 하려 할 때에도 #ruby("학|자|금","學|資|金") #ruby("염|려","念|慮")는 없을 것이오. 내 #ruby("노|형","老|兄")의 이야기를 하였더니 #ruby("자|기","自|己")가 나와 보고서 매우 마음에 든다고 나더러 #ruby("속","速")히 #ruby("결|정","決|定")하게 하라고 #ruby("권","勸")합디다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하룻밤 사이 #ruby("청|정|법|계","淸|淨|法|界")#footnote(numbering: _ => [54)])[#h(0.35em)#ruby("죄","罪")나 #ruby("속|세","俗|世")의 티끌 없이 깨끗한 #ruby("불|교","佛|敎")의 #ruby("세|계","世|界").]에서 #ruby("만","萬") 가지 생각이 다 재로 돌아가버린 듯한 터였다. 나는 중이 되기로 #ruby("승|낙","承|諾")하였다. 얼마 뒤에 #ruby("사|제","師|弟")#footnote(numbering: _ => [55)])[#h(0.35em)스님의 #ruby("상|좌","上|佐")에 #ruby("대","對")하여 그보다 나이 어린 중.] #ruby("호|덕|삼","扈|德|三")이 머리털을 깎는 #ruby[칼][剃刀]을 가지고 왔다. 냇가로 나가 「#ruby("삭|발|진|언","削|髮|眞|言")」을 쏭알쏭알 하더니 내 상투가 모래 위로 툭 떨어졌다. 이미 #ruby("결|심","決|心")은 하였지만 머리털과 같이 눈물이 뚝뚝 떨어졌다. #ruby("법|당","法|堂")에서 #ruby("종","鐘")이 울리고, #ruby("향|적|실","香|積|室")에서는 #ruby("공|양|주","供|養|主")가 #ruby("불|공","佛|供")밥을 짓고, #ruby("각","各") #ruby("암|자","庵|子")에서 #ruby("가|사","袈|裟")를 입은 스님 #ruby("수|백","數|百") #ruby("명","名")이 모여들었다. 나도 검은 #ruby[장삼][黑長衫]과 붉은 #ruby[가사][紅袈裟]#footnote(numbering: _ => [56)])[#h(0.35em)우리나라의 #ruby("승|려","僧|侶") #ruby("의|복","衣|服")은 #ruby("중|국","中|國")의 #ruby("영|향","影|響")으로 검은 #ruby("장|삼","長|衫")과 붉은 #ruby("가|사","袈|裟")를 받아들였다. #ruby("세|종","世|宗") 때부터 #ruby("승|려","僧|侶")의 #ruby("의|복","衣|服")에 검은 #ruby("색","色") #ruby("사|용","使|用")을 #ruby("금","禁")하고 난 #ruby("후","後") #ruby("대|체","大|體")로 #ruby("시|색","緇|色")\(#ruby("회|색","灰|色")과 비슷한 거무스레한 #ruby("색","色"))을 #ruby("이|용","利|用")하였다. #ruby("백|범","白|凡")이 말하는 검은 #ruby("장|삼","長|衫") #ruby("역|시","亦|是") 그와 같은 거무스레한 빛깔의 #ruby("장|삼","長|衫")일 것이다.]를 입고서 #ruby("대|웅|보|전","大|雄|寶|殿")으로 #ruby("인|도","引|導")되었다. 곁에서 #ruby("덕|삼","德|三")이가 부처님께 절하는 #ruby("법","法")을 가르쳐 주고, #ruby("은|사","恩|師") #ruby("하|은|당","荷|隱|堂")이 내 #ruby("승|명","僧|名")을 #ruby("원|종","圓|宗")이라 #ruby("명|명","命|名")하여 #ruby("불|전","佛|前")에 #ruby("고","告")하였다. #ruby("수|계|사","受|戒|師")는 #ruby("용|담","龍|潭")이란 점잖은 #ruby("화|상","和|尙")#footnote(numbering: _ => [57)])[#h(0.35em)중의 #ruby("경|칭","敬|稱"). #ruby("도","道")를 많이 닦았거나 #ruby("전|수","傳|授")해 주는 스님.]으로, #ruby("경|문","經|文")을 #ruby("낭|독","朗|讀")하고 #ruby("오|계","五|戒")#footnote(numbering: _ => [58)])[#h(0.35em)#ruby("불|교","佛|敎") #ruby("계|율","戒|律") #ruby("중","中") 가장 #ruby("근|원","根|源")이 되는 다섯 가지 #ruby("계|목","戒|目"). ① #ruby("생|명","生|命")을 죽이지 #ruby[말라][不殺生], ② 주지 않는 것을 가지지 #ruby[말라][不偸盜], ③ #ruby("사|음","邪|淫")하지 #ruby[말라][不邪淫], ④ 삿된 거짓말을 하지 #ruby[말라][不妄言], ⑤ 술을 마시지 #ruby[말라][不飮酒].]를 일러주었다. #ruby("예|불","禮|佛")을 마친 #ruby("후","後")에는 #ruby("노","老")스님 #ruby("보|경|당","寶|鏡|堂")을 #ruby("위|시","爲|始")하여 절 안에 있는 나이 많은 #ruby("대|사","大|師")들에게 #ruby("차|례","次|例")대로 돌아가면서 절을 하였다. #ruby("승|배","僧|拜")를 #ruby("연|습","練|習")하고 『#ruby("진|언|집","眞|言|集")』#footnote(numbering: _ => [59)])[#h(0.35em)여러 #ruby("권","卷")의 #ruby("다|라|니","陀|羅|尼")를 한글·#ruby("한|문","漢|文")·#ruby("범|자","梵|字") #ruby("순","順")으로 #ruby("병|기","幷|記")한 #ruby("책","冊"). 2#ruby("권","卷") 1#ruby("책","冊")으로 #ruby("불|교","佛|敎")의 #ruby("초|보|적","初|步|的")인 #ruby("경|전","經|典")에 속한다.]과 『#ruby("초|발|자|경","初|發|自|警")』#footnote(numbering: _ => [60)])[#h(0.35em)『#ruby("초|발|심|자|경|문","初|發|心|自|警|文")』의 #ruby("약|칭","略|稱"). #ruby("보|조|국|사","普|照|國|師")가 지은 『#ruby("초|심","初|心")』, #ruby("원|효|대|사","元|曉|大|師")가 지은 『#ruby("발|심","發|心")』, #ruby("야|운","野|雲")이 #ruby("수|행|자","修|行|者")를 #ruby("경|계","警|戒")하기 #ruby("위","爲")해 지은 『#ruby("자|경|문","自|警|文")』 #ruby("등","等")을 #ruby("합|본","合|本")한 것으로, #ruby("초|심|자|용","初|心|者|用")의 #ruby("불|교|서|적","佛|敎|書|籍")이다.] #ruby("등","等") #ruby("간|단","簡|單")한 #ruby("규|칙","規|則")을 배웠다.#footnote(numbering: _ => [61)])[#h(0.35em)#ruby("불|가","佛|家")에 스님으로 #ruby("입|문","入|門")하는 #ruby("의|식","儀|式")을 ‘#ruby("계","戒")를 주는 #ruby("법|회","法|會")’, 즉 #ruby("수|계|회","授|戒|會")라 한다. #ruby("수|계|회","授|戒|會")는 #ruby("소|승|불|교","小|乘|佛|敎")의 #ruby("경|우","境|遇") #ruby("복|잡","複|雜")한 큰 #ruby("의|식","儀|式")이고, #ruby("대|승|불|교","大|乘|佛|敎")의 #ruby("경|우","境|遇") #ruby("비|교|적","比|較|的") #ruby("간|단","簡|單")하다. 우리나라는 #ruby("대|승|불|교","大|乘|佛|敎")이지만, #ruby("수|계|회","授|戒|會")만은 #ruby("불|교","佛|敎")의 가장 큰 #ruby("의|식","儀|式")으로 자리잡고 있다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("승|행","僧|行")은 #ruby("하|심","下|心")이 #ruby("제|일","第|一")이라 하야,#footnote(numbering: _ => [62)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “중이 되려면 #ruby("제|일","第|一") 먼저 #ruby("자|기","自|己") 마음을 낮추어야 한다고 하며”.] 사람에게는 #ruby("물|론","勿|論")이고 #ruby("심|지|어","甚|至|於")는 #ruby("금|수","禽|獸")나 #ruby("곤|충","昆|蟲")에게까지 #ruby("자|기","自|己") 마음을 낮추지 않으면 #ruby("지|옥","地|獄")의 #ruby[고통][地獄苦]을 받는다고 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전","前")날 밤 나를 찾아와 #ruby("자|기","自|己") #ruby("상|좌","上|佐")가 되어 달라고 할 때에는 #ruby("지|극","至|極")히 #ruby("공|손","恭|遜")하던 #ruby("하|은|당","荷|隱|堂")부터 “얘, #ruby("원|종","圓|宗")아”를 #ruby("기|탄","忌|憚")없이 부르고, “생긴 것이 미련스러워서 #ruby("고|명","高|名")한 중은 되지 못하겠다. 얼굴이 어쩌면 저다지도 밉게 생겼을까? 어서 나가서 물도 긷고 나무도 쪼개거라” 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 깜짝 놀랐다. #ruby("망|명|객","亡|命|客")이 되어 #ruby("사|방","四|方")을 떠돌아다니던 때에도 내게는 #ruby("영|웅|심","英|雄|心")과 #ruby("공|명|심","功|名|心")이 있었다. #ruby("평|생","平|生")의 #ruby("한","恨")이던 #ruby("상","常")놈의 껍질을 벗고, #ruby("평|등","平|等")하기보다는 #ruby("월|등","越|等")한 #ruby("양|반","兩|班")이 되어 #ruby("평|범","平|凡")한 #ruby("양|반","兩|班")에게 #ruby("당","當")해온 오랜 #ruby("원|한","怨|恨")을 갚고자 하는 생각이 가슴 속에 가득하였다. 그런데 중놈이 되고 보니, #ruby("이|상","理|想")과 같은 생각은 #ruby("허|영","虛|榮")과 #ruby("야|욕","野|慾")에 #ruby("불|과","不|過")한 것이었다. 그런 생각이야말로 #ruby("불|씨","佛|氏") #ruby("문|중","門|中")에서는 #ruby("추|호","秋|毫")도 #ruby("용|납","容|納")할 수 없는 #ruby("악|마","惡|魔")와 같은 생각이었다. #ruby("만|일","萬|一") 이런 따위의 #ruby("악","惡")한 생각이 #ruby("계|속","繼|續")해서 마음속에 싹트고 자랄 때에는, 곧 #ruby("호|법|선|신","護|法|善|神")#footnote(numbering: _ => [63)])[#h(0.35em)#ruby("호|법|신","護|法|神"). #ruby("불|법","佛|法")을 #ruby("수|호","守|護")하는 #ruby("신","神"). 절의 #ruby("경|우","境|遇") #ruby("창|건|주","創|建|主")나 #ruby("인|연","因|緣")이 있는 #ruby("도|력","道|力") 높은 #ruby("고|승","高|僧")이나 #ruby("영|웅","英|雄")들을 #ruby("호|법|신","護|法|神")으로 모신다. #ruby("고|승","高|僧")들을 모시는 #ruby("경|우","境|遇") #ruby("조|사|전","祖|師|殿")으로 #ruby("발|전","發|展")하기도 한다.]께 #ruby("의|뢰","依|賴")하여 물리쳐내야 하는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘하도 많이 돌아다녔더니 나중에는 #ruby("별|세|계","別|世|界") #ruby("생|활","生|活")을 다 하겠다.’]
