#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("양|반","兩|班")이 #ruby("작|정","作|定")한 품삯은 얼마이고 #ruby("상","常")놈이 제 마음대로 올려받은 것은 얼마나 되오?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("금|년","今|年")에는 동네 품삯을, 년은 두 푼, 놈은 서 푼씩 #ruby("정","定")하였는데, 저놈이 어느 #ruby("댁","宅") 일을 하고 한 푼 더 받았기 때문에 #ruby("징|계","懲|戒")하여 다스리는 것이오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 다시 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|상","路|上")의 #ruby("행|인","行|人")들이 #ruby("주|막","酒|幕")에서 먹는 #ruby("음|식","飮|食")값도 한 끼에 #ruby("최|하","最|下")가 5, 6푼인데, 하루 품삯이 밥 한 #ruby("상","床") 값의 #ruby("반|액","半|額")에도 못 미치면 혼자 살림도 #ruby("유|지","維|持")해 나가기 어렵거든 하물며 집안 #ruby("식|구","食|口")들을 데리고 어찌 #ruby("생|활","生|活")을 하겠소?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("주|인","主|人")은 그래도 할 말이 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("설|사","設|使") 한 집에 #ruby("장|정","壯|丁")이 년놈 #ruby("합","合")하여 두 #ruby("명","名")이라 하면, #ruby("매|일","每|日") 한 사람씩이라도 #ruby("양|반","兩|班")집 일을 안 할 때가 없고, 일을 하는 날은 그놈의 집 #ruby("식|구","食|口")가 다 같이 와서 밥을 먹소. 그러니 품삯을 많이 #ruby("지|불","支|拂")하여 #ruby("상","常")놈 집에 #ruby("의|식|주","衣|食|住")가 #ruby("풍|족","豊|足")하게 되면 #ruby("자|연","自|然")히 #ruby("양|반","兩|班")에게 #ruby("공|손","恭|遜")치 못하게 될 것 아니오? 그래서 그같이 품삯을 #ruby("작|정","作|定")하여 주는 것이오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 이 말을 듣고 깜짝 놀랐다. 내가 #ruby("상","常")놈으로 #ruby("해|주","海|州") #ruby("서|촌","西|村")에 난 것을 늘 #ruby("한|탄","恨|歎")하였으나, 이곳에 와서 보니 #ruby("양|반","兩|班")의 #ruby("낙|원","樂|園")은 #ruby("삼|남","三|南")이요 #ruby("상","常")놈의 #ruby("낙|원","樂|園")은 #ruby("서|북","西|北")이다. 그나마 내가 #ruby("해|서","海|西") #ruby("상","常")놈으로 난 것이 큰 #ruby("행|복","幸|福")이다. #ruby("만|일","萬|一") #ruby("삼|남","三|南") #ruby("상","常")놈이 되었다면 얼마나 #ruby("불|행","不|幸")하였을까?]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("경|상|도","慶|尙|道") #ruby("지|방","地|方")의 #ruby("반|상","班|常") 간에는 다른 #ruby("지|방","地|方")에 없는 #ruby("특|수","特|殊")한 #ruby("풍|습","風|習")이 있다. #ruby("삼|남","三|南")에서는 소 잡는 #ruby[백정][屠牛漢]이 #ruby("망|건","網|巾")을 쓰지 못하는 것이 #ruby("상|례","常|例")로 맨머리에 #ruby("패|랭|이","平|洋|子")#footnote(numbering: _ => [41)])[#h(0.35em)대나무를 가늘게 오린 댓개비로 만든 갓으로 #ruby("초|립","草|笠")보다 굵다. ‘#ruby("차|양|자","遮|陽|子")’ ‘#ruby("폐|양|자","蔽|陽|子")’ ‘#ruby("평|량|자","平|涼|子")’라고도 한다.]를 쓰고 드나들게 되어 있다. 패랭이 밑에 #ruby("대|테","竹|丸")를 둘러대고 거기다가 끈을 맨 것이 #ruby("백|정","白|丁")놈이다. #ruby("백|정","白|丁")이 길을 가다가 길에서 #ruby("남|녀|노|소","男|女|老|少")를 #ruby("막|론","莫|論")하고 사람을 만나게 되면, 반드시 길 아래로 내려서서 “#ruby("소|인","小|人") #ruby("문|안","問|安")드리오” 하고 #ruby("인|사","人|事")하여야 한다. #ruby("행|인","行|人")이 지나가고 나면 그제서야 제 갈 길을 가는 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("삼|남","三|南") #ruby("양|반","兩|班")의 #ruby("위|엄","威|嚴")이나 #ruby("속|박","束|縛")이 #ruby("심","甚")하기는 하지만 그런 #ruby("중","中")에도 #ruby("약|간","若|干")의 #ruby("미|풍|양|속","美|風|良|俗")이 없지는 않다. 모내기철에 #ruby("김|제","金|堤") #ruby("만|경","萬|頃")#footnote(numbering: _ => [42)])[#h(0.35em)#ruby("김|제|평|야","金|堤|平|野")와 #ruby("만|경|평|야","萬|頃|平|野")를 가리키는 말이다. ‘#ruby("김|만|경|평|야","金|萬|頃|平|野")’라고도 하는데, #ruby("동|진|강","東|津|江")과 #ruby("만|경|강","萬|頃|江") #ruby("유|역","流|域")에 있는 기름진 #ruby("김|제|평|야","金|堤|平|野")와 #ruby("만|경|평|야","萬|頃|平|野")를 합쳐서 부르는 이름이다.]을 지나며 보니 #ruby("농|사","農|事")꾼들이 아침에 일을 #ruby("시|작","始|作")할 때에 #ruby("사|명|기","司|命|旗")#footnote(numbering: _ => [43)])[#h(0.35em)‘#ruby("농|자|천|하|지|대|본","農|者|天|下|之|大|本")’ #ruby("등","等")을 써넣은 #ruby("농|기","農|旗")를 뜻함.]를 들고 #ruby("장|고","箏|鼓")를 울리며 들에 나가 #ruby("농|기","農|旗")를 세운다. 모를 심을 때에 선소리꾼이 북을 치고 #ruby("농|가","農|歌")를 #ruby("인|도","引|導")하면 #ruby("남|녀","男|女") #ruby("농|군","農|軍")들은 손발을 흔들고 춤을 추며 일을 한다. 논 #ruby("주|인","主|人")은 #ruby("탁|주","濁|酒")를 논두렁 여기저기에 동이째 놓아두고 마음대로 먹게 하고, #ruby("행|인","行|人")이 지나면 다투어 #ruby("권","勸")한다. #ruby("농|군","農|軍")이 #ruby("음|식","飮|食")을 먹을 때는 #ruby("현|직","現|職") #ruby[감사][時任監使]나 #ruby("수|령","守|令")이라도 말에서 내려 #ruby("인|삿","人|事")말을 건넨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|개","大|槪")의 #ruby("노|동|자","勞|動|者")들에게 #ruby("조|직","組|織")이 있어, 논 #ruby("주|인","主|人")이 일꾼을 #ruby("고|용","雇|用")할 때는 그 #ruby("지|방","地|方") #ruby("조|직","組|織")의 #ruby("우두머리","有司: 廳首")와 #ruby("교|섭","交|涉")하여 일꾼을 #ruby("결|정","決|定")하게 된다. 일꾼을 #ruby("결|정","決|定")할 때, 미리 #ruby("의|복","衣|服")·품삯·#ruby("휴|식","休|息")·#ruby("질|병","疾|病") #ruby("등","等")에 #ruby("대","對")한 #ruby("조|건","條|件")을 #ruby("정","定")하고, #ruby("실|제","實|際") #ruby("감|독","監|督")은 그 우두머리가 맡아 한다. #ruby("만|일","萬|一") 일꾼이 #ruby("태|만","怠|慢")하여도 논 #ruby("주|인","主|人")이 마음대로 #ruby("책|벌","責|罰")하지 못하고 우두머리에게 #ruby("고|발","告|發")하여 #ruby("징|계","懲|戒")한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("반|상","班|常")의 #ruby("구|별","區|別")이 그같이 #ruby("심","甚")하지만, #ruby("정|월","正|月") #ruby("초|승","初|生")과 #ruby("팔|월","八|月") #ruby("중|추","仲|秋")에는 동네와 동네 #ruby("중|간","中|間")에 나무기둥이나 돌기둥을 세우고, 그 기둥에 동아줄을 매고 #ruby("각|기","各|其") #ruby("자|기","自|己") 동네로 #ruby("향","向")하여 기둥 끝이 눕도록 #ruby("경|쟁","競|爭")을 한다. 이때에는 #ruby("남|녀|노|소","男|女|老|少") #ruby("반|상","班|常")의 #ruby("구|별","區|別")이 없이 즐겁게 #ruby("용|기","勇|氣")를 내어 논다고 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("고|금|도","古|今|島")#footnote(numbering: _ => [44)])[#h(0.35em)#ruby("완|도","莞|島")와 #ruby("조|약|도","助|藥|島") 사이에 있는 섬. 옛것을 #ruby("숭|상","崇|尙")한 #ruby("도|덕|군|자","道|德|君|子")가 많은 곳이라 하여 #ruby("고|금|도","古|今|島")라 불린다.]에서 #ruby("충|무|공","忠|武|公")의 #ruby("전|적","戰|蹟")을 둘러보았고, #ruby("금|산","錦|山")에서는 #ruby("조|중|봉","趙|重|峯")의 #ruby("패|적|유|지","敗|績|遺|址")#footnote(numbering: _ => [45)])[#h(0.35em)#ruby("중|봉","重|峯")은 #ruby("조|선","朝|鮮") #ruby("선|조","宣|祖") 때의 #ruby("학|자","學|者")요 #ruby("의|병|장","義|兵|將")이었던 #ruby("조|헌","趙|憲")\(1544〜1592)의 #ruby("호","號"). #ruby("임|진|왜|란","壬|辰|倭|亂") 때 #ruby("옥|천","沃|川")·#ruby("홍|성","洪|城")에서 #ruby("의|병","義|兵")을 일으켜 #ruby("금|산|전|투","錦|山|戰|鬪")에서 싸우다가 700#ruby("명","名") #ruby("의|병","義|兵")과 함께 #ruby("전|사","戰|死")하였다. #ruby("패|적|유|지","敗|績|遺|址")는 #ruby("칠|백|의|총","七|百|義|塚")을 말한다.]를 보았으며, #ruby("공|주","公|州")에서는 #ruby("승","僧") #ruby("영|규","靈|奎")의 #ruby("비","碑")#footnote(numbering: _ => [46)])[#h(0.35em)#ruby("영|규","靈|奎")\(?〜1592)는 #ruby("조|선","朝|鮮") #ruby("선|조","宣|祖") 때의 #ruby("고|승","高|僧"). #ruby("임|진|왜|란","壬|辰|倭|亂") 때 #ruby("승|병|장","僧|兵|將")이 되어 #ruby("분|전","奮|戰")한 끝에 마침내 #ruby("청|주|성","淸|州|城")을 #ruby("수|복","收|復")하였다. #ruby("조|헌","趙|憲")과 함께 #ruby("금|산|전|투","錦|山|戰|鬪")에 #ruby("참|가","參|加")하여 #ruby("전|사","戰|死")하였다. #ruby("금|산","錦|山") #ruby("남","南")쪽 #ruby("진|락|산","珍|樂|山") 기슭에 그의 #ruby("영|정","影|幀")을 #ruby("안|치","安|置")한 #ruby("진|영|각","眞|影|閣")과 #ruby("비","碑")가 있다.]를 보고 많은 느낌을 받았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("임|실","任|實")에서 #ruby("전|주","全|州")를 #ruby("향","向")하던 #ruby("도|중","途|中"), #ruby("당|현","堂|峴")#footnote(numbering: _ => [47)])[#h(0.35em)#ruby("원|주","原|註"): “#ruby("전|주","全|州")와 #ruby("임|실","任|實")의 #ruby("중|간","中|間")에 있는 큰 고개”. #ruby("지|금","只|今")의 #ruby("임|실|군","任|實|郡") #ruby("관|촌|면","官|村|面") 슬치재를 가리키는 듯하다.]을 넘으려 할 즈음이었다. #ruby("풍|채","風|采")가 #ruby("부|잣","富|者")집 #ruby("주|인","主|人") 같아 보이는 마흔 남짓의 #ruby("중","中")늙은이 한 사람을 만나게 되었다. 혼자서 나귀를 몰고 가다가 고개 밑에서부터 나귀에서 내려 걷기 #ruby("시|작","始|作")했는데, #ruby("자|연","自|然") #ruby("동|행","同|行")이 되어 #ruby("인|사","人|事")를 하니 #ruby("임|실","任|實") #ruby("읍|내","邑|內")에 사는 #ruby("문|지|래","文|之|來")라는 사람이었다. 같이 이야기를 하다가 고개 위에 #ruby("당|도","當|到")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[고개 위에는 네댓 채의 #ruby("주|점","酒|店")이 있었다. 그날이 #ruby("전|주","全|州") #ruby("장","場")날이었으므로 #ruby("보|부|상","褓|負|商") #ruby("수|십","數|十") #ruby("명","名")이 #ruby("장","場")에 갔다가 돌아오는 길인지 고개 위 #ruby("주|점","酒|店") #ruby("근|처","近|處")에서 다리를 쉬고 있었다. #ruby("문|지|래","文|之|來")가 고개 위에 #ruby("도|착","到|着")하자 #ruby("주|점","酒|店") #ruby("주|인","主|人")이 나와서 #ruby("오|위|장","五|衛|將") #ruby("영|감","令|監") 오시느냐고 반가이 나와 #ruby("영|접","迎|接")을 한다. 들어가 술이나 한 #ruby("잔","盞") 자시라고 #ruby("권","勸")하나 #ruby("문|씨","文|氏")는 #ruby("사|양","辭|讓")하더니 내게 같이 쉬어가자고 #ruby("청","請")하였다. #ruby("문|씨","文|氏")에게 달리 #ruby("환|영","歡|迎")하는 사람이 없었다면 #ruby("동|행|중","同|行|中")에 술이나 한 #ruby("잔","盞")씩 먹자고 #ruby("청","請")하는데 #ruby("사|양","辭|讓")할 #ruby("이|유","理|由")가 없었을 것이다. 그러나 #ruby("문|씨","文|氏")는 #ruby("주|점","酒|店") #ruby("주|인","主|人")에게 #ruby("환|대","歡|待")를 받는 #ruby("처|지","處|地")인 #ruby("모|양","模|樣")이었으므로 굳이 #ruby("사|양","辭|讓")하고 고개 위를 넘었다. 해가 #ruby("서|산","西|山") 마루에 걸려 뉘엿뉘엿하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("급","急")히 걸어 #ruby("완|주|군","完|州|郡") #ruby("상|관","上|關")의 #ruby("주|점","酒|店")에 와서 들었다. 저녁밥을 먹고 앉아 담배를 피울 때쯤 #ruby("급|보","急|報")가 왔다. 오늘 해 지기 #ruby("직|전","直|前")에 고개 위에 30#ruby("여","餘") #ruby("명","名")의 #ruby("강|도","强|盜")가 나타나서 #ruby("행|상","行|商")들의 #ruby("재|물","財|物")을 #ruby("약|탈","掠|奪")했는데, #ruby("문|오|위|장","文|五|衛|將")은 #ruby("취|중","醉|中")에 그 #ruby("강|도","强|盜")들을 보고 #ruby("호|령","號|令")하다가 #ruby("강|도","强|盜")떼가 내려치는 도끼에 맞아 죽었다고 한다. 한 #ruby("번","番") 내려칠 때 #ruby("두|골","頭|骨")이 두 쪽으로 갈라지고, 두#ruby("번","番")째 칠 때 머리와 몸이 세 도막 나는 #ruby("참|사","慘|事")가 생겼던 것이다. #ruby("만|약","萬|若") 그때 내가 #ruby("문|씨","文|氏")의 손에 끌려 술자리를 같이 했으면 내 목숨이 어찌 되었을까? #ruby("심","甚")히 놀라운 일이었다. 들으니 #ruby("문|씨","文|氏")는 #ruby("임|실","任|實") #ruby("서|리|배","書|吏|輩")라 한다. #ruby("자|기","自|己") #ruby("친","親")아우가 #ruby("민|영|준","閔|泳|駿")#footnote(numbering: _ => [48)])[#h(0.35em)#ruby("민|영|휘","閔|泳|徽")\(1852〜1935). #ruby("초|명","初|名")이 #ruby("영|준","泳|駿"). #ruby("개|화|기","開|化|期") 때 #ruby("민|씨","閔|氏") #ruby("척|당","戚|黨")의 #ruby("중|심|인|물","中|心|人|物"). 1906#ruby("년","年") #ruby("휘|문|학|교","徽|文|學|校")를 #ruby("설|립","設|立")하고 1910#ruby("년","年") #ruby("이|후","以|後") #ruby("일|본","日|本") #ruby("정|부","政|府")로부터 #ruby("자|작","子|爵") #ruby("작|위","爵|位")를 받았다.]의 #ruby("신|임","信|任")을 받는 #ruby("청","廳")지기인데, 그 #ruby("권|위","權|威")를 가지고 #ruby("부|근","附|近")의 #ruby("인|심","人|心")을 잃은 탓에 이#ruby("번","番") #ruby("화","禍")를 만났다고들 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|주","全|州")에서 본 것은 이런 것이다. #ruby("전|주","全|州")에서는 #ruby("관|리","官|吏")와 #ruby("사|령","使|令")이 서로 #ruby("원|수|지|간","怨|讐|之|間")이기 때문에 #ruby("당|시","當|時") #ruby("진|위|대","鎭|衛|隊")#footnote(numbering: _ => [49)])[#h(0.35em)#ruby("대|한|제|국","大|韓|帝|國") 때의 #ruby("군|대","軍|隊") 이름. 1895#ruby("년","年")에 #ruby("지|방|대","地|方|隊")를 고쳐서 #ruby("진|위|대","鎭|衛|隊")라 일컫다가 1907#ruby("년","年")에 #ruby("폐|지","廢|止")되었다.] #ruby("병|정","兵|丁")을 #ruby("모|집","募|集")하는데 #ruby("사|령","使|令")이 #ruby("입|영","入|營")될까 두려워하여 #ruby("영|리","營|吏")의 #ruby("자|식","子|息")과 조카들을 #ruby("전|부","全|部") #ruby("병|정","兵|丁")으로 몰아넣었다고 한다. 머리에는 상투를 그대로 두고 그 위에 #ruby("군|모","兵|帽")를 높직하게 만들어 쓰고 있었다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[3) #ruby("출|세|간","出|世|間")의 길]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다시 #ruby("공|주","公|州") #ruby("이|서|방","李|書|房")과 #ruby("갑|사","甲|寺")에서부터 #ruby("동|행","同|行")하던 #ruby("중","中")에 있었던 일을 쓰고자 한다. #ruby("이|서|방","李|書|房")은 홀아비로 몇 #ruby("년","年") 동안 #ruby("사|설","私|設") #ruby("글|방","私|塾")의 #ruby("훈|장","訓|長")으로 지냈고, #ruby("지|금","只|今")은 #ruby("마|곡|사","麻|谷|寺")로 가서 중이나 되어 #ruby("일|생","一|生")을 #ruby("편|안","便|安")하게 지내려는 #ruby("의|향","意|向")을 가지고 있었다. 내게도 그리 하기를 #ruby("권","勸")했는데, 나도 얼마간 뜻이 없는 것은 아니었으나 갑작스레 생긴 #ruby("문|제","問|題")였으므로 섣불리 #ruby("결|정","決|定")할 수 없어서 이야기만 하였다. 하루 #ruby("종|일","終|日") 걸어서 #ruby("마|곡|사","麻|谷|寺") #ruby("남","南")쪽 #ruby("산","山")꼭대기에 오르니, 해는 #ruby("황|혼","黃|昏")인데 온 #ruby("산","山")에 #ruby("단|풍","丹|楓")잎은 누릇누릇 불긋불긋하였다. #ruby("유|자|비|추|풍","遊|子|悲|秋|風")인데다가,#footnote(numbering: _ => [50)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “가을 바람에 나그네의 마음은 슬프기만 한데”.] 저녁 안개가 #ruby("산","山")밑에 있는 #ruby("마|곡|사","麻|谷|寺")를 마치 자물쇠로 채운 듯이 둘러싸고 있는 #ruby("풍|경","風|景")을 보니, 나같이 온갖 #ruby("풍|진","風|塵") 속에서 오락가락하는 #ruby("자","者")의 더러운 발은 싫다고 #ruby("거|절","拒|絶")하는 듯하였다. 그러나 또 한#ruby("편","便")으로는, 저녁 #ruby("종","鐘")소리가 안개를 헤치고 나와 내 귀에 와서 모든 #ruby("번|뇌","煩|勞")를 #ruby("해|탈","解|脫")하고 #ruby("입|문","入|門")하라는 #ruby("권|고","勸|告")를 들려주는 듯하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|서|방","李|書|房")은 #ruby("결|정|적","決|定|的")으로 다시 내 #ruby("의|사","意|思")를 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("노|형","老|兄"), 어찌 하시려오? #ruby("세|상|사","世|上|事")를 다 잊고 중이 되십시다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이 자리에서 #ruby("노|형","老|兄")과 #ruby("결|정","決|定")하면 무슨 #ruby("필|요","必|要")가 있겠소? #ruby("일|단","一|旦") 절에 들어가 봐서 중이 되려는 #ruby("자","者")와 중을 만들 #ruby("자","者") 사이에 #ruby("의|견","意|見")이 맞아야 할 것 아니오?”]
