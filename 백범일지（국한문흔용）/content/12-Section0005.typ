#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이른바, #ruby("항|자|불|살|격","降|者|不|殺|格")으로#footnote(numbering: _ => [82)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("항|복","降|伏")하는 #ruby("자","者")는 죽이지 못한다는 #ruby("격","格")으로”.] #ruby("훈|장","訓|長")이 한#ruby("편","便")으로는 나를 꾸짖고 또 한#ruby("편","便")으로는 그 #ruby("시|객","詩|客")을 타일러 #ruby("근|근","僅|僅")히 일이 #ruby("조|용","從|容")하게 #ruby("해|결","解|決")되었다. 나는 다시 내게 #ruby("죄","罪")를 묻는 일이 생길까 #ruby("염|려","念|慮")하여 그날 일을 시키는 대로 #ruby("공|손","恭|遜")히 하며 마음 졸이며 지냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[술이 #ruby("반","半")쯤 #ruby("취","醉")하자 #ruby("훈|장","訓|長") #ruby("김|우|석","金|愚|石")으로부터 #ruby("시|작","始|作")하여 거기 모인 #ruby("시|인","詩|人")들이 #ruby("풍|축","風|軸")#footnote(numbering: _ => [83)])[#h(0.35em)#ruby("풍","風")은 노래 또는 #ruby("시","詩"). #ruby("풍|축","風|軸") 또는 #ruby("시|축","詩|軸")은 무리 지어 #ruby("시","詩")를 적는 두루마리 종이.]을 펼치고 #ruby("시","詩")를 짓거나 쓰면서 큰소리로 #ruby("낭|송","朗|誦")하고 있었다. 술 부어 올리고 물 갖다 바치는 동안 #ruby("주|의","注|意")를 기울여서 살펴보니 글씨부터 #ruby("촌","村")티가 나는데, #ruby("소|위","所|謂") #ruby("절|창","絶|唱")이니 #ruby("득|의|작","得|意|作")이니 하고 떠드는 것을 보니 노리고 고린#footnote(numbering: _ => [84)])[#h(0.35em)#ruby("원|문","原|文"): “노리고 고린 수작이 만타.” 하는 짓이 잘고(노리다) 치사하다(고리다).] #ruby("수|작","酬|酌")이 많았다. 나는 비록 #ruby("전","前")에 #ruby("시","詩")를 #ruby("전|공","專|攻")하지 않았으나, #ruby("최|재|학","崔|在|學")과 만나 같이 다닌 #ruby("후","後")로 #ruby("종|종","種|種") #ruby("산|사","山|寺")에서 #ruby("호|정","湖|亭") #ruby("노|동|항","盧|東|恒")의 #ruby("시|축","詩|軸") 글씨를 보았고, 또 #ruby("왕|파","汪|波") #ruby("황|경|환","黃|景|煥")과 #ruby("김|성|석","金|醒|石") #ruby("등","等") #ruby("당|시","當|時") #ruby("평|양","平|壤")의 #ruby("일|류","一|流") #ruby("명|사","名|士")들과 몇 달#ruby("간","間") 사귀게 되어 #ruby("시","詩")나 글씨에 #ruby("대","對")한 #ruby("약|간","若|干")의 #ruby("조|예","造|詣")를 터득하고 있었다. #ruby("훈|장","訓|長")에게 #ruby("청","請")하였다.]
