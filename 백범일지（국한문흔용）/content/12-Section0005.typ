#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[거기서 #ruby("경|상|도","慶|尙|道") #ruby("풍|기","豊|基")에서 온 #ruby("혜|정","慧|定")이란 중을 만났는데, #ruby("평|양","平|壤") #ruby("강|산","江|山")이 좋다기에 #ruby("구|경","求|景")을 간다고 했다. 나는 그와 #ruby("동|행","同|行")하기로 #ruby("약|조","約|條")하고, #ruby("서","西")쪽으로 #ruby("임|진|강","臨|津|江")을 건너 #ruby("송|도","松|都")를 #ruby("구|경","求|景")하고, #ruby("해|주","海|州") #ruby("감|영","監|營")부터 #ruby("구|경","求|景")하고 #ruby("평|양","平|壤")으로 가기로 하였다. #ruby("수|양|산","首|陽|山")에 들어가 #ruby("신|광|사","神|光|寺") #ruby("부|근","附|近") #ruby("북|암","北|菴")에 머물면서 #ruby("혜|정","慧|定")에게 내 #ruby("사|정","事|情")을 #ruby("약|간","若|干") 이야기하고 #ruby("부|탁","付|託")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("텃|골","基|洞") #ruby("본|가","本|家")에 가서 내 #ruby("부|모","父|母")님을 #ruby("비|밀","祕|密")히 #ruby("방|문","訪|問")하여 주오. #ruby("안|부","安|否")만 물어보고 내 몸이 #ruby("건|재","健|在")함을 말씀드리되 내가 #ruby("지|금","只|今") 어느 곳에 있는 것까지는 아직 말하지 마시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("혜|정","慧|定")을 떠나 보내고 #ruby("소|식","消|息") 돌아오기만 기다리던 #ruby("중","中"), 4#ruby("월","月") 29#ruby("일","日") 저녁 무렵이었다. #ruby("혜|정","慧|定")의 뒤를 따라 #ruby("부|모","父|母")님 두 분이 #ruby("북|암","北|菴")으로 들어오셨다. #ruby("부|모","父|母")님은 #ruby("혜|정","慧|定")이 #ruby("전","傳")하는 #ruby("자|식","子|息")의 #ruby("안|부","安|否")를 듣자,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 내 아들이 있는 곳을 알고 왔을 터이니, 너를 따라가면 내 #ruby("자|식","子|息")을 볼 수 있을 것이다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하시고, 바로 #ruby("혜|정","慧|定")을 따라오신 것이었다. #ruby("급|기|야","及|其|也")는 아들이 있는 곳까지 따라오셨는데, 와서 보니 돌중놈이 되어 있었다. 세 #ruby("식|구","食|口")가 다시 만나니 기쁘기도 하고 슬프기도 하여 서로 붙들고 눈물을 흘렸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("북|암","北|菴")에서 5#ruby("일","日") 동안 #ruby("휴|식","休|息")하고, 중의 #ruby("행|색","行|色") 그대로 #ruby("부|모","父|母")님을 모시고 #ruby("혜|정","慧|定")과 같이 #ruby("평|양","平|壤") #ruby("구|경","求|景")을 떠났다. 가는 길에 그 동안 #ruby("부|모","父|母")님께서 겪으셨던 일을 말씀해 주셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("무|술|년","戊|戌|年")\(1898) 3#ruby("월","月") 9#ruby("일","日")에 #ruby("인|천","仁|川")을 떠나 집에 #ruby("도|착","到|着")하자마자 #ruby("인|천","仁|川") #ruby("순|검","巡|檢")이 곧 뒤를 따라와서 #ruby("체|포","逮|捕")되셨다고 한다. 3#ruby("월","月") 13#ruby("일","日")에 #ruby("부|모","父|母")님 두 분 다 #ruby("인|천|옥","仁|川|獄")에 갇히게 되셨는데, 거기서 갖은 #ruby("형|벌","刑|罰")을 다 당하셨다. 어머님은 곧 #ruby("석|방","釋|放")되시고 아버님은 석 달 뒤에야 #ruby("석|방","釋|放")되셔서, #ruby("내|외|분","內|外|分") 같이 #ruby("고|향","故|鄕")으로 돌아가셨다.#footnote(numbering: _ => [72)])[#h(0.35em)1898#ruby("년","年") 3#ruby("월","月") #ruby("말","末") #ruby("백|범","白|凡")이 #ruby("탈|옥","脫|獄")하자 #ruby("법|부","法|部")에서 #ruby("백|범","白|凡") #ruby("대|신","代|身") 아버지를 #ruby("구|속","拘|束")하였고, 어머니는 #ruby("남|편","男|便")의 #ruby("석|방","釋|放")을 #ruby("소|장","訴|狀")으로 두 #ruby("번","番") #ruby("탄|원","歎|願")하였다. #ruby("백|범","白|凡")의 아버지는 1#ruby("년","年") #ruby("정|도","程|度") #ruby("징|역","懲|役")살이를 하였으며 1899#ruby("년","年") 3#ruby("월","月")에 #ruby("석|방","釋|放")되었다.]]
