#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("소|승","小|僧")이 #ruby("이|왕","已|往") 중이 된 #ruby("이|상","以|上"), 중이 #ruby("응|당","應|當") 해야 할 #ruby("공|부","工|夫")를 해야 되지 않겠습니까? #ruby("금|강|산","金|剛|山")으로 가서 #ruby("경|전","經|典")의 #ruby[뜻][經旨]이나 #ruby("연|구","硏|究")하고, #ruby("일|생","一|生") #ruby("충|실","充|實")한 #ruby("불|자","佛|者")가 되겠습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 벌써 #ruby("추|측","推|測")은 하고 있었다. 어쩔 수 있느냐? 네 #ruby("원","願")이 그런 데야.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("즉|시","卽|時") #ruby("하|은|당","荷|隱|堂")을 불러 둘이 한참 다투더니 #ruby("세|간","世|間")을 내어주었다. #ruby("백|미","白|米") 열 말과 #ruby("의|발","衣|鉢")#footnote(numbering: _ => [69)])[#h(0.35em)#ruby("가|사","袈|裟")와 바리때(나무로 만든 중의 밥그릇). 스님이 지녀야 할 #ruby("최|소|한","最|少|限")의 #ruby("생|활|도|구","生|活|道|具").]을 주어 큰#ruby("방","房")으로 내보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날부터 #ruby("자|유","自|由")였다. #ruby("백|미","白|米") 열 말을 팔아서 #ruby("여|비","旅|費")를 해 가지고 #ruby("경|성","京|城")으로 #ruby("출|발","出|發")하였다. 며칠 #ruby("후","後") #ruby("경|성","京|城")에 #ruby("도|착","到|着")하였으나 그때까지는 중이 #ruby("경|성","京|城") #ruby("문","門") 안으로 발을 들이는 것을 나라에서 #ruby("금","禁")하던 #ruby("중","中")이었다. #ruby("성|곽","城|郭") 바깥쪽으로 이 절 저 절 다니다가 #ruby("서|문","西|門") 밖에 있는 새 절#footnote(numbering: _ => [70)])[#h(0.35em)#ruby("서|대|문|구","西|大|門|區") #ruby("봉|원|사","奉|元|寺").]에 가서 하루 묵게 되었는데, 거기서 #ruby("사|형","師|兄")#footnote(numbering: _ => [71)])[#h(0.35em)같은 스승 밑에서 #ruby("불|법","佛|法")을 #ruby("전|수","傳|受")받은 #ruby("동|료","同|僚")나 #ruby("선|배","先|輩").] #ruby("혜|명","慧|明")을 만났다. #ruby("혜|명","慧|明")은 나더러 물었다.]
