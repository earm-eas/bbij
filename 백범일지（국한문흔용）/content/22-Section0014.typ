#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리하여 #ruby("총|사|령|부","總|司|令|部")를 #ruby("중|경","重|慶")에 #ruby("설|치","設|置")하고, #ruby("총|사|령","總|司|令") #ruby("이|청|천","李|靑|天"), #ruby("참|모|장","參|謀|長") #ruby("중|국|인","中|國|人"), #ruby("재|무|과|장","財|務|課|長") #ruby("중|국|인","中|國|人"), #ruby("고|급|참|모","高|級|參|謀") #ruby("최|용|덕","崔|用|德"), #ruby("한|인|참|모|장","韓|人|參|謀|長") #ruby("왕|일|서","王|逸|曙"),#footnote(numbering: _ => [5)])[#h(0.35em)#ruby("왕|일|서","王|逸|曙")는 #ruby("김|홍|일","金|弘|壹")의 #ruby("중|국|식","中|國|式") 이름. #ruby("윤|봉|길","尹|奉|吉") #ruby("의|거","義|擧") #ruby("직|후","直|後") #ruby("김|홍|일","金|弘|壹")은 #ruby("왜|경","倭|警")의 눈을 #ruby("피","避")하기 위하여 #ruby("종|전","從|前")의 #ruby("중|국|식","中|國|式") 이름인 #ruby("왕|웅","王|雄")을 다시 #ruby("왕|일|서","王|逸|曙")로 고쳤다.] #ruby("제","第")1#ruby("지|대|장","支|隊|長") #ruby("김|원|봉","金|元|鳳"), #ruby("제","第")2#ruby("지|대|장","支|隊|長") #ruby("이|범|석","李|範|奭"), #ruby("제","第")3#ruby("지|대|장","支|隊|長") #ruby("김|학|규","金|學|奎")를 #ruby("임|명","任|命")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제","第")1#ruby("지|대","支|隊")는 #ruby("중|경","重|慶") #ruby("남|안","南|岸")에 #ruby("설|치","設|置")하니 #ruby("대|원","隊|員")이 50#ruby("명","名") #ruby("미|만","未|滿")이고, #ruby("제","第")2#ruby("지|대","支|隊")는 #ruby("섬|서|성","陝|西|省") #ruby("서|안","西|安") #ruby("남|부","南|部") #ruby("두|곡","杜|曲")에 #ruby("설|치","設|置")하니 #ruby("대|원","隊|員")이 200#ruby("여","餘") #ruby("명","名")이요, #ruby("제","第")3#ruby("지|대","支|隊")는 #ruby("안|휘|성","安|徽|省") #ruby("부|양","阜|陽")에 #ruby("설|치","設|置")하니 #ruby("대|원","隊|員")이 300#ruby("여","餘") #ruby("명","名")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[몇 #ruby("개|월","個|月") 동안은 #ruby("광|복|군","光|復|軍")이 #ruby("유|명|무|실","有|名|無|實")하여 #ruby("연|합|국","聯|合|國")의 #ruby("인|기","人|氣")를 끌 만한 아무것도 없었다. 그러던 어느 날 #ruby("홀|연","忽|然") 우리 #ruby("임|시|정|부","臨|時|政|府") #ruby("정|청","政|廳")으로 가슴에 #ruby("태|극|기","太|極|旗")를 붙이고 #ruby("일|제","一|齊")히 #ruby("애|국|가","愛|國|歌")를 부르며 들어서는 #ruby("일|단","一|團")의 #ruby("청|년","靑|年")들이 있었다. 이들은 #ruby("화|북","華|北") #ruby("각|지","各|地")의 #ruby("왜|군","倭|軍") #ruby("부|대","部|隊")를 #ruby("탈|주","脫|走")한 #ruby("한|인","韓|人") #ruby("학|병","學|兵") #ruby("청|년","靑|年")들인데, #ruby("부|양","阜|陽")으로 #ruby("탈|출","脫|出")하여 오는 것을 #ruby("제","第")3#ruby("지|대|장","支|隊|長") #ruby("김|학|규","金|學|奎")의 #ruby("지|령","指|令")으로 #ruby("정|부","政|府")에 #ruby("호|송","護|送")한 것이었다.#footnote(numbering: _ => [6)])[#h(0.35em)#ruby("장|준|하","張|俊|河")·#ruby("김|준|엽","金|俊|燁") #ruby("등","等") #ruby("학|병","學|兵") #ruby("출|신","出|身")들이 #ruby("중|경","重|慶") #ruby("임|시|정|부","臨|時|政|府")에 #ruby("도|착","到|着")한 것은 1945#ruby("년","年") 1#ruby("월","月") 31#ruby("일","日") #ruby("하|오","下|午")였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이것이 #ruby("중|경","重|慶")에는 커다란 #ruby("반|응","反|應")을 불러일으켰다. #ruby("중|국","中|國") #ruby("각|계","各|界") #ruby("인|사","人|士")들이 #ruby("중|한|문|화|협|회","中|韓|文|化|協|會")#footnote(numbering: _ => [7)])[#h(0.35em)1942#ruby("년","年") 10#ruby("월","月") #ruby("중|국","中|國") #ruby("국|민|당","國|民|黨") #ruby("측","側")의 #ruby("손|과","孫|科")·#ruby("오|철|성","吳|鐵|城"), #ruby("임|시|정|부","臨|時|政|府") #ruby("측","側")의 #ruby("이|시|영","李|始|榮")·#ruby("조|소|앙","趙|素|昂") #ruby("등","等") #ruby("각|계","各|界") #ruby("인|사","人|士") 300#ruby("여","餘") #ruby("명","名")이 모여 #ruby("조|직","組|織")한 #ruby("일|종","一|種")의 #ruby("한|국|독|립|운|동","韓|國|獨|立|運|動") #ruby("지|원|단|체","支|援|團|體")이다.]에서 50#ruby("여","餘") #ruby("명","名")의 #ruby("청|년","靑|年") #ruby("환|영|회","歡|迎|會")를 #ruby("개|최","開|催")하니, #ruby("서|양","西|洋") #ruby("각","各") #ruby("통|신|사","通|信|社") #ruby("기|자","記|者")들과 #ruby("각|국","各|國") #ruby("대|사|관|원","大|使|館|員")들도 #ruby("호|기|심","好|奇|心") 어린 눈길로 #ruby("참|석","參|席")하여 #ruby("청|년","靑|年")들에게 #ruby("수|시","隨|時")로 #ruby("문|답","問|答")하였다. 그#ruby("중","中") #ruby("중|요","重|要")한 #ruby("일|화","逸|話")는 한 #ruby("청|년","靑|年")의 다음과 같은 #ruby("답|변","答|辯")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리는 어렸을 때부터 #ruby("일|본","日|本")의 #ruby("교|육","敎|育")을 받았습니다. 그런 까닭에 우리의 #ruby("역|사","歷|史")는 #ruby("고|사","姑|捨")하고 우리 #ruby("언|어","言|語")도 #ruby("능|숙","能|熟")치 못합니다. 그런데 #ruby("일|본","日|本")에 #ruby("유|학","留|學")#ruby("중","中") #ruby("징|병","徵|兵")으로 #ruby("출|전","出|戰")케 되어 #ruby("가|족","家|族")과 #ruby("이|별","離|別")#ruby("차","次") #ruby("귀|가","歸|家")하였더니, #ruby("부|모","父|母")와 #ruby("조|부|모","祖|父|母")들이 #ruby("비|밀","祕|密")히 #ruby("교|훈","敎|訓")하기를 ‘우리의 #ruby("독|립|정|부","獨|立|政|府")가 #ruby("중|경","重|慶")에 있으니, #ruby("왜|군","倭|軍") 앞잡이로 끌려다니다가 개죽음을 하지 말고 우리 #ruby("정|부","政|府")를 찾아가서 #ruby("독|립|전|쟁","獨|立|戰|爭")을 하다가 #ruby("영|광","榮|光")스러운 죽음을 하라’는 #ruby("명","命")을 받았습니다. 이 말에 따라 #ruby("일|본","日|本") #ruby("부|대","部|隊")에서 #ruby("탈|주","脫|走")하다가 더러는 죽고 더러는 살아 우리 #ruby("정|부","政|府")를 찾아온 것입니다.”#footnote(numbering: _ => [8)])[#h(0.35em)#ruby("일|본|군","日|本|軍") #ruby("탈|출","脫|出") #ruby("학|병","學|兵")들에 대한 #ruby("공|식","公|式") #ruby("환|영|식","歡|迎|式")은 1945#ruby("년","年") 2#ruby("월","月") 5#ruby("일","日") #ruby("임|정","臨|政") #ruby("청|사","廳|舍") 1#ruby("층","層") #ruby("식|당","食|堂")에서 #ruby("개|최","開|催")되었고, 이날 #ruby("학|병","學|兵")을 #ruby("대|표","代|表")하여 #ruby("답|사","答|辭")한 #ruby("인|물","人|物")은 #ruby("장|준|하","張|俊|河")였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 말에 #ruby("한|인","韓|人") #ruby("동|포","同|胞")는 말할 것도 없고 #ruby("연|합|국","聯|合|國") #ruby("인|사","人|士")들까지도 #ruby("감|격","感|激")에 넘쳤던 #ruby("모|양","模|樣")이다.#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("임|시|정|부","臨|時|政|府") #ruby("선|전|부","宣|傳|部") #ruby("비|서","祕|書")로 #ruby("중|한|문|화|협|회","中|韓|文|化|協|會") #ruby("비|서","祕|書")도 #ruby("겸|임","兼|任")하고 있었던 안병무의 #ruby("회|고","回|顧")에 의하면, #ruby("미|군","美|軍") 윔쓰 #ruby("대|위","大|尉")가 #ruby("백|범","白|凡")에게 “#ruby("선|생","先|生")님, 호박이 넝쿨째 뚝 떨어졌습니다”고 할 #ruby("정|도","程|度")로 #ruby("학|병","學|兵")들의 #ruby("중|경","重|慶") #ruby("도|착","到|着")은 #ruby("내|외","內|外")에 큰 #ruby("반|향","反|響")을 불러일으켰다.]]
