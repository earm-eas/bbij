#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜|적","倭|敵")이 #ruby("투|항","投|降")한 #ruby("후","後") #ruby("고|국","故|國")에 돌아갈 #ruby("준|비","準|備")로 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("역|사|적","歷|史|的") #ruby("문|서","文|書")를 #ruby("정|리","整|理")하고, #ruby("국|무|위|원","國|務|委|員")과 #ruby("일|반|직|원","一|般|職|員")이 #ruby("비|행|기","飛|行|機") 두 #ruby("대","臺")에 #ruby("분|승","分|乘")하게 되었다. 11#ruby("월","月") 5#ruby("일","日")에 나는 #ruby("선|발","先|發")로 13#ruby("년","年") #ruby("전","前")에 떠났던 #ruby("상|해","上|海")의 #ruby("공|기","空|氣")를 다시 #ruby("호|흡","呼|吸")하게 되었다. #ruby("중|경","重|慶") #ruby("출|발","出|發") 5#ruby("시|간","時|間") #ruby("후","後") #ruby("상|해","上|海")에 #ruby("착|륙","着|陸")하니 #ruby("오|후","午|後") 6#ruby("시","時")였다. #ruby("비|행|장","飛|行|場")에는 #ruby("내|외","內|外") #ruby("친|우","親|友")들이 #ruby("환|영","歡|迎")하여 #ruby("남|녀","男|女")를 #ruby("막|론","莫|論")하고 #ruby("인|산|인|해","人|山|人|海")를 이루었는데, 그 #ruby("비|행|장","飛|行|場")은 바로 #ruby("홍|구","虹|口") #ruby("신|공|원","新|公|園")이었다. 그#ruby("간","間") #ruby("왜|영|사|관","倭|領|事|館")이 #ruby("인|접","隣|接")한 까닭에 #ruby("상|해|생|활","上|海|生|活") 14#ruby("년","年") 동안에도 #ruby("신|공|원","新|公|園")에 가 본 것은 난#ruby("생","生") 처음이었다.#footnote(numbering: _ => [31)])[#h(0.35em)#ruby("홍|구|공|원","虹|口|公|園")은 #ruby("현|재","現|在") #ruby("루|쉰","魯|迅") #ruby("공|원","公|園")으로 바뀌었다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("신|공|원","新|公|園")을 물러나와 #ruby("시|내","市|內")로 들어갈 때 #ruby("상|해","上|海")에 #ruby("거|주","居|住")하는 #ruby("동|포","同|胞") 6,000#ruby("여","餘") #ruby("명","名")이 아침 6#ruby("시","時")부터 저녁 6#ruby("시","時")까지 #ruby("도|열","堵|列")하여 내가 오기를 #ruby("고|대","苦|待")한다 하여 #ruby("차","車")를 멈추고 나가보았다. 그곳에는 한 #ruby("장","丈") 높이의 #ruby("축|대","築|臺")가 있는데, 나는 그#ruby("단","壇") 위에 올라서서 #ruby("동|포","同|胞")를 #ruby("향","向")하여 인삿말을 하고 #ruby("시|내","市|內") #ruby("양|자|반|점","楊|子|飯|店")에서 #ruby("유|숙","留|宿")하였다.#footnote(numbering: _ => [32)])[#h(0.35em)#ruby("임|정","臨|政") #ruby("국|무|위|원","國|務|委|員")을 #ruby("역|임","歷|任")한 #ruby("조|경|한","趙|擎|韓")과 #ruby("당|시","當|時") #ruby("백|범","白|凡")의 #ruby("수|행|비|서","隨|行|祕|書")였던 #ruby("선|우|진","鮮|于|鎭")의 #ruby("회|고","回|顧")에 의하면 #ruby("임|정","臨|政") #ruby("요|인","要|人")들은 #ruby("상|해|반|점","上|海|飯|店")과 #ruby("양|자|반|점","楊|子|飯|店")에 나누어 #ruby("거|처","居|處")하였고, #ruby("백|범","白|凡")은 #ruby("중|국|인","中|國|人") #ruby("별|장","別|莊") 하나를 얻어 #ruby("엄|항|섭","嚴|恒|燮")과 #ruby("별|도","別|途")로 #ruby("거|처","居|處")하였다고 한다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("시|내","市|內")에 들어와서 알고 보니 그 #ruby("신|공|원","新|公|園") #ruby("축|대","築|臺") 위에 올라 #ruby("인|사","人|事")하던 곳이 바로 13#ruby("년","年") #ruby("전","前") #ruby("윤|봉|길","尹|奉|吉") #ruby("의|사","義|士")가 #ruby("왜|적","倭|敵") #ruby("시라카와","白川") #ruby("등","等")을 #ruby("폭|살","爆|殺")한 곳이었다. #ruby("왜|적","倭|敵")들이 그곳을 #ruby("기|념","紀|念")하기 위하여 #ruby("군|사|훈|련","軍|事|訓|鍊") #ruby("장|교","將|校")들의 #ruby("지|휘|대","指|揮|臺")로 #ruby("사|용","使|用")하였다 하니, 이 말을 들었을 때 13#ruby("년","年") #ruby("전","前") 그날의 #ruby("기|억","記|憶")이 새로워 #ruby("감|개|무|량","感|慨|無|量")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("세|상|만|사","世|上|萬|事")가 어찌 모두 #ruby("무|심","無|心")하고 #ruby("우|연","偶|然")이라 하리오. #ruby("상|해","上|海")에 #ruby("거|주","居|住")하는 #ruby("동|포","同|胞") #ruby("수","數")가 13#ruby("년","年") #ruby("전","前")보다 몇#ruby("십","十") #ruby("배","倍")나 #ruby("증|가","增|加")되었으나 #ruby("왜|적","倭|敵")과의 #ruby("전|쟁","戰|爭")으로 인한 #ruby("생|활|난","生|活|難")의 #ruby("고|통","苦|痛")으로 인하여 #ruby("각|종","各|種") #ruby("공|장","工|場")과 #ruby("사|업","事|業") #ruby("방|면","方|面")에서 #ruby("부|정","不|正")한 #ruby("업|자","業|者")가 #ruby("속|출","續|出")하였다. 이와 같은 #ruby("상|황","狀|況")에서 #ruby("이|전","以|前")의 #ruby("독|립|정|신","獨|立|精|神")을 굳게 지키며 #ruby("왜","倭")놈의 앞잡이가 되지 않은 사람들은 #ruby("선|우|혁","鮮|于|爀")·#ruby("장|덕|로","張|德|櫓")·#ruby("서|병|호","徐|炳|浩")·#ruby("한|진|교","韓|鎭|敎")·#ruby("조|봉|길","曹|奉|吉")·#ruby("이|용|환","李|龍|煥")·#ruby("하|상|린","河|相|麟")·#ruby("한|백|원","韓|栢|源")·#ruby("원|우|관","元|宇|觀") #ruby("등","等") #ruby("불|과","不|過") 10#ruby("여","餘") #ruby("인","人")에 #ruby("불|과","不|過")하였다. 그들의 굳은 #ruby("지|조","志|操")를 #ruby("가|상","嘉|尙")히 여겨 #ruby("서|병|호","徐|炳|浩") #ruby("자|택","自|宅")에서 #ruby("만|찬|회","晩|餐|會")를 #ruby("개|최","開|催")하고 #ruby("기|념|사|진","紀|念|寫|眞")을 #ruby("촬|영","撮|影")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("민|족|반|역|자","民|族|反|逆|者")로 #ruby("변|절","變|節")한 #ruby("안|준|생","安|俊|生")#footnote(numbering: _ => [33)])[#h(0.35em)#ruby("원|주","原|註"): “安俊生은 倭놈을 따라 本國에 도라와 倭敵 伊藤博邦에게 父親 義士의 罪를 謝하고 南總督을 애비라 稱하엿다.” #ruby("안|준|생","安|俊|生")은 #ruby("안|중|근","安|重|根")의 아들이며, ‘南總督’은 1936〜1942#ruby("년","年") #ruby("총|독","總|督")을 지낸 미나미 #ruby("지로","南次郞")이다.]을 #ruby("체|포","逮|捕")하여 #ruby("교|수|형","絞|首|刑")에 #ruby("처","處")하라 #ruby("중|국","中|國") #ruby("관|헌","官|憲")에게 #ruby("부|탁","付|託")하였으나 #ruby("관|원","官|員")들이 #ruby("실|행","實|行")치 않았다.]
