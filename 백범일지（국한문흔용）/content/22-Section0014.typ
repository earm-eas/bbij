#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("남|경","南|京")을 떠난 #ruby("후","後") #ruby("장|사","長|沙")에서 또 #ruby("누|차","屢|次") #ruby("폭|격","爆|擊")을 #ruby("당","當")하였으나 #ruby("별","別")로 #ruby("위|험","危|險")은 없었고, #ruby("광|동","廣|東") #ruby("역|시","亦|是") #ruby("위|험","危|險")은 없었다. #ruby("중|경","重|慶")에서는 4〜5#ruby("년","年") 동안 내내 그 #ruby("모|양","模|樣")으로 지내는 터인데, #ruby("침|식","寢|食")은 짬짬이 하고, 하는 일이란 오직 #ruby("피|난","避|難")뿐이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|경","重|慶")에서 #ruby("폭|격","爆|擊")을 #ruby("당","當")할 때에 #ruby("중|국","中|國")의 #ruby("국|민|성","國|民|性")이 #ruby("위|대","偉|大")한 것을 깨달았다. 높고 큰 #ruby("건|물","建|物")이 #ruby("삽|시|간","霎|時|間")에 재가 되는데도, 집#ruby("주|인","主|人")들은 한#ruby("편","便")으로 #ruby("가|족","家|族") #ruby("중","中") #ruby("피|살|자","被|殺|者")를 #ruby("매|장","埋|葬")하였고, 다른 한#ruby("편","便")으로 #ruby("생|존|자","生|存|者")들은 불 붙지 않은 나머지 기둥과 서까래를 모아 #ruby("임|시","臨|時") #ruby("가|옥","家|屋")을 #ruby("건|설","建|設")하였다. 그 일을 하는 #ruby("중","中")에 웃는 얼굴로 #ruby("비|장","悲|壯")한 빛을 보이지 아니하므로, 나는 그들을 볼 때 이러한 생각을 #ruby("금","禁")할 수 없었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘#ruby("만|일","萬|一") 우리 #ruby("동|포","同|胞")들이 저 #ruby("지|경","地|境")을 #ruby("당","當")하였다면 어떠할까? #ruby("화","火")가 나느니 성이 나느니, 홧김에 술을 마신다 성난 김에 싸움을 일으킨다 하여, #ruby("소|란","騷|亂")만 일으키고 #ruby("태|만","怠|慢")하지나 않을까.’]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|경","重|慶") #ruby("폭|격","爆|擊")이 더욱 #ruby("심","甚")해진 하루는 아침부터 저녁까지 #ruby("방|공|호","防|空|壕")에서 지냈다. 우리 #ruby("임|시|정|부","臨|時|政|府")도 #ruby("중|경","重|慶")을 떠날 때까지 네 #ruby("번","番") 옮겨다녔으니 그 #ruby("고|해|파|란","苦|海|波|瀾")만은 #ruby("영|원","永|遠")히 잊을 수 없다. #ruby("제","第")1#ruby("차","次")는 #ruby("양|류|가","楊|柳|街"), #ruby("제","第")2#ruby("차","次")는 #ruby("석|판|가","石|坂|街"), #ruby("제","第")3#ruby("차","次")는 #ruby("오|사|야|항","吳|師|爺|巷"), 마지막 #ruby("제","第")4#ruby("차","次")는 #ruby("연|화|지","蓮|花|池")에서 보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("양|류|가","楊|柳|街")에서는 #ruby("폭|격","爆|擊")으로 인하여 더 #ruby("이|상","以|上") 버틸 수가 없어서 #ruby("석|판|가","石|坂|街")로 #ruby("이|전","移|轉")하였다. 그랬는데 #ruby("석|판|가","石|坂|街")에서는 #ruby("화|재","火|災")로 #ruby("건|물","建|物")이 #ruby("전|소","全|燒")되는 바람에 #ruby("심|지|어","甚|至|於") #ruby("의|복","衣|服")까지 #ruby("소|실","燒|失")되었다. #ruby("오|사|야|항","吳|師|爺|巷")에서는 #ruby("화|재","火|災")는 겨우 #ruby("면","免")할 수 있었으나, #ruby("폭|격","爆|擊")으로 인하여 #ruby("가|옥","家|屋")이 #ruby("완|전","完|全")히 무너졌기 때문에 다시 #ruby("중|수","重|修")하였다. 그러나 #ruby("인|원","人|員")은 많고 #ruby("방","房")이 좁아 #ruby("부|득|이","不|得|已") 이곳을 #ruby("정|부","政|府") #ruby("직|원|주|택","職|員|住|宅")으로 #ruby("사|용","使|用")하고, #ruby("제","第")4#ruby("차","次") #ruby("정|청","政|廳")을 #ruby("연|화|지","蓮|花|池")에 70#ruby("여","餘") 칸 #ruby("건|물","建|物")을 빌려서 #ruby("사|용","使|用")하였으니, #ruby("세|금","貰|金")이 1#ruby("년","年")에 40#ruby("만","萬") #ruby("원","元")이나 되었다. #ruby("장","蔣") #ruby("주|석","主|席")이 #ruby("특|별","特|別")히 #ruby("보|조","補|助")해 주어 #ruby("정|부","政|府")가 #ruby("중|경","重|慶")을 떠날 때까지 이곳을 #ruby("사|용","使|用")하였다.#footnote(numbering: _ => [29)])[#h(0.35em)#ruby("장|준|하","張|俊|河")의 #ruby("회|고","回|顧")에 의하면 마지막 #ruby("임|정","臨|政")의 #ruby("청|사","廳|舍")가 있던 곳은 #ruby("연|화|지","蓮|花|池") #ruby("칠|성|란","七|星|蘭")이란 곳으로, 이 #ruby("건|물","建|物")은 #ruby("원|래","元|來") 범백용이라는 #ruby("중|국|인","中|國|人") #ruby("소|유","所|有")의 호텔이었다. #ruby("임|정","臨|政") #ruby("청|사","廳|舍")가 이곳으로 옮긴 것이 #ruby("장|준|하","張|俊|河") #ruby("일|행","一|行")이 #ruby("도|착","到|着")\(1945#ruby("년","年") 1#ruby("월","月") 31#ruby("일","日"))하기 4#ruby("개|월","個|月") #ruby("전","前")이라고 하였으니 1944#ruby("년","年") 9#ruby("월","月") #ruby("말","末") 쯤일 것으로 #ruby("추|측","推|測")된다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("오|사|야|항","吳|師|爺|巷")에 있을 때 #ruby("폭|격","爆|擊")이 가장 #ruby("심","甚")하던 4#ruby("월","月") 어느날, 새벽부터 아홉 #ruby("시|간","時|間")을 #ruby("금|탕|가","金|湯|街")의 #ruby("사|설","私|設") #ruby("방|공|호","防|空|壕")에서 지냈다. 집 마당 앞으로 #ruby("입|구","入|口")가 나 있기에 들어갔는데, 나중에 나와서 보니 그 #ruby("가|옥","家|屋")은 #ruby("전|부","全|部") #ruby("파|괴","破|壞")되었다. #ruby("급","急")히 돌아와 보니 내 집도 #ruby("대|문","大|門") #ruby("입|구","入|口")에 #ruby("폭|탄","爆|彈")이 떨어져 담#ruby("장","墻")과 기와가 #ruby("전|부","全|部") 무너지고 #ruby("파|괴","破|壞")되어 다시 #ruby("중|수","重|修")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 #ruby("남|안","南|岸")에서 #ruby("동|포","同|胞") 3, 4#ruby("명","名")이 #ruby("피|살","被|殺")되었다는 #ruby("급|보","急|報")를 듣고 #ruby("즉|시","卽|時") 가서 #ruby("조|사","調|査")해 보니, #ruby("폭|사|자","爆|死|者")는 #ruby("신|익|희","申|翼|熙") #ruby("씨","氏") 조카와 #ruby("김|영|린","金|永|麟")의 #ruby("처","妻")였다. 어찌할 #ruby("방|도","方|道")가 없고, 다만 #ruby("통|탄","痛|歎")할 뿐이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 #ruby("중|경","重|慶")에서는 #ruby("수","數")많은 사람들이 #ruby("폭|사","爆|死")하였다. #ruby[18제][十八梯] #ruby("방|공|동","防|空|洞")의 #ruby("관|청","官|廳") #ruby("보|도","報|道")는 400#ruby("여","餘") #ruby("명","名")이라 하고, #ruby("시|민","市|民")이 #ruby("전","傳")하는 말은 800#ruby("여","餘") #ruby("명","名")이라 하여, 내가 #ruby("직|접","直|接") #ruby("시|찰","視|察")하여 보았다. 내가 #ruby("고|서","古|書")를 #ruby("독|습","讀|習")할 때 #ruby("적|시|여|산","積|屍|如|山")이라는 #ruby("문|구","文|句")는 #ruby("문|인","文|人")의 #ruby("무|문|수|단","舞|文|手|段")으로 #ruby("상|상","想|像")하였드니.#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “내가 옛 #ruby("서|적","書|籍")을 익힐 때 “#ruby("시|체","屍|體")가 #ruby("산","山")처럼 쌓였다”라는 #ruby("구|절","句|節")을 #ruby("문|인","文|人")의 글재주로만 생각하였다”. #ruby("무|문|수|단","舞|文|手|段")은 #ruby("사|실","事|實")을 #ruby("과|장","誇|張")되게 #ruby("표|현","表|現")하는 #ruby("등","等") 글을 다듬는 것.] 그랬는데 그날 #ruby("교|장|구","較|場|口")에 나가 #ruby("광|경","光|景")을 살펴보니 들것으로 #ruby("방|공|호","防|空|壕")에 #ruby("산|재","散|在")한 #ruby("시|체","屍|體")를 #ruby("수|집","收|集")하는데, 어린 아이 #ruby("시|체","屍|體")는 들것 하나에 2, 3#ruby("명","名")씩, 어른은 1#ruby("명","名")씩 모아서 쌓으니, #ruby("과|연","果|然") “#ruby("시|체","屍|體")가 #ruby("산","山")처럼 쌓였다”라는 #ruby("문|구","文|句")가 예나 #ruby("지|금","只|今")이나 #ruby("동|일","同|一")하게 쓰이는 #ruby("이|유","理|由")를 #ruby("이|해","理|解")할 수 있을 것 같았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날의 #ruby("참|사","慘|事")는 #ruby("비|단","非|但") #ruby("폭|탄","爆|彈")에 맞아 죽은 것뿐 아니라 #ruby("방|공|호","防|空|壕")에서 #ruby("질|식","窒|息")한 것도 #ruby("중|요","重|要")한 #ruby("원|인","原|因")이 되었다. #ruby("시|체","屍|體") #ruby("모|양","模|樣")을 보면 #ruby("남|녀","男|女")#ruby("간","間")에 #ruby("의|복","衣|服")이 성한 것은 없고, #ruby("신|체","身|體")에 #ruby("상|처","傷|處")가 많은 것은 #ruby("방|공|호","防|空|壕") 속에서 #ruby("질|식","窒|息")하여 #ruby("최|후|발|악","最|後|發|惡")의 몸부림이 벌어진 #ruby("사|실","事|實") 때문이었다. 그러면 #ruby("격|투","格|鬪")가 일어나도록 #ruby("방|공|호","防|空|壕") 속에서 나오지 못한 #ruby("원|인","原|因")은 어디 있는가? 그것은 #ruby("지|휘","指|揮")하던 #ruby("경|관","警|官")이 #ruby("방|공|호","防|空|壕") #ruby("문","門")을 밖으로 채운 채 #ruby("자|기","自|己")만 #ruby("급","急")히 #ruby("도|망","逃|亡")갔기 때문이었다. 그 #ruby("과|실","過|失")로 인하여 #ruby("경|비|사|령","警|備|司|令") #ruby("유|치","劉|峙") #ruby("상|장","上|將")은 크게 #ruby("문|책","問|責")#ruby("당","當")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("산","山")같이 모아놓은 #ruby("시|체","屍|體")를 #ruby("운|반","運|搬")하는 것을 보았는데, #ruby("화|물|차","貨|物|車")에 마치 #ruby("물|건","物|件")처럼 실었다. #ruby("화|물|차","貨|物|車")가 달리다 흔들릴 때 #ruby("시|체","屍|體")가 땅으로 떨어지는 일도 있었다. 그런 #ruby("시|체","屍|體")는 다시 싣기 귀찮아서 #ruby("화|물|차","貨|物|車") 뒤에 목을 달아매고 달리니, #ruby("시|체","屍|體")가 땅에 끌리며 달려가는 모습은 차마 눈뜨고 볼 수 없는 #ruby("참|상","慘|狀")이었다. 그런데 그 많은 #ruby("시|체","屍|體") #ruby("중","中") #ruby("대|다|수","大|多|數")는 #ruby("밀|매|음","密|賣|淫")하던 #ruby("여|자","女|子")의 #ruby("시|체","屍|體")이니, 그 #ruby("원|인","原|因")은 #ruby("본|래","本|來") #ruby("교|장|동","較|場|洞") #ruby("부|근","附|近")이 #ruby("밀|매|음|촌","密|賣|淫|村")이었던 까닭이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[또 한 가지 #ruby("참|혹","慘|酷")한 것은, #ruby("친|척","親|戚")들이 모두 살아 있는 사람들은 저마다 #ruby("가|족","家|族") #ruby("시|체","屍|體")를 찾아가는데, 어떤 곳은 집조차 검은 #ruby("벽","甓")돌과 재만 남은 빈터에 #ruby("시|체","屍|體")를 갖다 놓고 #ruby("통|곡","痛|哭")하니, 차마 귀로 들을 수 없고 눈뜨고 볼 수 없는 #ruby("지|경","地|境")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[큰 #ruby("불|행","不|幸")이 있는 곳에서는 #ruby("혹","或") #ruby("행|복","幸|福")한 일도 볼 수 있다. #ruby("방|공|호","防|空|壕") 속에 #ruby("피|난","避|難")한 그들은 #ruby("귀|중|품","貴|重|品")을 #ruby("전|부","全|部") #ruby("휴|대","携|帶")하고 있었다. #ruby("경|관","警|官")들이 #ruby("지|휘","指|揮")하여 죽은 #ruby("자","者")의 몸에 있던 #ruby("귀|중|품","貴|重|品")을 #ruby("수|집","收|集")하니, #ruby("금|은|보|석","金|銀|寶|石") #ruby("역|시","亦|是") #ruby("시|체","屍|體")와 같이 #ruby("산","山")처럼 쌓였다. 그 #ruby("험","險")한 #ruby("시|체","屍|體")를 #ruby("운|반","運|搬")하기 위하여 #ruby("방|공|호","防|空|壕")에 #ruby("출|입","出|入")하던 #ruby("인|부","人|夫")들 #ruby("중","中")에는, 죽은 #ruby("자","者")의 #ruby("귀|중|품","貴|重|品")으로 #ruby("막|대","莫|大")한 #ruby("금|액","金|額")의 #ruby("부|자","富|者")가 되었다는 말까지 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|경","重|慶")은 #ruby("전|쟁","戰|爭") #ruby("이|전","以|前")에는 하나의 #ruby("상|업","商|業") #ruby("항|구","港|口")였다. 왼#ruby("편","便")에서 흘러오는 #ruby("가|릉|강","嘉|陵|江")과 오른#ruby("편","便")에서 흘러오는 #ruby("양|자|강","揚|子|江")이 #ruby("합|류","合|流")하는 곳으로, #ruby("중|경","重|慶")은 #ruby("천|여","千|餘") 톤의 #ruby("윤|선","輪|船")이 #ruby("정|박","碇|泊")하고 #ruby("물|화","物|貨")가 모이는 #ruby("중|요","重|要")한 #ruby("항|구","港|口")이다. 옛 이름은 #ruby("파|촉","巴|蜀")이니 그곳은 #ruby("고|대","古|代") #ruby("파","巴")#ruby("장|군","將|軍")이 #ruby("개|척","開|拓")한 곳이며, #ruby("연|화|지","蓮|花|池")에는 #ruby("파","巴")#ruby("장|군","將|軍")의 #ruby("분|묘","墳|墓")가 #ruby("온|전","穩|全")히 남아 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|경","重|慶")의 #ruby("기|후","氣|候")는 9#ruby("월","月") #ruby("초","初")부터 다음해 4#ruby("월","月")까지는 구름과 안개 때문에 햇빛을 보기 힘들며, #ruby("저|기|압","低|氣|壓")의 #ruby("분|지","盆|地")라 #ruby("지|면","地|面")에서 솟아나는 #ruby("악|취","惡|臭")가 흩어지지 못해 #ruby("공|기","空|氣")는 #ruby("극","極")히 #ruby("불|결","不|潔")하며, #ruby("인|가","人|家")와 #ruby("공|장","工|場")에서 #ruby("분|출","噴|出")되는 #ruby("석|탄","石|炭")#ruby("연|기","煙|氣")로 인하여 눈을 뜨기조차 #ruby("곤|란","困|難")하였다. 우리 #ruby("동|포","同|胞") 300〜400#ruby("명","名")이 6〜7#ruby("년","年") #ruby("거|주","居|住")하는 동안 #ruby("순|전","純|全")히 #ruby("폐|병","肺|病")으로 #ruby("사|망","死|亡")한 사람만 70〜80#ruby("명","名")에 #ruby("달","達")하였다. 이는 #ruby("중|경","重|慶")에 #ruby("거|주","居|住")하는 #ruby("전|체","全|體") #ruby("한|인","韓|人")의 1〜2#ruby("할","割")에 #ruby("해|당","該|當")하는 숫자이니 놀라지 않을 수 없다. #ruby("중|경","重|慶")에 #ruby("거|주","居|住")하는 #ruby("외|국","外|國")의 #ruby("영|사|관","領|事|館")이나 #ruby("상|업|자","商|業|者")들이 3#ruby("년","年") #ruby("이|상","以|上")을 견디지 못한다는 곳에서, 우리가 6〜7#ruby("년","年")씩이나 #ruby("거|주","居|住")하다 큰아들 #ruby("인","仁")이도 #ruby("역|시","亦|是") #ruby("폐|병","肺|病")으로 #ruby("사|망","死|亡")하였으니, 알고도 #ruby("불|가|피","不|可|避")하게 #ruby("당","當")한 일이라 좀처럼 잊기 어렵다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음은 우리가 #ruby("토|교","土|橋")에 #ruby("거|주","居|住")하던 것을 #ruby("대|강","大|綱") 말하고자 한다. #ruby("대|가|족","大|家|族") #ruby("식|구","食|口")가 #ruby("기|강","綦|江")으로 #ruby("이|주","移|住")한 #ruby("후","後"), #ruby("중|경","重|慶")과 #ruby("거|리","距|離")가 멀어 #ruby("내|왕","來|往")이 #ruby("불|편","不|便")하였다. 그런 까닭에 #ruby("중|경","重|慶")에서 #ruby("기|강","綦|江") 가는 40#ruby("리","里")쯤에 #ruby("토|교","土|橋")라는 #ruby("촌|시|장","村|市|場")이 있었는데 그곳에 #ruby("화|탄|계","花|灘|溪")와 #ruby("폭|포","瀑|布")가 있고, 그 #ruby("폭|포","瀑|布") 위에는 #ruby("동|감","東|坎")이라는 작은 #ruby("지|역","地|域")이 있다. 그래서 그곳 #ruby("토|지","土|地")를 20#ruby("년","年") #ruby("기|한","期|限")으로 #ruby("조|차","租|借")하고 #ruby("반|양|옥","半|洋|屋") 3#ruby("동","棟")을 #ruby("건|축","建|築")하였으며, #ruby("서|양","西|洋") #ruby("선|교|사","宣|敎|師")들은 우리를 위하여 #ruby("예|배|당","禮|拜|堂")과 #ruby("청|년|회|관","靑|年|會|館")으로 #ruby("사|용","使|用")하도록 #ruby("양|옥","洋|屋") 1#ruby("동","棟")을 #ruby("증|축","增|築")하여 주었고, 이와 #ruby("별|도","別|途")로 #ruby("시|가","市|街")에 2#ruby("층","層") #ruby("민|가","民|家") 1#ruby("동","棟")을 #ruby("구|입","購|入")하여 #ruby("백|여","百|餘") #ruby("명","名")의 #ruby("식|구","食|口")를 #ruby("수|용","收|容")하였다. #ruby("토|교","土|橋")는 #ruby("중|경","重|慶")에 #ruby("비","比")하면 #ruby("주|택|난","住|宅|難")도 덜할 뿐 아니라 #ruby("공|기","空|氣")도 #ruby("신|선","新|鮮")한 #ruby("편","便")이었다. 나는 #ruby("종|종","種|種") #ruby("토|교","土|橋")에 가서 #ruby("도|로","道|路") #ruby("수|선","修|繕"), #ruby("과|수","果|樹") #ruby("재|배","栽|培"), #ruby("축|석","築|石"), #ruby("제|방","堤|防") #ruby("등","等")을 #ruby("직|접","直|接") #ruby("실|행","實|行")하면서 #ruby("근|로|생|활|층","勤|勞|生|活|層")을 #ruby("동|정","同|情")하기도 하였다.]
