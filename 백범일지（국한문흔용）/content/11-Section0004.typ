#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("조|서|방","曺|書|房")이 내가 하라는 대로만 한다면 살려줄 #ruby("도|리","道|理")를 #ruby("연|구","硏|究")하여 보겠네.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|덕|근","曺|德|根")은 마음 깊이 #ruby("감|동","感|動")하고 또 #ruby("감|동","感|動")하여 무엇이나 하라는 대로 #ruby("복|종","服|從")하겠다고 했다. 나는 그에게 #ruby("자|기","自|己") 집에서 밥 가지고 오는 #ruby("하|인","下|人") #ruby("편","便")에 #ruby("편|지","便|紙")를 보내 돈 200#ruby("냥","兩")만 가져다가 #ruby("은|밀","隱|密")히 몸에 감추어 두라고 하였다. 그랬더니 #ruby("조|덕|근","曺|德|根")의 집에서는 그날로 #ruby("당|장","當|場") #ruby("백|동|전","白|銅|錢")#footnote(numbering: _ => [136)])[#h(0.35em)1891#ruby("년","年") #ruby("은|본|위|제","銀|本|位|制") #ruby("채|택","採|擇") #ruby("후","後") #ruby("주|조","鑄|造")된 #ruby("근|대|화|폐","近|代|貨|幣"). #ruby("본|위|화|폐","本|位|貨|幣") #ruby("은|전","銀|錢")에 #ruby("대","對")한 #ruby("보|조|화","補|助|貨")이다. #ruby("남|발","濫|發")로 #ruby("인","因")하여 이른바 ‘#ruby("백|동|화","白|銅|貨") 인플레’를 #ruby("초|래","招|來")하기도 하였다.]200#ruby("냥","兩")을 #ruby("감|옥","監|獄")으로 가져왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("감|옥","監|獄")에 있던 #ruby("죄|수","罪|囚")들 #ruby("중","中") 가장 #ruby("세|력","勢|力")이 컸던 #ruby("자","者")는 #ruby("징|역","懲|役") #ruby("만|기","滿|期")가 다 되어가던 #ruby("자","者")로 #ruby("감|옥","監|獄")에서는 그에게 #ruby("죄|수","罪|囚") #ruby("감|시","監|視")를 시키고 있던 터였다. #ruby("강|화","江|華") #ruby("출|신","出|身")으로 #ruby("황|순|용","黃|順|用")이란 #ruby("자","者")였는데, #ruby("절|도|죄","竊|盜|罪")로 3#ruby("년","年")을 다 살고 #ruby("출|옥|일","出|獄|日")이 15#ruby("일","日") 남아 있었다. #ruby("황|가","黃|哥")가 #ruby("옥|중","獄|中")에서 #ruby("당|도|용|사","當|道|用|事")를 한다.#footnote(numbering: _ => [137)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “여러 가지 일을 맡아 하였다.”]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|가","黃|哥")가 #ruby("남|색","男|色")#footnote(numbering: _ => [138)])[#h(0.35em)#ruby("남|자","男|子")끼리의 #ruby("동|성|연|애","同|性|戀|愛").]으로 좋아지내는 #ruby("김|백|석","金|白|石")#footnote(numbering: _ => [139)])[#h(0.35em)#ruby("규|장|각","奎|章|閣") #ruby("자|료","資|料")에 #ruby("의","依")하면 그는 #ruby("강|백|석","姜|伯|石")이다.]은 나이 17, 8#ruby("세","歲")의 #ruby("절|도","竊|盜") #ruby("재|범","再|犯")으로 10#ruby("년|형","年|刑")을 받은 지 채 몇 달이 못 되는 #ruby("자","者")였다. #ruby("조|덕|근","曺|德|根")에게 #ruby("은|밀","隱|密")히 #ruby("부|탁","付|託")하여 #ruby("김|백|석","金|白|石")으로 하여금 #ruby("황|가","黃|哥")를 보고 #ruby("애|원","哀|願")하여 살려 달라고 조르게 하였다. #ruby("황|가","黃|哥")가 #ruby("백|석","白|石")에 #ruby("대","對")한 #ruby("애|정","愛|情")에 못 이겨 살릴 #ruby("방|도","方|道")를 물으면, #ruby("황|가","黃|哥")더러 #ruby("창|수","昌|洙") #ruby("김|서|방","金|書|房")이 도우면 살 #ruby("도|리","道|理")가 없지 않다고 조르게 하였다. 하루는 #ruby("황|가","黃|哥")가 #ruby("백|석","白|石")의 #ruby("애|원","哀|願")대로 #ruby("비|밀","祕|密")히 나를 찾아왔다. 그 동안 지내던 더러운 #ruby("정","情")을 못 이겼음인지, 나를 보고 #ruby("백|석","白|石")이를 살려 달라고 #ruby("간|청","懇|請")했다. 나는 #ruby("황|가","黃|哥")를 #ruby("엄","嚴")히 꾸짖었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("출|옥","出|獄")할 #ruby("기|한","期|限")도 멀지 않았으니 #ruby("사|회","社|會")에 나가서 좋은 사람이 될 줄 알았는데, 벌써 #ruby("출|옥","出|獄")도 하기 #ruby("전","前")에 #ruby("범|죄","犯|罪")할 생각이나 하느냐? #ruby("백|석","白|石")이는 어린것이 #ruby("중","重")한 #ruby("형|벌","刑|罰")을 받았으므로 나도 불쌍히 여기지 않음이 아니나, #ruby("피|차","彼|此") #ruby("죄|수","罪|囚") #ruby("처|지","處|地")로 무슨 #ruby("도|리","道|理")가 있겠느냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|가","黃|哥")는 #ruby("송|연","悚|然")해져서 물러갔다. 다시 #ruby("조|덕|근","曺|德|根")으로 하여금 #ruby("백|석","白|石")을 시켜 #ruby("재|차","再|次") #ruby("삼|차","三|次") #ruby("김|서|방","金|書|房")에게서 #ruby("백|석","白|石")이를 살려주마는 #ruby("허|락","許|諾")을 받아내라고 부추겼다. 다음날 #ruby("황|가","黃|哥")는 눈물을 흘리면서 내게 찾아와 말하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 #ruby("백|석","白|石")의 #ruby("징|역","懲|役")을 #ruby("대|신","代|身")이라도 지겠습니다. #ruby("김|서|방","金|書|房")님은 하지 않으셔서 그렇지 #ruby("능","能")히 못할 일이 없으시니 #ruby("백|석","白|石")이를 살려만 주신다면 죽을 데라도 #ruby("사|양","辭|讓")치 않겠습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 다시 #ruby("황|가","黃|哥")를 믿지 못하겠다는 #ruby("태|도","態|度")로 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 #ruby("백|석","白|石")이를 얼마나 사랑하는지 모르나, 너는 #ruby("단|지","但|只") 더러운 #ruby("정","情")으로 #ruby("백|석","白|石")이를 살렸으면 하는 생각이 있을 것이다. 그러나 그 마음이 #ruby("과|연","果|然") 내가 #ruby("백|석","白|石")에게 #ruby("대","對")하여 가지는 마음과 같을지 #ruby("의|문","疑|問")이다. 나는 그 어린것이 #ruby("필|경","畢|竟") #ruby("옥|중","獄|中") #ruby("귀|신","鬼|神")이 될 것을 불쌍히 생각하고 있거니와, #ruby("설|사","設|使") 내가 #ruby("백|석","白|石")이를 불쌍히 여기는 마음으로 살려주마고 #ruby("허|락","許|諾")하고 #ruby("수|속","手|續")을 #ruby("시|작","始|作")한다 하여도, 네가 그 일을 #ruby("순|검|청","巡|檢|廳")에 #ruby("고|발","告|發")하여 나를 #ruby("망|신","亡|身")시키지나 않을까 걱정이다. 네가 나와 함께 #ruby("근","近") 2#ruby("년","年")이나 이곳에 있으면서 익히 보았던바, #ruby("이|순|보","李|順|甫")가 #ruby("탈|옥","脫|獄")하였을 때 #ruby("감|옥","監|獄") #ruby("죄|수","罪|囚") #ruby("전|부","全|部")가 불려가 매를 맞았으나, #ruby("관|리","官|吏")들 #ruby("중","中") 누구 한 사람 내게 #ruby("대","對")하여 #ruby("감","敢")히 말 한마디 묻는 것을 보았느냐? #ruby("만|일","萬|一") 내가 #ruby("백|석","白|石")이를 살리려다가 #ruby("실|패","失|敗")하여 점잖지 못한 모습만 드러나게 되면, 오늘까지 #ruby("관|리","官|吏")들의 #ruby("경|애","敬|愛")를 받아왔던 것이 다 헛일이 되지 않겠는가? 또 #ruby("백|석","白|石")이를 살리려다가 도리어 죽이는 #ruby("결|과","結|果")만 낳을 터이니, 살고자 하는 #ruby("백|석","白|石")이보다 살리려는 네 마음을 믿을 수 없다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|가","黃|哥")는 #ruby("별|별","別|別") #ruby("맹|세","盟|誓")를 다하였다. 그리고 그는 내가 같이 나가지는 않고 #ruby("자|기","自|己")들만 #ruby("옥|문","獄|門") 밖으로 나가게 해줄 #ruby("도|량","度|量")이 있는 줄 알았다. #ruby("황|가","黃|哥")에게 #ruby("절|대","絶|對") #ruby("복|종","服|從")하겠노라는 #ruby("서|약","誓|約")을 받고서야 비로소 #ruby("쾌","快")히 #ruby("승|낙","承|諾")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|덕|근","曺|德|根")·#ruby("양|봉|구","梁|鳳|九")·#ruby("황|순|용","黃|順|用")·#ruby("김|백|석","金|白|石")은 다 내가 #ruby("자|기","自|己")네들을 #ruby("옥|문","獄|門") 밖으로 나가게 해줄 줄 믿었다. 그러나 무슨 #ruby("방|법","方|法")으로 어떻게 할 것인지는 #ruby("감","敢")히 묻지도 못하고 있었다. #ruby("자|기","自|己")들 생각에 나는 #ruby("결","決")코 #ruby("도|주","逃|走")하지 않을 줄 믿고 #ruby("자|기","自|己")들만 내보내주고 나는 #ruby("의|연","毅|然")히 #ruby("감|옥","監|獄")에 있을 줄 믿었던 #ruby("모|양","模|樣")이다. #ruby("황|가","黃|哥")가]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리가 가려면 #ruby("노|잣","路|資")돈이 있어야지요.”]
