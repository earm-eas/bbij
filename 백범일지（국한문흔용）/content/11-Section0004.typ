#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("시|대","時|代")에도 #ruby("이|치","理|致")에 닿지 않는 #ruby("원|통","冤|痛") #ruby("억|울","抑|鬱")한 #ruby("송|사","訟|事")가 많았다. 내가 #ruby("감|옥","監|獄")에 갇혀 있는 #ruby("자","者")를 #ruby("위","爲")해 말을 #ruby("자|세","仔|細")히 들어보고서 #ruby("소|장","訴|狀")을 지어주면 #ruby("간|혹","間|或") #ruby("소|송","訴|訟")에서 이길 적도 있었다. 갇혀 있는 사람 #ruby("중","中")에는 #ruby("감|옥","監|獄") 바깥에 #ruby("소|식","消|息")을 보내 #ruby("대|서","代|書") #ruby("비|용","費|用")을 써가면서도 #ruby("곤|란","困|難")을 당하는 #ruby("경|우","境|遇")가 #ruby("허|다","許|多")하였다. 그러나 내가 #ruby("대|서","代|書")하면 서로 #ruby("상|의","相|議")해서 #ruby[인지][印札紙]만 사다가 써 보내면 되니 #ruby("편","便")하기도 하고, 또 #ruby("비|용","費|用") 한 푼 없이 #ruby("성|심","誠|心")껏 #ruby("소|장","訴|狀")을 지어주는 탓에 #ruby("김|창|수","金|昌|洙")가 쓴 #ruby("소|장","訴|狀")은 거의 다 #ruby("승|소","勝|訴")한다고 #ruby("와|전","訛|傳")이 되어, #ruby("옥|내","獄|內")에서는 #ruby("물|론","勿|論")이고 #ruby("심|지|어","甚|至|於") #ruby("관|리","官|吏")의 #ruby("대|서","代|書")까지도 한 일이 있다. #ruby("대|서","代|書")뿐 아니라 #ruby("백|성","百|姓")을 어려움에 빠뜨리고 돈을 #ruby("강|제","强|制")로 빼앗는 #ruby("사|건","事|件")이 있으면 #ruby("상|급","上|級") #ruby("관|리","官|吏")에게 #ruby("권|계","勸|戒")하여 #ruby("파|면","罷|免")시킨 일도 있었다. 그러므로 #ruby("간|수","看|守")들이 나를 꺼려 #ruby("죄|수","罪|囚")들을 함부로 #ruby("학|대","虐|待")하지 못하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[네#ruby("번","番")째, #ruby("성|악","聲|樂").]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 시골에서 나고 자랐으나 #ruby("농|군","農|軍")들의 ‘김매는 소리’나 ‘#ruby("목|동","牧|童") 갈가보다 소리’#footnote(numbering: _ => [104)])[#h(0.35em)#ruby("목|동","牧|童")은 ‘#ruby("목|동|가","牧|童|歌")’ 또는 ‘#ruby("목|동|문|답|가","牧|童|問|答|歌")’, 갈가보다는 ‘갈까보다 갈까보다 임을 따라 갈까보다’로 시작하는 #ruby("춘|향|가","春|香|歌")의 한 #ruby("구|절","句|節")인지도 모르겠다.] 한마디 불러 본 적이 없었고, 기껏 한다고 해야 #ruby("시","詩")나 #ruby("풍|월","風|月")을 읊조린 적밖에 없었다. 그 #ruby("당|시","當|時") #ruby("감|옥","監|獄") #ruby("규|칙","規|則")이 낮잠은 #ruby("허|락","許|諾")하는 #ruby("대|신","代|身") 밤#ruby("중","中")에는 잠을 자지 못하게 하고, 밤새도록 #ruby("죄|수","罪|囚")들에게 소리나 옛이야기를 시키곤 하였는데, #ruby("이|유","理|由")는 #ruby("야|간","夜|間")에 잠을 재우면 잠든 틈을 타서 #ruby("도|주","逃|走")하기 때문이라는 것이었다. #ruby("물|론","勿|論") 내게는 그런 #ruby("규|칙","規|則")을 #ruby("시|행","施|行")하지 않았으나, #ruby("보|통","普|通") 다들 그렇게 하니까 나도 #ruby("자|연","自|然")히 밤에 오래 놀다가 잠자리에 들곤 하였다. #ruby("덕|분","德|分")에 #ruby("시|조","時|調")나 #ruby("타|령","打|令")이나 남이 잘 하는 것을 자주 들어 소리의 #ruby("운|치","韻|致")를 알게 되었다. #ruby("조|덕|근","曺|德|根")에게 온갖 #ruby("시|조","時|調")와 #ruby("여|창","女|唱")지름#footnote(numbering: _ => [105)])[#h(0.35em)지름은 ‘지른다’는 뜻으로, #ruby("창|법","唱|法")의 하나.]·#ruby("남|창","男|唱")지름·#ruby("적|벽|가","赤|壁|歌")#footnote(numbering: _ => [106)])[#h(0.35em)#ruby("적|벽|가","赤|壁|歌")는 『#ruby("삼|국|지","三|國|志")』에서 가장 재미있는 #ruby("적|벽|대|전","赤|壁|大|戰")을 노래한 것으로, 서울 12#ruby("잡|가","雜|歌")에도 있고 판소리에도 있다. 여기서는 #ruby("잡|가","雜|歌") #ruby("적|벽|가","赤|壁|歌")인 듯하다.]·가세#ruby("타|령","打|令")#footnote(numbering: _ => [107)])[#h(0.35em)#ruby("원|래","元|來") 이름은 #ruby("선|유|가","船|遊|歌")로, #ruby("경|기|지|방","京|畿|地|方") 12#ruby("잡|가","雜|歌") #ruby("중","中")의 하나. #ruby("후|렴","後|斂")에 ‘가세’라는 말이 자주 나와 #ruby("일|명","一|名") ‘가세#ruby("타|령","打|令")’이라 불린다.]·개구리#ruby("타|령","打|令")#footnote(numbering: _ => [108)])[#h(0.35em)개구리#ruby("타|령","打|令")은 #ruby("전|라|민|요","全|羅|民|謠")에도 있고 #ruby("경|기|민|요","京|畿|民|謠")에도 있다. #ruby("조|덕|근","曺|德|根")이 #ruby("인|천","仁|川")사람인 것으로 미루어 보아 여기서 말하는 개구리#ruby("타|령","打|令")은 #ruby("경|기|민|요","京|畿|民|謠") 쪽인 듯하다.] #ruby("등","等")을 배워서 #ruby("죄|수","罪|囚")들과 같이 소리를 하며 지냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하루는 아침에 『#ruby("황|성|신|문","皇|城|新|聞")』을 읽어보니, #ruby("경|성","京|城")·#ruby("대|구","大|邱")·#ruby("평|양","平|壤")·#ruby("인|천","仁|川")에서 아무 날 #ruby("강|도","强|盜") 누구누구, #ruby("살|인","殺|人") 누구누구 #ruby("등","等")과 함께 #ruby("인|천","仁|川")에 있는 #ruby("살|인|강|도","殺|人|强|盜") #ruby("김|창|수","金|昌|洙")를 #ruby("교|수|형","絞|首|刑")에 #ruby("처","處")한다는 #ruby("기|사","記|事")가 나와 있었다.#footnote(numbering: _ => [109)])[#h(0.35em)#ruby("원|문","原|文"): “지금까지 紀憶되기는 七月 二十七日노 생각한다”. 『#ruby("황|성|신|문","皇|城|新|聞")』은 『#ruby("독|립|신|문","獨|立|新|聞")』의 #ruby("착|오","錯|誤"). 그런데 #ruby("김|창|수","金|昌|洙")에 대한 3#ruby("차","次") #ruby("심|문|일","審|問|日")이 9#ruby("월","月") 10#ruby("일","日"), #ruby("법|부|대|신","法|部|大|臣") #ruby("한|규|설","韓|圭|卨")이 #ruby("고|종","高|宗")에게 #ruby("김|창|수","金|昌|洙")의 #ruby("교|수|형","絞|首|刑")을 #ruby("건|의","建|議")한 것은 10#ruby("월","月") 22#ruby("일","日")\(#ruby("음|력","陰|曆") 9#ruby("월","月") 16#ruby("일","日"))이다. 따라서 7#ruby("월","月") 27#ruby("일","日")자 #ruby("신|문","新|聞")에 #ruby("교|수|형","絞|首|刑")에 처한다는 #ruby("기|사","記|事")가 실릴 수 없다. 11#ruby("월","月") 7#ruby("일","日")\(#ruby("음|력","陰|曆") 10#ruby("월","月") 3#ruby("일","日")) 『#ruby("독|립|신|문","獨|立|新|聞")』은 #ruby("김|창|수","金|昌|洙") #ruby("등","等")에 대한 #ruby("법|부","法|部")의 #ruby("교|수|형","絞|首|刑") #ruby("건|의","建|議")를 #ruby("보|도","報|道")한 바 있는데, 7#ruby("월","月") 27#ruby("일","日")자 #ruby("교|수|형","絞|首|刑") #ruby("기|사","記|事")는 이것을 말한다.] 누구나 그런 #ruby("기|사","記|事")를 본 다음에는 일부러라도 #ruby("태|연|자|약","泰|然|自|若")한 #ruby("태|도","態|度")를 가지려고 하겠지만, 어찌된 일인지 내 마음은 조금도 #ruby("경|동","驚|動")되지 않았다. #ruby("교|수|대","絞|首|臺")에 오를 #ruby("시|간","時|間")이 #ruby("반|일","半|日")밖에 남지 않았지만, #ruby("음|식","飮|食")과 #ruby("독|서","讀|書")와 사람 만나는 일을 #ruby("평|상|시","平|常|時")처럼 하였다. 그것은 #ruby("고|선|생","高|先|生") 말씀 #ruby("중","中")에 #ruby("박|태|보","朴|泰|輔")의 보습 단근질 #ruby("일|화","逸|話")가 있었는데, 그는 보습으로 단근질을 당하면서도 끝까지 #ruby("굴","屈")하지 않고 오히려 “#ruby("차|철|유|랭|갱|자|래","此|鐵|猶|冷|更|煮|來")”#footnote(numbering: _ => [110)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “이 쇠가 식었으니 다시 달구어 오너라”. #ruby("박|태|보","朴|泰|輔")\(1654〜1689). #ruby("조|선","朝|鮮") #ruby("중|기","中|期")의 #ruby("문|신","文|臣"). #ruby("호","號")는 #ruby("정|재","定|齋"). 그는 1689#ruby("년","年") #ruby("기|사|환|국","己|巳|換|局") 때 #ruby("인|현|왕|후","仁|顯|王|后")의 #ruby("폐|위","廢|位")를 #ruby("강|력","强|力")히 #ruby("반|대","反|對")하다 #ruby("심","甚")한 #ruby("고|문","拷|問")을 받고 #ruby("유|배","流|配") 가는 길목인 #ruby("노|량|진","鷺|梁|津")에서 #ruby("옥|독","獄|毒")으로 죽었다.]고 했다고 한다. 그 #ruby("일|화","逸|話")와 더불어 #ruby("삼|학|사","三|學|士")#footnote(numbering: _ => [111)])[#h(0.35em)#ruby("병|자|호|란","丙|子|胡|亂") 때 #ruby("청","淸")나라와 #ruby("화|의","和|議")를 #ruby("반|대","反|對")한 #ruby("홍|익|한","洪|翼|漢")·#ruby("윤|집","尹|集")·#ruby("오|달|제","吳|達|濟") #ruby("등","等") 세 사람. 이들은 #ruby("봉|림|대|군","鳳|林|大|君")과 함께 #ruby("청","淸")나라로 잡혀가 #ruby("처|형","處|刑")당했다.]에 관한 이야기를 힘있게 들었는데, 그 #ruby("효|험","效|驗")으로 안다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("신|문","新|聞")이 #ruby("배|포","配|布")된 #ruby("후","後")로 #ruby("감|리|서","監|理|署")가 술렁술렁하고 #ruby("인|천|항","仁|川|港") 사람들의 ‘#ruby("산","生") #ruby("조|문","弔|問")’#footnote(numbering: _ => [112)])[#h(0.35em)#ruby("원|문","原|文"): “#ruby("산","生")弔問”. 살아 있는 사람에게 하는 #ruby("조|문","弔|問").]이 #ruby("옥|문","獄|門")에 #ruby("답|지","遝|至")하였다. 오는 사람들이 나를 #ruby("면|대","面|對")하여 “마지막으로 보러 왔소” 하고는 모두 눈물을 흘렸다. 나는 도리어 그 사람들을 #ruby("위|로","慰|勞")하여 보내고 『#ruby("대|학","大|學")』을 외우곤 하였다. 그러나 다시 “아무 나리가 오셨소” “아무 #ruby("영|감","令|監")께서 오셨소” 하며 나를 마지막으로 보고자 하는 #ruby("면|회|자","面|會|者")들이 줄을 이었다. #ruby("통|지","通|知")를 받고 나가보면 그 사람들도 #ruby("역|시","亦|是")]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리는 #ruby("김|석|사","金|碩|士")가 살아 나와서 #ruby("상|면","相|面")할 줄 알았소. 그런데 이것이 웬일이오?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고서 눈물을 비오듯 흘렸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 어머님은 #ruby("음|식","飮|食")을 손수 들여넣어 주시면서도 #ruby("평|상|시","平|常|時")와 조금도 다름이 없으셨다. #ruby("주|위","周|圍")에 있는 사람들이 모르게 한 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("인|천|옥","仁|川|獄")에서는 #ruby("사|형|수","死|刑|囚") #ruby("집|행","執|行")을 늘#ruby("상","常") #ruby("오|후","午|後")에 끌고 나가서 #ruby("우|각|동","牛|角|洞")에서 #ruby("교|살","絞|殺")하던 터이므로, 아침밥 #ruby("점|심","點|心")밥도 잘 먹고 죽을 때는 어떻게 할 것인지 #ruby("준|비","準|備")할 마음도 없이 그냥 있었지만 #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들의 마음 아파하는 모습은 차마 보기 싫었다. 내게 #ruby("음|식","飮|食")을 얻어먹던 도둑 #ruby("죄|수","罪|囚")들과 내게 글을 배우던 #ruby("감|옥","監|獄") #ruby("제|자","弟|子")들, 그리고 내게 #ruby("소|송","訴|訟")에 #ruby("대","對")한 #ruby("지|도","指|導")를 받던 여러 #ruby("죄|수","罪|囚")들이 얼마나 #ruby("애|통","哀|痛")해 하며 울던지, #ruby("과|연","果|然") 제 #ruby("부|모","父|母") 죽을 때에도 그렇게 #ruby("애|통","哀|痛")해 하였을지 #ruby("의|문","疑|問")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이윽고 #ruby("교|수|대","絞|首|臺")로 끌려나갈 #ruby("시|간","時|間")이 되었다. 그때까지 나는 #ruby("성|현","聖|賢")의 말씀에 마음을 가라앉혔다가 #ruby("성|현","聖|賢")과 #ruby("동|행","同|行")할 생각으로 『#ruby("대|학","大|學")』만 읽고 앉아 있었다. 그런데 #ruby("시|간","時|間")이 지나도록 아무 #ruby("소|식","消|息")이 없이 그럭저럭 저녁밥을 먹었다. 옆사람들이 #ruby("창|수","昌|洙")는 #ruby("특|수|죄|인","特|殊|罪|人")이니 #ruby("야|간|집|행","夜|間|執|行")을 하려는가 보다 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[밤이 #ruby("초|경","初|更")은 하여서#footnote(numbering: _ => [113)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “저녁 무렵이 되어서”. #ruby("초|경","初|更")은 저녁 여섯 #ruby("시","時") #ruby("전|후","前|後").] 여러 사람의 발자국 소리가 나더니 #ruby("옥|문","獄|門") 열리는 소리가 들렸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘옳지. 지금이 그때로군!’]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 앉아 있는데, 내 얼굴을 보는 #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들은 마치 #ruby("자|기","自|己")가 죽으러 가는 듯 벌벌 떨었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[안쪽 #ruby[문][內間門]을 열기도 #ruby("전","前")에 #ruby("감|옥","監|獄") 뜰에서]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|창|수","金|昌|洙") 어느 #ruby("방","房")에 있소?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하는 소리가 들렸다. 내 #ruby("대|답","對|答")은 듣는지 마는지,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아이구, 이제 #ruby("김|창|수","金|昌|洙")는 살았소! 아이구, 우리 #ruby("감|리","監|理") #ruby("영|감","令|監")과 #ruby("감|리|서","監|理|署") #ruby("전|직|원","全|職|員")과 #ruby("각","各") #ruby("청|사","廳|舍") #ruby("직|원","職|員")이 아침부터 지금까지 밥 한 술 먹지 못하고 #ruby("창|수","昌|洙")를 어찌 차마 우리 손으로 죽인단 말이냐 하고 서로 말없이 얼굴만 물끄러미 바라보며 #ruby("한|탄","恨|歎")하였소. 그랬더니 지금 #ruby("대|군|주","大|君|主")\(#ruby("고|종","高|宗")) #ruby("폐|하","陛|下")께옵서 #ruby("대|청","大|廳")에서#footnote(numbering: _ => [114)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby[집무실][大廳]에서”. 1896#ruby("년","年") 2#ruby("월","月") 11#ruby("일","日")부터 1897#ruby("년","年") 2#ruby("월","月") 20#ruby("일","日")까지 #ruby("고|종","高|宗")은 #ruby("러|시|아","俄|羅|斯") #ruby("공|사|관","公|使|館")에 있었다. 따라서 여기서 #ruby("대|청","大|廳")은 #ruby("고|종","高|宗")의 #ruby("집|무|실","執|務|室")을 말한다.] #ruby("전|화","電|話")로 #ruby("감|리","監|理") #ruby("영|감","令|監")을 불러 계시옵고, #ruby("감|리","監|理") #ruby("영|감","令|監")은 #ruby("김|창|수","金|昌|洙")의 #ruby("사|형","死|刑")을 #ruby("정|지","停|止")하라는 #ruby("친|칙","親|勅")을 받잡고 밤#ruby("중","中")에라도 #ruby("감|옥","監|獄")에 내려가 #ruby("창|수","昌|洙")에게 알려주라는 #ruby("분|부","分|付")를 내리셨소. 오늘 하루 얼마나 #ruby("상|심","傷|心")하셨소?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("관|청","官|廳") #ruby("수|속","手|續")이 어떠했었는지는 모르나, 내 #ruby("요|량","料|量")으로는 #ruby("이|재|정","李|在|正")이 그 #ruby("공|문","公|文")을 받고 #ruby("상|부","上|部"), #ruby("즉","卽") #ruby("법|부","法|部")#footnote(numbering: _ => [115)])[#h(0.35em)#ruby("고|종","高|宗") 32#ruby("년","年")\(1895) #ruby("법|무|아|문","法|務|衙|門")을 #ruby("법|부","法|部")로 #ruby("개|칭","改|稱")하고 #ruby("사|법|행|정","司|法|行|政")을 #ruby("담|당","擔|當")했다.]에 #ruby("전|화","電|話")로 #ruby("교|섭","交|涉")한 것 같았다. 그러나 그#ruby("후","後")에 #ruby("대|청","大|廳")에서 나오는 #ruby("소|식","消|息")을 들으면, #ruby("사|형","死|刑")은 #ruby("형|식|적","形|式|的")으로라도 임금의 #ruby("재|가","裁|可")를 받아 #ruby("집|행","執|行")하는 #ruby("법","法")이므로, #ruby("법|부|대|신","法|部|大|臣")이 #ruby("사|형|수","死|刑|囚") 한 사람 한 사람의 #ruby[심문서][供件]를 가지고 #ruby("조|회","照|會")에 들어가서 #ruby("상|감","上|監")의 #ruby("친|감","親|監")을 거친다고 한다.#footnote(numbering: _ => [116)])[#h(0.35em)#ruby("당|시","當|時") #ruby("법|률","法|律")로 ‘#ruby("사|형","死|刑") #ruby("죄","罪")는 세 #ruby("번","番") #ruby("복|심","覆|審")하여 #ruby("왕","王")에게 아뢴다’고 #ruby("규|정","規|定")하였다. #ruby("법|부","法|部")에서 #ruby("김|창|수","金|昌|洙")의 #ruby("교|수|형","絞|首|刑")을 #ruby("왕","王")에게 #ruby("보|고","報|告")한 것은 10#ruby("월","月") 22#ruby("일","日")이다.] 그런데 그때 #ruby("입|시","入|侍")하였던 #ruby("승|지","承|旨") #ruby("중","中") 한 사람이 #ruby("각","各") #ruby("죄|수","罪|囚")의 #ruby("공|건","供|件")을 뒤적이며 보던 #ruby("중","中"), ‘#ruby("국|모|보|수","國|母|報|讐")’ 넉 #ruby("자","字")가 눈에 띄므로 #ruby("이|상","異|常")하게 여기고,#footnote(numbering: _ => [117)])[#h(0.35em)「#ruby("김|창|수","金|昌|洙") 3초」라는 #ruby("심|문|서","審|問|書")에 ‘身爲國民 含寃於國母之讐 有此擧’란 #ruby("구|절","句|節")이 있다.] 이미 #ruby("재|가","裁|可") #ruby("수|속","手|續")을 끝낸 #ruby("안|건","案|件")을 다시 꺼내 임금께 보여드렸다. 그 #ruby("내|용","內|容")을 보신 #ruby("대|군|주","大|君|主")께서는 #ruby("즉|시","卽|時") #ruby("어|전|회|의","御|前|會|議")를 여셨고, #ruby("의|결","議|決")한 #ruby("결|과","結|果") #ruby("국|제|관|계","國|際|關|係")와 #ruby("관|련","關|連")된 일이니 아직 #ruby("생|명","生|命")이나 살리고 보자 하여 #ruby("전|화","電|話")로 #ruby("친|칙","親|勅")하셨다 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("여|하","如|何")튼 #ruby("대|군|주","李|太|皇")께서 #ruby("친","親")히 #ruby("전|화","電|話")하신 것만은 #ruby("사|실","事|實")이었다. #ruby("이|상","異|常")하게 생각되는 것은, 그때 #ruby("경|성|부","京|城|府") 안에는 이미 #ruby("전|화","電|話")가 #ruby("가|설","架|設")된 지 오래였으나, #ruby("경|성","京|城") #ruby("외","外")의 #ruby("지|역","地|域")에 #ruby("장|거|리","長|距|離") #ruby("전|화","電|話")가 #ruby("설|치","設|置")된 것은 #ruby("인|천","仁|川")이 처음이었다는 #ruby("사|실","事|實")이다. #ruby("인|천","仁|川")까지의 #ruby("전|화","電|話") #ruby("가|설|공|사","架|設|工|事")가 #ruby("완|공","完|工")된 지 3#ruby("일","日")째 되는 #ruby("병|신|년","丙|申|年")\(1896) 8#ruby("월","月") 26#ruby("일","日")의 일이었다.#footnote(numbering: _ => [118)])[#h(0.35em)#ruby("음|력","陰|曆") 8#ruby("월","月") 26#ruby("일","日")은 #ruby("양|력","陽|曆") 10#ruby("월","月") 2#ruby("일","日")이다. 이날 #ruby("인|천|감|리|서","仁|川|監|理|署")는 #ruby("일|본|영|사|관","日|本|領|事|館")의 #ruby("압|력","壓|力")에 #ruby("의","依")해 #ruby("김|창|수","金|昌|洙")에 #ruby("대","對")한 #ruby("조|속","早|速")한 #ruby("판|결","判|決")을 #ruby("법|부","法|部")에 #ruby("건|의","建|議")하였다. 그러나 #ruby("법|부","法|部")는 #ruby("당|일","當|日") #ruby("전|보","電|報")로 #ruby("왕","王")이 #ruby("결|정","決|定")할 #ruby("사|항","事|項")이라며 이를 #ruby("유|보","留|保")하였다. 따라서 ‘#ruby("고|종","高|宗")이 #ruby("전|화","電|話")로 #ruby("사|형","死|刑")을 #ruby("중|단","中|斷")시켰다’는 #ruby("유|명","有|名")한 이야기에는 #ruby("약|간","若|干")의 #ruby("착|오","錯|誤")가 있다. #ruby("즉","卽") #ruby("전|화","電|話")가 아니라 #ruby("전|보","電|報")이며, #ruby("고|종","高|宗")이 아니라 #ruby("법|부","法|部")이고, #ruby("사|형","死|刑")을 #ruby("중|지","中|止")시킨 것이 아니라 #ruby("고|종","高|宗")의 #ruby("재|가","裁|可")를 #ruby("명|분","名|分")으로 #ruby("판|결","判|決")을 #ruby("지|연","遲|延")시킨 것이다.] #ruby("만","萬")에 하나 그때까지 #ruby("전|화","電|話") #ruby("준|공","竣|工")이 못 되었다면, 바로 #ruby("사|형","死|刑")이 #ruby("집|행","執|行")되었을 거라고들 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|리|서","監|理|署")에서 내려온 #ruby("주|사","主|事")는 이런 말을 했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("관|리","官|吏")들뿐 아니라 오늘 #ruby("전","全") #ruby("항|구","港|口")의 #ruby("객|주","客|主") 32#ruby("명","名")이 #ruby("긴|급|회|의","緊|急|會|議")를 하고 #ruby[통지문][通文] 돌리는 것을 보았는데, #ruby("항|구","港|口") 안에 있는 집집마다 몇 사람씩이든지 되는 대로 #ruby("우|각|현","牛|角|峴")에 #ruby("김|창|수","金|昌|洙")의 #ruby("교|수|형","絞|首|刑")을 구경가되, #ruby("각","各") 사람이 #ruby("엽|전","葉|錢") 한 #ruby("냥","兩")씩 #ruby("준|비","準|備")하여 가지고 오라 하였소. 사람들이 돈을 가지고 오면 거기서 모인 돈으로 한 사람의 몸값을 쳐주되, #ruby("부|족","不|足")한 #ruby("액|수","額|數")는 32#ruby("객|주","客|主")가 #ruby("담|당","擔|當")하고 #ruby("김|창|수","金|昌|洙")를 살리자고까지 하였소. 그러나 지금은 #ruby("천|행","天|幸")으로 살았고, 아마 며칠이 못 되어 #ruby("궐|내","闕|內")에서 #ruby("은|명","恩|命")이 계실 터이니 아무 #ruby("염|려","念|慮") 마시고 계시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[눈서리가 내리다가 갑자기 봄바람이 부는 듯하였다. 밤에 #ruby("옥|문","獄|門") 열리는 소리를 듣고 벌벌 떨던 #ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들은 이 #ruby("소|식","消|息")을 듣고서 너무 좋아서 죽을 #ruby("지|경","地|境")인 #ruby("모|양","模|樣")이었다. 신골방맹이#footnote(numbering: _ => [119)])[#h(0.35em)짚신 삼을 때 쓰는 방망이.]로 차꼬 등을 두들기며 온갖 노래를 다 부르고, 푸른 바지저고리 차림으로 춤도 추고 우스운 짓도 하며 하룻밤을 지내는 #ruby("양","樣")이 마치 #ruby("청|의|배|우","靑|衣|俳|優")들의 #ruby("연|극|장","演|劇|場")과 같았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|료","同|僚") #ruby("죄|수","罪|囚")들은 나를 보고 참말 #ruby("이|인","異|人")이라며 #ruby("경|탄","驚|歎")하였다. #ruby("사|형","死|刑")을 당할 날인데도 #ruby("평|소","平|素")와 똑같이 말하고 밥 먹고 #ruby("행|동","行|動")하였으니, 이는 #ruby("필|시","必|是") #ruby("선|견|지|명","先|見|之|明")이 있어 #ruby("자|기","自|己")가 죽지 않을 것을 미리 알았기 때문이라고들 하였다. #ruby("관|리","官|吏")들 #ruby("중","中")에서도 그렇게 아는 사람들이 많았다. 어머님은 그날 밤에야 비로소 그 일을 알게 되셨는데, #ruby("감|리","監|理")가 #ruby("대|군|주","大|君|主")의 #ruby("친|전","親|電")을 받고서 어머님께 알려드렸던 것이다. 이 일로 #ruby("인","因")해 누구보다도 어머님이 #ruby("당|신","當|身") 아들을 #ruby("이|인","異|人")이라 생각하게 되셨다. 배를 타고 #ruby("강|화","江|華") #ruby("갑|곶","甲|串")\(각구지목)을 지나오면서 #ruby("강","江")물에 같이 빠져 죽자고 하셨을 때 내가 #ruby("결","決")코 죽지 않을 거라 했던 일을 #ruby("기|억","記|憶")하시고, “내 아들은 미리 #ruby("자|기","自|己")가 죽지 않을 줄을 알았다”고 #ruby("확|신","確|信")하셨던 #ruby("모|양","模|樣")이다. 어머님뿐 아니라 #ruby("내|외|분","內|外|分")이 다 그런 #ruby("신|념","信|念")을 갖게 되셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|군|주","大|君|主")의 #ruby("친|칙","親|勅")으로 #ruby("김|창|수","金|昌|洙")의 #ruby("사|형","死|刑")이 #ruby("정|지","停|止")되었다는 #ruby("소|문","所|聞")이 #ruby("전|파","傳|播")되니, #ruby("전","前")날 나를 만나러 와서 #ruby("영|결","永|訣")을 고하던 사람들로부터 #ruby("치|하","致|賀") #ruby("면|회","面|會")하러 오는 사람이 #ruby("옥|문","獄|門")에 줄을 이었다. 나는 아예 #ruby("옥|문","獄|門") 안에 자리를 하고 앉아서 며칠 동안 손님 #ruby("응|접","應|接")을 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("사|형","死|刑") #ruby("정|지","停|止") #ruby("이|전","以|前")에는 #ruby("순|전","純|全")히 나의 젊은 #ruby("의|기","意|氣")를 #ruby("애|석","哀|惜")하게 여기고 뜨겁게 #ruby("동|정","同|情")하던 사람들이 나를 찾아왔었지만, 이번에는 내가 머지않아 #ruby("대|군|주","大|君|主")의 #ruby("소|명","召|命")을 입어 #ruby("영|귀","榮|貴")하게 될 줄 알고, 그때 #ruby("세|도","勢|道")를 얻으면 다른 수가 생기리라 생각하고 와서 #ruby("아|부","阿|附")하는 사람도 있었다. #ruby("관|리","官|吏") #ruby("중","中")에서도 그런 사람이 있었고, #ruby("인|천","仁|川") #ruby("항|내","港|內") #ruby("인|사","人|事")들 가운데서도 그런 빛이 보였다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[8) #ruby("파|옥","破|獄")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("간|수","看|守") #ruby("중","中") 우두머리#ruby("격","格")인 #ruby("최|덕|만","崔|德|萬")은 #ruby("강|화","江|華")#ruby("읍|내","邑|內") #ruby("김|우|후","金|虞|候")#footnote(numbering: _ => [120)])[#h(0.35em)이름은 #ruby("김|주|경","金|周|卿"). #ruby("우|후","虞|候")는 #ruby("조|선|시|대","朝|鮮|時|代")의 #ruby("무|관","武|官") #ruby("직|명","職|名").]의 집에 계집종으로 있던 #ruby("여|자","女|子")의 #ruby("서|방","書|房")이었다. 아내가 죽은 다음 #ruby("인|천","仁|川")으로 와서 #ruby("경|무|청","警|務|廳") #ruby("사|령","使|令")으로 #ruby("다|년|간","多|年|間") #ruby("봉|직","奉|職")하였으므로 #ruby("사|령","使|令")들의 #ruby("두|목","頭|目")이 되었다. 그 #ruby("최|덕|만","崔|德|萬")이 #ruby("강|화","江|華")에 가서 #ruby("자|기","自|己") 옛 #ruby("상|전","上|典")이었던 #ruby("김|우|후","金|虞|候")에게 내 이야기를 하였던 듯하다. 하루는 #ruby("감|리|서","監|理|署") #ruby("주|사","主|事")가 #ruby("의|복","衣|服") 한 벌을 가지고 와서 주며 말하기를,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("강|화","江|華")에서 온 #ruby("김|주|경","金|周|卿")이란 사람이 이 #ruby("의|복","衣|服")을 지어다가 #ruby("감|리","監|理") #ruby("사|또","使|道")에게 드리고 #ruby("김|창|수","金|昌|洙")에게 #ruby("분|부","分|付")하여 입도록 하여 달라는 #ruby("청|원","請|願")을 하였으니, 이 #ruby("의|복","衣|服")을 입고 #ruby("김|주|경","金|周|卿")이란 #ruby("친|구","親|舊")가 #ruby("면|회","面|會")하거든 보시오.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. #ruby("주|사","主|事")가 가고 나서 얼마 #ruby("후","後")에 #ruby("김|주|경","金|周|卿")이란 사람이 찾아왔다. 나이는 마흔 가까이 되어 보이고 #ruby("면|목","面|目")이 단단해 보였는데 만나서 #ruby("별","別") 말은 없었고,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("고|생","苦|生")이나 잘 하시오. 나는 #ruby("김|주|경","金|周|卿")이오.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고는 물러갔다. 어머님이 저녁밥을 가지고 오셔서 말씀하셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“아까 #ruby("강|화","江|華") 계신 #ruby("김|우|후","金|虞|候")라는 #ruby("양|반","兩|班")이 네 아버지와 나를 찾아오셨었다. 우리를 보시고 #ruby("우|선","于|先")은 네 #ruby("의|복","衣|服")만 #ruby("자|기","自|己") 집에서 지어왔다면서 우리 #ruby("양|주","兩|主") #ruby("의|복","衣|服")하라고 옷감을 끊어주시고, 또 돈 200#ruby("냥","兩")을 주시면서 #ruby("필|요","必|要")한 데 쓰라고 하셨다. 그리고는 #ruby("즉|시","卽|時") 가시면서 열흘 #ruby("후","後")에 다시 찾겠다고 하셨다. 네가 보니 어떻더냐? 밖에서 듣기에는 아주 훌륭한 사람이라고 하더라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[사람을 한 #ruby("번","番") 보고 어찌 잘 알 수 있을까마는 그 사람의 하는 일은 #ruby("감|사","感|謝")하다고 #ruby("모|자|간","母|子|間")에 이야기를 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("최|덕|만","崔|德|萬")에게 #ruby("김|주|경","金|周|卿")의 #ruby("내|력","來|歷")과 #ruby("인|격","人|格")을 #ruby("자|세","仔|細")히 물어보았다. #ruby("김|주|경","金|周|卿")의 #ruby("자","字")는 #ruby("경|득","卿|得")이니 #ruby("원|래","元|來") #ruby("강|화","江|華") #ruby("관|아","官|衙")에 #ruby[서리배][吏屬]였고 #ruby("병|인|양|요","丙|寅|洋|擾") #ruby("이|후","以|後") #ruby("운|현","雲|峴")#footnote(numbering: _ => [121)])[#h(0.35em)#ruby("운|현|군","雲|峴|君"), 곧 #ruby("대|원|군","大|院|君")을 가리킨다. 『#ruby("백|범|일|지","白|凡|逸|志")』에 자주 나오는 #ruby("표|현","表|現")이다.]이 #ruby("강|화|도","江|華|島")에 3,000#ruby("명","名")의 #ruby("별|무|사","別|武|士")를 #ruby("양|성","養|成")하고 섬 #ruby("주|위","周|圍")에 #ruby("석|루","石|壘")를 높이 쌓고 #ruby("진|무|영","鎭|撫|營")을 세우던 때, #ruby("김|주|경","金|周|卿")이 #ruby("포|량|고|직","包|糧|庫|直")#footnote(numbering: _ => [122)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("포|량|고","包|糧|庫")지기”. ‘包糧庫直’은 ‘砲糧庫直’이 맞다. #ruby("군|수|품","軍|需|品") #ruby("창|고","倉|庫")지기.]의 일을 맡았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[사람됨이 어렸을 때부터 #ruby("호|방","豪|放")하여 #ruby("초|립","草|笠")둥이#footnote(numbering: _ => [123)])[#h(0.35em)#ruby("초|립","草|笠")은 나이 어려서 #ruby("관|례","冠|禮")한 #ruby("남|자","男|子")가 쓰던 누런 풀로 결어 만든 갓. #ruby("초|립","草|笠")둥이는 #ruby("초|립","草|笠")을 쓴 젊은 사내.] 때부터 #ruby("독|서","讀|書")는 아니하고 #ruby("도|박","賭|博")을 일삼아 하였다. #ruby("부|모","父|母")가 #ruby("김|주|경","金|周|卿")을 #ruby("징|계","懲|戒")하기 #ruby("위","爲")해 곳간에 #ruby("감|금","監|禁")하였는데, 곳간에 들어가면서 #ruby("투|전","套|錢")#footnote(numbering: _ => [124)])[#h(0.35em)#ruby("화|투","花|鬪")와 비슷한 #ruby("도|박","賭|博") #ruby("기|구","器|具")의 #ruby("일|종","一|種"). #ruby("투|전","套|錢")은 #ruby("영|조","英|祖") #ruby("초|기","初|期")부터 크게 퍼져서 사람들에게 큰 #ruby("폐|해","弊|害")를 입혔으며 #ruby("관|아","官|衙")에서 #ruby("단|속","團|束")해도 #ruby("별","別") #ruby("효|과","效|果")가 없었다고 한다.] 한 목을 가지고 들어가 갇혀 있는 동안에도 #ruby("투|전","套|錢")의 #ruby("묘|법","妙|法")을 #ruby("연|구","硏|究")하였다. 나와서 서울로 올라가 #ruby("투|전","套|錢")을 몇#ruby("만","萬") 목이나 만들었는데, #ruby("자|기","自|己")만 알 수 있는 #ruby("표|시","眼|票")를 하여 #ruby("강|화","江|華")로 가지고 가서 팔았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|화","江|華")는 섬이라서 #ruby("포|구","浦|口")마다 고깃배들이 빽빽이 세워져 있는 곳이다. #ruby("김|주|경","金|周|卿")은 이 #ruby("투|전","套|錢")을 #ruby("친|구","親|舊")들에게 나누어주고 고깃배마다 들어가 팔게 했다. 그리고 #ruby("자|기","自|己")는 그 고깃배들을 돌아다니며 #ruby("투|전","套|錢")을 하여 돈을 #ruby("수|십|만","數|十|萬") #ruby("냥","兩")이나 벌었다. 그 돈으로 #ruby("각","各") #ruby("관|청","官|廳")의 #ruby("하|급","下|級") #ruby("관|속","官|屬")들을 #ruby("매|수","買|收")하여 #ruby("전|부","全|部") #ruby("자|기","自|己")의 #ruby("지|휘","指|揮") #ruby("명|령","命|令")을 받도록 해놓고, #ruby("원|근","遠|近")에서 #ruby("용|기","勇|氣")와 #ruby("지|략","智|略")이 있다는 #ruby("자","者")는 거의 다 #ruby("망|라","網|羅")하여 #ruby("자|기","自|己") #ruby("식|구","食|口")로 만들어 놓고 어떤 #ruby("양|반","兩|班")이든지 #ruby("비|리","非|理")만 저지르면 #ruby("직|접","直|接") #ruby("간|접","間|接")으로 #ruby("혼","魂")을 내주었다. #ruby("설|사","設|使") #ruby("경|내","境|內")에 #ruby("도|적","盜|賊")이 나서 #ruby("포|교","捕|校")가 #ruby("출|장","出|張") #ruby("체|포","逮|捕")를 하여도 먼저 #ruby("김|경|득","金|卿|得")에게 #ruby("보|고","報|告")해야 했다. #ruby("김|경|득","金|卿|得")이 “잡아가라” 하면 잡아가고, “내게 두고 가거라” 하면 #ruby("거|절","拒|絶")을 못하였다고 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("강|화","江|華")에 두 사람의 #ruby("인|물","人|物")이 있었는데, #ruby("양|반","兩|班") #ruby("중","中")에서는 #ruby("이|건|창","李|健|昌")#footnote(numbering: _ => [125)])[#h(0.35em)#ruby("이|건|창","李|健|昌")\(1852〜1898). #ruby("조|선","朝|鮮") #ruby("말|기","末|期")의 #ruby("대|문|장|가","大|文|章|家")이자 #ruby("양|명|학|자","陽|明|學|者"). 그는 세 #ruby("번","番")의 #ruby("유|배","流|配") #ruby("후","後") #ruby("만|년","晩|年")을 #ruby("향|리","鄕|里") #ruby("강|화","江|華")에서 보냈다. #ruby("대|표|적","代|表|的")인 #ruby("저|작","著|作")으로 『#ruby("당|의|통|략","黨|議|通|略")』이 있다.]이요 #ruby("상","常")놈 #ruby("중","中")에서는 #ruby("김|경|득","金|卿|得")이라 했다. #ruby("대|원|군","大|院|君")이 #ruby("김|경|득","金|卿|得")의 #ruby("인|격","人|格")을 #ruby("자|세","仔|細")히 알아보고 #ruby("포|량|감","包|糧|監")#footnote(numbering: _ => [126)])[#h(0.35em)앞에서는 #ruby("포|량|고|직","包|糧|庫|直")이라 했다.]의 #ruby("중|임","重|任")을 맡겼다 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("최|덕|만","崔|德|萬")의 말을 들어보면 #ruby("김|경|득","金|卿|得")은 #ruby("자|기","自|己") 집에 와서 #ruby("음|식","飮|食")을 먹으면서 이렇게 이야기하고 돌아갔다 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|창|수","金|昌|洙")를 살려내어야 할 터인데, 지금 #ruby("정|부","政|府")#ruby("대|관","大|官")들은 모두 눈에 #ruby[구리녹][銅綠]이 슬어서 돈밖에 보이는 것이 없으니, #ruby("불|가|불","不|可|不") #ruby("금|력","金|力")을 #ruby("사|용","使|用")치 아니하면 쉽게 #ruby("방|면","放|免")치 못할 것 같다. 내가 집에 가서 #ruby("가|산","家|産") #ruby("전|부","全|部")를 팔아 가지고 와서 #ruby("김|창|수","金|昌|洙")의 #ruby("부|모","父|母")님을 모시고 #ruby("경|성","京|城")에 가서, 어느 때까지든 #ruby("김|창|수","金|昌|洙")를 #ruby("석|방","釋|放")시키도록 #ruby("주|선","周|旋")을 하겠다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[열흘 남짓 지난 #ruby("후","後")에 #ruby("김|경|득","金|卿|得")이 #ruby("과|연","果|然") 왔다. #ruby("부|모","父|母")님 #ruby("중","中")에 한 분만 서울로 #ruby("동|행","同|行")하자고 하여 어머님이 서울로 가시고 아버님은 #ruby("인|천","仁|川")에 머무르셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("김|경|득","金|卿|得")은 서울로 가서 #ruby("당|시","當|時") #ruby("법|부|대|신","法|部|大|臣") #ruby("한|규|설","韓|圭|卨")#footnote(numbering: _ => [127)])[#h(0.35em)#ruby("한|규|설","韓|圭|卨")\(1848〜1930). #ruby("을|사|조|약","乙|巳|條|約")에 #ruby("반|대","反|對")하였고, 1896#ruby("년","年") #ruby("법|부|대|신","法|部|大|臣")을 #ruby("담|당","擔|當")하고 있었다.]을 찾아가 이렇게 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("대|감","大|監")이 #ruby("책|임","責|任") 있게 #ruby("김|창|수","金|昌|洙")의 #ruby("충|의","忠|義")를 #ruby("표|창","表|彰")하고, #ruby("조|속","早|速")히 #ruby("방|면","放|免")하도록 하여야 옳지 않겠소? #ruby("폐|하","陛|下")께 #ruby("비|밀","祕|密")히 #ruby("주|청","奏|請")이라도 하여 #ruby("장|래","將|來")에 #ruby("허|다","許|多")한 #ruby("충|의|지|사","忠|義|之|士")가 생기도록 함이 #ruby("대|감","大|監")의 #ruby("직|책","職|責")이 아니겠소?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("한|규|설","韓|圭|卨")도 속으로는 그 말에 #ruby("경|복","敬|服")하였다. 그러나 #ruby("당|시","當|時") #ruby("일|본","日|本") #ruby("공|사","公|使")였던 #ruby("하야시","林") #ruby("곤스케","權助")#footnote(numbering: _ => [128)])[#h(0.35em)#ruby("하야시","林")는 #ruby("백|범","白|凡")이 #ruby("탈|옥","脫|獄")한 #ruby("이|후","以|後")인 1899#ruby("년","年") 6#ruby("월","月") #ruby("부|임","赴|任")하기 때문에 #ruby("백|범","白|凡") #ruby("구|명|운|동","救|命|運|動") #ruby("당|시","當|時") #ruby("일|본","日|本") #ruby("공|사","公|使")가 아니다. #ruby("백|범","白|凡") #ruby("투|옥","投|獄") #ruby("시|기","時|期")의 #ruby("일|본","日|本") #ruby("공|사","公|使")는 #ruby("하라","原")\(1896)와 #ruby("가|토","加|藤")\(1897〜1899)이다.]가 벌써 나의 #ruby("사|건","事|件")이 #ruby("국|제|문|제","國|際|問|題")로 #ruby("화","化")하게 될까 #ruby("염|려","念|慮")하여, #ruby("각","各") #ruby("대|신","大|臣")들 #ruby("중","中")에 이 #ruby("사|건","事|件")으로 #ruby("폐|하","陛|下")께 아뢰는 #ruby("자","者")만 있으면 #ruby("별|별","別|別") #ruby("수|단","手|段")을 가리지 않고 #ruby("위|험","危|險")한 #ruby("지|경","地|境")으로 떨어뜨릴 #ruby("흉|계","凶|計")를 꾸미고 있었다. 그러니 옳은 일인 줄은 알지만 어떻게 할 #ruby("방|도","方|道")가 없다고 하였다. #ruby("김|경|득","金|卿|得")은 #ruby("사|관","舍|館")#footnote(numbering: _ => [129)])[#h(0.35em)‘舍館’은 ‘私館’. #ruby("공|관","公|館")의 #ruby("반|대","反|對")말. #ruby("즉","卽") 여기서는 #ruby("한|규|설","韓|圭|卨")의 집을 말한다.]에서 #ruby("분|기|탱|천","憤|氣|撐|天")하여 #ruby("대|관","大|官")들에게 #ruby("욕","辱")을 퍼붓고 나왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어떻든지 #ruby("공|식|적","公|式|的")으로 #ruby("소|장","訴|狀")이나 들이자 하여, 제1#ruby("차","次") #ruby("법|부","法|部")에 #ruby("소|지","訴|紙")를 올렸다. 그러자 “#ruby("국|모","國|母")의 #ruby("원|수","怨|讐")를 갚는다고 한 말의 뜻은 #ruby("가|상","可|尙")하나, #ruby("사|건","事|件")이 #ruby("중|대","重|大")하여 여기서 마음대로 할 수 없다”라고 쓴 #ruby("제|지","題|旨")#footnote(numbering: _ => [130)])[#h(0.35em)#ruby("제|지","題|旨")는 #ruby("제|사","題|辭"). #ruby("소|장","訴|狀")에 #ruby("대","對")한 #ruby("관|청","官|廳")의 #ruby("답|변","答|辯"). 『#ruby("백|범|일|지","白|凡|逸|志")』 #ruby("원|문","原|文")의 #ruby("제|사","題|辭")는 ‘報讐爲言이 其義可尙이나 事關重大하야 未可擅便向事’이지만, #ruby("소|장","訴|狀")의 #ruby("원|본","原|本")의 #ruby("제|사","題|辭")는 ‘觀此所訴하니 其義可尙이라 雖極矜憫이나 事係法部하니 官不得 擅斷向事’(#ruby("소|장","訴|狀")을 보니 그 뜻은 #ruby("가|상","可|尙")하고 #ruby("동|정","同|情")이 가지만 #ruby("법|부","法|部") #ruby("결|정|사|항","決|定|事|項")이라 #ruby("본|관","本|官")은 함부로 #ruby("판|단","判|斷")할 수 없음)이다.]가 내려왔다. 두#ruby("번","番") 세#ruby("번","番") #ruby("각","各") #ruby("관|청","官|廳")에 #ruby("일|일","一|一")이 #ruby("소|장","訴|狀")을 올렸으나 이리 미루고 저리 미루고 #ruby("결|말","結|末")이 나지 않았다.#footnote(numbering: _ => [131)])[#h(0.35em)#ruby("백|범","白|凡")의 어머니는 #ruby("인|천|감|리|서","仁|川|監|理|署")에 제1#ruby("차","次")로 #ruby("소|장","訴|狀")을 올리고 그 다음(1898#ruby("년","年") 2#ruby("월","月") 16#ruby("일","日"))에 #ruby("법|부","法|部")에 #ruby("소|장","訴|狀")을 올렸다. 이에 #ruby("대","對")한 #ruby("제|사","題|辭")는 ‘情雖矜憐 罪關王章 必不可容貸向事’(#ruby("사|정","事|情")은 비록 안되었지만 #ruby("죄","罪")가 #ruby("왕","王")의 #ruby("결|정|사|항","決|定|事|項")에 #ruby("관|계","關|係")되므로 #ruby("용|서","容|恕")할 수 없다)이다. 이어서 2#ruby("월","月") 21#ruby("일","日") #ruby("백|범","白|凡") 아버지도 #ruby("법|부","法|部")에 #ruby("소|장","訴|狀")을 올렸다. 이에 #ruby("대","對")한 #ruby("제|사","題|辭")는 ‘當有參酌矣리니 姑爲退待할 事’(마땅히 #ruby("참|작","參|酌")할 것이니 물러가 기다리라)이다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("소|송","訴|訟")에 #ruby("전|력","專|力")하기를 7, 8#ruby("개|월","個|月") 동안 #ruby("김|경|득","金|卿|得")의 돈은 바닥이 났다. 그 동안 아버님과 어머님이 번갈아 #ruby("인|천","仁|川")과 #ruby("경|성","京|城")을 오르락내리락 하시다가, 마침내 #ruby("김|경|득","金|卿|得")이 #ruby("소|송","訴|訟")을 #ruby("중|단","中|斷")하고 돌아와서 내게 #ruby("편|지","便|紙") 한 #ruby("통","通")을 보냈다. #ruby("내|용","內|容")은 #ruby("보|통","普|通") #ruby("위|문","慰|問")#ruby("편|지","便|紙")였고, #ruby("단|율","單|律")#footnote(numbering: _ => [132)])[#h(0.35em)#ruby("형|식","形|式")에 #ruby("엄|격","嚴|格")한 #ruby("율|시","律|詩")는 #ruby("기","起")·#ruby("승","承")·#ruby("전","轉")·#ruby("결","結")이 #ruby("각","各") 2#ruby("구","句"), #ruby("총","總") 8#ruby("구","句")로 되어 있다. #ruby("단|율","單|律")이란 #ruby("기","起")·#ruby("승","承")·#ruby("전","轉")·#ruby("결","結")이 #ruby("각|각","各|各") 1#ruby("구","句")씩 #ruby("총","總") 4#ruby("구","句")로 된 #ruby("율|시","律|詩")를 말한다.] 한 #ruby("수","首")가 있었다.]
