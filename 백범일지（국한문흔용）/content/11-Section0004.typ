#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 #ruby("지|방","地|方")을 두루 돌면서 #ruby("수|소|문","搜|所|聞")하여 들어보니, #ruby("벽|동","碧|潼")사람 #ruby("김|이|언","金|利|彦")이 힘과 #ruby("용|기","勇|氣")가 남달리 뛰어나고 #ruby("학|식","學|識")도 #ruby("풍|부","豐|富")하다 하였다. 일찍이 #ruby("심|양|자|사","瀋|陽|刺|史")#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("자|사","刺|史")는 #ruby("중|국","中|國")의 #ruby("지|방|관|리","地|方|官|吏")로 #ruby("주","州")의 #ruby("지|사","知|事")에 #ruby("해|당","該|當")하지만, #ruby("당|시","當|時")에 이 #ruby("지|역","地|域")에 #ruby("자|사","刺|史")라는 #ruby("관|직","官|職")은 없었다. 그런데 #ruby("당|시","當|時") #ruby("심|양|지|역","瀋|陽|地|域")에서는 #ruby("연|왕","燕|王") #ruby("의|극|당|아","依|克|唐|阿")가 #ruby("유|력|자","有|力|者")로 #ruby("반|일|운|동","反|日|運|動")을 #ruby("후|원","後|援")하였다. 『#ruby("노|정|약|기","路|程|略|記")』에 #ruby("의","依")하면 #ruby("김|창|수","金|昌|洙")·#ruby("김|형|진","金|亨|鎭") #ruby("등","等")은 #ruby("중|국","中|國")의 힘을 빌리기 #ruby("위","爲")해 #ruby("연|왕","燕|王")에게 #ruby("상|소","上|疏")를 올렸고, #ruby("연|왕","燕|王")은 #ruby("서|경|장","徐|慶|璋")과 #ruby("의|논","議|論")하여 이들에게 #ruby("진|동|창|의|사","鎭|東|倡|義|使")라는 #ruby("직|위","職|位")를 주고 #ruby("지|원","支|援")을 #ruby("약|속","約|束")하였다.]가 그의 #ruby("용|력","勇|力")을 높이 사서 #ruby("준|마","駿|馬") 한 #ruby("필","匹")과 『#ruby("삼|국|지","三|國|志")』 한 #ruby("질","帙")을 주었고, #ruby("청","淸")나라 #ruby("고|급","高|級") #ruby("장|교","將|校")들에게도 #ruby("융|숭","隆|崇")한 #ruby("대|우","待|遇")를 받고 있다 하였다. 그가 지금 #ruby("청","淸")나라의 #ruby("원|조","援|助")를 받아서 #ruby("의|병","義|兵")을 일으키려고 #ruby("도|모","圖|謀")하고 있다는 이야기를 들었다.#footnote(numbering: _ => [26)])[#h(0.35em)여기서부터 『#ruby("백|범|일|지","白|凡|逸|志")』와 『#ruby("노|정|약|기","路|程|略|記")』의 #ruby("중|국","中|國") #ruby("기|행","紀|行")은 큰 #ruby("차|이","差|異")가 있다. 『#ruby("노|정|약|기","路|程|略|記")』의 1895#ruby("년","年") #ruby("중|국","中|國") #ruby("원|정","遠|征")은 「6〜7#ruby("월","月")의 1#ruby("차","次") #ruby("원|정","遠|征")」과 「9#ruby("월","月")의 2#ruby("차","次") #ruby("원|정","遠|征")」 두 #ruby("번","番")에 걸쳐 있다. #ruby("백|범","白|凡")과 #ruby("김|형|진","金|亨|鎭")이 #ruby("삼|도|구","三|道|溝") #ruby("김|이|언","金|利|彦") #ruby("부|대","部|隊")에 #ruby("합|류","合|流")하여 11#ruby("월","月") #ruby("초","初") #ruby("거|사","擧|事")하는 것은 2#ruby("차","次") #ruby("중|국","中|國") #ruby("원|정","遠|征")에서 돌아올 즈음일 것이다.]]
