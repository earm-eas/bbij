#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海")에 모여든 여러 #ruby("청|년","靑|年")들 #ruby("중|심","中|心")으로 #ruby("정|부|조|직","政|府|組|織")이 #ruby("운|동","運|動") #ruby("진|전","進|展")에 #ruby("절|대","絶|對") #ruby("필|요","必|要")하다는 소리가 안팎으로 #ruby("점|차","漸|次") 높아져, #ruby("각","各") 곳에서 #ruby("상|해","上|海")에 온 #ruby("인|사","人|士")들이 #ruby("각|각","各|各") #ruby("대|표","代|表")를 #ruby("선|출","選|出")하고 #ruby("임|시|의|정|원","臨|時|議|政|院")을 #ruby("조|직","組|織")하여 #ruby("임|시|정|부","臨|時|政|府")를 만드니, 이것이 바로 #ruby("대|한|민|국|임|시|정|부","大|韓|民|國|臨|時|政|府")이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|승|만","李|承|晩")을 #ruby("총|리","總|理")로 #ruby("임|명","任|命")하고, #ruby("내|무","內|務")·#ruby("외|무","外|務")·#ruby("군|무","軍|務")·#ruby("재|무","財|務")·#ruby("법|무","法|務")·#ruby("교|통","交|通") #ruby("등","等")의 #ruby("부|서","部|署")가 #ruby("조|직","組|織")되었다. #ruby("도|산","島|山") #ruby("안|창|호","安|昌|浩")는 #ruby("미|주","美|洲")로부터 #ruby("상|해","上|海")에 와서 #ruby("내|무|총|장","內|務|總|長")으로 #ruby("취|임","就|任")하였고, #ruby("각","各") #ruby("부","部") #ruby("총|장","總|長")은 멀리서 미처 #ruby("도|착","到|着")하지 못했기 때문에 #ruby("차|장","次|長")들을 #ruby("대|리","代|理")로 #ruby("국|무|회|의","國|務|會|議")를 #ruby("진|행","進|行")하였다. #ruby("이|동|휘","李|東|輝")·#ruby("문|창|범","文|昌|範")은 #ruby("러|시|아|령","俄|西|亞|領") #ruby("연|해|주","沿|海|州")로부터 왔고, #ruby("이|시|영","李|始|榮")·#ruby("남|형|우","南|亨|祐") #ruby("등","等")은 #ruby("북|경","北|京")으로부터 모여들었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한#ruby("편","便") #ruby("정|부","政|府")의 #ruby("사|무","事|務")가 실마리를 잡아가기 #ruby("시|작","始|作")할 무렵 #ruby("한|성","漢|城")에서 #ruby("비|밀","祕|密")리에 #ruby("각","各") #ruby("도","道") #ruby("대|표","代|表")가 모여 #ruby("이|승|만","李|承|晩")을 #ruby("집|정|관","執|政|官") #ruby("총|재","總|裁")로 하는 #ruby("별|도","別|途")의 #ruby("정|부","政|府")를 #ruby("조|직","組|織")하였다. 그러나 #ruby("본|국","本|國")에서 #ruby("활|동","活|動")하기 어려워 그 #ruby("권|한","權|限")을 #ruby("상|해","上|海")로 보내니,#footnote(numbering: _ => [3)])[#h(0.35em)#ruby("한|성","漢|城")에서 #ruby("수|립","樹|立")된 #ruby("정|부","政|府")를 #ruby("세|칭","世|稱") ‘#ruby("한|성|정|부","漢|城|政|府")’라 하는데 #ruby("정|식","正|式") #ruby("명|칭","名|稱")은 ‘#ruby("대|조|선|공|화|국","大|朝|鮮|共|和|國")’이다. 1919#ruby("년","年") 4#ruby("월","月") #ruby("초","初") #ruby("이|봉|수","李|奉|洙")가 #ruby("한|성|정|부","漢|城|政|府")의 #ruby("각|료","閣|僚") #ruby("명|단","名|單")을 가지고 #ruby("상|해","上|海")로 왔다.] 미리 짜거나 #ruby("의|논","議|論")하지 않았는데도 비슷한 두 #ruby("개","個")의 #ruby("정|부","政|府")가 생겨나게 되었다. 이에 두 #ruby("정|부","政|府")를 #ruby("개|조","改|組")하여 #ruby("이|승|만","李|承|晩")을 #ruby("대|통|령","大|統|領")에 #ruby("임|명","任|命")하고, 4#ruby("월","月") 11#ruby("일","日") #ruby("헌|법","憲|法")을 #ruby("반|포","頒|布")하였다. 이런 #ruby("내|용","內|容")은 #ruby("운|동|사","運|動|史")와 #ruby("임|시|정|부","臨|時|政|府") #ruby("회|의|록","會|議|錄")에 #ruby("상|세","詳|細")히 #ruby("기|록","記|錄")되어 있으니, 여기서는 나에 #ruby("대","對")한 #ruby("사|실","事|實")만을 쓴다.]
