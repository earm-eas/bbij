#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海")에서 #ruby("개|최","開|催")한 #ruby("국|민|대|표|회|의","國|民|代|表|會|議")는 ‘#ruby("잡|종|회","雜|種|會")’라 부를 만한 모임이었다. 이 #ruby("회|의","會|議")에 #ruby("참|석","參|席")하기 #ruby("위","爲")해 #ruby("일|본","日|本")·#ruby("조|선","朝|鮮")·#ruby("중|국","中|國")·#ruby("러|시|아","俄|西|亞") #ruby("등","等") #ruby("각","各") #ruby("처","處")에서 #ruby("한|인|단|체","韓|人|團|體") #ruby("대|표","代|表")로 200#ruby("여","餘") #ruby("명","名")이 #ruby("각|양|각|색","各|樣|各|色")의 #ruby("명|칭","名|稱")으로 모여들었다. 그#ruby("중","中") 이르쿠츠크#ruby("파","派") #ruby("공|산|당","共|産|黨")과 #ruby("상|해|파","上|海|派") #ruby("공|산|당","共|産|黨")이 서로 #ruby("경|쟁|적","競|爭|的")으로 #ruby("민|족|주|의|자","民|族|主|義|者") #ruby("대|표","代|表")들을 #ruby("분|열","分|裂")시켜, 이르쿠츠크#ruby("파","派")는 #ruby("임|시|정|부","臨|時|政|府") #ruby("창|조","創|造")를, #ruby("상|해|파","上|海|派")는 #ruby("개|조","改|造")를 #ruby("각|각","各|各") #ruby("주|장","主|張")하였다. 이른바 #ruby("창|조|파","創|造|派")는 #ruby("현|임|시|정|부","現|臨|時|政|府")를 #ruby("취|소","取|消")하고 새로 #ruby("정|부","政|府")를 #ruby("조|직","組|織")하자는 것이고, #ruby("개|조|파","改|造|派")는 #ruby("현|정|부","現|政|府")를 #ruby("개|조","改|造")하자는 것이었다. #ruby("결|국","結|局") 하나로 #ruby("의|견","意|見")을 #ruby("통|일","統|一")시키지 못하여 #ruby("회|의","會|議")가 #ruby("분|열","分|裂")되었다.#footnote(numbering: _ => [21)])[#h(0.35em)1923#ruby("년","年") 1#ruby("월","月") #ruby("상|해","上|海")에서 #ruby("개|최","開|催")된 #ruby("국|민|대|표|대|회","國|民|代|表|大|會")에는 60#ruby("여","餘") #ruby("개","個") 그룹의 #ruby("대|표","代|表") 113#ruby("명","名")이 #ruby("참|석","參|席")하였다. #ruby("의|장","議|長")으로는 #ruby("간|도","間|島")에서 온 #ruby("김|동|삼","金|東|三")이, #ruby("부|의|장","副|議|長")으로는 #ruby("안|창|호","安|昌|浩")가 #ruby("선|출","選|出")되어 3#ruby("개|월","個|月") #ruby("이|상","以|上")에 걸쳐 92#ruby("차","次") #ruby("회|합","會|合")을 가졌지만, #ruby("민|족|운|동","民|族|運|動")의 #ruby("통|일","統|一")에 #ruby("실|패","失|敗")하였다. #ruby("당|시","當|時") #ruby("국|민|대|표|대|회","國|民|代|表|大|會")는 #ruby("임|정","臨|政")에 #ruby("대","對")한 #ruby("입|장","立|場")에 따라 ① #ruby("노|령","露|領")·#ruby("만|주|계","滿|洲|系")의 #ruby("창|조|파","創|造|派"), ② #ruby("국|내","國|內")·#ruby("미|주|계","美|洲|系")의 #ruby("개|조|파","改|造|派"), ③ #r