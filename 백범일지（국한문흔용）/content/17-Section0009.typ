#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째, #ruby("소|위","所|謂") #ruby("한|일|합|병","韓|日|合|倂")의 참된 #ruby("의|미","意|味")를 그 #ruby("전","前")까지는 깨닫지 못하였기 때문이다. #ruby("단|국","檀|國") #ruby("개|국","開|國") #ruby("이|후","以|後") #ruby("명|의","名|義")#ruby("상","上")으로는 #ruby("이|민|족","異|民|族")의 #ruby("속|국","屬|國")이 된 때도 있었고, 우리 스스로도 #ruby("이|씨","李|氏")가 #ruby("왕|씨","王|氏")를 #ruby("혁|명","革|命")하고 스스로 #ruby("왕","王")이 된 #ruby("전|례","前|例")가 있었다. 때문에 #ruby("왜","倭")놈에게 #ruby("병|탄","倂|吞")#ruby("당","當")해도 #ruby("당","唐")·#ruby("원","元")·#ruby("명","明")·#ruby("청","淸")의 #ruby("시|대","時|代")와 같이, 우리가 #ruby("완|전","完|全") #ruby("자|치","自|治")를 하고 #ruby("명|의","名|義")#ruby("상","上")으로만 #ruby("왜","倭")의 #ruby("속|국","屬|國")이 되는 것으로 아는 #ruby("동|포","同|胞")가 #ruby("대|부|분","大|部|分")이었다. #ruby[베트남][安南]·#ruby("인|도","印|度")에서의 #ruby("영|국","英|國")·#ruby("불|란|서","佛|蘭|西") #ruby("식|민|정|치","植|民|政|治")를 #ruby("절|충","折|衷")하려는 #ruby("왜","倭")놈의 #ruby("독|계","毒|計")를 꿰뚫어 보는 #ruby("인|사","人|士")는 100#ruby("분","分")의 2, 3에 #ruby("불|과","不|過")하였다. 그러나 #ruby("합|병","合|倂") #ruby("후","後") #ruby("제|1|착","第|一|着")으로 #ruby("안|악","安|岳") #ruby("사|건","事|件")을 #ruby("조|작","造|作")해낸 것과, #ruby("제|2|차","第|二|次")로 #ruby("선|천","宣|川") 105#ruby("인","人") #ruby("사|건","事|件")의 #ruby("참|학","慘|虐") #ruby("무|도","無|道")한 것을 보고 나서는 “#ruby("시|일|갈|상","是|日|曷|喪")”#footnote(numbering: _ => [2)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “언제 #ruby("망","亡")하련라”. #ruby("원|래","元|來")는 #ruby("시|일|갈|상","時|日|曷|喪"). 『#ruby("서|경","書|經")』 「#ruby("탕|서","湯|誓")」에 나오는 #ruby("구|절","句|節")로 #ruby("포|악","暴|惡")한 #ruby("군|주","君|主")의 #ruby("학|정","虐|政")에 시달리는 #ruby("백|성","百|姓")들이 #ruby("태|양","太|陽")이 무너져 #ruby("세|상","世|上")이 #ruby("망","亡")하기를 기다리는 #ruby("심|정","心|情")을 #ruby("의|미","意|味")한다.] 하는 #ruby("악|감|정","惡|感|情")이 #ruby("격|발","激|發")될 #ruby("기|분","氣|分")이 #ruby("농|후","濃|厚")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[둘째, #ruby("제|1|차","第|一|次") #ruby("세|계|대|전","世|界|大|戰")이 #ruby("종|료","終|了")되고 #ruby("파|리|강|화|회|의","巴|里|講|和|會|議")에서 #ruby("미|국","美|國") #ruby("대|통|령","大|統|領") 윌슨이 #ruby("민|족|자|결|주|의","民|族|自|決|主|義")를 #ruby("제|창","提|唱")하였다. #ruby("이|상","以|上") 두 가지 #ruby("원|인","原|因")으로 #ruby("만|세|운|동","萬|歲|運|動")이 #ruby("폭|발","爆|發")되었다.]
