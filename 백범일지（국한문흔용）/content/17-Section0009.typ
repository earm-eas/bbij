#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째 #ruby("정|부","政|府")가 아모리 #ruby("추|형|시|기","芻|形|時|期")일지라 하여도,#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("정|부","政|府")가 아무리 #ruby("위|축","萎|縮")되었다고 하더라도.”] #ruby("해|주","海|州") #ruby("서|촌","西|村") #ruby("김|존|위","金|尊|位")의 아들인 내가 한 나라의 #ruby("원|수","元|首")가 되는 것은 #ruby("국|가","國|家")·#ruby("민|족","民|族")의 #ruby("위|신","威|信")을 크게 떨어뜨리는 것이므로 #ruby("불|가","不|可")하다. 둘째 #ruby("이","李")·#ruby("홍","洪") #ruby("양|씨","兩|氏")도 #ruby("호|응","呼|應")하는 #ruby("인|재","人|材")가 없어 #ruby("실|패","失|敗")하였거늘, 내가 나서면 더욱 #ruby("호|응","呼|應")할 #ruby("인|재","人|材")가 없을 것이다.]
