#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그런 것이 아니오. #ruby("대|저","大|抵") #ruby("혁|명","革|命")이란 #ruby("유|혈|사|업","流|血|事|業")으로 어느 #ruby("민|족","民|族")에게나 #ruby("대|사","大|事")인데, #ruby("현|재","現|在") 우리의 #ruby("독|립|운|동","獨|立|運|動")은 #ruby("민|주|주|의|혁|명","民|主|主|義|革|命")에 #ruby("불|과","不|過")하오. 따라서 이대로 #ruby("독|립","獨|立")을 한 #ruby("후","後") 또다시 #ruby("공|산|혁|명","共|産|革|命")을 하게 되니, 두 번 #ruby("유|혈","流|血")은 우리 #ruby("민|족","民|族")에게도 큰 #ruby("불|행","不|幸")이오. 그러니 적은이#footnote(numbering: _ => [14)])[#h(0.35em)적은이는 아우님이란 뜻. #ruby("이|동|휘","李|東|輝")가 #ruby("수|하","手|下") #ruby("동|지","同|志")들에게 즐겨 쓰던 말이다.]도 나와 같이 #ruby("공|산|혁|명","共|産|革|命")을 하는 것이 어떠하오?”#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("이|동|휘","李|東|輝")의 #ruby("주|장","主|張")은 부르주아#ruby("민|주|주|의|혁|명","民|主|主|義|革|命")과 #ruby("사|회|주|의|혁|명","社|會|主|義|革|命")을 #ruby("동|시","同|時")에 #ruby("수|행","遂|行")하자는 것이다. #ruby("사|회|주|의","社|會|主|義") #ruby("이|념","理|念")의 #ruby("도|입","導|入") #ruby("초|기","初|期")에는 ‘#ruby("민|주|혁|명","民|主|革|命")’과 ‘#ruby("사|회|혁|명","社|會|革|命")’을 #ruby("동|시","同|時")에 #ruby("수|행","遂|行")하는 #ruby("좌|경|적","左|傾|的") #ruby("혁|명|론","革|命|論")이 #ruby("풍|미","風|靡")하였다.]]
