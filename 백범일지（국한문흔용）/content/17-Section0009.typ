#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("독|립|운|동","獨|立|運|動")이 우리 #ruby("한|민|족","韓|民|族")의 #ruby("독|자|성","獨|自|性")을 떠나서 어느 #ruby("제|3|자","第|三|者")의 #ruby("지|도","指|導")·#ruby("명|령","命|令")의 #ruby("지|배","支|配")를 받는다는 것은 #ruby("자|존|성","自|尊|性")을 #ruby("상|실","喪|失")한 #ruby("의|존|성","依|存|性") #ruby("운|동","運|動")입니다. #ruby("선|생","先|生")은 우리 #ruby("임|시|정|부","臨|時|政|府") #ruby("헌|장","憲|章")에 #ruby("위|배","違|背")되는 말을 하심이 크게 옳지 못하니, #ruby("제","弟")는 #ruby("선|생","先|生")의 #ruby("지|도","指|導")를 따를 수 없으며 #ruby("선|생","先|生")의 #ruby("자|중","自|重")을 #ruby("권|고","勸|告")합니다.”]
