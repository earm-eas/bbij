#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("국|민|대|회","國|民|大|會")가 #ruby("실|패","失|敗")한 #ruby("후","後") #ruby("상|해","上|海")에서는 #ruby("통|일","統|一")이란 #ruby("미|명","美|名")#ruby("하","下")에 #ruby("공|산|당|운|동","共|産|黨|運|動")이 끊어지지 않고 #ruby("민|족|운|동|자","民|族|運|動|者")들을 #ruby("종|용","慫|慂")하였다. #ruby("공|산|당","共|産|黨") #ruby("청|년","靑|年")들은 #ruby("여|전","如|前")히 #ruby("양|파","兩|派")로 나뉘어 #ruby("동|일","同|一")한 #ruby("목|적","目|的")과 #ruby("동|일","同|一")한 #ruby("명|칭","名|稱")으로 ‘#ruby("재","在")#ruby("중|국|청|년|동|맹","中|國|靑|年|同|盟")’과 ‘#ruby("주","住")#ruby("중|국|청|년|동|맹","中|國|靑|年|同|盟")’#footnote(numbering: _ => [23)])[#h(0.35em)#ruby("정|식","正|式") #ruby("명|칭","名|稱")은 ‘#ruby("재|중|국|한|인|청|년|동|맹","在|中|國|韓|人|靑|年|同|盟")’과 ‘#ruby("주|중|국|한|인|청|년|동|맹","住|中|國|韓|人|靑|年|同|盟")’이다. 이 #ruby("조|직","組|織")은 #ruby("각|각","各|各") #ruby("임|시|정|부","臨|時|政|府")가 있는 #ruby("상|해","上|海")에 #ruby("지|부","支|部")를 두고 있다.]을 #ruby("조|직","組|織")하고, #ruby("상|해","上|海")의 우리 #ruby("청|년","靑|年")들을 앞다투어 #ruby("포|섭","包|攝")하여 #ruby("독|립|운|동","獨|立|運|動")을 #ruby("공|산|운|동|화","共|産|運|動|化")하자고 #ruby("절|규","絶|叫")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러던 #ruby("중","中") 레닌은 #ruby("공|산|주|의|자","共|産|主|義|者")들에게 “#ruby("식|민|지|운|동","殖|民|地|運|動")은 #ruby("복|국|운|동","復|國|運|動")이 #ruby("사|회|운|동","社|會|運|動")보다 #ruby("우|선","優|先")하다”고 #ruby("발|표","發|表")하였다. 이 말이 한번 떨어지자 어제까지 #ruby("민|족|운|동","民|族|運|動") #ruby("즉","卽") #ruby("복|국|운|동","復|國|運|動")을 #ruby("비|난","非|難")·#ruby("조|소","嘲|笑")하던 #ruby("공|산|당|원","共|産|黨|員")들이 #ruby("돌|변","突|變")하여 #ruby("독|립","獨|立")·#ruby("민|족|운|동","民|族|運|動")을 #ruby("공|산|당","共|産|黨")의 #ruby("당|시","黨|是")로 #ruby("주|창","主|唱")하였다. 여기에 #ruby("민|족|주|의|자","民|族|主|義|者")들이 #ruby("자|연","自|然") #ruby("찬|동","贊|同")하고 나서서 ‘#ruby("유|일|독|립|당|촉|성|회","唯|一|獨|立|黨|促|成|會")’를 #ruby("성|립","成|立")시켰다.#footnote(numbering: _ => [24)])[#h(0.35em)1926#ruby("년","年") #ruby("말","末")부터 #ruby("좌|우|합|작","左|右|合|作")의 #ruby("유|일|당","唯|一|黨") #ruby("운|동","運|動")이 일어나 #ruby("국|내","國|內")에서는 #ruby("신|간|회","新|幹|會")가, #ruby("만|주","滿|洲")에서는 #ruby("삼|부|통|합|운|동","三|部|統|合|運|動")이, #ruby("중|국","中|國") #ruby("관|내|지|역","關|內|地|域")에서는 #ruby("한|국|유|일|독|립|당|촉|성|회","韓|國|唯|一|獨|立|黨|促|成|會")가 #ruby("결|성","結|成")되었다.] 그런데 #ruby("내|부","內|部")에서는 #ruby("의|연","依|然")히 #ruby("공|산|당","共|産|黨") #ruby("양|파","兩|派")의 #ruby("권|리|쟁|탈|전","權|利|爭|奪|戰")이 #ruby("음|양","陰|陽")으로 #ruby("치|열","熾|烈")하게 #ruby("대|립","對|立")되어 한 걸음도 #ruby("진|전","進|展")되기 어려웠다. #ruby("민|족|운|동|자","民|族|運|動|者")들도 #ruby("차|차","次|次") 깨우쳐 #ruby("공|산|당","共|産|黨")의 속임수에서 벗어나 #ruby("결|국","結|局") #ruby("유|일|독|립|당|촉|성|회","唯|一|獨|立|黨|促|成|會")는 #ruby("해|산","解|散")되고 말았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後") #ruby("한|국|독|립|당","韓|國|獨|立|黨")이 #ruby("조|직","組|織")되었다.#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("한|국|독|립|당","韓|國|獨|立|黨")은 1930#ruby("년","年") 1#ruby("월","月") #ruby("유|일|당","唯|一|黨") #ruby("운|동","運|動")의 #ruby("여|세","餘|勢")를 몰아 #ruby("상|해","上|海")에서 #ruby("창|립","創|立")되었다.] #ruby("한|독|당","韓|獨|黨")은 #ruby("순|전","純|全")한 #ruby("민|족|주|의|자","民|族|主|義|者")인 #ruby("이|동|녕","李|東|寧")·#ruby("안|창|호","安|昌|浩")·#ruby("조|완|구","趙|琬|九")·#ruby("이|유|필","李|裕|弼")·#ruby("차|이|석","車|利|錫")·#ruby("김|붕|준","金|朋|濬")·#ruby("김|구","金|九")·#ruby("송|병|조","宋|秉|祚") #ruby("등","等")을 #ruby("지|도|자","指|導|者")로 하여 #ruby("창|립","創|立")되었다. 이로부터 #ruby("민|족|주|의|자","民|族|主|義|者")와 #ruby("공|산|주|의|자","共|産|主|義|者")들이 #ruby("자|기","自|己")의 #ruby("수|단","手|段")에 #ruby("농|락","籠|絡")되지 않음을 깨닫고 #ruby("남|북","南|北") #ruby("만|주","滿|洲")로 #ruby("진|출","進|出")해서, #ruby("상|해","上|海")에서보다 #ruby("십|백","十|百") #ruby("배","倍") 더 #ruby("맹|렬","猛|烈")하게 #ruby("활|동","活|動")하였다. #ruby("이|상|룡","李|相|龍")의 #ruby("자|손","子|孫")은 #ruby("살|부|회","殺|父|會")까지 #ruby("조|직","組|織")하고 있었다. #ruby("살|부|회","殺|父|會")에서도 #ruby("체|면","體|面")을 #ruby("생|각","生|覺")해서인지 #ruby("회|원","會|員")이 #ruby("자|신","自|身")의 손으로 #ruby("직|접","直|接") 아비를 죽이는 것이 아니라, 너는 내 아비를 죽이고 나는 네 아비를 죽이는 것이 #ruby("규|칙","規|則")이라 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("남|북","南|北") #ruby("만|주","滿|洲")의 #ruby("독|립|운|동|단|체","獨|立|運|動|團|體")로 #ruby("정|의|부","正|義|部")·#ruby("신|민|부","新|民|部")·#ruby("참|의|부","參|議|部") #ruby("외","外")에 #ruby("남|군|정|서","南|軍|政|署")·#ruby("북|군|정|서","北|軍|政|署") #ruby("등","等") #ruby("각","各") #ruby("기|관","機|關")에 #ruby("공|산|당","共|産|黨")이 #ruby("침|입","侵|入")하여 #ruby("각","各") #ruby("기|관","機|關")을 #ruby("여|지","餘|地")없이 #ruby("파|괴","破|壞")·#ruby("훼|손","毁|損")하고 #ruby("인|명","人|命")을 #ruby("살|해","殺|害")하였다. #ruby("백|광|운","白|狂|雲")·#ruby("정|일|우","鄭|一|雨")·#ruby("김|좌|진","金|佐|鎭")·#ruby("김|규|식","金|奎|植")#footnote(numbering: _ => [26)])[#h(0.35em)위의 #ruby("김|규|식","金|奎|植")\(1880〜1931)은 #ruby("임|정","臨|政") #ruby("부|주|석","副|主|席") #ruby("김|규|식","金|奎|植")과는 #ruby("동|명|이|인","同|名|異|人")이다. 그는 #ruby("경|기|도","京|畿|道") #ruby("출|신","出|身")의 #ruby("독|립|운|동|가","獨|立|運|動|家")로 1907#ruby("년","年") #ruby("군|대","軍|隊") #ruby("해|산","解|散") #ruby("후","後") #ruby("의|병|운|동","義|兵|運|動")에 #ruby("참|여","參|與")하였고, 그 뒤 #ruby("일|본","日|本") #ruby("경|찰","警|察")에 #ruby("체|포","逮|捕")되어 #ruby("옥|고","獄|苦")를 치렀다. 1919#ruby("년","年") #ruby("북|로|군|정|서","北|路|軍|政|署") #ruby("사|단|장","師|團|長")에 #ruby("임|명","任|命")되어 이듬해 #ruby("청|산|리|전|투","靑|山|里|戰|鬪")에서 #ruby("전|과","戰|果")를 올렸다. #ruby("대|한|독|립|군|당","大|韓|獨|立|軍|黨") #ruby("총|사|령|관","總|司|令|官"), #ruby("고|려|혁|명|군","高|麗|革|命|軍") #ruby("총|사|령|관","總|司|令|官")을 #ruby("역|임","歷|任")하였으며 1931#ruby("년","年") #ruby("공|산|당|원","共|産|黨|員")에게 #ruby("피|살","被|殺")되었다.] #ruby("등","等") 우리 #ruby("운|동|계","運|動|界")에 다시 없는 #ruby("건|강","健|康")한 #ruby("장|군","將|軍")들을 다 잃어버렸고, 그로 #ruby("인","因")하여 #ruby("내","內")·#ruby("외|지","外|地") #ruby("동|포","同|胞")의 #ruby("독|립|사|상","獨|立|思|想")이 날로 #ruby("미|약","微|弱")해져 갔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 “#ruby("화","禍")는 홀로 오지 않는다”（禍不單行）고, #ruby("만|주","滿|洲") #ruby("동|북","東|北") 東三省（3#ruby("성","省")）의 #ruby("왕","王")이라 할 수 있는 #ruby("장|작|림","張|作|霖")과 #ruby("일|본","日|本")과의 #ruby("협|정","協|定")이 #ruby("성|립","成|立")되었다. 이로 #ruby("인","因")해 #ruby("한|인","韓|人") #ruby("독|립|운|동|가","獨|立|運|動|家")들은 붙잡히는 대로 #ruby("왜","倭")에게 넘겨졌다. #ruby("중|국","中|國") #ruby("백|성","百|姓")들은 #ruby("한|인","韓|人") 한#ruby("명","名")의 머리를 베어 #ruby("왜","倭")놈 #ruby("영|사|관","領|事|館")에 몇십 #ruby("원","元")에, #ruby("심|지|어","甚|之|於") 3〜4#ruby("원","元")엔 팔아 넘기기도 하였다. 어찌 #ruby("중|국","中|國")사람들뿐이랴. 그곳 우리 #ruby("한|인","韓|人")들은 비록 #ruby("중|국","中|國") #ruby("경|내","境|內")에 #ruby("거|주","居|住")하였지만 처음에는 #ruby("가|가|호|호","家|家|戶|戶")에서 해마다 #ruby("독|립|운|동","獨|立|運|動") #ruby("기|관","機|關")인 #ruby("정|의|부","正|義|部")나 #ruby("신|민|부","新|民|部")에 #ruby("정|성","精|誠")을 다해 부지런히 #ruby("세|금","稅|金")을 냈었다. 그러나 이와 같은 #ruby("순|박","純|朴")한 #ruby("동|포","同|胞")들도 우리 #ruby("무|장|대|오","武|裝|隊|伍")의 지나친 #ruby("위|력","威|力")과 #ruby("침|탈","侵|奪")을 #ruby("당","當")하게 되자 #ruby("점|차","漸|次") #ruby("반|발|심","反|發|心")이 생기게 되었다. 이로 #ruby("인","因")해 #ruby("독|립|군","獨|立|軍")이 #ruby("자|기","自|己") 집이나 동네에 #ruby("도|착","到|着")하면, #ruby("비|밀","祕|密")리에 #ruby("왜","倭")놈에게 #ruby("고|발","告|發")하는 #ruby("악|풍","惡|風")까지 생겼다. 또한 #ruby("독|립|운|동|자","獨|立|運|動|者")들까지도 #ruby("점|차","漸|次") #ruby("왜","倭")에게 #ruby("투|항","投|降")하는 #ruby("풍|습","風|習")이 생기고 보니, #ruby("동|북","東|北") 3#ruby("성","省")의 #ruby("운|동","運|動") #ruby("근|거|지","根|據|地")는 #ruby("자|연","自|然") #ruby("취|약","脆|弱")해질 수밖에 없었다. 그러다 #ruby("왜","倭")놈의 #ruby("보|호","保|護")#ruby("하","下")에 #ruby("만|주|국","滿|洲|國")이 #ruby("탄|생","誕|生")하니 #ruby("만|주","滿|洲")는 ‘#ruby("제|2","第|二")의 #ruby("조|선","朝|鮮")’이 되어버렸다. 이 얼마나 아프고 쓰린 일인가.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|북","東|北") 3#ruby("성","省")의 #ruby("정|의","正|義")·#ruby("신|민","新|民")·#ruby("참|의|부","參|議|部")와 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("관|계","關|係")는 어떠하였던가. #ruby("임|시|정|부","臨|時|政|府")가 처음 #ruby("조|직","組|織")되었을 때, 3#ruby("부","部")는 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("최|고|기|관","最|高|機|關")으로 #ruby("인|정","認|定")하고 #ruby("추|대","推|戴")하였다. 그러나 그 뒤 3#ruby("부","部")가 #ruby("점|차","漸|次") #ruby("할|거","割|據")하여 #ruby("군|정","軍|政")·#ruby("민|정","民|政")을 #ruby("합|작","合|作")하지 않고 #ruby("세|력","勢|力")을 다투어 서로 #ruby("전|쟁","戰|爭")까지 하였다. “#ruby("자|모|이|후","自|侮|而|後")에 #ruby("인","人")이 #ruby("모|지","侮|之")라”#footnote(numbering: _ => [27)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “스스로 업신여기면 다른 사람도 나를 업신여기게 된다.” #ruby("출|전","出|典")은 『#ruby("맹|자","孟|子")』 「#ruby("이|루","離|婁")」 #ruby("상","上").]고 함은 바로 이를 가리킨 #ruby("격|언","格|言")이라 할 수 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("정|세","情|勢")로 말하면 #ruby("동|북","東|北") 3#ruby("성","省") #ruby("방|면","方|面")에 우리 #ruby("독|립|군","獨|立|軍")이 벌써 자취를 감추었을 터이나, #ruby("신|흥|학|교","新|興|學|校") #ruby("시|절","時|節") #ruby("이|후","以|後") 30#ruby("여","餘") #ruby("년","年")이 지난 오늘까지 오히려 #ruby("김|일|성","金|日|成")#footnote(numbering: _ => [28)])[#h(0.35em)#ruby("원|문","原|文"): “金一聲”. ‘金一聲’은 ‘金日成’이다.] #ruby("등","等") #ruby("무|장|부|대","武|裝|部|隊")가 #ruby("의|연","依|然")히 #ruby("산|악|지|대","山|岳|地|帶")에 #ruby("의|거","依|據")하여 #ruby("엄|존","儼|存")하고 있다. 이들의 #ruby("압|록","鴨|綠")·#ruby("두|만","豆|滿")을 넘나들며 #ruby("왜|병","倭|兵")과 #ruby("전|쟁","戰|爭")을 할 수 있었던 것은, #ruby("중|국","中|國") #ruby("의|용|군","義|勇|軍")과 #ruby("연|합|작|전","聯|合|作|戰")을 하고 #ruby("러|시|아","俄|西|亞")의 #ruby("후|원","後|援")도 받았기 때문이다. 이렇게 #ruby("현|상","現|狀") #ruby("유|지","維|持")를 하는 #ruby("정|세","情|勢")라, #ruby("관|내","關|內") #ruby("임|시|정|부","臨|時|政|府") #ruby("방|면","方|面")과의 #ruby("연|락","連|絡")은 #ruby("극","極")히 #ruby("곤|란","困|難")하게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("종|전","從|前")의 #ruby("정|의","正|義")·#ruby("참|의","參|議")·#ruby("신|민","新|民") 3#ruby("부","部") #ruby("중","中") #ruby("참|의|부","參|議|部")는 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("시|종|일|관","始|終|一|貫") #ruby("옹|호","擁|護")·#ruby("추|대","推|戴")하였다. 그런데 3#ruby("부","部")가 #ruby("통|일","統|一")하여 #ruby("정|의|부","正|義|部")로 되자 서로 짓밟아 #ruby("종|막","終|幕")을 #ruby("고","告")하게 된 데에는, #ruby("공|산|당","共|産|黨")과 #ruby("민|족|당","民|族|黨")의 #ruby("충|돌","衝|突")이 #ruby("중|요","重|要")한 #ruby("요|인","要|因")으로 #ruby("작|용","作|用")하였다. 그리하여 #ruby("공|산|진|영","共|産|陣|營")이나 #ruby("민|족|진|영","民|族|陣|營")의 #ruby("말|로","末|路")는 같은 #ruby("운|명","運|命")으로 #ruby("귀|결","歸|結")되었다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) #ruby("무|정|부|상|태","無|政|府|狀|態")의 #ruby("국|무|령","國|務|領")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海") #ruby("정|세","情|勢")도 #ruby("대|략","大|略"), 서로 #ruby("패","敗")하여 함께 #ruby[망한][兩敗俱喪] 꼴이 되었으나, #ruby("임|시|정|부","臨|時|政|府")와 #ruby("한|국|독|립|당","韓|國|獨|立|黨")으로 #ruby("민|족|진|영","民|族|陣|營")의 #ruby("잔|해","殘|骸")만은 겨우 #ruby("유|지","維|持")하고 있었다. 그러나 #ruby("임|시|정|부","臨|時|政|府")는 #ruby("인|재","人|材")도 #ruby("극","極")히 #ruby("귀","貴")하고 #ruby("경|제","經|濟")도 매우 어려웠다. #ruby("정|부|제|도","政|府|制|度")는 #ruby("대|통|령","大|統|領") #ruby("이|승|만","李|承|晩")이 #ruby("교|체","交|替")되고 #ruby("박|은|식","朴|殷|植")이 #ruby("취|임","就|任")하였고, #ruby("대|통|령|제|도","大|統|領|制|度")를 #ruby("변|경","變|更")하여 #ruby("국|무|령|제","國|務|領|制")로 고쳤다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("제|1|대","第|一|代") #ruby("국|무|령","國|務|領")으로 #ruby("이|상|룡","李|相|龍")이 #ruby("취|임","就|任")하기 #ruby("위","爲")하여 #ruby("서|간|도","西|間|島")로부터 #ruby("상|해","上|海")에 #ruby("도|착","到|着")하였지만, #ruby("인|재","人|材")를 고르다가 #ruby("지|원|자","志|願|者")가 없자 도로 #ruby("간|도","間|島")로 돌아가버렸다. 그 다음에 #ruby("홍|면|희","洪|冕|熙")#footnote(numbering: _ => [29)])[#h(0.35em)#ruby("홍|면|희","洪|冕|熙")는 #ruby("홍|진","洪|震")\(1877〜1946)의 #ruby("본|명","本|名"). 그는 3·1#ruby("운|동","運|動") #ruby("후","後") #ruby("상|해","上|海")로 #ruby("망|명","亡|命")하여 #ruby("임|시|정|부","臨|時|政|府") #ruby("국|무|령","國|務|領"), #ruby("의|정|원","議|政|院") #ruby("의|장","議|長") #ruby("등","等")을 #ruby("역|임","歷|任")하였고, #ruby("해|방","解|放") #ruby("후","後") #ruby("비|상|국|민|회|의","非|常|國|民|會|議") #ruby("의|장","議|長")으로 #ruby("활|약","活|躍")하던 #ruby("중","中") #ruby("병|사","病|死")하였다.]를 #ruby("선|거","選|擧")하여, 그가 #ruby("진|강","鎭|江")에서 #ruby("상|해","上|海")로 와서 #ruby("취|임","就|任")한 #ruby("후","後") #ruby("조|각","組|閣")에 #ruby("착|수","着|手")하였으나, #ruby("역|시","亦|是") #ruby("호|응","呼|應")하는 #ruby("인|물","人|物")이 없으므로 #ruby("실|패","失|敗")하고 말았다.]
