#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하였다. 그것은 #ruby("자|기","自|己") #ruby("남|편","男|便")이 #ruby("존|경","尊|敬")하는 #ruby("노|선|배","老|先|輩")를 #ruby("친|절","親|切")히 #ruby("대|접","待|接")하기 #ruby("위","爲")함이었다. 그녀는 #ruby("초|산","初|産")에 딸아이 하나를 #ruby("해|산","解|産")하고 #ruby("불|행","不|幸")히도 #ruby("사|망","死|亡")하여 #ruby("노|가|만","盧|家|灣") #ruby("묘|지","墓|地")에 묻히게 되었다. 나는 그녀의 무덤을 볼 적마다, #ruby("엄|군","嚴|君")이 #ruby("능|력","能|力")이 #ruby("부|족","不|足")하다면 나라도 #ruby("능|력","能|力")이 생길 때 #ruby("기|념|묘|비","紀|念|墓|碑") 하나 세워주리라, 늘 #ruby("생|각","生|覺")하였다. 마침내 #ruby("상|해","上|海")를 떠날 때에는 그만한 #ruby("재|력","財|力")이 있었으나, #ruby("환|경","環|境")이 #ruby("여|의","如|意")치 못하여 그것도 뜻대로 되지 않았다. 이 글을 쓰는 오늘에도 #ruby("노|가|만","盧|家|灣") #ruby("공|무|국","工|務|局") #ruby("공|동|묘|지","共|同|墓|地")의 #ruby("임|씨","林|氏") 무덤이 눈에 어른거린다.#footnote(numbering: _ => [34)])[#h(0.35em)#ruby("엄|항|섭","嚴|恒|燮")\(1898〜1962)에 #ruby("관","關")하여 길게 #ruby("언|급","言|及")되어 있듯이, 그는 #ruby("백|범","白|凡")의 #ruby("핵|심","核|心") #ruby("측|근","側|近")이었다. 그는 #ruby("청|년|운|동","靑|年|運|動")에 #ruby("참|가","參|加")하여 #ruby("재|중|한|인|청|년|동|맹","在|中|韓|人|靑|年|同|盟") #ruby("중|앙|위|원","中|央|委|員")을 #ruby("역|임","歷|任")하고 #ruby("한|국|독|립|당","韓|國|獨|立|黨") #ruby("선|전|부|장","宣|傳|部|長"), #ruby("임|시|정|부","臨|時|政|府") #ruby("선|전|부|장","宣|傳|部|長") #ruby("등","等")을 #ruby("역|임","歷|任")하면서 #ruby("김|구","金|九") #ruby("명|의","名|義")의 #ruby("발|표|문","發|表|文")이나 #ruby("성|명|서","聲|明|書") #ruby("대|부|분","大|部|分")을 #ruby("기|초","起|草")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") 나의 #ruby("중|요","重|要") #ruby("임|무","任|務")가 무엇이었는지 #ruby("언|급","言|及")하기 #ruby("위","爲")해, 그때의 #ruby("환|경","環|境")이 어떠하였는지를 먼저 말하고자 한다. #ruby("원|년","元|年")\(1919)에서 3〜4#ruby("년","年")을 지내고 보니, #ruby("열|렬","熱|烈")하던 #ruby("독|립|운|동|자","獨|立|運|動|者") 가운데 하나 둘씩 #ruby("왜","倭")놈에게 #ruby("투|항","投|降")하거나 #ruby("귀|국","歸|國")하는 #ruby("자","者")들이 생겨났다. 그러한 #ruby("자","者")들은 #ruby("임|시|정|부","臨|時|政|府") #ruby("군|무|차|장","軍|務|次|長") #ruby("김|희|선","金|羲|善")과 #ruby("독|립|신|문|사","獨|立|新|聞|社") #ruby("주|필","主|筆") #ruby("이|광|수","李|光|洙"), #ruby("의|정|원","議|政|院") #ruby("부|의|장","副|議|長") #ruby("정|인|과","鄭|仁|果") #ruby("등","等")을 #ruby("위|시","爲|始")하여, #ruby("점|차","漸|次") 그 #ruby("수","數")가 늘어났다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다른 한#ruby("편","便")으로는 #ruby("정|부","政|府")의 #ruby("비|밀|파|견","祕|密|派|遣")으로 #ruby("국|내","國|內")에 #ruby("귀|국","歸|國")하는 #ruby("동|지","同|志")들도 있었다. #ruby("비|밀|정|치|조|직","祕|密|政|治|組|織")으로 #ruby("연|통|제","聯|通|制")를 #ruby("실|시","實|施")하여 #ruby("경|성","京|城")에 #ruby("총|판|부","總|辦|部")를 두고, 13#ruby("도","道")에는 #ruby("독|판","督|辦"), #ruby("각","各") #ruby("군","郡")에는 #ruby("군|감","郡|監"), #ruby("각","各") #ruby("면","面")에는 #ruby("면|감","面|監")을 두었다. #ruby("각|각","各|各")의 #ruby("주|무|장|관","主|務|長|官")은 #ruby("임|시|정|부","臨|時|政|府")에서 #ruby("임|명","任|命")하여 #ruby("이|면","裏|面")으로 #ruby("전|국","全|國")을 #ruby("통|치","統|治")하였다. 뿐만 아니라 #ruby("인|민","人|民")들은 #ruby("비|밀","祕|密") #ruby("납|세","納|稅")도 #ruby("성|심","誠|心")으로 #ruby("납|부","納|付")하여, #ruby("상|해","上|海") #ruby("임|시|정|부","臨|時|政|府")의 #ruby("위|신","威|信")은 그만치 떨쳐 일어났다.#footnote(numbering: _ => [35)])[#h(0.35em)#ruby("연|통|제","聯|通|制")는 #ruby("상|해","上|海") #ruby("임|시|정|부","臨|時|政|府")가 #ruby("국|내|외","國|內|外")의 #ruby("독|립|운|동","獨|立|運|動")을 #ruby("지|휘","指|揮")·#ruby("감|독","監|督")하기 #ruby("위","爲")해 #ruby("설|치","設|置")했던 #ruby("비|밀|연|락|망","祕|密|連|絡|網")이다. #ruby("일|본","日|本")의 #ruby("철|저","徹|底")한 #ruby("감|시","監|視") 때문에 애초의 #ruby("의|도","意|圖")와는 달리 #ruby("경|상|남|북|도","慶|尙|南|北|道"), #ruby("충|청|남|도","忠|淸|南|道") 및 #ruby("제|주|도","濟|州|道")에는 #ruby("조|직","組|織")되지 못하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 #ruby("함|남","咸|南")으로부터 #ruby("연|통|제","聯|通|制")가 #ruby("왜","倭")에게 #ruby("발|각","發|覺")되자 이를 #ruby("시|작","始|作")으로 #ruby("각","各") #ruby("도","道") #ruby("조|직","組|織")이 #ruby("파|괴","破|壞")되니, #ruby("비|밀|사|명","祕|密|使|命")을 띠고 갔다가 #ruby("체|포","逮|捕")된 #ruby("자","者")는 #ruby("일|일","一|一")이 헤아릴 수 없었다. 또한 처음에는 #ruby("열|성","熱|誠")으로 큰 뜻을 품고 #ruby("상|해","上|海")에 온 #ruby("청|년","靑|年")들도, #ruby("점|점","漸|漸") #ruby("경|제|난","經|濟|難")으로 #ruby("인","因")하여 #ruby("취|직","就|職")하거나 #ruby("행|상","行|商")에 #ruby("종|사","從|事")하였다. 이로 #ruby("인","因")하여 한때 #ruby("상|해","上|海") 우리 #ruby("독|립|운|동|자","獨|立|運|動|者")의 #ruby("수","數")가 #ruby("천|여","千|餘") #ruby("명","名")이었던 것이, #ruby("차|차","次|次") 줄어들어 겨우 #ruby("수|십","數|十") #ruby("명","名")에 #ruby("불|과","不|過")하였다. 그러니 #ruby("최|고|기|관","最|高|機|關")인 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("현|상","現|狀")을 #ruby("족","足")히 #ruby("짐|작","斟|酌")하고도 남음이 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("최|초","最|初")에는 #ruby("정|부","政|府")의 #ruby("문|파|수","門|把|守")를 #ruby("청|원","請|願")하였으나, 끝내는 #ruby("노|동|총|판","勞|動|總|辦"), #ruby("내|무|총|장","內|務|總|長"), #ruby("국|무|령","國|務|領"), #ruby("국|무|위|원","國|務|委|員"), #ruby("주|석","主|席")으로 #ruby("중|임","重|任")을 거의 #ruby("역|임","歷|任")하였다.#footnote(numbering: _ => [36)])[#h(0.35em)#ruby("백|범","白|凡")은 1919#ruby("년","年") #ruby("임|정","臨|政") #ruby("결|성|시","結|成|時")에는 #ruby("경|무|국|장","警|務|局|長")으로 #ruby("취|임","就|任")하였으나, 1923#ruby("년","年") #ruby("내|무|총|장","內|務|總|長"), 1924#ruby("년","年") #ruby("임|정|국|무|총|리|대|리","臨|政|國|務|總|理|代|理"), 1926#ruby("년","年") 12#ruby("월","月") #ruby("국|무|령","國|務|領"), 1927#ruby("년","年") #ruby("국|무|위|원","國|務|委|員") #ruby("등","等")을 #ruby("역|임","歷|任")하였다. 1930#ruby("년","年")과 1935#ruby("년","年") #ruby("국|무|위|원","國|務|委|員")에 #ruby("재|선","再|選")된 #ruby("후","後"), 1940#ruby("년","年")과 1944#ruby("년","年") #ruby("개|정","改|正")된 #ruby("임|정|헌|법","臨|政|憲|法")에 따라 #ruby("주|석","主|席")에 #ruby("취|임","就|任")하였다.] 이렇게 된 것은 나의 #ruby("문|파|수","門|把|守") #ruby("자|격","資|格")이 #ruby("진|보","進|步")된 것이 아니라, #ruby("임|시|정|부","臨|時|政|府")의 #ruby("인|재|난","人|材|難")·#ruby("경|제|난","經|濟|難")이 #ruby("극|도","極|度")에 달하였기 때문이다. 그것은 마치 #ruby("명|성","名|聲")이 #ruby("쟁|쟁","錚|錚")했던 #ruby("인|가","人|家")가 #ruby("몰|락","沒|落")하여, 그 #ruby("고|대|광|실","高|大|廣|室")이 #ruby("걸|인","乞|人")의 #ruby("소|굴","巢|窟")이 된 것과 #ruby("흡|사","恰|似")한 #ruby("형|편","形|便")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|승|만","李|承|晩") #ruby("대|통|령","大|統|領")이 #ruby("취|임","就|任")·#ruby("시|무","視|務")할 때는 #ruby("중|국","中|國") #ruby("인|사","人|士")는 #ruby("물|론","勿|論")이고, 눈 푸르고 코 큰 #ruby("영","英")·#ruby("불","佛")·#ruby("미","美") #ruby("친|구","親|舊")들도 더러 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("방|문","訪|問")하였다. 그러나 이제 #ruby("임|시|정|부","臨|時|政|府")에 #ruby("서|양|인","西|洋|人")이라고는 #ruby("공|무|국","工|務|局")의 #ruby("불|란|서","佛|蘭|西") #ruby("경|찰","巡|捕")이 #ruby("왜","倭")놈을 #ruby("대|동","帶|同")하고 사람을 잡으러 오거나, #ruby("세|금","稅|金") #ruby("독|촉","督|促")으로 오는 이 #ruby("외","外")에는 없었다.#footnote(numbering: _ => [37)])[#h(0.35em)#ruby("당|시","當|時") #ruby("임|시|정|부","臨|時|政|府")는 집#ruby("세","貰") 36달러도 내기 어려운 #ruby("형|편","形|便")이었다.] #ruby("상|해","上|海")에서 #ruby("서|양","西|洋")사람들 틈 속에 끼여 살지만, #ruby("서|양|인","西|洋|人") #ruby("친|구","親|舊")라곤 단 한 사람도 찾아오는 #ruby("자","者")가 없었다. 그렇지만 #ruby("매|년","每|年") 크리스마스에는 적어도 몇백 #ruby("원","元")어치의 #ruby("물|품","物|品")을 사서 #ruby("불|란|서","佛|蘭|西") #ruby("영|사","領|事")와 #ruby("공|무|국","工|務|局"), 그#ruby("전","前")의 #ruby("서|양|인","西|洋|人") #ruby("친|구","親|舊")들에게 #ruby("선|물","膳|物")하였다. 어떠한 #ruby("곤|란","困|難") #ruby("중","中")이라도 14#ruby("년","年") 동안 #ruby("연|중","年|中") #ruby("행|사","行|事")로 #ruby("실|행","實|行")한 것은 우리 #ruby("임|시|정|부","臨|時|政|府")가 #ruby("존|재","存|在")한다는 #ruby("흔|적","痕|跡")을 그들에게 #ruby("인|식","認|識")시키려는 #ruby("방|법","方|法")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 무렵 내가 #ruby("연|구","硏|究")·#ruby("실|행","實|行")했던 #ruby("사|무","事|務")가 하나 있으니, 곧 #ruby("편|지|정|책","便|紙|政|策")이다. #ruby("당|시","當|時") #ruby("사|방","四|方")을 돌아보아도 #ruby("정|부","政|府")의 #ruby("사|업","事|業") #ruby("발|전","發|展")은 #ruby("고|사","姑|捨")하고, 이름이라도 #ruby("보|전","保|全")할 길이 #ruby("막|연","漠|然")함을 느꼈다. 그러던 #ruby("중","中") #ruby("임|시|정|부","臨|時|政|府")가 #ruby("해|외","海|外")에 있는 만큼 #ruby("해|외","海|外") #ruby("동|포","同|胞")들에게 #ruby("의|뢰","依|賴")할 수밖에 없다는 #ruby("사|실","事|實")을 깨닫게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("해|외","海|外")에 #ruby("거|주","居|住")하는 #ruby("동|포","同|胞")는 #ruby("동|북","東|北") 3#ruby("성","省")에 가장 많았는데, 거기에는 250#ruby("여","餘")#ruby("만","萬") #ruby("명","名")의 #ruby("동|포","同|胞")가 살고 있었으나 #ruby("사|정","事|情")이 #ruby("본|국","本|國")과 #ruby("별","別")로 다르지 않았다. 두번째로는 #ruby("러|시|아|령","俄|西|亞|領")에 150#ruby("여","餘")#ruby("만","萬") #ruby("명","名")이 살고 있었지만, #ruby("공|산|국|가","共|産|國|家")라 #ruby("민|족|운|동","民|族|運|動")을 #ruby("금|지","禁|止")하여 그곳 #ruby("동|포","同|胞")들에게 #ruby("의|뢰","依|賴")하는 것은 #ruby("불|가|능","不|可|能")하였다. 세번째로 #ruby("일|본","日|本")에 40〜50#ruby("만","萬") #ruby("명","名")이 #ruby("거|주","居|住")하나 #ruby("역|시","亦|是") #ruby("의|뢰","依|賴")할 #ruby("형|편","形|便")이 못 되었다. 네번째로 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")·멕시코·쿠바에 #ruby("만|여","萬|餘") #ruby("명","名")이 살고 있었는데, 그들 #ruby("대|다|수","大|多|數")는 비록 #ruby("노|동|자","勞|動|者")였지만 #ruby("애|국|심","愛|國|心") 하나만은 #ruby("강|렬","强|烈")하였다. 그와 같이 된 까닭은 그곳에 살고 있는 #ruby("서|재|필","徐|載|弼") #ruby("박|사","博|士"), #ruby("이|승|만","李|承|晩") #ruby("박|사","博|士"), #ruby("안|창|호","安|昌|浩"), #ruby("박|용|만","朴|容|萬") #ruby("등","等")의 가르침을 받았기 때문이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그곳 #ruby("동|포","同|胞")들에게 #ruby("사|정","事|情")을 알리고 #ruby("정|부","政|府")에 #ruby("성|금","誠|金")을 바치게 할 #ruby("계|획","計|劃")을 세웠다. 그러나 #ruby("불|행","不|幸")히도 내가 #ruby("영|어","英|語")에 #ruby("문|외|한","門|外|漢")이라 손수 #ruby("편|지","便|紙") 겉#ruby("봉","封")도 쓸 수 없었고, 또한 그곳 #ruby("동|포","同|胞")들 #ruby("중","中") 몇 사람의 #ruby("친|지","親|知")가 있으나 #ruby("주|소","住|所")도 알 수 없는 #ruby("지|경","地|境")이었다. #ruby("다|행","多|幸")히 #ruby("엄|항|섭","嚴|恒|燮")·#ruby("안|공|근","安|恭|根") #ruby("등","等")의 도움으로 몇 사람의 #ruby("주|소","住|所")와 #ruby("성|명","姓|名")을 알아내어 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("현|상|황","現|狀|況")을 #ruby("극|진","極|盡")히 #ruby("설|명","說|明")하여 #ruby("동|정","同|情")을 #ruby("구","求")하는 #ruby("편|지","便|紙")를 쓰고, #ruby("엄|군","嚴|君")이나 #ruby("안|군","安|君")에게 겉#ruby("봉","封")을 쓰게 하여 #ruby("우|송","郵|送")하는 것이 내 #ruby("유|일","唯|一")한 #ruby("사|무","事|務")였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("수|신|인","受|信|人")이 없어서 #ruby("반|환","返|還")되어 돌아오는 #ruby("경|우","境|遇")도 더러 있었지만 #ruby("회|답","回|答")하는 #ruby("동|포","同|胞")들이 #ruby("점|차","漸|次") 늘어났다. 그#ruby("중","中")에 #ruby("시|카|고","芝|哥|古")의 #ruby("김|경","金|慶") 같은 이는 “집#ruby("세","貰")를 주지 못해 #ruby("정|부","政|府") #ruby("문","門")을 닫게 되었다”는 #ruby("보|도","報|道")를 보고, #ruby("즉|시","卽|時") #ruby("공|동|회","共|同|會")를 #ruby("소|집","召|集")하여 #ruby("미|화","美|貨") 200#ruby("여","餘") 달러를 #ruby("모|금","募|金")하여 보내준 일도 있었다.#footnote(numbering: _ => [38)])[#h(0.35em)#ruby("김|경","金|慶")의 #ruby("본|명","本|名")은 #ruby("김|병|준","金|炳|俊"). 그는 #ruby("도|산","島|山") #ruby("안|창|호","安|昌|浩")의 #ruby("지|지|자","支|持|者")였으며, #ruby("당|시","當|時") 그가 #ruby("임|시|정|부","臨|時|政|府")에 보내 준 200달러는 #ruby("임|정|인|사","臨|政|人|士") 아홉 #ruby("식|구","食|口")의 한 달 #ruby("기|본|생|활|비","基|本|生|活|費")에 #ruby("해|당","該|當")했다.] #ruby("김|경","金|慶") #ruby("씨","氏")와 나와 한 번도 만난 적 없지만 #ruby("애|국|심","愛|國|心") 하나로 이와 같이 한 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")·멕시코·쿠바의 #ruby("동|포","同|胞")들이 이같은 #ruby("애|국|심","愛|國|心")을 가지고 있으면서도 어찌하여 그 동안 #ruby("정|부","政|府") #ruby("성|금","誠|金")에 #ruby("소|홀","疏|忽")하였던가? 이와 같이 된 데는 다름이 아니라 1#ruby("년","年")에도 몇 #ruby("차|례","次|例")씩 #ruby("정|부","政|府") #ruby("각|료","閣|僚")들이 #ruby("변|경","變|更")되고, #ruby("헌|법","憲|法")도 자주 #ruby("변|경","變|更")됨에 따라 #ruby("정|부","政|府")의 #ruby("위|신","威|信")이 #ruby("추|락","墜|落")된 데 #ruby("원|인","原|因")이 있었다. 그런데다 #ruby("정|부","政|府") #ruby("사|정","事|情")을 자주 알려주지도 않아서 #ruby("동|포","同|胞")들이 #ruby("정|부","政|府")를 믿지 않았던 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("통|신","通|信")이 #ruby("진|실|성","眞|實|性")이 있는 데서 #ruby("점|차","漸|次") 믿음이 생기기 #ruby("시|작","始|作")하였다. 그리하여 #ruby("하|와|이","夏|威|夷")의 #ruby("안|창|호","安|昌|鎬"),#footnote(numbering: _ => [39)])[#h(0.35em)#ruby("하|와|이","夏|威|夷")의 #ruby("안|창|호","安|昌|鎬")는 #ruby("도|산","島|山") #ruby("안|창|호","安|昌|浩")와는 다른 #ruby("인|물","人|物")로 #ruby("하|와|이","夏|威|夷") #ruby("국|민|회","國|民|會") #ruby("계|통","系|統") #ruby("인|물","人|物")이다.] #ruby("가|와|이","加|哇|伊")\(Kauai)의 #ruby("현|순","玄|楯"), #ruby("김|상|호","金|商|鎬")·#ruby("이|홍|기","李|鴻|基")·#ruby("임|성|우","林|成|雨")·#ruby("박|종|수","朴|鍾|秀")·#ruby("문|인|화","文|寅|華")·#ruby("조|병|요","趙|炳|堯")·#ruby("김|현|구","金|鉉|九")·#ruby("안|원|규","安|源|奎")·#ruby("황|인|환","黃|仁|煥")·#ruby("김|윤|배","金|潤|培")·#ruby("박|신|애","朴|信|愛")·#ruby("심|영|신","沈|永|信") #ruby("등","等") #ruby("제|씨","諸|氏")가 나와 #ruby("정|부","政|府")에 #ruby("정|성","精|誠")을 보내주기 #ruby("시|작","始|作")하였다.#footnote(numbering: _ => [40)])[#h(0.35em)이들은 #ruby("주","主")로 ‘#ruby("하|와|이|애|국|단","夏|威|夷|愛|國|團")’과 ‘#ruby("가|와|이|단|합|회","加|哇|伊|團|合|會")’ #ruby("인|물","人|物")들이다. #ruby("가|와|이|단|합|회","加|哇|伊|團|合|會")는 1931#ruby("년","年") 4#ruby("월","月") 9#ruby("일","日") #ruby("가|와|이","加|哇|伊") 섬 가파아와 리피 두 #ruby("지|방","地|方")에 #ruby("거|류","居|留")하던 #ruby("동|포","同|胞")들이 #ruby("임|정","臨|政")의 #ruby("재|정","財|政") #ruby("후|원","後|援")을 #ruby("목|표","目|標")로 #ruby("결|성","結|成")한 #ruby("단|체","團|體")이며, 1939#ruby("년","年") 4#ruby("월","月") 29#ruby("일","日") #ruby("하|와|이|애|국|단","夏|威|夷|愛|國|團")에 #ruby("합|류","合|流")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[또한 #ruby[샌프란시스코][桑港]의 『#ruby("신|한|민|보","新|韓|民|報")』 #ruby("방|면","方|面")에서도 #ruby("점|차","漸|次") #ruby("정|부","政|府")에 #ruby("관|심","關|心")을 쏟기에 이르렀다. #ruby("김|호","金|乎")·#ruby("이|종|소","李|鍾|昭")·#ruby("홍|언","洪|焉")·#ruby("한|시|대","韓|始|大")·#ruby("송|종|익","宋|鍾|翊")·#ruby("최|진|하","崔|鎭|河")·#ruby("송|헌|수","宋|憲|樹")·#ruby("백|일|규","白|一|圭") #ruby("등","等") #ruby("제|씨","諸|氏")와, #ruby("멕|시|코","墨|西|哥")의 #ruby("김|기|창","金|基|昶")·#ruby("이|종|오","李|鍾|旿"), 쿠바의 #ruby("임|천|택","林|千|澤")·#ruby("박|창|운","朴|昌|雲") #ruby("등","等") #ruby("제|씨","諸|氏")가 #ruby("임|시|정|부","臨|時|政|府")에 #ruby("후|원","後|援")하였다.#footnote(numbering: _ => [41)])[#h(0.35em)『#ruby("신|한|민|보","新|韓|民|報")』는 #ruby("미|주","美|洲")의 #ruby("독|립|운|동|단|체","獨|立|運|動|團|體")인 #ruby("국|민|회","國|民|會") #ruby("계|통","系|統")의 #ruby("신|문","新|聞")이다. #ruby("국|민|회","國|民|會")는 #ruby("임|시|정|부","臨|時|政|府")의 #ruby("후|원","後|援")에 #ruby("적|극|적","積|極|的")이었으나 #ruby("이|승|만","李|承|晩") #ruby("중|심","中|心")의 #ruby("동|지|회","同|志|會")와는 #ruby("대|립","對|立")하는 #ruby("입|장","立|場")이었다.] #ruby("동|지|회","同|志|會") #ruby("방|면","方|面")에서도 #ruby("이|승|만","李|承|晩") #ruby("박|사","博|士")를 #ruby("필|두","筆|頭")로 하여 #ruby("이|원|순","李|元|淳")·#ruby("손|덕|인","孫|德|仁")·#ruby("안|현|경","安|賢|卿") #ruby("등","等") #ruby("제|씨","諸|氏")가 #ruby("정|부","政|府") #ruby("후|원","後|援")에 #ruby("참|가","參|加")하니,#footnote(numbering: _ => [42)])[#h(0.35em)#ruby("동|지|회","同|志|會")는 1921#ruby("년","年") #ruby("미|국","美|國") #ruby("하|와|이","夏|威|夷")에서 #ruby("이|승|만","李|承|晩")·#ruby("안|현|경","安|賢|卿") #ruby("등","等")이 #ruby("중|심","中|心")이 되어 #ruby("조|직","組|織")한 #ruby("독|립|운|동|단|체","獨|立|運|動|團|體")이다. #ruby("동|지|회","同|志|會")는 #ruby("임|정","臨|政") #ruby("후|원|단|체","後|援|團|體")로 #ruby("결|성","結|成")되었으나 #ruby("이|승|만","李|承|晩")의 #ruby("입|장","立|場")에 따라 때로는 #ruby("임|정","臨|政")에 #ruby("대|립|적","對|立|的")인 #ruby("입|장","立|場")을 보이기도 하였다.] #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷")·멕시코·쿠바의 우리 #ruby("교|포","僑|胞")들 #ruby("전|부","全|部")가 #ruby("정|부","政|府")의 #ruby("유|지","維|持")·#ruby("발|전","發|展")에 #ruby("공|동","共|同") #ruby("책|임","責|任")을 지게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러던 #ruby("중","中") #ruby("하|와|이","夏|威|夷")의 #ruby("안|창|호","安|昌|鎬")·#ruby("임|성|우","林|成|雨")#footnote(numbering: _ => [43)])[#h(0.35em)#ruby("임|성|우","林|成|雨")는 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("적|극","積|極") #ruby("후|원","後|援")한 #ruby("인|물","人|物")로 #ruby("하|와|이|애|국|단","夏|威|夷|愛|國|團")을 #ruby("조|직","組|織")하는 데 #ruby("주|도|적","主|導|的")인 #ruby("역|할","役|割")을 하였다.] #ruby("등","等") #ruby("제|씨","諸|氏")는 #ruby("장|래","將|來") #ruby("사|업","事|業")과 #ruby("관|련","關|聯")된 다음과 같은 #ruby("질|문|편|지","質|問|便|紙")를 보내왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("당|신","當|身")이 #ruby("정|부","政|府")를 지키고 있는 것을 #ruby("감|사","感|謝")히 #ruby("생|각","生|覺")한다. 그런데 #ruby("당|신","當|身") #ruby("생|각","生|覺")에 무슨 #ruby("사|업","事|業")을 하고 싶은가? 우리 #ruby("민|족","民|族")에 큰 도움이 되는 일이라면 돈을 #ruby("주|선","周|旋")하겠다.”]
