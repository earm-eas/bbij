#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|동|현","安|東|縣")에서 1919#ruby("년","年") 2#ruby("월","月")\(#ruby("음","陰")) 어느날, #ruby("영|국","英|國") #ruby("상|인","商|人") 죠지 소우(JeorgeShow)의 #ruby("윤|선","輪|船")을 타고 #ruby("동|행","同|行") 15#ruby("인","人")과 함께 4#ruby("일|간","日|間")의 #ruby("항|해","航|海") 끝에 #ruby("상|해","上|海") #ruby("포|동|선|창","浦|東|船|艙")에 #ruby("도|착","到|着")하였다. #ruby("상|륙","上|陸")할 때 눈에 선뜻 들어오는 것은 치마도 입지 않은 #ruby("여|자","女|子")들이 #ruby("삼|판|선","三|板|船")#footnote(numbering: _ => [1)])[#h(0.35em)#ruby("삼|판|선","三|板|船")은 #ruby("항|구","港|口") #ruby("근|처","近|處")에서 사람이나 짐을 실어 나르는 작은 거룻배.]의 노를 저으면서 #ruby("선|객","船|客")들을 실어 나르는 #ruby("광|경","光|景")이었다. #ruby("안|동|현","安|東|縣")에서 배를 탈 때 얼음덩이가 쌓인 것을 보았는데, #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地")에 #ruby("상|륙","上|陸")할 때는 거리의 #ruby("가|로|수","街|路|樹")에 #ruby("녹|음","綠|陰")이 우거져 있다. 옷을 입고도 배 안에서는 추위로 #ruby("고|생","苦|生")을 하였는데 이제는 등과 얼굴에 땀이 난다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海")에 #ruby("도|착","到|着")한 그날, #ruby("일|행","一|行")들과 같이 #ruby("공|승|서|리","公|昇|西|里") 15#ruby("호","號")에 있는 우리 #ruby("동|포","同|胞")의 집에서 담요만 깔고 방바닥 잠을 잤다. 다음날 #ruby("상|해","上|海")에 #ruby("집|합","集|合")한 #ruby("동|포","同|胞") #ruby("중","中")에 #ruby("친|구","親|舊")를 #ruby("조|사","調|査")하여 보니 #ruby("이|동|녕","李|東|寧") #ruby("선|생","先|生")을 #ruby("위|시","爲|始")하여, #ruby("이|광|수","李|光|洙")·#ruby("서|병|호","徐|丙|浩")·#ruby("김|홍|서","金|弘|敍")·#ruby("김|보|연","金|甫|淵") #ruby("등","等")이 있었다. #ruby("김|보|연","金|甫|淵")은 #ruby("장|연|군","長|淵|郡") #ruby("김|두|원","金|斗|元")의 큰 아들로 몇#ruby("년","年") #ruby("전","前") #ruby("처|자","妻|子")를 거느리고 #ruby("상|해","上|海")에 와서 살고 있었는데, 나를 찾아와 #ruby("자|기","自|己") 집에 함께 있기를 #ruby("청","請")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이날부터 그의 집에서 나의 #ruby("상|해","上|海")#ruby("생|활","生|活")이 #ruby("시|작","始|作")되었다. #ruby("주|인","主|人") #ruby("김|군","金|君")을 #ruby("안|내|자","案|內|者")로하여 10#ruby("여","餘") #ruby("년","年") 동안 밤낮으로 그리던 #ruby("이|동|녕","李|東|寧") #ruby("선|생","先|生")을 찾아갔다. #ruby("수|년","數|年") #ruby("전","前") #ruby("양|기|탁","梁|起|鐸")의 #ruby("사|랑|방","舍|廊|房")에서 #ruby("서|간|도","西|間|島") #ruby("무|관|학|교","武|官|學|校")의 #ruby("설|립","設|立")과 #ruby("지|사","志|士")들을 #ruby("소|집","召|集")하여 #ruby("광|복|사|업","光|復|事|業")을 #ruby("준|비","準|備")할 #ruby("책|임","責|任")을 맡았던 그때에 #ruby("비","比")해, 10#ruby("여","餘") #ruby("년","年") 동안 숱한 #ruby("고|생","苦|生")을 겪은 탓인지 그분의 #ruby("풍|성","豐|盛")하던 얼굴에 주름살이 잡혀 있었다. 서로 #ruby("악|수","握|手")하고 나니 #ruby("감|개|무|량","感|慨|無|量")하여 할 말을 잊었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("상|해","上|海")에 있는 #ruby("한|인","韓|人")은 500#ruby("여","餘") #ruby("명","名") #ruby("가|량","假|量") 되었다. 그 가운데 #ruby("약|간","若|干")의 #ruby("상|업","商|業") #ruby("종|사|자","從|事|者")와 #ruby("유|학|생","留|學|生"), 10#ruby("명","名") 남짓의 #ruby("전|차|회|사","電|車|會|社") #ruby("검|표|원","査|票|員")을 #ruby("제|외","除|外")하면, #ruby("대|부|분","大|部|分") #ruby("독|립|운|동","獨|立|運|動")을 #ruby("목|적","目|的")으로 #ruby("본|국","本|國")·#ruby("일|본","日|本")·#ruby("미|주","美|洲")·#ruby("중|국","中|國")·#ruby("러|시|아","俄|西|亞") #ruby("등","等")에서 모여든 #ruby("지|사","志|士")들이었다.]
