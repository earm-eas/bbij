#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("경|무|국|장","警|務|局|長") #ruby("시|절","時|節") #ruby("고|등|정|탐","高|等|偵|探")꾼 #ruby("선|우|갑","鮮|于|甲")을 #ruby("유|인","誘|引")하여 #ruby("포|박","捕|縛")·#ruby("신|문","訊|問")한 일이 있었다. 그는 죽을#ruby("죄","罪")를 지었음을 #ruby("시|인","是|認")하고 스스로 #ruby("사|형","死|刑") #ruby("집|행","執|行")을 #ruby("원","願")하였지만, 나는 뉘우치는 것을 보고 “살려줄 터이니 큰 #ruby("공","功")을 세워 #ruby("속|죄","贖|罪")할 것이냐?”고 물었다. 그가 #ruby("소|원","所|願")이라 하기로 #ruby("결|박","結|縛")을 풀어 보내주었더니, 그는 #ruby("상|해","上|海")에서 #ruby("정|탐","偵|探")한 #ruby("문|건","文|件")을 #ruby("임|시|정|부","臨|時|政|府")에 바치겠다는 뜻을 밝혔다. 나는 #ruby("시|간","時|間")을 #ruby("약|속","約|束")하고, 그를 만나기 #ruby("위","爲")해 #ruby("김|보|연","金|甫|淵")·#ruby("손|두|환","孫|斗|煥") #ruby("등","等")을 #ruby("왜","倭")놈의 #ruby("승|전|여|관","勝|田|旅|館")으로 보냈다. #ruby("과|연","果|然") 그는 #ruby("왜","倭")놈에게 #ruby("고|발","告|發")하지 않았고, 내가 #ruby("전|화","電|話")로 #ruby("호|출","呼|出")하면 #ruby("시|간","時|間")을 어기지 않고 #ruby("즉|시","卽|時") #ruby("대|기","待|機")하였다. 그러다가 4#ruby("일","日") #ruby("후","後") 몰래 #ruby("도|망","逃|亡")하여 #ruby("본|국","本|國")에 돌아가서, #ruby("임|시|정|부","臨|時|政|府")의 #ruby("덕","德")을 #ruby("칭|송","稱|頌")하고 다닌다는 #ruby("소|문","所|聞")을 들었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|인|우","姜|麟|佑")는 #ruby("왜","倭")놈의 #ruby("경|부","警|部")#footnote(numbering: _ => [7)])[#h(0.35em)#ruby("일|제","日|帝") 때의 #ruby("경|찰|관","警|察|官")으로 #ruby("경|시","警|視")의 아래 #ruby("계|급","階|級").]로서 #ruby("비|밀|사|명","祕|密|使|命")을 띠고 #ruby("상|해","上|海")에 와서, “#ruby("김|구","金|九") #ruby("선|생","先|生")에게 #ruby("자|기","自|己")가 #ruby("상|해","上|海")에 온 #ruby("임|무","任|務")를 #ruby("보|고","報|告")하겠으니 #ruby("면|회","面|會")를 #ruby("허|락","許|諾")해 달라”는 글을 보내왔다. 그는 만나는 #ruby("장|소","場|所")를, #ruby("왜","倭")놈과 #ruby("동|행","同|行")하면 나를 #ruby("체|포","逮|捕")할 수 있는 #ruby("영|국","英|國") #ruby("조|계|지","租|界|地")의 #ruby("신|세|계","新|世|界") #ruby("음|식|점","飮|食|店")으로 #ruby("청","請")하였다. #ruby("약|속","約|束")된 #ruby("시|각","時|刻")에 가서 보니 #ruby("강|인|우","姜|麟|佑") 혼자만 있었다. 그는 “#ruby("총|독|부","總|督|府")에서 제가 받은 #ruby("사|명","使|命")은 #ruby("모|모","某|某") #ruby("사|건","事|件")이므로 그#ruby("점","點")을 #ruby("주|의","注|意")하십시오”라고 알려주고, 또한 “#ruby("선|생","先|生")께서 거짓 #ruby("보|고|자|료","報|告|資|料")를 주시면 #ruby("귀|국","歸|國")하여 #ruby("책|임","責|任")이나 얼버무리겠습니다”라고 #ruby("제|안","提|案")하였다. 내가 #ruby("쾌","快")히 #ruby("승|낙","承|諾")하고 #ruby("자|료","資|料")를 만들어 주니, 그는 #ruby("귀|국","歸|國")하여 그 #ruby("공|로","功|勞")로 #ruby("풍|산","豊|山") #ruby("군|수","郡|守")가 되었다고 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("구|한|말","舊|韓|末") #ruby("내|무|대|신","內|務|大|臣")이었던 #ruby("동|농","東|農") #ruby("김|가|진","金|嘉|鎭")#footnote(numbering: _ => [8)])[#h(0.35em)#ruby("김|가|진","金|嘉|鎭")\(1846〜1922). 1877#ruby("년","年") #ruby("문|과","文|科")에 #ruby("급|제","及|第")한 #ruby("후","後") #ruby("병|조|참|의","兵|曹|參|議")·#ruby("공|조|판|서","工|曹|判|書")·#ruby("농|상|공|부|대|신","農|商|工|部|大|臣") #ruby("등","等")을 #ruby("역|임","歷|任")하였다. 그는 #ruby("일|본","日|本")이 #ruby("수|여","授|與")한 #ruby("남|작","男|爵") #ruby("직|위","職|位")를 #ruby("반|납","返|納")하고, #ruby("비|밀|결|사","祕|密|結|社")인 #ruby("대|동|단","大|同|團")의 #ruby("고|문","顧|問") 및 #ruby("총|재","總|裁")로 #ruby("추|대","推|戴")되어 #ruby("독|립|운|동","獨|立|運|動")에 #ruby("종|사","從|事")하였고, 3·1#ruby("운|동","運|動") #ruby("후","後") #ruby("상|해","上|海")로 #ruby("망|명","亡|命")하여 #ruby("임|시|정|부","臨|時|政|府")에 #ruby("참|여","參|與")하였다.] #ruby("선|생","先|生")은 #ruby("한|일|합|병","韓|日|合|倂") #ruby("후","後") #ruby("일|본","日|本")으로부터 #ruby("남|작","男|爵")의 #ruby("직|위","職|位")를 #ruby("수|여","授|與")받은 #ruby("인|물","人|物")이었다. 그런 그가 #ruby("기|미","己|未") 3·1#ruby("선|언","宣|言") #ruby("이|후","以|後")에 #ruby("대|동|당","大|同|黨")#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("대|동|당","大|同|黨") #ruby("혹","或")은 #ruby("대|동|단","大|同|團"). #ruby("원|래","元|來") #ruby("명|칭","名|稱")은 #ruby("조|선|민|족|대|동|단","朝|鮮|民|族|大|同|團"). 3·1#ruby("운|동","運|動") #ruby("직|후","直|後")인 1919#ruby("년","年") 3#ruby("월","月") #ruby("전|협","全|協")·#ruby("최|익|환","崔|益|煥") #ruby("등","等")이 #ruby("전","全") #ruby("조|선|민|족","朝|鮮|民|族")의 #ruby("대|단|결","大|團|結")을 #ruby("표|방","標|榜")하고 서울에서 #ruby("결|성","結|成")한 #ruby("독|립|운|동|단|체","獨|立|運|動|團|體")이다.]을 #ruby("조|직","組|織")해 #ruby("활|동","活|動")하다가, 아들 #ruby("의|한","毅|漢") #ruby("군","君")을 데리고 남은 #ruby("인|생","人|生")을 #ruby("독|립|운|동","獨|立|運|動")의 #ruby("책|원|지","策|源|地")에서 보낼 #ruby("목|적","目|的")으로 #ruby("상|해","上|海")에 #ruby("도|착","到|着")하였다. #ruby("후","後")에 #ruby("왜|총|독","倭|總|督")은 #ruby("남|작","男|爵")이 #ruby("독|립|운|동","獨|立|運|動")에 #ruby("참|가","參|加")한 것은 #ruby("일|본","日|本")의 #ruby("수|치","羞|恥")라 #ruby("생|각","生|覺")하여, #ruby("동|농","東|農") 며느리#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("원|문","原|文"): “懿漢子婦”. ‘懿漢’은 ‘毅漢’. #ruby("동|농","東|農")의 며느리인 #ruby("김|의|한","金|毅|漢")의 아내는 『#ruby("녹|두","綠|豆")꽃』의 #ruby("필|자","筆|者")인 #ruby("정|정|화","鄭|靖|和")이다. 그런데 #ruby("정|정|화","鄭|靖|和")는 #ruby("정|필|화","鄭|弼|和")를 #ruby("자|신","自|身")의 #ruby("팔|촌","八|寸")오빠라 #ruby("기|록","記|錄")하고 있어, #ruby("본|문","本|文")의 #ruby("사|촌","四|寸")오빠는 #ruby("기|억|상","記|憶|上") #ruby("착|오","錯|誤")인 듯하다.]의 #ruby("사|촌","四|寸")오빠가 되는 #ruby("정|필|화","鄭|弼|和")를 #ruby("비|밀","祕|密")리에 #ruby("파|견","派|遣")하여, #ruby("동|농","東|農") #ruby("선|생","先|生")에게 #ruby("은|밀","隱|密")히 #ruby("귀|국","歸|國")을 #ruby("종|용","慫|慂")하였다. 이것을 알아차린 #ruby("경|무|부","警|務|部")에서 #ruby("정|필|화","鄭|弼|和")를 #ruby("비|밀","祕|密")리에 #ruby("검|거","檢|擧")하여 #ruby("심|문","訊|問")하니, 그가 #ruby("사|실","事|實")을 낱낱이 #ruby("자|백","自|白")하므로 #ruby("교|수|형","絞|首|刑")에 #ruby("처","處")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("해|주","海|州")사람 #ruby("황|학|선","黃|學|善")은 #ruby("독|립|운|동","獨|立|運|動") #ruby("이|전","以|前")에 #ruby("상|해","上|海")에 #ruby("도|착","到|着")한 #ruby("청|년","靑|年")으로 우리 #ruby("독|립|운|동","獨|立|運|動")에 #ruby("열|정","熱|情")이 있어 보였다. 그런데 그는 #ruby("각","各") #ruby("방|면","方|面")에서 #ruby("상|해","上|海")로 모여든 #ruby("지|사","志|士")들이 #ruby("자|신","自|身")의 집에 #ruby("숙|식","宿|食")하는 것을 #ruby("기|화","奇|貨")로, 세워진 지 며칠 되지도 않은 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("악|평","惡|評")하였다. 이 때문에 새로 #ruby("도|착","到|着")한 #ruby("청|년","靑|年") #ruby("중","中"), #ruby("동|농","東|農") #ruby("선|생","先|生")과 같이 서울에서 #ruby("열|렬","熱|烈")히 #ruby("운|동","運|動")하던 #ruby("나|창|헌","羅|昌|憲") #ruby("등","等")은 #ruby("황","黃")의 #ruby("악|랄","惡|辣")한 #ruby("계|략","計|略")에 걸리어 #ruby("정|부","政|府")에 #ruby("대","對")해 #ruby("극|단|적","極|端|的")인 #ruby("악|감|정","惡|感|情")을 품게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[마침내 #ruby("김|기|제","金|基|濟")·#ruby("김|의|한","金|毅|漢") #ruby("등","等") #ruby("십|수","十|數") #ruby("명","名")이 #ruby("임|시|정|부","臨|時|政|府") #ruby("내|무|부","內|務|部")를 #ruby("습|격","襲|擊")한 #ruby("사|건","事|件")이 #ruby("발|생","發|生")하였다. 이에 #ruby("당|시","當|時") #ruby("정|부","政|府")를 #ruby("옹|호","擁|護")하던 #ruby("청|년","靑|年")들이 #ruby("극|도","極|度")로 #ruby("분|격","憤|激")하여 #ruby("육|박|전","肉|搏|戰")이 #ruby("시|작","始|作")되어, #ruby("나|창|헌","羅|昌|憲")·#ruby("김|기|제","金|基|濟") 두 사람이 #ruby("중|상","重|傷")을 입었다. #ruby("내|무|총|장","內|務|總|長") #ruby("이|동|녕","李|東|寧") #ruby("선|생","先|生")의 #ruby("명|령","命|令")에 따라 #ruby("포|박","捕|縛")된 #ruby("청|년","靑|年") 10#ruby("여","餘") #ruby("명","名")은 타일러서 풀어주고, #ruby("중|상","重|傷")을 #ruby("당","當")한 #ruby("나","羅")·#ruby("김","金") 두 사람은 #ruby("입|원","入|院") #ruby("치|료","治|療")하게 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("경|무|국","警|務|局")에서 그 #ruby("분|란","紛|亂")의 #ruby("원|인","原|因")을 깊이 #ruby("조|사","調|査")하였는데, 그 #ruby("결|과","結|果") 놀랄 만한 #ruby("사|실","事|實")을 #ruby("발|견","發|見")하였다. #ruby("나","羅")·#ruby("김","金") #ruby("등","等")의 #ruby("활|동","活|動") #ruby("배|후","背|後")는 #ruby("황|학|선","黃|學|善")인데, #ruby("황","黃")이 이들에게 #ruby("활|동|자|금","活|動|資|金")을 #ruby("제|공","提|供")하였고, #ruby("배|후","背|後")의 #ruby("일|본","日|本") #ruby("영|사|관","領|事|館")은 #ruby("황","黃")에게 #ruby("자|금","資|金")과 #ruby("계|획","計|劃")을 #ruby("제|공","提|供")한 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[마침내 #ruby("황","黃")을 #ruby("비|밀","祕|密")리에 #ruby("체|포","逮|捕")하여 #ruby("심|문","訊|問")한 #ruby("결|과","結|果"), 그가 #ruby("나|창|헌","羅|昌|憲") #ruby("등","等")의 #ruby("애|국|열|정","愛|國|熱|情")을 #ruby("이|용","利|用")하여, #ruby("정|부","政|府")의 #ruby("각","各") #ruby("총|장","總|長")과 #ruby("경|무|국|장","警|務|局|長") #ruby("김|구","金|九")까지 #ruby("전|부","全|部") #ruby("암|살","暗|殺")할 무서운 #ruby("계|획","計|劃")을 꾸미고 있다는 #ruby("사|실","事|實")을 알게 되었다. #ruby("황","黃")은 외딴 곳에 3#ruby("층","層") #ruby("양|옥","洋|屋")을 #ruby("세","貰")내어 #ruby("대|문","大|門")에 #ruby("민|생|의|원","民|生|醫|院")이란 큰 #ruby("간|판","看|板")을 붙이고, #ruby("나|창|헌","羅|昌|憲")이 #ruby("의|과|생","醫|科|生")인 #ruby("점","點")을 #ruby("이|용","利|用")하여 #ruby("정|부|요|인","政|府|要|人")들을 #ruby("유|인","誘|引")하여 #ruby("암|살","暗|殺")할 #ruby("계|획","計|劃")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황","黃")의 #ruby("신|문|기|록","訊|問|記|錄")을 #ruby("나|창|헌","羅|昌|憲")에게 보여주니, #ruby("나|군","羅|君")은 깜짝 놀라며 #ruby("황","黃")에게 속아 #ruby("자|기","自|己")도 모르게 큰 #ruby("죄","罪")를 #ruby("범","犯")할 뻔하였다며, 그#ruby("간","間")의 #ruby("사|연","事|緣")을 #ruby("설|명","說|明")하고 #ruby("황|가","黃|哥")를 #ruby("극|형","極|刑")에 #ruby("처","處")할 것을 #ruby("주|장","主|張")하였다. 그러나 그때는 이미 #ruby("황","黃")의 #ruby("사|형","死|刑")이 #ruby("집|행","執|行")되었고, #ruby("나|군","羅|君") #ruby("등","等")의 #ruby("행|위","行|爲")를 #ruby("조|사","調|査")#ruby("중","中")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한번은 #ruby("박|모","朴|某")라는 우리 #ruby("청|년","靑|年")이 #ruby("경|무|국|장","警|務|局|長") #ruby("면|회","面|會")를 #ruby("청","請")하기에 만나보았다. 그는 #ruby("초|면","初|面")에 눈물을 흘리며 품속에서 #ruby("권|총","拳|銃") 한 자루와 #ruby("왜","倭")놈이 준 #ruby("수|첩","手|帖") 하나를 내놓으며, “#ruby("본|국","本|國")에서 먹고 살기 #ruby("위","爲")해 며칠 #ruby("전","前") #ruby("상|해","上|海")에 오게 되었다”면서 다음과 같이 #ruby("자|백","自|白")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“첫 #ruby("대|면","對|面")에 #ruby("일|본","日|本") #ruby("영|사|관","領|事|館")이 나의 #ruby("체|격","體|格")이 튼튼한 것을 보더니, #ruby("김|구","金|九")를 #ruby("살|해","殺|害")하고 오면 돈도 많이 주고, #ruby("본|국","本|國") #ruby("가|족","家|族")들에게는 #ruby("국|가","國|家")의 #ruby("토|지","土|地")를 주어 #ruby("경|작","耕|作")하게 해주겠다고 하였습니다. 그러나 #ruby("만|일","萬|一") #ruby("불|응","不|應")하면 ‘후데이센진（不逞鮮人）’#footnote(numbering: _ => [11)])[#h(0.35em)#ruby[후데이센진][不逞鮮人]\(ふていせんじん)이란 #ruby("일|제","日|帝")가 #ruby("독|립|운|동|가","獨|立|運|動|家")들을 #ruby("비|방","誹|謗")하는 말로, ‘#ruby("불|평","不|平")·#ruby("불|만","不|滿")을 품고 제 마음대로 #ruby("행|동","行|動")하는 #ruby("조|선|인","朝|鮮|人")’이란 뜻이다.]으로 #ruby("체|포","逮|捕")하여 #ruby("취|조","取|調")한다고 하기에 #ruby("응|낙","應|諾")하였습니다. #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地")에서 #ruby("독|립","獨|立")을 #ruby("위","爲")하여 애쓰시는 #ruby("선|생","先|生")을 보고서, 나도 #ruby("한|인","韓|人")의 한 사람으로 어찌 #ruby("감","敢")히 #ruby("살|해","殺|害")할 마음을 품을 수 있겠습니까? 이런 까닭으로 #ruby("권|총","拳|銃")과 #ruby("수|첩","手|帖")을 #ruby("선|생","先|生")께 바치고, #ruby("중|국|지|역","中|國|地|域")으로 가 #ruby("상|업","商|業")에나 #ruby("종|사","從|事")하고자 합니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 말을 듣고 나는 #ruby("감|사","感|謝")의 뜻을 #ruby("표|시","表|示")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("신|조","信|條")는 “일을 맡기면 #ruby("의|심","疑|心")하지 않고, #ruby("의|심","疑|心")하면 일을 맡기지 않는다”는 것이다. 이러한 #ruby("신|조","信|條")로 #ruby("인","因")하여 #ruby("종|종","種|種") #ruby("해","害")를 #ruby("당","當")하면서도 #ruby("천|성","天|性")이라 #ruby("평|생","平|生") 고치지 못하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("경|호|원","警|護|員") #ruby("한|태|규","韓|泰|奎")는 #ruby("평|양","平|壤")사람인데, 사람됨이 부지런하고 #ruby("착|실","着|實")하여 7〜8#ruby("년","年") 써 오는 사이에 안팎 사람들의 #ruby("신|망","信|望")이 #ruby("심","甚")히 두터웠다. 그는 내가 #ruby("경|무|국|장","警|務|局|長")을 그만둔 #ruby("후","後")에도 #ruby("경|무|국","警|務|局") #ruby("사|무","事|務")를 보고 있었다. 그러던 어느날 #ruby("계|원","桂|園") #ruby("노|백|린","盧|伯|麟") #ruby("형","兄")이 아침 일찍 나의 집을 #ruby("방|문","訪|問")하여 말하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“뒷#ruby("도|로|변","道|路|邊")에 어떤 젊은 #ruby("여|자","女|子") #ruby("시|체","屍|體")가 하나 있는데 #ruby("중|국|인","中|國|人")들이 #ruby("한|인","韓|人")이라고 떠드니 #ruby("백|범","白|凡"), 같이 나가서 알아봅시다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("계|원","桂|園")과 같이 나가서 보니 #ruby("명|주","明|珠")의 #ruby("시|체","屍|體")였다. #ruby("명|주","明|珠")는 #ruby("하|층|여|자","下|層|女|子")로 어찌하여 왔든지 #ruby("상|해","上|海")에 와서 #ruby("정|인|과","鄭|仁|果")·#ruby("황|진|남","黃|鎭|南") #ruby("등","等")의 #ruby("식|모","炊|母")로도 일했고, 젊은 #ruby("남|자","男|子")들과의 #ruby("추|잡","醜|雜")한 #ruby("행|동","行|動")도 있다던 #ruby("여|자","女|子")였다. 어느날 한밤#ruby("중","中")에 #ruby("한|태|규","韓|泰|奎")와 같이 다니는 것을 보고, 나는 #ruby("무|심","無|心")히 “#ruby("한|군","韓|君")도 #ruby("청|년","靑|年")이니 서로 #ruby("친","親")한 #ruby("관|계","關|係")가 있나 보다”라고 #ruby("생|각","生|覺")한 것이 그다지 멀지 않은 때로 #ruby("기|억","記|憶")된다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("시|신","屍|身")을 #ruby("자|세","仔|細")히 살펴보니 #ruby("피|살","被|殺")된 것이 #ruby("분|명","分|明")하였다. #ruby("타|박","打|撲")으로 머리 위에 피묻은 #ruby("흔|적","痕|跡")이 있고, #ruby("복","腹") #ruby("부|분","部|分")에 노끈으로 조른 자국이 있었다. 그런데 #ruby("교|살","絞|殺")한 #ruby("수|법","手|法")이, 내가 #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 #ruby("김|진|사","金|進|士")로부터 #ruby("활|빈|당","活|貧|黨")에서 #ruby("사|형","死|刑")하는 #ruby("방|법","方|法")을 배워 #ruby("경|호|원","警|護|員")들에게 #ruby("연|습","練|習")시켜 #ruby("정|탐","偵|探")꾼 #ruby("처|형","處|刑")에 #ruby("응|용","應|用")하던 #ruby("수|법","手|法")과 #ruby("흡|사","恰|似")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("불|란|서","佛|蘭|西") #ruby("공|무|국","工|務|局")에 달려가서 #ruby("서|대|납","西|大|納")을 #ruby("고|발","告|發")하고 #ruby("합|동|조|사","合|同|調|査")에 #ruby("착|수","着|手")하였다. #ruby("한|태|규","韓|泰|奎")가 #ruby("명|주","明|珠")와 밤#ruby("중","中")에 #ruby("출|입","出|入")하던 집에 어떠한 #ruby("남|녀","男|女")가 #ruby("세","貰")들어 산 일이 있는가를 #ruby("조|사","調|査")하여, 1#ruby("개|월","個|月") #ruby("전","前")에 #ruby("한","韓")과 #ruby("명|주","明|珠")가 #ruby("동|거","同|居")한 #ruby("사|실","事|實")을 알아냈다. 그러나 그 집은 #ruby("명|주","明|珠")의 #ruby("시|체","屍|體")가 있는 곳과 #ruby("거|리","距|離")가 너무 멀었다. 그래서 #ruby("시|체","屍|體")가 놓여 있는 #ruby("근|처","近|處") 셋#ruby("방","房") #ruby("명|부","名|簿")를 #ruby("조|사","調|査")하니 10#ruby("여","餘") #ruby("일","日") #ruby("전","前") #ruby("방","房") 하나를 #ruby("한|씨","韓|氏") #ruby("성","姓")에게 빌려준 자취가 있었다. #ruby("방|문","房|門")을 열고 #ruby("자|세","仔|細")히 살펴보니 마루 위에 핏자국이 남아 있었다. 이로 #ruby("인","因")해 #ruby("한","韓")에게 #ruby("혐|의","嫌|疑")가 #ruby("집|중","集|中")되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|대|납","西|大|納")에게 #ruby("한|태|규","韓|泰|奎") #ruby("체|포","逮|捕")를 #ruby("상|의","相|議")하고, #ruby("한|태|규","韓|泰|奎")를 불러서 요즘은 어디서 #ruby("숙|식","宿|食")을 하는지를 물었다. 그는 #ruby("방","房")을 얻지 못하여 이리저리 다니며 #ruby("숙|식","宿|食")한다고 #ruby("답|변","答|辯")하였다. 바로 그때 #ruby("불|란|서","佛|蘭|西") #ruby("경|찰","警|察")이 들어와 #ruby("한","韓")을 #ruby("체|포","逮|捕")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("배|심|관","陪|審|官")으로 #ruby("심|문","訊|問")했다. 내가 #ruby("경|무|국|장","警|務|局|長")을 그만둔 뒤, #ruby("한","韓")은 여러 가지 #ruby("사|정","事|情")으로 #ruby("왜","倭")놈에게 #ruby("매|수","買|收")되어 #ruby("밀|탐","密|探")하며 #ruby("명|주","明|珠")와 #ruby("비|밀","祕|密")리에 #ruby("동|거","同|居")하던 #ruby("중","中"), #ruby("명|주","明|珠")에게 #ruby("왜","倭")놈의 #ruby("주|구","走|狗")란 #ruby("사|실","事|實")이 알려지게 되었다. #ruby("명|주","明|珠")는 비록 배우지 못해 아무것도 알지 못하는 #ruby("하|류|여|자","下|流|女|子")이지만, #ruby("애|국|심","愛|國|心")은 #ruby("강","强")하고 나를 #ruby("절|대|적","絶|對|的")으로 믿고 #ruby("존|경","尊|敬")하였다. #ruby("한","韓")은 “#ruby("명|주","明|珠")가 반드시 #ruby("고|발","告|發")할 #ruby("형|세","形|勢")이므로 #ruby("흔|적","痕|跡")을 없애기 #ruby("위","爲")하여 #ruby("암|살","暗|殺")하였다”고 #ruby("자|백","自|白")하였다.#footnote(numbering: _ => [12)])[#h(0.35em)#ruby("한|태|규","韓|泰|奎")에 #ruby("관","關")한 #ruby("심|문","訊|問")은 3#ruby("주|일","週|日") #ruby("이|상","以|上") #ruby("계|속","繼|續")되었다. 처음에 그는 #ruby("명|주","明|珠")를 #ruby("전","全")혀 모르는 #ruby("여|자","女|子")라고 #ruby("주|장","主|張")하면서 #ruby("범|행","犯|行")을 #ruby("부|인","否|認")하였다. #ruby("증|거","證|據")를 #ruby("제|시","提|示")하자 그는 #ruby("명|주","明|珠")가 그를 #ruby("독|살","毒|殺")하려 했기 때문에 죽였다고 #ruby("주|장","主|張")하였다. #ruby("심|문","訊|問") #ruby("결|과","結|果") #ruby("한|태|규","韓|泰|奎")는 #ruby("일|본","日|本")의 #ruby("비|밀","祕|密") #ruby("첩|자","諜|者")로 #ruby("한|국|국|민|대|표|회|의","韓|國|國|民|代|表|會|議")에 #ruby("관","關")한 #ruby("정|보","情|報")를 #ruby("제|공","提|供")하였다는 것이 밝혀졌다.] 이에 #ruby("한","韓")을 #ruby("종|신|징|역","終|身|懲|役")으로 #ruby("처|벌","處|罰")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 #ruby("사|건","事|件")을 같이 #ruby("조|사","調|査")한 #ruby("나|우","羅|愚") #ruby("등","等")은 나에게 이런 말을 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리는 #ruby("한","韓")이 돈을 물쓰듯하며 #ruby("괴|상","怪|常")한 #ruby("행|동","行|動")을 하는 것을 보고, #ruby("십|중|팔|구","十|中|八|九") #ruby("정|탐","偵|探")꾼이라고 #ruby("추|측","推|測")한 지 이미 오래였습니다. 그러나 #ruby("확|실","確|實")한 #ruby("증|거","證|據")를 얻지 못해 #ruby("선|생","先|生")께 #ruby("보|고","報|告")하지 못했습니다. #ruby("의|심","疑|心")만으로 #ruby("보|고","報|告")하였다가, 도리어 #ruby("동|지","同|志")를 #ruby("의|심","疑|心")한다는 #ruby("책|망","責|望")이나 들을 것 같아 입을 다물고 있었습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後") #ruby("한|태|규","韓|泰|奎")는 #ruby("감|옥","監|獄") #ruby("중|죄|수","重|罪|囚")들과 같이 #ruby("탈|옥","脫|獄")을 #ruby("모|의","謀|議")하여 #ruby("양|력","陽|曆") 1#ruby("월","月") 1#ruby("일","日") 이른 아침에 #ruby("거|사","擧|事")하기로 하였다. 그러나 #ruby("한","韓")은 그 #ruby("사|실","事|實")을 #ruby("불|란|서","佛|蘭|西") #ruby("간|수","看|守")들에게 #ruby("밀|고","密|告")하였다. #ruby("약|속","約|束")된 #ruby("시|간","時|間")에 #ruby("각","各") #ruby("감|방","監|房") #ruby("문","門")이 #ruby("일|제","一|齊")히 열리며 칼·몽둥이·돌을 가진 #ruby("죄|수","罪|囚")들이 쏟아져 나오자, #ruby("총","銃")을 메고 #ruby("경|비","警|備")#ruby("중","中")인 #ruby("간|수","看|守")들이 나오는 #ruby("죄|수","罪|囚")들을 쏘아 #ruby("죄|수","罪|囚") 8#ruby("명","名")이 #ruby("즉|사","卽|死")하였다. 이를 본 다른 #ruby("죄|수","罪|囚")들은 #ruby("감","敢")히 움직일 엄두도 못 내어 #ruby("옥|중","獄|中") #ruby("소|동","騷|動")은 #ruby("진|정","鎭|定")되었다. #ruby("한|태|규","韓|泰|奎")는 #ruby("재|판|정","裁|判|庭")에 여덟 #ruby("명","名")의 #ruby("시|체","屍|體")를 담은 #ruby("관","棺")머리에 서서 #ruby("증|인","證|人")으로 #ruby("출|정","出|廷")했다는 말을 들었다. 그런 #ruby("악|한","惡|漢")을 #ruby("절|대","絶|對") #ruby("신|임","信|任")하였던 나야말로 #ruby("세|상","世|上")에 머리 들기 어렵다는 #ruby("자|괴|감","自|愧|感")으로 지냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그로부터 얼마 #ruby("후","後") #ruby("한|태|규","韓|泰|奎")의 #ruby("서|신","書|信")이 날아들었다. #ruby("불|란|서","佛|蘭|西") #ruby("감|옥|관","監|獄|官")으로부터 같이 #ruby("고|생","苦|生")한 #ruby("감|옥","監|獄") #ruby("친|구","親|舊")를 8#ruby("명","名")이나 죽인 #ruby("공|로","功|勞")를 #ruby("인|정","認|定")받아 #ruby("특|전","特|典")으로 풀려났으니, #ruby("전|죄","前|罪")를 #ruby("용|서","容|恕")하고 다시 써 달라는 #ruby("내|용","內|容")이었다. 그러나 나의 #ruby("회|답","回|答")이 없음을 보고 #ruby("겁","怯")이 났던지 그는 #ruby("구|국","救|國")했다고 하며, 그#ruby("후","後") #ruby("평|양","平|壤")에서 #ruby("소|매|상","小|賣|商")으로 돌아다니더라는 #ruby("소|문","所|聞")을 들었다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[3) #ruby("사|상","思|想") #ruby("갈|등","葛|藤")과 #ruby("국|민|대|표|대|회","國|民|代|表|大|會")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|미|년","己|未|年") #ruby("즉","卽") #ruby("대|한|민|국","大|韓|民|國") #ruby("원|년","元|年")\(1919)에는 #ruby("국|내|외","國|內|外")가 #ruby("일|치","一|致")하여 #ruby("민|족|운|동","民|族|運|動")에 #ruby("매|진","邁|進")하였다. 그러나 #ruby("세|계","世|界") #ruby("사|조","思|潮")가 #ruby("점|차","漸|次") #ruby("봉|건","封|建")이니 #ruby("사|회|주|의","社|會|主|義")니 #ruby("복|잡","複|雜")해지면서, #ruby("단|순","單|純")하던 우리 #ruby("운|동|계","運|動|界")에도 #ruby("사|상","思|想")이 갈라지고, #ruby("음|양","陰|陽")으로 #ruby("투|쟁","鬪|爭")이 #ruby("전|개","展|開")되었다. #ruby("임|시|정|부","臨|時|政|府") #ruby("직|원","職|員") #ruby("중","中")에서도 #ruby("공|산|주|의","共|産|主|義")니 #ruby("민|족|주|의","民|族|主|義")니#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("원|주","原|註"): “民族主義는 世界가 規定하는 自己 民族만 强化하여 他民族을 壓迫하는 主義가 아니고, 우리 韓國 民族도 獨立 自由하야 다른 民族과 가튼 完全 幸福을 享有하자 함.” 이것은 #ruby("백|범","白|凡") 스스로 #ruby("민|족|주|의|관","民|族|主|義|觀")을 #ruby("요|약","要|約")한 것이다.] 하는 #ruby("분|파|적","分|派|的") #ruby("충|돌","衝|突")이 #ruby("격|렬","激|烈")해졌다. #ruby("심|지|어","甚|之|於") #ruby("정|부","政|府")의 #ruby("국|무|원","國|務|員") #ruby("중","中")에도 #ruby("대|통|령","大|統|領")과 #ruby("각","各") #ruby("부","部") #ruby("총|장","總|長")들 #ruby("간","間")에 #ruby("민|주|주|의","民|主|主|義")냐 #ruby("공|산|주|의","共|産|主|義")냐로 #ruby("각|기","各|其") 옳다는 #ruby("주|장","主|張")을 좇아 갈라졌다. 그 #ruby("대|강","大|綱")을 #ruby("거|론","擧|論")하면 #ruby("국|무|총|리","國|務|總|理") #ruby("이|동|휘","李|東|輝")는 #ruby("공|산|혁|명","共|産|革|命")을 부르짖고, #ruby("대|통|령","大|統|領") #ruby("이|승|만","李|承|晩")은 #ruby("민|주|주|의","民|主|主|義")를 #ruby("주|창","主|唱")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이로 #ruby("인","因")해 #ruby("국|무|회|의","國|務|會|議") #ruby("석|상","席|上")에서도 #ruby("의|견","意|見") #ruby("불|일|치","不|一|致")로 때때로 #ruby("논|쟁","論|爭")이 일어나 #ruby("국|시","國|是")가 서지 못하고, #ruby("정|부","政|府") #ruby("내|부","內|部")에 #ruby("괴|이","怪|異")한 #ruby("현|상","現|象")이 거듭 일어났다. #ruby("예","例")를 들면, #ruby("국|무|회|의","國|務|會|議")에서 #ruby("여|운|형","呂|運|亨")·#ruby("안|공|근","安|恭|根")·#ruby("한|형|권","韓|亨|權") 3#ruby("인","人")을 뽑아 #ruby("러|시|아","俄|西|亞")에 #ruby("대|표","代|表")로 보내기로 #ruby("결|정","決|定")하고 #ruby("여|비","旅|費")를 #ruby("각|출","各|出")하던 #ruby("중","中"), #ruby("금|전","金|錢")이 #ruby("입|수","入|手")됨을 보고 #ruby("이|동|휘","李|東|輝")가 #ruby("자|기","自|己") #ruby("심|복","心|腹")인 #ruby("한|형|권","韓|亨|權")을 #ruby("비|밀","祕|密")리에 먼저 #ruby("파|견","派|遣")하였던 일이 있었다. #ruby("이|동","移|動")하는 #ruby("한","韓")이 #ruby("시|베|리|아","西|伯|利|亞")를 #ruby("통|과","通|過")하고 난 뒤에야 이를 #ruby("공|개","公|開")하였으니, #ruby("정|부","政|府")나 #ruby("사|회","社|會")에 #ruby("물|의","物|議")가 #ruby("분|분","紛|紛")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|동|휘","李|東|輝")는 #ruby("호","號")가 #ruby("성|재","誠|齋")인데 #ruby[블라디보스토크][海蔘威]에서 이름을 바꾸어 ‘#ruby("대|자|유","大|自|由")’라 #ruby("행|세","行|世")하던 일도 있었다고 한다. 어느날 #ruby("이|총|리","李|總|理")가 나에게 #ruby("공|원","公|園") #ruby("산|보","散|步")를 #ruby("청","請")하기에 #ruby("동|반","同|伴")하였더니, #ruby("조|용","從|容")히 #ruby("자|기","自|己")를 도와 달라고 말하였다. 나는 좀 #ruby("불|쾌","不|快")한 #ruby("생|각","生|覺")이 들어서,]
