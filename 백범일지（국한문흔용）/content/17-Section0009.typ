#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한번은 #ruby("황|포","黃|浦") #ruby("선|창","船|艙")에서 #ruby("오|성|륜","吳|成|倫")#footnote(numbering: _ => [4)])[#h(0.35em)#ruby("오|성|륜","吳|成|倫")\(1900〜1947). #ruby("당|시","當|時") #ruby("의|열|단|원","義|烈|團|員")인 #ruby("오|성|륜","吳|成|倫")은 #ruby("다나카","田中") #ruby("암|살|미|수","暗|殺|未|遂") #ruby("사|건","事|件")으로 #ruby("체|포","逮|捕")되었으나 #ruby("유|치|장","留|置|場")을 #ruby("탈|출","脫|出")하여 #ruby("독|일","獨|逸")로 #ruby("망|명","亡|命")하였다. 그#ruby("후","後") 그는 모스크바 #ruby("공|산|대|학","共|産|大|學")을 #ruby("수|학","修|學")하고 #ruby("중|국","中|國")의 #ruby("광|동|봉|기","廣|東|蜂|起")에 #ruby("참|여","參|與")하였고, 1936#ruby("년","年") #ruby("동|만","東|滿")#ruby("특|위","特|委") #ruby("위|원","委|員") #ruby("겸","兼") #ruby("동|북|항|일|연|군","東|北|抗|日|聯|軍") #ruby("제|2|군","第|二|軍") #ruby("정|치|부","政|治|部") #ruby("주|임","主|任")에 #ruby("취|임","就|任"), #ruby("조|국|광|복|회","祖|國|光|復|會") #ruby("결|성","結|成")에 #ruby("참|여","參|與")하였다. 그는 1941#ruby("년","年") #ruby("일|본","日|本") #ruby("관|병","官|兵")에 #ruby("체|포","逮|捕")된 #ruby("후","後") #ruby("변|절","變|節")하였다.] #ruby("등","等")이 #ruby("왜|구","倭|寇") #ruby("다나카","田中") #ruby("기이치","義一")에게 #ruby("폭|탄","爆|彈")을 던졌으나 #ruby("폭|발","爆|發")하지 않아, #ruby("오|성|륜","吳|成|倫")이 다시 #ruby("권|총","拳|銃")을 #ruby("발|사","發|射")하여 #ruby("미|국","美|國") #ruby("여|행|객","旅|行|客") #ruby("여|자","女|子") 하나가 죽은 #ruby("사|건","事|件")이 일어났다.#footnote(numbering: _ => [5)])[#h(0.35em)#ruby("오|성|륜","吳|成|倫")으로부터 #ruby("사|건","事|件")의 #ruby("내|막","內|幕")을 #ruby("직|접","直|接") #ruby("전","傳")해들은 #ruby("김|산","金|山")의 『아리랑』에 #ruby("의","依")하면, #ruby("다나카","田中") 바로 앞에 서 있던 #ruby("미|국","美|國") #ruby("여|인","女|人")이 #ruby("폭|발","爆|發")소리에 놀라 #ruby("다나카","田中")를 껴안는 바람에 #ruby("오|성|륜","吳|成|倫")이 쏜 3#ruby("발","發")의 #ruby("총","銃")알은 그 #ruby("여|인","女|人")에게 #ruby("명|중","命|中")하였고, 이로 #ruby("인","因")해서 #ruby("다나카","田中") #ruby("암|살","暗|殺")은 #ruby("실|패","失|敗")하였다.] 이 #ruby("사|건","事|件") #ruby("후","後") #ruby("일","日")·#ruby("영","英")·#ruby("불","佛") 세나라 #ruby("합|작","合|作")으로 #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地")의 #ruby("한|인","韓|人")을 #ruby("대|거","大|擧") #ruby("수|색","搜|索")·#ruby("체|포","逮|捕")한 일이 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時")는 어머님까지 #ruby("상|해","上|海")에 와 계시던 때인데, 하루는 이른 아침에 #ruby("왜|경","倭|警") 7#ruby("명","名")이 #ruby("노|기|등|등","怒|氣|騰|騰")하여 #ruby("침|실","寢|室")에 #ruby("침|입","侵|入")하였다. 그#ruby("중","中") #ruby("불|란|서","佛|蘭|西") #ruby("경|관","警|官")이 #ruby("서|대|납","西|大|納")은 나와 #ruby("친","親")한 사이로, 내 집인 줄 알았으면 잡으러 오지 않았을 것이다. 그러나 #ruby("왜","倭")말과 #ruby("불|어","佛|語")가 서로 달라, #ruby("체|포|장","逮|捕|狀")에 #ruby("기|재","記|載")된 이름#ruby("자","字")가 #ruby("김|구","金|九")인지 모르고 #ruby("한|인","韓|人") #ruby("강|도","强|盜")로 알고 #ruby("체|포","逮|捕")하러 왔던 것이다. 그런데 와서 보니 잘 아는 #ruby("친|구","親|舊")가 아닌가. #ruby("왜","倭")놈들이 달려들어 #ruby("철|수|갑","鐵|手|匣")을 채우려 할 때, #ruby("서|대|납","西|大|納")이 #ruby("제|지","制|止")하며 나에게 “옷은 입고 #ruby("불|란|서","佛|蘭|西") #ruby("경|무|국","警|務|局")으로 가자”는 뜻을 밝혔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 말에 따라 #ruby("숭|산|로","崇|山|路")의 #ruby("경|찰|서","警|察|署")로 가 보니, #ruby("원|세|훈","元|世|勳") #ruby("등","等") 5#ruby("명","名")을 먼저 잡아 #ruby("유|치|장","留|置|場")에 #ruby("구|금","拘|禁")해 놓았다. 내가 #ruby("유|치|장","留|置|場")에 들어간 #ruby("후","後") #ruby("왜|경","倭|警")이 와서 #ruby("신|문","訊|問")하려 하자 #ruby("불|란|서","佛|蘭|西") 사람은 #ruby("허|락","許|諾")하지 않았다. 또한 #ruby("일|본","日|本") #ruby("영|사","領|事")가 #ruby("인|도","引|渡")를 #ruby("요|구","要|求")해도 듣지 않고 나에게 묻기를,]
