#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("정|부","政|府")의 #ruby("공|금|횡|령|범","公|金|橫|領|犯") #ruby("김|립","金|立")은 #ruby("오|면|직","吳|冕|稙")·#ruby("노|종|균","盧|鍾|均")#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("오|면|직","吳|冕|稙")\(1894〜1938), #ruby("노|종|균","盧|鍾|均")\(1894〜1939). 모두 #ruby("황|해|도","黃|海|道") #ruby("안|악","安|岳") #ruby("출|신","出|身")의 #ruby("동|갑","同|甲") #ruby("동|지","同|志"). #ruby("국|내","國|內")에서 3·1#ruby("운|동","運|動")과 『#ruby("조|선|일|보","朝|鮮|日|報")』·『#ruby("동|아|일|보","東|亞|日|報")』 #ruby("안|악|지|국","安|岳|支|局")에서 #ruby("활|동","活|動")하였고, 1921#ruby("년","年") #ruby("임|시|정|부","臨|時|政|府")의 #ruby("군|자|금","軍|資|金") #ruby("모|집|건","募|集|件")이 #ruby("발|각","發|覺")되어 #ruby("상|해","上|海")로 #ruby("망|명","亡|命")하였다. 1922#ruby("년","年") #ruby("김|구","金|九")의 #ruby("지|시","指|示")에 따라 모스크바 #ruby("자|금","資|金")을 #ruby("도|용","盜|用")한 #ruby("김|립","金|立")을 #ruby("사|살","射|殺")하였고, 그#ruby("후","後") #ruby("김|구","金|九")의 #ruby("측|근","側|近")으로 #ruby("한|국|노|병|회","韓|國|勞|兵|會")·#ruby("한|인|애|국|단","韓|人|愛|國|團")·#ruby("한|국|독|립|군|특|무|대","韓|國|獨|立|軍|特|務|隊") #ruby("등","等")에서 #ruby("활|동","活|動")하였다. 이들은 1935#ruby("년","年") #ruby("맹|혈|단","猛|血|團")을 #ruby("조|직","組|織")하고 #ruby("군|자|금","軍|資|金") #ruby("모|집","募|集"), #ruby("밀|정","密|偵") #ruby("처|단","處|斷") #ruby("등","等")의 #ruby("활|동","活|動")을 #ruby("계|속","繼|續")하였다. #ruby("오|면|직","吳|冕|稙")은 1936#ruby("년","年") #ruby("일|본","日|本") #ruby("영|사|관","領|事|館") #ruby("습|격","襲|擊")을 #ruby("계|획","計|劃")하다 #ruby("체|포","逮|捕")되어 1938#ruby("년","年") #ruby("평|양|형|무|소","平|壤|刑|務|所")에서 #ruby("사|형","死|刑")되었고, #ruby("노|종|균","盧|鍾|均")은 1938#ruby("년","年") #ruby("체|포","逮|捕")되어 이듬해 #ruby("해|주","海|州") #ruby("옥|중","獄|中")에서 #ruby("미|결|수","未|決|囚")로 #ruby("순|국","殉|國")하였다.] #ruby("등","等") #ruby("청|년","靑|年")들에게 #ruby("총|살","銃|殺")을 #ruby("당","當")하니 사람들이 #ruby("통|쾌","痛|快")하게 #ruby("생|각","生|覺")하였다. #ruby("임|시|정|부","臨|時|政|府")에서는 #ruby("한|형|권","韓|亨|權")을 #ruby("러|시|아","俄|西|亞") #ruby("대|표|직","代|表|職")에서 #ruby("파|면","罷|免")하고 #ruby("안|공|근","安|恭|根")을 #ruby("러|시|아","俄|西|亞") #ruby("주|재","駐|在") #ruby("대|표","代|表")로 #ruby("파|송"