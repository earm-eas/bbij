#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 그 말을 믿고 아무런 #ruby("의|심","疑|心")을 품지 않았다. 그랬는데 1#ruby("개|월","個|月")이 거의 가까워서야 #ruby("엄|항|섭","嚴|恒|燮") #ruby("군","君")에게서 #ruby("입|원","入|院")한 #ruby("진|상","眞|相")을 #ruby("상|세","詳|細")히 #ruby("보|고","報|告")받았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 #ruby("남|목|청","楠|木|廳")에서 #ruby("연|회","宴|飮")가 #ruby("시|작","始|作")될 때, #ruby("조|선|혁|명|당|원","朝|鮮|革|命|黨|員")으로 #ruby("남|경","南|京")에서부터 #ruby("상|해","上|海")로 #ruby("특|무|공|작","特|務|工|作")을 가고 싶다 하여 내가 #ruby("금|전","金|錢") #ruby("보|조","補|助")도 해준 적이 있는 #ruby("이|운|환","李|雲|煥")#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("원|문","原|文"): “李雲漢”. ‘李雲漢’은 ‘李雲煥’의 #ruby("착|오","錯|誤"). #ruby("안|병|무","安|炳|武")는 #ruby("이|운|환","李|雲|煥")이 스파이라기보다는 #ruby("불|평|분|자","不|平|分|子")라고 #ruby("회|고","回|顧")하였다. #ruby("평|소","平|素") #ruby("이|운|환","李|雲|煥")은 #ruby("임|정","臨|政") 어른들이 #ruby("자|기|편","自|己|便") #ruby("견|해","見|解")를 #ruby("고|수","固|守")하여 일에 #ruby("별","別") #ruby("진|전","進|展")이 없었고 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨") #ruby("청|년","靑|年")들에게 주는 #ruby("생|활|비","生|活|費")가 적어 #ruby("불|평","不|平")이 많았다고 한다.]이 #ruby("돌|입","突|入")하여 #ruby("권|총","短|銃")을 #ruby("난|사","亂|射")하였다. #ruby("제|1|발","第|一|發")에 내가 맞고, #ruby("제|2|발","第|二|發")에 #ruby("현|익|철","玄|益|哲")이 #ruby("중|상","重|傷"), #ruby("제|3|발","第|三|發")에 #ruby("유|동|열","柳|東|說")이 #ruby("중|상","重|傷"), #ruby("제|4|발","第|四|發")에 #ruby("이|청|천","李|靑|天")이 #ruby("경|상","輕|傷")을 입었다. #ruby("현|익|철","玄|益|哲")은 #ruby("의|원","醫|院")에 #ruby("도|착","到|着")하자마자 #ruby("절|명","絶|命")하였고, 나와 #ruby("유|동|열","柳|東|說")은 #ruby("입|원","入|院") #ruby("치|료","治|療")하고 #ruby("상|태","狀|態")가 #ruby("호|전","好|轉")되어 #ruby("동|시","同|時")에 #ruby("퇴|원","退|院")하게 되었다 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("범|인","犯|人")은 #ruby("성","省") #ruby("정|부","政|府")의 #ruby("긴|급","緊|急") #ruby("명|령","命|令")으로 #ruby("체|포","逮|捕")·#ruby("구|속","拘|束")되고, #ruby("혐|의|범","嫌|疑|犯")으로 #ruby("박|창|세","朴|昌|世")·#ruby("강|창|제","姜|昌|濟")·#ruby("송|욱|동","宋|郁|東")·#ruby("한|성|도","韓|成|道") #ruby("등","等")도 #ruby("수|감","收|監")되었다고 하였다. #ruby("일|대","一|大") #ruby("의|혹","疑|惑")은 #ruby("강|창|제","姜|昌|濟")·#ruby("박|창|세","朴|昌|世") 두 사람에게 #ruby("집|중","集|中")되었다. #ruby("강","姜")·#ruby("박","朴") 두 사람은 #ruby("종|전","從|前") #ruby("상|해","上|海")에서 #ruby("이|유|필","李|裕|弼")의 #ruby("지|휘","指|揮")로 #ruby("병|인|의|용|대","丙|寅|義|勇|隊")#footnote(numbering: _ => [23)])[#h(0.35em)1925#ruby("년","年") #ruby("말","末") #ruby("상|해","上|海")에서 #ruby("나|창|헌","羅|昌|憲")·#ruby("이|유|필","李|裕|弼")·#ruby("박|창|세","朴|昌|世") #ruby("등","等")이 #ruby("주|도","主|導")하여 #ruby("조|직","組|織")한 #ruby("민|족|주|의|계","民|族|主|義|系") #ruby("비|밀|독|립|운|동|단|체","祕|密|獨|立|運|動|團|體"). #ruby("상|해","上|海") #ruby("임|시|정|부","臨|時|政|府")의 #ruby("권|위","權|威")와 #ruby("정|신","精|神")을 #ruby("옹|호","擁|護")·#ruby("선|양","宣|揚")하며, #ruby("일|제","日|帝")와 그 #ruby("밀|정","密|偵")을 #ruby("주|살","誅|殺")하는 것을 #ruby("목|적","目|的")으로 #ruby("결|성","結|成")되었지만, #ruby("일|제","日|帝")의 #ruby("탄|압","彈|壓") #ruby("등","等")으로 #ruby("별","別")다른 #ruby("성|과","成|果")가 없었다.]라는 #ruby("특|무|공|작","特|務|工|作") #ruby("기|관","機|關")을 #ruby("설|립","設|立")한 #ruby("일|종","一|種")의 #ruby("혁|명|난|류","革|命|亂|類")#footnote(numbering: _ => [24)])[#h(0.35em)#ruby("혁|명|난|류","革|命|亂|類")는 #ruby("불|평","不|平")·#ruby("불|만","不|滿")으로 #ruby("혁|명","革|命")의 #ruby("본|진","本|陣")에서 떨어져 나와 함부로 #ruby("행|동","行|動")하는 #ruby("부|류","部|類")를 #ruby("지|칭","指|稱")한다.]로 #ruby("금|전","金|錢")을 #ruby("휴|대","携|帶")한 #ruby("동|포","同|胞")를 #ruby("강|탈","强|奪")하기도 하고, #ruby("일|본","日|本")의 #ruby("정|탐","偵|探")을 #ruby("총|살","銃|殺")도 하며 #ruby("직|접","直|接") 따르기도 한즉, 우리 #ruby("사|회","社|會")에 #ruby("신|용","信|用")은 없으나 #ruby("반|혁|명|자","反|革|命|者")로 #ruby("규|정","規|定")하기는 어려웠다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("수|십","數|十") #ruby("일","日") #ruby("전","前")에 #ruby("강|창|제","姜|昌|濟")가 나에게 #ruby("청","請")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("상|해","上|海")에서 #ruby("박|창|세","朴|昌|世")가 #ruby("장|사","長|沙")로 올 마음이 있으나 #ruby("여|비","旅|費")가 없어 오지를 못한다니 #ruby("여|비","旅|費")를 #ruby("보|조","補|助")해 주시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("상|해|기|관","上|海|機|關")에 #ruby("위|탁","委|託")하여 #ruby("처|리","處|理")하겠다고 하였다. 그 #ruby("이|유","理|由")는 #ruby("박|제|도","朴|濟|道")\(#ruby("창|세","昌|世")의 #ruby("장|자","長|子"))가 #ruby("일|본","日|本") #ruby("영|사|관","領|事|館") #ruby("정|탐","偵|探")이 된 것을 나는 #ruby("자|세","仔|細")히 알고 #ruby("박|창|세","朴|昌|世")가 #ruby("자|기","自|己") 집에 #ruby("안|주","安|住")하는 데 #ruby("특|별","特|別") #ruby("주|의","注|意")함이여섯다.#footnote(numbering: _ => [25)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “그 #ruby("이|유","理|由")는 #ruby("박|창|세","朴|昌|世")의 맏아들 #ruby("박|제|도","朴|濟|道")가 #ruby("일|본","日|本") #ruby("영|사|관","領|事|館")의 #ruby("정|탐","偵|探")이 된 것을 내가 #ruby("자|세","仔|細")히 알고 있었고, #ruby("박|창|세","朴|昌|世")가 그 아들 집에 살고 있는 데에 #ruby("특|별","特|別")히 #ruby("주|목","注|目")하였기 때문이다.”] #ruby("여|비","旅|費")가 없어 오지 못한다던 #ruby("박|창|세","朴|昌|世")가 #ruby("장|사","長|沙")에 와서, 나도 한 #ruby("번","番") 만나보았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("이|운|환","李|雲|煥")은 #ruby("필|시","必|是") #ruby("강","姜")·#ruby("박","朴") #ruby("양|인","兩|人")의 #ruby("악|선|전","惡|宣|傳")에 #ruby("이|용","利|用")된 나머지 #ruby("정|치|적","政|治|的") #ruby("감|정","感|情")에 #ruby("충|동","衝|動")되어 #ruby("남|목|청","楠|木|廳") #ruby("사|건","事|件")의 #ruby("주|범","主|犯")이 된 것이었다. #ruby("경|비|사|령|부","警|備|司|令|部") #ruby("조|사","調|査")로 알 수 있듯이 #ruby("박|창|세","朴|昌|世")가 #ruby("장|사","長|沙")에 #ruby("도|착","到|着")한 #ruby("직|후","直|後") #ruby("상|해","上|海")에서 #ruby("박|창|세","朴|昌|世")에게 200#ruby("원","元")이 #ruby("비|밀|리","祕|密|裡")에 #ruby("지|원","支|援")되었으나, #ruby("이|운|환","李|雲|煥")이 #ruby("수|십","數|十") #ruby("리","里") 떨어진 시골 #ruby("기|차|역","汽|車|驛")까지 걸어와 #ruby("체|포","逮|捕")되었을 때 #ruby("신|변","身|邊")에는 #ruby("단|지","但|只") 18#ruby("전","錢")만 #ruby("소|지","所|持")한 것으로 보나, #ruby("이|운|환","李|雲|煥")이 #ruby("범|행","犯|行") #ruby("후","後") #ruby("유|동|열","柳|東|說")의 #ruby("의|서","義|壻"), #ruby("최|덕|신","崔|德|新")\(#ruby("동|오|지|자","東|旿|之|子"))#footnote(numbering: _ => [26)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("최|덕|신","崔|德|新")”. #ruby("의|서","義|壻")는 #ruby("수|양","收|養")딸의 #ruby("남|편","男|便"). #ruby[최|동|오][崔|東|旿]\(1892〜?)는 #ruby("독|립|운|동|가","獨|立|運|動|家"). 1919#ruby("년","年") 그의 #ruby("고|향","故|鄕") #ruby("평|북","平|北") #ruby("의|주","義|州")에서 3·1#ruby("운|동","運|動")을 #ruby("주|도","主|導")하고 #ruby("만|주","滿|洲")로 #ruby("망|명","亡|命"), #ruby("정|의|부","正|義|府")에 #ruby("참|가","參|加")하였다. 1935#ruby("년","年") #ruby("민|족|혁|명|당","民|族|革|命|黨")을 #ruby("창|당","創|黨")하고, 그#ruby("후","後") #ruby("민|혁|당","民|革|黨")이 #ruby("임|정","臨|政")에 #ruby("참|여","參|與")하자 #ruby("임|정","臨|政")의 #ruby("국|무|위|원","國|務|委|員")과 #ruby("의|정|원","議|政|院") #ruby("의|원","議|員")으로 #ruby("활|동","活|動")했다. #ruby("귀|국","歸|國") #ruby("후","後") 1948#ruby("년","年") #ruby("남|북|연|석|회|의","南|北|聯|席|會|議")에 #ruby("참|여","參|與"), #ruby("월|북","越|北")하였다. 그의 아들 #ruby("최|덕|신","崔|德|新")은 #ruby("천|도|교","天|道|敎") #ruby("교|령","敎|領")을 지낸 #ruby("후","後") #ruby("월|북","越|北")하였다.]에게 #ruby("권|총","短|銃")을 들이대고 10#ruby("원","元")을 #ruby("강|요","强|要")하여 #ruby("장|사","長|沙")에서 #ruby("탈|출","脫|出")한 것을 보아도 #ruby("강","姜")·#ruby("박","朴")의 #ruby("마|수","魔|手")에 #ruby("이|용","利|用")된 것이 #ruby("사|실","事|實")인 것 같다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|쟁","戰|爭")으로 #ruby("장|사","長|沙")도 #ruby("위|급","危|急")한 #ruby("경|우","境|遇")에 #ruby("처","處")하니 #ruby("중|국","中|國") #ruby("법|정","法|庭")에서 #ruby("주|범","主|犯")과 #ruby[종범][首從犯人] 모두 #ruby("법","法")대로 #ruby("죄","罪")를 다스리지 못하고 #ruby("대|부|분","大|部|分") #ruby("석|방","釋|放")하였다. #ruby("이|운|환","李|雲|煥")까지 #ruby("탈|옥","脫|獄")하여 #ruby("귀|주","貴|州") #ruby("방|면","方|面")으로 #ruby("걸|인","乞|人") #ruby("행|색","行|色")으로 오는 것을 #ruby("구|양|군","歐|陽|群")이 만나서 말까지 하였다는 #ruby("보|고","報|告")를, 내가 #ruby("중|경","重|慶")서 들었다.#footnote(numbering: _ => [27)])[#h(0.35em)#ruby("구|양|군","歐|陽|群")은 #ruby("박|기|성","朴|基|成")의 #ruby("중|국|식","中|國|式") 이름. #ruby("박|기|성","朴|基|成")의 #ruby("회|고","回|顧")에 따르면 #ruby("임|무","任|務") #ruby("교|대","交|代")하러 가던 #ruby("중","中"), 성냥이 없어서 길 가는 사람에게 담뱃불을 빌리려고 #ruby("우|연","偶|然")히 #ruby("상|대|방","相|對|方")을 바라보니, 그가 바로 #ruby("이|운|환","李|雲|煥")이었다고 한다. #ruby("박|기|성","朴|基|成")은 그날 밤 #ruby("이|운|환","李|雲|煥")의 먹고 잘 곳을 #ruby("주|선","周|旋")해 주었으나, 다음날 일찍 일어나 보니 #ruby("이|운|환","李|雲|煥")은 어디론가 몰래 떠나버렸다고 한다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("남|목|청","楠|木|廳") #ruby("사|건","事|件")이 일어나자 #ruby("장|사","長|沙")는 #ruby("일|대","一|大") #ruby("소|동","騷|動")이 벌어졌다. #ruby("경|비|사|령|부","警|備|司|令|部")에서는 그때 #ruby("장|사","長|沙")에서 #ruby("출|발","出|發")하여 #ruby("무|창","武|昌")을 향해 #ruby("출|발","出|發")한 #ruby("기|차","汽|車")를 다시 #ruby("장|사","長|沙")까지 #ruby("후|퇴","後|退")시켜 #ruby("범|인","犯|人")을 #ruby("수|색","搜|索")하였고, 우리 #ruby("정|부","政|府")로서는 #ruby("광|동","廣|東")으로 #ruby("공|작|원","工|作|員")을 #ruby("파|견","派|遣")하여 #ruby("중","中")·#ruby("한","韓") #ruby("합|작","合|作")으로 #ruby("범|인","犯|人") #ruby("체|포","逮|捕")에 #ruby("노|력","努|力")하였다. #ruby("성","省") #ruby("주|석","主|席")인 #ruby("장|치|중","張|治|中") #ruby("장|군","將|軍")은 #ruby("상|아|의|원","湘|雅|醫|院")까지 #ruby("친","親")히 #ruby("방|문","訪|問")하여 어떠한 #ruby("방|법","方|法")으로든 나의 #ruby("치|료","治|療") #ruby("비|용","費|用")은 #ruby("성","省") #ruby("정|부","政|府")가 #ruby("책|임","責|任")질 터이라 하였다 한다.]
