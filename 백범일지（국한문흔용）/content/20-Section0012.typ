#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("퇴|원","退|院") #ruby("후","後") #ruby("즉|시","卽|時") 걸어서 어머님을 찾아뵈었다. 어머님께는 #ruby("사|실","事|實")대로 알리지 않고 지내다가, 거의 #ruby("퇴|원","退|院")할 무렵이 되어서야 #ruby("신","信")이가 #ruby("사|실","事|實")을 알려드렸던 것이다. 내가 뵈올 때에도 어머님은 조금도 #ruby("동|요","動|搖")하는 빛이 없이,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“자네의 #ruby("생|명","生|命")은 #ruby("상|제","上|帝")께서 #ruby("보|호","保|護")하시는 줄 아네. #ruby("사|악","邪|惡")한 것이 옳은 것을 #ruby("범","犯")하지 못하지. 하나 #ruby("유|감","遺|憾")스러운 것은 #ruby("이|운|환","李|雲|煥") #ruby[정탐꾼][韓奸]도 #ruby("한|인","韓|人")인즉, #ruby("한|인","韓|人")의 #ruby("총","銃")을 맞고 산 것은 #ruby("일|인","日|人")의 #ruby("총","銃")에 죽은 것보다 못하네.”]
