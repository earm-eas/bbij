#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이제부터는 다시 #ruby("장|사","長|沙")#ruby("생|활","生|活")을 #ruby("대|략","大|略") #ruby("기|록","記|錄")한다. 100#ruby("여","餘") #ruby("명","名")의 #ruby("남|녀|노|유","男|女|老|幼")와 #ruby("청|년","靑|年")을 이끌고 사람과 땅이 #ruby("생|소","生|疏")한 #ruby("호|남|성","湖|南|省") #ruby("장|사","長|沙")에 간 #ruby("이|유","理|由")는, #ruby("단|지","但|只") #ruby("다|수","多|數") #ruby("식|구","食|口")를 가진 #ruby("처|지","處|地")에 이곳이 #ruby("곡|식","穀|食")값이 #ruby("극","極")히 싼 곳인데다, #ruby("장|래","將|來") #ruby("홍|콩","香|港")을 #ruby("통","通")하여 #ruby("해|외","海|外")와 #ruby("통|신","通|信")을 #ruby("계|속","繼|續")할 #ruby("계|획","計|劃") 때문이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("장|사","長|沙")에 #ruby("선|발|대","先|發|隊")를 보내놓고 #ruby("안|심","安|心")하지 못하였으나, 뒤미처 #ruby("장|사","長|沙")에 #ruby("도|착","到|着")하자 #ruby("천|우|신|조","天|佑|神|助")로 #ruby("이|전","以|前")부터 #ruby("친","親")한 #ruby("장|치|중","張|治|中") #ruby("장|군","將|軍")이 #ruby("호|남|성","湖|南|省") #ruby("주|석","主|席")으로 #ruby("취|임","就|任")하여, #ruby("만|사","萬|事")가 #ruby("순|탄","順|坦")하였고 #ruby("신|변","身|邊")도 잘 #ruby("보|호","保|護")받았다. 우리의 #ruby("선|전","宣|傳") #ruby("등","等") #ruby("공|작","工|作")도 #ruby("유|력","有|力")하게 #ruby("진|전","進|展")되었고, #ruby("경|제","經|濟") #ruby("방|면","方|面")으로는 이미 #ruby("남|경","南|京")에서부터 #ruby("중|국","中|國") #ruby("중|앙","中|央")에서 주는 #ruby("매|월","每|月") #ruby("다|소","多|少")의 #ruby("보|조","補|助")와, 그 #ruby("외","外") #ruby("미|국","美|國") #ruby("한|인","韓|人") #ruby("교|포","僑|胞")의 #ruby("원|조","援|助")도 있었다. 또한 #ruby("물|가","物|價")가 싼 탓으로 #ruby("다|수","多|數") #ruby("식|구","食|口")의 #ruby("생|활","生|活")이 #ruby("고|등|난|민","高|等|難|民")의 #ruby("자|격","資|格")을 #ruby("보|유","保|有")케 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("본|국","本|國")을 떠나 #ruby("상|해","上|海")에 #ruby("도|착","到|着")한 #ruby("후","後") 우리 사람을 만나 #ruby("초|면","初|面")에 #ruby("인|사","人|事")할 때 #ruby("외","外")에는 #ruby("본|성|명","本|姓|名")을 내놓고 #ruby("인|사","人|事")를 못하고 #ruby("매|번","每|番") #ruby("변|성|명","變|姓|名") #ruby("생|활","生|活")을 #ruby("계|속","繼|續")하였으나, #ruby("장|사","長|沙")에 #ruby("도|착","到|着")한 #ruby("후","後")로는 #ruby("기|탄","忌|憚")없이 #ruby("김|구","金|九")로 #ruby("행|세","行|世")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("상|해","上|海")·#ruby("항|주","杭|州")·#ruby("남|경","南|京")에서 #ruby("장|사","長|沙")로 옮겨온 #ruby("식|구","食|口")는 #ruby("광|복|진|선","光|復|陣|線") #ruby("원|동","遠|東")#footnote(numbering: _ => [21)])[#h(0.35em)#ruby("원|동","遠|東")은 #ruby("상|해","上|海")를 #ruby("중|심","中|心")으로 한 #ruby("중|국","中|國") #ruby("동|남|방|지|역","東|南|方|地|域")을 말한다.]3#ruby("당","黨")의 #ruby("당|원","黨|員")과 그 #ruby("가|족","家|族"), 그리고 #ruby("임|시|정|부","臨|時|政|府") #ruby("직|원","職|員")들인데, #ruby("종|종","種|種") 3#ruby("당","黨") #ruby("통|일|문|제","統|一|問|題")가 #ruby("제|기","提|起")되었다. 3#ruby("당","黨")의 첫째가 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨")이니, #ruby("중|요","重|要") #ruby("간|부","幹|部")로는 #ruby("이|청|천","李|靑|天")·#ruby("유|동|열","柳|東|說")·#ruby("최|동|오","崔|東|旿")·#ruby("김|학|규","金|學|奎")·#ruby("황|학|수","黃|學|秀")·#ruby("이|복|원","李|復|源")·#ruby("안|일|청","安|一|淸")·#ruby("현|익|철","玄|益|哲") #ruby("등","等")이다. 다음은 #ruby("한|국|독|립|당","韓|國|獨|立|黨")이니, #ruby("간|부","幹|部")로는 #ruby("조|소|앙","趙|素|昻")·#ruby("홍|진","洪|震")·#ruby("조|시|원","趙|時|元") #ruby("등","等")이다. 3#ruby("당","黨")의 마지막은 내가 #ruby("창|립","創|立")한 #ruby("한|국|국|민|당","韓|國|國|民|黨")인데, #ruby("이|동|녕","李|東|寧")·#ruby("이|시|영","李|始|榮")·#ruby("조|완|구","趙|琬|九")·#ruby("차|이|석","車|利|錫")·#ruby("송|병|조","宋|秉|祚")·#ruby("김|붕|준","金|朋|濬")·#ruby("엄|항|섭","嚴|恒|燮")·#ruby("안|공|근","安|恭|根")·#ruby("양|묵","梁|墨")·#ruby("민|병|길","閔|丙|吉")·#ruby("손|일|민","孫|逸|民")·#ruby("조|성|환","趙|成|煥") #ruby("등","等")이 #ruby("간|부","幹|部")였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[3#ruby("당","黨") #ruby("통|일|문|제","統|一|問|題")를 #ruby("협|의","協|議")하기 #ruby("위","爲")하여 5#ruby("월","月") 6#ruby("일","日")에 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨") #ruby("당|부","黨|部")인 #ruby("남|목|청","楠|木|廳")에 모여서 #ruby("연|회","宴|會")를 #ruby("개|최","開|催")키로 하여 나도 #ruby("출|석","出|席")하였다. 그런데 #ruby("정|신","精|神")을 차려 보니 내 집이 아니고 #ruby("병|원","病|院")인 듯한데, 몸이 #ruby("극","極")히 #ruby("불|편","不|便")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 어디를 왔느냐?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 물어보니, #ruby("남|목|청","楠|木|廳")에서 술을 마시다 #ruby("졸|도","卒|倒")하여 #ruby("입|원","入|院")하였다는 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("의|사","醫|師")가 자주 와서 내 가슴을 #ruby("진|찰","診|察")했는데, 가슴에 무슨 #ruby("상|흔","傷|痕")이 있는 듯하여 물어 보았다.]
