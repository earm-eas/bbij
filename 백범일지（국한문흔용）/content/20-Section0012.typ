#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("부|득|이","不|得|已") #ruby("가|흥","嘉|興")의 #ruby("여|자","女|子") 뱃#ruby("사|공","沙|工") #ruby("주|애|보","朱|愛|寶")를 #ruby("매|월","每|月") 15#ruby("원","元")씩 #ruby("본|가","本|家")에 주고 데려와, #ruby("회|청|교","淮|淸|橋")에 #ruby("방","房")을 얻어 #ruby("동|거","同|居")하였다. 나는 #ruby("직|업","職|業")을 #ruby("고|물|상","古|物|商")이라 하고, #ruby("여|전","如|前")히 #ruby("광|동","廣|東") #ruby("해|남|도","海|南|島") 사람으로 #ruby("행|세","行|世")하였다. #ruby("경|찰","警|察")이 #ruby("호|구|조|사","戶|口|調|査")를 와도 #ruby("애|보","愛|寶")가 먼저 #ruby("설|명","說|明")하고, 나는 #ruby("직|접","直|接") 말하는 것을 삼갔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("노|구|교","蘆|溝|橋") #ruby("사|건","事|件")으로 #ruby("중|국","中|國")은 #ruby("일|본","日|本")에 #ruby("대","對")한 #ruby("항|전","抗|戰")을 #ruby("개|시","開|始")하였다.#footnote(numbering: _ => [13)])[#h(0.35em)1937#ruby("년","年") 7#ruby("월","月") 7#ruby("일","日"), #ruby("북|경","北|京") #ruby("교|외","郊|外")의 #ruby("영|정|강","永|定|江")에 있는 다리 #ruby("노|구|교","蘆|溝|橋") #ruby("부|근","附|近")에서 #ruby("훈|련|중","訓|練|中")인 #ruby("일|본","日|本") #ruby("군|대","軍|隊")와 #ruby("중|국","中|國") #ruby("군|대","軍|隊")#ruby("간","間")의 #ruby("충|돌","衝|突")로 #ruby("중|일|전|쟁","中|日|戰|爭")이 일어났다.] #ruby("한|인","韓|人")의 #ruby("인|심","人|心")도 #ruby("불|안","不|安")케 되었는데, 5#ruby("당","黨") #ruby("통|일","統|一")로 된 #ruby("민|족|혁|명|당","民|族|革|命|黨")은 족족 #ruby("분|열","分|裂")되어 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨")이 또 한 #ruby("개","個") 생기고, #ruby("미|주|대|한|인|독|립|단","美|洲|大|韓|人|獨|立|團")은 #ruby("탈|퇴","脫|退")하고, #ruby("의|열|단","義|烈|團") #ruby("분|자","分|子")만이 #ruby("민|족|혁|명|당","民|族|革|命|黨")을 #ruby("지|지","支|持")하게 되었다.#footnote(numbering: _ => [14)])[#h(0.35em)#ruby("민|족|혁|명|당","民|族|革|命|黨")은 #ruby("결|성","結|成")되자마자, 1935#ruby("년","年") 9#ruby("월","月") #ruby("조|소|앙","趙|素|昻") #ruby("계|열","系|列")이 #ruby("탈|퇴","脫|退")하여 #ruby("한|국|독|립|당","韓|國|獨|立|黨")을 #ruby("재|건","再|建")하였고, 1937#ruby("년","年") 5#ruby("월","月")에는 #ruby("이|청|천","李|靑|天") #ruby("계|열","系|列")이 #ruby("탈|퇴","脫|退")하여 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨")을 새로 #ruby("결|성","結|成")하여, #ruby("결|국","結|局") #ruby("김|원|봉","金|元|鳳")의 #ruby("의|열|단","義|烈|團") #ruby("계|열","系|列")만 남게 되었다.] 그같이 #ruby("분|열","分|裂")되는 #ruby("내|용","內|容")은 겉으로는 #ruby("민|족|운|동","民|族|運|動")을 #ruby("표|방","標|榜")하고 #ruby("이|면","裏|面")으로는 #ruby("공|산|주|의","共|産|主|義")를 #ruby("실|행","實|行")한다는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("시|국","時|局")은 #ruby("점|점","漸|漸") #ruby("급|박","急|迫")해져 우리 #ruby("한|국|국|민|당","韓|國|國|民|黨")과 #ruby("조|선|혁|명|당","朝|鮮|革|命|黨"), #ruby("한|국|독|립|당","韓|國|獨|立|黨")과 #ruby("미|주","美|洲")·#ruby("하|와|이","夏|威|夷") #ruby("각","各") #ruby("단|체","團|體")를 #ruby("연|결","連|結")하여 #ruby("민|족|진|선","民|族|陣|線")#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("정|식","正|式") #ruby("명|칭","名|稱")은 ‘#ruby("한|국|광|복|운|동|단|체|연|합|회","韓|國|光|復|運|動|團|體|聯|合|會")’. #ruby("중|일|전|쟁","中|日|戰|爭")이 #ruby("발|발","勃|發")하면서 #ruby("긴|급","緊|急")한 #ruby("통|일","統|一")의 #ruby("필|요|성","必|要|性")과 #ruby("임|정","臨|政")의 #ruby("정|당|성","正|當|性") #ruby("강|조","强|調")를 #ruby("위","爲")해 1937#ruby("년","年") 8#ruby("월","月") #ruby("결|성","結|成")한 #ruby("독|립|운|동|연|합|체","獨|立|運|動|聯|合|體")다. #ruby("김|원|봉","金|元|鳳") #ruby("중|심","中|心")의 #ruby("좌|파","左|派") #ruby("단|체","團|體")는 이에 #ruby("참|가","參|加")하지 않았다.]을 #ruby("결|성","結|成")하고, #ruby("임|시|정|부","臨|時|政|府")를 #ruby("옹|호","擁|護")·#ruby("지|지","支|持")하여, #ruby("정|부","政|府")는 #ruby("점|점","漸|漸") #ruby("발|전","發|展")하게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해|전|쟁","上|海|戰|爭")은 #ruby("점|점","漸|漸") #ruby("중|국","中|國") #ruby("측","側")이 #ruby("불|리","不|利")하게 되어 #ruby("왜|비|행|기","倭|飛|行|機")의 #ruby("남|경","南|京") #ruby("폭|격","爆|擊")이 날로 #ruby("심","甚")해졌다. #ruby("회|청|교","淮|淸|橋") 집에서 나는 초저녁에 #ruby("적|기","敵|機")로 #ruby("인","因")해서 #ruby("곤|란","困|難")을 받다가, #ruby("경|보","警|報") #ruby("해|제","解|除") #ruby("후","後") 잠이 깊이 들었는데, 갑자기 잠결에 #ruby("공|중","空|中")에서 #ruby("기|관|포","機|關|砲") 소리가 들렸다. 놀라 자리에서 벌떡 일어나 #ruby("방|문","房|門") 밖에 나서자, #ruby("벽|력","霹|靂")이 #ruby("진|동","震|動")하며 내가 누웠던 #ruby("천|장","天|障")이 무너져 내렸다. 뒷방에서 자는 #ruby("애|보","愛|寶")를 불러내니 죽지는 않았다. 뒷방에 같이 사는 이들이 흙먼지를 헤치고 나오는데, 뒷#ruby("벽","壁")은 무너지고 그 밖에는 #ruby("시|체","屍|體")가 헤아릴 수 없었다. #ruby("각|처","各|處")에서 불빛이 하늘로 높이 치솟아 하늘#ruby("색","色")은 마치 붉은 담요와 같았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[날이 밝아 #ruby("마|로|가","馬|路|街")에 있는 어머님 #ruby("댁","宅")을 찾아갔다. 여기저기 죽은 사람, #ruby("상","傷")한 사람이 길에 가득한 것을 보면서 #ruby("문","門")을 두드리니, 어머님께서 #ruby("친","親")히 나오셔서 #ruby("문","門")을 열었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“놀라셨지요?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 묻자, 어머님은 웃으시면서,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“놀라기는 무엇을 놀라. #ruby("침|대","寢|臺")가 들썩들썩 하더군. 그래, 사람이 많이 죽었나?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예, 오면서 보니 이 #ruby("근|처","近|處")에서도 사람이 #ruby("상","傷")하였던데요.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 사람들은 #ruby("상","傷")하지 않았나?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“글쎄올시다. 지금 나가보렵니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[곧 나와 #ruby("백|산","白|山") #ruby("이|청|천","李|靑|天")의 집을 #ruby("방|문","訪|問")하니, 집의 #ruby("진|동","震|動")으로 #ruby("경|황","驚|惶")을 겪었으나 #ruby("별|고","別|故")는 없고, #ruby("남|기|가","藍|旗|街")에 있는 #ruby("대|다|수","大|多|數") #ruby("학|생","學|生")과 #ruby("가|족","家|族")도 #ruby("무|고","無|故")하니 #ruby("천|만|다|행","千|萬|多|幸")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("성|암","醒|菴") #ruby("이|광","李|光") #ruby("댁","宅") #ruby("자|녀","子|女")는 일곱인데, #ruby("심|야","深|夜")에 #ruby("경|보","警|報")로 #ruby("피|난","避|難")가던 #ruby("도|중","途|中")에야 #ruby("천|영","天|英")이 혼자 자고 있던 것을 깨닫고, 다시 담을 넘어 들어가서 자는 아이를 안고 나왔다는 우스운 일도 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("남|경","南|京")이 #ruby("시|시|각|각","時|時|刻|刻") #ruby("위|험","危|險")하니 #ruby("중|국","中|國") #ruby("정|부","政|府")는 #ruby("중|경","重|慶")을 #ruby("전|시","戰|時") #ruby("수|도","首|都")로 #ruby("정","定")하고, #ruby("각","各") #ruby("기|관","機|關")을 #ruby("분|분","紛|紛")히 옮기기 #ruby("시|작","始|作")하였다. 우리 #ruby("광|복|진|선","光|復|陣|線") 3#ruby("당","黨")의 #ruby("인|원","人|員") 및 #ruby("가|솔","家|率") #ruby("백|여","百|餘") #ruby("명","名")은 #ruby("물|가","物|價")가 비싸지 않은 #ruby("호|남|성","湖|南|省") #ruby("장|사","長|沙")로 #ruby("우|선","優|先") #ruby("이|주","移|住")하기로 #ruby("결|정","決|定")하고, #ruby("상|해","上|海")·#ruby("항|주","杭|州")에 있는 #ruby("동|지","同|志")들과 #ruby("율|양","溧|陽") #ruby("고|당|암","古|堂|菴")에서 #ruby("선|도","仙|道")를 닦고 있는 #ruby("우|강","雩|岡") #ruby("양|기|탁","梁|起|鐸") #ruby("형","兄")을 #ruby("포|함","包|含")하여, #ruby("각|지","各|地") #ruby("식|구","食|口")에게 #ruby("남|경","南|京")으로 올 #ruby("여|비","旅|費")를 보내어 #ruby("소|집|령","召|集|令")을 #ruby("발","發")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("안|공|근","安|恭|根")을 #ruby("상|해","上|海")로 #ruby("파|견","派|遣")하여 #ruby("자|기","自|己") #ruby("가|솔","家|率")과, #ruby("안|중|근","安|重|根") #ruby("의|사","義|士")의 #ruby("부|인","夫|人")인 큰#ruby("형|수","兄|嫂")를 기어이 모셔오라고 거듭 #ruby("부|탁","付|託")하였다. 그런데 #ruby("공|근","恭|根")은 #ruby("자|기","自|己")의 #ruby("가|속","家|屬")들만 거느리고 왔을 뿐, 큰#ruby("형|수","兄|嫂")를 데려오지 않았다. 나는 크게 꾸짖었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("양|반","兩|班")의 집에 #ruby("화|재","火|災")가 나면 #ruby("사|당","祠|堂")부터 #ruby("포|출","抱|出")하나니,#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("사|당","祠|堂")에 가서 #ruby("신|주","神|主")부터 안고 나오거늘”. #ruby("원|문","原|文")에는 #ruby("신|주","神|主")가 빠져 있다.] #ruby("혁|명|가","革|命|家")가 #ruby("피|난","避|難")하면서 #ruby("국|가","國|家")를 #ruby("위","爲")하여 #ruby("살|신|성|인","殺|身|成|仁")한 #ruby("의|사","義|士")의 #ruby("부|인","夫|人")을 #ruby("왜|구","倭|寇")의 #ruby("점|령|구","占|領|區")에 버리고 오는 것은, #ruby("안|군","安|君") #ruby("가|문","家|門")의 #ruby("도|덕","道|德")에는 #ruby("물|론","勿|論")이고 #ruby("혁|명|가","革|命|家")의 #ruby("도|덕","道|德")으로도 #ruby("용|인","容|認")할 수 없는 일이다. 또한 #ruby("군","君")의 #ruby("가|족","家|族")도 #ruby("단|체|생|활","團|體|生|活") #ruby("범|위|내","範|圍|內")에 들어오는 것이 #ruby("생|사|고|락","生|死|苦|樂")을 같이 하는 #ruby("본|의","本|意")에 #ruby("합|당","合|當")하지 않겠는가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러나 #ruby("공|근","恭|根")은 #ruby("자|기","自|己") #ruby("식|구","食|口")만 #ruby("중|경","重|慶")으로 #ruby("이|주","移|住")케 하고, #ruby("단|체","團|體") #ruby("편|입","編|入")을 #ruby("원","願")하지 않으므로 #ruby("본|인","本|人")의 뜻에 맡겼다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("안|휘","安|徽") #ruby("둔|계","屯|溪")#ruby("중|학","中|學")에 #ruby("재|학|중","在|學|中")인 #ruby("신","信")이를 불러오고 어머님을 모셔와 #ruby("안|공|근","安|恭|根") #ruby("식|구","食|口")와 같이 #ruby("영|국","英|國") #ruby("윤|선","輪|船")으로 #ruby("한|구","漢|口")를 향해 떠났다. 그 뒤를 이어 #ruby("대|가|족","大|家|族") #ruby("백|여","百|餘") #ruby("식|구","食|口")는 #ruby("중|국","中|國") #ruby("목|선","木|船") 한 #ruby("척","隻")에 짐까지 가득 싣고, #ruby("남|경","南|京")에서 #ruby("소|개","疏|開")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 어머님을 모시고 #ruby("한|구","漢|口")에 #ruby("도|착","到|着")하여 #ruby("장|사","長|沙")로 가니, #ruby("선|발|대","先|發|隊") #ruby("조|성|환","趙|成|煥")·#ruby("조|완|구","趙|琬|九") #ruby("등","等")은 #ruby("진|강","鎭|江")에서 #ruby("임|시|정|부","臨|時|政|府") #ruby("문|서","文|書")와 #ruby("장|부","文|簿")를 가지고 #ruby("남|경","南|京") #ruby("일|행","一|行")보다 며칠 먼저 #ruby("도|착","到|着")하였고, #ruby("남|경","南|京") #ruby("일|행","一|行") #ruby("역|시","亦|是") #ruby("풍|랑|중","風|浪|中")에도 #ruby("무|사","無|事")하였다. #ruby("남|기|가","藍|旗|街") #ruby("사|무|소","事|務|所")에서 물 긷던 #ruby("고|용|인","雇|用|人") #ruby("채","蔡")#ruby("군","君")은, 사람이 #ruby("충|실","忠|實")하니 같이 데리고 가라고 어머님께서 #ruby("명|령","命|令")하시기에 #ruby("동|행","同|行")하였는데, #ruby("무|호","蕪|湖")에서 #ruby("풍|랑|중","風|浪|中") 물을 긷다 #ruby("실|족","失|足")하여 물에 빠져 죽었다. 이 한 가지 일만은 #ruby("불|행","不|幸")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("남|경","南|京")에서 #ruby("출|발","出|發")할 때 #ruby("주|애|보","朱|愛|寶")는 #ruby("본|향","本|鄕")인 #ruby("가|흥","嘉|興")으로 돌려보냈다. 그#ruby("후","後") #ruby("종|종","種|種") #ruby("후|회","後|悔")되는 것은, #ruby("송|별","送|別")할 때 #ruby("여|비","旅|費") 100#ruby("원","元")밖에 주지 못하였던 것이다. #ruby("근","近") 5#ruby("년","年") 동안 한갓 #ruby("광|동|인","廣|東|人")으로만 알고 나를 #ruby("위","爲")하였고, 모르는 사이 우리는 #ruby("부|부|같|이","類|似|夫|婦") 되었다. 나에 #ruby("대","對")한 #ruby("공|로","功|勞")가 없지 않은데, 내가 뒷날을 #ruby("기|약","期|約")할 수 있을 줄 알고 돈도 넉넉히 돕지 못한 것이 #ruby("유|감|천|만","遺|憾|千|萬")이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("한|구","漢|口")까지 #ruby("동|행","同|行")한 #ruby("공|근","恭|根")의 #ruby("식|구","食|口")는 #ruby("중|경","重|慶")으로 #ruby("이|주","移|住")하였고, #ruby("백|여","百|餘") #ruby("식|구","食|口")의 #ruby("동|지","同|志")·#ruby("동|포","同|胞")들은 #ruby("공|동|생|활","共|同|生|活")을 할 줄 몰라 #ruby("각|자","各|自") #ruby("방","房")을 얻어주고 #ruby("취|사","炊|事")하게 하였다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[4) 어머님에 #ruby("대","對")한 #ruby("추|억","追|憶")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님의 #ruby("생|활|문|제","生|活|問|題")를 빠뜨렸으므로 다시 거슬러 올라가 #ruby("기|록","記|錄")한다. 나는 #ruby("상|해","上|海")에서 #ruby("민|국","民|國") 6#ruby("년","年")\(1924) 1#ruby("월","月") 1#ruby("일","日") #ruby("상|처","喪|妻")하였다. #ruby("처","妻")는 #ruby("신","信")을 낳은 #ruby("후","後") 몸이 채 튼튼치 못하였을 때 #ruby("영|경|방","永|慶|坊") 10#ruby("호","號") 2#ruby("층","層")에서 어머님께 #ruby("세|숫","洗|手")물을 버려 달라고 하기가 #ruby("황|송","惶|悚")했는지 #ruby("세|숫","洗|手")대야를 들고 아래#ruby("층","層")으로 내려가다 #ruby("실|족","失|足")하여 #ruby("층|계","層|階")에서 굴렀다. 그#ruby("후","後") #ruby("늑|막|염","肋|膜|炎")이 #ruby("폐|병","肺|病")이 되어서 #ruby("홍|구","虹|口") #ruby("서|양|인","西|洋|人")이 #ruby("경|영","經|營")하는 #ruby("폐|병|원","肺|病|院")에서 #ruby("사|망","死|亡")하였다. 내가 그곳에 못 가는 까닭에 #ruby("보|륭|의|원","普|隆|醫|院")에서 #ruby("최|후","最|後") #ruby("작|별","作|別")을 하였다. #ruby("김|의|한","金|毅|漢") #ruby("부|처","夫|妻")가 #ruby("방|문","訪|問")하여 #ruby("처","妻")의 #ruby("임|종","臨|終")을 봐주었고, 나는 그들이 돌아와서 #ruby("보|고","報|告")하는 것만 들었다. #ruby("미|주","美|洲")에서 #ruby("상|해","上|海")에 온 #ruby("유|세|관","柳|世|觀")이 #ruby("입|원","入|院") 때와 #ruby("장|례|식","葬|禮|式") 때 많은 #ruby("수|고","受|苦")를 해주었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 세 살인 #ruby("신","信")을 #ruby("우|유","牛|乳")로 길렀는데, 밤에 잘 때는 어머님의 빈 젖을 물려 재웠다. #ruby("상|해","上|海")의 우리 #ruby("생|활","生|活")은 #ruby("극|도","極|度")로 #ruby("곤|란","困|難")하였다. 그때 #ruby("독|립|운|동","獨|立|運|動")을 하는 우리 #ruby("동|지","同|志")들은 #ruby("취|직|자","就|職|者")·#ruby("영|업|자","營|業|者")들을 #ruby("제","除")하면 #ruby("수|십","數|十") #ruby("명","名")에 #ruby("불|과","不|過")하였다. 어머님께서는 #ruby("청|년","靑|年")·#ruby("노|인","老|人")들이 굶주리는 것을 #ruby("애|석","哀|惜")히 여기셨지만 #ruby("구|제","救|濟")할 #ruby("방|법","方|法")이 없었다. 두 #ruby("손|자","孫|子")마저도 #ruby("상|해","上|海")에서 키우기 힘들어 #ruby("환|국","還|國")코자 하실 때, 어머님은 우리집 뒤쪽 쓰레기#ruby("통","桶") 안에 #ruby("근|처","近|處") #ruby("채|소|상","菜|蔬|商")이 버린 배추 껍데기가 많은 것을 보고, #ruby("매|일","每|日") 저녁 밤 깊은 #ruby("후","後") 그런대로 먹을 만한 것을 골라 소금물에 담가두었다가 #ruby("찬","饌")거리로 하기 #ruby("위","爲")해 여러 #ruby("항","缸")아리를 만들기도 하셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[아무리 생각해도 #ruby("상|해|생|활","上|海|生|活")을 #ruby("유|지","維|持")하기 어려워지자 어머님께서는 네 살이 채 안된 #ruby("신","信")이를 데리고 #ruby("귀|국","歸|國")의 길을 떠나셨고, 나는 #ruby("인","仁")이를 데리고 #ruby("여|반|로","呂|班|路") #ruby("단|층","單|層")집을 #ruby("세","貰")내어 #ruby("석|오","石|吾") #ruby("이|동|녕","李|東|寧") #ruby("선|생","先|生")과 #ruby("윤|기|섭","尹|琦|燮")·#ruby("조|완|구","趙|琬|九") #ruby("등","等") 몇 분 #ruby("동|지","同|志")들과 같이 살며 어머님께서 담아주신 우거지 김치를 오래 두고 먹었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님께서 #ruby("본|국","本|國")으로 돌아가실 때 #ruby("여|비","旅|費")를 넉넉히 드리지 못해, 겨우 #ruby("인|천","仁|川")에 #ruby("상|륙","上|陸")하시자 #ruby("여|비","旅|費")가 떨어졌다. 떠나실 때 내가 그런 말씀을 드린 바 없건만, 어머님은 #ruby("인|천","仁|川") 『#ruby("동|아|일|보","東|亞|日|報")』 #ruby("지|국","支|局")에 가서 #ruby("사|정","事|情")을 말씀하였다. #ruby("지|국","支|局")에서는 #ruby("신|문","新|聞")에 난 #ruby("상|해","上|海") #ruby("소|식","消|息")을 보고 벌써 알았다면서 #ruby("경|성","京|城") 갈 #ruby("여|비","旅|費")와 #ruby("차|표","車|票")를 사서 드렸고, #ruby("경|성","京|城")에서 다시 #ruby("동|아|일|보|사","東|亞|日|報|社")를 찾아가니 #ruby("역|시","亦|是") #ruby("사|리|원","沙|里|院")까지 보내드렸다고 했다.#footnote(numbering: _ => [17)])[#h(0.35em)『#ruby("동|아|일|보","東|亞|日|報")』는 1925#ruby("년","年") 11#ruby("월","月") 6#ruby("일|자","日|字") #ruby("보|도","報|道")에서 #ruby("곽|낙|원","郭|樂|園") #ruby("여|사","女|史")가 아들의 #ruby("만|류","挽|留")에도 #ruby("불|구","不|拘")하고 #ruby("고|국","故|國")으로 돌아오며, #ruby("여|사","女|史")가 #ruby("조|선","朝|鮮")에 오더라도 갈 곳이 없어 #ruby("암|담","暗|澹")하다고 #ruby("보|도","報|道")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海")를 떠나실 때 나는,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("사|리|원","沙|里|院")에 #ruby("도|착","到|着")하신 #ruby("후","後") #ruby("안|악","安|岳") #ruby("김|홍|량","金|鴻|亮") #ruby("군","君")에게 #ruby("통|지","通|知")하여 #ruby("영|접","迎|接")을 나오거든 따라가시고, #ruby("소|식","消|息")이 없거든 #ruby("송|화","松|禾") #ruby("득|성|리","得|聖|里") #ruby("이|모","姨|母")（張雲龍: #ruby("이|종|사|촌","姨|從|四|寸")） #ruby("댁","宅")으로 가십시오.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 #ruby("부|탁","付|託")하였다. 어머님은 내 #ruby("부|탁","付|託")대로 #ruby("사|리|원","沙|里|院")에서 #ruby("안|악","安|岳")의 #ruby("김|군","金|君")에게 #ruby("통|지","通|知")를 하였으나, 아무 #ruby("회|보","回|報")가 없어 #ruby("송|화","松|禾")로 가셨다. 2〜3#ruby("개|월","個|月") #ruby("후","後")인 #ruby("음|력","陰|曆") #ruby("정|초","正|初")에 #ruby("안|악","安|岳")에서 #ruby("김|용|제","金|庸|濟")의 큰아들 #ruby("선|량","善|亮") #ruby("군","君")이 어머님을 찾아뵙고 #ruby("안|악","安|岳")으로 모셔갈 #ruby("의|사","意|思")를 아뢰었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("경|찰|서","警|察|署") #ruby("일|본|인","日|本|人")이 #ruby("누|차","屢|次") 우리집에 와서 ‘할머님이 #ruby("안|악","安|岳")으로 오시지 않고 #ruby("중|도","中|道")에 계시게 하면서 우리 집안에서 할머님에게 #ruby("금|전","金|錢")을 보내어 #ruby("상|해","上|海")에 계신 #ruby("김|선|생","金|先|生")님에게 #ruby("독|립|자|금","獨|立|資|金")을 #ruby("공|급","供|給")한다’고 #ruby("야|단","惹|端")이니, 집안 어른들이 가서 모셔오라기로 왔습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("모|친","母|親")은 크게 #ruby("노","怒")하셔서 호통치셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("사|리|원","沙|里|院")에서 왔다고 #ruby("통|지","通|知")하였으나 아무 #ruby("대|답","對|答")이 없다가, 지금 #ruby("일|본","日|本") #ruby("순|사","巡|査")의 심부름으로 왔느냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("곡|절","曲|折")이 그리 된 것도 #ruby("정","情") #ruby("부|족","不|足")이 아니옵고 #ruby("환|경","環|境") #ruby("관|계","關|係")이오니 #ruby("용|서","容|恕")하시고 같이 가십시다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네 말 잘 알았다. 날이 따뜻해지면 #ruby("해|주","海|州") #ruby("고|향","故|鄕")에 다녀서 #ruby("안|악","安|岳")으로 가마.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하시고 어머니는 #ruby("선|량","善|亮")을 돌려보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[봄이 되어 #ruby("득|성|리","得|聖|里")에서 떠나 #ruby("도|고|로","陶|古|路") #ruby[임|선|재][林|善|在]\(셋째 #ruby("삼|촌","三|寸")의 사위)의 집과 #ruby("백|석|동","白|石|洞") #ruby[손|진|현][孫|鎭|鉉]\(#ruby("고|모","姑|母")의 아들)의 집을 #ruby("방|문","訪|問")하시고 #ruby("해|주","海|州") 텃골 #ruby[김|태|운][金|泰|運]\(#ruby("재|종|동|생","再|從|同|生"))과 몇몇 #ruby("친|척","親|戚")들과 함께 #ruby("부|친","父|親") #ruby("묘|소","墓|所")에 마지막으로 다녀서 #ruby("안|악","安|岳")으로 가셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[먼저 #ruby("선|량","善|亮")의 집으로 들어가셨는데 #ruby("김|씨","金|氏") #ruby("문|중","門|中")에서 이를 알고, #ruby("다|정","多|情")히 지내던 #ruby("용|진","庸|震")·#ruby("홍|량","鴻|亮") #ruby("등","等")이 찾아뵙고,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("모|친","母|親") 오시기 #ruby("전","前")에 #ruby("주|택","住|宅")과 살림살이며 #ruby("식|량","食|糧")·#ruby("의|료","醫|療")를 다 #ruby("준|비","準|備")하였으니 #ruby("편|안","便|安")히 계십시오.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 모셔가더라고 말씀하셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 #ruby("주|야","晝|夜")로 #ruby("상|해","上|海")에 있는 #ruby("자|손","子|孫")을 잊지 못하시고 #ruby("생|활|비","生|活|費")에서 #ruby("절|약","節|約")하여 #ruby("약|간","若|干")의 #ruby("금|전","金|錢")도 부쳐 보내셨지만, 그것은 타오르는 #ruby("화|로","火|爐") 속의 한 #ruby("점","點") #ruby[눈송이처럼][紅爐點雪] #ruby("별","別") 보탬이 되진 못했다. 이를 알아챈 어머님은 다시 #ruby("인","仁")이를 #ruby("본|국","本|國")으로 보내라고 #ruby("명|령","命|令")을 하셨다. #ruby[김|철|남][金|鐵|南]\(永斗) #ruby("군","君")의 #ruby("삼|촌","三|寸") #ruby("편","便")에 #ruby("인","仁")이까지 #ruby("귀|국","歸|國")시키니, 나는 #ruby("혈|혈|단|신","孑|孑|單|身")으로 한 #ruby("점","點") 딸린 #ruby("식|구","食|口")도 없게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("세|월","歲|月")이 흐르는 물과 같아서 내 나이 #ruby("오|십|여","五|十|餘")라. #ruby("과|거","過|去")를 #ruby("회|상","回|想")하고 #ruby("장|래","將|來")를 #ruby("추|상","推|想")하니 #ruby("신|세","身|世") #ruby("가|련","可|憐")하다. #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 #ruby("소|원","所|願")하기를, #ruby("천|우|신|조","天|佑|神|助")로 우리도 어느 때 #ruby("독|립|정|부","獨|立|政|府")가 #ruby("성|립","成|立")되거든 #ruby("정|부","政|府") #ruby("문","門")지기를 하다가 죽으면 #ruby("여|한","餘|恨")이 없다고 하였다. 이 #ruby("소|원","所|願")을 #ruby("초|과","超|過")하여 #ruby("최|고|직","最|高|職")을 #ruby("경|험","經|驗")한 나의 #ruby("책|임","責|任")을 무엇으로 #ruby("이|행","履|行")할까 하는 생각에서 #ruby("모|험|사|업","冒|險|事|業")에 #ruby("착|수","着|手")할 것을 #ruby("결|심","決|心")하고, 『#ruby("백|범|일|지","白|凡|逸|志")』를 쓰기 #ruby("시|작","始|作")하여 1#ruby("년","年") 2#ruby("개|월","個|月") 만에 #ruby("상|편","上|篇")을 #ruby("완|성","完|成")하였다. #ruby("경|과","經|過") #ruby("사|실","事|實")의 #ruby("모|년","某|年") #ruby("모|일","某|日")을 #ruby("기|입","記|入")한 것은 #ruby("본|국","本|國")에 계신 #ruby("모|친","母|親")께 #ruby("편|지","便|紙")를 올려 #ruby("답|장","答|狀")을 받아 #ruby("기|입","記|入")하였으나, 지금 #ruby("하|편","下|篇")을 쓰는 때에도 어머님이 곧 #ruby("생|존","生|存")하셨더라면 도움이 많았을 터이건만, 슬프도다!]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님이 #ruby("안|악","安|岳")에 계실 때 #ruby("동|경","東|京") #ruby("사|건","事|件")이 일어나자 #ruby("순|사|대","巡|査|隊")가 #ruby("주|택","住|宅")을 #ruby("포|위","包|圍")하고 며칠을 #ruby("경|계","警|戒")하였고, #ruby("홍|구","虹|口") #ruby("사|건","事|件") #ruby("이|후","以|後")에는 더욱 #ruby("심","甚")하였다 한다. 나는 #ruby("비|밀","祕|密")히 어머님께 #ruby("보|고","報|告")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“어머님께서 아이놈들을 데리고 다시 #ruby("중|국","中|國")에 오셔도 #ruby("이|전","以|前")과 같이 굶지는 않을 테니, 나올 수 있으면 오십시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 #ruby("본|래","本|來") 다른 #ruby("여|성","女|性")들이 미칠 수가 없을 만큼 #ruby("용|감","勇|敢")하셔서 #ruby("안|악","安|岳") #ruby("경|찰|서","警|察|署")에 #ruby("출|국|원","出|國|願")을 #ruby("제|출","提|出")하였다. #ruby("이|유","理|由")는 나이 늙어 죽을 날이 며칠 남지 않았으니 #ruby("생|전","生|前")에 #ruby("손|자","孫|子") 둘을 제 아비에게 맡기겠다는 것이었다. #ruby("다|행","多|幸")히 #ruby("안|악","安|岳") #ruby("경|찰|서","警|察|署")의 #ruby("허|가","許|可")를 얻으시고 짐을 꾸리던 즈음, #ruby("경|성","京|城") #ruby("경|시|청","警|視|廳")에서 #ruby("요|원","要|員")을 #ruby("안|악","安|岳")으로 #ruby("파|견","派|遣")하여 어머님을 #ruby("위|협","威|脅")하고 #ruby("설|득","說|得")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("상|해","上|海")에서 우리 #ruby("일|본","日|本") #ruby("경|관","警|官")들이 #ruby("당|신","當|身") 아들을 #ruby("체|포","逮|捕")하려 해도 찾지 못하는 터에 #ruby("노|인","老|人")이 말할 수 없이 #ruby("고|생","苦|生")할 것 없소. #ruby("상|부","上|部") #ruby("명|령","命|令")으로 #ruby("당|신","當|身") #ruby("출|국","出|國")은 #ruby("허|락","許|諾")지 않으니 그리 알고 집으로 돌아가서 #ruby("안|심","安|心")하고 지내시오.”]
