#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("안|공|근","安|恭|根")은 #ruby("중|경","重|慶")에 살던 #ruby("자|기","自|己") #ruby("가|족","家|族")과, #ruby("광|서","廣|西")로 #ruby("이|주","移|住")시켰던 작은 #ruby[형][仲兄] #ruby("정|근","定|根") #ruby("가|족","家|族")까지 #ruby("홍|콩","香|港")으로 #ruby("이|주","移|住")시킬 일로 #ruby("홍|콩","香|港")에 가 있었고, #ruby("인","仁")이 #ruby("역|시","亦|是") #ruby("상|해|공|작","上|海|工|作") 가는 길에 #ruby("홍|콩","香|港")에 가 있었다. 그런 까닭에 내가 #ruby("자|동|차","自|動|車")에 실려 #ruby("의|원","醫|院") #ruby("문|간","門|間")에 가서 #ruby("의|사","醫|師") #ruby("진|단","診|斷")으로 #ruby("가|망","可|望") 없다는 #ruby("선|고","宣|告")를 받은 #ruby("즉|시","卽|時"), #ruby("홍|콩","香|港")에 #ruby("발","發")한 #ruby("전|보","電|報")는 #ruby("피|인|창|살","被|人|槍|殺")의 #ruby("여|지","餘|地") 없은 #ruby("전|보","電|報")가 갓든 것이라.#footnote(numbering: _ => [28)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “‘#ruby("피|살","被|殺")#ruby("당","當")했다’는 #ruby("여|지","餘|地")없는 #ruby("전|보","電|報")가 #ruby("홍|콩","香|港")으로 갔던 것이다.”]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그래서 #ruby("수|일","數|日") #ruby("후","後") #ruby("인","仁")과 #ruby("공|근","恭|根")이 #ruby("장|례","葬|禮")에 #ruby("참|가","參|加")하기 #ruby("위","爲")해 #ruby("장|사","長|沙")로 돌아오기까지 하였다.]
