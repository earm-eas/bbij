#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("엄|항|섭","嚴|恒|燮") #ruby("군","君")의 집에서 #ruby("휴|양|중","休|養|中")이었는데, 하루는 #ruby("홀|연","忽|然") #ruby("신|기","神|氣")가 #ruby("불|편","不|便")하고 #ruby("구|역","嘔|逆")이 나며 오른쪽 다리가 #ruby("마|비","麻|痺")되므로, 다시 #ruby("상|아|의|원","湘|雅|醫|院")에 가서 #ruby("진|단","診|斷")을 받았다. X#ruby("광|선","光|線")으로 #ruby("심|장","心|臟") 곁에 들어 있던 #ruby("탄|환","彈|丸")을 #ruby("검|사","檢|査")하니, #ruby("위|치","位|置")가 #ruby("변|동","變|動")되어 오른쪽 갈비뼈 옆으로 옮겨가 있다는 것이었다. #ruby("서|양","西|洋") #ruby("외|과","外|科") #ruby("주|임","主|任")은,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("본|시","本|是") #ruby("심|장","心|臟") 곁에 있던 #ruby("탄|환","彈|丸")이 #ruby("대|혈|관","大|血|管")을 #ruby("통|과","通|過")하여 #ruby("우|측","右|側") 갈비뼈 쪽으로 옮겨갔습니다. #ruby("불|편","不|便")하면 #ruby("수|술","手|術")도 쉬우나 그대로 두어도 #ruby("생|명","生|命")에는 아무 #ruby("관|계","關|係")가 없습니다. 오른쪽 다리의 #ruby("마|비","麻|痺")는 #ruby("탄|환","彈|丸")이 #ruby("대|혈|관","大|血|管")을 #ruby("압|박","壓|迫")하는 까닭이나 #ruby("점|차","漸|次") #ruby("소|혈|관","小|血|管")들이 #ruby("확|대","擴|大")됨에 따라 #ruby("해|소","解|消")될 것입니다.”]
