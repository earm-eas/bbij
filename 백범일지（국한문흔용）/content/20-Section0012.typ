#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이때 우리 #ruby("사|회","社|會")에서는 또다시 #ruby("통|일","統|一") 바람이 일어나, #ruby("대|일|전|선|통|일|동|맹","對|日|戰|線|統|一|同|盟")의 #ruby("발|동","發|動")으로 #ruby("의|논","議|論")이 #ruby("분|분","紛|紛")하였다. 하루는 #ruby("의|열|단|장","義|烈|團|長") #ruby("김|원|봉","金|元|鳳")#footnote(numbering: _ => [6)])[#h(0.35em)#ruby[김|원|봉][金|元|鳳]\(1898〜?). #ruby("호","號")는 #ruby("약|산","若|山"). 그는 #ruby("동|지","同|志") 12#ruby("명","名")과 함께 1919#ruby("년","年") 11#ruby("월","月") #ruby("중|국","中|國") #ruby("길|림","吉|林")에서 #ruby("일|본","日|本") #ruby("관|원","官|員")을 #ruby("암|살","暗|殺")하고 #ruby("관|청","官|廳")을 #ruby("습|격","襲|擊")하는 #ruby("무|장|독|립|운|동|단|체","武|裝|獨|立|運|動|團|體")인 #ruby("의|열|단","義|烈|團")을 #ruby("결|성","結|成")하여 #ruby("단|장","團|長")을 맡았다. 그#ruby("후","後") #ruby("의|열|단","義|烈|團")은 #ruby("부|산|경|찰|서","釜|山|警|察|署") #ruby("폭|파","爆|破"), #ruby("밀|양|경|찰|서","密|陽|警|察|署")와 #ruby("동|양|척|식|회|사","東|洋|拓|殖|會|社") #ruby("습|격","襲|擊") #ruby("등","等") #ruby("활|발","活|潑")하게 #ruby("활|동","活|動")하였다. #ruby("의|열|단","義|烈|團") #ruby("해|산","解|散") #ruby("후","後") #ruby("김|원|봉","金|元|鳳")은 1935#ruby("년","年") #ruby("민|족|혁|명|당","民|族|革|命|黨") #ruby("결|성","結|成")을 #ruby("주|도","主|導")하였고, 1938#ruby("년","年") #ruby("조|선|의|용|대","朝|鮮|義|勇|隊")를 #ruby("편|성","編|成")하고 #ruby("총|대|장","總|隊|長")에 #ruby("취|임","就|任")하였으며, 1941#ruby("년","年") #ruby("조|선|의|용|대","朝|鮮|義|勇|隊")가 #ruby("한|국|광|복|군","韓|國|光|復|軍")에 #ruby("편|입","編|入")됨에 따라 #ruby("광|복|군","光|復|軍") #ruby("군|사|부|장","軍|事|部|長")에 #ruby("취|임","就|任")하였다. #ruby("해|방","解|放") #ruby("후","後") 그는 #ruby("인|민|공|화|당","人|民|共|和|黨")을 #ruby("창|설","創|設")하여 #ruby("임|정","臨|政") #ruby("요|인","要|人")들과는 #ruby("별|개","別|個")의 #ruby("활|동","活|動")을 하였고, 1948#ruby("년","年") #ruby("남|북|연|석|회|의","南|北|聯|席|會|議") #ruby("직|전","直|前")에 #ruby("월|북","越|北")하였다.] #ruby("군","君")이 #ruby("특|별|면|회","特|別|面|會")를 #ruby("청","請")하기로 #ruby("남|경","南|京") #ruby("진|회","秦|淮") #ruby("강","江")가에서 #ruby("밀|회","密|會")하였다. #ruby("김|군","金|君")이 나에게 묻기를,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("현|재","現|在") #ruby("발|동","發|動")되는 #ruby("통|일|운|동","統|一|運|動")에 #ruby("참|가","參|加") 아니할 수 없으니 #ruby("선|생","先|生")도 #ruby("동|참","同|參")하는 것이 어떻습니까?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("통|일","統|一")하자는 #ruby("대|원|칙","大|原|則")은 같으나, 그 #ruby("내|용","內|容")이 같은 이불 밑에서 다른 꿈을 꾸는 #ruby[것][同床異夢]으로 #ruby("간|파","看|破")되니, #ruby("군","君")의 #ruby("소|견","所|見")은 어떻소?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“제가 #ruby("통|일|운|동","統|一|運|動")에 #ruby("참|가","參|加")하는 #ruby("주|요","主|要") #ruby("목|적","目|的")은 #ruby("중|국|인","中|國|人")들에게 #ruby("공|산|당","共|産|黨")이란 #ruby("혐|의","嫌|疑")를 #ruby("면","免")하고자 함이올시다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("목|적","目|的")이 #ruby("각|기","各|其") 다른 그런 #ruby("통|일|운|동","統|一|運|動")에는 #ruby("참|가","參|加")하길 #ruby("원","願")하지 않소.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라며 #ruby("거|절","拒|絶")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그로부터 #ruby("소|위","所|謂") 5#ruby("당","黨") #ruby("통|일|회|의","統|一|會|議")가 #ruby("개|최","開|催")되니 #ruby("의|열|단","義|烈|團")·#ruby("신|한|독|당","新|韓|獨|黨")#footnote(numbering: _ => [7)])[#h(0.35em)#ruby("신|한|독|당","新|韓|獨|黨")은 #ruby("신|한|독|립|당","新|韓|獨|立|黨"). #ruby("신|한|독|립|당","新|韓|獨|立|黨")은 #ruby("만|주","滿|洲")에서 #ruby("홍|진","洪|震") #ruby("등","等")을 #ruby("중|심","中|心")으로 #ruby("조|직","組|織")된 #ruby("한|국|독|립|당","韓|國|獨|立|黨")과 #ruby("남|경","南|京")에서 #ruby("윤|기|섭","尹|琦|燮")·#ruby("신|익|희","申|翼|熙") #ruby("등","等")을 #ruby("중|심","中|心")으로 #ruby("조|직","組|織")된 #ruby("한|국|혁|명|당","韓|國|革|命|黨")을 #ruby("통|합","統|合")하여, 1934#ruby("년","年") #ruby("남|경","南|京")에서 #ruby("결|성","結|成")되었다.]·#ruby("조|선|혁|명|당","朝|鮮|革|命|黨")·#ruby("한|국|독|립|당","韓|國|獨|立|黨")·#ruby("미|주|대|한|인|독|립|단","美|洲|大|韓|人|獨|立|團")이 #ruby("통|합","統|合")하여 #ruby("조|선|민|족|혁|명|당","朝|鮮|民|族|革|命|黨")이 #ruby("탄|생","誕|生")하였다.#footnote(numbering: _ => [8)])[#h(0.35em)#ruby("조|선|민|족|혁|명|당","朝|鮮|民|族|革|命|黨")은 1935#ruby("년","年") 7#ruby("월","月") #ruby("출|범","出|帆")하였으나, #ruby("김|원|봉","金|元|鳳")과 #ruby("의|열|단","義|烈|團") #ruby("계|열","系|列")이 #ruby("주|도|권","主|導|權")을 잡자 #ruby("각","各") #ruby("단|체","團|體")가 다시 #ruby("이|탈","離|脫")하게 된다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[5#ruby("당","黨") #ruby("통|일","統|一") 속에는 #ruby("임|시|정|부","臨|時|政|府")를 #ruby[눈엣가시][眼中釘]로 보는 #ruby("의|열|단|원","義|烈|團|員") #ruby("김|두|봉","金|枓|奉")·#ruby("김|약|산","金|若|山") #ruby("등","等")의 #ruby("임|시|정|부","臨|時|政|府") #ruby("취|소|운|동","取|消|運|動")이 #ruby("극|렬","極|烈")하였다. #ruby("당|시","當|時") #ruby("국|무|위|원","國|務|委|員") #ruby("김|규|식","金|奎|植")·#ruby("조|소|앙","趙|素|昻")·#ruby("최|동|오","崔|東|旿")·#ruby("송|병|조","宋|秉|祚")·#ruby("차|이|석","車|利|錫")·#ruby("양|기|탁","梁|起|鐸")·#ruby("유|동|열","柳|東|說") 7#ruby("인","人") #ruby("중","中") #ruby("김|규|식","金|奎|植")·#ruby("조|소|앙","趙|素|昻")·#ruby("최|동|오","崔|東|旿")·#ruby("양|기|탁","梁|起|鐸")·#ruby("유|동|열","柳|東|說") 다섯 사람은 #ruby("통|일","統|一")에 #ruby("심|취","心|醉")하여 #ruby("임|시|정|부","臨|時|政|府") #ruby("파|괴","破|壞")에 #ruby("무|관|심","無|關|心")하였다. 이것을 본 #ruby("김|두|봉","金|枓|奉")은 #ruby("임|시","臨|時") #ruby("소|재|지","所|在|地")인 #ruby("항|주","杭|州")에 가서 #ruby("송|병|조","宋|秉|祚")·#ruby("차|이|석","車|利|錫") #ruby("양|인","兩|人")을 보고,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“5#ruby("당","黨") #ruby("통|일","統|一")이 되는 #ruby("차|제","此|際")에 #ruby("명|패","名|牌")만 남은 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("존|재","存|在")케 할 #ruby("필|요","必|要")가 없으니 #ruby("취|소","取|消")하여 버리자.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("강|경","強|硬")하게 #ruby("주|장","主|張")하였으나, #ruby("송","宋")·#ruby("차","車") 두 사람은 #ruby("강|경","強|硬") #ruby("반|대","反|對")를 하였다. #ruby("국|무|원","國|務|院") 7#ruby("인","人") #ruby("중","中") 다섯 사람이 #ruby("직|책","職|責")을 내놓으니#footnote(numbering: _ => [9)])[#h(0.35em)다섯 사람은 #ruby("임|정","臨|政") #ruby("국|무|위|원|직","國|務|委|員|職")을 #ruby("사|임","辭|任")하고 #ruby("민|족|혁|명|당","民|族|革|命|黨") #ruby("결|성","結|成")에 #ruby("참|여","參|與")하였다.] #ruby("국|무|회|의","國|務|會|議")를 #ruby("진|행","進|行")시킬 수가 없었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이 무렵 나는 #ruby("임|시|정|부","臨|時|政|府")가 #ruby("무|정|부|상|태","無|政|府|狀|態")라는 #ruby("조|완|구","趙|琬|九") #ruby("형","兄")의 #ruby("친|서","親|書")를 받고 #ruby("심","甚")히 #ruby("분|노","憤|怒")하여 #ruby("급","急")히 #ruby("항|주","杭|州")로 달려갔다. 그곳에 #ruby("주|재","駐|在")하던 #ruby("김|철","金|澈")은 이미 #ruby("병|사","病|死")하였고, 5#ruby("당","黨") #ruby("통|일","統|一")에 #ruby("참|가","參|加")하였던 #ruby("조|소|앙","趙|素|昻")은 벌써 #ruby("민|족|혁|명|당","民|族|革|命|黨")에서 #ruby("탈|퇴","脫|退")하였다.#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("민|족|혁|명|당","民|族|革|命|黨") #ruby("결|성","結|成")에 앞장섰던 #ruby("조|소|앙","趙|素|昻")은 #ruby("참|여","參|與") 두 달 만인 1935#ruby("년","年") 9#ruby("월","月") #ruby("사|상|적","思|想|的")인 #ruby("이|유","理|由")를 들어 가장 먼저 #ruby("민|족|혁|명|당","民|族|革|命|黨")을 #ruby("탈|당","脫|黨")하고 #ruby("한|국|독|립|당","韓|國|獨|立|黨")을 #ruby("재|건","再|建")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 #ruby("항|주","杭|州")에 #ruby("주|거","住|居")하던 #ruby("이|시|영","李|始|榮")·#ruby("조|완|구","趙|琬|九")·#ruby("김|붕|준","金|朋|濬")·#ruby("양|소|벽","梁|瀟|碧")·#ruby("송|병|조","宋|秉|祚")·#ruby("차|이|석","車|利|錫") #ruby("등","等") #ruby("의|원","議|員")들과 #ruby("임|시|정|부","臨|時|政|府") #ruby("유|지","維|持") #ruby("문|제","問|題")를 #ruby("협|의","協|議")하였다. 그 #ruby("결|과","結|果") #ruby("의|견","意|見")이 #ruby("일|치","一|致")되어 #ruby("일|동","一|同")이 #ruby("가|흥","嘉|興")에 #ruby("도|착","到|着")하여 #ruby("이|동|녕","李|東|寧")·#ruby("안|공|근","安|恭|根")·#ruby("안|경|근","安|敬|根")·#ruby("엄|항|섭","嚴|恒|燮")·#ruby("김|구","金|九") #ruby("등","等")이 #ruby("남|호","南|湖")에 놀잇배 한 #ruby("척","隻")을 띄우고 #ruby("선|중","船|中")에서 #ruby("의|회","議|會")를 #ruby("개|최","開|催")하였다. 이 #ruby("회|의","會|議")에서 #ruby("이|동|녕","李|東|寧")·#ruby("조|완|구","趙|琬|九")·#ruby("김|구","金|九") 3#ruby("인","人")을 새로 #ruby("국|무|위|원","國|務|委|員")으로 #ruby("보|선","補|選")하니, #ruby("기|존","旣|存")의 #ruby("송|병|조","宋|秉|祚")·#ruby("차|이|석","車|利|錫")을 #ruby("합","合")하여 모두 5#ruby("인","人")이 되어, 비로소 #ruby("국|무|회|의","國|務|會|議")를 #ruby("진|행","進|行")할 수 있게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[5#ruby("당","黨") #ruby("통|일","統|一")이 #ruby("형|성","形|成")될 #ruby("당|시","當|時")부터 #ruby("동|지","同|志")들은 #ruby("단|체","團|體") #ruby("조|직","組|織")을 #ruby("주|장","主|張")하였으나, 나는 #ruby("극","極")히 #ruby("만|류","挽|留")하였다. 그 #ruby("이|유","理|由")는, 다른 이들은 #ruby("통|일","統|一")하자는데 #ruby("내|용","內|容")이 #ruby("복|잡","複|雜")하여 아직 #ruby("참|가","參|加")하지는 않았으나, 내가 어찌 차마 딴 #ruby("단|체","團|體")를 #ruby("조|직","組|織")하겠느냐 하는 것이었다. 그러나 지금은 #ruby("조|소|앙","趙|素|昻")이 #ruby("한|독|당","韓|獨|黨") #ruby("재|건|설","再|建|設")을 #ruby("추|진","推|進")하니, 내가 #ruby("단|체","團|體")를 #ruby("조|직","組|織")하여도 #ruby("통|일","統|一")의 #ruby("파|괴|자","破|壞|者")는 아니며, #ruby("임|시|정|부","臨|時|政|府")가 #ruby("종|종","種|種") #ruby("위|험","危|險")을 #ruby("당","當")하는 것은 튼튼한 #ruby("배|경","背|景")이 없었기 때문인데, 이제 #ruby("임|시|정|부","臨|時|政|府")를 #ruby("옹|호","擁|護")하는 #ruby("단|체","團|體")가 #ruby("필|요","必|要")하다 생각하고 #ruby("한|국|국|민|당","韓|國|國|民|黨")을 #ruby("조|직","組|織")하였다.#footnote(numbering: _ => [11)])[#h(0.35em)1935#ruby("년","年") 11#ruby("월","月") #ruby("항|주","杭|州")에서 #ruby("김|구","金|九")·#ruby("이|동|녕","李|東|寧")·#ruby("조|완|구","趙|琬|九")·#ruby("엄|항|섭","嚴|恒|燮")·#ruby("박|찬|익","朴|贊|翊") #ruby("등","等")이 #ruby("한|국|국|민|당","韓|國|國|民|黨")을 #ruby("결|성","結|成")하였다. #ruby("한|국|국|민|당","韓|國|國|民|黨")은 1940#ruby("년","年") #ruby("재|건|한|국|독|립|당","再|建|韓|國|獨|立|黨")·#ruby("조|선|혁|명|당","朝|鮮|革|命|黨")과 함께 #ruby("한|국|독|립|당","韓|國|獨|立|黨")에 #ruby("합|류","合|流")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("낙|양|군|교","洛|陽|軍|校") #ruby("한|인","韓|人") #ruby("학|생|문|제","學|生|問|題")로 #ruby("남|경","南|京") #ruby("일|본","日|本") #ruby("영|사","領|事") #ruby("스|마","須|磨")가 #ruby("중|국","中|國")에 #ruby("엄|중","嚴|重") #ruby("항|의","抗|議")하고, #ruby("경|비|사|령","警|備|司|令") #ruby("곡|정|륜","谷|正|倫")에게 #ruby("교|섭","交|涉")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("대|역","大|逆") #ruby("김|구","金|九")를 우리가 #ruby("체|포","逮|捕")하려는데 #ruby("입|적","入|籍")이니 무엇이니 딴 말을 해선 안된다.”#footnote(numbering: _ => [12)])[#h(0.35em)#ruby("입|적","入|籍")은 #ruby("귀|화","歸|化")하여 #ruby("국|적","國|籍")에 #ruby("편|입","編|入")되거나 #ruby("호|적","戶|籍")에 올리는 것을 말한다. 여기서 #ruby("일|본","日|本") #ruby("영|사","領|事")의 #ruby("언|급","言|及")은, #ruby("김|구","金|九")가 #ruby("일|본|국|적","日|本|國|籍")에 올라 있지 않다는 #ruby("이|유","理|由")로 #ruby("체|포","逮|捕")할 수 없다고 #ruby("항|의","抗|議")해서는 안된다는 #ruby("의|미","意|味")인 듯하다.]]
