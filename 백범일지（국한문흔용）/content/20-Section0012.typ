)을 #ruby("역|임","歷|任")하였다. #ruby("해|방","解|放") #ruby("후","後") #ruby("귀|국","歸|國")하여 #ruby("대|동|청|년|단","大|同|靑|年|團")을 #ruby("결|성","結|成")하고, #ruby("정|부","政|府") #ruby("수|립","樹|立")에도 #ruby("참|여","參|與")하여 #ruby("제|헌|의|회","制|憲|議|會") #ruby("국|회|의|원","國|會|議|員")·#ruby("무|임|소|장|관","無|任|所|長|官") #ruby("등","等")을 지냈다.]과 #ruby("이|범|석","李|範|奭")#footnote(numbering: _ => [5)])[#h(0.35em)#ruby[이|범|석][李|範|奭]\(1900〜1972). #ruby("호","號")는 #ruby("철|기","鐵|驥"). 서울 #ruby("출|신","出|身"). 1920#ruby("년","年") #ruby("청|산|리|전|투","靑|山|里|戰|鬪")에 #ruby("참|전","參|戰")하였으며, #ruby("중|국","中|國") #ruby("관|내|지|방","關|內|地|方")으로 들어와 #ruby("낙|양|군|관|학|교","洛|陽|軍|官|學|校") #ruby("한|국|인|군|관|대|장","韓|國|人|軍|官|隊|長"), #ruby("광|복|군","光|復|軍") #ruby("제|2|지|대|장","第|二|支|隊|長")과 #ruby("참|모|장","參|謀|長") #ruby("등","等")을 #ruby("역|임","歷|任")하였다. #ruby("해|방","解|放") #ruby("이|후","以|後") #ruby("귀|국","歸|國")하여 #ruby("조|선|민|족|청|년|단","朝|鮮|民|族|靑|年|團")을 #ruby("결|성","結|成")하였으며, #ruby("정|부","政|府") #ruby("수|립|시","樹|立|時") #ruby("초|대","初|代") #ruby("국|무|총|리","國|務|總|理")와 #ruby("국|방|장|관","國|防|長|官")을 #ruby("겸|임","兼|任")하였다.]은 #ruby("교|관","敎|官")·#ruby("영|관","領|官")으로 #ruby("근|무","勤|務")케 하였다.]
