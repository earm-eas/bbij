#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳")에서 #ruby("사|범|강|습","師|範|講|習")을 마치고 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("확|장","擴|張")하여 #ruby("중|학|부","中|學|部")와 #ruby("소|학|부","小|學|部")를 두었다.#footnote(numbering: _ => [21)])[#h(0.35em)1907#ruby("년","年") #ruby("초|등|교|육|기|관","初|等|敎|育|機|關")으로 #ruby("양|산|학|교","楊|山|學|校")가 #ruby("설|립","設|立")되었고, 1908#ruby("년","年") #ruby("일|본","日|本") #ruby("유|학","留|學")에서 돌아온 #ruby("김|홍|량","金|鴻|亮") #ruby("등","等")의 #ruby("발|의","發|議")로 #ruby("김|효|영","金|孝|英")이 낸 3,000#ruby("원","元")과 #ruby("지|방|유|지","地|方|有|志")의 #ruby("의|연|금","義|捐|金") 3,000#ruby("원","元")을 #ruby("적|립","積|立")하여 #ruby("양|산|중|학|교","楊|山|中|學|校")를 #ruby("병|설","竝|設")하였다.] #ruby("김|홍|량","金|鴻|亮")이 #ruby("교|주","校|主") 겸 #ruby("교|장","校|長")이 되어 #ruby("교|무","校|務")를 맡았고, 나는 #ruby("최|광|옥","崔|光|玉") #ruby("등","等") #ruby("교|육|자","敎|育|者")와 힘을 합쳐 #ruby("해|서|교|육|총|회","海|西|敎|育|總|會")#footnote(numbering: _ => [22)])[#h(0.35em)#ruby("면|학|회","勉|學|會")가 #ruby("발|단","發|端")이 되어 1908#ruby("년","年") #ruby("황|해","黃|海")#ruby("도|지|역","道|地|域")의 #ruby("교|육","敎|育") #ruby("보|급","普|及")을 #ruby("위","爲")해 #ruby("결|성","結|成")된 #ruby("단|체","團|體").]를 #ruby("조|직","組|織")하여 #ruby("학|무|총|감","學|務|總|監")을 맡아 #ruby("전","全") #ruby("도|내","道|內")에 #ruby("교|육|기|관","敎|育|機|關")을 #ruby("설|립","設|立")·#ruby("운|영","運|營")하는 #ruby("책|임","責|任")을 지고 #ruby("각","各") #ruby("군","郡")을 #ruby("순|행","巡|行")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("배|천","白|川") #ruby("군|수","郡|守") #ruby("전|봉|훈","全|鳳|薰")의 #ruby("요|청","要|請")에 #ruby("의","依")해 #ruby("배|천|읍","白|川|邑")에 #ruby("당|도","當|到")하니, #ruby("전|군|수","全|郡|守")가 #ruby("각","各") #ruby("면","面")에 #ruby("훈|령","訓|令")하여 #ruby("면|내","面|內") #ruby("두|민","頭|民")과 #ruby("신|사","紳|士")#footnote(numbering: _ => [23)])[#h(0.35em)여기서 #ruby("두|민","頭|民")은 #ruby("향|촌","鄕|村")의 #ruby("지|도|급","指|導|級") #ruby("인|사","人|士"), #ruby("신|사","紳|士")는 #ruby("신|식","新|式") #ruby("문|명","文|明")에 눈을 뜬 사람들을 #ruby("의|미","意|味")한다.]들을 #ruby("오|리|정","五|里|亭")에 #ruby("소|집","召|集")하고 기다리다가, #ruby("군|수","郡|守")가 #ruby("선|창","先|唱")하여 “#ruby("김|구","金|龜") #ruby("선|생","先|生") #ruby("만|세","萬|歲")”를 부르자 #ruby("군|중","群|衆")이 #ruby("제|창","齊|唱")했다. 나는 #ruby("전|군|수","全|郡|守")의 입을 막고 #ruby("망|발","妄|發") 말라고 하였다. 나는 그때까지 ‘#ruby("만|세","萬|歲")’ 두 글자는 #ruby("황|제","皇|帝")만의 #ruby("전|용","專|用") #ruby("축|사","祝|辭")요, #ruby("황|태|자","皇|太|子")에게는 ‘#ruby("천|세","千|歲")’라고 부르는 것으로 알았다. #ruby("전|군|수","全|郡|守")는 내 손을 잡으며 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김","金")#ruby("선|생","先|生"), #ruby("안|심","安|心")하시오. 내가 #ruby("선|생","先|生")을 #ruby("환|영","歡|迎")하며 #ruby("만|세","萬|歲")를 부르는 것은 #ruby("통|례","通|例")요, #ruby("망|발","妄|發")이 아닙니다. #ruby("친|구","親|舊") #ruby("상|호|간","相|互|間")에도 맞이하고 보낼 때 #ruby("만|세","萬|歲")를 부르는 터인즉, #ruby("안|심","安|心")하시고 #ruby("영|접","迎|接")하는 여러분과 #ruby("인|사","人|事")나 하시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("배|천|읍","白|川|邑")에서 #ruby("전|군|수","全|郡|守") #ruby("사|저","私|邸")에 머물면서 #ruby("각","各") #ruby("면","面") #ruby("두|민","頭|民")들과 #ruby("회|동","會|同")하고, #ruby("교|육|시|설","敎|育|施|設") #ruby("방|침","方|針")을 #ruby("협|의","協|議"), #ruby("진|행","進|行")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("전|봉|훈","全|鳳|薰")은 #ruby("본|시","本|是") #ruby("재|령","載|寧") #ruby("서|리|배","胥|吏|輩") #ruby("출|신","出|身")으로, #ruby("해|주|읍","海|州|邑")에서 #ruby("총|순","摠|巡")으로 여러 해 #ruby("근|무","勤|務")하며 #ruby("교|육","敎|育")을 #ruby("장|려","獎|勵")하였다. #ruby("해|주","海|州")에 #ruby("정|내|학|교","正|內|學|校")를 #ruby("설|립","設|立")하여 #ruby("야|학","夜|學")을 #ruby("권|장","勸|獎")할 때는, #ruby("시|내","市|內")의 #ruby("각","各") #ruby("점|포","廛|房") #ruby("사|환","使|喚")을 #ruby("야|학","夜|學")에 보내지 않는 #ruby("주|인","主|人")은 #ruby("처|벌","處|罰")하는 #ruby("등","等") #ruby("별|별","別|別") #ruby("수|단","手|段")을 #ruby("사|용","使|用")하여 #ruby("교|육","敎|育")에 많은 #ruby("업|적","業|績")을 남겼다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 뒤 #ruby("배|천","白|川") #ruby("군|수","郡|守")가 되어 그 #ruby("군|내","郡|內")에 #ruby("교|육|시|설","敎|育|施|設")을 열심히 #ruby("설|립","設|立")하였다. #ruby("전|군|수","全|郡|守")의 외아들은 일찍 죽고 #ruby("장|손","長|孫") #ruby("무|길","武|吉")이 5, 6#ruby("세","歲")였다. 그때 #ruby("왜","倭")놈이 #ruby("수|비|대","守|備|隊")나 #ruby("헌|병|대","憲|兵|隊")를 #ruby("군","郡")마다 #ruby("주|둔","駐|屯")시켜 #ruby("관|아","官|衙")를 빼앗았지만, 홀로 #ruby("배|천|군","白|川|郡")만은 #ruby("전|군|수","全|郡|守")가 #ruby("완|강","頑|强")히 #ruby("거|부","拒|否")하여 빼앗기지 않았다. 그러므로 #ruby("왜","倭")놈이 눈엣가시처럼 생각하여 #ruby("종|종","種|種") #ruby("곤|란","困|難")한 #ruby("교|섭","交|涉")이 많았으나, #ruby("전|씨","全|氏")의 #ruby("본","本")뜻은 #ruby("군|수","郡|守")를 #ruby("영|화","榮|華")로운 자리로 알아서가 아니요, #ruby("군|수","郡|守")의 #ruby("권|한","權|限")을 가지고 #ruby("교|육","敎|育")에 힘을 보태고자 함이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그는 #ruby("최|광|옥","崔|光|玉")을 #ruby("초|빙","招|聘")하여 #ruby("사|범|강|습|소","師|範|講|習|所")를 열고, #ruby("청|년","靑|年")을 #ruby("모|집","募|集")하여 #ruby("애|국|심","愛|國|心")을 #ruby("고|취","鼓|吹")시키기에 #ruby("전|력","專|力")했다. #ruby("최|광|옥","崔|光|玉")은 마침내 #ruby("배|천|읍","白|川|邑")에서 #ruby("강|연","講|演")하다가 피를 #ruby("토","吐")하며 죽고 말았다. #ruby("원|근","遠|近") #ruby("인|사","人|士")들은 온 마음과 #ruby("열|성","熱|誠")을 다하는 #ruby("청|년|지|사","靑|年|志|士")가 #ruby("중|도","中|途")에 #ruby("사|망","死|亡")한 것을 #ruby("애|도","哀|悼")하였다. #ruby("임|시","臨|時")로 #ruby("배|천|읍","白|川|邑") #ruby("남|산","南|山") 위 #ruby("학|교","學|校") #ruby("운|동|장","運|動|場") 곁에 #ruby("장|사","葬|事")지내고, #ruby("황|해","黃|海")·#ruby("평|안|도","平|安|道") #ruby("인|사","人|士")들이 #ruby("최|선|생","崔|先|生")의 #ruby("충|정","忠|貞")을 #ruby("영|원","永|遠")히 #ruby("기|념","紀|念")하기 #ruby("위","爲")해 #ruby("장|지","葬|地")를 #ruby("사|리|원","沙|里|院") #ruby("정|거|장","停|車|場") #ruby("근|처","近|處")로 #ruby("정","定")하고, #ruby("비|석","碑|石")은 #ruby("평|양","平|壤") #ruby("정|거|장","停|車|場")의 #ruby("이|토","伊|藤") #ruby("히로부미","博文") #ruby("기|념|비","紀|念|碑")보다 더 훌륭하게 세워, #ruby("왕|래","往|來")하는 사람들에게 #ruby("영|원","永|遠")한 #ruby("인|상","印|象")을 주기로 하였다. #ruby("안|태|국","安|泰|國")#footnote(numbering: _ => [24)])[#h(0.35em)#ruby[안|태|국][安|泰|國]\(1874〜1920). #ruby("평|남","平|南") #ruby("중|화","中|和") #ruby("출|신","出|身")으로, #ruby("안|창|호","安|昌|浩")가 세운 #ruby("평|양","平|壤") #ruby("대|성|학|교","大|成|學|校")의 #ruby("교|장","校|長")을 #ruby("역|임","歷|任")했다. 1907#ruby("년","年") #ruby("이|후","以|後") #ruby("신|민|회","新|民|會")에도 #ruby("참|여","參|與")하였으며, 105#ruby("인","人") #ruby("사|건","事|件")에 #ruby("연|루","連|累")되어 #ruby("백|범","白|凡")과 같이 #ruby("옥","獄")살이를 했다.]에게 #ruby("비|석","碑|石")의 #ruby("모|양","模|樣")까지 #ruby("정","定")하여 #ruby("평|양","平|壤")에서 #ruby("축|조","築|造")하도록 하였으나, #ruby("합|병|조|약","合|併|條|約")이 #ruby("체|결","締|結")되어 이를 이루지 못하였다. 그의 #ruby("유|해","遺|骸")는 아직 #ruby("배|천","白|川")에 그대로 묻혀 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("재|령","載|寧") #ruby("양|원|학|교","養|元|學|校")에서 #ruby("유|림","儒|林")들을 #ruby("소|집","召|集")하여 #ruby("교|육","敎|育")에 대한 #ruby("방|침","方|針")을 #ruby("토|의","討|議")한 #ruby("후","後") #ruby("장|연","長|淵")에 갔다. #ruby("군|수","郡|守") #ruby("이|씨","李|氏")가 #ruby("영|접","迎|接")하고서 #ruby("자|기","自|己") #ruby("관|할","管|轄") #ruby("각","各") #ruby("면","面")에 #ruby("훈|령","訓|令")을 보내 #ruby("김|구","金|龜") #ruby("선|생","先|生")의 #ruby("교|육|방|침","敎|育|方|針")을 #ruby("성|심","誠|心") #ruby("복|종","服|從")하라 하고, 나에게 #ruby("각","各") #ruby("면","面")을 #ruby("순|행","巡|行")하여 달라고 #ruby("간|청","懇|請")했다. #ruby("간|청","懇|請")을 물리치지 못하여 #ruby("읍|내","邑|內")에서 한 #ruby("차|례","次|例") #ruby("환|등|대|회","幻|燈|大|會")를 #ruby("개|최","開|催")하였는데, #ruby("수|천","數|千") #ruby("명","名")의 #ruby("남|녀|노|소","男|女|老|少")가 #ruby("회|집","會|集")하여 #ruby("성|황|리","盛|況|裡")에 치렀다. 이어 #ruby("순|택","蓴|澤")·#ruby("신|화","薪|化")#ruby("면","面") #ruby("등","等")으로 #ruby("순|회","巡|廻")하다가, #ruby("안|악|학|교","安|岳|學|校")의 #ruby("사|무","事|務")가 #ruby("급|박","急|迫")하여 되돌아왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("송|화","松|禾") #ruby("수|교","水|橋") #ruby("시|장","市|場")에 #ruby("도|착","到|着")하여 #ruby("시|내","市|內") #ruby("유|력|자","有|力|者")인 #ruby("감|승|무","甘|承|武") #ruby("등","等") 몇몇 #ruby("유|지","有|志")의 #ruby("요|청","要|請")에 #ruby("의","依")하여 #ruby("부|근","附|近") 대여섯 곳 #ruby("소|학|교","小|學|校")를 불러모아 #ruby("환|등|회","幻|燈|會")를 열었다. 떠나고자 할 즈음에 #ruby("송|화","松|禾") #ruby("군|수","郡|守") #ruby("성|낙|영","成|樂|英")이 #ruby("대|표","代|表")를 보내어,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("초|면","初|面")인 #ruby("장|연","長|淵") #ruby("군|수","郡|守")는 #ruby("인|사","人|事")만 하고도 #ruby("각","各") #ruby("면","面")을 #ruby("순|회","巡|廻")하며 #ruby("강|연","講|演")까지 해주고, #ruby("친","親")한 나는 찾아주지도 않고 지나가려느냐?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하며 #ruby("간|청","懇|請")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("군","郡") #ruby("세|무|소|장","稅|務|所|長")인 #ruby("구|자|록","具|滋|祿") #ruby("군","君")도 #ruby("교|육","敎|育")에 #ruby("열|심","熱|心")이 있는 탓으로 #ruby("친|숙","親|熟")한 터여서, #ruby("구|군","具|君")의 #ruby("초|청","招|請")까지 받아 #ruby("부|득|이","不|得|已") #ruby("송|화|군","松|禾|郡") #ruby("읍|내","邑|內")로 #ruby("향","向")했다. 이 #ruby("소|문","所|聞")을 접한 #ruby("성|낙|영","成|樂|英")은 #ruby("즉|시","卽|時") #ruby("각","各") #ruby("면","面")에 10#ruby("여","餘") 곳 #ruby("학|교","學|校")와 #ruby("군|내","郡|內") #ruby("유|지","有|志") #ruby("인|사","人|士")와 #ruby("부|인","夫|人"), #ruby("아|동","兒|童")까지 #ruby("소|집","召|集")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 몇 #ruby("년","年") 만에 #ruby("송|화|읍","松|禾|邑")의 #ruby("광|경","光|景")을 보았다. #ruby("해|서","海|西")#ruby("의|병","義|兵")을 #ruby("토|벌","討|伐")하던 #ruby("요|새","要|塞")인 #ruby("읍|내","邑|內") #ruby("관|사","官|舍")는 거의 #ruby("대|부|분","大|部|分") #ruby("왜","倭")가 #ruby("점|령","占|領")했다. #ruby("수|비|대","守|備|隊")·#ruby("헌|병|대","憲|兵|隊")·#ruby("경|찰|서","警|察|署")·#ruby("우|편|국","郵|便|局") #ruby("등","等") 여러 #ruby("기|관","機|關")이 꽉 들어차고, #ruby("개|인","個|人") 집을 #ruby("군|청","郡|廳")으로 하여 #ruby("근|무","勤|務")하는 #ruby("광|경","光|景")을 보고 #ruby("분","憤")한 마음이 머리끝까지 치밀었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("환|등|회","幻|燈|會")를 열었다. #ruby("대|황|제","大|皇|帝")#footnote(numbering: _ => [25)])[#h(0.35em)1897#ruby("년","年") #ruby("고|종","高|宗")은 #ruby("국|호","國|號")를 #ruby("대|한|제|국","大|韓|帝|國")으로 바꾸고 #ruby("위|호","位|號")를 #ruby("황|제","皇|帝")로 높였다.] #ruby("진|영","眞|影")이 나오자 나는 #ruby("일|동","一|同")에게 #ruby("기|립|국|궁","起|立|鞠|躬")#footnote(numbering: _ => [26)])[#h(0.35em)일어나 고개 숙여 #ruby("경|의","敬|意")를 #ruby("표","表")하는 것.]을 #ruby("명","命")하여 #ruby("한|인","韓|人") #ruby("관|민","官|民")은 물론이고 #ruby("왜","倭")놈 #ruby("장|교","將|領")와 #ruby("경|관","警|官") 무리까지 #ruby("국|궁","鞠|躬")을 시킨 #ruby("후","後") ‘#ruby("한|인","韓|人")이 #ruby("일|본","日|本")을 #ruby("배|척","排|斥")하는 #ruby("이|유","理|由")는 무엇인가’라는 #ruby("제|목","題|目")으로 #ruby("강|연","講|演")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("과|거","過|去") #ruby("러|일|전|쟁","露|日|戰|爭")·#ruby("중|일|전|쟁","中|日|戰|爭") 때만 해도 #ruby("한|인","韓|人")의 #ruby("일|본","日|本")에 대한 #ruby("감|정","感|情")이 #ruby("극","極")히 #ruby("우|호|적","友|好|的")이었으나 #ruby("그|후","其|後")에 #ruby("강|압|조|약","强|壓|條|約")이 #ruby("체|결","締|結")됨에 따라 나쁜 #ruby("감|정","感|情")이 #ruby("점|점","漸|漸") #ruby("격|증","激|增")하였다. 내가 #ruby("연|전","年|前")에 #ruby("문|화","文|化") #ruby("종|산","鍾|山")에서 #ruby("직|접","直|接") 겪은 #ruby("사|실","事|實")로, #ruby("일|본|군","日|本|軍")이 시골 마을에서 #ruby("약|탈","掠|奪")을 #ruby("감|행","敢|行")하는 것을 #ruby("목|도","目|覩")했는데, #ruby("일|본","日|本")의 이와 같은 나쁜 #ruby("행|위","行|爲")가 곧 #ruby("한|인","韓|人")의 #ruby("배|일|감|정","排|日|感|情")의 #ruby("원|인","原|因")이라고 큰소리로 꾸짖었다. 나란히 앉은 #ruby("성|낙|영","成|樂|英")·#ruby("구|자|록","具|滋|祿")을 보니 얼굴이 흙빛으로 바뀌었고 #ruby("왜","倭")놈들은 #ruby("노|기","怒|氣")가 #ruby("등|등","騰|騰")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[갑자기 #ruby("경|찰","警|察")이 #ruby("환|등|회","幻|燈|會")를 #ruby("해|산","解|散")하고 나를 #ruby("경|찰|서","警|察|署")로 데려갔다. #ruby("군|중","群|衆")은 #ruby("감","敢")히 말은 못하였지만 #ruby("분","憤")이 나 대단히 #ruby("격|앙","激|昂")한 #ruby("분|위|기","雰|圍|氣")였다. 나를 #ruby("경|찰|서","警|察|署")에 데리고 가서 #ruby("한|인","韓|人") #ruby("감|독","監|督") #ruby("순|사","巡|査")의 #ruby("숙|직|실","宿|直|室")에서 같이 묵게 하였다. 그러자 #ruby("각","各") #ruby("학|교","學|校")에서 #ruby("학|생","學|生")들이 #ruby("차|례|차|례","次|例|次|例")로 #ruby("방|문","訪|問")하기로 하고, #ruby("위|문|대","慰|問|隊")를 #ruby("조|직","組|織")하여 #ruby("연|속","連|續")하여 #ruby("위|문","慰|問")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[하룻밤을 자고 다음날에 #ruby("하|얼|빈","哈|爾|濱") #ruby("전|보","電|報")로, #ruby("이|토","伊|藤") #ruby("히로부미","博文")가 #ruby("한|인","韓|人") #ruby("은|치|안","安|應|七")에게 #ruby("피|살","被|殺")되었다는 #ruby("신|문","新|聞")을 보았다.#footnote(numbering: _ => [27)])[#h(0.35em)원주: “은치안 三字가 其時 新聞에 揭載된 것은 安應七이니 卽 安重根의 字가 應七임이라.” ‘은치안’은 아마도 ‘응칠안’의 #ruby("중|국|식","中|國|式") #ruby("발|음","發|音")인 ‘잉치안’일 것이다.] #ruby("은|치|안","安|應|七")이 누구인지를 몰라 매우 궁금하였는데, 다음날 아침에 #ruby("안|응|칠","安|應|七"), 곧 #ruby("안|중|근","安|重|根")으로 #ruby("명|백","明|白")하게 #ruby("신|문","新|聞")에 #ruby("기|재","記|載")되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때에야 나는 어렴풋하게나마 내가 #ruby("구|류","拘|留")당하는 #ruby("원|인","原|因")을 깨달았다. 그날 저녁 #ruby("환|등|회","幻|燈|會")에서 #ruby("일|본","日|本")놈을 꾸짖고 욕하였지만 이미 여러 곳에서 그랬는데 #ruby("하|필","何|必") #ruby("송|화","松|禾") #ruby("경|찰","警|察")이 나에게 손을 댄 것을 #ruby("이|상","異|常")하게 여겼다. 그리고 #ruby("구|류","拘|留")를 당한다 해도 며칠 #ruby("후","後")면 #ruby("훈|방","訓|放")될 것으로 알았는데, #ruby("하|얼|빈","哈|爾|濱") #ruby("사|건","事|件")에 #ruby("관|련","關|聯")되는 #ruby("혐|의","嫌|疑")라면 좀 길게 #ruby("고|생","苦|生")하리라 생각되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[며칠 #ruby("후","後") #ruby("평|범","平|凡")한 말 몇 마디를 #ruby("신|문","訊|問")하고서 #ruby("유|치|장","留|置|場")에서 한 달을 지내게 하더니 #ruby("해|주","海|州") #ruby("지|방|재|판|소","地|方|裁|判|所")로 #ruby("압|송","押|送")하였다. #ruby("수|교","水|橋") #ruby("감|승|무","甘|承|武") 집에서 #ruby("점|심","點|心")을 먹을 때, #ruby("시|내","市|內") #ruby("학|교","學|校") #ruby("직|원","職|員")과 #ruby("시","市") #ruby("유|지","有|志")들이 #ruby("일|제","一|齊")히 모여서 #ruby("호|송","護|送")하는 #ruby("왜|순|사","倭|巡|査")에게 #ruby("요|청","要|請")하였다. #ruby("김|구","金|龜") #ruby("선|생","先|生")은 우리 #ruby("교|육|계","敎|育|界") #ruby("사|표","師|表")이니, #ruby("위|로|연","慰|勞|宴")을 베풀고 한 #ruby("차|례","次|例") #ruby("대|접","待|接")하겠다는 것이었다. #ruby("순|사","巡|査")는 #ruby("후|일","後|日") #ruby("해|주","海|州") 다녀온 #ruby("후","後") 실컷 #ruby("위|로","慰|勞")하라며 #ruby("거|절","拒|絕")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("해|주","海|州")에 #ruby("도|착","到|着")한 #ruby("즉|시","卽|時") #ruby("투|옥","投|獄")되었다. 하룻밤을 지내고, #ruby("검|사","檢|事")가 #ruby("안|중|근","安|重|根")과의 #ruby("관|계","關|係")를 #ruby("질|문","質|問")하였다. 그러나 #ruby("이|전","以|前")에는 #ruby("안|중|근","安|重|根") 집안과 #ruby("각|별","各|別")한 #ruby("관|계","關|係")에 있었지만 이번의 #ruby("하|얼|빈","哈|爾|濱") #ruby("사|건","事|件")과는 아무런 #ruby("관|련","關|聯")이 없다는 것을 알고, #ruby("검|사","檢|事")는 『#ruby("김|구","金|龜")』라고 쓴 100#ruby("여","餘") 쪽의 #ruby("책|자","冊|子")를 내놓고 #ruby("신|문","訊|問")했다. 그 #ruby("책","冊")은 내가 #ruby("수|년|간","數|年|間") #ruby("각","各") #ruby("지|방","地|方")을 돌아다니며 #ruby("일|본","日|本") #ruby("관|헌","官|憲")과 #ruby("반|목","反|目")한 것에 대한 #ruby("경|찰","警|察")의 #ruby("보|고","報|告")를 모은 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("불|기|소","不|起|訴")로 풀려나자 나는 #ruby("행|장","行|裝")을 챙겨서 #ruby("박|창|진","朴|昌|鎭")의 #ruby("책|방","冊|房")에 갔다. 마침 #ruby("박|군","朴|君")과 만나 그#ruby("간","間")의 #ruby("경|과","經|過")를 이야기하고 있을 때, 곁에 있던 #ruby("유|훈|영","柳|薰|永") #ruby("군","君")이 #ruby("인|사","人|事")를 하더니, #ruby("자|기","自|己") #ruby("부|친","父|親")의 #ruby[회갑연][壽筵]에 함께 #ruby("참|석","參|席")하여 달라고 #ruby("요|청","要|請")했다. #ruby("수|연","壽|筵")을 맞은 #ruby("노|인","老|人")은 곧 #ruby("해|주","海|州") #ruby("부|호","富|豪") 가운데 한 사람인 #ruby("유|장|단","柳|長|湍")이었다. 그런데 #ruby("송|화","松|禾") #ruby("경|찰|서","警|察|署")에서 나를 #ruby("호|송","護|送")했던 #ruby("한","韓")·#ruby("일","日") #ruby("순|사","巡|査") 가운데 #ruby("한|인","韓|人") #ruby("순|사","巡|査")들은, 나를 #ruby("동|정","同|情")하는 사람들로 #ruby("사|건","事|件")의 #ruby("진|행","進|行")을 알고 싶어 떠나지 않고 있었다. #ruby("연|회","宴|會")를 마친 #ruby("후","後") 나는 #ruby("순|사","巡|査") #ruby("전|부","全|部")를 #ruby("음|식|점","飮|食|店")으로 불러서 #ruby("경|과","經|過")를 말해 주고 되돌아가도록 했다.]
