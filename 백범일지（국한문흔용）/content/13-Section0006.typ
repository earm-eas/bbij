#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“옳지, 저 #ruby[신참수][新囚]도 #ruby("국|사|범","國|事|犯") #ruby("강|도","強|盜")인가 보다. 3#ruby("일","日") #ruby("전","前") 『#ruby("대|한|매|일|신|보","大|韓|每|日|申|報")』 #ruby("사|장","社|長") #ruby("양|기|탁","梁|起|鐸")이란 #ruby[신참수][新囚]가 들어왔고, 그 #ruby("공|범","共|犯")으로 #ruby("유|명","有|名")한 #ruby("신|사","紳|士") 여러 #ruby("명","名")이 #ruby("역","役")을 졌다고 아무개 #ruby("간|수","看|守") 나리가 말씀하더라. 그러면 저 #ruby[신참수][新囚]도 #ruby("신|사","紳|士")이므로 우리가 묻는 말에 #ruby("대|답","對|答")도 잘 아니하는가 보군. 아니꼬운 놈, 나도 #ruby[허왕산][旺山]#footnote(numbering: _ => [80)])[#h(0.35em)#ruby("구|한|말","舊|韓|末") #ruby("저|명","著|名")한 #ruby("의|병|장","義|兵|將") #ruby[허|위][許|蔿]\(1855〜1908)의 #ruby("호","號"). #ruby[허|위][許|蔿]는 1907#ruby("년","年") #ruby("정|미","丁|未") 7#ruby("조|약","條|約")과 #ruby("강|제|적","強|制|的")인 #ruby("군|대","軍|隊") #ruby("해|산","解|散")에 #ruby("반|대","反|對")하여 #ruby("의|병","義|兵")을 일으켜 서울 #ruby("진|공|작|전","進|攻|作|戰")을 세웠다가 #ruby("실|패","失|敗")하고, 1908#ruby("년","年") 6#ruby("월","月") #ruby("체|포","逮|捕")되어 10#ruby("월","月") 21#ruby("일","日") #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 #ruby("처|형","處|刑")되었다.] 밑의 #ruby("당|당","堂|堂")한 #ruby("참|모|장","參|謀|長")이야. 여기서 #ruby("교|만","驕|慢")을 부려봐야 #ruby("소|용","所|用")없다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 처음에 그 #ruby("자","者")들을 #ruby("하|등","下|等") #ruby("잡|범","雜|犯")들로만 알았다가, #ruby("허|위","許|蔿")의 #ruby("부|하","部|下")라는 말을 듣고서는 #ruby("심","甚")히 #ruby("통|탄","痛|歎")하였다. 저런 #ruby("자","者")가 #ruby("참|모|장","參|謀|長")이었으니, #ruby("허|위","許|蔿") #ruby("선|생","先|生")이 #ruby("실|패","失|敗")하였을 것은 불 보듯 #ruby[뻔한][明若觀火] 것 아닌가.#footnote(numbering: _ => [81)])[#h(0.35em)#ruby("매|천","梅|泉") #ruby("황|현","黃|玹")도 “#ruby("의|병","義|兵")에 #ruby("도|적|배","盜|賊|輩")와 다름없는 이들이 많다”고 #ruby("개|탄","慨|歎")한 바 있다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|중","獄|中")에 #ruby("전","傳")해오는 이야기가 있었다. #ruby("이|강|년","李|康|秊")#footnote(numbering: _ => [82)])[#h(0.35em)#ruby[이|강|년][李|康|秊]\(1858〜1908). #ruby("호","號")는 #ruby("운|강","雲|崗"). #ruby("고|종","高|宗") 17#ruby("년","年")\(1880) #ruby("무|과","武|科")에 #ruby("급|제","及|第")하였다가 #ruby("갑|신|정|변","甲|申|政|變")이 일어나자 #ruby("낙|향","落|鄕")하였고, 1895#ruby("년","年") #ruby("문|경","聞|慶")에서 #ruby("의|병","義|兵")을 일으켜 #ruby("탐|관|오|리","貪|官|汚|吏")를 #ruby("처|단","處|斷")했다. 1897#ruby("년","年") #ruby("만|주","滿|洲")에서 #ruby("의|병","義|兵")을 #ruby("모|집","募|集")하여 #ruby("왜|적","倭|賊")과 싸우고, 1905#ruby("년","年") #ruby("을|사|조|약","乙|巳|條|約") #ruby("이|후","以|後") 다시 #ruby("봉|기","蜂|起")하였으며, 1907#ruby("년","年") #ruby("군|대","軍|隊") #ruby("해|산","解|散") #ruby("후","後") #ruby("민|긍|호","閔|肯|鎬") #ruby("부|대","部|隊")와 #ruby("공|동|작|전","共|同|作|戰")으로 큰 #ruby("전|공","戰|功")을 세웠다. 서울 #ruby("진|공|계|획","進|攻|計|劃")을 세웠다가 #ruby("청|풍","淸|風") #ruby("금|수|산|전|투","金|水|山|戰|鬪")에서 #ruby("체|포","逮|捕")되어, 1908#ruby("년","年") #ruby("사|형","死|刑")당했다.] #ruby("선|생","先|生")과 #ruby("허|위","許|蔿") #ruby("선|생","先|生")은 #ruby("왜|적","倭|賊")에게 #ruby("체|포","逮|捕")되어, #ruby("신|문","訊|問")과 #ruby("재|판","裁|判")을 받지 않고 #ruby("사|형","死|刑")당하시기까지 #ruby("왜|적","倭|賊")을 더럽게 여기며 꾸짖다가 #ruby("순|국","殉|國")하셨는데, 그#ruby("후","後") #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 #ruby("사|용","使|用")하던 #ruby("자|래|정","自|來|井")이 #ruby("허|위","許|蔿") #ruby("선|생","先|生") #ruby("사|형|일","死|刑|日")로부터 우물물이 벌겋게 흐려져 #ruby("폐|정","廢|井")되었다는 것이다.]
