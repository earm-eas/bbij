#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("지|방|경|찰","地|方|警|察")의 #ruby("시|각","視|角")이 너무 #ruby("협|소","狹|小")하여 걸핏하면 #ruby("일|본","日|本")을 #ruby("배|척","排|斥")하느니 뭐니 하면서 #ruby("교|육|사|업","敎|育|事|業")에 #ruby("방|해","妨|害")가 많으니 #ruby("이|후","以|後") #ruby("지|방|경|찰","地|方|警|察")을 #ruby("주|의","注|意")시켜 우리 같은 사람들이 #ruby("교|육","敎|育")이나 잘 하도록 하여 달라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("학|교","學|校") #ruby("개|학","開|學") #ruby("시|기","時|期")가 이미 지났으니 #ruby("속","速")히 내려가 #ruby("학|교","學|校") #ruby("개|학","開|學")이나 하게 하라.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 하였다. #ruby("와타나베","渡邊") 놈은 #ruby("고|문","拷|問")도 하지 않고 그저 #ruby("유|치|장","留|置|場")으로 보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("국|모|보|수","國|母|報|讐") #ruby("사|건","事|件")은 #ruby("비|밀","祕|密")이 아니고 #ruby("세|상","世|上")이 다 아는 #ruby("공|공|연","公|公|然")한 #ruby("사|실","事|實")이다. #ruby("왜","倭")놈들이 #ruby("각","各") #ruby("경|찰|기|관","警|察|機|關")에 #ruby("주|의|인|물","注|意|人|物")로 붉은 줄을 긋고 나의 온갖 #ruby("행|동","行|動")을 #ruby("조|사","調|査")했으니, #ruby("해|주","海|州") #ruby("검|사|국","檢|事|局")에 #ruby("비|치","備|置")한 『#ruby("김|구","金|龜")』라는 #ruby("책|자","冊|子")에도 반드시 #ruby("쓰치다","土田")를 죽인 #ruby("사|실","事|實")이 #ruby("기|재","記|載")되었으리라 생각했고, 이번에 #ruby("총|감|부","總|監|府") #ruby("경|시","警|視") 한 #ruby("명","名")이 #ruby("안|악","安|岳")에 #ruby("출|장","出|張") #ruby("조|사","調|査")까지 하였으니, 그 #ruby("사|실","事|實")이 #ruby("발|각","發|覺")된다면 내 #ruby("일|생","一|生")은 여기서 끝이라고 생각하였다. #ruby("와타나베","渡邊") 놈이 썩 들어서면서 내 가슴에 X#ruby("광|선","光|線")을 비췄으니 #ruby("과|거","過|去")를 다 알고 있노라고 할 때, ‘#ruby("인|천","仁|川") #ruby("사|건","事|件")은 피할 수 없다’고 생각하면서도, 그놈의 X#ruby("광|선","光|線")을 #ruby("시|험","試|驗")해 보자는 생각이 들었던 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("와타나베","渡邊") 놈이 그 #ruby("사|실","事|實")을 알면서 #ruby("후|일","後|日")을 #ruby("위","爲")해 일부러 남겨두고 다른 말만 묻는 것이 아니란 #ruby("사|실","事|實")은, 그놈이 #ruby("신|문","訊|問")할 때 X#ruby("광|선","光|線") #ruby("운|운","云|云")하며 나의 #ruby("과|거","過|去")와 #ruby("현|재","現|在")를 잘 아는 듯 #ruby("표|시","表|示")를 내려고 애쓰는 것을 보아서도 잘 알 수 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러고 보니 #ruby("국|가","國|家")는 #ruby("망","亡")하였으나 #ruby("인|민","人|民")은 #ruby("망","亡")하지 않았다고 생각된다. 나는 #ruby("평|소","平|素") 우리 #ruby("한|인","韓|人")의 #ruby("정|탐","偵|探")을 몹시 미워해서 #ruby("여|지","餘|地")없이 #ruby("공|격","攻|擊")하곤 했는데, 나에게 #ruby("공|격","攻|擊")을 받은 #ruby("정|탐|배","偵|探|輩")까지도, #ruby("자|기","自|己")가 잘 아는 그 #ruby("사|실","事|實")만은 #ruby("밀|고","密|告")를 하지 않고 #ruby("왜","倭")놈에 #ruby("대","對")하여 #ruby("비|밀","祕|密")을 지켜준 것이 아닌가.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다른 사람은 #ruby("물|론","勿|論")이고, 나의 #ruby("제|자","弟|子")로서 #ruby("형|사","刑|事")가 된 #ruby("김|홍|식","金|弘|植")과, 같은 #ruby("학|교","學|校") #ruby("직|원","職|員")으로 있던 #ruby("원|인|상","元|仁|常") #ruby("등","等")부터 #ruby("밀|고","密|告")하지 않은 것이니, 그러고 보면 #ruby("각|처","各|處") #ruby("한|인","韓|人") #ruby("형|사","刑|事")와 #ruby("고|등|정|탐","高|等|偵|探")까지도 그 #ruby("양|심","良|心")에 #ruby("애|국|심","愛|國|心")이 조금이나마 남아 있는 것이 아닌가.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("사|회","社|會")에서 나를 이같이 #ruby("동|정","同|情")해 주었으니 나로서는 #ruby("최|후","最|後")의 한 숨까지 #ruby("동|지","同|志")를 #ruby("위","爲")하여 #ruby("분|투","奮|鬪")하고 #ruby("원|수","怨|讐")의 #ruby("요|구","要|求")에 #ruby("응","應")하지 않으리라 #ruby("결|심","決|心")하였다. 그리고 #ruby("김|홍|량","金|鴻|亮")은 여러 가지로 #ruby("활|동","活|動")할 #ruby("능|력","能|力")과 #ruby("품|격","品|格")이 나보다 나으니, #ruby("신|문","訊|問") 받을 때 이롭도록 말을 하여 그를 풀어주게 하리라. 그렇게 생각하여 “#ruby[거북이][龜]는 진흙 속에 빠지리니 #ruby[기러기][鴻]는 #ruby("해|외","海|外")로 날으라”#footnote(numbering: _ => [55)])[#h(0.35em)여기서 #ruby[거북][龜]은 #ruby("김|구","金|龜")를, #ruby[기러기][鴻]는 #ruby("김|홍|량","金|鴻|亮")을 #ruby("비|유","比|喩")한 것.]라는 #ruby("구","句")를 혼자 읊었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[일곱 #ruby("번","番") #ruby("신|문","訊|問")에서 #ruby("와타나베","渡邊") 놈만 #ruby("혹|형","酷|刑")을 가하지 않았고, 여섯 #ruby("번","番")은 #ruby("매|번","每|番") #ruby("정|신","精|神")을 잃은 #ruby("후","後")에야 #ruby("유|치|장","留|置|場")에 끌려왔다. 끌려올 때 #ruby("각","各") #ruby("방","房") #ruby("동|지","同|志")들의 #ruby("정|신","精|神")을 북돋아 주기 #ruby("위","爲")하여 “나의 #ruby("생|명","生|命")은 빼앗을 수 있거니와 내 #ruby("정|신","精|神")은 빼앗지 못하리라” 말하면, #ruby("왜","倭")놈들은 “나쁜 말이 해소데 타타쿠”#footnote(numbering: _ => [56)])[#h(0.35em)우리말과 #ruby("일|본","日|本")말이 #ruby("혼|합","混|合")된 #ruby("문|장","文|章"). 타타쿠(たたく)는 ‘때리다’라는 뜻. #ruby("즉","卽") 위 #ruby("문|장","文|章")은 ‘나쁜 말을 했지. 때려줄 거야’라는 #ruby("의|미","意|味")이다.]라고 #ruby("위|협","威|脅")하였지만 내 말을 들은 #ruby("동|지","同|志")들은 #ruby("견|고","堅|固")한 마음을 가지는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[여덟#ruby("번","番")째 #ruby("신|문","訊|問")에는 #ruby("각","各") #ruby("과|장","課|長")과 #ruby("주|임","主|任") #ruby("경|시","警|視") 7, 8#ruby("명","名")이 나란히 앉아 #ruby("위|협","威|脅")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“너의 #ruby("동|류","同|類")가 #ruby("대|부|분","大|部|分") #ruby("자|백","自|白")하였거늘 너 한 놈이 #ruby("자|백","自|白")을 않으니 #ruby("심","甚")히 어리석고 #ruby("완|고","頑|固")하다. #ruby("토|지","土|地")를 사들인 #ruby("지|주","地|主")가 논밭의 뭉우리돌을 골라내는 것은 #ruby("당|연","當|然")한 일 아니냐? 네가 아무리 입을 다물고 혀를 묶어 한마디도 #ruby("발|설","發|說")하지 않으려 하지만, 여러 놈의 입에서 네 #ruby("죄","罪")가 #ruby("발|각","發|覺")되었으니, #ruby("지|금","只|今") #ruby("당|장","當|場") 말하지 않으면 이 자리에서 때려죽이리라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나를 논밭의 자갈돌로 알고 파내려는 그대들의 #ruby("노|고","勞|苦")보다, 파내어지는 나의 #ruby("고|통","苦|痛")이 더욱 #ruby("심","甚")하니 내가 #ruby("자|결","自|決")하는 것을 보라!”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 머리를 기둥에 들이받고 #ruby("정|신","精|神")을 잃고 쓰러졌다. 여러 놈들이 #ruby("인|공|호|흡","人|工|呼|吸")을 하고 얼굴에 #ruby("냉|수","冷|水")를 끼얹어서 #ruby("정|신","精|神")이 돌아왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한 놈이 능청스럽게 #ruby("부|탁","付|託")한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")는 #ruby("조|선|인","朝|鮮|人") #ruby("중","中")에서 #ruby("신|앙","信|仰")을 받는 #ruby("인|물","人|物")인데, 이같이 #ruby("대|우","待|遇")를 하는 것이 #ruby("적|당","適|當")하지 않으니 저에게 #ruby("위|임","委|任")하여 #ruby("신|문","訊|問")하게 하옵소서.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그는 #ruby("즉|시","卽|時") #ruby("승|낙","承|諾")을 얻어가지고 나를 #ruby("자|기","自|己") #ruby("방","房")에 데리고 가서 #ruby("특|별","特|別") #ruby("대|우","待|遇")를 했다. 담배도 주고 말도 #ruby("존|대","尊|待")하며, #ruby("자|기","自|己")가 #ruby("황|해|도","黃|海|道")에 #ruby("출|장","出|張") 가서 #ruby("김|구","金|龜")의 온갖 #ruby("행|동","行|動")을 #ruby("일|일","一|一")이 #ruby("조|사","調|査")하여 보니, #ruby("교|육|사|업","敎|育|事|業")에 #ruby("열|성","熱|誠")인 것은 #ruby("학|교","學|校")에서 #ruby("월|급","月|給")을 받든 못 받든 #ruby("교|무","校|務")를 한결같이 보아온 것으로 알 수 있다는 둥, #ruby("일|반","一|般") #ruby("인|민","人|民")의 #ruby("여|론","輿|論")을 들어보아도 #ruby("정|직","正|直")한 사람인데 #ruby("총|감|부","總|監|府")에 와서 #ruby("김|구","金|龜")의 #ruby("신|분","身|分")을 모르는 사람들에게 #ruby("고|문","拷|問")도 많이 당한 #ruby("모|양","模|樣")이니 매우 #ruby("유|감","遺|憾")이라는 둥, #ruby("신|문","訊|問")도 #ruby("순","順")하게 하여야 #ruby("사|실","事|實")을 말하는 사람이 있고 #ruby("고|문","拷|問")해야 할 사람이 따로 있는데 #ruby("김|구","金|龜")에게는 #ruby("실|례","失|禮")가 많았다는 둥 하며, 능청스럽게 말을 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈이 #ruby("신|문","訊|問")하는 #ruby("방|법","方|法")에는 #ruby("대|략","大|略") 세 가지 #ruby("수|단","手|段")이 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[첫째, #ruby("가|혹","苛|酷")한 #ruby("고|문","酷|刑")이다. 채찍과 몽둥이로 #ruby("난|타","亂|打")하는 것, 두 손을 등 뒤에 포개고 오랏줄로 #ruby("결|박","結|縛")하여 #ruby("천|장","天|障")의 쇠고리에 끌어올리고서, #ruby("심|문","訊|問")받는 자를 둥근 걸상 위에 세웠다가 오랏줄 한 끝을 한편에 잡아매고 발#ruby("판","板")을 뽑아버리면 온몸이 #ruby("공|중","空|中")에 매달려 #ruby("질|식","窒|息")하게 되는데, #ruby("그|후","其|後") #ruby("결|박","結|縛")을 풀고 #ruby("냉|수","冷|水")를 온몸에 끼얹어 숨이 돌아오게 하는 것, #ruby("화|로","火|爐")에 쇠막대기를 #ruby("즐|비","櫛|比")하게 늘어놓아 벌겋게 달군 #ruby("후","後") 그 쇠막대기로 온몸을 함부로 지지는 것, 손가락 크기의 #ruby("능|목","菱|木")#footnote(numbering: _ => [57)])[#h(0.35em)마름모꼴의 나무.] 세 #ruby("개","個")를 세 손가락 사이에 끼우고 나무 #ruby("양","兩")끝을 노끈으로 동여매는 것, 거꾸로 매단 #ruby("후","後") 콧구멍에 #ruby("냉|수","冷|水")를 부어넣는 것 #ruby("등","等")이 그것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[둘째, 굶기는 것이다. #ruby("신|문","訊|問")할 때 #ruby("음|식","飮|食")을 #ruby("보|통","普|通") #ruby("수|인","囚|人")의 #ruby("반","半")으로 줄여 #ruby("생|명","生|命")만 #ruby("유|지","維|持")하게 해놓고, #ruby("친|척","親|戚")이 #ruby("사|식","私|食")을 #ruby("청|원","請|願")하여도 #ruby("신|문","訊|問") #ruby("주|임","主|任")의 #ruby("허|가","許|可")를 얻지 못하면 도로 내보낸다. #ruby("신|문","訊|問") #ruby("주|임","主|任") 되는 놈은, #ruby("사|실","事|實") #ruby("유|무","有|無")는 #ruby("관|계","關|係")치 않고 거짓말이라도 #ruby("왜","倭")놈들이 좋아할 만한 말을 하는 #ruby("수|인","囚|人")에게는 #ruby("사|식","私|食")을 #ruby("허|락","許|諾")하고, #ruby("반|항|성","反|抗|性")이 있어 보이면 #ruby("절|대","絶|對")로 #ruby("허|가","許|可")하지 않는다. 그래서 #ruby("유|치|장","留|置|場")에서는 #ruby("자|연","自|然")히 #ruby("사|식","私|食")을 받아먹는 #ruby("자","者")는 #ruby("강|경","强|硬")치 못해 보이게 된다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그밖에 한 가지가 #ruby("온|화","溫|和")한 #ruby("수|단","手|段")이다. 좋은 #ruby("음|식","飮|食")도 #ruby("대|접","待|接")하고 훌륭히 #ruby("장|식","裝|飾")한 #ruby("아카시","明石")#footnote(numbering: _ => [58)])[#h(0.35em)#ruby("원|주","原|註"): “當時 總監部 總長”. #ruby("아카시","明石元二郞")는 #ruby("내|정|간|섭","內|政|干|涉")과 쿠데타 #ruby("공|작","工|作")의 #ruby("전|문|가","專|門|家"). #ruby("당|시","當|時") #ruby("경|무|총|감","警|務|總|監")으로 #ruby("데라우치","寺內") #ruby("총|독","總|督") #ruby("암|살|모|의","暗|殺|謀|議") #ruby("사|건","事|件")을 #ruby("조|작","造|作")하여 #ruby("애|국","愛|國") #ruby("인|사","人|士")들을 #ruby("체|포","逮|捕")·#ruby("고|문","拷|問")한 #ruby("장|본|인","張|本|人")이다.]의 #ruby("방","房")으로 데려가 #ruby("극|진","極|盡")히 #ruby("공|경","恭|敬")하며 점잖게 #ruby("대|우","待|遇")하는 바람에, #ruby("가|혹","苛|酷")한 #ruby("고|문","拷|問")을 참아낸 #ruby("자","者")도 그 자리에서 #ruby("실|토","實|吐")한 사람이 더러 있다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("신|체","身|體") #ruby("고|문","體|刑")에는 한두 #ruby("번","番") 참아보았고, 저놈이 #ruby("발|악","發|惡")을 하면 나도 #ruby("감|정","感|情")이 #ruby("발","發")하여 #ruby("자|연","自|然") #ruby("저|항|력","抵|抗|力")이 생기므로 #ruby("인|내","忍|耐")하였지만, 둘째와 셋째를 당하여 참아내기는 #ruby("지|극","至|極")히 어려웠다. 두#ruby("번","番")째는 굶주림이니, 처음엔 밥이라야 껍질 #ruby("절|반","折|半") 모래 #ruby("절|반","折|半")에 #ruby("반|찬","飯|饌")은 소금이나 쓴 장아찌 꽁댕이를 주는데, #ruby("구|미","口|味")가 없어서 안 먹고 도로 보내기도 하였다. #ruby("그|후","其|後")에는 죽도록 맞은 날이 아니면 그런 밥이라도 기다려서 달게 먹는다. 그때까지 #ruby("근","近") 석 달 동안 아내는 #ruby("매|일","每|日") 아침저녁으로 밥을 가지고 #ruby("유|치|장","留|置|場") 앞에 와서 말소리가 들리도록 목소리를 높여,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")의 밥을 가지고 왔으니 들여주시오.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[한다. 그러면 #ruby("왜","倭")놈이,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“김가메#footnote(numbering: _ => [59)])[#h(0.35em)가메는 #ruby[거북][龜]의 #ruby("일|본|식","日|本|式") #ruby("발|음","發|音").] 나쁜 말이 했소데. #ruby("사|식","私|食")이레 일이 없소다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("매|번","每|番") 돌려보낸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("신|체","身|體")가 더욱 말이 아니었다. 그놈들이 달아매고 때릴 때는, #ruby("박|태|보","朴|泰|輔")가 보습 단근질 당할 때에 “이 쇠가 식었으니 다시 달구어 오라”고 한 #ruby("구|절","句|節")을 #ruby("암|송","暗|誦")하였다. 겨울철이라 그리하는지 겉옷만 벗기고 #ruby("양|직","洋|織") 속옷은 입힌 채로 #ruby("결|박","結|縛")하고 때릴 때,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“속옷을 입어서 아프지 않으니 속옷을 다 벗고 맞겠다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[며 #ruby("매|번","每|番") 알몸으로 매를 받아서, 살이 벗겨질 뿐 아니라 #ruby("온|전","穩|全")한 살가죽이라곤 없었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런 때 다른 사람들이 #ruby("문|전","門|前")에서 #ruby("사|식","私|食")을 먹으면, 고깃국과 김치 냄새가 코에 들어와서 미칠 듯이 먹고 싶어진다. #ruby("매|일","每|日") 아침저녁으로 #ruby("음|식","飮|食") 냄새가 코에 들어올 때마다, 나도 남에게 #ruby("해","害")가 될 말이라도 하고서 가져오는 밥이나 다 받아 먹을까, 또한 아내가 나이 젊으니 몸이라도 팔아서 좋은 #ruby("음|식","飮|食")이나 늘 하여다 주면 좋겠다 하는 더러운 생각이 난다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("박|영|효","朴|泳|孝")의 #ruby("부|친","父|親")#footnote(numbering: _ => [60)])[#h(0.35em)#ruby[박|원|양][朴|元|陽]\(1804〜1884). #ruby("갑|신|정|변","甲|申|政|變")이 #ruby("실|패","失|敗")하고 난 뒤 그는 아들의 #ruby("죄","罪")에 #ruby("연|루","連|累")되어 #ruby("직|위","職|位")를 #ruby("박|탈","剝|奪")당하고 #ruby("감|옥","監|獄")에서 죽었다.]이 #ruby("옥","獄")에서 섬거적을 뜯어먹다가 죽었다는 말, #ruby("소|무","蘇|武")가 #ruby("전|모","氈|毛")를 씹으며 19#ruby("년","年") 동안 #ruby("한","漢")나라에 대한 #ruby("절|의","節|義")를 지켰다#footnote(numbering: _ => [61)])[#h(0.35em)#ruby("소|무","蘇|武")는 #ruby("중|국","中|國") #ruby("전|한","前|漢")의 #ruby("명|신","名|臣")으로, #ruby("무|제","武|帝") 때 #ruby("사|신","使|臣")으로서 #ruby("흉|노","匈|奴")에 갔다가 그곳에 19#ruby("년|간","年|間") #ruby("유|폐","幽|閉")되었다. 그는 #ruby("극|심","極|甚")한 굶주림으로 옷의 #ruby("솜|털","氈|毛")과 들쥐·풀씨 #ruby("등","等")으로 #ruby("연|명","延|命")하다 끝내 살아 #ruby("귀|국","歸|國")하였다. #ruby("한","漢")의 #ruby("소|제","昭|帝")는 그의 #ruby("절|개","節|槪")를 기리어 벼슬을 내렸고, #ruby("후|세","後|世") 사람들은 그와 같은 #ruby("절|개","節|槪")를 #ruby("특|별","特|別")히 #ruby("소|무|절","蘇|武|節")이라 한다.]는 글과, #ruby("전","前")날에 알몸으로 #ruby("고|초","苦|楚")를 받던 일을 생각했다. “나의 #ruby("육|체","肉|體")를 욕보일 수 있을지언정 나의 #ruby("정|신","精|神")은 뺏을 수 없다”고 같이 #ruby("수|감","收|監")된 #ruby("동|지","同|志")들에게 #ruby("주|창","主|唱")하던 #ruby("기|개","氣|槪")와 #ruby("절|개","節|槪")를 생각하면서, 이러다가 #ruby("인|간","人|間")의 #ruby("본|성","本|性")은 사라져 없어지고 짐승의 #ruby("본|능","本|能")만 남는 것이 아닐까 #ruby("자|책","自|責")하던 때, #ruby("아카시","明石")의 #ruby("방","房")에서 나를 #ruby("극|진","極|盡")히 #ruby("우|대","優|待")를 하면서 #ruby("신|문","訊|問")한 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그놈의 #ruby("요|령","要|領")으로 보면 #ruby("신|부|민","新|附|民")의 #ruby("자|격","資|格")만 #ruby("표|시","表|示")하면#footnote(numbering: _ => [62)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “그놈의 #ruby("요|령","要|領")으로 보면, #ruby("식|민","植|民") #ruby("백|성","百|姓")이라 #ruby("인|정","認|定")하기만 하면”.] #ruby("즉|각","卽|刻") #ruby("총|독","總|督")에게 #ruby("보|고","報|告")하여 이와 같은 #ruby("고|통","苦|痛")도 #ruby("면","免")하게 할 뿐 아니라, #ruby("순","純") #ruby("일|본|인","日|本|人")만으로 #ruby("조|선","朝|鮮")을 #ruby("통|치","統|治")하는 것이 아니라 #ruby("덕|망","德|望")이 있는 #ruby("조|선|인","朝|鮮|人")을 #ruby("정|치","政|治")에 #ruby("참|여","參|與")시키려 하기 때문에 #ruby("당|신","當|身")같이 #ruby("충|후","忠|厚")한 사람이 #ruby("정|세","情|勢")의 #ruby("추|이","推|移")를 모르지 않을 터인즉 #ruby("순|응","順|應")함이 어떠하냐 하면서, #ruby("안|명|근","安|明|根") #ruby("사|건","事|件")과 #ruby("서|간|도","西|間|島") #ruby("사|건","事|件")을 #ruby("실|토","實|吐")하라 했다. 나의 #ruby("대|답","對|答")은, #ruby("당|신","當|身")이 나의 #ruby("충|후","忠|厚")를 #ruby("인|정","認|定")한다면 내가 #ruby("진|술","陳|述")한 것을 #ruby("인|정","認|定")하라는 것이었다. 그놈은 아주 점잖고 #ruby("예|의","禮|儀") 있는 모습이었지만 나의 말에 좋지 않은 #ruby("기|색","氣|色")을 보이면서 돌려보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 오늘 처음에는 당장 쳐죽인다고 #ruby("발|악","發|惡")하던 끝에 이놈에게 끌려왔는데, 이놈은 #ruby("구니토모","國友") #ruby("경|시","警|視")#footnote(numbering: _ => [63)])[#h(0.35em)#ruby("일|제","日|帝") 때 #ruby("지|금","只|今")의 #ruby("총|경","總|警")에 #ruby("해|당","該|當")하는 #ruby("경|찰|관","警|察|官") #ruby("직|위","職|位").]였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“내가 #ruby("이|전","以|前")에 #ruby("대|만|인","台|灣|人") #ruby("범|죄|자","犯|罪|者") 한 #ruby("명","名")을 맡아 #ruby("신|문","訊|問")하였는데, #ruby("지|금","只|今")의 #ruby("김|구","金|龜")와 같이 #ruby("고|집","固|執")하다가 ‘#ruby("검|사|국","檢|事|局")에 가서 #ruby("일|체","一|體")를 #ruby("자|백","自|白")하였노라’는 #ruby("편|지","便|紙")를 받았다. #ruby("김|구","金|龜")도 이제는 #ruby("검|사|국","檢|事|局")으로 넘어갈 터이니, 거기 가서 #ruby("사|실","事|實")을 말하면 더욱 #ruby("검|사","檢|事")의 #ruby("동|정","同|情")을 받을 수 있을 것이다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그는 #ruby("전|화","電|話")로 국수 장국밥에 고기를 많이 가져오라고 하여, 내 앞에 놓고 먹기를 #ruby("청","請")했다. 나는 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신이 나를 #ruby("무|죄","無|罪")로 #ruby("인|정","認|定")한다면 음식을 먹지만, #ruby("유|죄","有|罪")라 하면 먹지 않을 것이다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")는 #ruby("한|문|병|자","漢|文|病|者")#footnote(numbering: _ => [64)])[#h(0.35em)#ruby("자|세","仔|細")한 #ruby("의|미","意|味")는 알 수 없지만, 아마도 #ruby("백|범","白|凡")이 #ruby("일|어","日|語")를 배우지 않아 #ruby("한|문","漢|文")으로 #ruby("문|답","問|答")한 데서 나온 #ruby("표|현","表|現")이라 생각된다.]이다. #ruby("김|구","金|龜")는 지금껏 나에게 #ruby("동|정","同|情")을 아니하였으나, 나는 #ruby("자|연","自|然") #ruby("동|정","同|情")할 마음이 생겨서 변변치 못하나 #ruby("대|접","待|接")하는 것이니 식기 #ruby("전","前")에 먹으라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 한결같이 #ruby("사|양","辭|讓")하였다. #ruby("구니토모","國友")는 웃으면서 #ruby("한|자","漢|字")로 ‘#ruby("군|의|치|독|부","君|疑|置|毒|否")’#footnote(numbering: _ => [65)])[#h(0.35em)‘그대는 #ruby("독","毒")을 넣지나 않았을까 #ruby("의|심","疑|心")하는가?’라는 뜻.] 다섯 #ruby("자","字")를 써 보이고, 이제부터는 #ruby("사|식","私|食") 들이는 것을 #ruby("허|락","許|諾")하며 #ruby("신|문","訊|問")도 #ruby("종|결","終|結")되었다고 한다. 나는 “#ruby("독","毒")을 넣었는가 #ruby("의|심","疑|心")한 것은 아니다” 하고 먹고 돌아오니 저녁부터 #ruby("사|식","私|食")이 들어왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[같은 #ruby("방","房")에 있는 #ruby("이|종|록","李|宗|錄")은 나이가 적은 #ruby("청|년","靑|年")이었다. #ruby("친|척","親|戚") 가운데 따라온 사람이 없으므로 #ruby("사|식","私|食")을 가져다 줄 사람도 없었다. #ruby("방","房")안에서 먹으면 나누어 먹게 하겠으나, #ruby("사|식","私|食")은 반드시 #ruby("방","房") 밖에서 따로 먹게 했는데, #ruby("종|록","宗|錄")이 먹고 싶어하는 #ruby("형|상","形|狀")은 차마 볼 수가 없었다. 나는 #ruby("방","房") 밖에서 밥을 먹다가, 고기 한 덩이와 밥 한 덩이를 입에 물고 #ruby("방","房")안에 들어와서 입 안에서 도로 꺼내 먹여, 마치 어미새가 새끼에게 물어 먹이듯 했다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[7) #ruby("기|약","期|約")없는 15#ruby("년|형","年|刑")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 나는 #ruby("종|로|구|치|감","鍾|路|拘|置|監")으로 넘어갔다. 비록 #ruby("독|방","獨|房")에 있으나 #ruby("총|감|부","總|監|府")보다는 #ruby("편|리","便|利")하고, 이른바 #ruby("감|옥","監|獄")의 #ruby("식|사","食|事")도 #ruby("분|량","分|量")이 훨씬 많았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈이 내 #ruby("신|문","訊|問")에 대해 #ruby("사|실","事|實")대로 #ruby("형","刑")을 매긴다면 #ruby("소|위","所|謂") ‘#ruby("보|안|법","保|安|法") #ruby("위|반","違|反")’으로 #ruby("극|형","極|刑") 2#ruby("년","年")밖에 지울 수 없었다. 그래서 #ruby("소|위","所|謂") #ruby("안|명|근","安|明|根") #ruby("강|도","强|盜") #ruby("사|건","事|件")에다 억지로 얽어 끌어붙일 #ruby("결|심","決|心")인 듯했다. 그런데 내가 #ruby("경|성","京|城") #ruby("양|기|탁","梁|起|鐸") 집에서 #ruby("서|간|도","西|間|島") #ruby("사|건","事|件")을 #ruby("회|의","會|議")하고 #ruby("이|동|녕","李|東|寧")을 #ruby("파|송","派|送")하게 한 날짜가, 곧 #ruby("안|명|근","安|明|根")이 #ruby("안|악","安|岳")에 와서 #ruby("원|행|섭","元|行|燮")·#ruby("박|형|병","朴|亨|秉")·#ruby("고|봉|수","高|鳳|洙")·#ruby("한|정|교","韓|貞|敎") #ruby("등","等")과 #ruby("안|악","安|岳") #ruby("부|호","富|豪")를 #ruby("습|격","襲|擊")하자고 #ruby("회|의","會|議")했다는 날이었다. 그때 #ruby("안|악","安|岳")에 있었던 #ruby("김|홍|량","金|鴻|亮")·#ruby("김|용|제","金|庸|濟")·#ruby("도|인|권","都|仁|權")·#ruby("양|성|진","楊|成|鎭")·#ruby("장|윤|근","張|允|根") #ruby("등","等")은 #ruby("안|명|근","安|明|根")의 #ruby("종|범","從|犯")으로 쉽게 꾸몄지만, 나에게는 그날 #ruby("경|성","京|城")에 있었다는 #ruby("확|실","確|實")한 #ruby("증|거","證|據")가 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그리하여 #ruby("안|악","安|岳")에 #ruby("안|명|근","安|明|根")이 와서 만난 날짜만 이십몇 #ruby("일","日")이라 #ruby("기|입","記|入")하고, #ruby("경|성|회|의","京|城|會|議") 날짜는 #ruby("모|월","某|月") #ruby("중|순","中|旬")#footnote(numbering: _ => [66)])[#h(0.35em)#ruby("판|결|문","判|決|文")에는 1910#ruby("년","年") 12#ruby("월","月") #ruby("중|순","中|旬")으로 #ruby("기|록","記|錄")돼 있다.]에 #ruby("양|기|탁","梁|起|鐸") 집에서 #ruby("서|간|도","西|間|島")에 대한 #ruby("사|실","事|實")을 #ruby("회|의","會|議")하였다고 어름어름 #ruby("기|입","記|入")하였다. 그리고 내가 그날 #ruby("안|악","安|岳")에서 #ruby("회|의","會|議")에 #ruby("참|석","參|席")한 것을 #ruby("목|격","目|擊")하였다는 #ruby("증|인","證|人")으로 #ruby("양|산|학|교","楊|山|學|校") #ruby[교지기][校直] 아들인 14#ruby("세","歲")짜리 #ruby("이|원|형","李|元|亨") #ruby("학|생","學|生")을 잡아 올렸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 이른바 #ruby("검|사","檢|事") #ruby("신|문","訊|問")을 당할 때에 #ruby("벽","壁") 너머 #ruby("신|문|실","訊|問|室")에서 #ruby("이|원|형","李|元|亨")의 말소리가 들렸다. #ruby("왜","倭")놈이 #ruby("원|형","元|亨")에게 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("안|명|근","安|明|根")이 #ruby("양|산|학|교","楊|山|學|校")에 왔을 때, #ruby("김|구","金|龜")도 그 자리에 있었지?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("안|명|근","安|明|根")이 누구인지도 모르고, #ruby("김|구","金|龜") #ruby("선|생","先|生")님은 어디 가고 그날 없었습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("왜","倭")놈들은 죽일 것같이 #ruby("협|박","脅|迫")하고, #ruby("조|선|인","朝|鮮|人") #ruby("순|사","巡|査")놈은 #ruby("원|형","元|亨")을 달랬다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이 미련한 놈아. #ruby("안|명|근","安|明|根")이도, #ruby("김|구","金|龜")도 같이 앉아 있는 것을 보았다고 #ruby("대|답","對|答")만 하면, 네가 #ruby("지|금","只|今")이라도 아버지를 따라 집에 가도록 해줄 터이니 시키는 대로 말을 하여라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 그렇게 말하리다. 때리지 마셔요.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 #ruby("원|형","元|亨")이 #ruby("대|답","對|答")한다. #ruby("검|사","檢|事")놈이 나를 #ruby("신|문","訊|問")하다가 #ruby("초|인|종","招|人|鐘")을 울리니, #ruby("원|형","元|亨")을 #ruby("문","門") 안으로 들이세우고 #ruby("원|형","元|亨")에게 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("양|산|학|교","楊|山|學|校")에서 #ruby("안|명|근","安|明|根")이 #ruby("김|구","金|龜")와 같이 앉은 것을 네가 보았느냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“예.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[말이 끝나자마자, #ruby("원|형","元|亨")을 #ruby("문","門") 밖으로 끌고 나갔다. #ruby("검|사","檢|事")놈은 나에게 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 이런 #ruby("증|거","證|據")가 있는데도…….”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“500#ruby("여","餘") #ruby("리","里") 멀리 떨어진 곳에서, 같은 날 같은 #ruby("시|각","時|刻")에, 두 곳 #ruby("회|의","會|議")를 다 #ruby("참|석","參|席")한 #ruby("김|구","金|龜")를 만들려고 매우 #ruby("수|고","受|苦")스럽겠소.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[말을 마치니, 이것으로 #ruby("예|심","豫|審") #ruby("종|결","終|結")이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 우리 #ruby("사|건","事|件") #ruby("외","外")에 #ruby("의|병|장","義|兵|將") #ruby("강|기|동","姜|基|東")이 #ruby("원|산","元|山")에서 #ruby("체|포","逮|捕")되어 #ruby("경|무|총|감|부","警|務|總|監|府")에서 같이 #ruby("취|조","取|調")를 받고 #ruby("소|위","所|謂") #ruby("육|군|법|원","陸|軍|法|院")에서 #ruby("사|형","死|刑")을 받은 #ruby("사|건","事|件")이 있었고, #ruby("김|좌|진","金|佐|鎭")#footnote(numbering: _ => [67)])[#h(0.35em)#ruby[김|좌|진][金|佐|鎭]\(1889〜1930). #ruby("호","號") #ruby("백|야","白|冶"). 그는 1911#ruby("년","年") #ruby("북|간|도","北|間|島")에 #ruby("군|관|학|교","軍|官|學|校")를 #ruby("설|립","設|立")하기 #ruby("위","爲")해 #ruby("자|금","資|金")을 모으다 #ruby("체|포","逮|捕")되어 2#ruby("년","年") 6#ruby("개|월|간","個|月|間") #ruby("투|옥","投|獄")되었다.] #ruby("등","等") 몇 사람이 #ruby("애|국|운|동","愛|國|運|動")을 하다가 #ruby("강|도|죄","强|盜|罪")로 #ruby("징|역","懲|役")을 받고 같이 #ruby("수|감","收|監")되어 함께 #ruby("고|생","苦|生")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("강|기|동","姜|基|東")은 처음에는 #ruby("의|병","義|兵")에 #ruby("참|가","參|加")하였다가, #ruby("즉|시","卽|時") #ruby("귀|순","歸|順")하여 #ruby("헌|병|보|조|원","憲|兵|補|助|員")이 되어 #ruby("경|성|지|방","京|城|地|方")에서 #ruby("복|무","服|務")했다. 그런데 #ruby("왜","倭")놈들이 #ruby("의|병","義|兵")을 #ruby("총|검|거","總|檢|擧")하여 #ruby("수|십","數|十") #ruby("명","名")을 #ruby("일|시","一|時")에 #ruby("총|살","銃|殺")하기로 #ruby("내|정","內|定")하였는데, 그 #ruby("의|병","義|兵")들은 #ruby("강|기|동","姜|基|東")의 #ruby("전","前") #ruby("동|지","同|志")들이었다. #ruby("강|기|동","姜|基|東")은 #ruby("자|기","自|己") #ruby("수|직|시|간","守|直|時|間")에 #ruby("수|감","收|監")된 #ruby("의|병","義|兵")을 #ruby("전|부","全|部") #ruby("해|방","解|放")하고 #ruby("사|무|소","事|務|所")에 #ruby("비|치","備|置")한 #ruby("총|기","銃|器")를 꺼내어 #ruby("각|기","各|其") #ruby("무|장","武|裝")했다. 그리고 #ruby("야|간","夜|間")에 #ruby("경|계|망","警|戒|網")을 #ruby("돌|파","突|破")하여 #ruby("강|원","江|原")·#ruby("경|기","京|畿")·#ruby("충|청","忠|淸") #ruby("각|지","各|地")에서 #ruby("수|년","數|年") 동안 #ruby("항|일|전|쟁","抗|日|戰|爭")을 #ruby("계|속","繼|續")하였다. 그는 #ruby("후","後")에 #ruby("원|산","元|山")에서 #ruby("안|기|동","安|基|東")으로 #ruby("행|세","行|世")하면서 무슨 일을 #ruby("계|획","計|劃")하다가 #ruby("체|포","逮|捕")되어 #ruby("총|살","銃|殺")을 당하고 말았다.#footnote(numbering: _ => [68)])[#h(0.35em)#ruby[강|기|동][姜|基|東]\(1884〜1911). 그는 #ruby("대|한|제|국","大|韓|帝|國") #ruby("기|병","騎|兵") #ruby("부|위","副|尉")였는데, 1907#ruby("년","年") #ruby("군|대","軍|隊") #ruby("강|제","强|制") #ruby("해|산","解|散") #ruby("후","後") #ruby("해|산|군","解|散|軍")을 #ruby("규|합","糾|合")하여 #ruby("의|병|항|쟁","義|兵|抗|爭")을 하다 #ruby("체|포","逮|捕")되어 #ruby("위|장","僞|裝") #ruby("귀|순","歸|順")하여 #ruby("장|단","長|湍") #ruby("고|랑|포","高|浪|浦") #ruby("헌|병|보|조|원","憲|兵|補|助|員")을 하였다. 그는 #ruby("탈|옥","脫|獄")하여 #ruby("의|병|투|쟁","義|兵|鬪|爭")을 #ruby("계|속","繼|續")하다 1911#ruby("년","年") 2#ruby("월","月") 12#ruby("일","日") #ruby("원|산","元|山") #ruby("오|처|루","吾|妻|樓")에서 #ruby("체|포","逮|捕")되었다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("종|로|감|옥","鍾|路|監|獄")에서 하루는 #ruby("안|악","安|岳") #ruby("군|수","郡|守") #ruby("이","李")아무개가 #ruby("면|회","面|會")를 와서, #ruby("양|산|학|교","楊|山|學|校") #ruby("교|사","校|舍")는 #ruby("원|래","元|來") #ruby("관|청","官|廳")#ruby("건|물","建|物")이니 #ruby("환|부","還|付")하라고 #ruby("강|요","强|要")하고, #ruby("교|구","校|具")와 #ruby("집|물","什|物")도 #ruby("공|립","公|立") #ruby("보|통|학|교","普|通|學|校")에 #ruby("인|도","引|渡")한다는 #ruby("요|구|서","要|求|書")에 #ruby("날|인","捺|印")하라고 #ruby("요|구","要|求")했다. 나는 #ruby("교|사","校|舍")는 #ruby("공|공","公|共")#ruby("건|물","建|物")이니 빼앗아 #ruby("환|수","還|收")하더라도 #ruby("비|품","備|品")과 #ruby("기|구","器|具")는 #ruby("안|신|학|교","安|新|學|校")에 #ruby("기|부","寄|附")하겠다 하였으나, #ruby("결|국","結|局") #ruby("학|교","學|校") #ruby("전|부","全|部")를 #ruby("공|립","公|立") #ruby("보|통|학|교","普|通|學|校")의 #ruby("소|유","所|有")로 #ruby("강|탈","强|奪")해 갔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("양|산|학|교","楊|山|學|校") #ruby("소|학|생","小|學|生")들은 #ruby("국|가","國|家")에 대한 #ruby("관|념","觀|念")이 #ruby("부|족","不|足")했지만 #ruby("중|학|생","中|學|生")인 #ruby("손|두|환","孫|斗|煥")#footnote(numbering: _ => [69)])[#h(0.35em)#ruby[손|두|환][孫|斗|煥]\(1895〜?). #ruby("황|해|도","黃|海|道") #ruby("은|율","殷|栗") #ruby("출|신","出|身")의 #ruby("독|립|운|동|가","獨|立|運|動|家"). 그는 #ruby("임|시|정|부","臨|時|政|府") #ruby("의|정|원","議|政|院") #ruby("의|원","議|員")을 #ruby("역|임","歷|任")하였고, #ruby("민|족|혁|명|당","民|族|革|命|黨")에서 #ruby("활|동","活|動")하였다. #ruby("해|방","解|放") #ruby("후","後") 그는 #ruby("여|운|형","呂|運|亨")의 #ruby("인|민|당","人|民|黨")·#ruby("근|로|인|민|당","勤|勞|人|民|黨")의 #ruby("중|간|파","中|間|派") #ruby("조|직","組|織")에서 #ruby("주","主")로 #ruby("활|동","活|動")하였고, #ruby("남|북|연|석|회|의","南|北|聯|席|會|議")에도 #ruby("민|족|자|주|연|맹","民|族|自|主|聯|盟") #ruby("대|표","代|表")로 #ruby("참|석","參|席")하였다.]은 남달랐다. 내가 #ruby("장|련|읍","長|連|邑")에서 #ruby("봉|양|학|교","鳳|陽|學|校")#footnote(numbering: _ => [70)])[#h(0.35em)#ruby("원|주","原|註"): “耶敎 設立 後 改稱 進明”. #ruby("예|수|교","耶|蘇|敎")에서 #ruby("설|립","設|立"), #ruby("후","後")에 #ruby("진|명","進|明")으로 #ruby("개|칭","改|稱")하였다.]에 #ruby("근|무","勤|務")할 때 그는 #ruby("초|립","草|笠")둥이였다. 그 #ruby("부|친","父|親") #ruby("손|창|렴","孫|昌|濂")이 늦게 낳은 아들이라 #ruby("애|지|중|지","愛|之|重|之")한 탓에 그 #ruby("부|모","父|母")와 #ruby("어|른","尊|長")은 물론이요, 그 #ruby("군","郡") #ruby("군|수","郡|守")까지도 #ruby("두|환","斗|煥")에게 ‘해라’ 하는 말을 들었다. 어떤 사람이고 #ruby("두|환","斗|煥")에게 높임말을 들어본 사람이 없었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|해","黃|海")·#ruby("평|안","平|安") #ruby("양|도","兩|道")에는 #ruby("특","特")히 #ruby("지|방","地|方") #ruby("풍|습","風|習")에 #ruby("성|년","成|年")이 되기까지 #ruby("부|모","父|母")에게 ‘해라’ 하는 #ruby("습|속","習|俗")이 있으므로, 그 #ruby("천","賤")한 #ruby("풍|습","風|習")을 #ruby("개|량","改|良")하려고 애쓰던 때였다. #ruby("두|환","斗|煥")을 살살 꾀어 #ruby("학|교","學|校")에 #ruby("입|학","入|學")하게 한 #ruby("후","後"), 어느날 #ruby("수|신","修|身") #ruby("시|간","時|間")에 #ruby("학|생","學|生") #ruby("중","中")에 아직 #ruby("부|모","父|母")나 #ruby("연|로","年|老")하신 #ruby("어|른","尊|長")에게 ‘해라’ 하는 이가 있으면 손을 들라 하니, 몇몇 #ruby("거|수","擧|手")하는 #ruby("학|생","學|生") #ruby("중","中")에 #ruby("두|환","斗|煥")이도 있었다. #ruby("수|업","授|業")을 끝내고 #ruby("두|환","斗|煥")을 #ruby("별|실","別|室")로 불러,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“젖 먹는 어린애는 #ruby("부|모","父|母")나 #ruby("존|장","尊|長")에게 #ruby("경|어","敬|語")를 #ruby("사|용","使|用")하지 못한대도 탓할 수 없으나, 너와 같이 #ruby("어|른","尊|長")된 #ruby("표","標")로 상투 짜고 #ruby("초|립","草|笠") 쓰고서 #ruby("부|모","父|母")와 #ruby("어|른","尊|長")에게 #ruby("공|대","恭|待")할 줄을 모르니, 부끄러운 줄 모르느냐?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 꾸짖었다. 그러자 #ruby("두|환","斗|煥")이 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그러면 언제부터 #ruby("공|대","恭|待")를 하오리까?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“잘못인 줄 아는 #ruby("시|간","時|間")부터니라.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다음날 이른 아침 #ruby("문|전","門|前")에서 ‘#ruby("김|구","金|龜") #ruby("선|생","先|生")님’을 부르는 이가 있었다. 나가보니 #ruby("손|창|렴","孫|昌|濂") #ruby("의|관","議|官")이었다. #ruby("하|인","下|人")에게 #ruby[쌀][白米] 한 짐을 지우고 와서 #ruby("문","門") 안에 들여놓고, 너무 기뻐하여 말의 #ruby("순|서","順|序")도 차리지 못했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("두|환","斗|煥")이 놈이 어제 저녁에 #ruby("학|교","學|校")에서 돌아와 내게 #ruby("공|대","恭|待")하고, 저의 #ruby("모|친","母|親")에게는 #ruby("전","前")과 같이 ‘해라’를 하더니 깜짝 놀라 ‘에고 잘못했습니다’ 하고 말을 고치며 ‘#ruby("선|생","先|生")님 #ruby("교|훈","敎|訓")’이라고 합디다. #ruby("선|생","先|生")님, 진지 많이 잡수시고 그놈 잘 #ruby("교|육","敎|育")하여 주십시오. 밥맛 좋은 쌀이 들어왔기로 좀 가져왔습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나도 마음이 기뻐서 웃었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때에 #ruby("학|교","學|校")를 #ruby("신|설","新|設")하고서, #ruby("학|령","學|齡") #ruby("아|동","兒|童")이 있는 집에 #ruby("방|문","訪|問")하여 다니면서 #ruby("학|부|형","學|父|兄")에게 ‘#ruby("학|생","學|生")들의 머리는 깎지 않겠다’는 #ruby("조|건|부","條|件|附")로, #ruby("애|걸","哀|乞")하며 #ruby("아|동","兒|童")들을 모아 왔다. 그런데 어떤 아이들은 #ruby("부|모","父|母")들이 머리를 자주 빗기지 않아서 이와 서캐(이의 알)가 가득하였다. 나는 할 수 없이 얼레빗·참빗을 사다두고 #ruby("매|일","每|日") 몇 #ruby("시|간","時|間")씩 #ruby("학|생","學|生")들 머리를 빗겼다. #ruby("점|차","漸|次") #ruby("아|동","兒|童") #ruby("수|효","數|爻")가 늘어남에 따라 #ruby("학|과","學|科") #ruby("시|간","時|間")보다 머리 빗기는 #ruby("시|간","時|間")이 많게 되니, 그 다음 #ruby("수|단","手|段")으로 하나둘씩 #ruby("부|모","父|母")의 #ruby("승|낙","承|諾")을 얻어 머리를 깎아주었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("두|환","斗|煥")의 #ruby("경|우","境|遇") #ruby("부|친","父|親")의 #ruby("승|낙","承|諾")을 구하다가 도리어 #ruby("퇴|학","退|學")시키겠다고 할지 몰라 나는 #ruby("두|환","斗|煥")이와 #ruby("상|의","相|議")했다. #ruby("두|환","斗|煥")은 상투 짜는 것이 괴롭고 #ruby("초|립","草|笠")이 무거우니, 머리 깎는 것이 #ruby("소|원","所|願")이라 한다. 나는 머리를 깎아서 #ruby("두|환","斗|煥")을 집에 보낸 #ruby("후","後") 슬금슬금 따라가 보았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("손","孫")#ruby("의|관","議|官")은 눈물이 비오듯하며 #ruby("분","憤")이 머리끝까지 났으나, 더없이 사랑하는 #ruby("두|환","斗|煥")을 #ruby("심","甚")하게 꾸중하기는 싫고 나에게 #ruby("분","憤")풀이를 할 참이었다. 그런데 #ruby("두|환","斗|煥")이가 내가 온 것을 보고 기뻐하는 것을 보고서는 #ruby("분","憤")한 마음이 갑자기 다 어디로 갔는지, 눈에서는 눈물이 뚝뚝 떨어지는데도 얼굴에는 기쁨이 가득해지는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("선|생","先|生")님, 이것이 웬일이에요? 내가 죽거든 머리를 깎아주시지 않고.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("미|안","未|安")함을 #ruby("표","表")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("영|감","令|監")님께서는 #ruby("두|환","斗|煥")이를 #ruby("지|극","至|極")히 사랑하시지요? 나도 #ruby("영|감","令|監")님 다음으로는 사랑합니다. 나는 #ruby("두|환","斗|煥")이가 목이 가는데 큰 상투를 짜고 #ruby("망|건","網|巾")으로 조르고 무거운 #ruby("초|립","草|笠")을 씌워두는 것이 #ruby("위|생","衛|生")에 큰 #ruby("방|해","妨|害")가 되기 때문에 아끼고 사랑하는 생각으로 깎았습니다. #ruby("두|환","斗|煥")이 #ruby("신|체","身|體")가 튼튼해지면 #ruby("영|감","令|監")님에게 고맙다는 #ruby("인|사","人|事")를 듣고야 말걸요?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이로부터 #ruby("두|환","斗|煥")은 나를 따라 #ruby("안|악","安|岳")으로 #ruby("유|학","留|學")하게 되고, #ruby("손","孫")#ruby("의|관","議|官")도 같이 따라와 #ruby("객|지","客|地")에 머물면서 #ruby("두|환","斗|煥")이 #ruby("공|부","工|夫")하는 것을 보았다. #ruby("두|환","斗|煥")은 사람됨이 #ruby("총|명","聰|明")도 하거니와 #ruby("망|국","亡|國")의 #ruby("한","恨")을 같이 느낄 줄 알았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("중|학|생","中|學|生") #ruby("중","中")에 #ruby("우|기|범","禹|基|範")은, 내가 #ruby("문|화|군","文|化|郡") #ruby("종|산","鍾|山")의 #ruby("서|명|의|숙","西|明|義|塾")에서 가르치던 때 #ruby("과|부","寡|婦")의 #ruby("자|식","子|息")으로 #ruby("입|학","入|學")하여 #ruby("수|업","授|業")을 받았던 #ruby("학|생","學|生")이다. 그 #ruby("모|친","母|親")의 #ruby("능|력","能|力")으로는 #ruby("계|속","繼|續") #ruby("공|부","工|夫")할 수 없지만 #ruby("재|질","才|質")로는 #ruby("장|래|성","將|來|性")이 있어 보였다. 나는 #ruby("모|친","母|親")에게 #ruby("기|범","基|範")을 나에게 맡기면, #ruby("안|악","安|岳")으로 데리고 가서 내 집에 두고 #ruby("공|부","工|夫")시키겠다고 #ruby("요|청","要|請")했다. 그 #ruby("모|친","母|親")은 매우 #ruby("감|사","感|謝")해 하며 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("만|일","萬|一") #ruby("선|생","先|生")께서 그같이 생각하시면, 나도 따라가서 엿장사를 하며 #ruby("기|범","基|範")의 #ruby("공|부","工|夫")하는 #ruby("모|양","模|樣")을 보겠습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("기|범","基|範")을 9#ruby("세","歲") 때부터 내 집에서 기르며, #ruby("공|부","工|夫")는 #ruby("안|신|학|교","安|新|學|校") #ruby("소|학|과","小|學|科")를 마치고 #ruby("양|산|학|교","楊|山|學|校") #ruby("중|학|부","中|學|部")에 #ruby("입|학","入|學")하게 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 이제 #ruby("왜","倭")놈들이 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("해|산","解|散")하고 #ruby("교|구","校|具") #ruby("전|부","全|部")를 #ruby("강|탈","強|奪")하니, #ruby("교|육|사|업","敎|育|事|業")도 단 #ruby[꿈][春夢]이 되고 말았다. #ruby("목|자","牧|者")를 잃은 #ruby("양","羊")떼 같은 #ruby("학|생","學|生")들이 #ruby("원|수","怨|讐")의 채찍 아래 #ruby("신|음","呻|吟")하게 되었으니 #ruby("원|통","冤|痛")스러울 뿐이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 애써서 #ruby[기러기][鴻] #ruby("친|구","親|舊")\(#ruby("김|홍|량","金|鴻|亮"))가 #ruby("악","惡")의 #ruby[그물망][禍網]을 벗어나 멀리 #ruby("해|외","海|外")로 날아가기를 #ruby("기|도","祈|禱")하였건만, #ruby("홍|량","鴻|亮")은 #ruby("안|명|근","安|明|根")의 #ruby("부|탁","付|託")으로 #ruby("신|천","信|川") #ruby("이|원|식","李|源|植")에게 #ruby("권|고","勸|告")하였다고 #ruby("자|백","自|白")한 #ruby("점","點")으로 보아 풀려날 수 없었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 #ruby("상|경","上|京")하여 #ruby("사|식","私|食")을 날마다 들여보내시고 #ruby("종|종","種|種") #ruby("편|지","便|紙")로 #ruby("소|식","消|息")도 알리셨다. #ruby("안|악","安|岳")의 #ruby("가|산","家|産")과 #ruby("집|물","什|物")을 #ruby("전|부","全|部") #ruby("매|각","賣|却")하여 가지고 서울로 오다가, 두#ruby("번","番")째로 낳은 두 살배기 딸 #ruby("화|경","花|慶")#footnote(numbering: _ => [71)])[#h(0.35em)#ruby("원|문","原|文"): “花慶”. 다른 곳에는 이름이 ‘化敬’으로 되어 있다.]과 아내는 #ruby("당|시","當|時") #ruby("평|산","平|山")에 있던 #ruby("장|모","丈|母")가 사는 #ruby("처|형","妻|兄") 집에 들른 #ruby("후","後") #ruby("상|경","上|京")한다는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님이 손수 담은 밥그릇을 열고 밥을 먹으면서 생각하니, 어머님의 눈물이 밥에 #ruby("점|점","點|點")이 섞이었을 것이다. 18#ruby("년","年") #ruby("전","前") #ruby("해|주","海|州") #ruby("옥","獄")바라지로부터 #ruby("인|천","仁|川")의 #ruby("옥","獄")바라지 하실 때까지는 슬프고 #ruby("황|망","遑|忙")한 #ruby("중","中")에도 #ruby("내|외|분","內|外|分")이 서로 #ruby("위|로","慰|勞")하고 #ruby("의|논","議|論")하시며 지냈으나, #ruby("지|금","只|今")은 #ruby("과|부","寡|婦")의 몸으로 어느 누구 살뜰하게 #ruby("위|로","慰|勞")하여 줄 사람도 없다. #ruby("준|영","俊|永") #ruby("삼|촌","三|寸")과 #ruby("재|종|형|제","再|從|兄|弟")가 있으나 #ruby("대|부|분","大|部|分") #ruby("토|착","土|着") #ruby("농|민","農|民")이라 #ruby("거|론","擧|論")할 #ruby("여|지","餘|地")도 없고, #ruby("약","弱")한 아내와 어린 아이가 어머님에게 무슨 #ruby("위|안","慰|安")을 할 #ruby("능|력","能|力")이 있을까? 또한 아내가 어린 아이를 데리고, #ruby("자|기","自|己") #ruby("모|친","母|親")이 얹혀 사는 #ruby("처|형","妻|兄") 집에 갔다는 #ruby("소|식","消|息")에는 #ruby("무|한","無|限")의 느낌이 생긴다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("처|형","妻|兄")은 #ruby("본|래","本|來") #ruby("신|창|희","申|昌|熙") #ruby("군","君")과 #ruby("결|혼","結|婚")하여 #ruby("가|족","家|族")과 같이 #ruby("황|해|도","黃|海|道")에 와서 살았다. 내가 그 #ruby("처|제","妻|弟")인 #ruby("준|례","遵|禮")와 #ruby("결|혼","結|婚")한 #ruby("후","後"), #ruby("신|창|희","申|昌|熙") #ruby("군","君")은 다시 #ruby("의|과","醫|科") #ruby("졸|업","卒|業")을 #ruby("위","爲")해 세브란스 #ruby("의|학|교","醫|學|校")로 들어가게 되어 #ruby("처|형","妻|兄")과 #ruby("장|모","丈|母")까지 도로 #ruby("경|성","京|城")으로 #ruby("이|사","移|徙")해 갔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("그|후","其|後") 내가 #ruby("장|련|읍","長|連|邑")에 있을 때, #ruby("장|모","丈|母")와 #ruby("처|형","妻|兄") #ruby("모|녀","母|女") 두 사람만 #ruby("평|양","平|壤")을 들러 #ruby("장|련","長|連") 내 집까지 아내를 만나러 찾아왔다. 그런데 어찌된 #ruby("사|유","事|由")인지 #ruby("처|형","妻|兄")은 #ruby("신|창|희","申|昌|熙") #ruby("군","君")과 잘 맞지 않고 어긋난 빛을 보일 뿐 아니라, #ruby("거|동","擧|動")이 #ruby("상|식","常|識")에 벗어난 #ruby("경|향","傾|向")을 보였다. 하물며 #ruby("기|독|신|자","基|督|信|者")로서 #ruby("행|위","行|爲")인지라 그것을 본 나의 #ruby("부|부","夫|婦")는 #ruby("처|형","妻|兄")과 #ruby("장|모","丈|母")를 #ruby("권","勸")하여 #ruby("신|창|희","申|昌|熙")에게로 보냈다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("안|악","安|岳")에 #ruby("이|사","移|徙")했을 때 역시 #ruby("처|형","妻|兄")과 #ruby("장|모","丈|母")가 찾아왔는데, #ruby("처|형","妻|兄")은 #ruby("신|창|희","申|昌|熙")와 #ruby("부|부","夫|婦") #ruby("관|계","關|係")를 끝냈다고 한다. 나와 어머님은 한때도 집안에 #ruby("용|납","容|納")할 생각이 없었으나, 아내는 #ruby("자|신","自|身")의 어머니와 #ruby("형","兄")에 #ruby("대","對")해 #ruby("강|경","强|硬")한 #ruby("태|도","態|度")를 보이지 못하는 것이 #ruby("사|실","事|實")이었다. #ruby("가|정","家|庭")은 #ruby("심","甚")히 #ruby("불|안","不|安")에 빠졌다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 아내에게 #ruby("비|밀","祕|密")히 #ruby("부|탁","付|託")하고, #ruby("장|모","丈|母")에게 “큰딸을 데리고 나가주지 못할 터이면 작은딸까지 데리고 나가 달라”고 말했다. 말뜻을 깨닫지 못한 #ruby("장|모","丈|母")는 좋다 하고, #ruby("모|녀","母|女") 세 사람이 집을 떠나 #ruby("경|성","京|城")으로 #ruby("출|발","出|發")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 얼마 #ruby("후","後")에 #ruby("경|성","京|城")에 가서 #ruby("동|정","動|靜")을 살펴보니, 아내는 어머니와 #ruby("형","兄")을 떠나 어느 #ruby("학|교","學|校")에 #ruby("투|신","投|身")할 #ruby("계|책","計|策")을 하고 있었다. 나는 아내에게 #ruby("은|밀","隱|密")히 #ruby("약|간","若|干")의 #ruby("여|비","旅|費")를 주고 내려와 #ruby("재|령","載|寧")에 있던 #ruby("선|교|사","宣|敎|師") #ruby("군|예|빈","君|芮|彬")에게 말을 하니, #ruby("준|례","遵|禮")는 #ruby("당|분|간","當|分|間") 데려다가 #ruby("자|기","自|己") 집에 있게 하고 #ruby("서|서","徐|徐")히 데려가라 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 곧 #ruby("경|성","京|城")으로 #ruby("준|례","遵|禮")에게 #ruby("편|지","便|紙")를 보내고 #ruby("사|리|원|역","沙|里|院|驛") 앞에서 기다리니, #ruby("준|례","遵|禮") 혼자만 #ruby("차","車")에서 내렸다. 아내를 #ruby("군|예|빈","君|芮|彬") #ruby("목|사","牧|師") 집에다 데려다 두고, 나는 #ruby("안|악","安|岳")으로 와서 어머님에게 #ruby("사|정","事|情")을 #ruby("설|명","說|明")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("장|모","丈|母")나 #ruby("처|형","妻|兄")이 비록 #ruby("여|자","女|子") #ruby("도|리","道|理")에 #ruby("위|반","違|反")되는 #ruby("죄|상","罪|狀")이 있더라도, #ruby("죄","罪")가 없는 아내까지 내쫓는 것은 #ruby("도|리","道|理")가 아니니 #ruby("용|서","容|恕")하십시오.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[말이 끝나자마자 어머님은 #ruby("쾌","快")히 #ruby("승|낙","承|諾")하셨다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇다. 네가 데려오는 것보다 내가 #ruby("직|접","直|接") 가서 데려오마.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[어머님은 그날로 #ruby("재|령","載|寧")에 가셔서 아내를 데려왔다. #ruby("가|정","家|庭")의 #ruby("파|란","波|瀾")은 이로부터 #ruby("안|정","安|定")되었다. 아내 역시 #ruby("친|모","親|母")와 #ruby("친|형","親|兄")에 대한 #ruby("친|족|관|념","親|族|觀|念")을 #ruby("단|절","斷|絶")하고 지냈다. #ruby("그|후","其|後") #ruby("처|형","妻|兄")은 #ruby("평|산","平|山") #ruby("등|지","等|地")에서 #ruby("헌|병|보|조|원","憲|兵|補|助|員")의 #ruby("처","妻")인지 #ruby("첩","妾")인지가 되어 살고, #ruby("장|모","丈|母")도 같이 산다는 #ruby("풍|설","風|說")만 들었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 이번에 #ruby("가|족","家|族") #ruby("전|부","全|部")가 #ruby("경|성","京|城")으로 #ruby("공|판","公|判")이란 것을 보겠다고 오던 길에, #ruby("도|중","道|中")에 #ruby("평|산","平|山") #ruby("처|형","妻|兄") 집에다 아내와 #ruby("화|경","花|慶")이는 두고, 어머님만 #ruby("경|성","京|城")으로 먼저 오셔서 #ruby("공|판|일|자","公|判|日|子")를 #ruby("통|지","通|知")하여 아내를 #ruby("상|경","上|京")하게 하였다는 어머님의 #ruby("편|지","便|紙")를 보았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이제 내가 #ruby("주|장","主|張")하던 것과 힘써 온 것은 #ruby("대|부|분","大|部|分") 물거품으로 돌아갔다. #ruby("학|교","學|校")에서 #ruby("학|생","學|生")을 가르칠 때에도 #ruby("학|생","學|生")들이 나를 #ruby("숭|배","崇|拜")함보다, 내가 #ruby("학|생","學|生")들에게 #ruby("천|배","千|倍") #ruby("만|배","萬|倍")의 #ruby("숭|배","崇|拜")와 #ruby("희|망","希|望")을 두고 있었다. 나는 일찍이 #ruby("교|육","敎|育")을 #ruby("충|분","充|分")히 받지 못하여 #ruby("망|국|민","亡|國|民")이 되었으나, #ruby("학|생","學|生")들은 #ruby("후|일","後|日") #ruby("건|국|영|웅","建|國|英|雄")이 될 것을 바라던 마음도 헛된 것으로 돌아갔다. 또한 아내도 #ruby("자|기","自|己") 언니가 #ruby("헌|병","憲|兵")의 #ruby("첩","妾")질 한다는 말을 들은 #ruby("후","後")로는 #ruby("영|구","永|久")히 만나지 않기로 #ruby("결|심","決|心")하였건만, 내가 이 #ruby("지|경","地|境")이 되니 하는 수 없이 찾아갔을 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그럭저럭 #ruby("소|위","所|謂") #ruby("공|판|일|자","公|判|日|子")란 것이 #ruby("정","定")해지고, 어머님은 #ruby("왜","倭")놈 #ruby("나가이","永井")란 #ruby("변|호|사","辯|護|士")를 #ruby("고|용","雇|傭")하였다. #ruby("예|심","豫|審") #ruby("심|문","訊|問") 때 #ruby("나가이","永井") 놈은 내게 이런 말로 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("총|감|부","總|監|府") #ruby("유|치|장","留|置|場")에 있을 때 나무#ruby("판|자","板|子") #ruby("벽","壁")을 두드리며 #ruby("양|기|탁","梁|起|鐸")과 무슨 말을 하였는가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("나가이","永井")를 노려보고 #ruby("대|답","對|答")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“이것은 #ruby("신|문|관","訊|問|官")을 #ruby("대|리","代|理")한 것인가? 그 #ruby("사|실","事|實")은 #ruby("신|문","訊|問") #ruby("기|록","記|錄")에 #ruby("상|세","詳|細")히 #ruby("기|재","記|載")하였으니 나에게 더 물을 것이 없다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러자 #ruby("검|사","檢|事")놈과 눈을 꿈적이며 #ruby("실|패","失|敗")했다는 뜻을 #ruby("표|시","表|示")하는 것 같았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이른바 #ruby("재|판|일","裁|判|日")을 맞았다. #ruby("죄|수","罪|囚") #ruby("마|차","馬|車")에 실려 #ruby("경|성","京|城") #ruby("지|방|재|판|소","地|方|裁|判|所") #ruby("문|전","門|前")에 #ruby("당|도","當|到")했다. 어머님이 #ruby("화|경","花|慶")이를 업고 아내와 같이 #ruby("문","門") 안에서 기다리고 있는 것을 보면서, #ruby("소|위","所|謂") 2#ruby("호","號") #ruby("법|정","法|庭")이란 데로 끌려갔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[맨 #ruby[앞자리][首席]에 #ruby("안|명|근","安|明|根"), 다음으로 #ruby("김|홍|량","金|鴻|亮")이요, 나는 #ruby("제|3|차","第|三|次")에 앉고, #ruby("이|승|길","李|承|吉")·#ruby("배|경|진","裵|敬|鎭")·#ruby("한|순|직","韓|淳|稷")·#ruby("도|인|권","都|仁|權")·#ruby("양|성|진","楊|成|鎭")·#ruby("최|익|형","崔|益|亨")·#ruby("김|용|제","金|庸|濟")·#ruby("최|명|식","崔|明|植")·#ruby("장|윤|근","張|允|根")·#ruby("고|봉|수","高|鳳|洙")·#ruby("한|정|교","韓|貞|敎")·#ruby("박|형|병","朴|亨|秉") #ruby("등","等") 40#ruby("명","名")이 #ruby("출|석","出|席")하였다. #ruby("방|청|석","傍|聽|席")을 둘러보니 #ruby("각","各") #ruby("학|교","學|校") #ruby("남|녀","男|女") #ruby("학|생","學|生")과 #ruby("각","各") 사람의 #ruby("친|척","親|戚"), #ruby("친|구","親|舊")가 모였고, #ruby("변|호|사","辯|護|士")들과 #ruby("신|문|기|자","新|聞|記|者")들도 #ruby("열|석","列|席")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("동|지","同|志")들에게 #ruby("한|필|호","韓|弼|昊")·#ruby("신|석|충","申|錫|忠") 두 사람의 #ruby("경|과","經|過")를 들어보니, #ruby("한|필|호","韓|弼|昊") #ruby("선|생","先|生")은 그때 #ruby("경|무|총|감|부","警|務|總|監|府")에서 #ruby("피|살","被|殺")되었고, #ruby("신|석|충","申|錫|忠")은 #ruby("재|령","載|寧") #ruby("철|교","鐵|橋")까지 끌려오다 #ruby("강","江")에 #ruby("투|신","投|身")하여 죽었다는 가슴 아픈 #ruby("사|연","事|緣")을 알게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("대|강","大|綱") #ruby("신|문","訊|問")을 마친 #ruby("후","後") #ruby("소|위","所|謂") #ruby("판|결","判|決")이 있었다. #ruby("안|명|근","安|明|根")은 #ruby("종|신","終|身") #ruby("징|역","懲|役")이요, #ruby("김|홍|량","金|鴻|亮")·#ruby("김|구","金|龜")·#ruby("이|승|길","李|承|吉")·#ruby("배|경|진","裵|敬|鎭")·#ruby("한|순|직","韓|淳|稷")·#ruby("원|행|섭","元|行|燮")·#ruby("박|만|준","朴|萬|俊") 7#ruby("명","名")은 15#ruby("년|형","年|刑")인데, #ruby("원|행|섭","元|行|燮")·#ruby("박|만|준","朴|萬|俊")은 #ruby("결|석","缺|席")하였고, #ruby("도|인|권","都|仁|權")·#ruby("양|성|진","楊|成|鎭")은 10#ruby("년|형","年|刑")이요, #ruby("최|익|형","崔|益|亨")·#ruby("김|용|제","金|庸|濟")·#ruby("장|윤|근","張|允|根")·#ruby("고|봉|수","高|鳳|洙")·#ruby("한|정|교","韓|貞|敎")·#ruby("박|형|병","朴|亨|秉")은 7#ruby("년","年") #ruby("혹","或")은 5#ruby("년","年")으로 #ruby("구|형","求|刑")한 #ruby("후","後"), #ruby("판|결","判|決")도 그대로 #ruby("언|도","言|渡")되었다.#footnote(numbering: _ => [72)])[#h(0.35em)#ruby("판|결|일","判|決|日")은 1911#ruby("년","年") 7#ruby("월","月") 22#ruby("일","日")이었다. 5#ruby("년|형","年|刑")을 받은 사람은 없고 #ruby("최|하","最|下") 7#ruby("년|형","年|刑")이었다. 모두 18#ruby("명","名")이었으며, #ruby("본|문","本|文")의 16#ruby("명","名") #ruby("외","外") #ruby("최|명|식","崔|明|植")과 #ruby("김|익|연","金|益|鍊")이 있었다.] 이것은 이른바 ‘#ruby("강|도","強|盜") #ruby("사|건","事|件")’으로 #ruby("선|고","宣|告")된 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그#ruby("후","後")에 #ruby("소|위","所|謂") ‘#ruby("보|안","保|安") #ruby("사|건","事|件")’으로 또 #ruby("재|판","裁|判")할 때는, #ruby("수|석","首|席")으로는 #ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("김|구","金|龜")·#ruby("김|홍|량","金|鴻|亮")·#ruby("주|진|수","朱|鎭|洙")·#ruby("옥|관|빈","玉|觀|彬")·#ruby("김|도|희","金|道|熙")·#ruby("김|용|규","金|用|圭")·#ruby("고|정|화","高|貞|華")·#ruby("정|달|하","鄭|達|河")·#ruby("감|익|룡","甘|益|龍")·#ruby("김|용|규","金|用|圭")의 조카 #ruby("등","等")이었다. #ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("김|구","金|龜")·#ruby("김|홍|량","金|鴻|亮")·#ruby("주|진|수","朱|鎭|洙")·#ruby("옥|관|빈","玉|觀|彬")은 2#ruby("년","年") #ruby("징|역","懲|役")이고,#footnote(numbering: _ => [73)])[#h(0.35em)#ruby("옥|관|빈","玉|觀|彬")은 1#ruby("년","年") 6#ruby("개|월","個|月")이었고, #ruby("김|구","金|龜")·#ruby("김|홍|량","金|鴻|亮")은 여기서는 #ruby("형","刑")을 받지 않았다. 따라서 #ruby("김|구","金|龜")의 #ruby("총|형|량","總|刑|量")은 15#ruby("년|형","年|刑")이다.] 그 나머지는 1#ruby("년","年") #ruby("혹","或")은 6#ruby("개|월","個|月")이었다.#footnote(numbering: _ => [74)])[#h(0.35em)#ruby("안|윤|재","安|允|栽")·#ruby("감|익|룡","甘|益|龍")·#ruby("김|용|규","金|用|圭") #ruby("등","等")은 1#ruby("년","年") 6#ruby("개|월|형","個|月|刑")이었고, #ruby("유|문|형","柳|文|馨")·#ruby("권|태|선","權|泰|善")이 1#ruby("년|형","年|刑"), #ruby("김|용|태","金|用|泰")·#ruby("김|희|록","金|熙|祿")·#ruby("김|성|주","金|成|周")·#ruby("정|달|하","鄭|達|河")가 6#ruby("개|월|형","個|月|刑")이었다.] 그밖에 #ruby("이|동|휘","李|東|輝")·#ruby("이|승|훈","李|昇|薰")·#ruby("박|도|병","朴|道|秉")·#ruby("최|종|호","崔|宗|鎬")·#ruby("정|문|원","鄭|文|源")·#ruby("김|병|옥","金|秉|玉") #ruby("등","等") 19#ruby("인","人")은 #ruby("무|의|도","舞|衣|島")·#ruby("제|주|도","濟|州|島")·#ruby("고|금|도","古|今|島")·#ruby("울|릉|도","鬱|陵|島") #ruby("등","等")으로 1#ruby("년","年") #ruby("유|배","流|配")가 #ruby("결|정","決|定")되었다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[8) #ruby("서|대|문|감|옥","西|大|門|監|獄")으로]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[우리는 며칠 #ruby("후","後")에 #ruby("서|대|문|감|옥","西|大|門|監|獄")으로 #ruby("이|감","移|監")되었다. #ruby("동|지","同|志")들 #ruby("전|부","全|部")가 앞서거니 뒤서거니 그곳에서 함께 #ruby("복|역","服|役")하게 되니, 날마다 서로 얼굴 대하는 것으로도 #ruby("충|분","充|分")히 #ruby("위|로","慰|勞")가 되었고, #ruby("간|간","間|間")이 말로도 #ruby("사|정","事|情")을 알리며 지내는 까닭에 #ruby("고|생","苦|生") 가운데 #ruby("낙","樂")이 되었다. 그뿐 아니라 5#ruby("년","年") #ruby("이|하","以|下")는 #ruby("세|상","世|上")에 나갈 #ruby("소|망","所|望")이 있으나 7#ruby("년","年") #ruby("이|상","以|上")은 #ruby("옥|중|귀|신","獄|中|鬼|神")이 되리라고 믿었기 때문에, #ruby("육|체","肉|體")로는 #ruby("복|역","服|役")을 하나 #ruby("정|신","精|神")으로는 #ruby("왜","倭")놈을 짐승처럼 여기고, #ruby("쾌|활","快|活")한 마음으로 죽는 날까지 #ruby("낙|천|생|활","樂|天|生|活")을 하기로 했다. #ruby("동|지","同|志")들도 #ruby("대|부|분","大|部|分") #ruby("지|향","志|向")하는 바가 #ruby("동|일","同|一")하므로 #ruby("옥|중","獄|中")에서 하는 일이 서로 #ruby("모|의","謀|議")하지 않고도 같은 때가 많았다. #ruby("오|월|동|주","吳|越|同|舟")#footnote(numbering: _ => [75)])[#h(0.35em)#ruby("오|월|동|주","吳|越|同|舟")란 #ruby("중|국","中|國") #ruby("병|법|서","兵|法|書") 『#ruby("손|자","孫|子")』에 나오는 말로, #ruby("원|래","原|來") #ruby("적|대|국","敵|對|國")인 #ruby("오","吳")나라와 #ruby("월","越")나라 사람들도 같은 배에 타게 되면 #ruby("적|대|관|계","敵|對|關|係")는 사라지고 마음이 같아지게 된다, 즉 ‘#ruby("처|지","處|地")가 같으면 마음도 같아진다’는 #ruby("의|미","意|味")이다. 이 말이 #ruby("전","轉")하여 사이 나쁜 사람들이 같은 #ruby("처|지","處|地")에 #ruby("처","處")하거나 #ruby("단|지","但|只") #ruby("동|석","同|席")한 #ruby("경|우","境|遇")를 #ruby("의|미","意|味")하기도 한다. 여기서는 #ruby("원|래","原|來")의 뜻에 가깝다.]란 옛말이 참으로 헛말이 아닌 줄을 깨달았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("옥|중","獄|中")에서 #ruby("여|생","餘|生")을 보내게 된 #ruby("동|지","同|志")들은, #ruby("대|부|분","大|部|分") 크거나 어리거나 간에 아들을 두었으나, #ruby("유|독","唯|獨") 내가 젖먹이 #ruby("화|경","花|慶")이만 있고 또한 누이도 없는 #ruby("독|자","獨|子")임을 #ruby("애|석","哀|惜")하게 생각하였다. #ruby("김|용|제","金|庸|濟")는 4#ruby("남","男") 1#ruby("녀","女")를 두었으니, #ruby("장|남","長|男")은 #ruby("선|량","善|亮")이요, 그 다음이 #ruby("근|량","勤|亮")·#ruby("문|량","文|亮")·#ruby("순|량","順|亮")인데, #ruby("자|원","自|願")해서 #ruby("문|량","文|亮")으로 나의 #ruby("대","代")를 잇게 하겠다고 하여 #ruby("허|락","許|諾")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나의 #ruby("심|리","心|理") #ruby("상|태","狀|態")가 #ruby("체|포","逮|捕")된 #ruby("이|전","以|前")과 #ruby("이|후","以|後")에 큰 #ruby("변|동","變|動")이 생겼음을 깨달았다. #ruby("체|포","逮|捕")되기 #ruby("이|전","以|前")에는 #ruby("십|수|년","十|數|年") 동안 #ruby("성|경","聖|經")을 들고 #ruby("교|회|당","敎|會|堂")에서 #ruby("설|교","說|敎")하거나 #ruby("교|편","敎|鞭")을 들고 #ruby("교|실","敎|室")에서 #ruby("학|생","學|生")을 #ruby("교|훈","敎|訓")하였으므로, 하나하나 일마다 #ruby("양|심","良|心")을 #ruby("본|위","本|位")로 삼아서, 삿된 #ruby("마|음","邪|心")이 생길 때마다 먼저 #ruby("자|기","自|己")를 #ruby("자|책","自|責")하지 않고는 #ruby("감","敢")히 다른 사람의 그릇됨을 탓하지 못하는 것이 거의 #ruby("습|관","習|慣")이 되었다. 그런 까닭으로 #ruby("학|생","學|生")들과 #ruby("친|우","親|友")들 #ruby("간","間")에 #ruby("충|실","忠|實")하다는 #ruby("신|망","信|望")을 받고 지냈고, #ruby("범|사","凡|事")에 #ruby("추|기|급|인","推|己|及|人")의 #ruby("상|습","常|習")이 되엿섯건만,#footnote(numbering: _ => [76)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “#ruby("매|사","每|事")에 #ruby("자|기","自|己")로부터 #ruby("실|천","實|踐")하여 남에 미치는 것이 #ruby("습|관","習|慣")이 되었건만”.] 어찌하여 #ruby("불|과","不|過") #ruby("반|년","半|年") 만에 #ruby("심|리","心|理")에 큰 #ruby("변|동","變|動")이 생겨났는가를 #ruby("연|구","硏|究")해 보았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그러고 보면, 나의 #ruby("변|화","變|化")는 #ruby("경|무|총|감|부","警|務|總|監|府")에서 #ruby("신|문","訊|問")받을 때 #ruby("와타나베","渡邊") 놈이, 다시 마주앉은 오늘의 #ruby("김|구","金|龜")가 17#ruby("년","年") #ruby("전","前") #ruby("김|창|수","金|昌|洙")인 것도 모르고, #ruby("대|담","大|膽")하게 #ruby("자|기","自|己") 가슴에는 X#ruby("광|선","光|線")을 붙이고 있어 #ruby("출|생","出|生") #ruby("이|후","以|後") #ruby("지|금","只|今")껏 나의 #ruby("일|체","一|體") #ruby("행|동","行|動")을 #ruby("투|시","透|視")하고 있으니 터럭만큼이라도 숨기면 #ruby("당|장","當|場") 쳐죽이겠다고 #ruby("협|박","脅|迫")하던 때부터 #ruby("시|작","始|作")되었던 것이다. #ruby("태|산","泰|山")처럼 크게 보이던 #ruby("왜","倭")놈이 그때부터 #ruby("겨|자","芥|子")씨와 같이 작아 보였다. 무릇 일곱 #ruby("차|례","次|例")나 매달려 #ruby("질|식","窒|息")된 #ruby("후","後") #ruby("냉|수","冷|水")를 끼얹어 살아나곤 하였지만, 마음은 #ruby("점|점","漸|漸") #ruby("강|고","強|固")해져 #ruby("왜","倭")놈에게 #ruby("국|권","國|權")을 빼앗긴 것은 #ruby("일|시|적","一|時|的") #ruby("국|운","國|運") #ruby("쇠|퇴","衰|退")요, #ruby("일|본","日|本")은 #ruby("조|선","朝|鮮")을 #ruby("영|구","永|久") #ruby("통|치","統|治")할 #ruby("자|격","資|格")이 없다는 것이 불 보듯 #ruby("확|연","確|然")한 #ruby("사|실","事|實")로 생각되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("소|위","所|謂") #ruby("고|등|관","高|等|官")이라고 #ruby("모|자","帽|子")에 #ruby("금","金")줄을 둘셋씩 붙인 놈이, 나에게 #ruby("일|본","日|本") #ruby("천|황","天|皇")의 #ruby("신|성|불|가|침","神|聖|不|可|侵")인 #ruby("권|위","權|威")를 #ruby("과|장","誇|張")하여, ‘#ruby("천|황","天|皇")이 #ruby("재|가","裁|可")한 #ruby("법|령","法|令")에 #ruby("대","對")하여 #ruby("행|정|관|리","行|政|官|吏")가 털끝만큼이라도 #ruby("범|위","範|圍")에 벗어나는 #ruby("행|사","行|事")를 못한다’ 또 ‘#ruby("조|선","朝|鮮") #ruby("인|민","人|民")도 #ruby("천|황","天|皇")의 어린 #ruby("백|성","赤|子")이라 #ruby("일|본|인","日|本|人")과 한가지로 #ruby("대|접|받|는","一|視|同|仁") #ruby("행|복","幸|福")을 받는 것이니, #ruby("공","功")이 있는 사람은 #ruby("상","賞")을 주고 #ruby("죄","罪")가 있는 사람은 #ruby("벌","罰")을 주는 #ruby("법|령","法|令")대로, #ruby("관|리","官|吏")가 #ruby("법|령","法|令")에 #ruby("의","依")하여 #ruby("공|평","公|平")히 #ruby("시|행","施|行")한다’ 그러니 ‘#ruby("관|리","官|吏")가 #ruby("자|기","自|己")에게 좋게 하는 #ruby("인|민","人|民")에게는 #ruby("죄","罪")가 있어도 #ruby("벌","罰")하지 않고 #ruby("자|기","自|己")가 미워하는 사람에게는 #ruby("죄","罪")가 가벼워도 무겁게 #ruby("벌","罰")하던 #ruby("구|한|국","舊|韓|國")\(#ruby("대|한|제|국","大|韓|帝|國")) #ruby("시|대","時|代")와는 하늘과 땅의 #ruby("차|이","差|異")가 있다’고 혀가 닳도록 #ruby("과|장","誇|張")하여 말했다. 그런 그놈의 입에다 대고 며칠 #ruby("후","後")에 내가 되물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대의 말이, #ruby("안|악","安|岳")에 가서 보니 #ruby("급|료","給|料")의 많고 적음을 #ruby("불|문","不|問")에 부치고 #ruby("오|직","唯|只") #ruby("성|심","誠|心")으로 #ruby("학|교","學|校")만 잘 되도록 애쓰는 #ruby("선|생","先|生")이라고 #ruby("인|민","人|民") #ruby("일|반","一|般")에게 #ruby("신|앙","信|仰")을 받은 것을 보면, #ruby("김|구","金|龜")는 #ruby("지|방","地|方")의 #ruby("유|공|자","有|功|者") 가운데 하나라고 하지 않았느냐? 더욱이 나에게는 오늘까지 #ruby("범|죄","犯|罪") #ruby("사|실","事|實")이 없고 #ruby("상","賞")을 받을 사람의 #ruby("열","列")에는 있을지라도 #ruby("죄","罪")를 받을 만한 #ruby("사|실","事|實")로 #ruby("인|정","認|定")될 것은 없으니, 어서 #ruby("방|송","放|送")하면 곧 #ruby("학|교","學|校")로 돌아가 #ruby("개|학","開|學")하겠다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“네가 그런 줄 안다만 #ruby("전|답","田|畓")을 사들인 #ruby("지|주","地|主")로서 뭉우리돌을 골라내는 것이 #ruby("상|례","常|例") 아니냐? 네가 아무리 #ruby("범|죄","犯|罪") #ruby("사|실","事|實")을 #ruby("자|백","自|白")하지 않았으나 너의 #ruby("동|류","同|類")가 다 너를 우두머리라 말하였으니, 그것이 #ruby("증|거","證|據")가 되어 끝내 #ruby("죄","罪")를 #ruby("면","免")하기 어렵다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("관|리","官|吏")로서 #ruby("법|률","法|律")을 #ruby("무|시","無|視")하는 것 아니냐?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[하고 내가 #ruby("반|문","反|問")했더니, #ruby("관|리","官|吏")를 #ruby("희|롱","戲|弄")한다고 미친개 #ruby("모|양","模|樣")으로 #ruby("분|기|탱|천","憤|氣|撐|天")해서 죽도록 매질하였다. 그러나 #ruby("왜","倭")놈이 나를 뭉우리돌로 #ruby("인|정","認|定")하는 것은 참 기쁘다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘오냐, 나는 죽어도 뭉우리돌 #ruby("정|신","精|神")을 품고 죽겠고, 살아도 뭉우리돌의 #ruby("책|무","責|務")를 다하리라.’]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[는 생각을 가슴 깊이 새겼다. 나는 죽는 날까지 #ruby("왜|마","倭|魔")의 #ruby("소|위","所|謂") #ruby("법|률","法|律")이란 것을 한 푼이라도 #ruby("파|괴","破|壞")할 수만 있다면 #ruby("계|속","繼|續") #ruby("행","行")하고, #ruby("왜|마","倭|魔")를 #ruby("희|롱","戲|弄")하는 것을 #ruby("유|일","唯|一")한 #ruby("오|락","娛|樂")으로 삼고, #ruby("보|통","普|通")사람으로 맛보기 어려운 #ruby("별|종|생|활","別|種|生|活")의 #ruby("진|수","眞|髓")를 맛보리라고 #ruby("결|심","決|心")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|대|문","西|大|門")에 #ruby("이|감","移|監")할 때에 #ruby("옥|관","獄|官")이 나에게,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("김|구","金|龜")는, 오늘 입고 있던 #ruby("의|복","衣|服")을 벗어 #ruby("집|물|고","什|物|庫")에 #ruby("봉","封")하여 두는 것과 같이 네 #ruby("자|유","自|由")까지 맡겨두고, #ruby("옥|의","獄|衣")를 입고 #ruby("감|옥","監|獄")에 들어왔으니 #ruby("관|리","官|吏")에게 #ruby("복|종","服|從")하는 것뿐이다.”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 한 말을 #ruby("수|긍","首|肯")하였다. #ruby("간|수","看|守")가 다음날 #ruby("복|역","服|役")시킨다면서 #ruby("수|갑","手|匣")을 풀지 않고 #ruby("수|갑","手|匣") #ruby("검|사","檢|査")를 하면서 너무 꽉 잠그는 바람에, 하룻밤 사이에 손목이 퉁퉁 부어서 보기에 끔찍하게 되었다. 다음날 아침 #ruby("검|사","檢|査") 때에 #ruby("간|수","看|守")들이 보고 놀라서 #ruby("이|유","理|由")를 물었다. 나는 #ruby("대|답","對|答")했다.]
