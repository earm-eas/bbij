#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("감|방","監|房")에 들어가서 #ruby("차|례|차|례","次|例|次|例") #ruby("인|사","人|事")를 하며 물어보니, #ruby("혹","或")은 ‘#ruby("강|원|도","江|原|道") #ruby("의|병","義|兵")의 #ruby("참|모|장","參|謀|長")’이니 #ruby("혹","或")은 ‘#ruby("경|기|도","京|畿|道") #ruby("의|병","義|兵")의 #ruby("중|대|장","中|隊|長")’이니 하여, #ruby("대|부|분","大|部|分") #ruby("의|병","義|兵") #ruby("두|령","頭|領")이고 #ruby("졸|병","卒|兵")이라는 사람을 보지 못했다. 처음에는 #ruby("극","極")히 #ruby("존|경","尊|敬")하는 마음으로 #ruby("교|제","交|際")를 #ruby("시|작","始|作")하였으나, 얼마 되지 않아 마음 씀씀이와 #ruby("행|동|거|지","行|動|居|止")가 #ruby("순|전","純|全")한 #ruby("강|도","強|盜")로밖에 보이지 않았다. #ruby("참|모|장","參|謀|長")이라 하는 사람이 #ruby("군|대","軍|隊")의 #ruby("규|율","規|律")이나 #ruby("전|략","戰|略")이 무엇인지조차 알지 못할 뿐 아니라, #ruby("의|병","義|兵")을 일으킨 #ruby("목|적","目|的")이 무엇인지, #ruby("국|가","國|家")가 무엇인지도 모르는 사람이 많았고, #ruby("당|시","當|時") #ruby("무|기","武|器")를 가지고 여러 마을을 #ruby("횡|행","橫|行")하면서 #ruby("만|행","蠻|行")한 것을 잘한 일처럼 큰소리쳤다.]
