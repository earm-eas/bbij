#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[뉘가 알았으랴, 그가 며칠 #ruby("후","後") #ruby("경|성","京|城") #ruby("이|현","泥|峴")에서 군밤장수로 #ruby("가|장","假|裝")하고서 #ruby("충|천","衝|天")하는 #ruby("의|기","意|氣")를 품고 #ruby("이|완|용","李|完|用")을 #ruby("저|격","狙|擊")하여 #ruby("조|선","朝|鮮") #ruby("천|지","天|地")를 #ruby("진|동","震|動")하게 할 #ruby("이|재|명","李|在|明") #ruby("의|사","義|士")인 줄을.#footnote(numbering: _ => [36)])[#h(0.35em)위의 #ruby("이|현","泥|峴")은 #ruby("종|현","鍾|峴")의 #ruby("착|오","錯|誤"). #ruby("이|재|명","李|在|明")의 #ruby("의|거","義|擧")는 1909#ruby("년","年") 12#ruby("월","月") 22#ruby("일","日") #ruby("종|현|천|주|교|성|당","鍾|峴|天|主|敎|聖|堂")\(#ruby("현","現") #ruby("명|동|성|당","明|洞|聖|堂")) 앞에서 일어났다.] 그는 먼저 #ruby("인|력|거","人|力|車")를 끄는 #ruby("차|부","車|夫")를 죽이고 #ruby("이|완|용","李|完|用")의 #ruby("생|명","生|命")은 다 빼앗지 못하고 #ruby("체|포","逮|捕")되어 #ruby("순|국","殉|國")하였던 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그때 우리의 #ruby("요|청","要|請")에 #ruby("응","應")하여 나이 23〜4#ruby("세","歲")의 #ruby("청|년","靑|年")이 눈썹 가에 #ruby("분|기","憤|氣")를 띠고 들어섰다. 우리 두 사람이 돌아가며 #ruby("인|사","人|事")를 했는데, #ruby("자|기","自|己")는 #ruby("이|재|명","李|在|明")이고 #ruby("수|개|월","數|個|月") #ruby("전","前")에 #ruby("미|주","美|洲")로부터 #ruby("귀|국","歸|國")하였다고 했다. #ruby("평|양","平|壤")의 #ruby("오|인|성","吳|仁|星")이란 #ruby("여|자","女|子")와 #ruby("결|혼","結|婚")하여 지내는바, #ruby("자|기","自|己") #ruby("부|인","夫|人")의 #ruby("가|정","家|庭")은 #ruby("과|부","寡|婦")인 #ruby("장|모","丈|母")가 딸 셋을 데리고 지내는데 #ruby("가|세","家|勢")가 #ruby("풍|족","豊|足")하여 딸들을 #ruby("교|육","敎|育")시켰지만, #ruby("국|가","國|家")의 #ruby("대|사","大|事")에 #ruby("충|성","忠|誠")을 바칠 #ruby("용|기","勇|氣")가 없고 #ruby("구|차","苟|且")하게 #ruby("안|일","安|逸")에만 빠져 #ruby("자|기","自|己")의 #ruby("의|기","意|氣")와 #ruby("충|성","忠|誠")을 #ruby("이|해","理|解")하지 못한다고 했다. 그리고 이 때문에 #ruby("자|기","自|己") #ruby("부|부|간","夫|婦|間")에 다툼거리가 생겨 #ruby("학|교","學|校")에 #ruby("손|해","損|害")가 될까 #ruby("우|려","憂|慮")된다고 #ruby("기|탄","忌|憚")없이 말하였다.#footnote(numbering: _ => [37)])[#h(0.35em)#ruby("이|재|명","李|在|明") #ruby("의|사","義|士")의 #ruby("부|인","夫|人")은 #ruby("거|사","擧|事") #ruby("전","前") 마지막 #ruby("작|별","作|別")에서 울지도 않았고 #ruby("만|류","挽|留")하지도 않았다고 한다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("계|원","桂|園") #ruby("형","兄")과 내가 #ruby("이|의|사","李|義|士")에게 #ruby("장|래","將|來")에 #ruby("목|적","目|的")하는 일과 #ruby("과|거","過|去") #ruby("경|력","經|歷")·#ruby("학|식","學|識") #ruby("등","等")을 #ruby("일|일","一|一")이 물으니, #ruby("자|기","自|己")는 어려서 #ruby("하|와|이","夏|威|夷")에 건너가서 #ruby("공|부","工|夫")하다, #ruby("조|국","祖|國")이 섬 #ruby("왜","倭")놈에게 #ruby("강|점","强|占")되었단 #ruby("소|식","消|息")을 듣고 #ruby("귀|국","歸|國")하였으며, #ruby("지|금","只|今") 하려는 일은 #ruby("매|국|노","賣|國|奴") #ruby("이|완|용","李|完|用")을 #ruby("위|시","爲|始")하여 몇 놈을 죽이고자 #ruby("준|비","準|備")#ruby("중","中")이라고 했다. 그리고 #ruby("단|도","短|刀") 한 자루, #ruby("단|총","短|銃") 한 #ruby("정","挺")과 #ruby("이|완|용","李|完|用") #ruby("등","等")의 #ruby("사|진","寫|眞") 몇 #ruby("장","張")을 품속에서 내놓았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("계|원","桂|園")과 나는 #ruby("동|일","同|一")한 #ruby("관|찰","觀|察")로 그를, #ruby("시|세","時|勢")의 #ruby("격|변","激|變") 때문에 헛된 #ruby("열|정","熱|情")에 들뜬 #ruby("청|년","靑|年")으로 보았다. #ruby("계|원","桂|園")이 #ruby("이|의|사","李|義|士")의 손을 잡고 #ruby("간|곡","懇|曲")히 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("군","君")이 #ruby("국|사","國|事")에 #ruby("비|분","悲|憤")하여 #ruby("용|기","勇|氣") 있게 #ruby("활|동","活|動")하는 것은 #ruby("극","極")히 #ruby("가|상","可|尙")하나, 큰일을 #ruby("도|모","圖|謀")하고자 하는 #ruby("대|장|부","大|丈|夫")가 #ruby("총|기","銃|器")로 #ruby("자|기","自|己") #ruby("부|인","夫|人")을 #ruby("위|협","威|脅")하고 동네에서 #ruby("총","銃")을 마구 쏘아 #ruby("민|심","民|心")을 #ruby("요|란","擾|亂")케 하는 것은 #ruby("의|지","意|志")가 #ruby("확|고","確|固")하지 못한 #ruby("표|징","表|徵")이오. 그러니 #ruby("지|금","只|今") 칼과 #ruby("총","銃")을 나에게 맡겨두고, #ruby("의|지","意|志")를 더욱 #ruby("강","强")하고 굳게 #ruby("수|양","修|養")하고 #ruby("동|지","同|志")도 더 사귀고 얻어서, #ruby("실|행","實|行")할 수 있을 때 #ruby("총","銃")과 칼을 찾아가는 것이 어떠하오?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("의|사","義|士")는 한참 쳐다보다가 #ruby("총","銃")과 칼을 #ruby("계|원","桂|園")에게 주었지만, #ruby("안|색","顔|色")에는 즐겁지 못한 #ruby("기|색","氣|色")이 #ruby("역|력","歷|歷")하였다. 그와 #ruby("작|별","作|別")하고 #ruby("사|리|원|역","沙|里|院|驛")에서 #ruby("차","車")가 막 떠나려 할 때, #ruby("홀|연","忽|然")히 #ruby("이|의|사","李|義|士")가 나타나 #ruby("계|원","桂|園")에게 #ruby("물|품","物|品")의 #ruby("반|환","返|還")을 #ruby("요|구","要|求")하였다. #ruby("계|원","桂|園")은 웃으면서 “#ruby("경|성","京|城") 와서 찾으시오” 하고 말하는 사이, #ruby("기|차","汽|車")가 떠났다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런 지 한 달이 못 되어 #ruby("의|사","義|士")는 #ruby("동|지","同|志") 몇 #ruby("명","名")과 함께 #ruby("경|성","京|城")에 #ruby("도|착","到|着")하였다. #ruby("이|현","泥|峴")에서 #ruby("이|의|사","李|義|士")는 군밤장수로 #ruby("가|장","假|裝")하고 길가에서 밤을 팔다가 #ruby("이|완|용","李|完|用")을 칼로 찔렀다. #ruby("이|완|용","李|完|用")은 #ruby("생|명","生|命")이 #ruby("위|험","危|險")하고, #ruby("이|의|사","李|義|士")와 #ruby("김|정|익","金|貞|益"), #ruby("김|용|문","金|龍|文"), #ruby("전|태|선","全|泰|善"), #ruby("오","吳")◯◯ #ruby("등","等") 여러 사람이 #ruby("체|포","逮|捕")되었다는 #ruby("사|건","事|件")이 #ruby("신|문","新|聞")에 #ruby("게|재","揭|載")되었다.#footnote(numbering: _ => [38)])[#h(0.35em)#ruby("이|재|명","李|在|明") #ruby("의|사","義|士")는 #ruby("이|완|용","李|完|用")을, #ruby("김|정|익","金|貞|益")이 #ruby("이|용|구","李|容|九")를, #ruby("이|동|수","李|東|秀")가 #ruby("송|병|준","宋|秉|畯")을 #ruby("담|당","擔|當")하기로 되어 있었다. #ruby("백|범","白|凡")이 이름을 #ruby("기|억","記|憶")하지 못하는 #ruby("오|군","吳|君")은 뒤에 #ruby("서|대|문|감|옥","西|大|門|監|獄")에서 만나는 #ruby("오|복|원","吳|復|元")이다. #ruby("전|태|선","全|泰|善")은 #ruby("원|문","原|文")에 ‘田泰善’으로 잘못 #ruby("기|록","記|錄")돼 있다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 깜짝 놀랐다. #ruby("이|의|사","李|義|士")가 #ruby("단|총","短|銃")을 #ruby("사|용","使|用")하였다면 #ruby("국|적","國|賊") #ruby("이|완|용","李|完|用")의 목숨을 #ruby("확|실","確|實")히 끊었을 것인데, 눈먼 우리가 #ruby("간|섭","干|涉")하여 #ruby("무|기","武|器")를 빼앗는 바람에 #ruby("충|분","充|分")한 #ruby("성|공","成|功")을 못한 것이다. #ruby("한|탄","恨|歎")과 #ruby("후|회","後|悔")가 그치지 않았다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[5) #ruby("신|민|회","新|民|會")와 #ruby("안|악","安|岳") #ruby("사|건","事|件")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("기|록","記|錄")의 #ruby("선|후","先|後")가 #ruby("전|도","顚|倒")되었다. #ruby("오|호","嗚|呼")라! #ruby("국|가","國|家")는 #ruby("병|탄","倂|呑")된 뒤였다. #ruby("국|가","國|家")가 #ruby("합|병","合|併")의 #ruby("치|욕","恥|辱")을 당한 #ruby("당|시","當|時")의 #ruby("인|심","人|心")은 매우 #ruby("흉|흉","洶|洶")하였다. #ruby("원|로|대|신","元|老|大|臣")과 #ruby("내|외","內|外") #ruby("관|리","官|吏")들 #ruby("중","中") #ruby("자|살","自|殺")하는 #ruby("자","者")도 많았고 #ruby("교|육|계","敎|育|界")의 #ruby("배|일|사|상","排|日|思|想")이 #ruby("극|도","極|度")에 달했다. 오직 듣지도 못하고 알지도 못하는 #ruby("농|민","農|民")들 #ruby("중","中")에는 #ruby("합|병","合|併")이 무엇인지, #ruby("망|국","亡|國")이 무엇인지 모르고 있는 #ruby("자","者")도 많았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나부터 #ruby("망|국","亡|國")의 #ruby("치|욕","恥|辱")을 당하고 나라 없는 아픔을 느끼나, 사람이 사랑하는 #ruby("자|식","子|息")을 잃으면 슬퍼하면서도 살아날 것 같은 #ruby("생|각","生|覺")이 나는 것처럼, 나라가 #ruby("망","亡")하였으나 #ruby("국|민","國|民")이 #ruby("일|치","一|致") #ruby("분|발","奮|發")하면 곧 #ruby("국|권","國|權")이 #ruby("회|복","回|復")될 것같이 #ruby("생|각","生|覺")되었다. 그렇게 하려면 #ruby("후|세","後|世")들의 #ruby("애|국|심","愛|國|心")을 #ruby("앙|양","昂|揚")하여 #ruby("장|래","將|來")에 #ruby("광|복","光|復")하는 길밖에 없다고 #ruby("생|각","生|覺")되어, #ruby("계|속","繼|續")하여 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("확|장","擴|張")하고 #ruby("중|소|학|부","中|小|學|部")에 #ruby("학|생","學|生")을 늘려 #ruby("모|집","募|集")하면서 #ruby("교|장","校|長")의 #ruby("임|무","任|務")를 다했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이에 앞서 #ruby("국|내","國|內") #ruby("국|외","國|外")를 #ruby("통","通")하여 #ruby("정|치|적","政|治|的") #ruby("비|밀|결|사","祕|密|結|社")가 #ruby("조|직","組|織")되니, 곧 #ruby("신|민|회","新|民|會")였다. #ruby("안|창|호","安|昌|浩")는 #ruby("미|주","美|洲")로부터 #ruby("귀|국","歸|國")하여 #ruby("평|양","平|壤")에 #ruby("대|성|학|교","大|成|學|校")를 #ruby("병|설","竝|設")하여 #ruby("청|년","靑|年")을 #ruby("교|육","敎|育")하는 것을 #ruby("표|면","表|面")의 #ruby("사|업","事|業")으로 내세우면서 #ruby("이|면","裏|面")에서는, #ruby("양|기|탁","梁|起|鐸")·#ruby("안|태|국","安|泰|國")·#ruby("이|승|훈","李|昇|薰")·#ruby("전|덕|기","全|德|基")·#ruby("이|동|녕","李|東|寧")·#ruby("주|진|수","朱|鎭|洙")·#ruby("이|갑","李|甲")·#ruby("이|종|호","李|鍾|浩")·#ruby("최|광|옥","崔|光|玉")·#ruby("김|홍|량","金|鴻|亮")과 #ruby("그|외","其|外") 몇 사람을 #ruby("중|심","中|心")으로 하여 #ruby("당|시","當|時") 400#ruby("여","餘") #ruby("명","名") #ruby("정|수|분|자","精|粹|分|子")로 #ruby("조|직","組|織")된 #ruby("단|체","團|體"), #ruby("즉","卽") #ruby("신|민|회","新|民|會")#footnote(numbering: _ => [39)])[#h(0.35em)1907#ruby("년","年") #ruby("도|산","島|山") #ruby("안|창|호","安|昌|浩")가 #ruby("미|국","美|國")에서 #ruby("귀|국","歸|國")하여 그해 4#ruby("월","月") #ruby("이|갑","李|甲")·#ruby("전|덕|기","全|德|基")·#ruby("양|기|탁","梁|起|鐸") #ruby("등","等")과 같이 #ruby("조|직","組|織")한 #ruby("비|밀|결|사","祕|密|結|社"). #ruby("총|감|독","總|監|督")에 #ruby("양|기|탁","梁|起|鐸"), #ruby("총|서|기","總|書|記")에 #ruby("이|동|녕","李|東|寧"), #ruby("재|무","財|務")에 #ruby("전|덕|기","全|德|基"), #ruby("집|행|원","執|行|員")에 #ruby("안|창|호","安|昌|浩")를 #ruby("선|출","選|出")하였다.]를 #ruby("훈|련","訓|鍊")·#ruby("지|도","指|導")하였다. 그 때문에 #ruby("안|창|호","安|昌|浩")는 #ruby("용|산","龍|山") #ruby("헌|병|대","憲|兵|隊")에 잡혀 #ruby("수|감","收|監")된 일도 있었다.#footnote(numbering: _ => [40)])[#h(0.35em)#ruby("안|창|호","安|昌|浩")는 #ruby("안|중|근","安|重|根") #ruby("의|사","義|士") #ruby("의|거","義|擧") #ruby("관|련","關|聯") #ruby("혐|의","嫌|疑")로 3#ruby("개|월|간","個|月|間") #ruby("수|감","收|監")된 적이 있다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("합|병","合|併")된 #ruby("후","後")에는 이른바 #ruby("주|의|인|물","注|意|人|物")을 #ruby("일|망|타|진","一|網|打|盡")할 것으로 #ruby("예|상","豫|想")함이었던지, #ruby("안|창|호","安|昌|浩")는 미리 #ruby("비|밀|리","祕|密|裏")에 #ruby("장|연|군","長|淵|郡") #ruby("송|천","松|川")에서 #ruby("위|해|위","威|海|衛")로 몰래 건너가고, #ruby("이|종|호","李|鍾|浩")·#ruby("이|갑","李|甲")·#ruby("유|동|열","柳|東|說") #ruby("동|지","同|志")가 이어 #ruby("압|록|강","鴨|綠|江")을 건넜다.#footnote(numbering: _ => [41)])[#h(0.35em)#ruby("원|문","原|文"): “威海尉”. ‘尉’는 ‘衛’. #ruby("위|해|위","威|海|衛")는 #ruby("중|국","中|國") #ruby("산|동|반|도","山|東|半|島") 끝에 #ruby("위|치","位|置")한 #ruby("도|시","都|市")로, #ruby("현","現") #ruby("지|명","地|名")은 #ruby("위|해","威|海"). 1398#ruby("년","年") #ruby("명","明")나라 때 #ruby("왜|구","倭|寇")의 #ruby("습|격","襲|擊")에 #ruby("대|비","對|備")하여 이곳에 #ruby("기|지","基|地")를 #ruby("설|치","設|置")하고 ‘#ruby("위|해|위","威|海|衛")’라는 #ruby("군|대","軍|隊")를 두었다. #ruby("신|민|회","新|民|會")는 1910#ruby("년","年") 3#ruby("월","月") #ruby("만|주","滿|洲")에 #ruby("무|관|학|교","武|官|學|校") #ruby("설|립","設|立")과 #ruby("독|립|군","獨|立|軍") #ruby("기|지","基|地") #ruby("창|건","創|建")을 #ruby("결|정","決|定")하였고, 이를 #ruby("위","爲")해 4#ruby("월","月") #ruby("안|창|호","安|昌|浩")·#ruby("이|갑","李|甲") #ruby("등","等")이 #ruby("출|국","出|國")하였다. #ruby("안|창|호","安|昌|浩")는 #ruby("중|국","中|國") #ruby("산|동|성","山|東|省")으로 #ruby("망|명","亡|命")하여 이른바 ‘#ruby("청|도|회|의","靑|島|會|議")’를 #ruby("소|집","召|集")하였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("경|성","京|城")에서 #ruby("양|기|탁","梁|起|鐸")#footnote(numbering: _ => [42)])[#h(0.35em)#ruby[양|기|탁][梁|起|鐸]\(1871〜1938). 배델(Bethell, E. T.)과 같이 『#ruby("대|한|매|일|신|보","大|韓|每|日|申|報")』를 만들어 #ruby("일|제","日|帝")를 #ruby("규|탄","糾|彈")하고, #ruby("신|민|회","新|民|會")에서도 #ruby("중|심|적","中|心|的")인 #ruby("역|할","役|割")을 하였다.]이 #ruby("주|최","主|催")하는 #ruby("비|밀|회|의","祕|密|會|議") #ruby("통|지","通|知")를 받고 나도 달려가 #ruby("참|석","參|席")했다. #ruby("양|기|탁","梁|起|鐸")의 집에 #ruby("출|석","出|席")된 #ruby("인|원","人|員")은 #ruby("양|기|탁","梁|起|鐸")·#ruby("이|동|녕","李|東|寧")·#ruby("안|태|국","安|泰|國")·#ruby("주|진|수","朱|鎭|洙")·#ruby("이|승|훈","李|昇|薰")·#ruby("김|도|희","金|道|熙")·#ruby("김|구","金|龜") #ruby("등","等")이었다. #ruby("비|밀|회|의","祕|密|會|議")를 열어 #ruby("지|금","只|今") #ruby("왜","倭")가 #ruby("경|성","京|城")에 이른바 #ruby("총|감|부","總|監|府")라는 것을 #ruby("설|치","設|置")하고 #ruby("전|국","全|國")을 #ruby("통|치","統|治")하니, 우리도 #ruby("경|성","京|城")에 #ruby("비|밀|리","祕|密|裏")에 #ruby("도|독|부","都|督|府")를 #ruby("설|치","設|置")하여 #ruby("전|국","全|國")을 다스릴 것, #ruby("만|주","滿|洲")에 #ruby("이|민|계|획","移|民|計|劃")을 #ruby("실|시","實|施")할 것과 #ruby("무|관|학|교","武|官|學|校")를 #ruby("설|립","設|立")하고 #ruby("장|교","將|校")를 #ruby("양|성","養|成")하여 #ruby("광|복|전|쟁","光|復|戰|爭")을 일으킬 것, 이를 #ruby("준|비","準|備")하기 #ruby("위","爲")해 #ruby("이|동|녕","李|東|寧")을 먼저 #ruby("만|주","滿|洲")에 #ruby("파|송","派|送")하여 #ruby("토|지","土|地") #ruby("매|수","買|收"), #ruby("가|옥","家|屋") #ruby("건|축","建|築")과 #ruby("기|타","其|他") #ruby("일|반","一|般")을 #ruby("위|임","委|任")하고, 그 나머지 #ruby("참|석","參|席")한 #ruby("인|원","人|員")으로 #ruby("각","各") #ruby("지|방","地|方") #ruby("대|표","代|表")를 #ruby("선|정","選|定")하여, 15#ruby("일","日") #ruby("이|내","以|內")에 #ruby("황|해|도","黃|海|道")에서 #ruby("김|구","金|龜")가 15#ruby("만","萬") #ruby("원","元"), #ruby("평|남","平|南")의 #ruby("안|태|국","安|泰|國")이 15#ruby("만","萬") #ruby("원","元"), #ruby("평|북","平|北") #ruby("이|승|훈","李|昇|薰")이 15#ruby("만","萬") #ruby("원","元"), #ruby("강|원","江|原")의 #ruby("주|진|수","朱|鎭|洙")가 10#ruby("만","萬") #ruby("원","元"), #ruby("경|성","京|城")의 #ruby("양|기|탁","梁|起|鐸")이 20#ruby("만","萬") #ruby("원","元")을 #ruby("모|집","募|集")하여, #ruby("이|동|녕","李|東|寧")의 뒤를 #ruby("파|송","派|送")하기로 #ruby("의|결","議|決")하고 #ruby("즉|각","卽|刻") #ruby("출|발","出|發")하였다.#footnote(numbering: _ => [43)])[#h(0.35em)#ruby("신|민|회","新|民|會")는 1910#ruby("년","年") 가을 #ruby("이|동|녕","李|東|寧")·#ruby("이|시|영","李|始|榮")이 #ruby("독|립|운|동","獨|立|運|動") #ruby("기|지","基|地")의 #ruby("후|보|지","候|補|地")를 #ruby("답|사","踏|査")하기 #ruby("위","爲")해 #ruby("만|주","滿|洲")로 갔고, 12#ruby("월","月") #ruby("중|순","中|旬") 그들로부터 #ruby("보|고","報|告")받고 #ruby("단|체","團|體") #ruby("이|주","移|住")를 #ruby("위","爲")한 #ruby("구|체|적","具|體|的")인 #ruby("대|책","對|策") 마련에 들어갔다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[경|술|년][庚|戌|年]\(1910, 35#ruby("세","歲")) 11#ruby("월","月") 20#ruby("일","日") 이른 아침에 #ruby("양|기|탁","梁|起|鐸")의 #ruby("친|동|생","親|同|生") #ruby("인|탁","寅|鐸")과 그의 #ruby("부|인","夫|人")이 #ruby("동|행","同|行")하여 #ruby("사|리|원|역","沙|里|院|驛")에서 #ruby("하|차","下|車")하였다. #ruby("인|탁","寅|鐸") #ruby("부|부","夫|婦")는 #ruby("재|령","載|寧")#footnote(numbering: _ => [44)])[#h(0.35em)#ruby("원|주","原|註"): “寅鐸은 載寧 裁判所 書記로 赴任의 途次에 同行한 것 　이고 우리의 秘密計劃을 通情치 안은 것은 起鐸부터 親弟의게 事情을 勿說하라고 우리의게 付托한 것이라”.]으로, 나는 #ruby("안|악","安|岳")으로 돌아왔다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("김|홍|량","金|鴻|亮")과 #ruby("협|의","協|議")하여 #ruby("토|지","土|地")와 #ruby("가|산","家|産")을 팔기 #ruby("시|작","始|作")했고, #ruby("신|천","信|川") #ruby("유|문|형","柳|文|馨") #ruby("등","等") 몇 사람과 이웃 #ruby("군","郡") #ruby("동|지","同|志")에게 #ruby("장|래","將|來") #ruby("방|침","方|針")을 #ruby("은|밀","隱|密")히 알려 #ruby("계|획","計|劃")을 #ruby("진|행","進|行")해 가던 #ruby("중","中")이었다. 그때 #ruby("장|연","長|淵")의 #ruby("이|명|서","李|明|瑞")가 #ruby("자|기","自|己") #ruby("모|친","母|親")과 #ruby("친|동|생","親|同|生") #ruby("명|선","明|善")을 데리고 #ruby("서|간|도","西|間|島")에 먼저 가서 뒤에 #ruby("도|착","到|着")하는 #ruby("동|지","同|志")들의 #ruby("편|의","便|宜")를 #ruby("제|공","提|供")하겠다며 #ruby("안|악","安|岳")으로 찾아왔기에, #ruby("북|행","北|行")을 #ruby("인|도","引|導")하여 #ruby("출|발","出|發")시켰다.#footnote(numbering: _ => [45)])[#h(0.35em)#ruby("원|주","原|註"): “李明瑞는 南滿에 渡하엿다가 同志 十五人을 引率하고 國內에 潛入하야 殷栗郡守를 射殺하고 倭守備隊와 極熱히 싸오다가 敵彈에 殉國하엿다”.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳")에 돌아와 #ruby("소|문","所|聞")을 들으니, #ruby("안|명|근","安|明|根")#footnote(numbering: _ => [46)])[#h(0.35em)#ruby[안|명|근][安|明|根]\(1879〜1927). #ruby("황|해|도","黃|海|道") #ruby("신|천","信|川") #ruby("출|생","出|生"). #ruby("안|중|근","安|重|根")의 #ruby("사|촌","四|寸") #ruby("동|생","同|生"). #ruby("호","號")는 #ruby("매|산","梅|山"). 1910#ruby("년","年") #ruby("국|권","國|權")이 #ruby("침|탈","侵|奪")당하자 #ruby("무|관|학|교","武|官|學|校") #ruby("설|립","設|立")을 #ruby("위","爲")해 #ruby("황|해|도","黃|海|道")의 #ruby("신|석|효","申|錫|孝") #ruby("등","等")으로부터 #ruby("자|금","資|金")을 모으다가 #ruby("밀|고","密|告")로 #ruby("체|포","逮|捕")되었다.]이 #ruby("안|악","安|岳")에 와서 나를 여러 #ruby("차|례","次|例") 찾았으나, 나의 #ruby("경|성|행","京|城|行")으로 서로 어긋나 만나지 못하였다는 것이다. 그런데 어느날 갑자기 밤#ruby("중","中")에 #ruby("명|근","明|根")이 #ruby("양|산|학|교","楊|山|學|校")로 찾아왔다. 그는 #ruby("자|기","自|己")가 #ruby("해|서","海|西")의 #ruby("각","各") #ruby("군","郡") #ruby("부|호","富|豪")를 #ruby("다|수","多|數") 만나본 #ruby("결|과","結|果") 모두 #ruby("독|립|운|동","獨|立|運|動") #ruby("자|금","資|金")을 #ruby("허|락","許|諾")하고도 #ruby("신|속","迅|速")히 추렴에 #ruby("응","應")하지 않아, #ruby("안|악|읍","安|岳|邑") 몇몇 #ruby("부|호","富|豪")를 #ruby("총|기","銃|器")로 #ruby("위|협","威|脅")하여 #ruby("타|지|방","他|地|方")에 #ruby("영|향","影|響")을 미치게 할 #ruby("목|적","目|的")이니, #ruby("응|원","應|援")·#ruby("지|도","指|導")해 주기를 #ruby("청","請")했다.]
