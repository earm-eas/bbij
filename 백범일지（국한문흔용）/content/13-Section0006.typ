#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("정|순|만","鄭|淳|萬")의 #ruby("인|도","引|導")로 #ruby("교|회|당","敎|會|堂")에서 #ruby("맹|세","盟|誓")의 #ruby("기|도","祈|禱")를 하고, 모두 #ruby("대|한|문","大|漢|門") 앞으로 나갔다. #ruby("서|명","署|名")한 다섯 사람만 #ruby("궐|문","闕|門") 밖에서 #ruby("형|식|상","形|式|上")으로 #ruby("회|의","會|議")를 열어 #ruby("상|소","上|疏")를 #ruby("의|결","議|決")하였지만, #ruby("상|소|장","上|疏|章")은 벌써 #ruby("별|감","別|監")들의 #ruby("협|조","協|助")로 #ruby("상|감","上|監")께 올려졌다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그런데 갑자기 #ruby("왜","倭")놈 #ruby("순|사|대","巡|査|隊")가 달려와서 #ruby("간|섭","干|涉")했다. 다섯 사람이 #ruby("일|시","一|時")에 #ruby("왜","倭")놈 #ruby("순|사","巡|査")에게 달려들어 #ruby("내|정|간|섭","內|政|干|涉")을 #ruby("규|탄","糾|彈")하였다. #ruby("즉|각","卽|刻") #ruby("대|한|문","大|漢|門") 앞에는 #ruby("왜","倭")놈의 칼이 번쩍번쩍 빛났고 다섯 #ruby("지|사","志|士")는 맨주먹으로 싸움을 #ruby("시|작","始|作")하였다. #ruby("근|처","近|處")에서 #ruby("호|위","護|衛")하던 우리들은 소리를 #ruby("벽|력","霹|靂")같이 지르며, “#ruby("왜","倭")놈이 #ruby("국|권","國|權")을 #ruby("강|탈","強|奪")하고 #ruby("조|약","條|約")을 #ruby("강|제","强|制")로 #ruby("체|결","締|結")하는데, 우리 #ruby("인|민","人|民")은 #ruby("원|수","怨|讐")의 #ruby("노|예","奴|隸")가 되어 살 것인가 #ruby("의","義")롭게 죽을 것인가” 하는 #ruby("격|분","激|憤")한 #ruby("연|설","演|說")을 곳곳에서 하니 #ruby("인|심","人|心")이 #ruby("흉|흉","洶|洶")해졌다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[다섯 #ruby("지|사","志|士")는 #ruby("경|무|청","警|務|廳")에 #ruby("감|금","監|禁")되었는데 #ruby("심|문","訊|問")하는 것을 보니 #ruby("결|국","結|局") #ruby("훈|방","訓|放")할 #ruby("모|양","模|樣")이었다. 우리는 #ruby("계|속","繼|續") #ruby("상|소","上|疏")하는 것을 그만두고, #ruby("종|로","鍾|路")에서 #ruby("공|개|연|설","公|開|演|說")을 하다 #ruby("금|지","禁|止")당하면 #ruby("대|대|적","大|大|的")인 #ruby("육|박|전","肉|薄|戰")을 #ruby("전|개","展|開")하기로 했다. #ruby("종|로","鍾|路")에서 #ruby("연|설","演|說")을 하니 #ruby("왜|순|사","倭|巡|査")가 칼을 뽑아들었다. #ruby("연|설","演|說")하던 #ruby("청|년","靑|年")이 맨손으로 달려들어 발로 차 #ruby("왜|순|사","倭|巡|査")를 땅에 거꾸러뜨리자, #ruby("왜","倭")놈들이 #ruby("총","銃")을 쏘기 #ruby("시|작","始|作")했다. 그때 마침 #ruby("어|물|전","魚|物|廛") #ruby[도매점][魚廛都家]이 #ruby("화|재","火|災")를 당한 뒤라 기와조각이 #ruby("산","山")처럼 쌓여 있어, 우리 몇 사람이 그 기와조각을 #ruby("왜|순|사|대","倭|巡|査|隊")를 #ruby("향","向")해 던지며 #ruby("접|전","接|戰")이 #ruby("시|작","始|作")되었다. #ruby("왜|순|사","倭|巡|査")놈들은 #ruby("중|국|인","中|國|人") #ruby("상|점","商|店")에 #ruby("침|입","侵|入")하여 #ruby("잠|복","潛|伏")한 채 #ruby("총","銃")을 #ruby("발|사","發|射")하였다. #ruby("군|중","群|衆")이 기와조각을 #ruby("중|국","中|國") #ruby("점|포","店|舖")에 던지자, #ruby("왜|보|병","倭|步|兵") 1#ruby("개","個") #ruby("중|대","中|隊")가 #ruby("포|위","包|圍")하여 #ruby("공|격","攻|擊")했다. #ruby("인|산|인|해","人|山|人|海")를 이루던 #ruby("군|중","群|衆")은 제#ruby("각|각","各|各") 흩어졌고, #ruby("왜","倭")놈들은 #ruby("한|인","韓|人")을 잡히는 대로 #ruby("포|박","捕|縛")하니 #ruby("수|십","數|十") #ruby("명","名")이 #ruby("체|포","逮|捕")·#ruby("감|금","監|禁")되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그날 #ruby("민|영|환","閔|泳|煥")#footnote(numbering: _ => [5)])[#h(0.35em)#ruby[민|영|환][閔|泳|煥]\(1861〜1905). #ruby("민|영|환","閔|泳|煥")은 1905#ruby("년","年") #ruby("을|사|늑|약","乙|巳|勒|約")이 #ruby("체|결","締|結")되자 이를 #ruby("반|대","反|對")하는 #ruby("상|소","上|疏")를 올렸고, 그 #ruby("효|과","效|果")가 없자 1905#ruby("년","年") 11#ruby("월","月") 30#ruby("일","日") #ruby("국|민","國|民")과 #ruby("각|국","各|國") #ruby("공|사","公|使")에게 고하는 #ruby("유|서","遺|書")를 남기고 #ruby("자|결","自|決")하였다. #ruby("시|호","諡|號")는 #ruby("충|정","忠|正").]이 #ruby("자|결","自|決")하였다. 그 #ruby("보|도","報|道")를 접하고 몇몇 #ruby("동|지","同|志")들과 같이 #ruby("민|영|환","閔|泳|煥") 댁에 가서 #ruby("조|문","弔|問")을 마치고 돌아서 큰 #ruby("도|로","道|路")에 나오는 때였다. 나이가 #ruby("사|십","四|十") 안팎쯤 되어 보이는 어떤 한 사람이, 흰 #ruby("명|주","明|紬")저고리에 갓 #ruby("망|건","網|巾")도 없이 맨상투 바람으로 #ruby("의|복","衣|服")에 핏자국이 얼룩덜룩한 채 여러 사람의 #ruby("호|위","護|衛")를 받으며 #ruby("인|력|거","人|力|車")에 실려가는데, 크게 소리치며 울부짖는 것이었다. 누구냐고 물으니, #ruby("참|찬","參|贊") #ruby("이|상|설","李|相|卨")#footnote(numbering: _ => [6)])[#h(0.35em)#ruby[이|상|설][李|相|卨]\(1870〜1917). 이 #ruby("시|기","時|期") #ruby("선|구|적","先|驅|的")인 #ruby("풍|운","風|雲")의 #ruby("민|족|운|동|가","民|族|運|動|家"). 그는 #ruby("을|사|늑|약","乙|巳|勒|約")을 #ruby("전|후","前|後")하여 #ruby("일|본","日|本")을 #ruby("규|탄","糾|彈")하는 #ruby("상|소|운|동","上|疏|運|動")을 #ruby("주|도","主|導")하고, 1906#ruby("년","年") #ruby("북|간|도","北|間|島") #ruby("용|정","龍|井")으로 #ruby("망|명","亡|命")하였다. 그는 1907#ruby("년","年") #ruby("고|종","高|宗")의 #ruby("밀|사","密|使")로 #ruby("헤이그","海牙")에 갔으며, 그것이 #ruby("실|패","失|敗")하자 #ruby("러|시|아","俄|西|亞") #ruby("연|해|주","沿|海|州")로 가서 #ruby("권|업|회","勸|業|會")를 #ruby("조|직","組|織")하였다.]인데 #ruby("자|살","自|殺") #ruby("미|수","未|遂")에 그쳤다 한다. 그이도 나라일이 날로 잘못되어 감을 보고 #ruby("의|분","義|憤")을 못 이겨 #ruby("자|살","自|殺")하려던 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|초","當|初") #ruby("상|동|회|의","尙|洞|會|議")에서는 다섯 #ruby("내|지","乃|至") 여섯 사람이 한 #ruby("조","組")가 되어 몇 #ruby("차|례","次|例")든 비록 앞사람이 죽더라도 뒷사람은 이어 #ruby("계|속","繼|續")하기로 하였으나, #ruby("상|소","上|疏")하여 #ruby("체|포","逮|捕")당한 #ruby("지|사","志|士")들을 몇십 #ruby("일","日") #ruby("구|류","拘|留")에만 #ruby("처","處")하고 말 #ruby("정|황","情|況")이니 #ruby("계|속","繼|續")할 #ruby("필|요","必|要")가 없어졌다. 아무리 #ruby("급|박","急|迫")하여도 #ruby("국|가|흥|망","國|家|興|亡")에 대한 #ruby("절|실","切|實")한 #ruby("각|오","覺|悟")가 적은 #ruby("민|중","民|衆")과 더불어서는 무슨 일이나 #ruby("실|효","實|效") 있게 할 수가 없다. 바꿔 말하면 아직 #ruby("민|중","民|衆")의 #ruby("애|국|사|상","愛|國|思|想")이 #ruby("박|약","薄|弱")한 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("칠|년|병","七|年|病") #ruby("삼|년|애","三|年|艾")”#footnote(numbering: _ => [7)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “7#ruby("년","年") 묵은 #ruby("병","病")에 3#ruby("년","年") 묵은 쑥을 구한다”. #ruby("원|래","原|來")는 ‘七年之病 求三年艾’으로 #ruby("범|순|인","范|純|仁")의 말. 7#ruby("년","年") 동안이나 오래 앓은 고생한 #ruby("병","病")에 3#ruby("년","年") 걸리지 않으면 #ruby("생|장","生|長")할 수 없는 쑥을 구한다는 것으로, #ruby("평|소","平|素")에 미리 갖추어 놓지 않고 #ruby("필|요","必|要")한 때 급히 구하면 얻지 못한다는 뜻이다.]는 #ruby("격","格")으로 때는 늦었으나마, #ruby("인|민","人|民")의 #ruby("애|국|사|상","愛|國|思|想")을 #ruby("고|취","鼓|吹")하여 #ruby("인|민","人|民")으로 하여금 #ruby("국|가","國|家")가 곧 #ruby("자|기","自|己") 집인 줄을 깨닫고, #ruby("왜","倭")놈이 곧 #ruby("자|기","自|己") #ruby("생|명","生|命")과 #ruby("재|산","財|産")을 빼앗고 #ruby("자|기","自|己") #ruby("자|손","子|孫")을 #ruby("노|예","奴|隸")로 삼을 줄을 #ruby("분|명","分|明")히 깨닫도록 하는 수밖에 다른 #ruby("최|선|책","最|善|策")이 없다고 생각했다. 그때 모였던 #ruby("동|지","同|志")들이 #ruby("사|방","四|方")으로 헤어져서 #ruby("애|국|사|상","愛|國|思|想")을 #ruby("고|취","鼓|吹")하고 #ruby("신|교|육","新|敎|育")을 #ruby("실|시","實|施")하기로 하여, 나도 다시 #ruby("황|해|도","黃|海|道")로 돌아와 #ruby("교|육","敎|育")에 #ruby("종|사","從|事")하였다.]
#heading(level: 3)[#text(font: "KOPUSGo B")[2) #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校")와 #ruby("하|기","夏|期") #ruby("사|범|강|습","師|範|講|習")]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("장|련","長|連")을 떠나 내 나이 33#ruby("세","歲")인 #ruby[무|신|년][戊|申|年]\(1908)#footnote(numbering: _ => [8)])[#h(0.35em)이듬해 #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校")로 옮겨 #ruby("하|기","夏|期") #ruby("사|범|강|습|회","師|範|講|習|會")를 #ruby("개|최","開|催")한 것이 1907#ruby("년","年")이므로, #ruby("종|산","鍾|山") #ruby("서|명|의|숙","西|明|義|塾") #ruby("교|사","敎|師")가 된 것은 1906#ruby("년","年")\(31#ruby("세","歲"))으로 보는 것이 #ruby("타|당","妥|當")하다.]9#ruby("월","月") 9#ruby("일","日"), #ruby("문|화","文|化") #ruby("초|리|면","草|里|面") #ruby("종|산","鍾|山")에 #ruby("거|주","居|住")하면서 그 동네 #ruby("사|립","私|立") #ruby("서|명|의|숙","西|明|義|塾")의 #ruby("교|사","敎|師")가 되어 #ruby("농|촌","農|村") #ruby("아|동","兒|童")을 가르쳤다. 그러다가 그 이듬해 #ruby("정|월","正|月") 18#ruby("일","日") #ruby("안|악|읍","安|岳|邑")으로 옮겨, #ruby("읍","邑")에 #ruby("신|설","新|設")한 #ruby("사|립","私|立") #ruby("양|산|학|교","楊|山|學|校")의 #ruby("교|사","敎|師")가 되어 #ruby("근|무","勤|務")하였다. #ruby("장|련","長|連")에서 #ruby("종|산","鍾|山")으로 갈 때는 #ruby("우|종|서","禹|鍾|瑞") #ruby("목|사","牧|師")의 #ruby("간|청","懇|請")으로 갔는데, #ruby("서|명|의|숙","西|明|義|塾")이 #ruby("산|촌","山|村")에 있어 #ruby("발|전|성","發|展|性")이 보이지 않는데다, #ruby("김|용|제","金|庸|濟") #ruby("등","等") 몇몇 #ruby("친|구","親|舊")의 부름에 따라 #ruby("안|악|읍","安|岳|邑")으로 옮기게 된 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("서|명|의|숙","西|明|義|塾")에서 #ruby("근|무","勤|務")할 때, #ruby("의|병|장","義|兵|將") #ruby("우|동|선","禹|東|鮮")#footnote(numbering: _ => [9)])[#h(0.35em)#ruby("원|문","原|文"): “禹東善”. ‘禹東善’은 ‘禹東鮮’의 #ruby("오|류","誤|謬"). #ruby[우|동|선][禹|東|鮮]\(1870〜1908)은 #ruby("황|해|도","黃|海|道") #ruby("문|화","文|化") #ruby("출|신","出|身")의 #ruby("의|병","義|兵"). #ruby("을|사|의|병","乙|巳|義|兵") #ruby("당|시","當|時") #ruby("격|전","激|戰")을 벌이다 #ruby("체|포","逮|捕")된 그는 #ruby("감|옥","監|獄")에서 #ruby("감|시|병","監|視|兵")의 #ruby("총","銃")을 빼앗아 #ruby("일|본|군","日|本|軍") 8#ruby("명","名")을 #ruby("사|살","射|殺")하고 끝까지 #ruby("교|전","交|戰")하다 #ruby("사|망","死|亡")하였다.]이 10#ruby("리","里")쯤 떨어진 #ruby("내|동","內|洞")에 #ruby("진","陣")을 치고 있다가 #ruby("왜|병","倭|兵")의 #ruby("야|간","夜|間") #ruby("습|격","襲|擊")으로 #ruby("달|천","達|泉") #ruby("부|근","附|近")에서 크게 #ruby("패","敗")하고, 그중 17#ruby("명","名")의 #ruby("의|병","義|兵") #ruby("시|체","屍|體")가 #ruby("내|동","內|洞") #ruby("동|구","洞|口") 밖 길가에 널려 있다는 #ruby("보|도","報|道")를 들었다. 그때 마침, #ruby("왜|병","倭|兵") 세 #ruby("명","名")이 #ruby("총|기","銃|器")를 #ruby("휴|대","携|帶")하고 #ruby("종|산","鍾|山")에 들어와 집집마다 다니며 #ruby("계|란","鷄|卵")과 닭을 #ruby("약|탈","掠|奪")하고 다닌다고, #ruby("동|장","洞|長")이 놀라 찾아와 #ruby("보|고","報|告")하는 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 #ruby("동|장","洞|長") #ruby("우|창|제","禹|昌|濟")의 집에 같이 가 보니, #ruby("왜|병","倭|兵")이 산 닭과 #ruby("계|란","鷄|卵")을 마구 #ruby("약|탈","掠|奪")하고 있었다.#footnote(numbering: _ => [10)])[#h(0.35em)#ruby("당|시","當|時") #ruby("일|본|군","日|本|軍")은 #ruby("의|병","義|兵")과 그 #ruby("관|련|자","關|聯|者")들을 #ruby("흉|폭","兇|暴")하게 #ruby("살|해","殺|害")하였을 뿐만 아니라 #ruby("전|국","全|國")의 개와 닭을 잡아 “13#ruby("도","道") #ruby("강|산","江|山")에서 개와 닭의 소리가 끊기었다”고 할 #ruby("정|도","程|度")였다.] 나는 그 #ruby("왜|병","倭|兵")에게 #ruby("필|담","筆|談")으로 물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("군|대","軍|隊")에서 #ruby("물|품","物|品")을 #ruby("징|발","徵|發")하는 것이냐, 돈 주고 사는 것이냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“돈 주고 사는 것이다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇다면 #ruby("달|천","達|泉") #ruby("시|장","市|場")에서 #ruby("구|입","購|入")할 수 있거늘 왜 이같이 #ruby("촌|민","村|民")을 #ruby("압|박","壓|迫")하느냐.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“당신이 #ruby("문|화","文|化") #ruby("군|수","郡|守")냐?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“나는 #ruby("서|명|의|숙","西|明|義|塾") #ruby("교|사","敎|師")이다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[한 놈이 나와 #ruby("문|답","問|答")하는 사이에 나머지 #ruby("왜|병","倭|兵")은 밖으로 나가 앞집, 뒷집에서 닭을 몰아 안마당으로 #ruby("돌|입","突|入")하니, #ruby("부|인","夫|人")과 어린 아이들이 놀라 소리를 지른다. 나는 #ruby("동|장","洞|長")에게 #ruby("호|령","號|令")했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("도|적","盜|賊")이 집집마다 쳐들어온다는데, #ruby("동|장","洞|長")은 #ruby("실|태","實|態")도 #ruby("관|찰","觀|察")하지 않는가?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나와 #ruby("문|답","問|答")하던 #ruby("왜|병","倭|兵")이 #ruby("호|각","號|角")을 부니, #ruby("외|출","外|出")하였던 놈들이 닭을 한 손에 두세 마리씩 들고 들어왔다. 그놈들이 무슨 말을 하더니, #ruby("강|탈","強|奪")한 닭을 내버리고 동네 바깥으로 나갔다. “아랫동네에서는 집집마다 닭을 잡아 몇 짐이나 지고 갔다”며 동네사람들이 #ruby("후|환","後|患")을 두려워하기에, 나에게 맡기라고 했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[나는 #ruby("종|산","鍾|山")에서 첫아기로 딸을 낳았다. 태어난 지 며칠 만에 #ruby("모|녀","母|女")를 #ruby("가|마","轎|子")에 태워 와서 찬#ruby("기|운","氣|運")을 많이 쐰 탓인지, 딸아이는 #ruby("안|악","安|岳")에 #ruby("도|착","到|着")한 #ruby("후","後") 바로 죽고 말았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악|군","安|岳|郡")에는 #ruby("당|시","當|時") #ruby("십|수|명","十|數|名")의 #ruby("유|지","有|志")가 있었는데, #ruby("김|용|제","金|庸|濟")·#ruby("김|용|진","金|庸|震")·#ruby("김|홍|량","金|鴻|亮")·#ruby("이|시|복","李|始|馥")·#ruby("이|상|진","李|相|晋")·#ruby("최|재|원","崔|在|源")·#ruby("장|윤|근","張|允|根")·#ruby("김|종|원","金|鍾|元")·#ruby("최|명|식","崔|明|植")·#ruby("김|형|종","金|亨|鍾")·#ruby("김|기|형","金|基|瑩")·#ruby("표|치|정","表|致|禎")·#ruby("장|명|선","張|明|善")·#ruby("차|승|용","車|承|用")·#ruby("한|필|호","韓|弼|浩")·#ruby("염|도|선","廉|道|善")·#ruby("전|승|근","田|承|根")·#ruby("함|덕|희","咸|德|熙")·#ruby("장|응|선","張|應|璇")·#ruby("원|인|상","元|仁|常")·#ruby("원|정|부","元|貞|溥")·#ruby("송|영|서","宋|永|瑞")·#ruby("송|종|서","宋|鍾|瑞")·#ruby("김|용|승","金|庸|昇")·#ruby("김|용|필","金|庸|弼")·#ruby("한|응|조","韓|應|祚") #ruby("등","等")은 #ruby("중|년","中|年") 및 #ruby("청|년","靑|年")이요, #ruby("김|효|영","金|孝|英")·#ruby("이|인|배","李|仁|培")·#ruby("최|용|화","崔|龍|化")·#ruby("박|남|병","朴|南|秉")·#ruby("박|도|병","朴|道|秉")·#ruby("송|한|익","宋|漢|益") #ruby("선|배","先|輩")들은 그 #ruby("군|내","郡|內") #ruby("중|견","中|堅") #ruby("인|물","人|物")인데, 여기 #ruby("기|록","記|錄")한 #ruby("인|원","人|員")은 #ruby("직|접","直|接") 나의 일 즉 #ruby("교|육|사|업","敎|育|事|業")에 #ruby("관|계","關|係") 있는 사람만 헤아려 본 것이다.#footnote(numbering: _ => [11)])[#h(0.35em)#ruby("안|창|호","安|昌|浩")가 “13#ruby("개","個") #ruby("도","道")마다 #ruby("안|악|군","安|岳|郡") 같은 고을이 하나씩만 있으면, 이 나라는 10#ruby("년","年") 안에 #ruby("일|본","日|本")을 따라잡을 수 있을 것이다”라고 #ruby("격|찬","激|讚")한 바와 같이 #ruby("당|시","當|時") #ruby("안|악|군","安|岳|郡")은 #ruby("신|교|육","新|敎|育")의 #ruby("선|구|지|대","先|驅|地|帶")였다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("신|교|육","新|敎|育")의 #ruby("필|요","必|要")를 #ruby("절|감","切|感")하여 #ruby("김|홍|량","金|鴻|亮")#footnote(numbering: _ => [12)])[#h(0.35em)#ruby[김|홍|량][金|鴻|亮]\(1885〜1950). #ruby("황|해|도","黃|海|道") #ruby("안|악","安|岳") #ruby("출|신","出|身"). 1906#ruby("년","年") #ruby("김|구","金|龜")가 #ruby("운|영","運|營")하는 #ruby("양|산|학|교","楊|山|學|校")를 #ruby("설|립","設|立")하였고, 1910#ruby("년","年") 12#ruby("월","月") #ruby("만|주","滿|洲") #ruby("안|동|현","安|東|縣")에서 #ruby("농|장","農|場")과 #ruby("무|역","貿|易")을 #ruby("경|영","經|營")하면서 #ruby("신|민|회","新|民|會")의 #ruby("독|립|군","獨|立|軍") #ruby("기|지","基|地") #ruby("건|설","建|設")을 #ruby("지|지","支|持")하였다. 1911#ruby("년","年") #ruby("안|명|근","安|明|根") #ruby("사|건","事|件")에 #ruby("연|루","連|累")되어 #ruby("징|역","懲|役")을 살다 1919#ruby("년","年")에 #ruby("석|방","釋|放")되었다.]·#ruby("최|재|원","崔|在|源") #ruby("외","外") 몇몇 #ruby("청|년","靑|年")은 #ruby("경|성","京|城")과 #ruby("일|본","日|本")에 #ruby("유|학","留|學")하고, #ruby("선|배","先|輩") #ruby("등","等")은 #ruby("교|육","敎|育") #ruby("발|달","發|達")에 #ruby("성|심","誠|心")껏 #ruby("노|력","努|力")해서, 그 #ruby("읍|내","邑|內") #ruby("예|수|교|회","耶|蘇|敎|會")에 #ruby("제|1|차","第|一|次")로 #ruby("안|신|학|교","安|新|學|校")가 #ruby("설|립","設|立")되었고, 그 다음 #ruby("사|립","私|立") #ruby("양|산|학|교","楊|山|學|校")가 #ruby("설|립","設|立")되었다.#footnote(numbering: _ => [13)])[#h(0.35em)#ruby("안|신|학|교","安|新|學|校")에는 #ruby("기|독|교|계","基|督|敎|界") #ruby("자|녀","子|女")들이, #ruby("향|청","鄕|廳")자리에 세워진 #ruby("양|산|학|교","楊|山|學|校")에는 #ruby("비|기|독|계","非|基|督|界") #ruby("자|녀","子|女")들이 #ruby("주","主")로 다녔다.] 그#ruby("후","後")에 #ruby("공|립","公|立") #ruby("보|통|학|교","普|通|學|校")가 #ruby("설|립","設|立")되었으며, #ruby("동|창","東|倉")의 #ruby("배|영|학|교","培|英|學|校"), #ruby("용|순","龍|順")의 #ruby("유|신|학|교","維|新|學|校") #ruby("등","等")이 잇따라 #ruby("설|립","設|立")되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("황|해","黃|海")·#ruby("평|안","平|安") #ruby("양|도","兩|道")의 #ruby("교|육|계","敎|育|界")나 #ruby("학|생|계","學|生|界")에서 #ruby("평|양","平|壤")의 #ruby("최|광|옥","崔|光|玉")이 #ruby("제|일","第|一") #ruby("신|망","信|望")을 가진 #ruby("청|년","靑|年")이었으므로, 그를 #ruby("초|빙","招|聘")하여 #ruby("양|산|학|교","楊|山|學|校")에서 #ruby("하|기","夏|期") #ruby("사|범|강|습","師|範|講|習")을 열었다.#footnote(numbering: _ => [14)])[#h(0.35em)#ruby[최|광|옥][崔|光|玉]\(1879〜1910). #ruby("평|양","平|壤")의 #ruby("숭|실|학|교","崇|實|學|校")와 #ruby("일|본","日|本") #ruby("메이지","明治")#ruby("대|학","大|學")을 #ruby("졸|업","卒|業")한 #ruby("후","後") 1906#ruby("년","年") #ruby("황|해|도","黃|海|道") #ruby("안|악|지|역","安|岳|地|域")을 #ruby("중|심","中|心")으로 하는 #ruby("면|학|회","勉|學|會") #ruby("결|성","結|成")을 #ruby("주|도","主|導")하였다. #ruby("면|학|회","勉|學|會")는 #ruby("회|장","會|長") #ruby("임|택|권","林|澤|權") #ruby("이|하","以|下") #ruby("초|기","初|期") #ruby("회|원","會|員")이 20#ruby("여","餘") #ruby("명","名")이었고 #ruby("본|부","本|部")는 #ruby("정|명|재","鄭|明|哉")의 집에 두었다. #ruby("면|학|회","勉|學|會")는 #ruby("김|구","金|龜")의 #ruby("양|산|학|교","楊|山|學|校")와 #ruby("공|동","共|同")으로 1907#ruby("년","年")에서 1909#ruby("년","年")까지 3#ruby("년|간","年|間") #ruby("하|기","夏|期") #ruby("사|범|강|습|회","師|範|講|習|會")를 열었다. #ruby("제|1|회","第|一|回") #ruby("강|습|회","講|習|會")의 #ruby("주|제","主|題")는 ‘무너져가는 #ruby("조|국","祖|國")을 일으켜 세우려면 #ruby("자|녀","子|女")를 #ruby("교|육","敎|育")시켜라’였다. #ruby("강|습|회","講|習|會")에서 #ruby("최|광|옥","崔|光|玉")은 #ruby("국|어","國|語")·#ruby("생|리|학","生|理|學")·#ruby("물|리|학","物|理|學")·#ruby("식|물|학","植|物|學")·#ruby("경|제|학","經|濟|學") #ruby("등","等") 가장 많은 #ruby("과|목","科|目")을 #ruby("담|당","擔|當")하였다. #ruby("면|학|회","勉|學|會")는 1908#ruby("년","年") #ruby("해|서|교|육|총|회","海|西|敎|育|總|會")로 #ruby("발|전","發|展")하였다.] #ruby("황|해|도","黃|海|道")에서 #ruby("교|육","敎|育")에 #ruby("종|사","從|事")하는 #ruby("인|사","人|士")는 시골의 #ruby("서|당","書|堂") #ruby("훈|장","訓|長")까지 불러모았고, #ruby("평|안|남|북|도","平|安|南|北|道")의 #ruby("유|지","有|志")나 #ruby("교|육|자","敎|育|者"), #ruby("경|기","京|畿")·#ruby("충|청|도","忠|淸|道")의 #ruby("강|습|생","講|習|生")까지 몰려와서 400#ruby("여","餘") #ruby("명","名")에 달했다. #ruby("강|사","講|師")로는 #ruby("김|홍|량","金|鴻|亮"), #ruby("이|시|복","李|始|馥"), #ruby("이|상|진","李|相|晋"), #ruby("한|필|호","韓|弼|浩"), #ruby("이|보|경","李|寶|慶"),#footnote(numbering: _ => [15)])[#h(0.35em)#ruby("원|주","原|註"): “今 光洙”. #ruby("춘|원","春|園") #ruby("이|광|수","李|光|洙")의 #ruby("아|명","兒|名")이 #ruby("이|보|경","李|寶|慶")이다. #ruby("이|광|수","李|光|洙")는 #ruby("일|본","日|本") #ruby("유|학","留|學")\(1905#ruby("년","年")〜1906#ruby("년","年") 12#ruby("월","月"), 1907#ruby("년","年") 2#ruby("월","月")〜1910#ruby("년","年") 3#ruby("월","月")) #ruby("이|후","以|後") #ruby("귀|국","歸|國")하여 #ruby("정|주","定|州") #ruby("오|산|학|교","五|山|學|校") #ruby("교|원","敎|員")이 된다. 그는 1907#ruby("년","年") 여름#ruby("방|학","放|學")#ruby("중","中") #ruby("일|시","一|時") #ruby("귀|국","歸|國")하여 #ruby("안|악|면|학|회","安|岳|勉|學|會")의 #ruby("하|계|수|련|회","夏|季|修|練|會")에서 #ruby("서|양|사","西|洋|史") #ruby("과|목","科|目")을 #ruby("담|당","擔|當")하였다.] #ruby("김|낙|영","金|洛|英"), #ruby("최|재|원","崔|在|源"), #ruby("도|인|권","都|仁|權") #ruby("외","外") 몇 사람과, #ruby("여|교|사","女|敎|師")로 #ruby("김|낙|희","金|樂|姬"), #ruby("방|신|영","方|信|榮")이 있었고, #ruby("강|습|생","講|習|生")에는 #ruby("강|구|봉","姜|九|峰"), #ruby("박|혜|명","朴|慧|明") #ruby("등","等") #ruby("승|도","僧|徒")까지 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("박|혜|명","朴|慧|明")은 #ruby("연|전","年|前")에 나와 #ruby("경|성","京|城") #ruby("영|도|사","永|道|寺")#footnote(numbering: _ => [16)])[#h(0.35em)#ruby("현|재","現|在")의 서울#ruby("시","市") #ruby("성|북|구","城|北|區") #ruby("안|암|동","安|岩|洞")에 있는 #ruby("개|운|사","開|運|寺"). 그런데 앞(157쪽)에서 #ruby("백|범","白|凡")은 #ruby("해|명|대|사","海|明|大|師")를 #ruby("서|대|문","西|大|門") 밖 새 절(#ruby("봉|원|사","奉|元|寺"))에서 헤어졌다고 #ruby("기|술","記|述")하였다.]에서 #ruby("피|차","彼|此")에 #ruby("백|납","白|衲")으로 헤어진 #ruby("사|형","師|兄")으로 #ruby("당|시","當|時") #ruby("패|엽|사","貝|葉|寺") #ruby("주|지|승","住|持|僧")이었는데 #ruby("강|습|회","講|習|會")에서 #ruby("우|연","偶|然")히 #ruby("상|봉","相|逢")했다. 나는 매우 반가워서 #ruby("양|산|학|교","楊|山|學|校") #ruby("사|무|실","事|務|室")에 #ruby("인|도","引|導")하고 여러 #ruby("교|사","敎|師")들에게 내 #ruby("형","兄")님이라고 #ruby("소|개","紹|介")했다. #ruby("교|사","敎|師")들은 #ruby("의|아","疑|訝")해 했다. 나이도 나보다 적어 보일 뿐 아니라, 내가 #ruby("여|동|생","女|同|生")도 없는 #ruby[외아들][獨子]임을 아는 까닭이었다. 나는 #ruby("자|초|지|종","自|初|至|終")을 #ruby("설|명","說|明")하고 나의 #ruby("친|형","親|兄")으로 알아 달라 하였다. 그리고 #ruby("승|속","僧|俗")을 #ruby("불|문","不|問")하고 #ruby("교|육","敎|育")이 #ruby("급|선|무","急|先|務")임을 #ruby("역|설","力|說")한 #ruby("결|과","結|果"), #ruby("혜|명|대|사","慧|明|大|師")도 #ruby("자|기","自|己")부터 #ruby("사|범|학","師|範|學")을 #ruby("공|부","工|夫")하여 곧 #ruby("패|엽|사","貝|葉|寺")에 #ruby("학|교","學|校")를 #ruby("설|립","設|立")하고 #ruby("승|속","僧|俗")의 #ruby("학|생","學|生")을 가르치며 #ruby("교|육","敎|育")하겠다 하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("혜|명","慧|明")은 나에게 지난 일을 이야기했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("형|제","兄|弟")가 #ruby("영|도|사","永|道|寺")에서 헤어진 #ruby("후","後"), 나는 #ruby("본|사","本|寺")인 #ruby("마|곡|사","麻|谷|寺")에 돌아갔습니다. #ruby("종","宗")스님#footnote(numbering: _ => [17)])[#h(0.35em)#ruby("원|주","原|註"): “指我”. #ruby("김|구","金|龜")를 가리킨다. #ruby("백|범","白|凡")의 #ruby("법|명","法|名")이 #ruby("원|종","圓|宗")이었다.]의 #ruby("노","老")스님이시던 #ruby("보|경|당","寶|鏡|堂")과 스님 #ruby("하|은|당","河|隱|堂") 두 늙은이가 #ruby("석|유","石|油") 한 #ruby("통","桶")을 사서, 그 좋고 나쁨을 #ruby("시|험","試|驗")하기 #ruby("위","爲")해 불이 붙은 막대기 끝을 #ruby("석|유|통","石|油|桶")에 넣자 #ruby("석|유|통","石|油|桶")이 #ruby("폭|발","爆|發")하여, 그 집안에 있던 #ruby("보|경","寶|鏡")·#ruby("하|은","河|隱")·#ruby("포|봉","抱|峯") 세 스님이 한꺼번에 #ruby("사|망","死|亡")하였습니다. 절의 #ruby("총|회","總|會")에서 #ruby("재|산","財|産")을 #ruby("관|리","管|理")하고 우리 #ruby("가|문","家|門")의 #ruby("명|성","名|聲")을 이어받을 사람은 오직 #ruby("종","宗")스님이라 #ruby("공|식","公|式") #ruby("결|정","決|定")하고, #ruby("종","宗")스님을 찾으려고 #ruby("덕|삼","德|三")스님을 #ruby("금|강|산","金|剛|山")까지 보내어 #ruby("탐|문","探|問")하였습니다. 그러나 #ruby("결|국","結|局") #ruby("종|적","蹤|跡")을 알지 못하여 그 #ruby("거|대","巨|大")한 #ruby("재|산","財|産")은 절의 #ruby("공|유","共|有")로 하고 말았습니다.”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("칠|순","七|旬")이 넘은 #ruby("김|효|영","金|孝|英") #ruby("선|생","先|生")은 #ruby("김|홍|량","金|鴻|亮")의 #ruby("조|부","祖|父")이니, 어렸을 때 #ruby("한|학","漢|學")을 #ruby("공|부","工|夫")하다가 #ruby("가|세","家|勢")가 #ruby("빈|곤","貧|困")하여 #ruby("상|업","商|業")을 #ruby("경|영","經|營")하였다. #ruby("본|도","本|道") #ruby("소|산","所|産")인 #ruby("포|목","布|木")을 사서 #ruby("자|신","自|身")의 어깨에 지고 #ruby("강|계","江|界")·#ruby("초|산","楚|山") #ruby("등|지","等|地")로 #ruby("행|상","行|商")하면서, 배가 많이 고플 때는 허리띠를 더 졸라매며 #ruby("지|극","至|極")히 #ruby("절|약","節|約")하여 #ruby("자|수|성|가","自|手|成|家")하였다 한다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 뵈었을 때의 #ruby("노|선|생","老|先|生")은 비록 #ruby("기|골","氣|骨")이 #ruby("장|대","長|大")하고 #ruby("용|모","容|貌")가 #ruby("탈|속","脫|俗")하나, ㄱ#ruby("자","字") #ruby("모|양","模|樣")으로 허리가 굽어서 지팡이에 #ruby("의|지","依|支")하여 뜰에 #ruby("출|입","出|入")했다. 비록 #ruby("구|식","舊|式") #ruby("인|물","人|物")이지만 #ruby("두|뇌","頭|腦")가 #ruby("명|석","明|晳")하여, #ruby("정|세","情|勢")를 #ruby("관|찰","觀|察")하는 #ruby("능|력","能|力")은 #ruby("신|진","新|進")#ruby("청|년","靑|年") #ruby("중","中")에서도 더불어 #ruby("의|논","議|論")할 만한 #ruby("자|격","資|格")이 있는 사람이 드물었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|신|학|교","安|新|學|校")를 #ruby("신|설","新|設")하고, #ruby("직|원","職|員")들이 #ruby("경|비","經|費")를 #ruby("조|달","調|達")해야 하는 어려움 때문에 #ruby("회|의","會|議")를 열었을 때, #ruby("모|금|함","募|金|函")에 ‘#ruby("무|명|씨","無|名|氏") #ruby[벼][正租] #ruby("일|백","一|百") #ruby("석","石") #ruby("의|연","義|捐")’이 들어왔다. 뒷날 #ruby("김|효|영","金|孝|英") #ruby("선|생","先|生")이 #ruby("자|기","自|己") #ruby("자|손","子|孫")에게도 알리지 않고 #ruby("자|신","自|身")을 숨겨 #ruby("의|연|금","義|捐|金")을 낸 것을 알았다. #ruby("장|손","長|孫") #ruby("홍|량","鴻|亮")을 #ruby("일|본","日|本")에 #ruby("유|학","留|學")하게 한 것으로도 #ruby("선|생","先|生")의 #ruby("교|육","敎|育")에 대한 #ruby("각|오","覺|悟")는 #ruby("증|명","證|明")된다. #ruby("선|생","先|生")은 바둑과 술을 #ruby("지|극","至|極")히 좋아하여, #ruby("원|근","遠|近")에 몇몇 바둑 #ruby("친|구","親|舊")가 #ruby("자|기","自|己") #ruby("사|랑","舍|廊")에서 함께 술 마시고 바둑 두는 것을 #ruby("노|년","老|年")의 즐거움으로 삼았다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("해|주","海|州") #ruby("서|촌","西|村") #ruby("강|경|희","姜|景|熙")는 #ruby("본|래","本|來") 우리 #ruby("고|향","故|鄕") #ruby("침|산","砧|山") #ruby("강|씨","姜|氏")로, #ruby("대|대","代|代")로 #ruby("거|부","巨|富")였지만 젊었을 때 #ruby("방|탕","放|蕩")하여 #ruby("파|산","破|産")한 사람인데, #ruby("선|생","先|生")의 바둑 #ruby("친|구","親|舊") 가운데 하나였다. 하루는 #ruby("선|생","先|生")을 #ruby("문|안","問|安")하고자 #ruby("사|랑","舍|廊")에 갔다. 그 #ruby("강|씨","姜|氏")는 내가 아이때부터 보고 알던 #ruby("노|인","老|人")이요, 나의 #ruby("선|조","先|祖")를 #ruby("멸|시","蔑|視")·#ruby("압|박","壓|迫")하던 #ruby("양|반","兩|班")이지만, 아버님과 #ruby("친|분","親|分")이 #ruby("비|교|적","比|較|的") 두터웠던 #ruby("옛|정","舊|情")을 생각해서 절을 드렸다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 며칠 뒤 #ruby("선|생","先|生")을 모시고 있던 #ruby("용|진","庸|震") #ruby("군","君")에게 들으니, 어제 #ruby("자|기","自|己") #ruby("부|친","父|親")과 #ruby("강|노|인","姜|老|人")이 바둑을 두다가 두 #ruby("노|인","老|人") 사이에 #ruby("언|쟁","言|爭")이 있었다고 한다. 바둑 두는 #ruby("중","中")에 #ruby("강|노|인","姜|老|人")이 #ruby("자|기","自|己") #ruby("부|친","父|親")에게 이런 말을 했다 한다.]
