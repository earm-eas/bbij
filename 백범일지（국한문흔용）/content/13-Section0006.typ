#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("형","兄")이 #ruby("여|순","旅|順") #ruby("사|건","事|件")#footnote(numbering: _ => [47)])[#h(0.35em)1910#ruby("년","年") 3#ruby("월","月") #ruby("안|중|근","安|重|根")이 #ruby("여|순|감|옥","旅|順|監|獄")에서 #ruby("사|형","死|刑")당한 것을 말한다.]을 #ruby("목|도","目|覩")한 나머지, 더욱이 #ruby("혈|족","血|族")으로 더욱 피가 끓어 이와 같은 #ruby("계|획","計|劃")을 #ruby("생|각","生|覺")해낸 듯하나, 5#ruby("일|간","日|間") #ruby("황|해","黃|海") #ruby("일|대","一|帶")에 #ruby("자|유","自|由") #ruby("천|지","天|地")를 #ruby("조|성","造|成")하더라도 #ruby("금|전","金|錢")보다 #ruby("중|요","重|要")한 것이 #ruby("동|지","同|志")의 #ruby("결|속","結|束")인데, #ruby("동|지","同|志")는 몇 사람이나 얻었나요?”]
