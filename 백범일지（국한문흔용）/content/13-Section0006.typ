#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("자|기","自|己") #ruby("부|친","父|親")은 이 말을 듣자마자 #ruby("분|기","憤|氣") #ruby("대|발","大|發")하며, 바둑판을 들어 #ruby("문","門") 밖에 던지면서 #ruby("강|씨","姜|氏")를 크게 꾸짖었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그대의 #ruby("지|금","只|今") 말은 #ruby("결","決")코 나를 #ruby("위","爲")하는 것이 아니다. #ruby("칠|십","七|十") #ruby("노|구","老|軀")로 며칠 뒤 #ruby("왜","倭")놈의 #ruby("노|예|문|적","奴|隸|門|籍")에 #ruby("편|입","編|入")될 나쁜 #ruby("운|명","運|命")을 가진 나 같은 놈을 가리켜, #ruby("팔|자","八|字") 좋다는 것이 무엇이냐?”]
