#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("포|교","捕|校")는 #ruby("피","避")하여 멀리 #ruby("도|주","逃|走")하면 #ruby("혹|시","或|是") #ruby("생|명","生|命")을 #ruby("보|존","保|存")할 수 있으나, 우리 #ruby("법","法")으로 #ruby("사|형","死|刑")을 받고 그물을 빠져나가기는 #ruby("지|극","至|極")히 어렵습니다. 그리고 #ruby("도|적","盜|賊")질하기 싫든지 나이 많아 #ruby("도|당","徒|黨")에서 물러나기를 #ruby("청|원","請|願")하여도, #ruby("동|지","同|志")가 #ruby("급","急")한 #ruby("경|우","境|遇") #ruby("자|기","自|己") 집에 숨겨주는 한 가지 일만은 #ruby("응|낙","應|諾")한다는 #ruby("서|약","誓|約")을 받고 난 뒤, #ruby("행|락","行|樂")을 #ruby("면|제","免|除")하여 줍니다.”]
