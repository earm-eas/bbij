#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("당|시","當|時") #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校")에는 #ruby("중","中")·#ruby("소|학|부","小|學|部"), 2#ruby("부","部")를 두고 있었는데, 처음에는 #ruby("이|인|배","李|仁|培")가 #ruby("교|장","校|長")이었고, 그 뒤는 #ruby("김|홍|량","金|鴻|亮")이 #ruby("교|주","校|主") 겸 #ruby("교|장","校|長")이 되었다. 나는 #ruby("소|학|부","小|學|部")에서 #ruby("유|년","幼|年")의 #ruby("교|육","敎|育")을 #ruby("담|임","擔|任")하면서, #ruby("재|령","載|寧") #ruby("북|율|면","北|栗|面") #ruby("무|상|동","武|尙|洞")의 #ruby("보|강|학|교","保|强|學|校") #ruby("교|장","校|長")을 겸하여 그 #ruby("학|교","學|校")에도 #ruby("종|종","種|種") #ruby("왕|래","往|來")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("보|강|학|교","保|强|學|校")는 처음 #ruby("노|동|자","勞|動|者")들이 #ruby("주|동","主|動")이 되어 #ruby("설|립","設|立")하였는데, #ruby("부|근","附|近") 동네 #ruby("유|지","有|志")들이 #ruby("운|영","運|營")하면서 #ruby("학|교","學|校") #ruby("진|흥|책","振|興|策")으로 나를 #ruby("교|장","校|長")으로 뽑은 것이었다. #ruby("전|승|근","田|承|根")을 #ruby("주|임|교|사","主|任|敎|師")로 #ruby("임|명","任|命")하고, #ruby("장|덕|준","張|德|俊")은 #ruby("교|사","敎|師") 겸 #ruby("학|생","學|生")으로 #ruby("친|동|생","親|同|生") #ruby("덕|수","德|秀")#footnote(numbering: _ => [28)])[#h(0.35em)#ruby[장|덕|수][張|德|秀]\(1895〜1947). #ruby("호","號")는 #ruby("설|산","雪|山"). #ruby("일|본","日|本") #ruby("유|학","留|學") #ruby("후","後") #ruby("귀|국","歸|國")하여 『#ruby("동|아|일|보","東|亞|日|報")』 #ruby("창|간","創|刊")할 때 #ruby("주|간","主|幹")을 맡았다. #ruby("해|방","解|放") #ruby("후","後") #ruby("한|국|민|주|당","韓|國|民|主|黨") #ruby("외|교|부|장","外|交|部|長")·#ruby("정|치|부|장","政|治|部|長")을 #ruby("역|임","歷|任")하다 1947#ruby("년","年") 12#ruby("월","月") #ruby("암|살","暗|殺")되었다. #ruby("한|민|당","韓|民|黨")에서는 #ruby("암|살","暗|殺")의 #ruby("배|후","背|後")로 #ruby("백|범","白|凡")을 #ruby("지|목","指|目")하였고, #ruby("재|판","裁|判") #ruby("참|고|자|료","參|考|資|料")로 『#ruby("백|범|일|지","白|凡|逸|志")』가 #ruby("필|사","筆|寫")되었다.]를 데리고 #ruby("교|내","校|內")에 #ruby("숙|식","宿|食")하며, #ruby("교|감","校|監") #ruby("허|정|삼","許|貞|三") #ruby("등","等")의 #ruby("협|력","協|力")으로 #ruby("교|무","校|務")를 #ruby("발|전","發|展")해 갈 때였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("교|사","校|舍")는 #ruby("신|축","新|築")하던 #ruby("중","中")이어서 아즉 #ruby("개|와","蓋|瓦")치 못하고 #ruby("개|초","蓋|草")만 하고#footnote(numbering: _ => [29)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “아직 기와를 얹지 못하고 이엉으로 #ruby("대|강","大|綱") 얽어”. #ruby("개|초","蓋|草")는 이엉으로 지붕을 이는 것.] #ruby("개|교","開|校")하여 가르치고 있었다. #ruby("학|교","學|校")는 #ruby("무|상|동","武|尙|洞")에서 떨어져 #ruby("야|외","野|外")에 #ruby("독|립","獨|立")한 #ruby("교|사","校|舍")였는데, #ruby("종|종","種|種") #ruby[도깨비불][鬼火]이 #ruby("발|생","發|生")하여 #ruby("진|화","鎭|火")한다는 #ruby("보|고","報|告")가 있었다. 나는 #ruby("교|직|원","敎|職|員") 한 사람에게 #ruby("비|밀","祕|密")히 #ruby("주|의","注|意")를 주었다. #ruby("화|재","火|災")가 #ruby("매|번","每|番") 밤이 깊은 #ruby("후","後")에 일어난다 하니, 3#ruby("일","日") 동안 #ruby("은|밀","隱|密")한 곳에 숨어서 사람의 #ruby("흔|적","痕|跡")이 있는지 살피고, #ruby("흔|적","痕|跡")이 있으면 가만히 #ruby("추|적","追|跡")하여 #ruby("행|동","行|動")을 살펴보라고 #ruby("지|시","指|示")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("과|연","果|然") 둘째 날에 #ruby("급|보","急|報")가 왔다. #ruby("학|교","學|校")에 #ruby("중|대|사|고","重|大|事|故")가 있으니 #ruby("교|장","校|長")이 #ruby("출|석","出|席")하여 달라는 #ruby("보|고","報|告")를 받은 #ruby("즉|시","卽|時") #ruby("학|교","學|校")에 나가보니, 지키던 #ruby("직|원","職|員")이 불을 지른 #ruby("범|인","犯|人") 한 #ruby("명","名")을 묶어놓았고, 동네와 #ruby("학|교","學|校")에서는 ‘죽이자’ ‘살리자’ 하는 #ruby("소|동","騷|動")이 일어났다. 내가 #ruby("범|인","犯|人")을 #ruby("직|접","直|接") #ruby("심|문","訊|問")하니, 그는 그 동네 #ruby("서|당","書|堂") #ruby("훈|장","訓|長")이었다. 내가 동네 어른들을 #ruby("초|청","招|請")해 #ruby("신|교|육","新|敎|育")의 #ruby("필|요","必|要")를 #ruby("설|명","說|明")하자 #ruby("자|기","自|己")가 가르치던 #ruby("아|동","兒|童") 4, 5#ruby("명","名")이 #ruby("전|부","全|部") #ruby("학|교","學|校")에 #ruby("입|학","入|學")하게 되어, #ruby("자|기","自|己")는 #ruby("고|역","苦|役")인 #ruby("농|사","農|事")밖에 #ruby("생|활|방|도","生|活|方|道")가 없게 된 것을 #ruby("원|망","怨|望")해서 #ruby("방|화","放|火")하였다고 #ruby("자|백","自|白")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 일찍이 #ruby("학|교","學|校") #ruby("사|무|원","事|務|員")을 불러 #ruby("학|교","學|校")에 #ruby("화|재","火|災")가 나던 #ruby("진|상","眞|相")을 물으니 그이들은 #ruby("확|실","確|實")히 도깨비불이라 했다. #ruby("학|교","學|校") #ruby("부|근","附|近") 땅에 그 동네에서 해마다 #ruby("제|사","祭|祀")드리던 이른바 #ruby("부|군|당","府|君|堂")#footnote(numbering: _ => [30)])[#h(0.35em)#ruby("관|아","官|衙")에서 #ruby("신|령","神|靈")을 모시던 #ruby("신|당","神|堂").]이란 것이 있고 그 #ruby("당","堂") #ruby("주|위","周|圍")에는 아름드리 #ruby("고|목","古|木")이 늘어서 있었는데, #ruby("학|교","學|校") #ruby("건|물","建|物")을 새로 #ruby("건|축","建|築")한 #ruby("후","後") 그 #ruby("고|목","古|木")을 베어 #ruby("학|교","學|校")의 #ruby("연|료","燃|料")로 #ruby("사|용","使|用")하였다. 그 까닭으로 동네 #ruby("인|민","人|民")들이 도깨비불로 여겨, #ruby("학|교","學|校")에서 #ruby("부|군|당","府|君|堂")에 #ruby("제|사","祭|祀")지내지 않으면 #ruby("화|재","火|災")를 피하지 못한다는 #ruby("미|신","迷|信")이 #ruby("분|분","紛|紛")하였다 한다. 그래서 내가 그 #ruby("교|직|원","敎|職|員")에게 #ruby("은|밀","隱|密")히 #ruby("지|시","指|示")해 놓았던 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("직|원","職|員") #ruby("보|고","報|告")에 #ruby("의","依")하면, 두#ruby("번","番")째 #ruby("화|재","火|災")가 난 뒤 #ruby("매|일","每|日") 밤 #ruby("교|사","校|舍") #ruby("부|근","附|近")에 #ruby("은|신","隱|身")하고 #ruby("감|시","監|視")하던 이틀째 되는 밤#ruby("중","中"), #ruby("무|상","武|尙") 동네로부터 #ruby("학|교","學|校")로 가는 길에 사람의 기척이 있어 가만히 따라가 보니, 어떤 사람이 #ruby("황|급","遑|急")히 #ruby("교|사","校|舍")로 달려가 #ruby("강|당","講|堂")의 지붕과 마주보고 있는 #ruby("사|무|실","事|務|室") 지붕에 무슨 #ruby("물|건","物|件")을 던지는 것이었다. #ruby("강|당","講|堂") 지붕에는 벌써 #ruby("화|염","火|焰")이 일어나고, #ruby("사|무|실","事|務|室") 지붕에는 반딧불과 같이 반짝반짝하면서 아직 불이 일어나지 않는 것을 본 그 사람이 #ruby("도|주","逃|走")하려고 할 즈음, 지키던 #ruby("직|원","職|員")이 붙잡아서 #ruby("결|박","結|縛")하고, 동네사람들을 불러 불을 끄고, 나에게 #ruby("급","急")히 #ruby("보|고","報|告")한 것이었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 #ruby("범|인","犯|人")을 #ruby("신|문","訊|問")하니 #ruby("일|일","一|一")이 #ruby("자|백","自|白")했다. #ruby("과|연","果|然") #ruby("학|교","學|校")가 #ruby("자|기","自|己") #ruby("생|활","生|活")에 #ruby("손|해","損|害")를 미치기 때문에 #ruby("방|화","放|火")하였다는 것이요, 그 #ruby("방|법","方|法")은 #ruby("일|지|장","一|指|長")의 #ruby("화|승|말|단","火|繩|末|端")에 당셕냥 한 줌을 #ruby("약|두","藥|頭")를 #ruby("총|결","總|結")하고,#footnote(numbering: _ => [31)])[#h(0.35em)#ruby("현|대|어","現|代|語"): “손가락 길이만큼 되는 #ruby("화|약","火|藥")심지 머리에 당성냥 한 줌을 뭉쳐 바르고”.] 줄 끝에 돌멩이를 매달아 지붕에 던져 불을 냈다는 것이었다. 나는 #ruby("경|찰","警|察")에 #ruby("고|발","告|發")하지 않고 조용히 마을을 떠날 것을 #ruby("명","命")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("안|악","安|岳")에서 그 #ruby("학|교","學|校")까지 20#ruby("리","里") #ruby("거|리","距|離")이므로, #ruby("일|주|일","一|週|日")에 한 #ruby("차|례","次|例")씩 #ruby("보|강|학|교","保|强|學|校")에 나갔다. #ruby("안|악|읍","安|岳|邑")에서 #ruby("신|환|포","新|換|浦") #ruby("하|류","下|流")를 건너 #ruby("학|교","學|校")로 가는데, 여름철에 #ruby("학|교","學|校")에 가면서 나루터를 #ruby("향","向")해 가노라면, #ruby("학|교","學|校")에서는 #ruby("소|학|생","小|學|生")들이 나를 바라보고 #ruby("영|접","迎|接")하느라고 몰려나오고 #ruby("직|원","職|員")들도 뒤를 이어 나온다. 내가 나루터에 #ruby("도|착","到|着")하여 보니, 건너편에 와 있던 #ruby("소|학|생","小|學|生") #ruby("전|부","全|部")가 #ruby("의|복","衣|服")을 척척 벗고 #ruby("강","江") 속으로 뛰어 들어간다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[내가 크게 놀라 #ruby("고|함","高|喊")을 지르니, #ruby("직|원","職|員")들은 #ruby("강","江")가에서 웃으면서 #ruby("안|심","安|心")하라고 #ruby("답","答")한다. 나룻배에 올라 #ruby("강","江") 가운데로 나아가자, 거뭇거뭇한 #ruby("학|생","學|生")들의 머리가 물 속에서 나타나 뱃전에 매달리는 것이, 마치 쳇바퀴에 개미떼 붙듯 하였다. 나는 #ruby("장|래","將|來")에 #ruby("해|군","海|軍")을 #ruby("모|집","募|集")하게 되면 #ruby("연|해","沿|海") #ruby("촌|락","村|落")에서 #ruby("인|력","人|力")을 #ruby("모|집","募|集")하는 것이 #ruby("편|리","便|利")하겠다고 생각했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("무|상|동","武|尙|洞") 역시 #ruby("재|령","載|寧") #ruby("여|물|평","餘|物|坪")의 한 동네이다. #ruby("평|내","坪|內")에는 #ruby("특|별","特|別")한 #ruby("거|부","巨|富")는 없으나 #ruby("보|통","普|通")으로는 그다지 #ruby("빈|곤","貧|困")하지 않은 곳이니, #ruby("토|지","土|地")가 #ruby("대|부|분","大|部|分") #ruby("궁|장","宮|庄")#footnote(numbering: _ => [32)])[#h(0.35em)#ruby("궁","宮")에 #ruby("소|속","所|屬")된 #ruby("농|장","農|場"), #ruby("즉","卽") #ruby("궁|장|토","宮|庄|土"). #ruby("조|선|조","朝|鮮|朝") #ruby("재|령","載|寧") #ruby("여|물|평","餘|物|坪")\(나무리벌)은 #ruby("궁|장|토","宮|庄|土")가 #ruby("집|결","集|結")된 #ruby("지|역","地|域")으로 #ruby("유|명","有|名")하다. 이 #ruby("비|옥","肥|沃")한 #ruby("토|지","土|地")들은 #ruby("토|지|조|사|사|업","土|地|調|査|事|業") #ruby("이|후","以|後") #ruby("대|부|분","大|部|分") #ruby("동|양|척|식|회|사","東|洋|拓|殖|會|社") #ruby("소|유","所|有")의 #ruby("농|장","農|場")이 되었다.]이고 #ruby("지|극","至|極")히 #ruby("비|옥","肥|沃")한 까닭이다. #ruby("인|품","人|品")이 #ruby("명|민","明|敏")·#ruby("준|수","俊|秀")하며, #ruby("시|대","時|代") #ruby("변|천","變|遷")에 #ruby("순|응","順|應")하여 #ruby("운|수","雲|水")·#ruby("진|초","進|礎")·#ruby("보|강","保|强")·#ruby("기|독","基|督") #ruby("학|교","學|校") #ruby("등","等")을 #ruby("설|립","設|立")하여 #ruby("자|제","子|弟")를 #ruby("교|육","敎|育")하고, #ruby("농|무|회","農|務|會")를 #ruby("조|직","組|織")하여 #ruby("농|업","農|業") #ruby("발|달","發|達")을 #ruby("계|도","啓|導")하는 #ruby("등","等") #ruby("공|익|사|업","公|益|事|業")에 #ruby("착|안","着|眼")하는 것이 #ruby("실","實")로 볼 만했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("나|석|주","羅|錫|疇")#footnote(numbering: _ => [33)])[#h(0.35em)#ruby[나|석|주][羅|錫|疇]\(1892〜1926). #ruby("재|령","載|寧") #ruby("여|물|평","餘|物|坪") #ruby("북|률|면","北|栗|面") #ruby("출|신","出|身")으로 #ruby("보|명|학|교","普|明|學|校")에서 #ruby("수|학","修|學")하였고, 1913#ruby("년","年") #ruby("북|간|도","北|間|島")로 건너가 #ruby("무|관|학|교","武|官|學|校")에 #ruby("입|학","入|學"), #ruby("군|사|훈|련","軍|事|訓|鍊")을 받았다. 1919#ruby("년","年") #ruby("국|내","國|內")에 들어와 3·1#ruby("운|동","運|動")에 #ruby("참|여","參|與")하였고, #ruby("여|물|평","餘|物|坪") #ruby("지|역","地|域")에서 #ruby("비|밀|결|사","祕|密|結|社")를 #ruby("조|직","組|織")하여 #ruby("친|일|파","親|日|派")를 #ruby("숙|청","肅|淸")하고 #ruby("군|자|금","軍|資|金")을 모으다 #ruby("일|본","日|本")의 #ruby("감|시","監|視") 때문에 #ruby("상|해","上|海")로 #ruby("망|명","亡|命")하였다.] #ruby("의|사","義|士")는 #ruby("당|시","當|時") #ruby("젊|은","妙|齡") #ruby("청|년","靑|年")으로, 나라의 #ruby("형|세","形|勢")가 날로 잘못되어 감을 #ruby("한","恨")스럽게 생각하여, #ruby("평|내","坪|內")에서 #ruby("남|녀","男|女") 어린 아이 8, 9#ruby("명","名")을 배에 싣고 #ruby("비|밀|리","祕|密|裏")에 #ruby("중|국","中|國")으로 건너가 #ruby("철|망","鐵|網") 밖에서 #ruby("교|육","敎|育")시켜 보고자 #ruby("출|발","出|發")하다가, #ruby("장|련","長|連") #ruby("오|리|포","梧|里|浦")에서 #ruby("왜|경","倭|警")에게 #ruby("발|각","發|覺")되어 여러 달 #ruby("옥|고","獄|苦")를 치렀다. #ruby("출|옥","出|獄") #ruby("후","後")에는 겉으로 #ruby("상|업","商|業"), #ruby("농|업","農|業")에 #ruby("종|사","從|事")하면서 속으로는 #ruby("독|립","獨|立")의 #ruby("사|상","思|想")을 #ruby("고|취","鼓|吹")시키며, #ruby("직|접","直|接") #ruby("간|접","間|接")으로 #ruby("교|육","敎|育")에 #ruby("열|성","熱|誠")을 다하여 #ruby("평|내","坪|內") #ruby("청|년","靑|年")의 우두머리로 #ruby("신|임","信|任")을 받고 있었다. 나도 #ruby("종|종","種|種") #ruby("여|물|평","餘|物|坪")에 #ruby("왕|래","往|來")하게 되었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("노|백|린","盧|伯|麟")#footnote(numbering: _ => [34)])[#h(0.35em)#ruby[노|백|린][盧|伯|麟]\(1876〜1925). #ruby("호","號")는 #ruby("계|원","桂|園"). #ruby("황|해|도","黃|海|道") #ruby("은|율","殷|栗") #ruby("출|신","出|身")으로 #ruby("일|본","日|本")으로 #ruby("유|학","留|學")가 #ruby("일|본","日|本") #ruby("육|군|군|관|학|교","陸|軍|軍|官|學|校")를 #ruby("졸|업","卒|業")했다. 그#ruby("후","後") #ruby("귀|국","歸|國")하여 #ruby("대|한|제|국","大|韓|帝|國")의 #ruby("군","軍") #ruby("요|직","要|職")을 두루 #ruby("역|임","歷|任")하였다. #ruby("군|대","軍|隊")가 #ruby("해|산","解|散")되고 #ruby("국|권","國|權")도 빼앗기자 그는 #ruby("신|민|회","新|民|會")에 #ruby("관|여","關|與")하고 #ruby("해|서|교|육|총|회|장","海|西|敎|育|總|會|長")으로 #ruby("교|육|운|동","敎|育|運|動")을 했다. 1919#ruby("년","年") #ruby("중|국","中|國")으로 #ruby("망|명","亡|命")하여 #ruby("상|해|임|시|정|부","上|海|臨|時|政|府") #ruby("군|무|총|장","軍|務|總|長")을 지냈다.]이 #ruby("군|직","軍|職")에서 물러나 #ruby("풍|천","豊|川") #ruby("자|택","自|宅")에서 #ruby("교|육|사|업","敎|育|事|業")에 #ruby("종|사","從|事")하던 때였다. 하루는 #ruby("경|성","京|城") 가는 길에 #ruby("안|악","安|岳")에서 그와 #ruby("상|봉","相|逢")하여, 함께 #ruby("여|물|평","餘|物|坪") #ruby("진|초|동","進|礎|洞") #ruby("교|육|가","敎|育|家")인 #ruby("김|정|홍","金|正|洪") #ruby("군","君")의 집에서 같이 잤다. #ruby("진|초|학|교","進|礎|學|校") #ruby("직|원","職|員")들과 함께 술을 마시던 즈음 갑자기 동네에서 #ruby("소|동","騷|動")하는 소리가 났다. #ruby("진|초|학|교","進|礎|學|校") #ruby("교|장","校|長") #ruby("김|정|홍","金|正|洪")이 놀라고 두려워서 어찌할 바를 모르면서 #ruby("사|실","事|實")을 말했다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[학교의 #ruby("여|교|사","女|敎|師") #ruby("오|인|성","吳|仁|星")은 #ruby("이|재|명","李|在|明")#footnote(numbering: _ => [35)])[#h(0.35em)#ruby[이|재|명][李|在|明]\(1890〜1910). #ruby("평|양","平|壤")사람으로 1904#ruby("년","年") #ruby("대|한|노|동|이|민|사","大|韓|勞|動|移|民|社")의 #ruby("이|민","移|民") #ruby("모|집","募|集")에 따라가 #ruby("하|와|이","夏|威|夷")에서 #ruby("수|년|간","數|年|間") #ruby("노|동","勞|動")에 #ruby("종|사","從|事")하였다. 1907#ruby("년","年") #ruby("한|일|의|정|서","韓|日|議|定|書") #ruby("협|약","協|約") #ruby("후","後") #ruby("귀|국","歸|國"), #ruby("이|토","伊|藤")를 #ruby("암|살","暗|殺")하려다 #ruby("안|창|호","安|昌|浩")의 #ruby("만|류","挽|留")로 #ruby("실|패","失|敗")하고, #ruby("안|중|근","安|重|根")이 #ruby("이|토","伊|藤")를 #ruby("저|격","狙|擊")한 #ruby("후","後") #ruby("이|완|용","李|完|用") #ruby("등","等") #ruby("국|내","國|內") #ruby("친|일|파","親|日|派")를 #ruby("척|결","剔|抉")하기로 #ruby("결|심","決|心")하였다.]의 #ruby("부|인","夫|人")인데, #ruby("이|군","李|君")이 #ruby("자|기","自|己") #ruby("부|인","夫|人")에게 무슨 #ruby("요|구","要|求")를 #ruby("강|경","强|硬")히 하였던지 #ruby("단|총","短|銃")으로 #ruby("위|협","威|脅")하니, #ruby("오|여|사","吳|女|士")는 놀라고 겁이 나서 #ruby("학|교","學|校") #ruby("수|업","授|業")을 #ruby("감|당","堪|當")치 못할 #ruby("사|정","事|情")을 말하고 이웃집에 #ruby("피","避")해 숨어버렸다 한다. 그런데 #ruby("이|군","李|君")이 미친 사람 #ruby("모|양","模|樣")으로 동네 어귀에서 #ruby("총","銃")을 쏘아대며, #ruby("매|국|노","賣|國|奴")를 #ruby("일|일","一|一")이 #ruby("총|살","銃|殺")하겠노라고 소리를 치니 동네가 #ruby("소|동","騷|動")한다는 것이었다. #ruby("노|백|린","盧|伯|麟")과 #ruby("상|의","相|議")하여 #ruby("이|군","李|君")을 #ruby("청","請")해 불렀다.]
