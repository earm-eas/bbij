#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[‘옛날 #ruby("의|병","義|兵")은 네가 보는 바와 같이 #ruby[무식한][目不識丁] 것들이니 #ruby("국|가","國|家")에 #ruby("대","對")한 #ruby("의|무","義|務")도 #ruby("이|해","理|解")하지 못하는 것이 #ruby("사|실","事|實")이나, 너는 일찍이 #ruby("고|후|조","高|後|凋")에게 #ruby("의|리","義|理")가 무엇인지 가까이서 배웠고, 그이에게서 배운 #ruby("금|언","金|言") #ruby("중","中")에 #ruby("삼|척|동|자","三|尺|童|子")라도 개나 #ruby("양","羊")을 가리켜 절을 시키면 반드시 크게 #ruby("노","怒")하며 #ruby("불|응","不|應")한다는 말을, #ruby("강|단","講|壇")에서 #ruby("신|성","神|聖")한 #ruby("제|2|세","第|二|世") #ruby("국|민","國|民")에게 #ruby("연|설","演|說")하던 네가, 머리를 숙여 #ruby("왜","倭")놈 #ruby("간|수","看|守")에게 #ruby("예","禮")를 하느냐? 네가 #ruby("항|상","恒|常") #ruby("암|송","暗|誦")하는 #ruby("고|인","古|人")의 #ruby("시","詩") 가운데,]
