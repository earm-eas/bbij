#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby[신|해|년][辛|亥|年]\(1911, 36#ruby("세","歲")) #ruby("정|월","正|月") #ruby("초","初")닷새, 내가 #ruby("양|산|학|교","楊|山|學|校") #ruby("사|무|실","事|務|室")에서 아직 일어나지도 않았을 때, #ruby("왜|헌|병","倭|憲|兵") 한 #ruby("명","名")이 와서 #ruby("헌|병|소|장","憲|兵|所|長")이 #ruby("잠|시","暫|時") #ruby("면|담","面|談")할 일이 있다고 함께 가기를 #ruby("청","請")했다. 같이 가니 벌써 #ruby("김|홍|량","金|鴻|亮")·#ruby("도|인|권","都|仁|權")·#ruby("이|상|진","李|相|晋")·#ruby("양|성|진","楊|成|鎭")·#ruby("박|도|병","朴|道|秉")·#ruby("한|필|호","韓|弼|昊")·#ruby("장|명|선","張|明|善") #ruby("등","等") #ruby("교|직|원","敎|職|員")을 #ruby("차|례","次|例")로 불러모은 #ruby("후","後")였다. #ruby("경|무|총|감|부","警|務|總|監|府")의 #ruby("명|령","命|令")이라며 #ruby("임|시|구|류","臨|時|拘|留")에 #ruby("처","處")한다고 #ruby("선|언","宣|言")한 뒤, 2, 3#ruby("일","日") #ruby("후","後") #ruby("전|부","全|部")를 #ruby("재|령","載|寧")에 옮겨 가두고, #ruby("황|해","黃|海") #ruby("일|대","一|帶")의 #ruby("평|소","平|素") #ruby("애|국|자","愛|國|者")로 #ruby("지|목","指|目")된 #ruby("인|사","人|士")를 #ruby("대|부|분","大|部|分") #ruby("체|포","逮|捕")하였다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[이보다 앞서 #ruby("배|천","白|川") #ruby("군|수","郡|守") #ruby("전|봉|훈","全|鳳|薰")이 나에게 #ruby("상|의","相|議")해 왔다. #ruby("국|가","國|家")의 #ruby("대|세","大|勢")가 이미 기우니 #ruby("소|위","所|謂") #ruby("군|수","郡|守")란 #ruby("직|책","職|責")도 #ruby("분|통","憤|痛")이 터져 못하겠다며, #ruby("형","兄") #ruby("등","等")이 #ruby("종|사","從|事")하는 #ruby("안|악","安|岳") #ruby("양|산|학|교","楊|山|學|校") #ruby("부|근","附|近")에 #ruby("가|옥","家|屋") 한 채를 사서 #ruby("주|거","住|居")하면서 오로지 #ruby("손|자","孫|子") #ruby("무|길","武|吉")의 #ruby("학|업","學|業")에나 힘쓰는 것이 #ruby("소|원","所|願")이라는 것이다. #ruby("당|시","當|時") #ruby("수|안","遂|安")으로 #ruby("이|직","移|職")되었던 #ruby("군|수","郡|守") #ruby("전|봉|훈","全|鳳|薰")이 #ruby("습|락|현","習|樂|峴")에 기와집 한 채를 #ruby("매|입","買|入")하여 #ruby("수|리","修|理")하고 #ruby("솔|가","率|家")하여 #ruby("안|악","安|岳")으로 #ruby("이|주","移|住")해 오는 날, 우리는 #ruby("재|령","載|寧")에서 #ruby("사|리|원","沙|里|院")으로, #ruby("사|리|원","沙|里|院")에서 #ruby("경|성","京|城")으로 다시 #ruby("이|송","移|送")되는 날이었다. #ruby("전|봉|훈","全|鳳|薰")이 우리의 #ruby("소|식","消|息")을 듣고 #ruby("안|악","安|岳")으로 #ruby("이|사","移|徙")하던 #ruby("심|회","心|懷")가 어떠하였으랴.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("해|서","海|西") #ruby("각","各") #ruby("군","郡")에서 #ruby("체|포","逮|捕")되어 #ruby("경|성","京|城")으로 #ruby("이|송","移|送")되는 #ruby("인|사","人|士") #ruby("중","中"), #ruby("송|화","松|禾")의 #ruby("반|정","泮|亭") #ruby("신|석|충","申|錫|忠") #ruby("진|사","進|士")는 #ruby("재|령|강","載|寧|江") #ruby("철|교","鐵|橋")를 건너다 #ruby("강","江")에 몸을 던져 #ruby("자|살","自|殺")하였다. #ruby("신|석|충","申|錫|忠")은 #ruby("본|시","本|是") #ruby("해|서","海|西")의 #ruby("저|명","著|名")한 #ruby("학|자","學|者")요 #ruby("대|자|선|가","大|慈|善|家")였다. 나는 #ruby("석|충","錫|忠")의 #ruby("형|제","兄|弟")#footnote(numbering: _ => [48)])[#h(0.35em)#ruby("원|문","原|文"): “弟”. #ruby("원|주","原|註"): “次兄”. #ruby("원|문","原|文")에 #ruby[아우][弟]와 #ruby("원|주","原|註")에 #ruby[둘째형][次兄]이 #ruby("병|기","竝|記")되어 있어 #ruby("형|제|간","兄|弟|間")의 #ruby("순|서","順|序")를 알 수 없다.] #ruby("석|제","錫|悌") #ruby("진|사","進|士")의 #ruby("자|손","子|孫") #ruby("교|육|문|제","敎|育|問|題")로 한 #ruby("차|례","次|例") #ruby("방|문","訪|問")하여 하룻밤 같이 자며 #ruby("담|화","談|話")한 적이 있을 뿐이다. 그때에 #ruby("석|제","錫|悌") #ruby("진|사","進|士")를 #ruby("방|문","訪|問")하고자 동네 #ruby("입|구","入|口")에 들어서니, #ruby("신|진|사","申|進|士") #ruby("댁","宅")에서 #ruby("소|식","消|息")을 듣고서 #ruby("석|제","錫|悌")의 아들 #ruby("낙|영","洛|英")과 #ruby("손|자","孫|子") #ruby("상|호","相|浩") #ruby("등","等")이 #ruby("동|구","洞|口")밖까지 나와 맞았다. 내가 #ruby("모|자","帽|子")를 벗어 #ruby("인|사","人|事")할 때 #ruby("낙|영","洛|英") #ruby("등","等")은 검은 #ruby[갓][黑笠]을 벗고 #ruby("답|례","答|禮")하려 했다. 내가 웃으면서 갓끈 끄르는 것을 #ruby("만|류","挽|留")하니, #ruby("낙|영","洛|英") #ruby("등","等")은 #ruby("송|구","悚|懼")한 빛을 띠고서 “#ruby("선|생","先|生")께서 #ruby("관","冠")을 벗으시는데, 우리가 그저 #ruby("답|례","答|禮")할 수 있습니까?” 했다. 나는 도리어 #ruby("미|안","未|安")하여 내가 쓴 담벙거지는 #ruby("양|인","洋|人")이 쓰는 #ruby("물|건","物|件")인데, #ruby("서|양|인","西|洋|人")의 #ruby("통|례","通|例")가 #ruby("인|사","人|事")할 때 #ruby("탈|모","脫|帽")하는 것이니 #ruby("용|서","容|恕")하라고 하였다. 나는 #ruby("석|제","錫|悌") #ruby("진|사","進|士")를 보고 #ruby("국|가","國|家") #ruby("문|명","文|明")에 #ruby("교|육","敎|育")이 #ruby("급|선|무","急|先|務")인 것을 하룻밤 동안 온 마음으로 #ruby("설|파","說|破")하고, #ruby("손|자","孫|子") #ruby("상|호","相|浩")의 #ruby("교|육","敎|育")을 #ruby("의|뢰","依|賴")받고 #ruby("안|악","安|岳")으로 돌아왔던 것이다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("사|리|원","沙|里|院")에서 우리와 #ruby("호|송","護|送")하는 #ruby("헌|병","憲|兵") 몇 #ruby("명","名")이 #ruby("경|성|행","京|城|行") #ruby("기|차","汽|車")를 타고 가던 #ruby("중","中") #ruby("기|차","汽|車") 안에서 #ruby("이|승|훈","李|昇|薰")을 만났다. #ruby("남|강","南|岡") #ruby("이|승|훈","李|昇|薰")#footnote(numbering: _ => [49)])[#h(0.35em)#ruby[이|승|훈][李|昇|薰]\(1864〜1930). #ruby("평|북","平|北") #ruby("정|주","定|州") #ruby("출|신","出|身")의 #ruby("민|족|기|업|가","民|族|企|業|家")·#ruby("운|동|가","運|動|家"). 1907#ruby("년","年") #ruby("신|민|회","新|民|會")에 #ruby("가|입","加|入")하고 #ruby("고|향","故|鄕") #ruby("정|주","定|州")에 #ruby("오|산|학|교","五|山|學|校")를 세웠다. 3·1#ruby("운|동","運|動") #ruby("당|시","當|時") 33#ruby("인","人")의 한 사람이다.]은 우리가 묶여 가는 것을 보고, 다른 사람이 알지 못하게 #ruby("차|창","車|窓") 밖으로 머리를 내밀고 하염없이 눈물을 흘렸다. #ruby("기|차","汽|車")가 #ruby("용|산|역","龍|山|驛")에 #ruby("도|착","到|着")할 즈음 #ruby("형|사","刑|事") 한 #ruby("명","名")이 #ruby("남|강","南|岡")에게 #ruby("인|사","人|事")를 하고 물었다.]
