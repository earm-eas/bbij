#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[그 며칠 #ruby("후","後"), #ruby("감|방","監|房")에서 #ruby("동|료","同|僚") #ruby("수|인","囚|人")들이 #ruby("의|복","衣|服")에서 #ruby("이","蝨")를 잡는 것을 본 #ruby("고|군","高|君")은, #ruby("비|밀","祕|密")히 #ruby("각","各") 사람에게 #ruby("부|탁","付|託")하여 이를 거두어 모아서 뒤 씻는 종이에 싸놓고, #ruby("간|수","看|守")에게 #ruby("전|옥","典|獄") #ruby("면|회","面|會")를 #ruby("청","請")하였다. #ruby("전|옥","典|獄") 앞에 이 꾸린 것을 내어놓으며,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("전","前")날 #ruby("전|옥|장","典|獄|長") #ruby("덕","德")으로 돌 없는 밥을 먹는 것은 #ruby("감|사","感|謝")하나, #ruby("의|복","衣|服")에 이가 끓어서 잠도 잘 수 없고, 깨어도 이 때문에 온몸이 근지러워서 견디기 어렵소.#footnote(numbering: _ => [78)])[#h(0.35em)#ruby("당|시","當|時") #ruby("감|옥","監|獄")의 가장 무서운 #ruby("적","敵")은 빈대와 벼룩이었다. #ruby("신|숙","申|肅")은 “밤이 이미 깊으기에/#ruby("억|제","抑|制")하고 잠을 #ruby("청","請")하니/#ruby("무|정","無|情")한 빈대 벼룩/벌떼같이 달려 든다”며 그의 #ruby("옥|중","獄|中") #ruby("체|험","體|驗")을 말하였다.] #ruby("구|한|국","舊|韓|國")#ruby("시|대","時|代") #ruby("감|옥","監|獄")에는 #ruby("수|인","囚|人")이 #ruby("자|기","自|己") 집에서 #ruby("의|복","衣|服")을 가져다 #ruby("착|용","着|用")할 수 있었으나 #ruby("대|일|본","大|日|本")의 #ruby("문|명","文|明")한 #ruby("법|률","法|律")은 그도 #ruby("허|가","許|可")하지 않으니, 이처럼 #ruby("불|결","不|潔")한 #ruby("의|복","衣|服")을 입으면 #ruby("질|병","疾|病")이 생길까 #ruby("염|려","念|慮")되오.”]
