#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[3#ruby("일","日") 굶어 #ruby("도|적","盜|賊")할 마음이 생기지 않을 #ruby("자","者") 드물다 하나, 마음만으로 #ruby("도|적","盜|賊")이 될 수는 없다. 한두 #ruby("명","名")의 좀도둑은 #ruby("가|능","可|能")하지만 #ruby("수|십","數|十") #ruby("명","名") #ruby("수|백","數|百") #ruby("명","名")의 #ruby("집|단|체","集|團|體")가 되어 #ruby("일|사|불|란","一|絲|不|亂")하게 움직이는 데에는 반드시 #ruby("지|휘","指|揮") #ruby("명|령","命|令")을 보내는 #ruby("기|관","機|關")과 #ruby("주|동|인|물","主|動|人|物")이 있어야 이끌 수 있을 것이다. 그만한 #ruby("인|물","人|物")이 있다 하면 #ruby("자|격","資|格")과 #ruby("지|량","智|量")이 #ruby("정|부","政|府") #ruby("관|리","官|吏") #ruby("이|상","以|上")의 #ruby("인|격|자","人|格|者")라야 할 것이니, #ruby("연|구","硏|究")·#ruby("조|사","調|査")하여 볼 #ruby("필|요","必|要")가 있다 해서 #ruby("연|구","硏|究")한 것이나, 끝내 #ruby("단|서","端|緖")를 얻지 못하고 말았던 것이다.]
