#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“#ruby("동|지","同|志")가 #ruby("사|방","四|方")에 흩어져 움직이니 #ruby("동|지","同|志")들이 서로 모를 사람도 많을 것이고 그러면 서로 만나서 #ruby("충|돌","衝|突")을 피하기 어렵고 여러 가지 #ruby("불|편","不|便")할 터인데, #ruby("동|지","同|志")들은 서로 무엇으로 #ruby("표|별","表|別")합니까?”]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“그렇지요. 우리의 #ruby("표|별","表|別")은 자주자주 고치는 까닭에 #ruby("영|구","永|久")히 #ruby("정","定")해진 것이 없으나 반드시 #ruby("표|별","表|別")은 있습니다. #ruby("일|례","一|例")를 들면, 얼마 #ruby("전","前") 어떤 #ruby("여|관","旅|館")에 #ruby[대상인][大商] 몇 #ruby("명","名")이 #ruby("숙|박","宿|泊")함을 알고 밤#ruby("중","中")에 #ruby("도|당","徒|黨")을 이끌고 #ruby("침|입","侵|入")하여 #ruby("재|물","財|物")을 #ruby("약|탈","掠|奪")하는데, 갑자기 #ruby("좌|중","座|中")에 낯을 땅에 대고 꿈적을 못하는 사람 가운데 한 사람이 #ruby("반","半")벙어리 말로 ‘에구, 나도 #ruby("장","醬") 담글 때 추렴돈 석 #ruby("냥","兩") 내었는데요’ 하고 우리끼리 #ruby("통","通")하는 #ruby("표|별","表|別")을 말합니다. ‘저놈, #ruby("방|자","放|恣")스럽게 무슨 #ruby("수|작","酬|酌")을 하니, 저놈부터 동여 앞세우라’ 하여 끌고 와서 #ruby("문|답","問|答")한 #ruby("결|과","結|果") #ruby("확|실","確|實")히 #ruby("동|지","同|志")입니다. 그런 #ruby("경|우","境|遇")에는 그 #ruby("동|지","同|志")까지 #ruby("장|물","贓|物") 나누는 것을 같이 하는 것이 #ruby("법","法")입니다.”]
