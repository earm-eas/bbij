#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“우리 #ruby("비|밀|결|사","秘|密|結|社")의 #ruby("시|원","始|原")과 #ruby("유|래","由|來")가 여러 백 #ruby("년","年")으로 이제는 #ruby("자|연","自|然") #ruby("공|공|연","公|公|然")한 #ruby("비|밀","秘|密")이 되었으나 #ruby("기|강","紀|綱")이 #ruby("엄|밀","嚴|密")한 탓으로, 나라가 #ruby("망","亡")함에 따라 예로부터 지켜오던 #ruby("사|회","社|會") #ruby("기|강","紀|綱")이 #ruby("여|지","餘|地")없이 #ruby("추|락","墜|落")된 오늘날에도, #ruby("조|선","朝|鮮")에서 ‘#ruby("벌","蜂")의 #ruby("법","法")’과 ‘#ruby("도|적","盜|賊")놈의 #ruby("법","法")’은 그대로 남아 있다고 #ruby("자|인","自|認")합니다. #ruby("노|형","老|兄")을 #ruby("북|대","北|隊")로 생각하고, 알지 못하시는 것을 여러 말로 물은 데 #ruby("대","對")하여 #ruby("미|안","未|安")합니다. 그런즉 #ruby("노|형","老|兄")에게 물은 것에 #ruby("대","對")해 먼저 #ruby("설|명","說|明")을 하고, 이어 #ruby("조|직","組|織")·#ruby("훈|련","訓|鍊")·#ruby("실|행","實|行")의 몇 가지 #ruby("예","例")를 들어 말씀하오리다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("조|선|시|대","朝|鮮|時|代") #ruby("이|전","以|前")은 #ruby("상|고","上|古")할 수 없으나, #ruby("조|선|시|대","朝|鮮|時|代") #ruby("이|후","以|後") #ruby("도|적","盜|賊")의 #ruby("계|파","系|派")와 #ruby("시|원","始|原")은 이렇습니다. #ruby("도|적","盜|賊")이란 이름부터 #ruby("명|예","名|譽")롭지 않거든 누가 #ruby("도|적","盜|賊")질을 좋은 #ruby("직|업","職|業")으로 알고 #ruby("행","行")할 #ruby("자","者") 있으리오만, #ruby("대|개","大|槪")가 #ruby("불|평|자","不|平|者")의 #ruby("반|동|적","反|動|的") #ruby("심|리","心|理")에서 #ruby("기|인","起|因")된 것이외다. #ruby("고|려","高|麗") #ruby("말","末") #ruby("이|성|계","李|成|桂")가 #ruby("신|하","臣|下")로서 임금을 #ruby[쳐서][以臣伐君] 나라를 얻은 #ruby("후","後"), #ruby("당|시","當|時")에 #ruby("두|문|동","杜|門|洞") 72#ruby("인","人")#footnote(numbering: _ => [104)])[#h(0.35em)#ruby("조|선","朝|鮮") #ruby("건|국","建|國")을 #ruby("반|대","反|對")하는 #ruby("고|려","高|麗") #ruby("유|신","遺|臣") #ruby("고|천|상","高|天|祥") #ruby("등","等") 72#ruby("인","人")의 #ruby("충|신","忠|臣")·#ruby("열|사","烈|士")들이 #ruby("망|국","亡|國")의 #ruby("비|애","悲|哀")를 품고 #ruby("두|문|동","杜|門|洞")에 들어가 #ruby("신|왕|조","新|王|朝")에 #ruby("협|력","協|力")하지 않자, #ruby("이|성|계","李|成|桂")는 #ruby("두|문|동","杜|門|洞")을 #ruby("포|위","包|圍")하고 불을 놓아 #ruby("몰|살","沒|殺")시켰다고 한다.] 같은 사람들 #ruby("외","外")에도 #ruby("고|려","高|麗") #ruby("왕|조","王|朝")에 #ruby("충|성","忠|誠")하고자 하는 뜻을 가지고 있는 #ruby("자","者") 많았을 것이오. 그러한 #ruby("지|사","志|士")들이 #ruby("비|밀|리","秘|密|裏")에 #ruby("연|락","連|絡") #ruby("혹","或")은 #ruby("집|단","集|團")하여 가지고, #ruby("약","弱")한 #ruby("자","者")를 #ruby("구|제","救|濟")하고 기운 것을 붙들고자 하는 #ruby("선|의","善|意")와, #ruby("질|서","秩|序")를 #ruby("파|괴","破|壞")하고자 하는 #ruby("보|복|적","報|復|的") #ruby("대|의","大|義")를 #ruby("표|방","標|榜")하고, 구석진 곳에 #ruby("동|지","同|志")를 #ruby("소|집","召|集")하였습니다. #ruby("조|선","朝|鮮")의 #ruby("은|총","恩|寵")과 #ruby("국|록","國|祿")을 먹는 #ruby("자","者"), #ruby("백|성","百|姓")을 #ruby("착|취","搾|取")하는 #ruby("소|위","所|謂") #ruby("양|반","兩|班")이라는 #ruby("족|속","族|屬")과 #ruby("부|유","富|有")한 #ruby("자","者")의 #ruby("재|물","財|物")을 #ruby("탈|취","奪|取")하여 #ruby("빈|한","貧|寒")한 #ruby("백|성","百|姓")을 #ruby("구|제","救|濟")하였는데, 나라에서 #ruby("도|적","盜|賊")이란 이름을 붙여 가지고 500#