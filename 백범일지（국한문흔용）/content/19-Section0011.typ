#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[라고 알려주고, 곧 아래#ruby("층","層")으로 내려가 #ruby("전|화","電|話")로 #ruby("자|기","自|己") #ruby("남|편","男|便")을 불렀다. #ruby("부|인","夫|人")은 #ruby("자|기","自|己")네 #ruby("자|동|차","自|動|車")에 나와 #ruby("부|부","夫|婦")인 #ruby("양","樣") 나란히 앉고 #ruby[피치][費吾生] #ruby("선|생","先|生")은 #ruby("운|전|사","運|轉|士")가 되어, 뜰 #ruby("내","內")에서 #ruby("차","車")를 몰고 #ruby("문","門") 밖으로 나갔다.#footnote(numbering: _ => [3)])[#h(0.35em)#ruby[피치][費吾生] #ruby("부|인","夫|人")에 #ruby("의","依")하면 #ruby("안|전","安|全")을 #ruby("위","爲")해 그녀가 #ruby("동|행","同|行")한 것은 #ruby("안|공|근","安|恭|根")의 #ruby("제|의","提|議")에 #ruby("의","依")한 것이었다고 한다.]]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("문","門") 밖으로 나가면서 보니 #ruby("일|본|인","日|本|人")은 보이지 않았지만 #ruby("불|란|서|인","佛|蘭|西|人")·러시아#ruby("인","人")·#ruby("중|국|인","中|國|人") #ruby("등","等") #ruby("각|국","各|國")의 #ruby("정|탐","偵|探")꾼이 #ruby("문","門") 앞과 #ruby("주|위","周|圍")를 수풀처럼 에워싸고 있었다. 그러나 #ruby("미|국|인","美|國|人") 집이라 어찌할 수가 없어 손을 쓰지 못하고 있는 것이었다. #ruby("불|란|서","佛|蘭|西") #ruby("조|계|지","租|界|地")를 지나 #ruby("중|국|지|역","中|國|地|域")에 이르러 #ruby("자|동|차","自|動|車")를 멈추고, 나와 #ruby("공|근","恭|根")은 #ruby("기|차|역","火|車|站")으로 가서 #ruby("당|일","當|日")로 #ruby("가|흥","嘉|興")의 #ruby("수|륜|사|창","秀|綸|沙|廠")으로 #ruby("피|신","避|身")하였다.#footnote(numbering: _ => [4)])[#h(0.35em)#ruby("정|정|화","鄭|靖|和")의 #ruby("회|고","回|顧")에 #ruby("의","依")하면 #ruby("수|륜|사|창","秀|綸|沙|廠")은 #ruby("저|보|성","褚|輔|成")의 아들인 #ruby("봉|장","鳳|章")이 #ruby("경|영","經|營")하던 #ruby("면|사|공|장","棉|絲|工|場")으로 #ruby("당|시","當|時") #ruby("세|계|대|공|황","世|界|大|恐|慌")으로 #ruby("폐|쇄","閉|鎖")되어 있었기 때문에 #ruby("피|신|처","避|身|處")로 #ruby("적|격","適|格")이었다고 한다.] 이 곳은 #ruby("남|파","南|坡") #ruby("박|찬|익","朴|贊|翊") #ruby("형","兄")이 #ruby("은|주|부","殷|鑄|夫")와 #ruby("저|보|성","褚|輔|成") #ruby("제|씨","諸|氏")에게 #ruby("주|선","周|旋")하여 #ruby("마|련","磨|鍊")한 곳으로 #ruby("엄|항|섭","嚴|恒|燮") #ruby("군","君")의 #ruby("가|족","家|族")을 비롯하여 #ruby("김|의|한","金|毅|漢") #ruby("일|가","一|家")와 #ruby("석|오","石|吾") #ruby("선|생","先|生")이 벌써 며칠 #ruby("전","前")에 #ruby("이|사","移|徙")해 와 있었다.]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[#ruby("상|해","上|海")에서 #ruby[피치][費吾生] #ruby("부|인","夫|人")이 내게 #ruby("보|고","報|告")한 #ruby("내|용","內|容")은 아래와 같았다. #ruby[피치][費吾生] #ruby("부|인","夫|人")은 아래#ruby("층","層")에서 #ruby("유|리|창","琉|璃|窓")으로 #ruby("문","門") 밖을 살펴보다가, 동저고리 차림의 낯선 #ruby("중|국|인","中|國|人") #ruby("노|동|자","勞|動|者")가 #ruby("자|기","自|己")네 #ruby("주|방","廚|房")으로 들어가는 것을 #ruby("발|견","發|見")하였다. #ruby("수|상","殊|常")하게 여겨 따라가서,]
#para(first: 1em, rest: 0em, alignment: left, size: 1em, justify: true)[“누구냐?”]
#para(first: 0em, rest: 0em, alignment: left, size: 1em, justify: true)[고 #ruby("질|문","質|問")하였다.]
